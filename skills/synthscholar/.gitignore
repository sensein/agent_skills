*.py[cod]
.DS_Store

# Working artefacts from a bring-your-own-corpus run (Mode 3) — corpora carry
# full article text, and search provenance can carry unpublished protocol
# details. Keep them out of the skill repo.
corpus*.json
protocol*.json
search_provenance*.json
review_output/
pdfs/
*.ttl
*.jsonld

# Search-strategy engine: the MeSH RDF dump (~2 GB) and the index built from it
# are regenerated locally (generate_search_strategy.py --build-index), and
# --fetch writes PubMed records under searches/.
mesh*.nt
mesh*.nt.gz
scripts/search_strategy/data/mesh.sqlite
scripts/search_strategy/data/mesh.sqlite.building
searches/
