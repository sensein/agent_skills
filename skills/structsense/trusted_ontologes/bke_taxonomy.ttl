bican:DisplayColor a owl:Class ;
    rdfs:label "DisplayColor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:color_hex_triplet ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bican:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:is_color_for_taxon ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bican:color_hex_triplet ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:xref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:is_color_for_set ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:part_of_palette ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:CellTypeSet ;
            owl:onProperty bican:is_color_for_set ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:is_color_for_taxon ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:ColorPalette ;
            owl:onProperty bican:part_of_palette ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:color_hex_triplet ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:part_of_palette ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:is_color_for_set ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:CellTypeTaxon ;
            owl:onProperty bican:is_color_for_taxon ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty bican:xref ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty bican:id ],
        bican:ProvEntity,
        <https://w3id.org/biolink/vocab/NamedThing> ;
    skos:definition "One element of a color palette representing the association between a color and entity," ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

