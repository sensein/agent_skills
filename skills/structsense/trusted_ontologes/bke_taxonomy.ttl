        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty <https://w3id.org/biolink/vocab/deprecated> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/biolink/vocab/type> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/biolink/vocab/id> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/biolink/vocab/description> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/biolink/vocab/id> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/biolink/vocab/category> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/biolink/vocab/type> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/biolink/vocab/name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty <https://w3id.org/biolink/vocab/category> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/biolink/vocab/iri> ] ;
    skos:definition "Root Biolink Model class for all things and informational relationships, real or imagined." ;
    skos:exactMatch <https://w3id.org/biolink/vocab/Entity> ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> .

bican:VersionedNamedThing a owl:Class ;
    rdfs:label "VersionedNamedThing" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/biolink/vocab/version> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/biolink/vocab/version> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/biolink/vocab/version> ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:VersionedNamedThing ;
            owl:onProperty bican:revision_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:revision_of ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:revision_of ],
        <https://w3id.org/biolink/vocab/NamedThing> ;
    skos:definition "An iteration of the biolink:NamedThing class that stores metadata about the object's version." ;
    skos:inScheme <https://identifiers.org/brain-bican/bican-core-schema> .

bican:was_derived_from a owl:ObjectProperty ;
    rdfs:label "was_derived_from" ;
    rdfs:range bican:ProvEntity ;
    skos:definition "A derivation is a transformation of an entity into another, an update of an entity resulting in a new one, or the construction of a new entity based on a pre-existing entity." ;
    skos:inScheme <https://identifiers.org/brain-bican/bican-prov-schema> .

bican:was_generated_by a owl:ObjectProperty ;
    rdfs:label "was_generated_by" ;
    rdfs:range bican:ProvActivity ;
    skos:definition "Generation is the completion of production of a new entity by an activity. This entity did not exist before generation and becomes available for usage after this generation." ;
    skos:inScheme <https://identifiers.org/brain-bican/bican-prov-schema> .

<https://w3id.org/biolink/vocab/creation_date> a owl:DatatypeProperty ;
    rdfs:label "creation date" ;
    rdfs:domain <https://w3id.org/biolink/vocab/NamedThing> ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf <https://w3id.org/biolink/vocab/node_property> ;
    skos:altLabel "date started",
        "publication date" ;
    skos:definition "date on which an entity was created. This can be applied to nodes or edges" ;
    skos:exactMatch dcterms:createdOn,
        <https://www.wikidata.org/prop/P577> ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> .

<https://w3id.org/biolink/vocab/format> a owl:DatatypeProperty ;
    rdfs:label "format" ;
    rdfs:domain <https://w3id.org/biolink/vocab/InformationContentEntity> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <https://w3id.org/biolink/vocab/node_property> ;
    skos:exactMatch dcterms:format,
        <https://www.wikidata.org/prop/P2701> ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> .

<https://w3id.org/biolink/vocab/in_taxon_label> a owl:DatatypeProperty ;
    rdfs:label "in taxon label" ;
    rdfs:domain <https://w3id.org/biolink/vocab/ThingWithTaxon> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <https://w3id.org/biolink/vocab/node_property> ;
    skos:definition "The human readable scientific name for the taxon of the entity." ;
    skos:exactMatch <https://www.wikidata.org/prop/P225> ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> ;
    bican:denormalized true .

<https://w3id.org/biolink/vocab/license> a owl:DatatypeProperty ;
    rdfs:label "license" ;
    rdfs:domain <https://w3id.org/biolink/vocab/InformationContentEntity> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <https://w3id.org/biolink/vocab/node_property> ;
    skos:exactMatch dcterms:license ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> ;
    skos:narrowMatch <https://www.wikidata.org/prop/P275> .

<https://w3id.org/biolink/vocab/rights> a owl:DatatypeProperty ;
    rdfs:label "rights" ;
    rdfs:domain <https://w3id.org/biolink/vocab/InformationContentEntity> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <https://w3id.org/biolink/vocab/node_property> ;
    skos:exactMatch dcterms:rights ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> .

bican:accession_id a owl:DatatypeProperty ;
    rdfs:label "accession_id" ;
    rdfs:range xsd:string ;
    skos:definition "A provider assigned accession identifier for a given entity." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:ProvEntity a owl:Class ;
    rdfs:label "ProvEntity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom bican:ProvEntity ;
            owl:onProperty bican:was_derived_from ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:ProvActivity ;
            owl:onProperty bican:was_generated_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:was_generated_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:was_generated_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:was_derived_from ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:was_derived_from ] ;
    skos:definition "An entity is a physical, digital, conceptual, or other kind of thing with some fixed aspects;  entities may be real or imaginary." ;
    skos:exactMatch prov:Entity ;
    skos:inScheme <https://identifiers.org/brain-bican/bican-prov-schema> .

<https://w3id.org/biolink/vocab/node_property> a owl:DatatypeProperty ;
    rdfs:label "node property" ;
    rdfs:domain <https://w3id.org/biolink/vocab/NamedThing> ;
    rdfs:range xsd:string ;
    skos:definition "A grouping for any property that holds between a node and a value" ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> .

bican:revision_of a owl:ObjectProperty ;
    rdfs:label "revision_of" ;
    rdfs:range bican:VersionedNamedThing ;
    skos:inScheme <https://identifiers.org/brain-bican/bican-core-schema> .

<https://w3id.org/biolink/vocab/Attribute> a owl:Class ;
    rdfs:label "attribute" ;
