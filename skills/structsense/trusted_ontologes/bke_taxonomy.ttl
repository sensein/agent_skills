@prefix bican: <https://identifiers.org/brain-bican/vocab/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

bican:AnnotationCollection a owl:Class ;
    rdfs:label "AnnotationCollection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom bican:GenomeAnnotation ;
            owl:onProperty bican:genome_annotations ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:GeneAnnotation ;
            owl:onProperty bican:annotations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:annotations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:genome_annotations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:genome_assemblies ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:GenomeAssembly ;
            owl:onProperty bican:genome_assemblies ] ;
    skos:inScheme <https://identifiers.org/brain-bican/genome-annotation-schema> .

bican:ParcellationAnnotationTermMap a owl:Class ;
    rdfs:label "ParcellationAnnotationTermMap" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty bican:subject_parcellation_term ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( bican:ParcellationAnnotation xsd:string ) ] ;
            owl:onProperty bican:subject_parcellation_annotation ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( bican:ParcellationTerm xsd:string ) ] ;
            owl:onProperty bican:subject_parcellation_term ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:subject_parcellation_term ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty bican:subject_parcellation_annotation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:subject_parcellation_annotation ] ;
    skos:definition "The parcellation annotation term map table defines the relationship between parcellation annotations and parcellation terms.  A parcellation term is uniquely denoted by a parcellation term identifier and the parcellation terminology it belongs to.  A parcellation term can be spatially parameterized by the union of one or more parcellation annotations within a versioned  release of an anatomical annotation set. For example, annotations defining individual cortical layers in cortical region  R (R1, R2/3, R4, etc) can be combined to define the parent region R." ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:ParcellationColorAssignment a owl:Class ;
    rdfs:label "ParcellationColorAssignment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( bican:ParcellationColorScheme xsd:string ) ] ;
            owl:onProperty bican:part_of_parcellation_color_scheme ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:color ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:part_of_parcellation_color_scheme ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty bican:part_of_parcellation_color_scheme ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:color ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:subject_parcellation_term ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( bican:ParcellationTerm xsd:string ) ] ;
            owl:onProperty bican:subject_parcellation_term ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty bican:subject_parcellation_term ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bican:color ] ;
    skos:definition "The parcellation color assignment associates hex color value to a parcellation term within a  versioned release of a color scheme. A parcellation term is uniquely denoted by a parcellation  term identifier and the parcellation terminology it belongs to." ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

<https://w3id.org/biolink/vocab/chembl_chirality> a owl:DatatypeProperty ;
    rdfs:label "chembl chirality" ;
    rdfs:domain <https://w3id.org/biolink/vocab/NamedThing> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <https://w3id.org/biolink/vocab/node_property> ;
    skos:definition "Tern indicating the chirality of the chemical entity." ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> .

<https://w3id.org/biolink/vocab/chembl_drug_warning> a owl:DatatypeProperty ;
    rdfs:label "chembl drug warning" ;
    rdfs:domain <https://w3id.org/biolink/vocab/NamedThing> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <https://w3id.org/biolink/vocab/node_property> ;
    skos:definition "Text describing warnings for use of chemicals as therapeutics." ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> .

<https://w3id.org/biolink/vocab/chembl_prodrug> a owl:DatatypeProperty ;
    rdfs:label "chembl prodrug" ;
    rdfs:domain <https://w3id.org/biolink/vocab/NamedThing> ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf <https://w3id.org/biolink/vocab/node_property> ;
    skos:definition "Flag indicating if a drug is a prodrug that is active only after being metabolized by the body." ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> .

<https://w3id.org/biolink/vocab/organism_taxon_has_taxonomic_rank> a owl:ObjectProperty ;
    rdfs:label "organism taxon_has taxonomic rank" ;
    rdfs:domain <https://w3id.org/biolink/vocab/OrganismTaxon> ;
    rdfs:range <https://w3id.org/biolink/vocab/TaxonomicRank> ;
    rdfs:subPropertyOf <https://w3id.org/biolink/vocab/has_taxonomic_rank> ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> ;
    skos:mappingRelation <https://www.wikidata.org/entity/P105> ;
    skos:prefLabel "has taxonomic rank" .

<https://w3id.org/brain-bican/bke-taxonomy.owl.ttl> a owl:Ontology ;
    rdfs:label "BKETaxonomy" ;
    dcterms:title "BKE Taxonomy Schema" ;
    skos:definition "The BKE Taxonomy Schema represents the structure of classifications of cell types and their hierarchical relationships in the mammalian brain." .

bican:ParcellationAnnotation a owl:Class ;
    rdfs:label "ParcellationAnnotation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bican:internal_identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:part_of_anatomical_annotation_set ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty bican:part_of_anatomical_annotation_set ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:voxel_count ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:internal_identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:voxel_count ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty bican:voxel_count ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( bican:AnatomicalAnnotationSet xsd:string ) ] ;
            owl:onProperty bican:part_of_anatomical_annotation_set ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty bican:internal_identifier ] ;
    skos:definition "A parcellation annotation defines a specific segment of an anatomical space denoted by an internal  identifier and is a unique and exclusive member of a versioned release anatomical annotation set.  For example, in the case where the anatomical annotation set is a single multi-value image mask (e.g. Allen Mouse CCF), a specific annotation corresponds to a specific label index (internal identifier) in the mask." ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

<https://w3id.org/biolink/vocab/related_to> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "related to" ;
    rdfs:domain <https://w3id.org/biolink/vocab/NamedThing> ;
    rdfs:range <https://w3id.org/biolink/vocab/NamedThing> ;
    skos:broadMatch <owl:topObjectProperty> ;
    skos:definition "A relationship that is asserted between two named things" ;
    skos:exactMatch <UMLS:related_to> ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> ;
    skos:narrowMatch <BFO:0000054>,
        <BTO:related_to>,
        <CHEBI:is_conjugate_acid_of>,
        <CHEBI:is_conjugate_base_of>,
        <HMDB:disease>,
        <HMDB:has_protein_association>,
        <IAO:0000136>,
        <MONDO:disease_shares_features_of>,
        <NCIT:disease_may_have_associated_disease>,
        <NCIT:human_disease_maps_to_eo_disease>,
        <NCIT:is_abnormal_cell_of_disease>,
        <NCIT:is_related_to_endogenous_product>,
        <PATO:reciprocal_of>,
        <SNOMED:has_associated_morphology>,
        <SNOMED:has_associated_procedure>,
        <SNOMED:has_direct_morphology>,
        <SNOMED:has_disposition>,
        <SNOMED:has_indirect_morphology>,
        <SNOMED:has_modification>,
        <SNOMED:has_procedure_morphology>,
        <SNOMED:has_specimen_source_morphology>,
        <SNOMED:inheres_in>,
        <SNOMED:is_interpreted_by>,
        <SNOMED:relative_to_part_of>,
        <UBERON:synapsed_by>,
        <UMLS:RO>,
        <UMLS:RQ>,
        <UMLS:class_code_classified_by>,
        <UMLS:exhibited_by>,
        <UMLS:has_context_binding>,
        <UMLS:has_form>,
        <UMLS:has_mapping_qualifier>,
        <UMLS:larger_than>,
        <UMLS:mapped_to>,
        <UMLS:owning_section_of>,
        <http://id.nlm.nih.gov/mesh/RO>,
        <http://id.nlm.nih.gov/mesh/has_mapping_qualifier>,
        <http://id.nlm.nih.gov/mesh/mapped_to>,
