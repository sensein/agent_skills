            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( bican:BioType xsd:string ) ] ;
            owl:onProperty bican:molecular_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:source_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty bican:referenced_in ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( bican:GenomeAnnotation xsd:string ) ] ;
            owl:onProperty bican:referenced_in ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:molecular_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:molecular_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:referenced_in ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bican:source_id ],
        <https://w3id.org/biolink/vocab/Gene> ;
