bican:ParcellationTerminology a owl:Class ;
    rdfs:label "ParcellationTerminology" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( bican:ParcellationTerminology xsd:string ) ] ;
