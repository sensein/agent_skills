<https://w3id.org/biolink/vocab/PhysicalEssenceOrOccurrent> a owl:Class ;
    rdfs:label "physical essence or occurrent" ;
    skos:definition "Either a physical or processual entity." ;
    skos:exactMatch <https://w3id.org/biolink/vocab/PhysicalEssenceOrOccurrent> ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> .

<https://w3id.org/biolink/vocab/attribute_name> a owl:DatatypeProperty ;
    rdfs:label "attribute_name" ;
    rdfs:domain <https://w3id.org/biolink/vocab/Attribute> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <https://w3id.org/biolink/vocab/name> ;
    skos:altLabel "display name",
        "label",
        "title" ;
    skos:definition "The human-readable 'attribute name' can be set to a string which reflects its context of interpretation, e.g. SEPIO evidence/provenance/confidence annotation or it can default to the name associated with the 'has attribute type' slot ontology term." ;
    skos:exactMatch <https://github.com/The-Sequence-Ontology/Specifications/blob/master/gff3.md#Name>,
        <https://github.com/geneontology/go-annotation/blob/master/specs/gpad-gpi-2-0.md#DB_Object_Name> ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> ;
    skos:mappingRelation <rdfs:label> ;
    skos:narrowMatch dcterms:title,
        <https://www.wikidata.org/prop/P1476> ;
    skos:prefLabel "name" .

<https://w3id.org/biolink/vocab/has_attribute_type> a owl:ObjectProperty ;
    rdfs:label "has attribute type" ;
    rdfs:domain <https://w3id.org/biolink/vocab/Attribute> ;
    rdfs:range <https://w3id.org/biolink/vocab/OntologyClass> ;
    skos:definition "connects an attribute to a class that describes it" ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> ;
    skos:narrowMatch <http://loinc.org/rdf/has_modality_type>,
        <http://loinc.org/rdf/has_view_type> .

<https://w3id.org/biolink/vocab/has_numeric_value> a owl:DatatypeProperty ;
    rdfs:label "has numeric value" ;
    rdfs:domain <https://w3id.org/biolink/vocab/QuantityValue> ;
    rdfs:range xsd:double ;
    skos:definition "connects a quantity value to a number" ;
    skos:exactMatch <http://qudt.org/1.1/schema/qudt#quantityValue> ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> .

<https://w3id.org/biolink/vocab/has_qualitative_value> a owl:ObjectProperty ;
    rdfs:label "has qualitative value" ;
    rdfs:domain <https://w3id.org/biolink/vocab/Attribute> ;
    rdfs:range <https://w3id.org/biolink/vocab/NamedThing> ;
    skos:definition "connects an attribute to a value" ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> .

<https://w3id.org/biolink/vocab/has_unit> a owl:DatatypeProperty ;
    rdfs:label "has unit" ;
    rdfs:domain <https://w3id.org/biolink/vocab/QuantityValue> ;
    rdfs:range <UO:0000000> ;
    skos:closeMatch <http://purl.obolibrary.org/obo/uo#is_unit_of>,
        <http://www.ebi.ac.uk/efo/EFO_0001697> ;
    skos:definition "connects a quantity value to a unit" ;
    skos:exactMatch <IAO:0000039>,
        <http://qudt.org/1.1/schema/qudt#unit> ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> ;
    skos:narrowMatch <SNOMED:has_concentration_strength_denominator_unit>,
        <SNOMED:has_concentration_strength_numerator_unit>,
        <SNOMED:has_presentation_strength_denominator_unit>,
        <SNOMED:has_presentation_strength_numerator_unit>,
        <SNOMED:has_unit_of_presentation> .

<https://w3id.org/biolink/vocab/macromolecular_machine_mixin_name> a owl:DatatypeProperty ;
    rdfs:label "macromolecular machine mixin_name" ;
    rdfs:domain <https://w3id.org/biolink/vocab/MacromolecularMachineMixin> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <https://w3id.org/biolink/vocab/name> ;
    skos:altLabel "display name",
        "label",
        "title" ;
    skos:definition "genes are typically designated by a short symbol and a full name. We map the symbol to the default display name and use an additional slot for full name" ;
    skos:exactMatch <https://github.com/The-Sequence-Ontology/Specifications/blob/master/gff3.md#Name>,
        <https://github.com/geneontology/go-annotation/blob/master/specs/gpad-gpi-2-0.md#DB_Object_Name> ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> ;
    skos:mappingRelation <rdfs:label> ;
    skos:narrowMatch dcterms:title,
        <https://www.wikidata.org/prop/P1476> ;
    skos:prefLabel "name" .

<https://w3id.org/biolink/vocab/symbol> a owl:DatatypeProperty ;
    rdfs:label "symbol" ;
    rdfs:domain <https://w3id.org/biolink/vocab/NamedThing> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <https://w3id.org/biolink/vocab/node_property> ;
    skos:definition "Symbol for a particular thing" ;
    skos:exactMatch <https://github.com/geneontology/go-annotation/blob/master/specs/gpad-gpi-2-0.md#DB_Object_Symbol>,
        <https://www.alliancegenome.org/symbol> ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> .

bican:AbbreviationEntityType a owl:Class ;
    owl:unionOf ( <https://identifiers.org/brain-bican/vocab/AbbreviationEntityType#cell_type> <https://identifiers.org/brain-bican/vocab/AbbreviationEntityType#gene> <https://identifiers.org/brain-bican/vocab/AbbreviationEntityType#anatomical> ) ;
    linkml:permissible_values <https://identifiers.org/brain-bican/vocab/AbbreviationEntityType#anatomical>,
        <https://identifiers.org/brain-bican/vocab/AbbreviationEntityType#cell_type>,
        <https://identifiers.org/brain-bican/vocab/AbbreviationEntityType#gene> .

bican:AuthorityType a owl:Class ;
    owl:unionOf ( <https://identifiers.org/brain-bican/vocab/AuthorityType#ENSEMBL> <https://identifiers.org/brain-bican/vocab/AuthorityType#NCBI> ) ;
    linkml:permissible_values <https://identifiers.org/brain-bican/vocab/AuthorityType#ENSEMBL>,
        <https://identifiers.org/brain-bican/vocab/AuthorityType#NCBI> .

bican:BioType a owl:Class ;
    owl:unionOf ( <https://identifiers.org/brain-bican/vocab/BioType#protein_coding> <https://identifiers.org/brain-bican/vocab/BioType#noncoding> ) ;
    linkml:permissible_values <https://identifiers.org/brain-bican/vocab/BioType#noncoding>,
        <https://identifiers.org/brain-bican/vocab/BioType#protein_coding> .

bican:CellTypeSet a owl:Class ;
    rdfs:label "CellTypeSet" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bican:accession_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:order ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:CellTypeTaxon ;
            owl:onProperty bican:contains_taxon ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:order ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:CellTypeSet ;
            owl:onProperty bican:has_parent ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:minInclusive "0.0" ] ) ] ) ] ;
            owl:onProperty bican:order ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:has_parent ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bican:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:accession_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:part_of_taxonomy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:accession_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:Abbreviation ;
            owl:onProperty bican:has_abbreviation ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:CellTypeTaxonomy ;
            owl:onProperty bican:part_of_taxonomy ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty bican:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty bican:xref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:contains_taxon ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:has_parent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:part_of_taxonomy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:cell_type_set_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:cell_type_set_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:CellTypeSetType ;
            owl:onProperty bican:cell_type_set_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:has_abbreviation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:xref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bican:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bican:name ],
        bican:ProvEntity,
        <https://w3id.org/biolink/vocab/NamedThing> ;
    skos:definition "A grouping of cell type taxons. The grouping may represent a specific taxonomic level (rank) or cell type neighborhood." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:Checksum a owl:Class ;
    rdfs:label "checksum" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bican:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:checksum_algorithm ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:checksum_algorithm ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:DigestType ;
            owl:onProperty bican:checksum_algorithm ],
        <https://w3id.org/biolink/vocab/Entity> ;
    skos:definition "Checksum values associated with digital entities." ;
    skos:inScheme <https://identifiers.org/brain-bican/bican-core-schema> .

bican:DISTANCEUNIT a owl:Class ;
    owl:unionOf ( <https://identifiers.org/brain-bican/vocab/DISTANCEUNIT#mm> <https://identifiers.org/brain-bican/vocab/DISTANCEUNIT#um> <https://identifiers.org/brain-bican/vocab/DISTANCEUNIT#m> ) ;
    linkml:permissible_values <https://identifiers.org/brain-bican/vocab/DISTANCEUNIT#m>,
        <https://identifiers.org/brain-bican/vocab/DISTANCEUNIT#mm>,
        <https://identifiers.org/brain-bican/vocab/DISTANCEUNIT#um> .

bican:GenomeAnnotation a owl:Class ;
    rdfs:label "GenomeAnnotation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:content_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:digest ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bican:content_url ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( bican:GenomeAssembly xsd:string ) ] ;
            owl:onProperty bican:reference_assembly ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:reference_assembly ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:AuthorityType ;
            owl:onProperty bican:authority ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty bican:reference_assembly ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:authority ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( bican:Checksum xsd:string ) ] ;
            owl:onProperty bican:digest ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/biolink/vocab/version> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/biolink/vocab/version> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:authority ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/biolink/vocab/version> ],
        <https://w3id.org/biolink/vocab/Genome> ;
    skos:definition "Represents a genome annotation. Includes metadata about the genome, such as its version and reference assembly." ;
    skos:inScheme <https://identifiers.org/brain-bican/genome-annotation-schema> .

bican:GenomeAssembly a owl:Class ;
    rdfs:label "GenomeAssembly" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/biolink/vocab/version> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:strain ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:strain ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/biolink/vocab/version> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bican:strain ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/biolink/vocab/version> ],
        <https://w3id.org/biolink/vocab/NamedThing>,
        <https://w3id.org/biolink/vocab/ThingWithTaxon> ;
    skos:definition "Represents a genome assembly. A genome assembly is a computational representation of a genome sequence." ;
    skos:inScheme <https://identifiers.org/brain-bican/genome-annotation-schema> .

bican:ImageDataset a owl:Class ;
    rdfs:label "ImageDataset" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:z_size ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( bican:ImageDataset xsd:string ) ] ;
            owl:onProperty bican:revision_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:ANATOMICALDIRECTION ;
            owl:onProperty bican:z_direction ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:z_direction ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:revision_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:z_size ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:x_size ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty bican:x_size ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:ANATOMICALDIRECTION ;
            owl:onProperty bican:x_direction ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:x_size ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:x_direction ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:x_resolution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:revision_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty bican:x_resolution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:y_direction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:x_resolution ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:y_direction ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:ANATOMICALDIRECTION ;
            owl:onProperty bican:y_direction ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty bican:z_resolution ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:y_resolution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:z_direction ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:y_size ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty bican:y_resolution ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:DISTANCEUNIT ;
            owl:onProperty bican:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:x_direction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:z_resolution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:y_resolution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:y_size ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty bican:y_size ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:z_resolution ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty bican:z_size ],
        bican:VersionedNamedThing ;
    skos:definition "An image dataset is versioned release of a multidimensional regular grid of measurements  and metadata required for a morphological representation of an entity such as an anatomical  structure (ref: OBI_0003327, RRID:SCR_006266)" ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:MatrixFile a owl:Class ;
    rdfs:label "MatrixFile" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty bican:xref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bican:content_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:content_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:xref ],
        bican:ProvEntity,
        <https://w3id.org/biolink/vocab/NamedThing> ;
    skos:definition "A digital file containing the representation of full or partial data matrix." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:ParcellationAtlas a owl:Class ;
    rdfs:label "ParcellationAtlas" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( bican:AnatomicalSpace xsd:string ) ] ;
            owl:onProperty bican:has_anatomical_space ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:has_anatomical_space ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( bican:ParcellationAtlas xsd:string ) ] ;
            owl:onProperty bican:specialization_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:has_parcellation_terminology ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( bican:ParcellationAtlas xsd:string ) ] ;
            owl:onProperty bican:revision_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:revision_of ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:specialization_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:has_anatomical_annotation_set ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:revision_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( bican:AnatomicalAnnotationSet xsd:string ) ] ;
            owl:onProperty bican:has_anatomical_annotation_set ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:specialization_of ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty bican:has_anatomical_space ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( bican:ParcellationTerminology xsd:string ) ] ;
            owl:onProperty bican:has_parcellation_terminology ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty bican:has_parcellation_terminology ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty bican:has_anatomical_annotation_set ],
        bican:VersionedNamedThing ;
    skos:definition "A parcellation atlas is a versioned release reference used to guide experiments or deal with the spatial relationship between  objects or the location of objects within the context of some anatomical structure. An atlas is minimally defined by a notion  of space (either implicit or explicit) and an annotation set. Reference atlases usually have additional parts that make them  more useful in certain situations, such as a well defined coordinate system, delineations indicating the boundaries of various  regions or cell populations, landmarks, and labels and names to make it easier to communicate about well known and useful  locations (ref: ILX:0777109, RRID:SCR_023499)." ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:ParcellationColorScheme a owl:Class ;
    rdfs:label "ParcellationColorScheme" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:revision_of ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty bican:subject_parcellation_terminology ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:revision_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:subject_parcellation_terminology ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( bican:ParcellationTerminology xsd:string ) ] ;
            owl:onProperty bican:subject_parcellation_terminology ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( bican:ParcellationColorScheme xsd:string ) ] ;
            owl:onProperty bican:revision_of ],
        bican:VersionedNamedThing ;
    skos:definition "A parcellation color scheme is a versioned release color palette that can be used to visualize a  parcellation terminology or its related parcellation annotation. A parcellation terminology may  have zero or more parcellation color schemes and each color scheme is in context of a specific  parcellation terminology, where each parcellation term is assigned a hex color value. A parcellation  color scheme is defined as a part of one and only one parcellation terminology." ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:ParcellationTermSet a owl:Class ;
    rdfs:label "ParcellationTermSet" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( bican:ParcellationTerminology xsd:string ) ] ;
            owl:onProperty bican:part_of_parcellation_terminology ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:has_parent_parcellation_term_set ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty bican:part_of_parcellation_terminology ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( bican:ParcellationTermSet xsd:string ) ] ;
            owl:onProperty bican:has_parent_parcellation_term_set ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:ordinal ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:ordinal ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty bican:ordinal ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:has_parent_parcellation_term_set ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:part_of_parcellation_terminology ],
        bican:VersionedNamedThing ;
    skos:definition "A parcellation term set is the set of parcellation terms within a specific parcellation terminology.  A parcellation term set belongs to one and only one parcellation terminology and each parcellation  term in a parcellation terminology belongs to one and only one term set.  If the parcellation terminology is a taxonomy, parcellation term sets can be used to represent  taxonomic ranks. For consistency, if the terminology does not have the notion of taxonomic ranks,  all terms are grouped into a single parcellation term set." ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

