<https://w3id.org/biolink/vocab/ActivityAndBehavior> a owl:Class ;
    rdfs:label "activity and behavior" ;
    rdfs:subClassOf <https://w3id.org/biolink/vocab/Occurrent> ;
    skos:definition "Activity or behavior of any independent integral living, organization or mechanical actor in the world" ;
    skos:exactMatch <https://lhncbc.nlm.nih.gov/semanticnetwork/download/sg_archive/SemGroups-v04.txtACTI>,
        <https://w3id.org/biolink/vocab/ActivityAndBehavior> ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> .

<https://w3id.org/biolink/vocab/GenomicEntity> a owl:Class ;
    rdfs:label "genomic entity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/biolink/vocab/has_biological_sequence> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/biolink/vocab/has_biological_sequence> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/biolink/vocab/has_biological_sequence> ] ;
    skos:exactMatch <https://w3id.org/biolink/vocab/GenomicEntity> ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> ;
    skos:narrowMatch <GENO:0000897>,
        <http://purl.bioontology.org/ontology/STY/T028> .

<https://w3id.org/biolink/vocab/MacromolecularMachineMixin> a owl:Class ;
    rdfs:label "macromolecular machine mixin" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/biolink/vocab/name> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/biolink/vocab/name> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/biolink/vocab/name> ] ;
    skos:definition "A union of gene locus, gene product, and macromolecular complex. These are the basic units of function in a cell. They either carry out individual biological activities, or they encode molecules which do this." ;
    skos:exactMatch <https://w3id.org/biolink/vocab/MacromolecularMachineMixin> ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> .

