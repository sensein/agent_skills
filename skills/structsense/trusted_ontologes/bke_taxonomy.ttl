    rdfs:label "annotations" ;
    skos:inScheme <https://identifiers.org/brain-bican/genome-annotation-schema> .

bican:contains_cluster a owl:ObjectProperty ;
    rdfs:label "contains_cluster" ;
    skos:definition "One of potentially cell clusters which together defines the cell type taxon." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:contains_observation a owl:ObjectProperty ;
    rdfs:label "contains_observation" ;
    skos:definition "One of potentially many input observations which together define the cluster." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:contains_sample a owl:ObjectProperty ;
    rdfs:label "contains_sample" ;
    skos:definition "One of potentially many sample which together define the cluster." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:contains_taxon a owl:ObjectProperty ;
    rdfs:label "contains_taxon" ;
    skos:definition "One of potentially many cell types taxons which together defines the cell type set." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:curated_markers_to_mouse a owl:ObjectProperty ;
    rdfs:label "curated_markers_to_mouse" ;
    skos:definition "Marker genes in the mouse species that are related to the respective cell type." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:curated_markers_to_primates a owl:ObjectProperty ;
    rdfs:label "curated_markers_to_primates" ;
    skos:definition "Marker genes in the primate species that are related to the respective cell type." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:denotes_cell_type a owl:ObjectProperty ;
    rdfs:label "denotes_cell_type" ;
    skos:definition "One of potentially many cell type terms  which the abbreviation denotes." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:denotes_gene_annotation a owl:ObjectProperty ;
    rdfs:label "denotes_gene_annotation" ;
    skos:definition "One of potentially many gene annotation terms to which the abbreviation denotes." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:denotes_parcellation_term a owl:ObjectProperty ;
    rdfs:label "denotes_parcellation_term" ;
    skos:definition "One of potentially many parcellation terms (anatomical structures) which the abbreviation denotes." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:digest a owl:DatatypeProperty ;
    rdfs:label "digest" ;
    rdfs:range [ owl:unionOf ( bican:Checksum xsd:string ) ] ;
    skos:definition "Stores checksum information." ;
    skos:inScheme <https://identifiers.org/brain-bican/bican-core-schema> .

bican:genome_annotations a owl:ObjectProperty ;
    rdfs:label "genome_annotations" ;
    skos:inScheme <https://identifiers.org/brain-bican/genome-annotation-schema> .

bican:genome_assemblies a owl:ObjectProperty ;
    rdfs:label "genome_assemblies" ;
    skos:inScheme <https://identifiers.org/brain-bican/genome-annotation-schema> .

bican:has_variable a owl:ObjectProperty ;
    rdfs:label "has_variable" ;
    skos:definition "One of set of genes which together forms the variable set of an observation matrix." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:represented_by a owl:ObjectProperty ;
    rdfs:label "represented_by" ;
    skos:definition "One of potentially matrix files which together represents the entire observation matrix." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

<https://w3id.org/biolink/vocab/Annotation> a owl:Class ;
    rdfs:label "annotation" ;
    skos:definition "Biolink Model root class for entity annotations." ;
    skos:exactMatch <https://w3id.org/biolink/vocab/Annotation> ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> .

<https://w3id.org/biolink/vocab/ChemicalEntityOrGeneOrGeneProduct> a owl:Class ;
    rdfs:label "chemical entity or gene or gene product" ;
    skos:definition "A union of chemical entities and children, and gene or gene product. This mixin is helpful to use when searching across chemical entities that must include genes and their children as chemical entities." ;
    skos:exactMatch <https://w3id.org/biolink/vocab/ChemicalEntityOrGeneOrGeneProduct> ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> .

<https://w3id.org/biolink/vocab/GeneOrGeneProduct> a owl:Class ;
    rdfs:label "gene or gene product" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/biolink/vocab/macromolecular_machine_mixin_name> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/biolink/vocab/macromolecular_machine_mixin_name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/biolink/vocab/macromolecular_machine_mixin_name> ],
        <https://w3id.org/biolink/vocab/MacromolecularMachineMixin> ;
    skos:definition "A union of gene loci or gene products. Frequently an identifier for one will be used as proxy for another" ;
    skos:exactMatch <https://w3id.org/biolink/vocab/GeneOrGeneProduct> ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> .

<https://w3id.org/biolink/vocab/Occurrent> a owl:Class ;
    rdfs:label "occurrent" ;
    rdfs:subClassOf <https://w3id.org/biolink/vocab/PhysicalEssenceOrOccurrent> ;
    skos:definition "A processual entity." ;
    skos:exactMatch <BFO:0000003>,
        <https://w3id.org/biolink/vocab/Occurrent> ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> .

<https://w3id.org/biolink/vocab/SubjectOfInvestigation> a owl:Class ;
    rdfs:label "subject of investigation" ;
    skos:definition "An entity that has the role of being studied in an investigation, study, or experiment" ;
    skos:exactMatch <https://w3id.org/biolink/vocab/SubjectOfInvestigation> ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> .

<https://w3id.org/biolink/vocab/has_quantitative_value> a owl:ObjectProperty ;
    rdfs:label "has quantitative value" ;
    rdfs:domain <https://w3id.org/biolink/vocab/Attribute> ;
    rdfs:range <https://w3id.org/biolink/vocab/QuantityValue> ;
    skos:definition "connects an attribute to a value" ;
    skos:exactMatch <http://qudt.org/1.1/schema/qudt#quantityValue> ;
    skos:inScheme <https://w3id.org/biolink/bican-biolink-schema> ;
    skos:narrowMatch <SNOMED:has_concentration_strength_numerator_value>,
        <SNOMED:has_presentation_strength_denominator_value>,
        <SNOMED:has_presentation_strength_numerator_value> .

bican:CellTypeSetType a owl:Class ;
    owl:unionOf ( <https://identifiers.org/brain-bican/vocab/CellTypeSetType#taxonomic_level> <https://identifiers.org/brain-bican/vocab/CellTypeSetType#neighborhood> ) ;
    linkml:permissible_values <https://identifiers.org/brain-bican/vocab/CellTypeSetType#neighborhood>,
        <https://identifiers.org/brain-bican/vocab/CellTypeSetType#taxonomic_level> .

bican:CellTypeTaxonomyCreationProcess a owl:Class ;
    rdfs:label "CellTypeTaxonomyCreationProcess" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:used ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:ClusterSet ;
            owl:onProperty bican:used ],
        bican:ProvActivity,
        <https://w3id.org/biolink/vocab/Procedure> ;
    skos:definition "The process of organizing cells or clusters into a systematic classification of cell types and their heirarchical relationships and groupings." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:Cluster a owl:Class ;
    rdfs:label "Cluster" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:xref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty bican:xref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:accession_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:accession_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:minInclusive "0.0" ] ) ] ) ] ;
            owl:onProperty bican:number_of_observations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:contains_sample ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:CellSpecimen ;
            owl:onProperty bican:contains_sample ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:ObservationRow ;
            owl:onProperty bican:contains_observation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:part_of_set ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bican:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bican:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:ClusterSet ;
            owl:onProperty bican:part_of_set ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty bican:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bican:accession_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:part_of_set ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:contains_observation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:number_of_observations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:number_of_observations ],
        bican:ProvEntity,
        <https://w3id.org/biolink/vocab/NamedThing> ;
    skos:definition "One specific cluster from the set of clusters determined by a clustering process. A cluster is defined by set of observations which has been grouped together based on similarities or patterns." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:ClusteringProcess a owl:Class ;
    rdfs:label "ClusteringProcess" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:used ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:ObservationMatrix ;
            owl:onProperty bican:used ],
        bican:ProvActivity,
        <https://w3id.org/biolink/vocab/Procedure> ;
    skos:definition "The process of organizing and classifying observations into groups or clusters based on similarities or patterns." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:ColorPalette a owl:Class ;
    rdfs:label "ColorPalette" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:CellTypeTaxonomy ;
            owl:onProperty bican:is_palette_for ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bican:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bican:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty bican:xref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:is_palette_for ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:xref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bican:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty bican:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:is_palette_for ],
        bican:ProvEntity,
        <https://w3id.org/biolink/vocab/NamedThing> ;
    skos:definition "A schematic set of display colors that can be applied to individual components of the associated entity set (for example, a taxonomy)." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:ObservationMatrixCreationProcess a owl:Class ;
    rdfs:label "ObservationMatrixCreationProcess" ;
    rdfs:subClassOf bican:ProvActivity,
        <https://w3id.org/biolink/vocab/Procedure> ;
    skos:definition "The process of aggregating data to create an observation matrix (potentially virtual) for the purpose of dissemination or performing an analysis (such as clustering)." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:ObservationRow a owl:Class ;
    rdfs:label "ObservationRow" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bican:label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:part_of_matrix ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:MatrixFile ;
            owl:onProperty bican:represented_in ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:represented_in ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:represented_in ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:was_derived_from ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:label ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:ObservationMatrix ;
            owl:onProperty bican:part_of_matrix ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:xref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:part_of_matrix ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:CellSpecimen ;
            owl:onProperty bican:was_derived_from ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:label ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty bican:xref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:was_derived_from ],
        bican:ProvEntity,
        <https://w3id.org/biolink/vocab/NamedThing> ;
    skos:definition "One specific row of the observation matrix representing a set of measurements preformed on a sample over a set of variables or features." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:adj a owl:DatatypeProperty ;
    rdfs:label "adj" ;
    skos:definition "Proportion of composition found in Adjacent Regions" ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:authority a owl:ObjectProperty ;
    rdfs:label "authority" ;
    rdfs:range bican:AuthorityType ;
    skos:definition "The organization responsible for publishing the data." ;
    skos:inScheme <https://identifiers.org/brain-bican/genome-annotation-schema> .

bican:cell_type_set_type a owl:ObjectProperty ;
    rdfs:label "cell_type_set_type" ;
    skos:definition "A tag denoting the type or purpose of the cell type set." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:checksum_algorithm a owl:ObjectProperty ;
    rdfs:label "checksum algorithm" ;
    rdfs:range bican:DigestType ;
    skos:definition "The type of cryptographic hash function used to calculate the checksum value." ;
    skos:inScheme <https://identifiers.org/brain-bican/bican-core-schema> .

bican:color a owl:DatatypeProperty ;
    rdfs:label "color" ;
    skos:definition "A string representing to hex triplet code of a color" ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:color_hex_triplet a owl:DatatypeProperty ;
    rdfs:label "color_hex_triplet" ;
    skos:definition "A hex string representing the display color for an associated entity." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:entity_type a owl:ObjectProperty ;
    rdfs:label "entity_type" ;
    skos:definition "The entity type which the abbreviation term denotes." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:gpe a owl:DatatypeProperty ;
    rdfs:label "gpe" ;
    skos:definition "Proportion of composition found in External Globus Pallidus" ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:gpi a owl:DatatypeProperty ;
    rdfs:label "gpi" ;
    skos:definition "Proportion of composition found in Internal Globus Pallidus" ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:has_anatomical_annotation_set a owl:DatatypeProperty ;
    rdfs:label "has_anatomical_annotation_set" ;
    skos:definition "Reference to the anatomical annotation set component of the parcellation atlas" ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:has_anatomical_space a owl:DatatypeProperty ;
    rdfs:label "has_anatomical_space" ;
    skos:definition "Reference to the anatomical space component of the parcellation atlas" ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:has_parcellation_terminology a owl:DatatypeProperty ;
    rdfs:label "has_parcellation_terminology" ;
    skos:definition "Reference to the parcellation terminology component of the parcellation atlas" ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:has_parent_parcellation_term a owl:DatatypeProperty ;
    rdfs:label "has_parent_parcellation_term" ;
    skos:definition "Reference to the parent parcellation term for which the parcellation term is a child ( spatially part) of" ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:has_parent_parcellation_term_set a owl:DatatypeProperty ;
    rdfs:label "has_parent_parcellation_term_set" ;
    skos:definition "Reference to the parent parcellation term set for which the parcellation term set is a child  (lower taxonomic rank) of." ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:internal_identifier a owl:DatatypeProperty ;
    rdfs:label "internal_identifier" ;
    skos:definition "An identifier that uniquely denotes a specific parcellation annotation within the context of an anatomical annotation set" ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:is_color_for_set a owl:ObjectProperty ;
    rdfs:label "is_color_for_set" ;
    skos:definition "The associated cell type set of the specified display color." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:is_color_for_taxon a owl:ObjectProperty ;
    rdfs:label "is_color_for_taxon" ;
    skos:definition "The associated cell type taxon for the specified display color." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:is_palette_for a owl:ObjectProperty ;
    rdfs:label "is_palette_for" ;
    skos:definition "The cell types taxonomy for which the palette provides display color properties for." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:label a owl:DatatypeProperty ;
    rdfs:label "label" ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:meaning a owl:DatatypeProperty ;
    rdfs:label "meaning" ;
    skos:definition "The meaning of an abbreviation term." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:measures a owl:DatatypeProperty ;
    rdfs:label "measures" ;
    skos:definition "Reference to the specific image dataset used to define the anatomical space." ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:molecular_type a owl:DatatypeProperty ;
    rdfs:label "molecular_type" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( bican:BioType xsd:string ) ] ;
    skos:inScheme <https://identifiers.org/brain-bican/genome-annotation-schema> .

bican:number_of_cells a owl:DatatypeProperty ;
    rdfs:label "number_of_cells" ;
    skos:definition "The aggregated number of cells that defines the cell type taxon." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:number_of_observations a owl:DatatypeProperty ;
    rdfs:label "number_of_observations" ;
    skos:definition "The number of observations in the cluster." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:parameterizes a owl:DatatypeProperty ;
    rdfs:label "parameterizes" ;
    skos:definition "Reference to the anatomical space for which the anatomical annotation set is anchored" ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:part_of_anatomical_annotation_set a owl:DatatypeProperty ;
    rdfs:label "part_of_anatomical_annotation_set" ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:part_of_matrix a owl:ObjectProperty ;
    rdfs:label "part_of_matrix" ;
    skos:definition "The observation matrix for which is observation row is part of." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:part_of_palette a owl:ObjectProperty ;
    rdfs:label "part_of_palette" ;
    skos:definition "The color palette for which the display color map is part of." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:part_of_parcellation_color_scheme a owl:DatatypeProperty ;
    rdfs:label "part_of_parcellation_color_scheme" ;
    skos:definition "Reference to the parcellation color scheme for which the color assignment is part of." ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:part_of_parcellation_term_set a owl:DatatypeProperty ;
    rdfs:label "part_of_parcellation_term_set" ;
    skos:definition "Reference to the parcellation term set for which the parcellation term is part of." ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:part_of_parcellation_terminology a owl:DatatypeProperty ;
    rdfs:label "part_of_parcellation_terminology" ;
    skos:definition "Reference to the parcellation terminology for which the parcellation term set partitions." ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:part_of_set a owl:ObjectProperty ;
    rdfs:label "part_of_set" ;
    skos:definition "The cluster set from which the cluster is part of." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:reference_assembly a owl:DatatypeProperty ;
    rdfs:label "reference_assembly" ;
    skos:definition "The reference genome assembly that this genome annotation was created from." ;
    skos:inScheme <https://identifiers.org/brain-bican/genome-annotation-schema> .

bican:referenced_in a owl:DatatypeProperty ;
    rdfs:label "referenced_in" ;
    skos:definition "The genome annotation that this gene was referenced from." ;
    skos:inScheme <https://identifiers.org/brain-bican/genome-annotation-schema> .

bican:represented_in a owl:ObjectProperty ;
    rdfs:label "represented_in" ;
    skos:definition "The specific file where this observation row is represented." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:sn a owl:DatatypeProperty ;
    rdfs:label "sn" ;
    skos:definition "Proportion of composition found in Substantia Nigra" ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:source_id a owl:DatatypeProperty ;
    rdfs:label "source_id" ;
    skos:definition "The authority specific identifier." ;
    skos:inScheme <https://identifiers.org/brain-bican/genome-annotation-schema> .

bican:spatial_proportions_human a owl:ObjectProperty ;
    rdfs:label "spatial_proportions_human" ;
    skos:definition "Quantification of regional composition (how much of something is found in each named brain region) in Human species." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:spatial_proportions_macaque a owl:ObjectProperty ;
    rdfs:label "spatial_proportions_macaque" ;
    skos:definition "Quantification of regional composition (how much of something is found in each named brain region) in Macaque species." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:spatial_proportions_marmoset a owl:ObjectProperty ;
    rdfs:label "spatial_proportions_marmoset" ;
    skos:definition "Quantification of regional composition (how much of something is found in each named brain region) in Marmoset species." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:spatial_regional_proportions a owl:ObjectProperty ;
    rdfs:label "spatial_regional_proportions" ;
    skos:definition "Species-independent quantification of regional composition (how much of something is found in each named brain region)," ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:specialization_of a owl:DatatypeProperty ;
    rdfs:label "specialization_of" ;
    skos:definition "Reference to the general (non versioned) parcellation atlas for which the parcellation atlas is a specific  version release of." ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:sth a owl:DatatypeProperty ;
    rdfs:label "sth" ;
    skos:definition "Proportion of composition found in Subthalamic Nucleus" ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:str a owl:DatatypeProperty ;
    rdfs:label "str" ;
    skos:definition "Proportion of composition found in Striatum" ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:strain a owl:DatatypeProperty ;
    rdfs:label "strain" ;
    skos:definition "The genetic variant or subtype of a species or organism." ;
    skos:inScheme <https://identifiers.org/brain-bican/genome-annotation-schema> .

bican:subject_parcellation_annotation a owl:DatatypeProperty ;
    rdfs:label "subject_parcellation_annotation" ;
    skos:definition "Reference to the parcellation annotation that is the subject of the association." ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:subject_parcellation_terminology a owl:DatatypeProperty ;
    rdfs:label "subject_parcellation_terminology" ;
    skos:definition "Reference to the parcellation terminology for which the parcellation color scheme is in  context of." ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:symbol a owl:DatatypeProperty ;
    rdfs:label "symbol" ;
    skos:definition "Symbol representing a parcellation term." ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:term a owl:DatatypeProperty ;
    rdfs:label "term" ;
    skos:definition "An abbreviation term." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:unit a owl:ObjectProperty ;
    rdfs:label "unit" ;
    skos:definition "A controlled vocabulary attribute defining the length unit of the x, y, and z  resolution values." ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    skos:definition "The checksum value obtained from a specific cryotographic hash function." ;
    skos:inScheme <https://identifiers.org/brain-bican/bican-core-schema> .

bican:voxel_count a owl:DatatypeProperty ;
    rdfs:label "voxel_count" ;
    skos:definition "The number of voxels (3D pixels) spanned by the parcellation annotation (optional)." ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:x_direction a owl:ObjectProperty ;
    rdfs:label "x_direction" ;
    skos:definition "A controlled vocabulary attribute defining the x axis direction in terms of anatomical  direction." ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:x_resolution a owl:DatatypeProperty ;
    rdfs:label "x_resolution" ;
    skos:definition "The resolution (length / pixel) in along the x axis (numerical value part)." ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:x_size a owl:DatatypeProperty ;
    rdfs:label "x_size" ;
    skos:definition "The number of pixels/voxels (size) along the x axis." ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:y_direction a owl:ObjectProperty ;
    rdfs:label "y_direction" ;
    skos:definition "A controlled vocabulary attribute defining the y axis direction in terms of anatomical  direction." ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:y_resolution a owl:DatatypeProperty ;
    rdfs:label "y_resolution" ;
    skos:definition "The resolution (length / pixel) in along the y axis (numerical value part)." ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:y_size a owl:DatatypeProperty ;
    rdfs:label "y_size" ;
    skos:definition "The number of pixels/voxels (size) along the y axis." ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:z_direction a owl:ObjectProperty ;
    rdfs:label "z_direction" ;
    skos:definition "A controlled vocabulary attribute defining the z axis direction in terms of anatomical  direction." ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:z_resolution a owl:DatatypeProperty ;
    rdfs:label "z_resolution" ;
    skos:definition "The resolution (length / pixel) in along the z axis (numerical value part)." ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:z_size a owl:DatatypeProperty ;
    rdfs:label "z_size" ;
    skos:definition "The number of pixels/voxels (size) along the y axis." ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

