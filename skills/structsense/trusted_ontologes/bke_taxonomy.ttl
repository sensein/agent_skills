            owl:minCardinality 0 ;
            owl:onProperty bican:part_of_taxonomy ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:GeneAnnotation ;
            owl:onProperty bican:curated_markers_to_primates ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/biolink/vocab/name> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:contains_cluster ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:CellTypeTaxon ;
            owl:onProperty bican:has_parent ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty bican:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:SpatialProportions ;
            owl:onProperty bican:spatial_proportions_marmoset ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:SpatialProportions ;
            owl:onProperty bican:spatial_proportions_macaque ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:SpatialProportions ;
            owl:onProperty bican:spatial_proportions_human ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/biolink/vocab/name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:SpatialProportions ;
            owl:onProperty bican:spatial_regional_proportions ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:CellTypeTaxonomy ;
            owl:onProperty bican:part_of_taxonomy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:xref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:has_abbreviation ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:GeneAnnotation ;
            owl:onProperty bican:curated_markers_to_mouse ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:minInclusive "0.0" ] ) ] ) ] ;
            owl:onProperty bican:number_of_cells ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:Abbreviation ;
            owl:onProperty bican:has_abbreviation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:curated_markers_to_mouse ],
        [ a owl:Restriction ;
