            owl:maxCardinality 1 ;
            owl:onProperty bican:meaning ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:term ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bican:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bican:term ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:GeneAnnotation ;
            owl:onProperty bican:denotes_gene_annotation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:meaning ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:entity_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:term ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty bican:xref ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty bican:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:denotes_gene_annotation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bican:meaning ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:denotes_cell_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:CellTypeTaxon ;
            owl:onProperty bican:denotes_cell_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:denotes_parcellation_term ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:ParcellationTerm ;
            owl:onProperty bican:denotes_parcellation_term ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:entity_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:xref ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:AbbreviationEntityType ;
            owl:onProperty bican:entity_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:id ],
        bican:ProvEntity,
        <https://w3id.org/biolink/vocab/NamedThing> ;
    skos:definition "Maps an abbreviation string to its decoded meaning. Optionally the abbreviation can be link to one or more entities it denotes." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:AnatomicalAnnotationSet a owl:Class ;
    rdfs:label "AnatomicalAnnotationSet" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( bican:AnatomicalSpace xsd:string ) ] ;
            owl:onProperty bican:parameterizes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:revision_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:parameterizes ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty bican:parameterizes ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( bican:AnatomicalAnnotationSet xsd:string ) ] ;
            owl:onProperty bican:revision_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:revision_of ],
        bican:VersionedNamedThing ;
    skos:definition "An anatomical annotation set is a versioned release of a set of anatomical annotations anchored  in the same anatomical space that divides the space into distinct segments following some annotation  criteria or parcellation scheme. For example, the anatomical annotation set of 3D image based  reference atlases (e.g. Allen Mouse CCF) can be expressed as a set of label indices of single  multi-valued image annotations or as a set of segmentation masks (ref: ILX:0777108, RRID:SCR_023499)" ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:AnatomicalSpace a owl:Class ;
    rdfs:label "AnatomicalSpace" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( bican:ImageDataset xsd:string ) ] ;
            owl:onProperty bican:measures ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty bican:measures ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:revision_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( bican:AnatomicalSpace xsd:string ) ] ;
            owl:onProperty bican:revision_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:revision_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:measures ],
        bican:VersionedNamedThing ;
    skos:definition "An anatomical space is versioned release of a mathematical space with a defined mapping  between the anatomical axes and the mathematical axes. An anatomical space may be defined by  a reference image chosen as the biological reference for an anatomical structure of interest  derived from a single or multiple specimens (ref: ILX:0777106, RRID:SCR_023499)" ;
    skos:inScheme <https://identifiers.org/brain-bican/anatomical-structure-schema> .

bican:CellSpecimen a owl:Class ;
    rdfs:label "CellSpecimen" ;
    rdfs:subClassOf bican:ProvEntity,
        <https://w3id.org/biolink/vocab/NamedThing> ;
    skos:definition "( defined as in BERS)" ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:DigestType a owl:Class ;
    owl:unionOf ( <http://spdx.org/rdf/terms#checksumAlgorithm_sha1> <http://spdx.org/rdf/terms#checksumAlgorithm_md5> <http://spdx.org/rdf/terms#checksumAlgorithm_sha256> ) ;
    linkml:permissible_values <http://spdx.org/rdf/terms#checksumAlgorithm_md5>,
        <http://spdx.org/rdf/terms#checksumAlgorithm_sha1>,
        <http://spdx.org/rdf/terms#checksumAlgorithm_sha256> .

bican:ObservationMatrix a owl:Class ;
    rdfs:label "ObservationMatrix" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:represented_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:xref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bican:content_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:has_variable ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:was_derived_from ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:ObservationMatrixCreationProcess ;
            owl:onProperty bican:was_generated_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty bican:xref ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:GeneAnnotation ;
            owl:onProperty bican:has_variable ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:was_generated_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:MatrixFile ;
            owl:onProperty bican:represented_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:CellSpecimen ;
            owl:onProperty bican:was_derived_from ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:was_generated_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:content_url ],
        bican:ProvEntity,
        <https://w3id.org/biolink/vocab/NamedThing> ;
    skos:definition "A matrix (potentially virtual) of observations. Each row represents a specific observation or measurements on specific sample (such as a cell) over a set of variables or features. Each column represents the set of measurements (such as gene expression) of a specific variable (such as gene) over all samples." ;
    skos:inScheme <https://w3id.org/brain-bican/bke-taxonomy> .

bican:ProvActivity a owl:Class ;
    rdfs:label "ProvActivity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bican:used ],
        [ a owl:Restriction ;
            owl:allValuesFrom bican:ProvEntity ;
            owl:onProperty bican:used ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bican:used ] ;
    skos:definition "An activity is something that occurs over a period of time and acts upon or with entities;  it may include consuming, processing, transforming, modifying, relocating, using, or generating entities." ;
    skos:exactMatch prov:Activity ;
    skos:inScheme <https://identifiers.org/brain-bican/bican-prov-schema> .

