        <http://loinc.org/rdf/has_object_guidance>,
        <http://loinc.org/rdf/has_scale>,
        <http://loinc.org/rdf/has_suffix>,
        <http://loinc.org/rdf/has_time_aspect>,
        <http://loinc.org/rdf/has_time_modifier>,
        <http://loinc.org/rdf/has_timing_of>,
        <http://purl.obolibrary.org/obo/INO_0000154>,
        <http://purl.obolibrary.org/obo/RO_0000053>,
        <http://purl.obolibrary.org/obo/RO_0000086>,
        <http://purl.obolibrary.org/obo/RO_0000087>,
        <http://purl.org/oban/association_has_object_property>,
        <http://purl.org/oban/association_has_subject_property>,
