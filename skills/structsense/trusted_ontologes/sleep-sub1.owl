    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#CircadianRhythmSleepWakeDisorders -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#CircadianRhythmSleepWakeDisorders">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#SleepDisorder"/>
        <Concept_name>Sleep Disorders, Circadian Rhythm</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10012</Sleep_ID>
        <UMLS_CUI>C0877792</UMLS_CUI>
        <definition>Dyssomnias associated with disruption of the normal 24 hour sleep wake cycle secondary to travel (e.g., JET LAG SYNDROME), shift work, or other causes.</definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Co-Sleeping -->

