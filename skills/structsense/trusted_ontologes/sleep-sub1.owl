    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#definition"/>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#creator -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#creator"/>
    


