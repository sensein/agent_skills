        <Concept_name>Irregular sleep/wake cycle</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10048</Sleep_ID>
        <UMLS_CUI>C5194377</UMLS_CUI>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#IrregularSleepWakePattern -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#IrregularSleepWakePattern">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#SleepPattern"/>
        <Concept_name>Irregular sleep-wake pattern</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10049</Sleep_ID>
        <UMLS_CUI>C0393771</UMLS_CUI>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#KleineLevinSyndrome -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#KleineLevinSyndrome">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#CentralDisordersOfHypersomnolence"/>
        <Concept_name>Kleine-Levin Syndrome</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10051</Sleep_ID>
        <UMLS_CUI>C0206085</UMLS_CUI>
        <definition>A rare disorder characterized by episodes of excessive sleep and behavioral alterations while awake. It affects predominantly males. The individuals exhibit normal behavior between episodes.</definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#LifestylePattern -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#LifestylePattern">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#AffectingFactor"/>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10052</Sleep_ID>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Lighting -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Lighting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#EnvironmentalFactor"/>
        <Concept_name>Light intensity</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10053</Sleep_ID>
        <UMLS_CUI>C0596836</UMLS_CUI>
        <definition>Level or amount of energy being emitted by either a natural (e.g. sun) or an artificial source of light.</definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#ListeningToWhiteNoise -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#ListeningToWhiteNoise">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#BedtimeRitual"/>
        <Concept_name>Listening; white noise</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10124</Sleep_ID>
        <UMLS_CUI>C2584303; C0871956</UMLS_CUI>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#LossOfCognitiveFunction -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#LossOfCognitiveFunction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#EffectsOfPoorSleep"/>
        <Concept_name>Effect; Cognitive functions</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10026</Sleep_ID>
        <UMLS_CUI>C1280500; C0392335</UMLS_CUI>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Massage -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Massage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#BedtimeRitual"/>
        <Concept_name>Massage</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10123</Sleep_ID>
        <UMLS_CUI>C0024875</UMLS_CUI>
        <definition>The systematic and methodical manipulations of body tissues best performed with the hands for the purpose of affecting the nervous and muscular systems and the general circulation.</definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#MedicineOrSupplement -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#MedicineOrSupplement">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#SleepAid"/>
        <Concept_name>Medications; Supplement</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10055</Sleep_ID>
        <UMLS_CUI>C4284232; C2348609</UMLS_CUI>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Meditation -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Meditation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#BedtimeRitual"/>
        <Concept_name>meditation</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10120</Sleep_ID>
        <UMLS_CUI>C0150277</UMLS_CUI>
        <definition>A state of consciousness in which the individual eliminates environmental stimuli from awareness so that the mind can focus on a single thing, producing a state of relaxation and relief from stress. A wide variety of techniques are used to clear the mind of stressful outside interferences. It includes meditation therapy.</definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#NREMRelatedParasomnias -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#NREMRelatedParasomnias">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Parasomnias"/>
        <Concept_name>Non-rapid eye movement parasomnia</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10060</Sleep_ID>
        <UMLS_CUI>C4476680</UMLS_CUI>
        <definition>A parasomnia that occurs in non-rapid eye movement (NREM) sleep. This refers to a disorder of arousal that occurs during slow-wave sleep (ie, NREM stage 3 sleep).</definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Narcolepsy -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Narcolepsy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#CentralDisordersOfHypersomnolence"/>
        <Concept_name>Narcolepsy</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10057</Sleep_ID>
        <UMLS_CUI>C0027404</UMLS_CUI>
        <definition>An abnormal phenomenon characterized by a classic tetrad of excessive daytime sleepiness with irresistible sleep attacks, cataplexy (sudden bilateral loss of muscle tone), hypnagogic hallucination, and sleep paralysis.</definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#NicotineConsumption -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#NicotineConsumption">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#LifestylePattern"/>
        <Concept_name>Cigarette consumption</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10119</Sleep_ID>
        <UMLS_CUI>C0459840</UMLS_CUI>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Noise -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Noise">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#EnvironmentalFactor"/>
        <Concept_name>Sound intensity</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10099</Sleep_ID>
        <UMLS_CUI>C2371706</UMLS_CUI>
        <definition>Level or volume of auditory phenomenon determined by the amount of energy being generated, where high energy levels are perceived as loud sounds and low energy levels as soft sounds.</definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#NonRapidEyeMovement -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#NonRapidEyeMovement">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#SleepStage"/>
        <Concept_name>Sleep, Slow-Wave</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10058</Sleep_ID>
        <UMLS_CUI>C0234451</UMLS_CUI>
        <definition>A stage of sleep characterized by synchronized wave activity as observed in the ELECTROENCEPHALOGRAM; the waves exhibit a frequency of 0.5 to 2 Hz, and a peak-to-peak amplitude greater than 75 microvolts.</definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#NormalSleepWakePattern -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#NormalSleepWakePattern">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#SleepPattern"/>
        <Concept_name>Normal sleep-wake patterns</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10059</Sleep_ID>
        <UMLS_CUI>C0517754</UMLS_CUI>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#ObstructiveSleepApneaDisorders -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#ObstructiveSleepApneaDisorders">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#SleepRelatedBreathingDisorders"/>
        <Concept_name>Sleep Apnea, Obstructive</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10061</Sleep_ID>
        <UMLS_CUI>C0520679</UMLS_CUI>
        <definition>A disorder characterized by recurrent apneas during sleep despite persistent respiratory efforts. It is due to upper airway obstruction. The respiratory pauses may induce HYPERCAPNIA or HYPOXIA. Cardiac arrhythmias and elevation of systemic and pulmonary arterial pressures may occur. Frequent partial arousals occur throughout sleep, resulting in relative SLEEP DEPRIVATION and daytime tiredness. Associated conditions include OBESITY; ACROMEGALY; MYXEDEMA; micrognathia; MYOTONIC DYSTROPHY; adenotonsilar dystrophy; and NEUROMUSCULAR DISEASES.</definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#OtherHypersomnias -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#OtherHypersomnias">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#CentralDisordersOfHypersomnolence"/>
        <Concept_name>Other hypersomnia</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10062</Sleep_ID>
        <UMLS_CUI>C0029637</UMLS_CUI>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#OtherParasomnias -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#OtherParasomnias">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Parasomnias"/>
        <Concept_name>Other parasomnia</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10063</Sleep_ID>
        <UMLS_CUI>C2875258</UMLS_CUI>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Pain -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Pain">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#PhysicalFactor"/>
        <Concept_name>Pain</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10064</Sleep_ID>
        <UMLS_CUI>C0030193</UMLS_CUI>
        <definition>An unpleasant sensory and emotional experience associated with actual or potential tissue damage, or described in terms of such damage.</definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Parasomnias -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Parasomnias">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#SleepDisorder"/>
        <Concept_name>Parasomnia</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10065</Sleep_ID>
        <UMLS_CUI>C0030508</UMLS_CUI>
        <definition>Movements or behaviors associated with sleep, sleep stages, or partial arousals from sleep that may impair sleep maintenance. Parasomnias are generally divided into four groups: arousal disorders, sleep-wake transition disorders, parasomnias of REM sleep, and nonspecific parasomnias.</definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#PeriodicLimbMovementDisorder -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#PeriodicLimbMovementDisorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#SleepRelatedMovementDisorders"/>
        <Concept_name>Periodic limb movement sleep disorder</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10066</Sleep_ID>
        <UMLS_CUI>C1561887</UMLS_CUI>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#PhysicalFactor -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#PhysicalFactor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#AffectingFactor"/>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10067</Sleep_ID>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Polysomnography -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Polysomnography">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#SleepAssessmentTest"/>
        <Concept_name>Polysomnography</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10068</Sleep_ID>
        <UMLS_CUI>C0162701</UMLS_CUI>
        <definition>Simultaneous and continuous monitoring of several parameters during sleep to study normal and abnormal sleep. The study includes monitoring of brain waves, to assess sleep stages, and other physiological variables such as breathing, eye movements, and blood oxygen levels which exhibit a disrupted pattern with sleep disturbances.</definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#PoorSleepPattern -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#PoorSleepPattern">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#SleepPattern"/>
        <Concept_name>Poor sleep pattern</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10069</Sleep_ID>
        <UMLS_CUI>C1277595</UMLS_CUI>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Pruritus -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Pruritus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#PhysicalFactor"/>
        <Concept_name>Pruritus</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10070</Sleep_ID>
        <UMLS_CUI>C0033774</UMLS_CUI>
        <definition>An intense itching sensation that produces the urge to rub or scratch the skin to obtain relief.</definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#PsychologicalFactor -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#PsychologicalFactor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#AffectingFactor"/>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10071</Sleep_ID>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#PulseOximetry -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#PulseOximetry">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Polysomnography"/>
        <Concept_name>Oximetry, Pulse</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10072</Sleep_ID>
        <UMLS_CUI>C0034108</UMLS_CUI>
        <definition>A non-invasive method that provides estimates of arterial oxyhemoglobin saturation by utilizing selected wavelengths of light to determine the saturation of oxyhemoglobin.</definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#REMRelatedParasomnias -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#REMRelatedParasomnias">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Parasomnias"/>
        <Concept_name>REM Sleep Parasomnias</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10074</Sleep_ID>
        <UMLS_CUI>C0752301</UMLS_CUI>
        <definition>Abnormal behavioral or physiologic events that are associated with REM sleep, including REM SLEEP BEHAVIOR DISORDER.</definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#RapidEyeMovement -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#RapidEyeMovement">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#SleepStage"/>
        <Concept_name>Sleep, REM</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10073</Sleep_ID>
        <UMLS_CUI>C0037322</UMLS_CUI>
        <definition>A stage of sleep characterized by rapid movements of the eye and low voltage fast pattern EEG. It is usually associated with dreaming.</definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#RestlessLegsSyndrome -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#RestlessLegsSyndrome">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#SleepRelatedMovementDisorders"/>
        <Concept_name>Restless Legs Syndrome</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10075</Sleep_ID>
        <UMLS_CUI>C0035258</UMLS_CUI>
        <definition>A disorder characterized by aching or burning sensations in the lower and rarely the upper extremities that occur prior to sleep or may awaken the patient from sleep.</definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#ShiftWork -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#ShiftWork">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#LifestylePattern"/>
