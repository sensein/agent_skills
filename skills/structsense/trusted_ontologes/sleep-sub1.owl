    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#SNOMEDCT_ID"/>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Sleep_ID -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Sleep_ID"/>
    


