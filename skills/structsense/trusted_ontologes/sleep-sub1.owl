        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10003</Sleep_ID>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#AlcoholConsumption -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#AlcoholConsumption">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#LifestylePattern"/>
        <Concept_name>Alcohol consumption</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10118</Sleep_ID>
        <UMLS_CUI>C0001948</UMLS_CUI>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Anxiety -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Anxiety">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#PsychologicalFactor"/>
        <Concept_name>Anxiety</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10005</Sleep_ID>
        <UMLS_CUI>C0003467</UMLS_CUI>
        <definition>Emotional tension or energy characterized by unexplained feelings of apprehension, uneasiness or dread associated to an anticipated, actual or imagined stressor.</definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#AttributeOfSleep -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#AttributeOfSleep">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Sleep"/>
