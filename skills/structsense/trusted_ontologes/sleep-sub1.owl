        <UMLS_CUI>C0344315</UMLS_CUI>
        <definition>An emotional state characterized by feelings of sadness, emptiness, and/or tearfulness.</definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#EffectOnDailyFunction -->

