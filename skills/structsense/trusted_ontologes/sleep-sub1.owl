    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Insomnia -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Insomnia">
