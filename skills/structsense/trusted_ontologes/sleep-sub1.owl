        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10046</Sleep_ID>
        <UMLS_CUI>C0917801</UMLS_CUI>
        <definition>Persistent difficulty initiating or maintaining sleep.</definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#InsufficientPhysicalRecovery -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#InsufficientPhysicalRecovery">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#EffectsOfPoorSleep"/>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10028</Sleep_ID>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#IrregularSleepWakeCycle -->

