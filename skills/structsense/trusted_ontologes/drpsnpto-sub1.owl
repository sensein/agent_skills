        <rdfs:label xml:lang="en">Mental Status Assessment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MetabolicDisorder -->

