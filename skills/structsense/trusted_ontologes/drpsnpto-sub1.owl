SNOMEDCT:69690008</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Hypnapompic Hallucination</ncit4:synonym>
        <umls5:cui xml:lang="en">C0424082</umls5:cui>
        <rdfs:label xml:lang="en">Hypnopompic Hallucination</rdfs:label>
        <skos:definition xml:lang="en">It refers to the &quot;hallucinations that occur during the period of awakening, most commonly of the visual, tactile or auditory modatlity.&quot; (ICD-11)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IdentificationOfNonpharmacologicalTreatment -->

