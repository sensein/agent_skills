        <umls5:cui xml:lang="en">C4713273</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the activity of identifying the appropriate nonpharmacological treatment for a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Identification of Nonpharmacological Treatment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IdentifyingAntecedentOfBehaviour -->

