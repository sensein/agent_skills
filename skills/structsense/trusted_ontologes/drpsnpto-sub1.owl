        <rdfs:comment xml:lang="en">It refers to the activity that health care professionals identify the events that follow the behaviour, such as who is negatively affected.</rdfs:comment>
        <rdfs:label xml:lang="en">Identifying Consequence of Behaviour</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ImmigrantGenerationStatus -->

