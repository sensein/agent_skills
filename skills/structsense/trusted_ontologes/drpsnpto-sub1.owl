        <umls5:cui xml:lang="en">C4061117</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the concept that inadequate lighting may make visual clues less clear, and then cause the presence of psychotic symptoms.</rdfs:comment>
        <rdfs:label xml:lang="en">Inadequate Lighting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/InappropriateDressing -->

