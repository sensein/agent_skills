        <umls5:cui xml:lang="en">C0017319</umls5:cui>
        <rdfs:comment xml:lang="en">MESH 2020 &quot;Physicians whose practice is not restriced to a specific field of medicine.&quot;</rdfs:comment>
        <rdfs:label xml:lang="en">General Practitioner</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneticPredisposition -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneticPredisposition">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IntrapersonalCausativeFactor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/causes"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Delusion"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit4:crossReference xml:lang="en">MESH:D020022
SNOMEDCT:47708004</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Genetic Susceptibility, Genetic Predisposition to Disease, Inherited Predisposition, Inherited Susceptibility,</ncit4:synonym>
        <umls5:cui xml:lang="en">C0314657</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the genetic characteristics that increase the probability of having a disease or disorder.</rdfs:comment>
        <rdfs:label xml:lang="en">Genetic Predisposition</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Geriatrician -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Geriatrician">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
        <ncit4:crossReference xml:lang="en">MESH:D000072219
SNOMEDCT:90655003</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Geriatric Specialist, Gerontologist, Care of the Elderly Physician</ncit4:synonym>
        <umls5:cui xml:lang="en">C0586872</umls5:cui>
        <rdfs:label xml:lang="en">Geriatrician</rdfs:label>
        <skos:definition xml:lang="en">MESH:&quot;Physicians specializing in physiological and pathological aspects of aging and the aged, including the clinical problems of senescence and senility.&quot;</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Gesture -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Gesture">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyNonaggressiveBehaviour"/>
        <ncit4:crossReference xml:lang="en">MESH:D005868</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0017510</umls5:cui>
        <rdfs:label xml:lang="en">Gesture</rdfs:label>
        <skos:definition xml:lang="en">&quot;Movement of a part of the body for the purpose of communication.&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GivenName -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GivenName">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonName"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:408677003</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Forename, First Name</ncit4:synonym>
        <umls5:cui xml:lang="en">C1443235</umls5:cui>
        <rdfs:label xml:lang="en">Given Name</rdfs:label>
        <skos:definition xml:lang="en">&quot;Personal name used with a family name to form a full name.&quot; (SNOMEDCT)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GivingInformation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GivingInformation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CommunicatingActionSuggested"/>
        <ncit4:synonym xml:lang="en">Informing</ncit4:synonym>
        <umls5:cui xml:lang="en">C0700287</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the communication technique that health care professionals should always give a person with dementia the information about what he/she will do and how he/she will do it and why he/she need to do it.</rdfs:comment>
        <rdfs:label xml:lang="en">Giving Information</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GlasgowComaAssessment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GlasgowComaAssessment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ComprehensiveInitialAssessment"/>
        <rdfs:comment xml:lang="en">It refers to the actions performed to assess the response to stimuli in patients with craniocerebral injuries.</rdfs:comment>
        <rdfs:label xml:lang="en">Glasgow Coma Assessment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Glaucoma -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Glaucoma">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MedicalIllness"/>
        <ncit4:crossReference xml:lang="en">MESH:D005901
SNOMEDCT:23986001</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0017601</umls5:cui>
        <rdfs:label xml:lang="en">Glaucoma</rdfs:label>
        <skos:definition xml:lang="en">MESH: &quot;An ocular disease, occurring in many forms, having as its primary characteristics an unstable or a sustained increase in the intraocular pressure which the eye cannot withstand without damage to its structure or impairment of its function.&quot;</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GoalAchieved -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GoalAchieved">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomManagementOutcome"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:390802008</ncit4:crossReference>
        <umls5:cui xml:lang="en">C1272277</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the outcome that the goal has been achieved.</rdfs:comment>
        <rdfs:label xml:lang="en">Goal Achieved</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GoalNotAchieved -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GoalNotAchieved">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomManagementOutcome"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:390801001</ncit4:crossReference>
        <umls5:cui xml:lang="en">C1272276</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the outcome that the goal has not been achieved.</rdfs:comment>
        <rdfs:label xml:lang="en">Goal Not Achieved</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Grabbing -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Grabbing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyAggressiveBehaviour"/>
        <umls5:cui xml:lang="en">C4715140</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the behaviour of grasping suddenly and roughly.</rdfs:comment>
        <rdfs:label xml:lang="en">Grabbing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Granddaughter -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Granddaughter">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyMember"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:44181008</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Grand Daughter</ncit4:synonym>
        <umls5:cui xml:lang="en">C0337561</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to a female grandchild of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Granddaughter</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Grandfather -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Grandfather">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyMember"/>
        <ncit4:crossReference xml:lang="en">MESH:D000066502
SNOMEDCT:34871008</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Grandpa</ncit4:synonym>
        <umls5:cui xml:lang="en">C0337475</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the father of a person&apos;s father or mother.</rdfs:comment>
        <rdfs:label xml:lang="en">Grandfather</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GrandioseDelusion -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GrandioseDelusion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Delusion"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:247667002</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Grandiosity, Delusion of Grandeur, Grandiose Delusion Disorder</ncit4:synonym>
        <umls5:cui xml:lang="en">C0233681</umls5:cui>
        <rdfs:label xml:lang="en">Grandiose Delusion</rdfs:label>
        <skos:definition xml:lang="en">&quot;A delusion of inflated worth, power, knowledge, identity, or special relationship to a deity or famous person.&quot; (ICD-11)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Grandmother -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Grandmother">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyMember"/>
        <ncit4:crossReference xml:lang="en">MESH:D000066502
SNOMEDCT:113157001</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Grandma, Grand Mother</ncit4:synonym>
        <umls5:cui xml:lang="en">C0337474</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the mother of a person&apos;s father or mother.</rdfs:comment>
        <rdfs:label xml:lang="en">Grandmother</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Grandson -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Grandson">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyMember"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:70578009</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Grand Son</ncit4:synonym>
        <umls5:cui xml:lang="en">C0337573</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to a male grandchild of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Grandson</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Groaning -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Groaning">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VerballyNonaggressiveBehaviour"/>
        <umls5:cui xml:lang="en">C4552524</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the behaviour of making a deep inarticulate sound.</rdfs:comment>
        <rdfs:label xml:lang="en">Groaning</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GroupExercise -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GroupExercise">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Exercise"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:361182006</ncit4:crossReference>
        <umls5:cui xml:lang="en">C1276393</umls5:cui>
        <rdfs:label xml:lang="en">Group Exercise</rdfs:label>
        <skos:definition xml:lang="en">It refers to the intervention that a workout is led by an instructor or trainer in a group setting.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Grunting -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Grunting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VerballyNonaggressiveBehaviour"/>
        <umls5:cui xml:lang="en">C0234892</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the behaviour of making a low, short guttural sound.</rdfs:comment>
        <rdfs:label xml:lang="en">Grunting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Guardian -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Guardian">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isGuardianOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonWithDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit4:crossReference xml:lang="en">MESH:D007872
SNOMEDCT:58626002</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Legal Guardian</ncit4:synonym>
        <umls5:cui xml:lang="en">C0023226</umls5:cui>
        <rdfs:label xml:lang="en">Guardian</rdfs:label>
        <skos:definition xml:lang="en">&quot;An individual who is authorized under applicable State or local law to consent on behalf of a child or incapable person to general medical care including participation in clinical research.&quot; - National Cancer Institute</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GustatoryHallucination -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GustatoryHallucination">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Hallucination"/>
        <ncit4:crossReference xml:lang="en">MESH:D006212
SNOMEDCT:29139005</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Taste Hallucination</ncit4:synonym>
        <umls5:cui xml:lang="en">C0233766</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the &quot;hallucinations of taste in the absence of an actual external stimulus.&quot; (ICD-11)</rdfs:comment>
        <rdfs:label xml:lang="en">Gustatory Hallucination</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HairCarePreference -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HairCarePreference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonalHygienePreference"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:304219007</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0582056</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the preference to hair care, such as preference for using oil on hair.</rdfs:comment>
        <rdfs:label xml:lang="en">Hair Care Preference</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Hallucination -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Hallucination">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isHallucinationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonWithDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit4:crossReference xml:lang="en">MESH:D006212
SNOMEDCT:7011001</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0018524</umls5:cui>
        <rdfs:label xml:lang="en">Hallucination</rdfs:label>
        <skos:definition xml:lang="en">&quot;Sensory perceptions of any modality occuring in the absence of the appropriate (external) stimulus. The person may or may not have insight into the unreal nature of the perception.&quot; (ICD-11)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HallucinogenAddiction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HallucinogenAddiction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Addiction"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:38247002</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Hallucinogen Dependence</ncit4:synonym>
        <umls5:cui xml:lang="en">C0018528</umls5:cui>
        <rdfs:label xml:lang="en">Hallucinogen Addiction</rdfs:label>
        <skos:definition xml:lang="en">&quot;A drug dependence for a hallucinogenic substance.&quot; (National Cancer Institute)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HandPreference -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HandPreference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Preferenece"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:246559009</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0422881</umls5:cui>
        <rdfs:label xml:lang="en">Hand Preference</rdfs:label>
        <skos:definition xml:lang="en">Hand Preference is &quot;the tendency to be more skilled and comfortable using one hand instead of the other for tasks such as writing and throwing a ball.&quot; (MEDLINEPLUS)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HandWringing -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HandWringing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyNonaggressiveBehaviour"/>
        <ncit4:synonym xml:lang="en">Hand Rubbing</ncit4:synonym>
        <umls5:cui xml:lang="en">C0239846</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the behaviour of constant twisting of the hands of a person as an expression of distress or concern.</rdfs:comment>
        <rdfs:label xml:lang="en">Hand Wringing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HarmToSelf -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HarmToSelf">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EffectOfPsychoticSymptom"/>
        <rdfs:comment xml:lang="en">It refers to the harm of dementia-related psychotic symptoms to oneself.</rdfs:comment>
        <rdfs:label xml:lang="en">Harm to Self</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HavingHaircut -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HavingHaircut">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RecreationalActivity"/>
        <rdfs:comment xml:lang="en">It refers to the intervention of having a haircut.</rdfs:comment>
        <rdfs:label xml:lang="en">Having Haircut</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HavingRegularRoutine -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HavingRegularRoutine">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SocialEnvironmentalIntervention"/>
        <rdfs:comment xml:lang="en">It refers to the intervention of having a regular routine for a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Having Regular Routine</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HavingRegularStaff -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HavingRegularStaff">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SocialEnvironmentalIntervention"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:225788005</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Regular Daily Routine</ncit4:synonym>
        <umls5:cui xml:lang="en">C0562339</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the intervention of having consistent and regular staff for providing care to a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Having Regular Staff</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HavingSpareSetOfCertainItem -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HavingSpareSetOfCertainItem">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneralNursingCareIntervention"/>
        <rdfs:comment xml:lang="en">It refers to the intervention of preparing a spare set of items that are often mislaid such as eyeglasses.</rdfs:comment>
        <rdfs:label xml:lang="en">Having Spare Set of Certain Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Headache -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Headache">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Pain"/>
        <ncit4:crossReference xml:lang="en">MESH:D006261
SNOMEDCT:25064002</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Head Pain, Cranial Pain, Cephalalgia, Cephalgia</ncit4:synonym>
        <umls5:cui xml:lang="en">C0018681</umls5:cui>
        <rdfs:label xml:lang="en">Headache</rdfs:label>
        <skos:definition xml:lang="en">&quot;The symptom of pain in the cranial region. It may be an isolated benign occurrence or manifestation of a wide variety of headache disorders.&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/caresFor"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonWithDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/conducts"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomManagementActivity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasCareGoal"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CareGoal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasCommunicationSkill"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CommunicationSkill"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/usesTool"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomAssessmentTool"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:223366009</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Health Professional, Healthcare Professional</ncit4:synonym>
        <umls5:cui xml:lang="en">C1704312</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to all service providers working within the context of the health system, such as doctors, nurses, physiotherapists and medical social workers.</rdfs:comment>
        <rdfs:label xml:lang="en">Health Care Professional</rdfs:label>
    </owl:Class>
    


