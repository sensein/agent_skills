        <umls5:cui xml:lang="en">C0221423</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the medical condition that normally receives medical treatment.</rdfs:comment>
        <rdfs:label xml:lang="en">Medical Illness</rdfs:label>
    </owl:Class>
    


