    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BaylorHallucinationQuestionnaire"/>
