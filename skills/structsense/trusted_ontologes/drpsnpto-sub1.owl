            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">It refers to the distinctive attributes of psychotic symptoms in dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Feature of Psychotic Symptom</rdfs:label>
    </owl:Class>
    


