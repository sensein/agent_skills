        <rdfs:label xml:lang="en">Marital Status</rdfs:label>
        <skos:definition xml:lang="en">&quot;A demographic parameter indicating a person&apos;s status with respect to marriage, divorce, widowhood, singleness, etc.&quot; (MESH)</skos:definition>
    </owl:Class>
    


