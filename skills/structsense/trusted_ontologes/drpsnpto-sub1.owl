        <umls5:cui xml:lang="en">C0016470</umls5:cui>
        <rdfs:label xml:lang="en">Food Allergy</rdfs:label>
        <skos:definition xml:lang="en">&quot;Food allergy is an abnormal response to a food triggered by human body&apos;s immune system.&quot; (MEDLINEPLUS)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FoodPreference -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FoodPreference">
