        <rdfs:comment xml:lang="en">It refers to the constant and unending talking.</rdfs:comment>
        <rdfs:label xml:lang="en">Ceaseless Talking</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CeradBehaviorRatingScaleForDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CeradBehaviorRatingScaleForDementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomAssessmentTool"/>
        <ncit4:abbreviation xml:lang="en">BRSD</ncit4:abbreviation>
        <rdfs:comment xml:lang="en">The CERAD (Consortium to Establish a Registry for Alzheimer&apos;s Disease) Behavior Rating Scale for Demenita is a standardized instrument for rating behavioral abnormalities in demented or cognitively impaired people.</rdfs:comment>
        <rdfs:label xml:lang="en">CERAD Behavior Rating Scale for Dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ChangeInRoutine -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ChangeInRoutine">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EnvironmentalCausativeFactor"/>
        <ncit4:synonym xml:lang="en">Disruption of Familiar Routine</ncit4:synonym>
        <rdfs:comment xml:lang="en">It refers to the changes in the routine which can cause psychotic symptoms in dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Change in Routine</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CheckingHearingAid -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CheckingHearingAid">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneralNursingCareIntervention"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:225678000</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Hearing Aid Check</ncit4:synonym>
        <umls5:cui xml:lang="en">C0455223</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the interim checks to confirm that hearing aids are clean and operational.</rdfs:comment>
        <rdfs:label xml:lang="en">Checking Hearing Aid</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CholesterolLevel -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CholesterolLevel">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MedicalHistory"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:365793008</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0428466</umls5:cui>
        <rdfs:label xml:lang="en">Cholesterol Level</rdfs:label>
        <skos:definition xml:lang="en">It refers to the amount of each type of cholesterol (low-density lipoprotein and high-density lipoprotein) and certain fats in one&apos;s blood. (MEDLINEPLUS)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ChronicDisease -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ChronicDisease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MedicalHistory"/>
        <ncit4:crossReference xml:lang="en">MESH:D002908
SNOMEDCT:27624003</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Chronic Illness</ncit4:synonym>
        <umls5:cui xml:lang="en">C0008679</umls5:cui>
        <rdfs:label xml:lang="en">Chronic Disease</rdfs:label>
        <skos:definition xml:lang="en">&quot;A disease condition that persists over a significant span of time.&quot; (National Cancer Institute)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ClinicalGlobalImpressionScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ClinicalGlobalImpressionScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomAssessmentTool"/>
        <ncit4:abbreviation xml:lang="en">CGIS</ncit4:abbreviation>
        <umls5:cui xml:lang="en">C3639708</umls5:cui>
        <rdfs:label xml:lang="en">Clinical Global Impression Scale</rdfs:label>
        <skos:definition xml:lang="en">&quot;A standardized survey developed by W. Guy in 1976 which is used to evaluate the efficacy of a therapeutic intervention. This instrument consists of 3 sections pertaining to the severity of the patient&apos;s illness, their level of improvement and a comparison of the therapeutic effect versus the side effects.&quot; - National Cancer Institute</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CloseSupervision -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CloseSupervision">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneralNursingCareIntervention"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:225312004</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0557988</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the activity of supervising a person closely.</rdfs:comment>
        <rdfs:label xml:lang="en">Close Supervision</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ClothingPreference -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ClothingPreference">
