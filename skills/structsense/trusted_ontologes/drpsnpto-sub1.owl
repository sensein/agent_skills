        <rdfs:comment xml:lang="en">It refers to the type of immigration.</rdfs:comment>
        <rdfs:label xml:lang="en">Immigration Type</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/InadequateLighting -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/InadequateLighting">
