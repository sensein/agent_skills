    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AbilityToPerformActivitiesOfDailyLife -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AbilityToPerformActivitiesOfDailyLife">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RemainingAbility"/>
        <ncit4:synonym xml:lang="en">Ability to Perform ADL</ncit4:synonym>
        <umls5:cui xml:lang="en">C0562507</umls5:cui>
        <rdfs:label xml:lang="en">Ability to Perform Activities of Daily Life</rdfs:label>
        <skos:definition xml:lang="en">It refers to the ability to perform the most basic physical tasks and personal care activities independently with or without assistive device. (Nursing Outcomes Classification)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AboriginalPerson -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AboriginalPerson">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DemographicInformation"/>
        <ncit4:synonym xml:lang="en">Aboriginals</ncit4:synonym>
        <umls5:cui xml:lang="en">C0935542</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the information about a person that if he/she is aboriginal.</rdfs:comment>
        <rdfs:label xml:lang="en">Aboriginal Person</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Absconding -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Absconding">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyNonaggressiveBehaviour"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:248046000</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Running Away, Wandering Off the Facility</ncit4:synonym>
        <umls5:cui xml:lang="en">C0424352</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the behaviour of a resident leaving secretly from the long-term care facility which he/she lives.</rdfs:comment>
        <rdfs:label xml:lang="en">Absconding</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AcknowledgementOfFeeling -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AcknowledgementOfFeeling">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneralNursingCareIntervention"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:439151001</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Acknolwdgement of Concern</ncit4:synonym>
        <umls5:cui xml:lang="en">C2585406</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the activity of recognizing the feeling of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Acknowledgement of Feeling</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ActiveListening -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ActiveListening">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CommunicatingActionSuggested"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:386507003</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0150122</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the technique of paying close attention to the speaker in order to understand what is being said.</rdfs:comment>
        <rdfs:label xml:lang="en">Active Listening</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Addiction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Addiction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MedicalHistory"/>
        <ncit4:synonym xml:lang="en">Addictive Disorder</ncit4:synonym>
        <rdfs:label xml:lang="en">Addiction</rdfs:label>
        <skos:definition xml:lang="en">&quot;Addiction is a complex condition, a brain disease that is manifested by compulsive substance use despite harmful consequence. People with addiction (severe substance use disorder) have an intense focus on using a certain substance(s), such as alcohol or drugs, to the point that it takes over their life.&quot; (American Psychiatric Association)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AfterBreakfast -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AfterBreakfast">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Time"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:7221000175107</ncit4:crossReference>
        <umls5:cui xml:lang="en">C1550743</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the time after breakfast.</rdfs:comment>
        <rdfs:label xml:lang="en">After Breakfast</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AfterDinner -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AfterDinner">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Time"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:1521000175104</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">After Supper</ncit4:synonym>
        <umls5:cui xml:lang="en">C1879671</umls5:cui>
        <rdfs:label xml:lang="en">After Dinner</rdfs:label>
        <skos:definition xml:lang="en">&quot;After supper or evening meal.&quot; - National Cancer Institute</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AfterLunch -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AfterLunch">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Time"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:1541000175107</ncit4:crossReference>
        <umls5:cui xml:lang="en">C1879668</umls5:cui>
        <rdfs:label xml:lang="en">After Lunch</rdfs:label>
        <skos:definition xml:lang="en">&quot;After lunch&quot; - National Cancer Institute</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Afternoon -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Afternoon">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Time"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:422133006</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0439550</umls5:cui>
        <rdfs:label xml:lang="en">Afternoon</rdfs:label>
        <skos:definition xml:lang="en">&quot;The time period between noon and sunset.&quot; - National Cancer Institute</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Age -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Age">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DemographicInformation"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:397669002</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0001779</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the time elapsed since birth.</rdfs:comment>
        <rdfs:label xml:lang="en">Age</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Agitation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Agitation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HarmToSelf"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:24199005</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Agitation or Aggression in Dementia, Agitated Behavior, Feeling Agitated, Being Agitated</ncit4:synonym>
        <umls5:cui xml:lang="en">C0085631</umls5:cui>
        <rdfs:label xml:lang="en">Agitation</rdfs:label>
        <skos:definition xml:lang="en">&quot;Agitated behaviour is defined as any inappropriate physical or verbal, aggressive or non-aggressive, act that is not an obvious expression of need or disorientation.&quot; - Cohen-Mansfield, Libin and Marx 2007</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AlcoholAddiction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AlcoholAddiction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Addiction"/>
        <ncit4:crossReference xml:lang="en">MESH:D000437
SNOMEDCT:66590003</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Alcohol Problem Drinking, Alcohol Dependence</ncit4:synonym>
        <umls5:cui xml:lang="en">C0001973</umls5:cui>
        <rdfs:label xml:lang="en">Alcohol Addiction</rdfs:label>
        <skos:definition xml:lang="en">&quot;An addictive behavior defined as drinking excessive amounts of alcohol over a long period of time, having difficulty reducing the amount of alcohol consumed, strongly desiring alcohol and experiencing withdrawal symptoms when not drinking alcohol.&quot; (Human Phenotype Ontology)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Alertness -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Alertness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CognitiveAbility"/>
        <umls5:cui xml:lang="en">C1443086</umls5:cui>
        <rdfs:label xml:lang="en">Alertness</rdfs:label>
        <skos:definition xml:lang="en">&quot;Alertness is the state of active attention by high sensory awareness such as being watchful and prompt to meet danger or emergency, or being quick to perceive and act.&quot; (Wikipedia)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Allergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Allergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MedicalHistory"/>
        <ncit4:crossReference xml:lang="en">MESH:D006967
SNOMEDCT:418634005</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Hypersensitivity, Hypersensitivity Reaction</ncit4:synonym>
        <umls5:cui xml:lang="en">C0020517</umls5:cui>
        <rdfs:label xml:lang="en">Allergy</rdfs:label>
        <skos:definition xml:lang="en">&quot;An allergy is an immune response or reaction to substances that are usually not harmful.&quot; (Human Phenotype Ontology)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AlzheimerDiseaseDementiaMixedTypeWithCerebrovascularDisease -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AlzheimerDiseaseDementiaMixedTypeWithCerebrovascularDisease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToAlzheimerDisease"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:79341000119107</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Mixed Vascular Alzheimer Dementia</ncit4:synonym>
        <umls5:cui xml:lang="en">C3532942</umls5:cui>
        <rdfs:label xml:lang="en">Alzheimer Disease Dementia Mixed Type with Cerebrovascular Disease</rdfs:label>
        <skos:definition xml:lang="en">&quot;Dementia due to Alzheimer disease and concomitant cerebrovascular disease.&quot; From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Anaemia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Anaemia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MedicalIllness"/>
        <ncit4:crossReference xml:lang="en">MESH:D000740
SNOMEDCT:271737000</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Lack of Blood</ncit4:synonym>
        <umls5:cui xml:lang="en">C0002871</umls5:cui>
        <rdfs:comment xml:lang="en">Anaemia is a deficiency in the number or quality of red blood cells in one&apos;s body.</rdfs:comment>
        <rdfs:label xml:lang="en">Anaemia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Anger -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Anger">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EmotionalDistress"/>
        <ncit4:crossReference xml:lang="en">MESH:D000786
SNOMEDCT:75408008</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Feeling Angry, Angry Mood</ncit4:synonym>
        <umls5:cui xml:lang="en">C0002957</umls5:cui>
        <rdfs:label xml:lang="en">Anger</rdfs:label>
        <skos:definition xml:lang="en">&quot;A strong emotional feeling of displeasure aroused by being interfered with, injured or threatened.&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AnimalAllergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AnimalAllergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Allergy"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:717234006</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Allergy to Animal</ncit4:synonym>
        <umls5:cui xml:lang="en">C4082933</umls5:cui>
        <rdfs:label xml:lang="en">Animal Allergy</rdfs:label>
        <skos:definition xml:lang="en">&quot;Hypersensitivity in form of an adverse immune reaction against animal proteins.&quot; (Human Phenotype Ontology)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AnimalAssistedTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AnimalAssistedTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IndividualTherapyForPsychoticSymptom"/>
        <ncit4:abbreviation xml:lang="en">AAT</ncit4:abbreviation>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:386515000</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Pet Therapy</ncit4:synonym>
        <umls5:cui xml:lang="en">C0150133</umls5:cui>
        <rdfs:label xml:lang="en">Animal Assisted Therapy</rdfs:label>
        <skos:definition xml:lang="en">Animal assisted therapy is a psychotherapy treatment based upon building a bond with an animal through interaction and play. Defined by Sunrise medical 2018.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AnimalHairAllergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AnimalHairAllergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Allergy"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:300911008</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Allergy to Animal Hair</ncit4:synonym>
        <umls5:cui xml:lang="en">C0577623</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the allergic reaction to animal hair, such as wool.</rdfs:comment>
        <rdfs:label xml:lang="en">Animal Hair Allergy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AppleJuiceIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AppleJuiceIntervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IndividualTherapyForPsychoticSymptom"/>
        <rdfs:comment xml:lang="en">It refers to the intervention of giving 24-oz glasses of apple juice to people with dementia for 1 month. Apple juice improves delusions according to the study of Remington et al. 2010 &quot;Apple juice improved behavioral but not cognitive symptoms in moderate-to-late stage Alzheimer&apos;s Disease in an open-label pilot study&quot;.</rdfs:comment>
        <rdfs:label xml:lang="en">Apple Juice Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Arguing -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Arguing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VerballyAggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">It refers to the expressing diverging or opposite views, typically in a heated or angry way.</rdfs:comment>
        <rdfs:label xml:lang="en">Arguing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Aromatherapist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Aromatherapist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
        <umls5:cui xml:lang="en">C2985484</umls5:cui>
        <rdfs:label xml:lang="en">Aromatherapist</rdfs:label>
        <skos:definition xml:lang="en">&quot;A person who practices a type of complementary medicien called aromatherapy. This therapy uses plant oils that give off strong, pleasant smells to promote relaxation and a sense of well-being. The plant oils are usually inhaled or put on the skin using wet clothes, baths, or massage.&quot; - U.S. National Cancer Insitute</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ArtCognitiveActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ArtCognitiveActivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RecreationalActivity"/>
        <ncit4:crossReference xml:lang="en">MESH:D001155
SNOMEDCT:65153003</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Art Therapy, Art-Based Therapy</ncit4:synonym>
        <umls5:cui xml:lang="en">C0003827</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the acitivities that involves the use of creative techniques such as drawing, painting, and coloring to help people with dementia to express themselves artistically and enhance coginitive function.</rdfs:comment>
        <rdfs:label xml:lang="en">Art Cognitive Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ArtTherapist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ArtTherapist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:309410006</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0586935</umls5:cui>
        <rdfs:label xml:lang="en">Art Therapist</rdfs:label>
        <skos:definition xml:lang="en">&quot;(1) An individual who uses art to achieve the therapeutic goals of symptom relief, emotional integration, and recovery from or adjustment to illness or disability. (2) An art therapist uses a form of treatment that enables patients with mental or physical disabilities to use art as a way of expressing and dealing with feelings and inner conflicts. (3) An individual who uses arts modalities and creative processes during intentional intervention in therapeutic, rehabilitative, community, or educational settings to foster health, communication, and expression; promote the integration of physical, emotional, cognitive, and social functioning; enhance self-awareness; and facilitate change.&quot; From U.S. National Uniform Claim Committee - Health Care Provider Taxonomy</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Arthritis -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Arthritis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ChronicDisease"/>
        <ncit4:crossReference xml:lang="en">MESH:D001168
SNOMEDCT:3723001</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Inflammatory Arthritis, Joint Inflammation</ncit4:synonym>
        <umls5:cui xml:lang="en">C0003864</umls5:cui>
        <rdfs:label xml:lang="en">Arthritis</rdfs:label>
        <skos:definition xml:lang="en">&quot;Acute or chronic inflammation of joints.&quot; (MESH)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AskingAssistance -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AskingAssistance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CommunicatingActionSuggested"/>
        <rdfs:comment xml:lang="en">It refers to the communication skill of asking for assistance of the care receiver during care delivery.</rdfs:comment>
        <rdfs:label xml:lang="en">Asking Assistance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AssociatedGroup -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AssociatedGroup">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BackgroundOfPersonWithDementia"/>
        <rdfs:comment xml:lang="en">It refers to the information about the groups an individual is connected with.</rdfs:comment>
        <rdfs:label xml:lang="en">Associated Group</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AssociatedProfessionalOrganization -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AssociatedProfessionalOrganization">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AssociatedGroup"/>
        <rdfs:comment xml:lang="en">It refers to the information about the professional organizations that an individual is connected with.</rdfs:comment>
        <rdfs:label xml:lang="en">Associated Professional Organization</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AssociatedSocialClub -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AssociatedSocialClub">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AssociatedGroup"/>
        <rdfs:comment xml:lang="en">It refers to the information about the social clubs that an individual is connected with.</rdfs:comment>
        <rdfs:label xml:lang="en">Associated Social Club</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AtRiskForFall -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AtRiskForFall">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MedicalHistory"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:129839007</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Fall Risk, At Risk for Falling</ncit4:synonym>
        <umls5:cui xml:lang="en">C1268740</umls5:cui>
        <rdfs:label xml:lang="en">At Risk for Fall</rdfs:label>
        <skos:definition xml:lang="en">&quot;Potential for increased chance of falling that may cause physical harm, damage or loss.&quot; (Periperative Nursing Data Set)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AtRiskOfPressureUlcer -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AtRiskOfPressureUlcer">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MedicalHistory"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:285304000</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Pressure Sore Risk, At Risk of Pressure Sore</ncit4:synonym>
        <umls5:cui xml:lang="en">C0563204</umls5:cui>
        <rdfs:label xml:lang="en">At Risk of Pressure Ulcer</rdfs:label>
        <skos:definition xml:lang="en">It refers to the risk of injury to skin and underlying tissue resulting from prolonged pressure on the skin. (Mayo Clinic)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AttendingConcert -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AttendingConcert">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RecreationalActivity"/>
        <rdfs:comment xml:lang="en">It refers to the intervention of attending a concert.</rdfs:comment>
        <rdfs:label xml:lang="en">Attending Concert</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AuditoryHallucination -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AuditoryHallucination">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Hallucination"/>
        <ncit4:crossReference xml:lang="en">MESH:D006212
SNOMEDCT:45150006</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0233762</umls5:cui>
        <rdfs:label xml:lang="en">Auditory Hallucination</rdfs:label>
        <skos:definition xml:lang="en">It refers to the &quot;hallucinations involving the perception of sound, most frequently of voices but sometimes of clicks or other noises, that are not restricted to the period of awakening or the onset of sleep.&quot; (ICD-11)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AuditoryImpairment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AuditoryImpairment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SensoryImpairment"/>
        <ncit4:crossReference xml:lang="en">MESH:D034381
SNOMEDCT:15188001</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Poor Hearing, Hearing Impairment</ncit4:synonym>
        <umls5:cui xml:lang="en">C1384666</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the damaged sense of hearing.</rdfs:comment>
        <rdfs:label xml:lang="en">Auditory Impairment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Aunt -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Aunt">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyMember"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:25211005</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0337576</umls5:cui>
        <rdfs:label xml:lang="en">Aunt</rdfs:label>
        <skos:definition xml:lang="en">&quot;The sister of one&apos;s father or mother; the wife of one&apos;s uncle.&quot; - U.S. National Cancer Institute</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AvoidArguingWithPatient -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AvoidArguingWithPatient">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CommunicatingActionAvoided"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AvoidScolding"/>
        <umls5:cui xml:lang="en">C0509169</umls5:cui>
        <rdfs:comment xml:lang="en">It refers that health care professionals should not argue with the person who has delusions and/or hallucinations. It is better to acknowledge that the person may be frightened by the delusions and hallucinations.</rdfs:comment>
        <rdfs:label xml:lang="en">Avoid Arguing with Patient</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AvoidArguingWithPatientAboutFalseBelief -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AvoidArguingWithPatientAboutFalseBelief">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AvoidArguingWithPatient"/>
        <umls5:cui xml:lang="en">C4710607</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the concept that health care professionals should not argue about false beliefs.</rdfs:comment>
        <rdfs:label xml:lang="en">Avoid Arguing with Patient about False Belief</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AvoidArguingWithPatientAboutValidityOfHallucination -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AvoidArguingWithPatientAboutValidityOfHallucination">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AvoidArguingWithPatient"/>
        <umls5:cui xml:lang="en">C0509170</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the concept that health care professionals should avoid argue with patient about the validity of the hallucinations.</rdfs:comment>
        <rdfs:label xml:lang="en">Avoid Arguing with Patient about Validity of Hallucination</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AvoidScolding -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/AvoidScolding">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CommunicatingActionAvoided"/>
        <rdfs:comment xml:lang="en">It refers to the concept that health care professionals should not scold person with dementia-related psychotic symptoms, such as do not scold the person for losing objects or hiding things.</rdfs:comment>
        <rdfs:label xml:lang="en">Avoid Scolding</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BackPain -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BackPain">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Pain"/>
        <ncit4:crossReference xml:lang="en">MESH:D001416
SNOMEDCT:161891005</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Backache, Back Ache, Dorsalgia, Dorsodynia</ncit4:synonym>
        <umls5:cui xml:lang="en">C0004604</umls5:cui>
        <rdfs:label xml:lang="en">Back Pain</rdfs:label>
        <skos:definition xml:lang="en">&quot;Acute or chronic pain located in the posterior regions of the thorax; lumbosacral region; or the adjacent regions.&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BackgroundOfPersonWithDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BackgroundOfPersonWithDementia">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isBackgroundOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonWithDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isMatchedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonWithDementiaFocusedIntervention"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isProvidedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Person"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">It refers to the information about the background of person with dementia which is associated with psychotic symptoms in dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Background of Person with Dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BackgroundPersonalityFactor -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BackgroundPersonalityFactor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomCausativeFactor"/>
        <rdfs:comment xml:lang="en">Background personality factors are those that reflect people&apos;s characteristic patterns of thoughts, feelings, and behaviors.</rdfs:comment>
        <rdfs:label xml:lang="en">Background Personality Factor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BadDream -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BadDream">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IntrapersonalCausativeFactor"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:419748005</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Unpleasant Dream, Nightmare</ncit4:synonym>
        <umls5:cui xml:lang="en">C1636655</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to dreams that bring out strong feelings of fear, terror, distress or anxiety.</rdfs:comment>
        <rdfs:label xml:lang="en">Bad Dream</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BallGame -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BallGame">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Exercise"/>
        <rdfs:comment xml:lang="en">It refers to the exercise intervention involving some type of ball.</rdfs:comment>
        <rdfs:label xml:lang="en">Ball Game</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BalloonKicking -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BalloonKicking">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Exercise"/>
        <rdfs:comment xml:lang="en">It refers to the activity of kicking balloons.</rdfs:comment>
        <rdfs:label xml:lang="en">Balloon Kicking</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BaylorHallucinationQuestionnaire -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BaylorHallucinationQuestionnaire">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomAssessmentTool"/>
        <umls5:cui xml:lang="en">C5188410</umls5:cui>
        <rdfs:label xml:lang="en">Baylor Hallucination Questionnaire</rdfs:label>
        <skos:definition xml:lang="en">Baylor Hallucination Questionnaire is a six-item, four-point scale questionnaire for assessing hallucinations. From Fernandez et al. 2008 &quot;Scales to assess psychosis in Parkinson&apos;s Disease: critique and recommendations&quot;</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Bedtime -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Bedtime">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Time"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:21029003</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0521112</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the usual time of going to bed.</rdfs:comment>
        <rdfs:label xml:lang="en">Bedtime</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Beekeeping -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Beekeeping">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RecreationalActivity"/>
        <ncit4:crossReference xml:lang="en">MESH:D056630</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Bee-keeping, Apiculture</ncit4:synonym>
        <umls5:cui xml:lang="en">C2717862</umls5:cui>
        <rdfs:label xml:lang="en">Beekeeping</rdfs:label>
        <skos:definition xml:lang="en">&quot;The management and maintenance of colonies of honeybees.&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BeforeBedtime -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BeforeBedtime">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Time"/>
        <umls5:cui xml:lang="en">C1879793</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the time prior to going to bed.</rdfs:comment>
        <rdfs:label xml:lang="en">Before Bedtime</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BeforeBreakfast -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BeforeBreakfast">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Time"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:1501000175105</ncit4:crossReference>
        <umls5:cui xml:lang="en">C1549040</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the time prior to eating breakfast.</rdfs:comment>
        <rdfs:label xml:lang="en">Before Breakfast</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BeforeDinner -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BeforeDinner">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Time"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:3071000175109</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Before Evening Meal</ncit4:synonym>
        <umls5:cui xml:lang="en">C1550742</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the time prior to eating dinner.</rdfs:comment>
        <rdfs:label xml:lang="en">Before Dinner</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BeforeLunch -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BeforeLunch">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Time"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:3091000175105</ncit4:crossReference>
        <umls5:cui xml:lang="en">C1550741</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the time prior to eating lunch.</rdfs:comment>
        <rdfs:label xml:lang="en">Before Lunch</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BehaviourTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BehaviourTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Psychotherapy"/>
        <ncit4:crossReference xml:lang="en">MESH:D001521
SNOMEDCT:166001</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Behavioral Psychotherapy, Behaviour Modification, Behavioral Intervention</ncit4:synonym>
        <umls5:cui xml:lang="en">C0004933</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to psychotherapy that uses techniques derived from behaviourism. It seeks to identify and help change potentially self-destructive or unhealthy behaviours.</rdfs:comment>
        <rdfs:label xml:lang="en">Behaviour Therapy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BehaviouralPathologyInAlzheimersDiseaseRatingScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BehaviouralPathologyInAlzheimersDiseaseRatingScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomAssessmentTool"/>
        <ncit4:abbreviation xml:lang="en">BEHAVE-AD</ncit4:abbreviation>
        <rdfs:comment xml:lang="en">The Behavioral Patholody in Alzheimer&apos;s Disease Rating Scale is a screening instrument for the evaluation of behavioral disturbances in Alzheimer&apos;s patients. It has items for evaluting psychotic symptoms. Each type of delusion or hallucination is rated on a 4-point scale of severity.</rdfs:comment>
        <rdfs:label xml:lang="en">Behavioural Pathology in Alzheimer&apos;s Disease Rating Scale</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Belief -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Belief">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BackgroundOfPersonWithDementia"/>
        <umls5:cui xml:lang="en">C0004951</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to a state or habit of mind in which trust or confidence is placed in some person or thing; conviction of the truth of some statement or the reality of some phenomenon.</rdfs:comment>
        <rdfs:label xml:lang="en">Belief</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BiologicalGender -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BiologicalGender">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GenderIdentity"/>
        <rdfs:comment xml:lang="en">It refers to the gender of a person assigned biologically at birth.</rdfs:comment>
        <rdfs:label xml:lang="en">Biological Gender</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BipolarDisorder -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BipolarDisorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychiatricDisorder"/>
        <ncit4:crossReference xml:lang="en">MESH:D001714
SNOMEDCT:13746004</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Bipolar Affective Disorder, Bipolar Affective Psychosis, Bipolar Mood Disorder, Bipolar Illness, Manic Depression,</ncit4:synonym>
        <umls5:cui xml:lang="en">C0005586</umls5:cui>
        <rdfs:comment xml:lang="en">Bipolar disorder is a mental illness marked by extreme shifts in mood.</rdfs:comment>
        <rdfs:label xml:lang="en">Bipolar Disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Biting -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Biting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyAggressiveBehaviour"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:69547003</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Aggressive Biting</ncit4:synonym>
        <umls5:cui xml:lang="en">C0233534</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the behaviour of biting something or somebody aggressively.</rdfs:comment>
        <rdfs:label xml:lang="en">Biting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BizarreDelusion -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BizarreDelusion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Delusion"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:82791007</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0233671</umls5:cui>
        <rdfs:label xml:lang="en">Bizarre Delusion</rdfs:label>
        <skos:definition xml:lang="en">&quot;A delusion that involves a phenomenon that would be regarded as physically impossible within the person&apos;s cultural context.&quot; (ICD-11)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BodyHeight -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BodyHeight">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BackgroundOfPersonWithDementia"/>
        <ncit4:crossReference xml:lang="en">MESH:D001827
SNOMEDCT:50373000</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Height</ncit4:synonym>
        <umls5:cui xml:lang="en">C0005890</umls5:cui>
        <rdfs:label xml:lang="en">Body Height</rdfs:label>
        <skos:definition xml:lang="en">&quot;The distance from the sole to the crown of the head with body standing on a flat surface and fully extended.&quot; (MESH)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BodyWeight -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BodyWeight">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BackgroundOfPersonWithDementia"/>
        <ncit4:crossReference xml:lang="en">MESH:D001835
SNOMEDCT:27113001</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Weight</ncit4:synonym>
        <umls5:cui xml:lang="en">C0005910</umls5:cui>
        <rdfs:label xml:lang="en">Body Weight</rdfs:label>
        <skos:definition xml:lang="en">&quot;The mass or quantity of heaviness of an individual. It is expressed by units of pounds or kilograms.&quot; (MESH)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BorderlinePersonalityDisorder -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BorderlinePersonalityDisorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MedicalIllness"/>
        <ncit4:crossReference xml:lang="en">MESH:D001883
SNOMEDCT:20010003</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0006012</umls5:cui>
        <rdfs:label xml:lang="en">Borderline Personality Disorder</rdfs:label>
        <skos:definition xml:lang="en">&quot;A personality disorder marked by a pattern of instability of interpersonal relationships, self-image, and affects, and marked impulsivity beginning by early adulthood and present in a variety of contexts. (DSM-IV)&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Boredom -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Boredom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IntrapersonalCausativeFactor"/>
        <ncit4:crossReference xml:lang="en">MESH:D001887
SNOMEDCT:83765003</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0006019</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the state of feeling disinterested in one&apos;s surroundings, having nothing to do or feeling that life is dull. Some delusions emerged as providing content at times of boredom and inactivity. When the person has no role and does not know what to do, they may resort to past roles or other roles.</rdfs:comment>
        <rdfs:label xml:lang="en">Boredom</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BrainInjury -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BrainInjury">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IntrapersonalCausativeFactor"/>
        <ncit4:crossReference xml:lang="en">MESH:D001930
SNOMEDCT:127294003</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Brain Damage, Cerebral Damage, Cerebral Injury</ncit4:synonym>
        <umls5:cui xml:lang="en">C0270611</umls5:cui>
        <rdfs:label xml:lang="en">Brain Injury</rdfs:label>
        <skos:definition xml:lang="en">SNOMEDCT: &quot;An injury to the brain which is not hereditary, congenital, or degenerative.&quot;</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BreakfastTime -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BreakfastTime">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Time"/>
        <ncit4:crossReference xml:lang="en">MESH:D062408
SNOMEDCT:307160001</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Morning Meal Time, Breakfast</ncit4:synonym>
        <umls5:cui xml:lang="en">C2698559</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the time of people having breakfast.</rdfs:comment>
        <rdfs:label xml:lang="en">Breakfast Time</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BriefPsychiatricRatingScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BriefPsychiatricRatingScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomAssessmentTool"/>
        <ncit4:abbreviation xml:lang="en">BPRS</ncit4:abbreviation>
        <ncit4:crossReference xml:lang="en">MESH:D010054</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Overall and Gorham Brief Psychiatric Rating Scale</ncit4:synonym>
        <umls5:cui xml:lang="en">C0029941</umls5:cui>
        <rdfs:label xml:lang="en">Brief Psychiatric Rating Scale</rdfs:label>
        <skos:definition xml:lang="en">The Brief Psychiatric Rating Scale was designed to measure clinical change in psychiatric patients. It includes 18 items and each item is scored on a seven-point scale ranging from &quot;not present&quot; to &quot;extremely severe&quot;. From Overall and Gorham 1962 &quot;The Brief Psychiatric Rating Scale&quot;</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BrightLightStimulation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BrightLightStimulation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EnvironmentalCausativeFactor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/causes"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Hallucination"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The bright light can be an inappropriate sensory stimulation that cause hallucination in person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Bright Light Stimulation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Brother -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Brother">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyMember"/>
        <ncit4:crossReference xml:lang="en">MESH:D035781
SNOMEDCT:70924004</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0337527</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to a male sibling of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Brother</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BrotherInLaw -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BrotherInLaw">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyMember"/>
        <umls5:cui xml:lang="en">C1553711</umls5:cui>
        <rdfs:label xml:lang="en">Brother-in-law</rdfs:label>
        <skos:definition xml:lang="en">&quot;A brother by marriage.&quot; (National Cancer Institute)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BuildingModelTrain -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BuildingModelTrain">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RecreationalActivity"/>
        <rdfs:comment xml:lang="en">It refers to the activity of building a model train.</rdfs:comment>
        <rdfs:label xml:lang="en">Building Model Train</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BurnsSymptomChecklist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BurnsSymptomChecklist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomAssessmentTool"/>
        <rdfs:comment xml:lang="en">This scale was developed by Burns et al in 1990,  which includes 16 questions pertaining to a range of psychotic symptoms.</rdfs:comment>
        <rdfs:label xml:lang="en">Burns&apos; Symptom Checklist</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BusinessImmigration -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BusinessImmigration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ImmigrationType"/>
        <rdfs:comment xml:lang="en">It refers to the type of immigration that people choose to live in other countries for operating a new or existing business.</rdfs:comment>
        <rdfs:label xml:lang="en">Business Immigration</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/COVID19 -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/COVID19">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MedicalIllness"/>
        <ncit4:crossReference xml:lang="en">MESH:D000086382
SNOMEDCT:840539006</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">2019 Novel Coronavirus Disease, 2019 Novel Cornavirus Infection, Coronavirus Disease-19, 2019-nCov Disease</ncit4:synonym>
        <umls5:cui xml:lang="en">C5203670</umls5:cui>
        <rdfs:label xml:lang="en">COVID19</rdfs:label>
        <skos:definition xml:lang="en">&quot;COVID-19 is an infectious disease cuased by a newly discovered coronavirus. Most people infected with the COVID-19 virus will experience mild to moderate respiratory illness and recover without requiring special treatment.  Older people, and those with underlying medical problems like cardiovascular disease, diabetes, chronic respiratory disease, and cancer are more likely to develop serious illness.&quot; (World Health Organization)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CannabisAddiction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CannabisAddiction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Addiction"/>
        <ncit4:crossReference xml:lang="en">MESH:D002189
SNOMEDCT:85005007</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Cannabis Dependence, Marijuana Addiction, Marijuana Dependence</ncit4:synonym>
        <umls5:cui xml:lang="en">C0006870</umls5:cui>
        <rdfs:label xml:lang="en">Cannabis Addiction</rdfs:label>
        <skos:definition xml:lang="en">&quot;Physical and psychological dependence on the drug cannabis.&quot; (National Cancer Institute)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Cardiologist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Cardiologist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
        <ncit4:crossReference xml:lang="en">MESH:D000072096
SNOMEDCT:17561000</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0175906</umls5:cui>
        <rdfs:label xml:lang="en">Cardiologist</rdfs:label>
        <skos:definition xml:lang="en">&quot;Qualified medical professionals who specialize in preventing and treating disorders of the heart and cardiovascular system.&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CareGoal -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CareGoal">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isCareGoalOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit4:crossReference xml:lang="en">MESH:D010347</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Goal of Care</ncit4:synonym>
        <umls5:cui xml:lang="en">C2930505</umls5:cui>
        <rdfs:label xml:lang="en">Care Goal</rdfs:label>
        <skos:definition xml:lang="en">It refers to the goal setted for a particular patient usually reflecting patient and family goals as well as those institution and health care providers. From MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CarePlanCreation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CarePlanCreation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomManagementActivity"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:370789001</ncit4:crossReference>
        <umls5:cui xml:lang="en">C1269668</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the activity of developing an individualized plan of care.</rdfs:comment>
        <rdfs:label xml:lang="en">Care Plan Creation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CaseManager -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CaseManager">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
        <ncit4:crossReference xml:lang="en">MESH:D000071959
SNOMEDCT:768832004</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0687694</umls5:cui>
        <rdfs:label xml:lang="en">Case Manager</rdfs:label>
        <skos:definition xml:lang="en">&quot;Professionals who are in charge of assessment, planning, facilitation, care coordination, evaluation, and advocacy for options and services to meet a patient&apos;s and family&apos;s comprehensive health needs.&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CausativeFactorInvestigation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CausativeFactorInvestigation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomManagementActivity"/>
        <rdfs:comment xml:lang="en">It refers to the activity of investigating the factors that cause psychotic symptoms of a person living with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Causative Factor Investigation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CeaselessTalking -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CeaselessTalking">
