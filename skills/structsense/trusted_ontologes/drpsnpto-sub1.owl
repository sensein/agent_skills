        <rdfs:label xml:lang="en">Manchester and Oxford Universities Scale for the Psychological Assessment of Dementia</rdfs:label>
        <skos:definition xml:lang="en">MOUSEPAD stands for Manchester and Oxford Universities Scale for the Psychological Assessment of Dementia. It is a 59-time instrument for assessing the psychopathological and behavioural changes in dementia. It was developed by Allen et al. in 1996.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MakingBizarreNoise -->

