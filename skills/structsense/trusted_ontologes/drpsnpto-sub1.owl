    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MusicTherapist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MusicTherapist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:309412003</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0586937</umls5:cui>
        <rdfs:label xml:lang="en">Music Therapist</rdfs:label>
        <skos:definition xml:lang="en">&quot;Music therapists use music interventions to asses clients&apos; strengths and needs, develop goals, implement services, and evaluate and document progress for individuals of all ages. Music therapists facilitate changes in physical, cognitive, emotional, and/or psychosoical health.&quot; from U.S. National Uniform Claim Committee - Health care Provider Taxonomy</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MusicTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MusicTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IndividualTherapyForPsychoticSymptom"/>
        <ncit4:abbreviation xml:lang="en">MT</ncit4:abbreviation>
        <ncit4:crossReference xml:lang="en">MESH:D009147
SNOMEDCT:21065008</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Music Intervention</ncit4:synonym>
        <umls5:cui xml:lang="en">C0026868</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the use of music to promote well-being.</rdfs:comment>
        <rdfs:label xml:lang="en">Music Therapy</rdfs:label>
        <skos:definition xml:lang="en">The American Music Therapy Association (AMTA) defines music therapy as &quot;the clinical and evidenc-based use of music intervention to accomplish individualized goals within a therapeutic relationship by a credentialed professional who has completed an approved music therapy program&quot; (American Music Therapy Association 2006).</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NativeLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NativeLanguage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/LanguageInformation"/>
        <umls5:cui xml:lang="en">C1510558</umls5:cui>
        <rdfs:label xml:lang="en">Native Language</rdfs:label>
        <skos:definition xml:lang="en">&quot;It refers to the language that a person has been exposed to from birth or within the critical period.&quot; (Wikipedia)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NeedForInterpreter -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NeedForInterpreter">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BackgroundOfPersonWithDementia"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:315593009</ncit4:crossReference>
        <umls5:cui xml:lang="en">C1278519</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the need of an interpreter to assist the conversation between a person who doesn&apos;t speak local language and health care professionals.</rdfs:comment>
        <rdfs:label xml:lang="en">Need for Interpreter</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Negativism -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Negativism">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EmotionalDistress"/>
        <ncit4:crossReference xml:lang="en">MESH:D009341
SNOMEDCT:58326007</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Demonstrated Behavior Negativism</ncit4:synonym>
        <umls5:cui xml:lang="en">C0027562</umls5:cui>
        <rdfs:label xml:lang="en">Negativism</rdfs:label>
        <skos:definition xml:lang="en">&quot;State of mind or behavior characterized by extreme skepticism and persistent opposition or resistance to outside suggestions or advice.&quot; (APA, Thesaurus of Psychological Index Terms, 1994)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Nephew -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Nephew">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyMember"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:83559000</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0337579</umls5:cui>
        <rdfs:label xml:lang="en">Nephew</rdfs:label>
        <skos:definition xml:lang="en">&quot;A son of one&apos;s brother or sister.&quot; - U.S. National Cancer Institute</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NeurologicalAssessment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NeurologicalAssessment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ComprehensiveInitialAssessment"/>
        <ncit4:crossReference xml:lang="en">MESH:D009460
SNOMEDCT:225398001</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Neurologic Examination, Neurological Examiniation, Assessing Neurological Status, Neuro Exam</ncit4:synonym>
        <umls5:cui xml:lang="en">C0027853</umls5:cui>
        <rdfs:comment xml:lang="en">&quot;Assessment of sensory and motor responses and reflexes that is used to determine impairment of the nervious system.&quot; - MESH</rdfs:comment>
        <rdfs:label xml:lang="en">Neurological Assessment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Neurologist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Neurologist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
        <ncit4:crossReference xml:lang="en">MESH:D000072141
SNOMEDCT:563997003</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0237426</umls5:cui>
        <rdfs:label xml:lang="en">Neurologist</rdfs:label>
        <skos:definition xml:lang="en">&quot;Qualified medical professionals who specialize in treating nervous system diseases.&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NeuropsychiatricInventory -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NeuropsychiatricInventory">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomAssessmentTool"/>
        <ncit4:abbreviation xml:lang="en">NPI</ncit4:abbreviation>
        <ncit4:synonym xml:lang="en">Neuropsychiatric Inventory Questionnaire, Neuropsychiatric Interview</ncit4:synonym>
        <umls5:cui xml:lang="en">C3539727</umls5:cui>
        <rdfs:comment xml:lang="en">The Neuropsychiatric Inventory (NPI) was developed by Cummings et al. to access dementia-related behavioral symptoms. The NPOI originally examined 10 sub-domains of behavioral functioning: delusions, hallucinations, agitation/aggression, dysphoria, anxiety, euphoria, apathy, disinhibition, irritability/lability, and aberrant motor activity. Two more sub-domains have been added since its development: night-time behavioral disturbances and appetite and eating abnormalities.</rdfs:comment>
        <rdfs:label xml:lang="en">Neuropsychiatric Inventory</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NeuropsychiatricInventoryClinicianRatingScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NeuropsychiatricInventoryClinicianRatingScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomAssessmentTool"/>
        <ncit4:abbreviation xml:lang="en">NPI-C</ncit4:abbreviation>
        <rdfs:comment xml:lang="en">It is an assessment tool of neuropsychiatric symptoms in dementia. It is a revised version of the Neuopsychiatric Inventory (NPI), including expanded domains and items, and a clinician rating methodology. It was developed by Medeiros et al. in 2010.</rdfs:comment>
        <rdfs:label xml:lang="en">Neuropsychiatric Inventory - Clinician Rating Scale</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NeuropsychiatricInventoryNursingHomeVersion -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NeuropsychiatricInventoryNursingHomeVersion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomAssessmentTool"/>
        <ncit4:abbreviation xml:lang="en">NPI-NH</ncit4:abbreviation>
        <rdfs:comment xml:lang="en">It was developed to help characterize the neuropsychiatric symptoms and psychopathology of patients with Alzheimer&apos;s disease and other dementia when the patients are residents in extended care facilities or other care settings where information is gathered from health care professionals. The NPI-NH was derived from the Neuropsychiatric Inventory (NPI), which was originally developed for the assessment of neuropsychiatric symptoms and psychopathology in community-dwelling patients where information was obtained from family caregivers. The content of the questions of the NPI and NPI-NH are identical but have been rephrased appropriately. In addition, the caregiver distress scale of the NPI has been changed to an occupational disruptiveness scale for the NPI-NH to allow an assessment of the impact of behavioral disturbances on professional caregivers.</rdfs:comment>
        <rdfs:label xml:lang="en">Neuropsychiatric Inventory - Nursing Home Version</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Neuropsychiatrist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Neuropsychiatrist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Psychiatrist"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:21450003</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Neuro-psychiatrist</ncit4:synonym>
        <umls5:cui xml:lang="en">C0334912</umls5:cui>
        <rdfs:label xml:lang="en">Neuropsychiatrist</rdfs:label>
        <skos:definition xml:lang="en">&quot;A neuropsychiatrist is a psychiatrist specializing in the diagnosis and treatment of disorders affecting the brain which cause behavioral, psychological and psychiatric symptoms.&quot; - Brain Injury Alliance of New Jersey</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NewRoommate -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NewRoommate">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EnvironmentalCausativeFactor"/>
        <rdfs:comment xml:lang="en">It refers to the enviornmental change of having a new roommate.</rdfs:comment>
        <rdfs:label xml:lang="en">New Roommate</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NicotineAddiction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NicotineAddiction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Addiction"/>
        <ncit4:crossReference xml:lang="en">MESH:D014029</ncit4:crossReference>
        <umls5:cui xml:lang="en">C5241305</umls5:cui>
        <rdfs:comment xml:lang="en">&quot;Nicotine addiction occurs when a person becomes addicted to nicotine, which is a chemical found in tobacco.&quot; (HealthLine.com)</rdfs:comment>
        <rdfs:label xml:lang="en">Nicotine Addiction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Niece -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Niece">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyMember"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:34581001</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0337578</umls5:cui>
        <rdfs:label xml:lang="en">Niece</rdfs:label>
        <skos:definition xml:lang="en">&quot;A daughter of one&apos;s brother or sister.&quot; - U.S. National Cancer Institute</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Night -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Night">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Time"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:2546009</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">At Night, Nocturnal, Night Time</ncit4:synonym>
        <umls5:cui xml:lang="en">C0240526</umls5:cui>
        <rdfs:label xml:lang="en">Night</rdfs:label>
        <skos:definition xml:lang="en">&quot;The time in every 24 hour period when it is dark.&quot; - National Cancer Institute</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NihilisticDelusion -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NihilisticDelusion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Delusion"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:247679002</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0233677</umls5:cui>
        <rdfs:label xml:lang="en">Nihilistic Delusion</rdfs:label>
        <skos:definition xml:lang="en">&quot;A delusion that the self, part of the self, part of the body, other persons, or the whole world has ceased to exist.&quot; (ICD-11)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Nocturia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Nocturia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MedicalIllness"/>
        <ncit4:crossReference xml:lang="en">MESH:D053158
SNOMEDCT:139394000</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0028734</umls5:cui>
        <rdfs:label xml:lang="en">Nocturia</rdfs:label>
        <skos:definition xml:lang="en">&quot;Frequent episodes of urination during the night.&quot; - National Cancer Institute</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Noise -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Noise">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EnvironmentalCausativeFactor"/>
        <ncit4:crossReference xml:lang="en">MESH:D009622</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0028263</umls5:cui>
        <rdfs:label xml:lang="en">Noise</rdfs:label>
        <skos:definition xml:lang="en">MESH: &quot;Any sound which is unwanted or interferes with hearing other sounds.&quot;</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NoiseControl -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NoiseControl">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicalEnvironmentalIntervention"/>
        <umls5:cui xml:lang="en">C0509705</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the control or prevent undesirable or excessive noise.</rdfs:comment>
        <rdfs:label xml:lang="en">Noise Control</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NonpharmacologicalIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NonpharmacologicalIntervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Intervention"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isAffectedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FactorAffectingImplementationOfNonpharmacologicalInterventionToPsychoticSymptom"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/reducesPsychoticSymptomCausedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomCausativeFactor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PharmacologicalIntervention"/>
        <ncit4:synonym xml:lang="en">Environmental and Psychosocial Intervention</ncit4:synonym>
        <rdfs:comment xml:lang="en">It refers to the intervention which does not use drugs.</rdfs:comment>
        <rdfs:label xml:lang="en">Nonpharmacological Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NonpharmacologicalTreatmentKnowledge -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NonpharmacologicalTreatmentKnowledge">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/KnowledgeOfHealthCareProfessional"/>
        <rdfs:comment xml:lang="en">It refers to the health care professionals&apos; knowledge of using non-drug approaches to treat psychotic symptoms in dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Nonpharmacological Treatment Knowledge</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NorthEastVisualHallucinationsInterview -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NorthEastVisualHallucinationsInterview">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomAssessmentTool"/>
        <ncit4:abbreviation xml:lang="en">NEVHI</ncit4:abbreviation>
        <rdfs:comment xml:lang="en">It is a comprehensive assessment tool, developed by Mosimann et al in 2008, for identifying the presence of visual hallucinations; it is helpful to quantify cognitions, emotions and behaviours associated with hallucinations.</rdfs:comment>
        <rdfs:label xml:lang="en">North-East Visual Hallucinations Interview</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NumberOfChildren -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NumberOfChildren">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DemographicInformation"/>
        <umls5:cui xml:lang="en">C2229974</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to how many children a person has.</rdfs:comment>
        <rdfs:label xml:lang="en">Number of Children</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NursesObservationScaleForInpatientEvaluation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NursesObservationScaleForInpatientEvaluation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomAssessmentTool"/>
        <ncit4:abbreviation xml:lang="en">NOSIE</ncit4:abbreviation>
        <rdfs:label xml:lang="en">Nurses Observation Scale for Inpatient Evaluation</rdfs:label>
        <skos:definition xml:lang="en">The Nurses&apos; Observation Scale for Inpatient Evaluation is an inpatient ward behavior rating scale containing 80 items of ward behavior. From Fernandez et al. 2008 &quot;Scales to assess psychosis in Parkinson&apos;s Disease: critique and recommendations&quot;</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NursesObservationScaleForInpatientEvalution30Version -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NursesObservationScaleForInpatientEvalution30Version">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomAssessmentTool"/>
        <ncit4:abbreviation xml:lang="en">NOSIE-30</ncit4:abbreviation>
        <rdfs:label xml:lang="en">Nurses Observation Scale for Inpatient Evalution - 30 Version</rdfs:label>
        <skos:definition xml:lang="en">It is a revised version of the original version of the Nurses&apos; Observation Scale for Inpatient Evaluation with a selection of 30 items. From Hoigfeld et al. 1966 &quot;NOSIE-30: a treatment sensitive ward behaviour scale&quot;</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ObservingPsychoticSymptom -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ObservingPsychoticSymptom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ComprehensiveInitialAssessment"/>
        <rdfs:comment xml:lang="en">It refers to the activity of observing the psychotic symptoms.</rdfs:comment>
        <rdfs:label xml:lang="en">Observing Psychotic Symptom</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/OccupationalTherapist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/OccupationalTherapist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
        <ncit4:abbreviation xml:lang="en">OT</ncit4:abbreviation>
        <ncit4:crossReference xml:lang="en">MESH:D000072087
SNOMEDCT:80546007</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0028807</umls5:cui>
        <rdfs:label xml:lang="en">Occupational Therapist</rdfs:label>
        <skos:definition xml:lang="en">MESH defines Occupational Therapist as &quot;Professionals trained to help individuals develop or regain skills needed to achieve independence in their lives.&quot;</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/OccupationalTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/OccupationalTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychosocialRehabilitation"/>
        <ncit4:abbreviation xml:lang="en">OT</ncit4:abbreviation>
        <ncit4:crossReference xml:lang="en">MESH:D009788
SNOMEDCT:84478008</ncit4:crossReference>
        <umls5:cui xml:lang="en">C1318464</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the intervention of developing, recovering, or maintain the meaningful activities, or occupations, of individuals.</rdfs:comment>
        <rdfs:label xml:lang="en">Occupational Therapy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/OfferingComfortFood -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/OfferingComfortFood">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneralNursingCareIntervention"/>
        <ncit4:synonym xml:lang="en">Providing Comfort Food</ncit4:synonym>
        <umls5:cui xml:lang="en">C3650749</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the intervention of providing comfort food to a person, such as biscuits, cheese sticks, almonds and lollipop.</rdfs:comment>
        <rdfs:label xml:lang="en">Offering Comfort Food</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/OfferingDrink -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/OfferingDrink">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneralNursingCareIntervention"/>
        <ncit4:synonym xml:lang="en">Providing Drink, Giving Drink</ncit4:synonym>
        <rdfs:comment xml:lang="en">It refers to the intervention of offering drink to a person with dementia, such as water, warm milk or tea.</rdfs:comment>
        <rdfs:label xml:lang="en">Offering Drink</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/OlfactionImpairment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/OlfactionImpairment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SensoryImpairment"/>
        <ncit4:synonym xml:lang="en">Impaired Olfaction</ncit4:synonym>
        <umls5:cui xml:lang="en">C4014889</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the damaged sense of smell.</rdfs:comment>
        <rdfs:label xml:lang="en">Olfaction Impairment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/OlfactoryHallucination -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/OlfactoryHallucination">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Hallucination"/>
        <ncit4:crossReference xml:lang="en">MESH:D006212
SNOMEDCT:39672001</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Phantosmia</ncit4:synonym>
        <umls5:cui xml:lang="en">C0233765</umls5:cui>
        <rdfs:label xml:lang="en">Olfactory Hallucination</rdfs:label>
        <skos:definition xml:lang="en">It refers to the &quot;hallucinations involving the perception of odour (e.g., of burning rubber, decaying fish, orange peel) in the absence of an actual external stimulus.&quot; (ICD-11)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/OneOnOneInteraction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/OneOnOneInteraction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RealHumanContactIntervention"/>
        <ncit4:synonym xml:lang="en">One on One Time, One to One Interaction, 1:1 time, 1x1 time</ncit4:synonym>
        <rdfs:comment xml:lang="en">It refers to the intervention of one-on-one interaction.</rdfs:comment>
        <rdfs:label xml:lang="en">One on One Interaction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Ophthalmologist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Ophthalmologist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
        <ncit4:crossReference xml:lang="en">MESH:D000072163
SNOMEDCT:422234006</ncit4:crossReference>
        <umls5:cui xml:lang="en">C1704292</umls5:cui>
        <rdfs:label xml:lang="en">Ophthalmologist</rdfs:label>
        <skos:definition xml:lang="en">&quot;Qualified medical professionals specializing in medical and surgical treatment of defects and diseases of the eye.&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/OpioidAddiction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/OpioidAddiction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Addiction"/>
        <ncit4:crossReference xml:lang="en">MESH:D009293
SNOMEDCT:75544000</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Opiate Addiction, Opioid Dependence, Opiate Dependence</ncit4:synonym>
        <umls5:cui xml:lang="en">C0524662</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the addiction to opioids which sometimes called narcotics.</rdfs:comment>
        <rdfs:label xml:lang="en">Opioid Addiction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Optometrist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Optometrist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
        <ncit4:crossReference xml:lang="en">MESH:D000072162
SNOMEDCT:28229004</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0029146</umls5:cui>
        <rdfs:label xml:lang="en">Optometrist</rdfs:label>
        <skos:definition xml:lang="en">&quot;Qualified professionals trained in primary eye and vision care, including measurement of visual abilities, diagnosing disorders of the visual system and provision of treatment such as prescriptions for correction of visual defects with lenses or glasses and vision therapy.&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/OrganizationalCulture -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/OrganizationalCulture">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FactorAffectingImplementationOfNonpharmacologicalInterventionToPsychoticSymptom"/>
        <ncit4:crossReference xml:lang="en">MESH:D015279</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0029242</umls5:cui>
        <rdfs:label xml:lang="en">Organizational Culture</rdfs:label>
        <skos:definition xml:lang="en">&quot;Beliefs and values shared by all members of the organization. These shared values, which are subject to change, are reflected in the day to day management of the organization.&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Outburst -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Outburst">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EmotionalDistress"/>
        <ncit4:synonym xml:lang="en">Emotional Outburst</ncit4:synonym>
        <umls5:cui xml:lang="en">C0679475</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the sudden release of strong emotion.</rdfs:comment>
        <rdfs:label xml:lang="en">Outburst</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PANSS -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PANSS">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomAssessmentTool"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:273703003</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0451383</umls5:cui>
        <rdfs:label xml:lang="en">Positive and Negative Syndrome Scale</rdfs:label>
        <skos:definition xml:lang="en">The Positive and Negative Syndrome Scale is a 30-item scale with 7 positive symptom items, 7 negative symptom items, and 16 general psychopathology symptom items. From Kay et al. 1989 &quot;The Positive and Negative Syndrome Scale (PANSS): rationale and standardisation.&quot;</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PAS -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PAS">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomAssessmentTool"/>
        <rdfs:comment xml:lang="en">The Psychogeriatric Assessment Scales (PAS) provide an assessment of the clinical changes seen in dementia and depression.</rdfs:comment>
        <rdfs:label xml:lang="en">Psychogeriatric Assessment Scales</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://biostats.com.au/PAS/</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Pacing -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Pacing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyNonaggressiveBehaviour"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:74691006</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Pacing Up and Down</ncit4:synonym>
        <umls5:cui xml:lang="en">C0562458</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the behaviour of walking with regular slow or fast paces, especially without a particular destination.</rdfs:comment>
        <rdfs:label xml:lang="en">Pacing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Pain -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Pain">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MedicalIllness"/>
        <ncit4:crossReference xml:lang="en">MESH:D010146
SNOMEDCT:22253000</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Ache</ncit4:synonym>
        <umls5:cui xml:lang="en">C0030193</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the highly unpleasant physical sensation caused by illness or injury.</rdfs:comment>
        <rdfs:label xml:lang="en">Pain</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PainAssessment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PainAssessment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DeliriumAssessment"/>
        <ncit4:crossReference xml:lang="en">MESH:D010147
SNOMEDCT:225399009</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Pain Measurement, Assessing Pain</ncit4:synonym>
        <umls5:cui xml:lang="en">C0030198</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the actions performed to assess the pain of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Pain Assessment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ParkinsonPsychosisQuestionnaire -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ParkinsonPsychosisQuestionnaire">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomAssessmentTool"/>
        <ncit4:abbreviation xml:lang="en">PPQ</ncit4:abbreviation>
        <rdfs:label xml:lang="en">Parkinson Psychosis Questionnaire</rdfs:label>
        <skos:definition xml:lang="en">Parkinson Psychosis Questionnaire consists of screening questions for typical early signs and psychotic symptoms in Parkinson Disease and quantifies the frequency and severity of four clinical categories-sleep disturbances, hallucinations/illusions, delusions and orientation. From Brandstaedter et al. 2005 &quot;Development and evaluation of the Parkinson Psychosis Questionnaire: A screening-instrument for the early diagnosis of drug-induced psychosis in Parkinson&apos;s disease&quot;</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ParkinsonPsychosisRatingScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ParkinsonPsychosisRatingScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomAssessmentTool"/>
        <ncit4:abbreviation xml:lang="en">PPRS</ncit4:abbreviation>
        <umls5:cui xml:lang="en">C5190056</umls5:cui>
        <rdfs:label xml:lang="en">Parkinson Psychosis Rating Scale</rdfs:label>
        <skos:definition xml:lang="en">&quot;The Parkinson Psychosis Rating Scale was designed to assess the severity of specific symptoms of levodopa-induced psychosis in patients with Parkinson&apos;s disease. The scale is administered by the clinican and consists of six items, each rated from 1 (no symptoms) to 4 (extreme symptoms); total score ranges from 6 - 24 points.&quot; from Friedberg et al. 1998 &quot;Parkinson Psychosis Rating Scale: a practical instrument for grading psychosis in Parkinson&apos;s disease&quot;</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PastOccupation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PastOccupation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BackgroundOfPersonWithDementia"/>
        <ncit4:synonym xml:lang="en">Past Work, Former Career</ncit4:synonym>
        <rdfs:comment xml:lang="en">It refers to the information about the past occupations (job or profession) of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Past Occupation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PastoralCare -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PastoralCare">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IndividualTherapyForPsychoticSymptom"/>
        <ncit4:crossReference xml:lang="en">MESH:D010327
SNOMEDCT:105405003</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Pastoral Care Intervention, Pastoral Counseling</ncit4:synonym>
        <umls5:cui xml:lang="en">C0030643</umls5:cui>
        <rdfs:label xml:lang="en">Pastoral Care</rdfs:label>
        <skos:definition xml:lang="en">&quot;Counseling or comfort given by ministers, priests, rabbis, etc., to those in need of help with emotional problems or stressful situations.&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PastoralCounselor -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PastoralCounselor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
        <ncit4:synonym xml:lang="en">Pastoral Carer</ncit4:synonym>
        <umls5:cui xml:lang="en">C2985482</umls5:cui>
        <rdfs:label xml:lang="en">Pastoral Counselor</rdfs:label>
        <skos:definition xml:lang="en">&quot;A person who is trained to give spiritual and mental health advice.&quot; - National Cancer Institute</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PerceivedGender -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PerceivedGender">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GenderIdentity"/>
        <rdfs:comment xml:lang="en">It refers to the gender of a person that is perceived by oneself.</rdfs:comment>
        <rdfs:label xml:lang="en">Perceived Gender</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PerpetuatingFactor -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PerpetuatingFactor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomCausativeFactor"/>
        <rdfs:comment xml:lang="en">Perpetuating factors are those that keep a problem going, such as ongoing substance use and biological patterns (insomnia).</rdfs:comment>
        <rdfs:label xml:lang="en">Perpetuating Factor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersecutoryDelusion -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersecutoryDelusion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Delusion"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:216004</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Delusion of Persecution, Paranoid Delusion</ncit4:synonym>
        <umls5:cui xml:lang="en">C1704268</umls5:cui>
        <rdfs:label xml:lang="en">Persecutory Delusion</rdfs:label>
        <skos:definition xml:lang="en">&quot;A delusion in which the central theme is that one (or someone to whom one is close) is being attacked, mocked, harassed, cheated, conspired against, or persecuted.&quot; (ICD-11)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Person -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Person">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/providesBackgroundInformation"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BackgroundOfPersonWithDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit4:synonym xml:lang="en">People</ncit4:synonym>
        <rdfs:comment xml:lang="en">It refers to human beings related to the management of psychotic symptoms in people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Person</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonName -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonName">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DemographicInformation"/>
        <ncit4:crossReference xml:lang="en">MESH:D009275
SNOMEDCT:703503000</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0027365</umls5:cui>
        <rdfs:label xml:lang="en">Person Name</rdfs:label>
        <skos:definition xml:lang="en">&quot;Word or set of words by which a person is known, addressed, or referred to.&quot; (SNOMEDCT)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonReorientation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonReorientation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ReorientingPatient"/>
        <ncit4:synonym xml:lang="en">Reorientation to Person</ncit4:synonym>
        <rdfs:comment xml:lang="en">It refers to the activity of helping patient to figure out who a person is.</rdfs:comment>
        <rdfs:label xml:lang="en">Person Reorientation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonWithDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonWithDementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasBackground"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BackgroundOfPersonWithDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasDelusion"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Delusion"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasDementia"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Dementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasFamilyMember"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyMember"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasFriend"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Friend"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasGuardian"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Guardian"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasHallucination"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Hallucination"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasInterpreter"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Interpreter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasPsychoticSymptom"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isCaredBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit4:abbreviation xml:lang="en">PwD</ncit4:abbreviation>
        <ncit4:synonym xml:lang="en">People with Dementia, Resident, Demented Person, Patient With Dementia,</ncit4:synonym>
        <rdfs:comment xml:lang="en">It refers to the person with dementia who is living in the long term care.</rdfs:comment>
        <rdfs:label xml:lang="en">Person with Dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonWithDementiaFocusedIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonWithDementiaFocusedIntervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NonpharmacologicalIntervention"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/matches"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BackgroundOfPersonWithDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">It refers to the interventions targeting people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Person with Dementia Focused Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonalCareAssistant -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonalCareAssistant">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
        <ncit4:crossReference xml:lang="en">MESH:D009728
SNOMEDCT:224576000</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Nurses&apos; Aide, Nursing Assistant, Aid Nurse,  Assistant of Nursing, Care Worker,</ncit4:synonym>
        <umls5:cui xml:lang="en">C0028663</umls5:cui>
        <rdfs:label xml:lang="en">Personal Care Assistant</rdfs:label>
        <skos:definition xml:lang="en">National Uniform Claim Committee - Health Care Provider Taxonomy (NUCCPT) defined this term as &quot;(1) An unlicensed individual who is trained to function in an assistive role to the licensed nurse in the provision of patient/client activities as delegated by the nurse; (2) An individual trained (either on-the-job or through a formal course generally of less than one year) and experienced in performing patient or client-care nursing tasks that do not require the skills of a specialist, technician, or professional. Examples of tasks performed include changing clothes, diapers, and beds; assisting patients to perform exercises or personal hygiene tasks, and supporting communicaiton or social interaction.&quot;</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonalHistoryOfMentalHealth -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonalHistoryOfMentalHealth">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MedicalHistory"/>
        <ncit4:synonym xml:lang="en">Personal History of Mental and Behavioral Disorder</ncit4:synonym>
        <umls5:cui xml:lang="en">C2977653</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the personal history of mental and behavioral disorders.</rdfs:comment>
        <rdfs:label xml:lang="en">Personal History of Mental Health</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonalHygienePreference -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonalHygienePreference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Preferenece"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:304218004</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0582005</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the preference to personal hygiene, such as shaving preference, and hair care preference.</rdfs:comment>
        <rdfs:label xml:lang="en">Personal Hygiene Preference</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PetKeepingHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PetKeepingHobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Hobby"/>
        <rdfs:comment xml:lang="en">It refers to a hobby of keeping domestic animals as pets.</rdfs:comment>
        <rdfs:label xml:lang="en">Pet Keeping Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PharmacologicalIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PharmacologicalIntervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Intervention"/>
        <rdfs:comment xml:lang="en">It refers to the intervention which uses drugs.</rdfs:comment>
        <rdfs:label xml:lang="en">Pharmacological Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhoneCall -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhoneCall">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RealHumanContactIntervention"/>
        <rdfs:comment xml:lang="en">It refers to the treatment that involves having conversation with family members or friends of the person with dementia through the phone.</rdfs:comment>
        <rdfs:label xml:lang="en">Phone Call</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicalAbility -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicalAbility">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RemainingAbility"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:288329007</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Ability to Perform General Purpose Physical Activities</ncit4:synonym>
        <umls5:cui xml:lang="en">C0565668</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the ability to perform some physical act, such as move freely and easily.</rdfs:comment>
        <rdfs:label xml:lang="en">Physical Ability</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicalEnvironmentalIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicalEnvironmentalIntervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EnvironmentalIntervention"/>
        <rdfs:comment xml:lang="en">It refers to the intervention of modifying the physical environment of people living with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Physical Environmental Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicalRestraint -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicalRestraint">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IndividualTherapyForPsychoticSymptom"/>
        <ncit4:crossReference xml:lang="en">MESH:D012149
SNOMEDCT:386423001</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0035260</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the intervention of using physical means to restrict the movement of all or part of the body.</rdfs:comment>
        <rdfs:label xml:lang="en">Physical Restraint</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicalTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicalTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IndividualTherapyForPsychoticSymptom"/>
        <ncit4:crossReference xml:lang="en">MESH:D026741
SNOMEDCT:91251008</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Physiotherapy</ncit4:synonym>
        <umls5:cui xml:lang="en">C0949766</umls5:cui>
        <rdfs:label xml:lang="en">Physical Therapy</rdfs:label>
        <skos:definition xml:lang="en">It refers to &quot;therapies to prevent, correct, or alleviate dysfunction of anatomic or physiologic origin, employing physical phenomena such as temperature, light, water, and sound, as well as exercise and massage&quot; according to the Computer Retrieval of Information on Scientific Projects Thesaurus (CSP).</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyAggressiveBehaviour -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyAggressiveBehaviour">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Agitation"/>
        <ncit4:synonym xml:lang="en">Physical Aggression, Hurting Behaviour, Hurting</ncit4:synonym>
        <umls5:cui xml:lang="en">C4534295</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the behaviour that is aggressive or combative to self or others.</rdfs:comment>
        <rdfs:label xml:lang="en">Physically Aggressive Behaviour</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyNonaggressiveBehaviour -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyNonaggressiveBehaviour">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Agitation"/>
        <rdfs:comment xml:lang="en">It refers to the behaviours that are not intending to cause physical harm, but departing from an accepted standard.</rdfs:comment>
        <rdfs:label xml:lang="en">Physically Nonaggressive Behaviour</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Physician -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Physician">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
        <ncit4:crossReference xml:lang="en">MESH:D010820
SNOMEDCT:112247003</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Doctor, Medical Doctor</ncit4:synonym>
        <umls5:cui xml:lang="en">C0031831</umls5:cui>
        <rdfs:label xml:lang="en">Physician</rdfs:label>
        <skos:definition xml:lang="en">&quot;Individuals licensed to practice medicine.&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Physiotherapist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Physiotherapist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
        <umls5:cui xml:lang="en">C4724245</umls5:cui>
        <rdfs:label xml:lang="en">Physiotherapist</rdfs:label>
        <skos:definition xml:lang="en">&quot;A healthcare profession that assesses, diagnoses, treats, and works to prevent disease, disability, and movement disorders through physical means.&quot; - National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PlaceReorientation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PlaceReorientation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ReorientingPatient"/>
        <ncit4:synonym xml:lang="en">Reorientation to Place</ncit4:synonym>
        <rdfs:comment xml:lang="en">It refers to the activity of helping patient figure out where he/she is.</rdfs:comment>
        <rdfs:label xml:lang="en">Place Reorientation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PlacingCurtainOverWindow -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PlacingCurtainOverWindow">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicalEnvironmentalIntervention"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/reducesPsychoticSymptomCausedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/WindowReflection"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">It refers to the intervention of placing a curtain over a window.</rdfs:comment>
        <rdfs:label xml:lang="en">Placing Curtain Over Window</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PlayingCardHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PlayingCardHobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Hobby"/>
        <umls5:cui xml:lang="en">C2136032</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the hobby of playing cards.</rdfs:comment>
        <rdfs:label xml:lang="en">Playing Card Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PointingFinger -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PointingFinger">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyNonaggressiveBehaviour"/>
        <ncit4:synonym xml:lang="en">Finger Pointing</ncit4:synonym>
        <rdfs:comment xml:lang="en">It refers to the behaviour of pointing at someone with a finger to accuse he/she or suggest he/she is guilty.</rdfs:comment>
        <rdfs:label xml:lang="en">Pointing Finger</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PollenAllergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PollenAllergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Allergy"/>
        <ncit4:crossReference xml:lang="en">MESH:D006255
SNOMEDCT:44316004</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Hay Fever, Allergy to Pollen</ncit4:synonym>
        <umls5:cui xml:lang="en">C0018621</umls5:cui>
        <rdfs:label xml:lang="en">Pollen Allergy</rdfs:label>
        <skos:definition xml:lang="en">&quot;An allergy experienced at a particular time of year when trees or grasses pollinate and elicit an allergic reaction.&quot; (Human Phenotype Ontology)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Polypharmacy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Polypharmacy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MedicationEffect"/>
        <ncit4:crossReference xml:lang="en">MESH:D019338
SNOMEDCT:129846003</ncit4:crossReference>
        <umls5:cui xml:lang="en">C2922974</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the concurrent use of multiple medications by a patient.</rdfs:comment>
        <rdfs:label xml:lang="en">Polypharmacy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PoorQualityOfLife -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PoorQualityOfLife">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HarmToSelf"/>
        <ncit4:synonym xml:lang="en">Lower Quality of Life</ncit4:synonym>
        <umls5:cui xml:lang="en">C3686815</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the concept that psychotic symptoms has an effect on the individual&apos;s wellbeing and the ability to enjoy life.</rdfs:comment>
        <rdfs:label xml:lang="en">Poor Quality of Life</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PrecipitatingFactor -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PrecipitatingFactor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomCausativeFactor"/>
        <ncit4:crossReference xml:lang="en">MESH:D015985
SNOMEDCT:410658008</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Trigger, Triggering Factor, Provoking Factor</ncit4:synonym>
        <umls5:cui xml:lang="en">C0032930</umls5:cui>
        <rdfs:label xml:lang="en">Precipitating Factor</rdfs:label>
        <skos:definition xml:lang="en">&quot;The factor(s) that cause or trigger the onset of an occurrence.&quot; (National Cancer Institute)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PredisposingFactor -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PredisposingFactor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomCausativeFactor"/>
        <ncit4:crossReference xml:lang="en">MESH:D015984</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Contextual Factor</ncit4:synonym>
        <umls5:cui xml:lang="en">C0032946</umls5:cui>
        <rdfs:comment xml:lang="en">Predisposing factors are those that put an individual at risk of developing a problem, such as genetics and life events.</rdfs:comment>
        <rdfs:label xml:lang="en">Predisposing Factor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Preferenece -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Preferenece">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BackgroundOfPersonWithDementia"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:225773000</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0558295</umls5:cui>
        <rdfs:label xml:lang="en">Preference</rdfs:label>
        <skos:definition xml:lang="en">&quot;The act, fact, or principle of giving advantages to some particular person, object, or course of action over others; designated as more desirable.&quot; (National Cancer Institute)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PreferredLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PreferredLanguage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/LanguageInformation"/>
        <rdfs:comment xml:lang="en">It refers to the language most preferred by a person for communication.</rdfs:comment>
        <rdfs:label xml:lang="en">Preferred Language</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PresentBehaviouralExamination -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PresentBehaviouralExamination">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomAssessmentTool"/>
        <ncit4:abbreviation xml:lang="en">PBE</ncit4:abbreviation>
        <rdfs:comment xml:lang="en">It is an interview instrument for measuring behavioural abnormalities in dementia and other neuropsychiatric conditions, which is developed by Hope and Fairburn in 1992.</rdfs:comment>
        <rdfs:label xml:lang="en">Present Behavioural Examination</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ProvidingEyeglasses -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ProvidingEyeglasses">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ProvidingSensoryAid"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:7128000</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Provision of Eyeglasses, Provision of Spectacles</ncit4:synonym>
        <umls5:cui xml:lang="en">C0419274</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the intervention of providing eysglasses to a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Providing Eyeglasses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ProvidingHearingAid -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ProvidingHearingAid">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ProvidingSensoryAid"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:281656009</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Hearing Aid Provision, Auditory Aid Provision</ncit4:synonym>
        <umls5:cui xml:lang="en">C0554812</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the intervention of providing hearing aids to a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Providing Hearing Aid</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ProvidingOpportunityToDiscussHallucination -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ProvidingOpportunityToDiscussHallucination">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneralNursingCareIntervention"/>
        <ncit4:synonym xml:lang="en">Provide Patient with Opportunities to Discuss Hallucinations</ncit4:synonym>
        <umls5:cui xml:lang="en">C0515014</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the activity of providing patient with opportunities to discuss hallucinations.</rdfs:comment>
        <rdfs:label xml:lang="en">Providing Opportunity to Discuss Hallucination</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ProvidingSensoryAid -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ProvidingSensoryAid">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneralNursingCareIntervention"/>
        <rdfs:comment xml:lang="en">It refers to the items or devices that are designed to compensate for deficiencies in the sense organs, such as hearing impairment and vision impairment.</rdfs:comment>
        <rdfs:label xml:lang="en">Providing Sensory Aid</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychiatricDisorder -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychiatricDisorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MedicalIllness"/>
        <ncit4:crossReference xml:lang="en">MESH:D001523
SNOMEDCT:74732009</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Psychiatric Illness, Mental Disorder, Mental Disease, Mental Illness, Psychological Disorder, Psychological Dysfunction, Mental Dysfunction</ncit4:synonym>
        <umls5:cui xml:lang="en">C0004936</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the mental illness that greatly disturbs the thinking, moods, and/or behaviour and seriously increases the risk of disability, pain, death, or loss of freedom.</rdfs:comment>
        <rdfs:label xml:lang="en">Psychiatric Disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Psychiatrist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Psychiatrist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
        <ncit4:crossReference xml:lang="en">MESH:D011570
SNOMEDCT:80584001</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0033872</umls5:cui>
        <rdfs:label xml:lang="en">Psychiatrist</rdfs:label>
        <skos:definition xml:lang="en">&quot;A medical doctor who specializes in the prevention, diagnosis, and treatment of mental, emotional, and behavioral disorders.&quot; - National Cancer Institute.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Psychoeducation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Psychoeducation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychosocialTherapy"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:702545008</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0871175</umls5:cui>
        <rdfs:comment xml:lang="en">Psychoeducation is an evidence-based therapeutic intervention for patients that provides information and support to better understand and cope with illness.</rdfs:comment>
        <rdfs:label xml:lang="en">Psychoeducation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Psychogeriatric -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Psychogeriatric">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
        <ncit4:crossReference xml:lang="en">MESH:D005852</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Geriatric Psychiatry Specialty, Geriatric Psychiatry</ncit4:synonym>
        <umls5:cui xml:lang="en">C0017467</umls5:cui>
        <rdfs:label xml:lang="en">Psychogeriatric</rdfs:label>
        <skos:definition xml:lang="en">MESH defined it as &quot;a subspecialty of psychiatry concerned with the mental health of the aged&quot;.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Psychogeriatrician -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Psychogeriatrician">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Psychiatrist"/>
        <ncit4:synonym xml:lang="en">Old Age Psychiatrist</ncit4:synonym>
        <umls5:cui xml:lang="en">C0586880</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the psychiatrist specializing in the diagnosis and treatment of mental illness in elderly people.</rdfs:comment>
        <rdfs:label xml:lang="en">Psychogeriatrician</rdfs:label>
        <skos:definition xml:lang="en">SNOMEDCT:309364005</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Psychologist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Psychologist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
        <ncit4:crossReference xml:lang="en">MESH:D011584
SNOMEDCT:59944000</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0033908</umls5:cui>
        <rdfs:label xml:lang="en">Psychologist</rdfs:label>
        <skos:definition xml:lang="en">&quot;A specialist who can talk with patients and their families about emotional and personal matters, and can help them make decisions.&quot; - National Cancer Institute</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychosocialRehabilitation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychosocialRehabilitation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychosocialTherapy"/>
        <ncit4:abbreviation xml:lang="en">PSR</ncit4:abbreviation>
        <ncit4:crossReference xml:lang="en">MESH:D0000067250
SNOMEDCT:26890005</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Psychiatric Rehabilitation, Mental Health Rehabilitation</ncit4:synonym>
        <umls5:cui xml:lang="en">C0204512</umls5:cui>
        <rdfs:comment xml:lang="en">Psychosocial rehabilitation helps people with mental health problems to develop the social, emotional and intellectual skills they need in order to live happily.</rdfs:comment>
        <rdfs:label xml:lang="en">Psychosocial Rehabilitation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychosocialTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychosocialTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IndividualTherapyForPsychoticSymptom"/>
        <ncit4:synonym xml:lang="en">Psychosocial Intervention, Psychosocial Treatment</ncit4:synonym>
        <umls5:cui xml:lang="en">C0869937</umls5:cui>
        <rdfs:label xml:lang="en">Psychosocial Therapy</rdfs:label>
        <skos:definition xml:lang="en">It refers to the treatments that attempt to effect change through the manipulation of social or psychological factors. From Psychiatric Rehabilitation (Third Edition), 2014.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Psychotherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Psychotherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychosocialTherapy"/>
        <ncit4:crossReference xml:lang="en">MESH:D011613
SNOMEDCT:75516001</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Psychological Therapy, Talking Therapy, Talk Therapy</ncit4:synonym>
        <umls5:cui xml:lang="en">C0033968</umls5:cui>
        <rdfs:comment xml:lang="en">Psychotherapy is the use of psychological methods, particularly when based on regular interaction with patients, to help them change behaviour and overcome problems in desired ways.</rdfs:comment>
        <rdfs:label xml:lang="en">Psychotherapy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomAssessmentTool -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomAssessmentTool">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/assesses"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isUsedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:446167009</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Psychotic Symptom Rating Scale, Psychotic Symptom Assessment Scale</ncit4:synonym>
        <umls5:cui xml:lang="en">C2959702</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the tool or scale which is used to assess the psychotic symptoms of person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Psychotic Symptom Assessment Tool</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomCausativeFactor -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomCausativeFactor">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/causes"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isAddressedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Intervention"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit4:synonym xml:lang="en">Psychotic Symptom Causative Agent</ncit4:synonym>
        <rdfs:comment xml:lang="en">It refers to the factors that could cause the psychotic symptoms in dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Psychotic Symptom Causative Factor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomCompletelyStop -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomCompletelyStop">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CareGoal"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomStabilize"/>
        <rdfs:comment xml:lang="en">It refers to the care goal that is the patient&apos;s psychotic symptoms are completely stopped.</rdfs:comment>
        <rdfs:label xml:lang="en">Psychotic Symptom Completely Stop</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomEducationToFamilyMember -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomEducationToFamilyMember">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyMemberFocusedIntervention"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SupportToFamilyMember"/>
        <rdfs:comment xml:lang="en">It refers to the psychotic symptoms education that is provided to family members of people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Psychotic Symptom Education to Family Member</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomInDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomInDementia">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasDuration"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DurationOfPsychoticSymptom"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasEffect"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EffectOfPsychoticSymptom"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasFeature"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FeatureOfPsychoticSymptom"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasFrequency"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FrequencyOfPsychoticSymptom"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasPerformanceTime"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Time"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasSeverity"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SeverityOfPsychoticSymptom"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isAssessedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomAssessmentTool"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isCausedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomCausativeFactor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isPsychoticSymptomOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonWithDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isTreatedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Intervention"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit4:synonym xml:lang="en">Psychotic Symptoms in Dementia, Psychoses in Dementia, Psychosis in Dementia, Psychotic Disorder in Dementia</ncit4:synonym>
        <rdfs:label xml:lang="en">Psychotic Symptom in Dementia</rdfs:label>
        <skos:definition xml:lang="en">Psychotic symptoms in dementia are defined as &quot;a disturbance in the perception and/or appreciation of objective reality that could present in people with dementia&quot;. (Burns, Jayasinha, and Brodaty 2014 - A Clinician&apos;s field guide to good practice: managing behavioural and psychological symptoms of dementia&quot;)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomManagementActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomManagementActivity">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasManagementActionTime"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Time"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isConductedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">It refers to the activities conducted for managing psychotic symptoms in dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Psychotic Symptom Management Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomManagementOutcome -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomManagementOutcome">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isOutcomeOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Intervention"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit4:synonym xml:lang="en">Psychotic Symptom Treatment Outcome, Psychotic Symptom Treatment Effect, Outcome of Psychotic Symptom Treatment</ncit4:synonym>
        <rdfs:comment xml:lang="en">It refers to the result of intervention for psychotic symptoms in a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Psychotic Symptom Management Outcome</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomStabilize -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomStabilize">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CareGoal"/>
        <rdfs:comment xml:lang="en">It refers to the care goal of stabilizing (not becoming worse) the psychotic symptoms in a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Psychotic Symptom Stabilize</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PulmonaryInfection -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PulmonaryInfection">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Infection"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:128601007</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Lung Infection, Infectious Lung Disorder, Infectious Lung Disease, Infectious Disease of Lung</ncit4:synonym>
        <umls5:cui xml:lang="en">C0876973</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the lung infection which can be caused by a virus, bacteria, and fungus.</rdfs:comment>
        <rdfs:label xml:lang="en">Pulmonary Infection</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Punching -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Punching">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyAggressiveBehaviour"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:284626004</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Punching Other Person</ncit4:synonym>
        <umls5:cui xml:lang="en">C0562585</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the behaviour of stricking other person with the fist.</rdfs:comment>
        <rdfs:label xml:lang="en">Punching</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PunchingSelf -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PunchingSelf">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SelfHarmBehaviour"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:284757007</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0562717</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the behaviour of stricking oneself with the fist.</rdfs:comment>
        <rdfs:label xml:lang="en">Punching Self</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Pushing -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Pushing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyAggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">It refers to the behaviour of moving forward by using force to pass people or cause them to move aside.</rdfs:comment>
        <rdfs:label xml:lang="en">Pushing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Quarantine -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Quarantine">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IndividualTherapyForPsychoticSymptom"/>
        <ncit4:crossReference xml:lang="en">MESH:D011790
SNOMEDCT:170499009</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Contact Isolation, Isolation Quarantine</ncit4:synonym>
        <umls5:cui xml:lang="en">C0034386</umls5:cui>
        <rdfs:label xml:lang="en">Quarantine</rdfs:label>
        <skos:definition xml:lang="en">&quot;Restriction of freedom of movement of individuals who have been exposed to infectious or communicable disease in order to prevent its spread; a period of detention of vessels, vehicles, or travelers coming from infected or suspected contagion. It includes goverment regulations on the detention of animals at frontiers or ports of entrance for the prevention of infectious disease, through a period of isolation before being allowed to enter a country&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RamblingSpeech -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RamblingSpeech">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VerballyNonaggressiveBehaviour"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:162208002</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0423982</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the behaviour of talking at length in a confused or inconsequential way.</rdfs:comment>
        <rdfs:label xml:lang="en">Rambling Speech</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RapidCognitiveDecline -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RapidCognitiveDecline">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HarmToSelf"/>
        <umls5:cui xml:lang="en">C2750110</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the rapid decrease of the general mental capability of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Rapid Cognitive Decline</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ReadingBook -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ReadingBook">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RecreationalActivity"/>
        <rdfs:comment xml:lang="en">It refers to the activity of reading a book.</rdfs:comment>
        <rdfs:label xml:lang="en">Reading Book</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ReadingBookHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ReadingBookHobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Hobby"/>
        <rdfs:comment xml:lang="en">It refers to the hobby of reading books.</rdfs:comment>
        <rdfs:label xml:lang="en">Reading Book Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ReadingMagazine -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ReadingMagazine">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RecreationalActivity"/>
        <rdfs:comment xml:lang="en">It refers to the activity of reading a magazine.</rdfs:comment>
        <rdfs:label xml:lang="en">Reading Magazine</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ReadingNewspaper -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ReadingNewspaper">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RecreationalActivity"/>
        <rdfs:comment xml:lang="en">It refers to the activity of reading a newspaper.</rdfs:comment>
        <rdfs:label xml:lang="en">Reading Newspaper</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RealHumanContactIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RealHumanContactIntervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HumanContactIntervention"/>
        <rdfs:comment xml:lang="en">It refers to the treatment that involves of having real social interaction with other people.</rdfs:comment>
        <rdfs:label xml:lang="en">Real Human Contact Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RealityOrientationTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RealityOrientationTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IndividualTherapyForPsychoticSymptom"/>
        <umls5:cui xml:lang="en">C3650753</umls5:cui>
        <rdfs:comment xml:lang="en">Reality orientation is a psychological therapy aimed at reducing confusion and inappropriate behaviours in people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Reality Orientation Therapy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Reassurance -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Reassurance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneralNursingCareIntervention"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:223476006</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Providing Reassurance and Comfort, Reassuring</ncit4:synonym>
        <umls5:cui xml:lang="en">C0514711</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the intervention of letting the person with dementia know health care professionals are there and will keep him or her safe.</rdfs:comment>
        <rdfs:label xml:lang="en">Reassurance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Recognition -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Recognition">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CognitiveAbility"/>
        <ncit4:crossReference xml:lang="en">MESH:D021641
SNOMEDCT:312020002</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Psychological Recognition, Psychology Recognition</ncit4:synonym>
        <umls5:cui xml:lang="en">C0524637</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the ability to identify stimuli, like situations, places, people, objects, etc. that a person have seen before.</rdfs:comment>
        <rdfs:label xml:lang="en">Recognition</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RecreationalActivitiesOfficer -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RecreationalActivitiesOfficer">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
        <ncit4:abbreviation xml:lang="en">RAO</ncit4:abbreviation>
        <rdfs:comment xml:lang="en">Recreational activities officer will drive the energy, engagement and participation of residents into a range of social, recreational and cultural activities, as well as mental health and wellbeing programs, tha empower the residents&apos; choices and independence.</rdfs:comment>
        <rdfs:label xml:lang="en">Recreational Activities Officer</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RecreationalActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RecreationalActivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IndividualTherapyForPsychoticSymptom"/>
        <ncit4:crossReference xml:lang="en">MESH:D011998</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Recreation</ncit4:synonym>
        <umls5:cui xml:lang="en">C0034872</umls5:cui>
        <rdfs:label xml:lang="en">Recreational Activity</rdfs:label>
        <skos:definition xml:lang="en">&quot;Activity engaged in for pleasure.&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RecreationalTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RecreationalTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IndividualTherapyForPsychoticSymptom"/>
        <ncit4:abbreviation xml:lang="en">RT</ncit4:abbreviation>
        <ncit4:crossReference xml:lang="en">MESH:D057173
SNOMEDCT:42364006</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Therapeutic Recreation Therapy, Therapeutic Recreation</ncit4:synonym>
        <umls5:cui xml:lang="en">C0034873</umls5:cui>
        <rdfs:label xml:lang="en">Recreational Therapy</rdfs:label>
        <skos:definition xml:lang="en">Recreational therapy is a systematic process that utilizes recreation and other activity-based interventions to address the assessed needs of individuals with illness and/or disabling condition, as a means to psychological and physical health, recovery and well-being. Defined by National Council for Therapeutic Recreation Certification https://www.nctrc.org/about-ncrtc/about-recreational-therapy/</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Redirection -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Redirection">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneralNursingCareIntervention"/>
        <ncit4:synonym xml:lang="en">Use Diversion to Redirect Inappropriate Behavior, Diverting, Diversion</ncit4:synonym>
        <umls5:cui xml:lang="en">C0547409</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the intervention of assigning or directing a person something else to do as a substitute.</rdfs:comment>
        <rdfs:label xml:lang="en">Redirection</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ReferralToASpecialist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ReferralToASpecialist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneralNursingCareIntervention"/>
        <umls5:cui xml:lang="en">C0849620</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the act of referring a patient to a specialist for consultation, review, or further action.</rdfs:comment>
        <rdfs:label xml:lang="en">Referral to a Specialist</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RefugeeFromWarRelatedArea -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RefugeeFromWarRelatedArea">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RefugeeImmigration"/>
        <rdfs:comment xml:lang="en">It refers the imgrant as a refugee from a war related area.</rdfs:comment>
        <rdfs:label xml:lang="en">Refugee From War Related Area</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RefugeeImmigration -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RefugeeImmigration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ImmigrationType"/>
        <rdfs:comment xml:lang="en">It refers to  the type of immigration that a person is forced to flee for their lives (as a refugee) and choose to move to another country .</rdfs:comment>
        <rdfs:label xml:lang="en">Refugee Immigration</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RegisteredNurse -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RegisteredNurse">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
        <ncit4:abbreviation xml:lang="en">RN</ncit4:abbreviation>
        <ncit4:crossReference xml:lang="en">MESH:D009726
SNOMEDCT:224535009</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0687673</umls5:cui>
        <rdfs:label xml:lang="en">Registered Nurse</rdfs:label>
        <skos:definition xml:lang="en">National Cancer Institute (NCI) defined Registered Nurse as &quot;a nurse who has graduated from an accredited registered nursing program, has passed the state exam for licensure, and been registered and licensed to practice by a state authority. R.N.s receive educational preparation through hospital-based diploma programs, community/junior college associate&apos;s degree programs, baccalaureate programs, or combinations thereof.&quot;</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Relationship -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Relationship">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BackgroundOfPersonWithDementia"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:272151006</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0439849</umls5:cui>
        <rdfs:label xml:lang="en">Relationship</rdfs:label>
        <skos:definition xml:lang="en">&quot;A state of connectedness between people, objects, or events; to be associated or connected with something.&quot; - U.S. National Cancer Institute.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RelationshipWithFamilyMember -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RelationshipWithFamilyMember">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Relationship"/>
        <rdfs:comment xml:lang="en">It refers to the state of connectedness between a person and his/her family member(s).</rdfs:comment>
        <rdfs:label xml:lang="en">Relationship with Family Member</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RelationshipWithFriend -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RelationshipWithFriend">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Relationship"/>
        <rdfs:comment xml:lang="en">It refers to the state of connectedness between a person and his/her frined(s).</rdfs:comment>
        <rdfs:label xml:lang="en">Relationship with Friend</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RelationshipWithPet -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RelationshipWithPet">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Relationship"/>
        <rdfs:comment xml:lang="en">It refers to the state of connectedness between a person and his/her pet(s).</rdfs:comment>
        <rdfs:label xml:lang="en">Relationship with Pet</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Religion -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Religion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DemographicInformation"/>
        <ncit4:crossReference xml:lang="en">MESH:D012067</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0035039</umls5:cui>
        <rdfs:label xml:lang="en">Religion</rdfs:label>
        <skos:definition xml:lang="en">&quot;A personal or institutionalized system grounded in belief and reverence for a supernatural power or powers regarded as creator and governor of the universe.&quot; (from dictionary.com)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ReligiousBelief -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ReligiousBelief">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Belief"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:1400009</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0035045</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to attitudes towards mythological, supernatural, or spiritual aspects of a religion.</rdfs:comment>
        <rdfs:label xml:lang="en">Religious Belief</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ReligiousDelusion -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ReligiousDelusion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Delusion"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:247671004</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0424021</umls5:cui>
        <rdfs:label xml:lang="en">Religious Delusion</rdfs:label>
        <skos:definition xml:lang="en">&quot;A delusion involving religious or spiritual themes or subject matter that other members of the person&apos;s religious group do not accept as possible.&quot; (ICD-11)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RelocatingPatientToAnotherAppropriateArea -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RelocatingPatientToAnotherAppropriateArea">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneralNursingCareIntervention"/>
        <rdfs:comment xml:lang="en">It refers to the intervention of relocating a patient to another area which is appropirate and comfortable.</rdfs:comment>
        <rdfs:label xml:lang="en">Relocating Patient to Another Appropirate Area</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RemainingAbility -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RemainingAbility">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BackgroundOfPersonWithDementia"/>
        <rdfs:comment xml:lang="en">It refers to the abilities that are still existing.</rdfs:comment>
        <rdfs:label xml:lang="en">Remaining Ability</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ReminiscenceTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ReminiscenceTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IndividualTherapyForPsychoticSymptom"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:228549005</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0150321</umls5:cui>
        <rdfs:label xml:lang="en">Reminiscence Therapy</rdfs:label>
        <skos:definition xml:lang="en">&quot;Using the recall of past events, feelings, and thoughts to facilitate pleasure, quality of life, or adaptation to present circumstances.&quot; - Nursing Interventions Classification</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RemovingDangerousObject -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RemovingDangerousObject">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicalEnvironmentalIntervention"/>
        <ncit4:synonym xml:lang="en">Remove From Environment Sharp or Blunt Ojects that could be Used to Injure Patient or Others</ncit4:synonym>
        <umls5:cui xml:lang="en">C0548146</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the environmental intervention of removing objects (sharp or blunt) that could be used to harm or injure patient or others.</rdfs:comment>
        <rdfs:label xml:lang="en">Removing Dangerous Object</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RemovingMirror -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RemovingMirror">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicalEnvironmentalIntervention"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/reducesPsychoticSymptomCausedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MirrorReflection"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <umls5:cui xml:lang="en">C4710625</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the intervention of removing mirrors from the living environment of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Removing Mirror</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ReorientingPatient -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ReorientingPatient">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneralNursingCareIntervention"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:53236004</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Reorientation</ncit4:synonym>
        <umls5:cui xml:lang="en">C0204745</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the activity of changing the focus or direction of a patient in order to help him/her to find the reality.</rdfs:comment>
        <rdfs:label xml:lang="en">Reorienting Patient</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RepetitivePhysicalMannerism -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RepetitivePhysicalMannerism">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyNonaggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">It refers to the behaviour of behaving certain physical actions repetitively.</rdfs:comment>
        <rdfs:label xml:lang="en">Repetitive Physical Mannerism</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RepetitiveQuestioning -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RepetitiveQuestioning">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VerballyNonaggressiveBehaviour"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:609583009</ncit4:crossReference>
        <umls5:cui xml:lang="en">C3662016</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the behaviour of questioning repetitively.</rdfs:comment>
        <rdfs:label xml:lang="en">Repetitive Questioning</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Repositioning -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Repositioning">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneralNursingCareIntervention"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:308739004</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0556030</umls5:cui>
        <rdfs:label xml:lang="en">Repositioning</rdfs:label>
        <skos:definition xml:lang="en">&quot;The act of placing in a new position.&quot; - National Cancer Institute</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ReschedulingRoutine -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ReschedulingRoutine">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneralNursingCareIntervention"/>
        <rdfs:comment xml:lang="en">It refers to the intervention fo rescheduling the care routine of person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Rescheduling Routine</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Resisting -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Resisting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyAggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">It refers to the refusal to accept or comply with something, such as resisting care.</rdfs:comment>
        <rdfs:label xml:lang="en">Resisting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RespiratoryDisease -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RespiratoryDisease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MedicalIllness"/>
        <ncit4:crossReference xml:lang="en">MESH:D012120
SNOMEDCT:50043002</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Respiratory Illness, Respiration Disorder, Disease of the Respiratory System, Respiratory System Disorder, Disorder of Respiratory System</ncit4:synonym>
        <umls5:cui xml:lang="en">C0035204</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the diseases of respiratory system.</rdfs:comment>
        <rdfs:label xml:lang="en">Respiratory Disease</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RespiratoryTractInfection -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RespiratoryTractInfection">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Infection"/>
        <ncit4:abbreviation xml:lang="en">URTI</ncit4:abbreviation>
        <ncit4:crossReference xml:lang="en">MESH:D012141
SNOMEDCT:54150009</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Upper Respiratory Infection</ncit4:synonym>
        <umls5:cui xml:lang="en">C00411912</umls5:cui>
        <rdfs:label xml:lang="en">Respiratory Tract Infection</rdfs:label>
        <skos:definition xml:lang="en">&quot;An upper respiratory tract infection is an illness caused by an acute infection, which involves the upper respiratory tract, including the nose, sinuses, pharynx, or larynx.&quot; - Wikipedia</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RestlessSleep -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RestlessSleep">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SleepDisturbance"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:12262002</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0235160</umls5:cui>
        <rdfs:label xml:lang="en">Restless Sleep</rdfs:label>
        <skos:definition xml:lang="en">&quot;Restless sleep may involve the following issues: tossing and turning trying to get settled and comfortable; the feeling of being only half-asleep or that you’re not sleeping deeply; constant stirring because your mind is racing; frustration with the inability to sleep soundly; not being able to fall back asleep quickly after waking up unexpectedly. A main sign or symptom of restless sleep is often found the next day, when an individual may feel tired, sluggish, or mentally off.&quot; (SleepFoundation.org)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Restlessness -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Restlessness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyNonaggressiveBehaviour"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:162221009</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Restlessness Behaviour</ncit4:synonym>
        <umls5:cui xml:lang="en">C3887611</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the restless behaviour.</rdfs:comment>
        <rdfs:label xml:lang="en">Restlessness</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ReviewingMedicalHistory -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ReviewingMedicalHistory">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ComprehensiveInitialAssessment"/>
        <umls5:cui xml:lang="en">C0677073</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the activity of reviewing the medical history of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Reviewing Medical History</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Roaring -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Roaring">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VerballyNonaggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">It refers to the behaviour of making a very loud, deep, prolonged sound.</rdfs:comment>
        <rdfs:label xml:lang="en">Roaring</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Rocking -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Rocking">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyNonaggressiveBehaviour"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:30189004</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Body Rocking, Repetitive Rocking Movements</ncit4:synonym>
        <umls5:cui xml:lang="en">C0005899</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the behaviour of repetitively moving body gently to and from side to side.</rdfs:comment>
        <rdfs:label xml:lang="en">Rocking</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RoleIdentity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RoleIdentity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BackgroundOfPersonWithDementia"/>
        <rdfs:comment xml:lang="en">It refers to the role (or character) people play when holding specific positions in groups.</rdfs:comment>
        <rdfs:label xml:lang="en">Role Identity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RoomTemperatureControl -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RoomTemperatureControl">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicalEnvironmentalIntervention"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:278417005</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0457548</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the activity of controlling the room temperature.</rdfs:comment>
        <rdfs:label xml:lang="en">Room Temperature Control</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Rummaging -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Rummaging">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyNonaggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">It refers to the behaviour of disorganised foraging.</rdfs:comment>
        <rdfs:label xml:lang="en">Rummaging</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RushHallucinationInventory -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RushHallucinationInventory">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomAssessmentTool"/>
        <ncit4:abbreviation xml:lang="en">RHI</ncit4:abbreviation>
        <umls5:cui xml:lang="en">C5190207</umls5:cui>
        <rdfs:label xml:lang="en">Rush Hallucination Inventory</rdfs:label>
        <skos:definition xml:lang="en">Rush Hallucination Inventory contains 53 items including informational questions and questions about frequency and duration ratings. From Fernandez et al. 2008 &quot;Scales to assess psychosis in Parkinson&apos;s Disease: critique and recommendations&quot;</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ScaleForAssessmentOfPositiveSymptomsParkinsonsDiseaseAdopted -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ScaleForAssessmentOfPositiveSymptomsParkinsonsDiseaseAdopted">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomAssessmentTool"/>
        <ncit4:abbreviation xml:lang="en">SAPS-PD</ncit4:abbreviation>
        <rdfs:comment xml:lang="en">It is a shortened Scale for Assessment of Positive Symptoms for Parkinson&apos;s disease, developed by Voss et al in 2013. The Scale for the Assessment of Positive Symptoms (SAPS) is a rating scale to measure postive symtpoms in schizophrenia. The scale was developed by Nacy Andreasen and was first published in 1984.</rdfs:comment>
        <rdfs:label xml:lang="en">Scale for the Assessment of Positive Symptoms - Parkinson&apos;s Disease-Adopted</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Schizophrenia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Schizophrenia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychiatricDisorder"/>
        <ncit4:crossReference xml:lang="en">MESH:D012559
SNOMEDCT:58214004</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Schizaphrenic Disorder</ncit4:synonym>
        <umls5:cui xml:lang="en">C0036341</umls5:cui>
        <rdfs:comment xml:lang="en">Schizophrenia is a significant mental illness that causes someone to have an altered experience of reality. It affects people&apos;s thoughts, perceptions and behaviour and interferes with their ability to function in their daily life.</rdfs:comment>
        <rdfs:label xml:lang="en">Schizophrenia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Scratching -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Scratching">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyAggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">It refers to the behaviour of marking the surface of something with a sharp or pointed object; and hurting someone&apos;s body with one&apos;s fingernails.</rdfs:comment>
        <rdfs:label xml:lang="en">Scratching</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Screaming -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Screaming">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VerballyNonaggressiveBehaviour"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:81916006</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0521008</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the behaviour of making a loud, piercing sound.</rdfs:comment>
        <rdfs:label xml:lang="en">Screaming</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Searching -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Searching">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyNonaggressiveBehaviour"/>
        <ncit4:synonym xml:lang="en">Searching Behaviour</ncit4:synonym>
        <umls5:cui xml:lang="en">C4050474</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the behaviour of thoroughly scrutinizing, especially in a disconcering way.</rdfs:comment>
        <rdfs:label xml:lang="en">Searching</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SecondGenerationImmigrant -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SecondGenerationImmigrant">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ImmigrantGenerationStatus"/>
        <umls5:cui xml:lang="en">C2047974</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the individuals who have at least one foreign-born parent.</rdfs:comment>
        <rdfs:label xml:lang="en">Second Generation Immigrant</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Seizure -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Seizure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MedicalIllness"/>
        <ncit4:crossReference xml:lang="en">MESH:D012640
SNOMEDCT:91175000</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0036572</umls5:cui>
        <rdfs:label xml:lang="en">Seizure</rdfs:label>
        <skos:definition xml:lang="en">MESH:&quot;Clinical or subclinical disturbances of cortical function due to a sudden, abnormal, excessive, and disorganized discharge of brain cells. Clinical manifestations include abnormal motor, sensory, and psychic phenomena. Recurrent seizures are usually referred to as Epilepsy or &quot;seizure disorder.&quot;</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SelfHarmBehaviour -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SelfHarmBehaviour">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyAggressiveBehaviour"/>
        <ncit4:synonym xml:lang="en">Self Injurious Behaviour, Self Harm, Self Injury, Self Destructive Behaviour, Huring Self</ncit4:synonym>
        <umls5:cui xml:lang="en">C0085271</umls5:cui>
        <rdfs:label xml:lang="en">Self Harm Behaviour</rdfs:label>
        <skos:definition xml:lang="en">&quot;Behavior in which persons hurt or harm themselves without the motive of suicide or of sexual deviation.&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SelfTalk -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SelfTalk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VerballyNonaggressiveBehaviour"/>
        <ncit4:synonym xml:lang="en">Self Talking</ncit4:synonym>
        <umls5:cui xml:lang="en">C0871330</umls5:cui>
        <rdfs:label xml:lang="en">Self Talk</rdfs:label>
        <skos:definition xml:lang="en">&quot;Vocalized or unvocalized speech that is directed to oneself or an imaginary recipient.&quot; - Psychological Index Terms</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SelfmanagementSkillTraining -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SelfmanagementSkillTraining">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychosocialRehabilitation"/>
        <ncit4:synonym xml:lang="en">Self-Management and Resistance Training</ncit4:synonym>
        <umls5:cui xml:lang="en">C0814412</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to using self-managed coping strategies such as cognitive, interactive, and visual techniques to manage psychotic symptoms.</rdfs:comment>
        <rdfs:label xml:lang="en">Self-management Skill Training</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SensoryAbility -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SensoryAbility">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RemainingAbility"/>
        <ncit4:synonym xml:lang="en">Sensory Status</ncit4:synonym>
        <umls5:cui xml:lang="en">C4068684</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the ability of the sense organs (e.g., eye, ear, nose, skin) to receive input accurately from the sense organs.</rdfs:comment>
        <rdfs:label xml:lang="en">Sensory Ability</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SensoryBoxActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SensoryBoxActivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RecreationalActivity"/>
        <ncit4:synonym xml:lang="en">Fiddle Box, Dementia Fiddle Box</ncit4:synonym>
        <rdfs:comment xml:lang="en">It refers to the activity of playing a sensory box, which is container filled with everyday objects to assist people with dementia to interact, communicate, and reminisce.</rdfs:comment>
        <rdfs:label xml:lang="en">Sensory Box Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SensoryImpairment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SensoryImpairment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IntrapersonalCausativeFactor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/causes"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Hallucination"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit4:synonym xml:lang="en">Sensory Deprivation, Sensory Deficit, Sensory Defect</ncit4:synonym>
        <umls5:cui xml:lang="en">C3809741</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the concept that people can experience psychotic symptoms because of the damaged physical senses.</rdfs:comment>
        <rdfs:label xml:lang="en">Sensory Impairment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SeverityOfPsychoticSymptom -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SeverityOfPsychoticSymptom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FeatureOfPsychoticSymptom"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isSeverityOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit4:synonym xml:lang="en">Severity Level of Psychotic Symptom</ncit4:synonym>
        <rdfs:comment xml:lang="en">It refers to the severity level of a psychotic symptom in dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Severity of Psychotic Symptom</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Sexuality -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Sexuality">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BackgroundOfPersonWithDementia"/>
        <ncit4:crossReference xml:lang="en">MESH:D019529
SNOMEDCT:118200004</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0036915</umls5:cui>
        <rdfs:label xml:lang="en">Sexuality</rdfs:label>
        <skos:definition xml:lang="en">&quot;The sexual functions, activities, attitudes, and orientations of an individual.&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ShavingPreference -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ShavingPreference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonalHygienePreference"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:304221002</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0582058</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the preference to shaving, such as preference to dry shave or wet shave.</rdfs:comment>
        <rdfs:label xml:lang="en">Shaving Preference</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Shouting -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Shouting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VerballyNonaggressiveBehaviour"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:284594001</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Yelling</ncit4:synonym>
        <umls5:cui xml:lang="en">C0562551</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the behaviour of making a loud cry.</rdfs:comment>
        <rdfs:label xml:lang="en">Shouting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Shoving -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Shoving">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyAggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">It refers to the behaviour of pushing someone or something roughly.</rdfs:comment>
        <rdfs:label xml:lang="en">Shoving</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ShuttingOffBrightLight -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ShuttingOffBrightLight">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingAppropriateLighting"/>
        <rdfs:comment xml:lang="en">It refers to shut off bright light.</rdfs:comment>
        <rdfs:label xml:lang="en">Shutting Off Bright Light</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ShuttingOffIntercomSystem -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ShuttingOffIntercomSystem">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NoiseControl"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/reducesPsychoticSymptomCausedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/InroomIntercom"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">It refers to the intervention of shutting off the intercommunication system.</rdfs:comment>
        <rdfs:label xml:lang="en">Shutting Off Intercom System</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SimulatedPresenceTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SimulatedPresenceTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HumanContactIntervention"/>
        <ncit4:abbreviation xml:lang="en">SPT</ncit4:abbreviation>
        <rdfs:comment xml:lang="en">It refers to the treatment that involves playing a personalized video or audiotape recording of family members to the person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Simulated Presence Therapy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Sister -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Sister">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyMember"/>
        <ncit4:crossReference xml:lang="en">MESH:D035781
SNOMEDCT:27733009</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0337514</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to a female sibling of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Sister</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SisterInLaw -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SisterInLaw">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyMember"/>
        <umls5:cui xml:lang="en">C2350006</umls5:cui>
        <rdfs:label xml:lang="en">Sister-in-law</rdfs:label>
        <skos:definition xml:lang="en">&quot;A sister by marriage.&quot; (National Cancer Institute)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SkilledImmigration -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SkilledImmigration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ImmigrationType"/>
        <rdfs:comment xml:lang="en">It refers to the type of immigration that people are invited to live in other countries to fill critical labor gaps and contribute specialized skills.</rdfs:comment>
        <rdfs:label xml:lang="en">Skilled Immigration</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Slamming -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Slamming">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyAggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">It refers to the behaviour of shutting something (such as a door or window) forcefully and loudly.</rdfs:comment>
        <rdfs:label xml:lang="en">Slamming</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SleepDisturbance -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SleepDisturbance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IntrapersonalCausativeFactor"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:53888004</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Diffculty Sleeping, Sleep Dysfunction, Trouble Sleeping, Disturbance in Sleep Behavior</ncit4:synonym>
        <umls5:cui xml:lang="en">C0037317</umls5:cui>
        <rdfs:comment xml:lang="en">Sleep disorders are conditions that result in changes in the way that a person sleep. Sleep disturbances lead to altered dream phenomena, which later lead to frank daytime hallucinations and delusions.</rdfs:comment>
        <rdfs:label xml:lang="en">Sleep Disturbance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SocialEnvironmentalIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SocialEnvironmentalIntervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EnvironmentalIntervention"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:719861005</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Modification of Social Environment</ncit4:synonym>
        <umls5:cui xml:lang="en">C4304386</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the intervention of modifying social environment of people living with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Social Environmental Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SocialHistory -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SocialHistory">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BackgroundOfPersonWithDementia"/>
        <umls5:cui xml:lang="en">C3714536</umls5:cui>
        <rdfs:label xml:lang="en">Social History</rdfs:label>
        <skos:definition xml:lang="en">&quot;Past events that occurred between individuals and/or their communities.&quot; - National Cancer Institute</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SocialIsolation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SocialIsolation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EnvironmentalCausativeFactor"/>
        <ncit4:crossReference xml:lang="en">MESH:D012934
SNOMEDCT:422650009</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0037421</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the concept that people with dementia can present psychotic symptoms if they are left alone and lack of interaction with others.</rdfs:comment>
        <rdfs:label xml:lang="en">Social Isolation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SocialMediaVideoCall -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SocialMediaVideoCall">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RealHumanContactIntervention"/>
        <rdfs:comment xml:lang="en">It refers to the treatment that involves having converstion with others through social media video software, such as talking with families using Zoom.</rdfs:comment>
        <rdfs:label xml:lang="en">Social Media Video Call</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SocialOuting -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SocialOuting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RecreationalActivity"/>
        <ncit4:synonym xml:lang="en">Going to a Party or Other Social Outing</ncit4:synonym>
        <umls5:cui xml:lang="en">C3842924</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to an outing devoted to an social gathering, such as going out for a party or a picnic.</rdfs:comment>
        <rdfs:label xml:lang="en">Social Outing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SocialRole -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SocialRole">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RoleIdentity"/>
        <ncit4:crossReference xml:lang="en">MESH:D012380</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0035820</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the role (or character) people play when holding specific social positions in a functional group, such as a club, sorority, fraternity, or the personnel of such a structure whose purpose is for social interactions.</rdfs:comment>
        <rdfs:label xml:lang="en">Social Role</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SocializationHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SocializationHobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Hobby"/>
        <rdfs:comment xml:lang="en">It refers to the hobby of socializing with others.</rdfs:comment>
        <rdfs:label xml:lang="en">Socialization Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SomaticDelusion -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SomaticDelusion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Delusion"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:33323008</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Somatic Delusion Disorder</ncit4:synonym>
        <umls5:cui xml:lang="en">C0349746</umls5:cui>
        <rdfs:label xml:lang="en">Somatic Delusion</rdfs:label>
        <skos:definition xml:lang="en">&quot;A delusion involving the functioning or appearance of one&apos;s body, including of having a serious disease.&quot; (ICD-11)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SomaticHallucination -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SomaticHallucination">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Hallucination"/>
        <ncit4:crossReference xml:lang="en">MESH:D006212
SNOMEDCT:85550003</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Hallucinations of Internal Bodily Sensation</ncit4:synonym>
        <umls5:cui xml:lang="en">C0233774</umls5:cui>
        <rdfs:label xml:lang="en">Somatic Hallucination</rdfs:label>
        <skos:definition xml:lang="en">It refers to the &quot;hallucinations involving the perception of an unusual physical state or event within the body, such as an electrical impulse running down one&apos;s arms or an object inside one&apos;s chest.&quot; (ICD-11)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Son -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Son">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyMember"/>
        <ncit4:crossReference xml:lang="en">MESH:D009679
SNOMEDCT:65616008</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0037683</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the male child of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Son</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SonInLaw -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SonInLaw">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyMember"/>
        <umls5:cui xml:lang="en">C2350007</umls5:cui>
        <rdfs:label xml:lang="en">Son-in-law</rdfs:label>
        <skos:definition xml:lang="en">&quot;The husband of one&apos;s daughter.&quot; (National Cancer Institute)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SpacedRetrievalIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SpacedRetrievalIntervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IndividualTherapyForPsychoticSymptom"/>
        <rdfs:comment xml:lang="en">Spaced retrieval Intervention is a method that helps a person with dementia always place an item in the same location.</rdfs:comment>
        <rdfs:label xml:lang="en">Spaced Retrieval Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SpeakingInExcessivelyLoudVoice -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SpeakingInExcessivelyLoudVoice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VerballyNonaggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">It refers to the behaviour of speaking in a voice which is excessively loud.</rdfs:comment>
        <rdfs:label xml:lang="en">Speaking in Excessively Loud Voice</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SpeechTherapist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SpeechTherapist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
        <ncit4:abbreviation xml:lang="en">ST</ncit4:abbreviation>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:159026005</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Speech Pathologist, Speech Language Therapist</ncit4:synonym>
        <umls5:cui xml:lang="en">C0402015</umls5:cui>
        <rdfs:label xml:lang="en">Speech Therapist</rdfs:label>
        <skos:definition xml:lang="en">&quot;A specialist who evaluates and treats people with communication and swallowing problems.&quot; - National Cancer Institute</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SpiritualBelief -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SpiritualBelief">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Belief"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:1400009</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0683811</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the acceptance of a superior being and is related to an existential perspective on life, death, and the nature of reality.</rdfs:comment>
        <rdfs:label xml:lang="en">Spiritual Belief</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Spitting -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Spitting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyAggressiveBehaviour"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:284646009</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Spitting at Other Person, Spitting on People</ncit4:synonym>
        <umls5:cui xml:lang="en">C0562604</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the behaviour of ejecting saliva forcibly from one&apos;s mouth and spitting at other person.</rdfs:comment>
        <rdfs:label xml:lang="en">Spitting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Staring -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Staring">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyAggressiveBehaviour"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:103262002</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0423086</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the behaviour of looking fixedly or vacantly at someone or something with one&apos;s eyes wide open.</rdfs:comment>
        <rdfs:label xml:lang="en">Staring</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/StartTime -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/StartTime">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Time"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:398201009</ncit4:crossReference>
        <umls5:cui xml:lang="en">C1301880</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the time at which something is to start or did start.</rdfs:comment>
        <rdfs:label xml:lang="en">Start Time</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/StimulantAddiction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/StimulantAddiction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Addiction"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:442406005</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Stimulant Dependence</ncit4:synonym>
        <umls5:cui xml:lang="en">C2711618</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the addiction to stimulants which are a class of drugs, such as caffeine, amphetamines, and cocaine.</rdfs:comment>
        <rdfs:label xml:lang="en">Stimulant Addiction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/StructureOfCare -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/StructureOfCare">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FactorAffectingImplementationOfNonpharmacologicalInterventionToPsychoticSymptom"/>
        <rdfs:comment xml:lang="en">It refers to the structure including all of the factors that affect the context in which care is delivered.</rdfs:comment>
        <rdfs:label xml:lang="en">Structure of Care</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Suicide -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Suicide">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HarmToSelf"/>
        <ncit4:crossReference xml:lang="en">MESH:D013405
SNOMEDCT:44301001</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0038661</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the action of killing oneself intentionally.</rdfs:comment>
        <rdfs:label xml:lang="en">Suicide</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Sunbathing -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Sunbathing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RecreationalActivity"/>
        <ncit4:crossReference xml:lang="en">MESH:D055108</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Sun Bathing</ncit4:synonym>
        <umls5:cui xml:lang="en">C0038813</umls5:cui>
        <rdfs:label xml:lang="en">Sunbathing</rdfs:label>
        <skos:definition xml:lang="en">&quot;Exposing oneself to sunlight or ultraviolet rays.&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Sundowning -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Sundowning">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EnvironmentalCausativeFactor"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:609585002</ncit4:crossReference>
        <umls5:cui xml:lang="en">C1142436</umls5:cui>
        <rdfs:comment xml:lang="en">Confusion and behavioural disturbances appear or grow worse in the late afternoon, early evening or at night - the period of sun going down - due to the damaged internal clock in the brain that sense day and night.</rdfs:comment>
        <rdfs:label xml:lang="en">Sundowning</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SupportHealthCareProfessionalInRosterChange -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SupportHealthCareProfessionalInRosterChange">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SupportToHealthCareProfessional"/>
        <rdfs:comment xml:lang="en">It refers to the support to health care professionals in changing their rosters.</rdfs:comment>
        <rdfs:label xml:lang="en">Support to Health Care Professional in Roster Change</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SupportToFamilyMember -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SupportToFamilyMember">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyMemberFocusedIntervention"/>
        <ncit4:synonym xml:lang="en">Provide Privacy and Support for Family Member</ncit4:synonym>
        <umls5:cui xml:lang="en">C0515044</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the intervention of providing resources, information and services to family members of a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Support to Family Member</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SupportToHealthCareProfessional -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SupportToHealthCareProfessional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessionalFocusedIntervention"/>
        <rdfs:comment xml:lang="en">It refers to the support to health care professionals of people living with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Support to Health Care Professional</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SupportiveTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SupportiveTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Psychotherapy"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:243114000</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Supportive Psychotherapy, Supportive Care</ncit4:synonym>
        <umls5:cui xml:lang="en">C0344211</umls5:cui>
        <rdfs:comment xml:lang="en">Supportive therapy is a form of psychotherapy that relies on the therapeutic alliance to alleviate symptoms, improve self-esteem, restore relation to reality, regulate impulses and negative thinking, and reinforce the ability to cope with life stressors and challenges.</rdfs:comment>
        <rdfs:label xml:lang="en">Supportive Therapy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/TactileHallucination -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/TactileHallucination">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Hallucination"/>
        <ncit4:crossReference xml:lang="en">MESH:D006212
SNOMEDCT:66609003</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Hallucination of Tactile Sensation</ncit4:synonym>
        <umls5:cui xml:lang="en">C0233767</umls5:cui>
        <rdfs:label xml:lang="en">Tactile Hallucination</rdfs:label>
        <skos:definition xml:lang="en">It refers to the hallucinations involving the perception of being touched (e.g., feeling like bugs are crawling on the skin, pins being stuck into one&apos;s finger) that are not restricted to the period of awakening or the onset of sleep.&quot; (ICD-11)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/TakingVitalSign -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/TakingVitalSign">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ComprehensiveInitialAssessment"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:61746007</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Observation of Vital Sign, Vital Signs Assessment</ncit4:synonym>
        <umls5:cui xml:lang="en">C0150404</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the actions performed to assess a person&apos;s vital signs, including temperature, pulse, respirations, and blood pressure.</rdfs:comment>
        <rdfs:label xml:lang="en">Taking Vital Sign</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Tearing -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Tearing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyAggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">It refers to the behaviour of pulling something apart or to pieces with force, such as tearing books.</rdfs:comment>
        <rdfs:label xml:lang="en">Tearing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/TelevisionStimulation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/TelevisionStimulation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EnvironmentalCausativeFactor"/>
        <rdfs:comment xml:lang="en">It refers to the concept that figures on television are thought to exist in the real environment.</rdfs:comment>
        <rdfs:label xml:lang="en">Television Stimulation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Threat -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Threat">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VerballyAggressiveBehaviour"/>
        <umls5:cui xml:lang="en">C0749385</umls5:cui>
        <rdfs:comment xml:lang="en">A statement of an intention to injury, damage, or other hostile action on someone in retribution for something done or not done.</rdfs:comment>
        <rdfs:label xml:lang="en">Threat</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ThrowingObject -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ThrowingObject">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyAggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">It refers to the behaviour of using hands to lift something and propel it with force through the air.</rdfs:comment>
        <rdfs:label xml:lang="en">Throwing Object</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Time -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Time">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isManagementActionTimeOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomManagementActivity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isPerformanceTimeOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit4:crossReference xml:lang="en">MESH:D013995
SNOMEDCT:410670007</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0040223</umls5:cui>
        <rdfs:label xml:lang="en">Time</rdfs:label>
        <skos:definition xml:lang="en">MESH: &quot;The dimension of the physical universe which, at a given place, orders the sequence of events.&quot;</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/TimeReorientation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/TimeReorientation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ReorientingPatient"/>
        <ncit4:synonym xml:lang="en">Reorientation to Time</ncit4:synonym>
        <rdfs:comment xml:lang="en">It refers to the activity of helping patient figure out the right time.</rdfs:comment>
        <rdfs:label xml:lang="en">Time Reorientation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Tradition -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Tradition">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BackgroundOfPersonWithDementia"/>
        <umls5:cui xml:lang="en">C0683624</umls5:cui>
        <rdfs:label xml:lang="en">Tradition</rdfs:label>
        <skos:definition xml:lang="en">&quot;A belief or behavior that is passed from generation to generation in a family, a culture, or a religion.&quot;(National Cancer Institute)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/TransferOfCareToHospital -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/TransferOfCareToHospital">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomManagementActivity"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:429202003</ncit4:crossReference>
        <umls5:cui xml:lang="en">C1997687</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the health care activity of transfer of care to hospital.</rdfs:comment>
        <rdfs:label xml:lang="en">Transfer of Care to Hospital</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/TurnOffTelevision -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/TurnOffTelevision">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NoiseControl"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/reducesPsychoticSymptomCausedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/TelevisionStimulation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">It refers to the intervention of turning off the television which is causing the psychotic symptoms of a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Turn Off Television</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Uncle -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Uncle">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyMember"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:38048003</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0337577</umls5:cui>
        <rdfs:label xml:lang="en">Uncle</rdfs:label>
        <skos:definition xml:lang="en">&quot;The brother of one&apos;s father or mother; the husband of one&apos;s aunt.&quot; - U.S. National Cancer Institute</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UnfamiliarEnvironment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UnfamiliarEnvironment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EnvironmentalCausativeFactor"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:224799004</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0557741</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the environments that people had not visited or experienced or had knowledge of.</rdfs:comment>
        <rdfs:label xml:lang="en">Unfamiliar Environment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UnfamiliarHealthCareProfessional -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UnfamiliarHealthCareProfessional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EnvironmentalCausativeFactor"/>
        <rdfs:comment xml:lang="en">It refers to the concept that health care professionals may not be known or recognized by people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Unfamiliar Health Care Professional</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UnifiedParkinsonDiseaseRatingScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UnifiedParkinsonDiseaseRatingScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomAssessmentTool"/>
        <ncit4:abbreviation xml:lang="en">UPDRS</ncit4:abbreviation>
        <umls5:cui xml:lang="en">C3639721</umls5:cui>
        <rdfs:label xml:lang="en">Unified Parkinson Disease Rating Scale</rdfs:label>
        <skos:definition xml:lang="en">A standardized rating scale originally developed by S. Fahn, R. Elton, and other members of the UPDRS Development Committee in 1987 which is used to evaluate the status of a patient&apos;s Parkinson&apos;s disease.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UrinaryTractInfection -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UrinaryTractInfection">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Infection"/>
        <ncit4:abbreviation xml:lang="en">UTI</ncit4:abbreviation>
        <ncit4:crossReference xml:lang="en">MESH:D014552
SNOMEDCT:68566005</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Urinary Infection, Urinary Tract Infectious Disease</ncit4:synonym>
        <umls5:cui xml:lang="en">C0042029</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to an infection in any part of the urinary system - kidneys, ureters, bladder and urethra.</rdfs:comment>
        <rdfs:label xml:lang="en">Urinary Tract Infection</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingAbusiveLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingAbusiveLanguage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VerballyAggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">It refers to the behaviour of using extremely offensive and insulting language.</rdfs:comment>
        <rdfs:label xml:lang="en">Using Abusive Language</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingAccusatoryLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingAccusatoryLanguage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VerballyAggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">It refers to the behaviour of using the language which indicating or suggesting that one believes a person has done something wrong.</rdfs:comment>
        <rdfs:label xml:lang="en">Using Accusatory Language</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingAppropriateLighting -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingAppropriateLighting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicalEnvironmentalIntervention"/>
        <rdfs:comment xml:lang="en">It refers to the intervention of using appropriate lighting in the living environment of a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Using Appropriate Lighting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingContrastingColouredMaterial -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingContrastingColouredMaterial">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicalEnvironmentalIntervention"/>
        <rdfs:comment xml:lang="en">It refers to the intervention of using highly contrasting coloured material, such as using signage in black and yellow.</rdfs:comment>
        <rdfs:label xml:lang="en">Using Contrasting Coloured Material</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingHostileLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingHostileLanguage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VerballyAggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">It refers to the behaviour of using unfriendly language.</rdfs:comment>
        <rdfs:label xml:lang="en">Using Hostile Language</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingImprovedLighting -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingImprovedLighting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingAppropriateLighting"/>
        <rdfs:comment xml:lang="en">It refers to the intervention of using improved lighting.</rdfs:comment>
        <rdfs:label xml:lang="en">Using Improved Lighting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingLargerTypeface -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingLargerTypeface">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicalEnvironmentalIntervention"/>
        <rdfs:comment xml:lang="en">It refers to a particular design of type which is clear and has large sized type, and is good for dementia friendly print</rdfs:comment>
        <rdfs:label xml:lang="en">Using Larger Typeface</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingNightLight -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingNightLight">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingAppropriateLighting"/>
        <rdfs:comment xml:lang="en">It refers to the intervention of using a night light during the night.</rdfs:comment>
        <rdfs:label xml:lang="en">Using Night Light</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingObjectFromHome -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingObjectFromHome">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CreatingHomeFamiliarityInEnvironment"/>
        <rdfs:comment xml:lang="en">It refers to using objects from home to decorate the living environment of a person with dementia, such as personal memorabilia and furnitures.</rdfs:comment>
        <rdfs:label xml:lang="en">Using Object From Home</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingObsceneLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingObsceneLanguage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VerballyAggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">It refers to the behaviour of using offensive and disgusting language.</rdfs:comment>
        <rdfs:label xml:lang="en">Using Obscene Language</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingPictureFromHome -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingPictureFromHome">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CreatingHomeFamiliarityInEnvironment"/>
        <rdfs:comment xml:lang="en">It refers to using pictures or paintings or photos to decorate the living environment of a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Using Picture From Home</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingProfaneLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingProfaneLanguage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VerballyAggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">It refers to the behaviour of using disrespect language.</rdfs:comment>
        <rdfs:label xml:lang="en">Using Profane Language</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingWeightedBlanket -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsingWeightedBlanket">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicalEnvironmentalIntervention"/>
        <rdfs:comment xml:lang="en">It refers to the intervention of using a weighted blanket. Weighted blankets are blankets designed with inserted objects that locally increase the weight to stimulate the sensory system that are intended to improve sleep and to help calm anxiety and stress.</rdfs:comment>
        <rdfs:label xml:lang="en">Using Weighted Blanket</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsinglargerObject -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UsinglargerObject">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicalEnvironmentalIntervention"/>
        <rdfs:comment xml:lang="en">It refers to the intervention of  using larger objects.</rdfs:comment>
        <rdfs:label xml:lang="en">Using Larger Object</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UtilizationOfAuthorityFigure -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/UtilizationOfAuthorityFigure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IndividualTherapyForPsychoticSymptom"/>
        <rdfs:comment xml:lang="en">It refers to the intervention of utilizing a power figure to strengthen a calming message.</rdfs:comment>
        <rdfs:label xml:lang="en">Utilization of Authority Figure</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VerballyAggressiveBehaviour -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VerballyAggressiveBehaviour">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DisruptiveVocalisation"/>
        <ncit4:synonym xml:lang="en">Verbally Aggressive Behavior</ncit4:synonym>
        <rdfs:comment xml:lang="en">It refers to the verbal and vocal agitated behaviours.</rdfs:comment>
        <rdfs:label xml:lang="en">Verbally Aggressive Behaviour</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VerballyNonaggressiveBehaviour -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VerballyNonaggressiveBehaviour">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DisruptiveVocalisation"/>
        <ncit4:synonym xml:lang="en">Verbally Nonaggressive Behavior</ncit4:synonym>
        <rdfs:comment xml:lang="en">It refers to the verbal and vocal behaviours that are not aggressive.</rdfs:comment>
        <rdfs:label xml:lang="en">Verbally Nonaggressive Behaviour</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ViewingFamilyVideotape -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ViewingFamilyVideotape">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SimulatedPresenceTherapy"/>
        <rdfs:comment xml:lang="en">It refers to the treatment that involves playing a personalized video recording of family members to the person with dementia.</rdfs:comment>
        <rdfs:label>Viewing Family Videotape</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Vision -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Vision">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SensoryAbility"/>
        <ncit4:crossReference xml:lang="en">MESH:D014785
SNOMEDCT:281004000</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Visual Function, Sight, Seeing Function, Sense of Sight, Sensory Visual Perception</ncit4:synonym>
        <umls5:cui xml:lang="en">C0042789</umls5:cui>
        <rdfs:label xml:lang="en">Vision</rdfs:label>
        <skos:definition xml:lang="en">It refers to the perception of objects by the eye. (National Cancer Institute)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VisitorPreference -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VisitorPreference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Preferenece"/>
        <rdfs:comment xml:lang="en">It refers to the preference to visitors.</rdfs:comment>
        <rdfs:label xml:lang="en">Visitor Preference</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VisualHallucination -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VisualHallucination">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Hallucination"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isCausedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Institutionalization"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit4:crossReference xml:lang="en">MESH:D006212
SNOMEDCT:64269007</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0233763</umls5:cui>
        <rdfs:label xml:lang="en">Visual Hallucination</rdfs:label>
        <skos:definition xml:lang="en">It refers to the &quot;optical perception of an object, person or event in the absence of a corresponding stimulus.&quot; (National Cancer Institute)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VisualImpairment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VisualImpairment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SensoryImpairment"/>
        <ncit4:crossReference xml:lang="en">MESH:D015354
SNOMEDCT:246635007</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Vision Impairment, Poor Vision, Low Vision, Dim Vision, Dimming Vision, Loss of Vision, Loss of Eyesight, Decreased Vision, Diminished Vision, Reduced Vision, Subnormal Vision, Eyesight Issue</ncit4:synonym>
        <umls5:cui xml:lang="en">C0042798</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the damaged ability to see clearly with eyes. Poor vision of a person with dementia can cause hallucination.</rdfs:comment>
        <rdfs:label xml:lang="en">Visual Impairment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VisuospatialFunctionDeficit -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VisuospatialFunctionDeficit">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CognitiveImpairment"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:142281000119109</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Cognitive Deficit in Visuospatial Function</ncit4:synonym>
        <umls5:cui xml:lang="en">C4543355</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the cognitive deficit in visuospatial function. It typically involves deficits in distinguishing line orientation or curved and straight lines or the inability to separate figure and ground overlapping elements in a scene.</rdfs:comment>
        <rdfs:label xml:lang="en">Visuospatial Function Deficit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Walking -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Walking">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Exercise"/>
        <ncit4:crossReference xml:lang="en">MESH:D016138
SNOMEDCT:129006008</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Walk</ncit4:synonym>
        <umls5:cui xml:lang="en">C0080331</umls5:cui>
        <rdfs:label xml:lang="en">Walking</rdfs:label>
        <skos:definition xml:lang="en">&quot;An activity in which the body advances at a slow to moderate pace by moving the feet in a coordinated fashion.&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Wandering -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Wandering">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyNonaggressiveBehaviour"/>
        <ncit4:crossReference xml:lang="en">MESH:D055816</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Wandering Behaviour, Wandering in Dementia</ncit4:synonym>
        <umls5:cui xml:lang="en">C0871597</umls5:cui>
        <rdfs:label xml:lang="en">Wandering</rdfs:label>
        <skos:definition xml:lang="en">&quot;Moving oneself through space while confused or otherwise cognitively impaired.&quot;- MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/WatchingMovie -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/WatchingMovie">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RecreationalActivity"/>
        <rdfs:comment xml:lang="en">It refers to the activity of watching a movie, such as an old action movie.</rdfs:comment>
        <rdfs:label xml:lang="en">Watching Movie</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/WatchingSportShowHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/WatchingSportShowHobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Hobby"/>
        <rdfs:comment xml:lang="en">It refers to the hobby of watching sports show, such as watching tennis show, and football show.</rdfs:comment>
        <rdfs:label xml:lang="en">Watching Sport Show Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/WatchingTV -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/WatchingTV">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RecreationalActivity"/>
        <umls5:cui xml:lang="en">C3827501</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the activity of watching TV.</rdfs:comment>
        <rdfs:label xml:lang="en">Watching TV</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/WeightLoss -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/WeightLoss">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HarmToSelf"/>
        <ncit4:crossReference xml:lang="en">MESH:D015431
SNOMEDCT:262285001</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Weight Decreased, Lose Weight, Losing Weight, Decreased Weight</ncit4:synonym>
        <umls5:cui xml:lang="en">C1262477</umls5:cui>
        <rdfs:label xml:lang="en">Weight Loss</rdfs:label>
        <skos:definition xml:lang="en">&quot;Decrease in existing body weight.&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Wife -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Wife">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyMember"/>
        <ncit4:crossReference xml:lang="en">MESH:D018454
SNOMEDCT:127850001</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0242665</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the female partner in marriage.</rdfs:comment>
        <rdfs:label xml:lang="en">Wife</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/WindowReflection -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/WindowReflection">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EnvironmentalCausativeFactor"/>
        <rdfs:comment xml:lang="en">It refers to the concept that a reflection in a window may lead a person with dementia to believe that someone is in the same room.</rdfs:comment>
        <rdfs:label xml:lang="en">Window Reflection</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Yoga -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Yoga">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Exercise"/>
        <ncit4:synonym xml:lang="en">Yoga Activity</ncit4:synonym>
        <umls5:cui xml:lang="en">C2979879</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the yoga as a recreational activity.</rdfs:comment>
        <rdfs:label xml:lang="en">Yoga</rdfs:label>
    </owl:Class>
    


