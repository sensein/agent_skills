    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Fatigue -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Fatigue">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IntrapersonalCausativeFactor"/>
        <ncit4:crossReference xml:lang="en">MESH: D005221
SNOMEDCT: 84229001</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Lassitude, Decreased Energy, Energy Loss, Lack of Energy, Tired, Tired All the Time, Tired Time, Tiredness, Tired Out, Weariness</ncit4:synonym>
        <umls5:cui xml:lang="en">C0015672</umls5:cui>
        <rdfs:label xml:lang="en">Fatigue</rdfs:label>
        <skos:definition xml:lang="en">&quot;The state of weariness following a period of exertion, mental or physical, characterized by a decreased capacity for work and reduced efficiency to respond to stimuli.&quot; (MESH)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FeatureOfPsychoticSymptom -->

