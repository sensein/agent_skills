    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/affects -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/affects">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isAffectedBy"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FactorAffectingImplementationOfNonpharmacologicalInterventionToPsychoticSymptom"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NonpharmacologicalIntervention"/>
        <rdfs:comment xml:lang="en">It refers to the relationship - factor affecting implementation of nonpharmacological intervention to psychotic symptoms &apos;affects&apos; nonpharmacological intervention</rdfs:comment>
        <rdfs:label xml:lang="en">affects</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/assesses -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/assesses">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isAssessedBy"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomAssessmentTool"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomInDementia"/>
        <rdfs:comment xml:lang="en">It refers to the relation ship - psychotic symptom assessment tool  &apos;assesses psychotic symptom&apos; psychotic symptom in dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">assesses</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/caresFor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/caresFor">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isCaredBy"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonWithDementia"/>
        <rdfs:comment xml:lang="en">It refers to the relationship - health care professional &apos;cares for&apos; person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">cares for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/causes -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/causes">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isCausedBy"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomCausativeFactor"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomInDementia"/>
        <rdfs:comment xml:lang="en">It refers to the relationship - causative factors &apos;causes&apos; psychotic symptoms in dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">causes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/conducts -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/conducts">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isConductedBy"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomManagementActivity"/>
        <rdfs:comment xml:lang="en">It refers to the relationship - health care professional &apos;conducts&apos; psychotic symptom management activity.</rdfs:comment>
        <rdfs:label xml:lang="en">conducts</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasBackground -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasBackground">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isBackgroundOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonWithDementia"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BackgroundOfPersonWithDementia"/>
        <rdfs:comment xml:lang="en">It refers to the relationship - person with dementia &apos;has background&apos; background of person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">has background</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasCareGoal -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasCareGoal">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isCareGoalOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CareGoal"/>
        <rdfs:comment xml:lang="en">It refers to the relationship that Health Care Professional &quot;has Care Goal&quot; Care Goal.</rdfs:comment>
        <rdfs:label xml:lang="en">has care goal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasCommunicationSkill -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasCommunicationSkill">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isCommunicationSkillOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CommunicationSkill"/>
        <rdfs:comment xml:lang="en">It refers to the relationship - health care professional &apos;has communication technique&apos; communication technique.</rdfs:comment>
        <rdfs:label xml:lang="en">has communication skill</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasContext -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasContext">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasFeature"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isContextOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomInDementia"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ContextOfPsychoticSymptom"/>
        <rdfs:comment xml:lang="en">It refers to the relationship - psychotic symptom &apos;has context&apos; context of psychotic symptom.</rdfs:comment>
        <rdfs:label xml:lang="en">has context</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasDelusion -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasDelusion">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasPsychoticSymptom"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isDelusionOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonWithDementia"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Delusion"/>
        <rdfs:comment xml:lang="en">It refers to the relationship - person with dementia &apos;has delusion&apos; delusion.</rdfs:comment>
        <rdfs:label xml:lang="en">has delusion</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasDementia -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasDementia">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isDementiaOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonWithDementia"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Dementia"/>
        <rdfs:comment xml:lang="en">It refers to the relationship - person with dementia &apos;has dementia&apos; dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">has dementia</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasDuration -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasDuration">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasFeature"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isDurationOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomInDementia"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DurationOfPsychoticSymptom"/>
        <rdfs:comment xml:lang="en">It refers to the relationship - psychotic symptom &apos;has duration&apos; duration of psychotic symptom.</rdfs:comment>
        <rdfs:label xml:lang="en">has duration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasEffect -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasEffect">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isEffectOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomInDementia"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EffectOfPsychoticSymptom"/>
        <rdfs:comment xml:lang="en">It refers to the relationship - psychotic symptom &apos;has effect&apos; effect of psychotic symptom.</rdfs:comment>
        <rdfs:label xml:lang="en">has effect</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasFamilyMember -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasFamilyMember">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isFamilyMemberOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonWithDementia"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyMember"/>
        <rdfs:comment xml:lang="en">It refers to the relationship - person with dementia &apos;has family member&apos; family member of person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">has family member</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasFeature -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasFeature">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isFeatureOf"/>
