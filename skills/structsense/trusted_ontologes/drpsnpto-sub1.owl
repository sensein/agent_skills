        <ncit4:crossReference xml:lang="en">MESH:D060825
SNOMEDCT:386806002</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Cognitive Decline, Cognitive Deficit, Cognitive Dysfunction, Impaired Cognition, Cognitive Function Abnormal</ncit4:synonym>
        <umls5:cui xml:lang="en">C0338656</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the damaged cognitive ability.</rdfs:comment>
        <rdfs:label xml:lang="en">Cognitive Impairment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CollectingThemedItemHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CollectingThemedItemHobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Hobby"/>
        <rdfs:comment xml:lang="en">It refers to the hobby of collecting themed items and objects.</rdfs:comment>
        <rdfs:label xml:lang="en">Collecting Themed Item Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ColumbiaUnveristyScaleForPsychopathologyInAlzheimersDisease -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ColumbiaUnveristyScaleForPsychopathologyInAlzheimersDisease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomAssessmentTool"/>
        <ncit4:abbreviation xml:lang="en">CUSPAD</ncit4:abbreviation>
        <rdfs:comment xml:lang="en">It is a short semi-structured instrument for psychotic features of Alzheimer&apos;s Disease, which that can be administered by a trained lay interviewer. It was developed by Devanand et al in 1992.</rdfs:comment>
        <rdfs:label xml:lang="en">Columbia University Scale for Psychopathology in Alzheimer&apos;s Disease</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CommunicatingActionAvoided -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CommunicatingActionAvoided">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CommunicationSkill"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CommunicatingActionSuggested"/>
        <rdfs:comment xml:lang="en">It refers to the communicating actions that should be avoided.</rdfs:comment>
        <rdfs:label xml:lang="en">Communicating Action Avoided</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CommunicatingActionSuggested -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CommunicatingActionSuggested">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CommunicationSkill"/>
        <rdfs:comment xml:lang="en">It refers to the communicating actions that are suggested to do during a communication.</rdfs:comment>
        <rdfs:label xml:lang="en">Communicating Action Suggested</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CommunicationSkill -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CommunicationSkill">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isCommunicationSkillOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:401049002</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Communication Technique</ncit4:synonym>
        <umls5:cui xml:lang="en">C0870313</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the technique for communicating with person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Communication Skill</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Comorbidity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Comorbidity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IntrapersonalCausativeFactor"/>
        <ncit4:crossReference xml:lang="en">MESH:D015897</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Co-morbidity</ncit4:synonym>
        <umls5:cui xml:lang="en">C0009488</umls5:cui>
        <rdfs:label xml:lang="en">Comorbidity</rdfs:label>
        <skos:definition xml:lang="en">&quot;The presence of co-existing or additional diseases with reference to an initial diagnosis or with reference to the index condition that is the subject of study. Comorbidity may affect the ability of affected individuals to function and also their survival; it may be used as a prognostic indicator for length of hospital stay, cost factors, and outcome or survival.&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CompassionOfHealthCareProfessional -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CompassionOfHealthCareProfessional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FactorAffectingImplementationOfNonpharmacologicalInterventionToPsychoticSymptom"/>
        <ncit4:synonym xml:lang="en">Compassion Shown by Staff</ncit4:synonym>
        <umls5:cui xml:lang="en">C1822096</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the health care professionals&apos; sympathetic pity and concern for the suffering of people with dementia. Compassion of health care professionals allow them to better understand the needs of people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Compassion of Health Care Professional</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Complaining -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Complaining">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VerballyAggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The expression of dissatisfaction or annoyance about something.</rdfs:comment>
        <rdfs:label xml:lang="en">Complaining</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ComplianceWithRequestBasedOnPsychoticSymptom -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ComplianceWithRequestBasedOnPsychoticSymptom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneralNursingCareIntervention"/>
        <rdfs:comment xml:lang="en">It refers to the intervention that health care professionals act complying with the request which is based on the psychotic symptoms in dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Compliance with Request Based on Psychotic Symptom</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ComprehensiveInitialAssessment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ComprehensiveInitialAssessment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomManagementActivity"/>
        <ncit4:synonym xml:lang="en">Initial Assessment</ncit4:synonym>
        <rdfs:comment xml:lang="en">It refers to the activity that the health care professionals perform a comprehensive assessment to establish antecedents and consequences of the patient&apos;s behaviours, noting his/her present interactions with others as well as his/her family and social history.</rdfs:comment>
        <rdfs:label xml:lang="en">Comprehensive Initial Assessment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ConcernOfFamilyMember -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ConcernOfFamilyMember">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EffectOfPsychoticSymptom"/>
        <rdfs:comment xml:lang="en">It refers to the concept that psychotic symptoms in a person with dementia may cause the worry of his/her family members about him/her.</rdfs:comment>
        <rdfs:label xml:lang="en">Concern of Family Member</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ConcernOfFriend -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ConcernOfFriend">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EffectOfPsychoticSymptom"/>
        <rdfs:comment xml:lang="en">It refers to the concept that psychotic symptoms in a person with dementia may cause the concern of his/her friends about him/her.</rdfs:comment>
        <rdfs:label xml:lang="en">Concern of Friend</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Confusion -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Confusion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HarmToSelf"/>
        <ncit4:crossReference xml:lang="en">MESH:D003221
SNOMEDCT:286933003</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Feeling Confused, Confusional State, Confused, Daze, Dazed, Dazing, Disorientation Confusion, Easily Confused</ncit4:synonym>
        <umls5:cui xml:lang="en">C0009676</umls5:cui>
        <rdfs:label xml:lang="en">Confusion</rdfs:label>
        <skos:definition xml:lang="en">&quot;A mental state characterized by bewilderment, emotional disturbance, lack of clear thinking, and perceptual disorientation.&quot; (from MeSH 2020)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ConstantManipulationOfObject -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ConstantManipulationOfObject">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyNonaggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">It refers to the behaviour of manipulating something constantly.</rdfs:comment>
        <rdfs:label xml:lang="en">Constant Manipulation of Object</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ConstantRepetitionOfWord -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ConstantRepetitionOfWord">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VerballyNonaggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">It refers to the behaviour of continuously repeating words or sentences.</rdfs:comment>
        <rdfs:label xml:lang="en">Constant Repetition of Word</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ConstantUnwarrantedRequestsForAttention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ConstantUnwarrantedRequestsForAttention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VerballyNonaggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">It refers to the constant and not justified requests for attention.</rdfs:comment>
        <rdfs:label xml:lang="en">Constant Unwarranted Requests for Attention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ConstantUnwarrantedRequestsForHelp -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ConstantUnwarrantedRequestsForHelp">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VerballyNonaggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">It refers to the constant and not justified requests for help.</rdfs:comment>
        <rdfs:label xml:lang="en">Constant Unwarranted Requests for Help</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ConstantUnwarrantedRequestsForReassurance -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ConstantUnwarrantedRequestsForReassurance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VerballyNonaggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">It refers to the constant and not justified requests for reassurance.</rdfs:comment>
        <rdfs:label xml:lang="en">Constant Unwarranted Requests for Reassurance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Constipation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Constipation">
