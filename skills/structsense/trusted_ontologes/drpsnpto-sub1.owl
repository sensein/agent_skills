        <umls5:cui xml:lang="en">C0085633</umls5:cui>
        <rdfs:label xml:lang="en">Mood Swing</rdfs:label>
        <skos:definition xml:lang="en">&quot;Tendency to dispaly unpredictable and rapidly changing emotions or moods.&quot; - PsycINFO Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Morning -->

