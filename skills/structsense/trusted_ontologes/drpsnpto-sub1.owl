    <owl:Ontology rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO">
        <terms:creator xml:lang="en">Zhenyu Zhang</terms:creator>
        <terms:date xml:lang="en">28/02/2021</terms:date>
        <terms:license xml:lang="en">This ontology is licensed under CC BY-NC-SA International 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/</terms:license>
        <terms:title xml:lang="en">Dementia-Related Psychotic Symptoms Non-Pharmacological Treatment Ontology (DRPSNPTO)</terms:title>
        <rdfs:comment xml:lang="en">The DRPSNPTO ontology represents the domain knowledge specific to non-pharmacological treatment of psychotic symptoms in dementia in the long-term care setting.</rdfs:comment>
        <owl:versionInfo xml:lang="en">v1.0</owl:versionInfo>
    </owl:Ontology>
    


