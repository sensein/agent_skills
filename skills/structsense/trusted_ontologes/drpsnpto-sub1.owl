        <ncit4:crossReference xml:lang="en">MESH:D005518</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0016483</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the preference to one food over another.</rdfs:comment>
        <rdfs:label xml:lang="en">Food Preference</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FrequencyOfPsychoticSymptom -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FrequencyOfPsychoticSymptom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FeatureOfPsychoticSymptom"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isFrequencyOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">It refers to the rate at which a psychotic symptom occurs over a particular period of time.</rdfs:comment>
        <rdfs:label xml:lang="en">Frequency of Psychotic Symptom</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Friend -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Friend">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isFriendOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonWithDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit4:crossReference xml:lang="en">MESH:D033062
SNOMEDCT:113163005</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0079382</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the friends of person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Friend</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FriendVisit -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FriendVisit">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RealHumanContactIntervention"/>
        <rdfs:comment xml:lang="en">It refers to the treatment that involves having friends of the person with dementia to visit him/her in the long-term care facility.</rdfs:comment>
        <rdfs:label xml:lang="en">Friend Visit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FrontotemporalDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FrontotemporalDementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Dementia"/>
        <ncit4:abbreviation xml:lang="en">FTD</ncit4:abbreviation>
        <ncit4:crossReference xml:lang="en">MESH:D057180
SNOMEDCT:230270009</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0338451</umls5:cui>
        <rdfs:label xml:lang="en">Frontotemporal Dementia</rdfs:label>
        <skos:definition xml:lang="en">&quot;Frontotemporal dementia (FTD) is a group of primary neurodegenerative disorders primarily affecting the frontal and temporal lobes. Onset is typically insidious with a gradual and worsening course. Several syndromic variants (some with an identified genetic basis or familiarity) are described that include presentations with predominantly marked personality and behavioural changes (such as executive dysfunction, apathy, deterioration of social cognition, repetitive behaviours, and dietary changes) or with predominantly language deficits (that include semantic, agrammatic/nonfluent, and logopenic forms), or with a combination of these deficits. Memory function, psychomotor speed, as well as visuoperceptual and visuospatial abilities often remain relatively intact, particularly during the early stages of the disorder.&quot; From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Frustration -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Frustration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EmotionalDistress"/>
        <ncit4:crossReference xml:lang="en">MESH:D005639
SNOMEDCT:224973000</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Feeling Frustrated</ncit4:synonym>
        <umls5:cui xml:lang="en">C0016770</umls5:cui>
        <rdfs:label xml:lang="en">Frustration</rdfs:label>
        <skos:definition xml:lang="en">&quot;The motivational and/or affective state resulting from being blocked, thwarted, disappointed or defeated.&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GamblingAddiction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GamblingAddiction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Addiction"/>
        <ncit4:crossReference xml:lang="en">MESH:D005715
SNOMEDCT:18085000</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Pathological Gambling, Compulsive Gambling</ncit4:synonym>
        <umls5:cui xml:lang="en">C0030662</umls5:cui>
        <rdfs:label xml:lang="en">Gambling Addiction</rdfs:label>
        <skos:definition xml:lang="en">&quot;A disorder characterized by a preoccupation with gambling and the excitement that gambling with increasing risk provides. Pathological gamblers are unable to cut back on their gambling, despite the fact that it may lead them to lie, steal, or lose a significant relationship, job, or educational opportunity. &quot;(National Cancer Institute)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Gardening -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Gardening">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RecreationalActivity"/>
        <ncit4:crossReference xml:lang="en">MESH:D051639</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0868963</umls5:cui>
        <rdfs:label xml:lang="en">Gardening</rdfs:label>
        <skos:definition xml:lang="en">&quot;Cultivation of plants (fruit, vegetables, medical herbs) on small plots of ground or in containers.&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GardeningHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GardeningHobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Hobby"/>
        <rdfs:comment xml:lang="en">It refers to the hobby of gardening.</rdfs:comment>
        <rdfs:label xml:lang="en">Gardening Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GastrointestinalAssessment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GastrointestinalAssessment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ComprehensiveInitialAssessment"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:443466001</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Evaluation of Gastrointestinal Tract</ncit4:synonym>
        <umls5:cui xml:lang="en">C2732712</umls5:cui>
        <rdfs:label xml:lang="en">Gastrointestinal Assessment</rdfs:label>
        <skos:definition xml:lang="en">Gastrointestinal assessment includes inspection, auscultation and light palpation of the abdomen to identify visible abnormalities; bowel sounds and softness/tenderness. (Clinical Guidelines - Nursing)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GenderIdentity -->

