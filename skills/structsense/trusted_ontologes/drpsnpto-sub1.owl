        <umls5:cui xml:lang="en">C5230199</umls5:cui>
        <rdfs:label xml:lang="en">Misidentification Delusion</rdfs:label>
        <skos:definition xml:lang="en">&quot;A delusion that people in one&apos;s enviornment, which may include family members and loved ones, are imposters or actors or are otherwise not who they seem to be.&quot; (ICD-11)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Monitoring -->

