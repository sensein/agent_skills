        <umls5:cui xml:lang="en">C1880174</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the information regarding the means of contacting a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Contact Information</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ContextOfPsychoticSymptom -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ContextOfPsychoticSymptom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FeatureOfPsychoticSymptom"/>
        <rdfs:comment xml:lang="en">It refers to the circumstances that form the setting for psychotic symptoms in dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Context of Psychotic Symptom</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Cooking -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Cooking">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RecreationalActivity"/>
        <ncit4:crossReference xml:lang="en">MESH:D003296</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0335326</umls5:cui>
        <rdfs:label xml:lang="en">Cooking</rdfs:label>
        <skos:definition xml:lang="en">&quot;The art or practice of preparing food. It includes the preparation of special foods for diets in various diseases.&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Coordination -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Coordination">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicalAbility"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:85352007</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Physiologic Coordination</ncit4:synonym>
        <umls5:cui xml:lang="en">C0242414</umls5:cui>
        <rdfs:label xml:lang="en">Coordination</rdfs:label>
        <skos:definition xml:lang="en">It refers to the ability to execute smooth, accurate, controlled motor responses (optimal interaction of muscle function).</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CosmeticAllergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CosmeticAllergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Allergy"/>
        <ncit4:synonym xml:lang="en">Makeup Allergy</ncit4:synonym>
        <umls5:cui xml:lang="en">C1626925</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the allergic reactions to cosmetics.</rdfs:comment>
        <rdfs:label xml:lang="en">Cosmetic Allergy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CountryOfBirth -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CountryOfBirth">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DemographicInformation"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:370159000</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Country of Origin</ncit4:synonym>
        <umls5:cui xml:lang="en">C1300001</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the country which a person was born in.</rdfs:comment>
        <rdfs:label xml:lang="en">Country of Birth</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Cousin -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Cousin">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyMember"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:55538000</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0337580</umls5:cui>
        <rdfs:label xml:lang="en">Cousin</rdfs:label>
        <skos:definition xml:lang="en">&quot;A child of one&apos;s aunt or uncle or their descendents.&quot; - U.S. National Cancer Institute</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CreatingHomeFamiliarityInEnvironment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CreatingHomeFamiliarityInEnvironment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicalEnvironmentalIntervention"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/reducesPsychoticSymptomCausedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Institutionalization"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/treats"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/JealousDelusion"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit4:synonym xml:lang="en">Creating Home Familiarity in Environment, Creating Homelikeness, Simulate Homelike Environment</ncit4:synonym>
        <umls5:cui xml:lang="en">C4710627</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the intervention of creating homelikeness environment for people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Creating Home Familiarity in Environment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CreationOfCareGoal -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CreationOfCareGoal">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CarePlanCreation"/>
        <ncit4:synonym xml:lang="en">Setting Goal of Care, Setting Care Goal</ncit4:synonym>
        <rdfs:comment xml:lang="en">It refers to the activity of setting care goals.</rdfs:comment>
        <rdfs:label xml:lang="en">Creation of Care Goal</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CreationOfIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CreationOfIntervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CarePlanCreation"/>
        <rdfs:comment xml:lang="en">It refers to the activity of creating the intervention.</rdfs:comment>
        <rdfs:label xml:lang="en">Creation of Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Cursing -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Cursing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VerballyAggressiveBehaviour"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:48285002</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Swearing, Using Foul Language</ncit4:synonym>
        <umls5:cui xml:lang="en">C0233730</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the behaviour of using offensive language.</rdfs:comment>
        <rdfs:label xml:lang="en">Cursing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DateOfBirth -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DateOfBirth">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DemographicInformation"/>
        <ncit4:abbreviation xml:lang="en">DOB</ncit4:abbreviation>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:184099003</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Birth Date</ncit4:synonym>
        <umls5:cui xml:lang="en">C0421451</umls5:cui>
        <rdfs:label xml:lang="en">Date of Birth</rdfs:label>
        <skos:definition xml:lang="en">&quot;The calendar date on which a person was born.&quot; (National Cancer Institute)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Daughter -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Daughter">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyMember"/>
        <ncit4:crossReference xml:lang="en">MESH:D009679
SNOMEDCT:66089001</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0011011</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the female child of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Daughter</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DaughterInLaw -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DaughterInLaw">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyMember"/>
        <umls5:cui xml:lang="en">C1553705</umls5:cui>
        <rdfs:label xml:lang="en">Daughter-in-law</rdfs:label>
        <skos:definition xml:lang="en">&quot;The wife of one&apos;s son.&quot; (National Cancer Institute)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Daytime -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Daytime">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Time"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:280017001</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Diurnal</ncit4:synonym>
        <umls5:cui xml:lang="en">C0332169</umls5:cui>
        <rdfs:label xml:lang="en">Daytime</rdfs:label>
        <skos:definition xml:lang="en">&quot;The time between sunrise and sunset while it is light.&quot; - National Cancer Institute</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DaytimeSleepiness -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DaytimeSleepiness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SleepDisturbance"/>
        <umls5:cui xml:lang="en">C0541854</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to inappropriate sleepiness during the day.</rdfs:comment>
        <rdfs:label xml:lang="en">Daytime Sleepiness</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DecreasedAttention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DecreasedAttention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CognitiveImpairment"/>
        <ncit4:synonym xml:lang="en">Attention Deficiency, Poor Concentration</ncit4:synonym>
        <umls5:cui xml:lang="en">C3899405</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the impaired ability to focus on a subject or idea.</rdfs:comment>
        <rdfs:label xml:lang="en">Decreased Attention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Dehydration -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Dehydration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MedicalIllness"/>
        <ncit4:crossReference xml:lang="en">MESH:D003681
SNOMEDCT:34095006</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Deficient Fluid Volume, Body Water Dehydration</ncit4:synonym>
        <umls5:cui xml:lang="en">C0011175</umls5:cui>
        <rdfs:comment xml:lang="en">Dehydration is a condition that can occur when the loss of body fluids, mostly water, exceeds the amount that is taken in.</rdfs:comment>
        <rdfs:label xml:lang="en">Dehydration</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Delirium -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Delirium">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IntrapersonalCausativeFactor"/>
        <ncit4:crossReference xml:lang="en">MESH:D003693
SNOMEDCT:419567006</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0011206</umls5:cui>
        <rdfs:label xml:lang="en">Delirium</rdfs:label>
        <skos:definition xml:lang="en">&quot;Delirium is characterised by disturbed attention (i.e., reduced ability to direct, focus, sustain, and shift attention) and awareness (i.e., reduced orientation to the environment) that develops over a short period of time and tends to fluctuate during the course of a day, accompanied by other cognitive impairment such as memory deficit, disorientation, or impairment in language, visuospatial ability, or perception. Disturbance of the sleep-wake cycle (reduced arousal of acute onset or total sleep loss with reversal of the sleep-wake cycle) may also be present. The symptoms are attributable to a disorder or disease not classified under mental and behavioural disorders or to substance intoxication or withdrawal or to a medication.&quot; From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DeliriumAssessment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DeliriumAssessment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ComprehensiveInitialAssessment"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:733870009</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Delirium Screening, Assessment of Delirium</ncit4:synonym>
        <umls5:cui xml:lang="en">C4518226</umls5:cui>
        <rdfs:label xml:lang="en">Delirium Assessment</rdfs:label>
        <skos:definition xml:lang="en">It refers to the activity that health care professionals assess, treat and/or eliminate sources of delirium that may be impacting on a person&apos;s exacerbation of behavioural and psychological symptoms of dementia. Health care professionals normally look for: 1) bladder symptoms, including changes in urine, incontience, and genital discomfort; 2) changes in bowel habits, including pain, cramps, diarrhoea, and appetite; 3) pain indicators, including a history of conditions, physical appearance, recent surgery, and skin integrity; 4) signs of infection, including localised infection, evidence of pneumonia, and pressure sores, and 5) changes in medication. From Dementia Support Australia</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Delusion -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Delusion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isDelusionOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonWithDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Hallucination"/>
        <ncit4:crossReference xml:lang="en">MESH:D003702
SNOMEDCT:2073000</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Delusional Disorder, Delusional Idea, Delusional Symptom, Delusional Thought, Fixed Beliefs Contradicted by Reality, Delusional Belief, Psychotic Delusion</ncit4:synonym>
        <umls5:cui xml:lang="en">C0011253</umls5:cui>
        <rdfs:label xml:lang="en">Delusion</rdfs:label>
        <skos:definition xml:lang="en">&quot;A belief that is demonstrably untrue or not shared by others, usually based on incorrect inference about external reality. The belief is firmly held with conviction and is not, or is only briefly, susceptibel to modification by experience or evidence that contradicts it. The belief is not ordinarily accepted by other members or the person&apos;s culture or subculture (i.e., it is not an article of religious faith).&quot; (ICD-11)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DelusionOfBeingControlled -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DelusionOfBeingControlled">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Delusion"/>
        <rdfs:label xml:lang="en">Delusion of Being Controlled</rdfs:label>
        <skos:definition xml:lang="en">&quot;A delusion that involves an external force or person controlling one&apos;s feelings, impluses, thoughts, or behaviour.&quot; (ICD-11)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DelusionOfGuilt -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DelusionOfGuilt">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Delusion"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:53108004</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0233684</umls5:cui>
        <rdfs:label xml:lang="en">Delusion of Guilt</rdfs:label>
        <skos:definition xml:lang="en">&quot;A delusion involving exaggerated or inappropriate responsibility, need for punishment or retribution, or disproportionate consequences of one&apos;s actions, such as that a minor error in the past will lead to disaster, that the person has committed a sin or horrible crime and should be punished severely, or that the person is responsible for a horrible outcome with which there can be no possible connection.&quot; (ICD-11)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DelusionOfImpoverishment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DelusionOfImpoverishment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Delusion"/>
        <ncit4:synonym xml:lang="en">Delusion of Poverty</ncit4:synonym>
        <umls5:cui xml:lang="en">C0233678</umls5:cui>
        <rdfs:label xml:lang="en">Delusion of Impoverishment</rdfs:label>
        <skos:definition xml:lang="en">&quot;A delusional conviction that one is currently destitute or soon will be, or that one does not have the necessary financial resources to live on, in spite of evidence to the contrary.&quot; (ICD-11)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DelusionOfReference -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DelusionOfReference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Delusion"/>
        <ncit4:synonym xml:lang="en">Referential Delusion</ncit4:synonym>
        <umls5:cui xml:lang="en">C0233682</umls5:cui>
        <rdfs:label xml:lang="en">Delusion of Reference</rdfs:label>
        <skos:definition xml:lang="en">&quot;A delusion that events, objects, or other people in the person&apos;s immediate environment have a particular and unusual personal significance, usually of a negative or pejorative nature. (ICD-11)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Dementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Dementia">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isDementiaOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonWithDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit4:crossReference xml:lang="en">MESH:D003704
SNOMEDCT:52448006</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0497327</umls5:cui>
        <rdfs:label xml:lang="en">Dementia</rdfs:label>
        <skos:definition xml:lang="en">&quot;Dementia is an acquired brain syndrome characterized by a decline from a previous level of cognitive function with impairment in two or more cognitive domains (such as memory, executive functions, attention, language, social cognition and judgement, psychomotor speed, visuoperceptual or visuospatial abilities). The cognitive impairment is not entirely attributable to normal aging and significantly interferes with independence in the person&apos;s performance of activities of daily living. Based on available evidence, the cognitive impairment is attributed or assumed to be attributable to a neurological or medical condition that affects the brain, trauma, nutritional deficiency, chronic use of specific substances or medications, or exposure to heavy metals or other toxins.&quot; From ICD-11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToAlzheimerDisease -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToAlzheimerDisease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Dementia"/>
        <ncit4:crossReference xml:lang="en">MESH:D000544
SNOMEDCT:26929004</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Alzheimer Disease Dementia</ncit4:synonym>
        <umls5:cui xml:lang="en">C0002395</umls5:cui>
        <rdfs:label xml:lang="en">Dementia due to Alzheimer Disease</rdfs:label>
        <skos:definition xml:lang="en">&quot;Dementia due to Alzheimer disease is the most common form of dementia. Onset is insidious with memory impairment typically reported as the initial presenting complaint. The characteristic course is a slow but steady decline from a previous level of cognitive functioning with impairment in additional cognitive domains (such as executive functions, attention, language, social cognition and judgment, psychomotor speed, visuoperceptual or visuospatial abilities) emerging with disease progressing.&quot; From ICD-11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToAlzheimerDiseaseWithEarlyOnset -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToAlzheimerDiseaseWithEarlyOnset">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToAlzheimerDisease"/>
        <rdfs:label xml:lang="en">Dementia due to Alzheimer Disease with Early Onset</rdfs:label>
        <skos:definition xml:lang="en">&quot;Dementia due to Alzheimer disease in which symptoms emerge before the age of 65 years. It is relatively rare, representing less than 5% of all cases, and may be genetically determined (autosomal dominant Alzheimer disease). Clinical presentation may be similar to cases with later onset, but a significant proportion of cases manifest atypical symptoms, with relatively less severe memory deficits.&quot; From ICD11 version 09/2020.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToAlzheimerDiseaseWithLateOnset -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToAlzheimerDiseaseWithLateOnset">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToAlzheimerDisease"/>
        <rdfs:label xml:lang="en">Dementia due to Alzheimer Disease with Late Onset</rdfs:label>
        <skos:definition xml:lang="en">&quot;Dementia due to Alzheimer disease that develops at the age of 65 years or above. This is the most common pattern, representing more than 95% of all cases.&quot; From ICD11 Version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToCerebrovascularDisease -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToCerebrovascularDisease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Dementia"/>
        <ncit4:abbreviation xml:lang="en">VaD</ncit4:abbreviation>
        <ncit4:crossReference xml:lang="en">MESH:D015140
SNOMEDCT:429998004</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Cerebrovascular Disease Dementia, Vascular Dementia</ncit4:synonym>
        <umls5:cui xml:lang="en">C0011269</umls5:cui>
        <rdfs:label xml:lang="en">Dementia due to Cerebrovascular Disease</rdfs:label>
        <skos:definition xml:lang="en">&quot;Vascular dementia is due to significant brain parenchyma injury resulting from cerebrovascular disease (ischemic or haemorrhagic). The onset of the cognitive deficits is temporally related to one or more vascular events. Cognitive decline is typically most prominent in speed of information processing, complex attention, and frontal-executive functioning. There is evidence of the presence of cerebrovascular disease considered to be sufficient to account for the neurocognitive deficits from history, physical examination and neuroimaging.&quot; From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToDownSyndrome -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToDownSyndrome">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Dementia"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:733194007</ncit4:crossReference>
        <umls5:cui xml:lang="en">C4518638</umls5:cui>
        <rdfs:label xml:lang="en">Dementia due to Down Syndrome</rdfs:label>
        <skos:definition xml:lang="en">&quot;Dementia due to Down syndrome is a neurodegenerative disorder related to the impact of abnormal increased production and accumulation of amyloid precursor protein (APP) leading to formation of beta-amyloid plaques and tau tangles. APP gene expression is increased due to its location on chromosome 21, which is abnormally triplicated in Down syndrome. Cognitive deficits and neuropathological features are similar to those observed in Alzheimer disease. Onset is typically after the fourth decade of life with a gradual decline in functioning.&quot; From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToExposureToHeavyMetal -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToExposureToHeavyMetal">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Dementia"/>
        <rdfs:label xml:lang="en">Dementia due to Exposure to Heavey Metal</rdfs:label>
        <skos:definition xml:lang="en">&quot;Dementia due to exposure to heavy metals caused by toxic exposure to specific heavy metals such as aluminium from dialysis water, lead, mercury or manganese. The characteristic cognitive impairments in Dementia due to exposure to heavy metals depend on the specific heavy metal that the individual has been exposed to but can affect all cognitive domains. Onset of symptoms is related to exposure and progression can be rapid especially with acute exposure. In many cases, symptoms are reversible when exposure is identified and ceases. Investigations such as brain imaging or neurophysiological testing may be abnormal. Lead poisoning is associated with abnormalities on brain imaging including widespread calcification and increased signal on MRI T2-weighted images of periventricular white matter, basal ganglia hypothalamus and pons. Dementia due to aluminium toxicity may demonstrate characteristic paroxysmal high-voltage delta EEG changes. Examination may make evident other features such as peripheral neuropathy in the case of lead, arsenic, or mercury.&quot; From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToHumanImmunodeficiencyVirus -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToHumanImmunodeficiencyVirus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Dementia"/>
        <rdfs:label xml:lang="en">Dementia due to Human Immunodeficiency Virus</rdfs:label>
        <skos:definition xml:lang="en">&quot;Dementia due to human immunodeficiency virus develops during the course of confirmed HIV disease, in the absence of a concurrent illness or condition other than HIV infection that could explain the clinical features. Although a variety of patterns of cognitive deficit are possible depending on where the HIV pathogenic processes have occurred, typically deficits follow a subcortical pattern with impairments in executive function, processing speed, attention, and learning new information. The course of Dementia due to human immunodeficiency virus varies including resolution of symptoms, gradual decline in functioning, improvement, or fluctuation in symptoms. Rapid decline in cognitive functioning is rare with the advent of antiretroviral medications.&quot; From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToHuntingtonDisease -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToHuntingtonDisease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Dementia"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:442344002</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Dementia due to Huntington Chorea</ncit4:synonym>
        <umls5:cui xml:lang="en">C0236961</umls5:cui>
        <rdfs:label xml:lang="en">Dementia due to Huntington Disease</rdfs:label>
        <skos:definition xml:lang="en">&quot;Dementia due to Huntington disease occurs as part of a widespread degeneration of the brain due to a trinucleotide repeat expansion in the HTT gene, which is transmitted through autosomal dominance. Onset of symptoms is insidious typically in the third and fourth decade of life with gradual and slow progression. Initial symptoms typically include impairments in executive functions with relative sparing of memory, prior to the onset of motor deficits (bradykinesia and chorea) characteristic of Huntington disease.&quot; From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToInjuryToTheHead -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToInjuryToTheHead">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Dementia"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:762351006</ncit4:crossReference>
        <umls5:cui xml:lang="en">C4546139</umls5:cui>
        <rdfs:label xml:lang="en">Dementia due to Injury to the Head</rdfs:label>
        <skos:definition xml:lang="en">&quot;Dementia due to injury to the head is caused by damage inflicted on the tissues of the brain as the direct or indirect result of an external force. Trauma to the brain is known to have resulted in loss of consciousness, amnesia, disorientation and confusion, or neurological signs. The symptoms characteristic of Dementia due to injury to the head must arise immediately following the trauma or after the individual gains consciousness and must persist beyond the acute post-injury period. Cognitive deficits vary depending on the specific brain areas affected and the severity of the injury but can include impairments in attention, memory, executive functioning, personality, processing speed, social cognition, and language abilities.&quot; From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToLewyBodyDisease -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToLewyBodyDisease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Dementia"/>
        <ncit4:crossReference xml:lang="en">MESH:D020961
SNOMEDCT:312991009</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Dementia with Lewy Body, Lewy Body Dementia, Lewy Body Disease Dementia</ncit4:synonym>
        <umls5:cui xml:lang="en">C0752347</umls5:cui>
        <rdfs:label xml:lang="en">Dementia due to Lewy Body Disease</rdfs:label>
        <skos:definition xml:lang="en">&quot;Dementia due to Lewy body disease is the second most common form of dementia in the elderly after Alzheimer disease. The precise etiology is unknown but involves abnormal alpha-synuclein protein folding and aggregation with Lewy body formation primarily in the cortex and brainstem. Onset is insidious with attentional and executive functioning deficits typically reported as the initial presenting complaint. These cognitive deficits are often accompanied by visual hallucination and symptoms of REM sleep behaviour disorder. Hallucinations in other sensory modalities, depressive symptoms, and delusions may also be present. The symptom presentation usually varies significantly over the course of days necessitating longitudinal assessment and differentiation from Delirium. Sontaneous onset of Parkinsonism within approximately 1 year of the onset of cognitive symptoms is characteristic of the disease.&quot; From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToMultipleSclerosis -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToMultipleSclerosis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Dementia"/>
        <rdfs:label xml:lang="en">Dementia due to Multiple Sclerosis</rdfs:label>
        <skos:definition xml:lang="en">&quot;Dementia due to multiple sclerosis is a neurodegenerative disease due to the cerebral effects of multiple sclerosis, a demyelinating disease. Onset of symptoms is insidious and not related to the progression or functional impairment attributable to the primary disease (i.e., multiple sclerosis). Cognitive impairments vary according to the location of demyelination but typically include deficits in processing speed, memory, attention, and aspects of executive functioning.&quot; From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToNormalPressureHydrocephalus -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToNormalPressureHydrocephalus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Dementia"/>
        <rdfs:label xml:lang="en">Dementia due to Normal Pressure Hydrocephalus</rdfs:label>
        <skos:definition xml:lang="en">&quot;Dementia due to normal pressure hydrocephalus results from excess accumulation of cerebrospinal fluid in the brain as a result of idiopathic, non-obstructive causes but can also be secondary to haemorrhage, infection or inflammation. Progression is gradual but intervention (e.g., shunt) can result in significant improvement of symptoms. Typically, cognitive impairments include reduced processing speed, deficits in executive functioning and attention, as well as personality changes. These symptoms are also typically accompanied by gait abnormalities and urinary incontinence. Brain imaging to reveal ventricular volume and brain displacement is often necessary to confirm the diagnosis.&quot; From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToParkinsonDisease -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToParkinsonDisease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Dementia"/>
        <ncit4:abbreviation xml:lang="en">PDD</ncit4:abbreviation>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:101421000119107</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Parkinson Disease Dementia</ncit4:synonym>
        <umls5:cui xml:lang="en">C0236960</umls5:cui>
        <rdfs:label xml:lang="en">Dementia due to Parkinson Disease</rdfs:label>
        <skos:definition xml:lang="en">&quot;Dementia due to Parkinson disease develops among individuals with idiopathic Parkinson disease and is characterized by impairment in attention, memory, executive and visuo-spatial functions as well as behavioural and psychiatric symptoms such as changes in affect, apathy and hallucinations. Onset is insidious and the course is one of gradual worsening of symptoms. The primary pathological correlat is Lewy Body-type degeneration predominantly in the basal ganglia rather than in the cortex as is typical of Dementia due to Lewy body disease.&quot; From ICD-11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToPellagra -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToPellagra">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Dementia"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:788899002</ncit4:crossReference>
        <umls5:cui xml:lang="en">C5230201</umls5:cui>
        <rdfs:label xml:lang="en">Dementia due to Pellagra</rdfs:label>
        <skos:definition xml:lang="en">&quot;Dementia due to pellagra is caused by persistent lack of vitamin B3 (niacin) or tryptophan either in the diet or due to poor absorption in the gastrointestinal tract due to disease (e.g., Crohn disease) or due to the effects of some medications (e.g., isoniazid). Core signs of pellagra include dermatological changes (sensitivity to sunlight, lesions, alopecia, and oedema) and diarrhoea. With prolonged nutritional deficiency cognitive symptoms that include aggressivity, motor disturbances (ataxia and restlessness), confusion, and weakness are observed. Treatment with nutritional supplementation (e.g., niacin) typically results in reversal of symptoms.&quot; From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToPrionDisease -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToPrionDisease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Dementia"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:762350007</ncit4:crossReference>
        <umls5:cui xml:lang="en">C4546138</umls5:cui>
        <rdfs:label xml:lang="en">Dementia due to Prion Disease</rdfs:label>
        <skos:definition xml:lang="en">&quot;Dementia due to prion disease is a primary neurodegenerative disease caused by a group of spongiform encephalopathies resulting from abnormal prion protein accumulation in the brain. These can be sporadic, genetic (caused by mutations in the prion-protein gene), or transmissible (acquired from an infected individual). Onset is insidious and there is a rapid progression of symptoms and impairment characterised by cognitive deficits, ataxia, and motor symptoms (myoclonus, chorea, or dystonia). Diagnosis is typically made on the basis of brain imaging studies, presence of characteristic proteins in spinal fluid, EEG, or genetic testing.&quot; From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToPsychoactiveSubstancesIncludingMedication -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToPsychoactiveSubstancesIncludingMedication">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Dementia"/>
        <ncit4:synonym xml:lang="en">Dementia due to Psychoactive Substances including Medications</ncit4:synonym>
        <rdfs:label xml:lang="en">Dementia due to Psychoactive Substances including Medication</rdfs:label>
        <skos:definition xml:lang="en">&quot;Dementia due to psychoactive substances including medications includes forms of dementia that are judged to be a direct consequence of substance use and that persist beyond the usual duration of action or withdrawal syndrome associated with the substance. The amount and duration of substance use must be sufficient to produce the cognitive impairment. The cognitive impairment is not better accounted for by a disorder that is not induced by substances such as a dementia due to another medical condition.&quot; From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToUseOfAlcohol -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToUseOfAlcohol">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToPsychoactiveSubstancesIncludingMedication"/>
        <rdfs:label xml:lang="en">Dementia due to Use of Alcohol</rdfs:label>
        <skos:definition xml:lang="en">&quot;Dementia due to use of alcohol is characterised by the development of persistent cognitive impairments (e.g., memory problems, language impairment, and an inability to perform complex motor tasks) that meet the definitional requirements of Dementia that are judged to be a direct consequence of alcohol use and that persist beyond the usual duration of alcohol intoxication or acute withdrawal. The intensity and duration of alcohol use must have been sufficient to produce the cognitive impairment. The cognitive impairment is not better accounted for by a disorder or disease that is not induced by alcohol such as a dementia due to another disorder or disease classified elsewhere.&quot; From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToUseOfAnxiolytic -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToUseOfAnxiolytic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToPsychoactiveSubstancesIncludingMedication"/>
        <rdfs:label xml:lang="en">Dementia due to Use of Anxiolytic</rdfs:label>
        <skos:definition xml:lang="en">Dementia due to use of anxiolytics is characterised by the development of persistent cognitive impairments (e.g., memory problems, language impairment, and an inability to perform complex motor tasks) that meet the definitional requirements of Dementia that are judged to be a direct consequence of anxiolytic use and that persist beyond the usual duration of action or withdrawal syndrome associated with the substance. The amount and duration of anxiolytic use must be sufficient to produce the cognitive impairment. The cognitive impairment is not better accounted for by a disorder that is not induced by anxiolytics such as a dementia due to another medical condition. (ICD-11 version 09/2020)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToUseOfHypnotic -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToUseOfHypnotic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToPsychoactiveSubstancesIncludingMedication"/>
        <rdfs:label xml:lang="en">Dementia due to Use of Hypnotic</rdfs:label>
        <skos:definition xml:lang="en">Dementia due to use of hypnotics is characterised by the development of persistent cognitive impairments (e.g., memory problems, language impairment, and an inability to perform complex motor tasks) that meet the definitional requirements of Dementia that are judged to be a direct consequence of hypnotic use and that persist beyond the usual duration of action or withdrawal syndrome associated with the substance. The amount and duration of hypnotic use must be sufficient to produce the cognitive impairment. The cognitive impairment is not better accounted for by a disorder that is not induced by hypnotics such as a dementia due to another medical condition. (ICD-11 version 09/2020)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToUseOfSedative -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToUseOfSedative">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToPsychoactiveSubstancesIncludingMedication"/>
        <rdfs:label xml:lang="en">Dementia due to Use of Sedative</rdfs:label>
        <skos:definition xml:lang="en">Dementia due to use of sedatives is characterised by the development of persistent cognitive impairments (e.g., memory problems, language impairment, and an inability to perform complex motor tasks) that meet the definitional requirements of Dementia that are judged to be a direct consequence of sedative use and that persist beyond the usual duration of action or withdrawal syndrome associated with the substance. The amount and duration of sedative use must be sufficient to produce the cognitive impairment. The cognitive impairment is not better accounted for by a disorder that is not induced by sedativessuch as a dementia due to another medical condition. From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToUseOfVolatileInhalants -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToUseOfVolatileInhalants">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DementiaDueToPsychoactiveSubstancesIncludingMedication"/>
        <rdfs:label xml:lang="en">Dementia due to Use of Volatile Inhalants</rdfs:label>
        <skos:definition xml:lang="en">&quot;Dementia due to use of volatile inhalants is characterised by the development of persistent cognitive impairments (e.g., memory problems, language impairment, and an inability to perform complex motor tasks) that meet the definitional requirements of Dementia that are judged to be a direct consequence of inhalant use or exposure and that persist beyond the usual duration of action or withdrawal syndrome associated with the substance. The amount and duration of inhalant use or exposure must be sufficient to be capable of producing the cognitive impairment. The cognitive impairment is not better accounted for by a disorder that is not induced by volatile inhalants such as a dementia due to another medical condition.&quot; From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DemographicInformation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DemographicInformation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BackgroundOfPersonWithDementia"/>
        <ncit4:synonym xml:lang="en">Patient Demographic Information</ncit4:synonym>
        <umls5:cui xml:lang="en">C4318886</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the demographic information of person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Demographic Information</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DepressedMood -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DepressedMood">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MoodDisorder"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:366979004</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Depressed, Feeling Down, Feeling Blue, Miserable, Low Mood</ncit4:synonym>
        <umls5:cui xml:lang="en">C0344315</umls5:cui>
        <rdfs:label xml:lang="en">Depressed Mood</rdfs:label>
        <skos:definition xml:lang="en">&quot;An emotional state characterized by feelings of sadness, emptiness, and/or tearfulness.&quot; - National Cancer Institute</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Depression -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Depression">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychiatricDisorder"/>
        <ncit4:crossReference xml:lang="en">MESH:D003863</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Mental Depression, Monopolar Depression, Melancholic State</ncit4:synonym>
        <umls5:cui xml:lang="en">C0011570</umls5:cui>
        <rdfs:comment xml:lang="en">It is a mental illness. People with depression may feel sad, hopeless, lost, or anger.</rdfs:comment>
        <rdfs:label xml:lang="en">Depression</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DestroyingProperty -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DestroyingProperty">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyAggressiveBehaviour"/>
        <ncit4:synonym xml:lang="en">Destruction, Destroying</ncit4:synonym>
        <umls5:cui xml:lang="en">C1948029</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the behaviour of destroying properties.</rdfs:comment>
        <rdfs:label xml:lang="en">Destroying Property</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DiabetesMellitus -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DiabetesMellitus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ChronicDisease"/>
        <ncit4:abbreviation xml:lang="en">DM</ncit4:abbreviation>
        <ncit4:crossReference xml:lang="en">MESH:D003920
SNOMEDCT:73211009</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Diabetes</ncit4:synonym>
        <umls5:cui xml:lang="en">C0011849</umls5:cui>
        <rdfs:label xml:lang="en">Diabetes Mellitus</rdfs:label>
        <skos:definition xml:lang="en">&quot;A heterogeneous group of disorders characterized by hyperglycemia and glucose intolerance.&quot; (MeSH)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Dietitian -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Dietitian">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
        <ncit4:crossReference xml:lang="en">MESH:D064686
SNOMEDCT:159033005</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Nutritionist</ncit4:synonym>
        <umls5:cui xml:lang="en">C3536818</umls5:cui>
        <rdfs:label xml:lang="en">Dietitian</rdfs:label>
        <skos:definition xml:lang="en">&quot;Persons specially trained and licensed in nutrition sciences and dietetics.&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DinnerTime -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DinnerTime">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Time"/>
        <ncit4:crossReference xml:lang="en">MESH:D062407
SNOMEDCT:307163004</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Dinnertime, Evening Meal, Supper Time</ncit4:synonym>
        <umls5:cui xml:lang="en">C0585040</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the time of people having evening meal.</rdfs:comment>
        <rdfs:label xml:lang="en">Dinner Time</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DisorganizedSpeech -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DisorganizedSpeech">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VerballyNonaggressiveBehaviour"/>
        <umls5:cui xml:lang="en">C1866987</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the behaviour of speaking which arises from abnormal thought processes. A person having disorganized speech might talking with nonexistent entities, or quickly jumping from one unrelated topic to another. From https://www.goodtherapy.org/blog/psychopedia/disorganized-speech</rdfs:comment>
        <rdfs:label xml:lang="en">Disorganized Speech</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Disorientation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Disorientation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CognitiveImpairment"/>
        <ncit4:crossReference xml:lang="en">MESH:D003221
SNOMEDCT:62476001</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0233407</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the altered mental state. A disoriented person may not known their location and identity, or the time and date.</rdfs:comment>
        <rdfs:label xml:lang="en">Disorientation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DisplayingCalendarProminently -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DisplayingCalendarProminently">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicalEnvironmentalIntervention"/>
        <rdfs:comment xml:lang="en">It refers to the environmental intervention of putting a calendar/calendars in a prominent place in order that it may readily be seen.</rdfs:comment>
        <rdfs:label xml:lang="en">Displaying Calender Prominently</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DisplayingClockProminently -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DisplayingClockProminently">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicalEnvironmentalIntervention"/>
        <rdfs:comment xml:lang="en">It refers to the environmental intervention of putting a clock/clocks in a prominent place in order that it may readily be seen.</rdfs:comment>
        <rdfs:label xml:lang="en">Displaying Clock Prominently</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DisruptionToCareRoutine -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DisruptionToCareRoutine">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EffectOfPsychoticSymptom"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DistressOfHealthCareProfessional"/>
        <rdfs:comment xml:lang="en">It refers to the effect that the daily care routine could be disrupted by the performance of psychotic symptoms in people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Disruption to Care Routine</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DisruptiveVocalisation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DisruptiveVocalisation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Agitation"/>
        <ncit4:abbreviation xml:lang="en">DV</ncit4:abbreviation>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:699303006</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Disruptive Vocalization, Vocally Disruptive Behavior, Vocally Disruptive Behaviour</ncit4:synonym>
        <umls5:cui xml:lang="en">C3697171</umls5:cui>
        <rdfs:label xml:lang="en">Disruptive Vocalisation</rdfs:label>
        <skos:definition xml:lang="en">&quot;Making vocal utterances that are distressing sounding and socially inappropriate due to their intensity, frequency, duration and/or setting, as a manifestation of some form of brain disease, usually dementia.&quot; - SNOMEDCT</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DistanceSupervision -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DistanceSupervision">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneralNursingCareIntervention"/>
        <ncit4:synonym xml:lang="en">Distant Supervision</ncit4:synonym>
        <rdfs:comment xml:lang="en">It refers to the intervention of supervising a person at a distance due to the needs of the person or the safety of staff.</rdfs:comment>
        <rdfs:label xml:lang="en">Distance Supervision</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Distraction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Distraction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneralNursingCareIntervention"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:414039005</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Distraction Therapy</ncit4:synonym>
        <umls5:cui xml:lang="en">C1369038</umls5:cui>
        <rdfs:label>Distraction</rdfs:label>
        <skos:definition xml:lang="en">&quot;Purposeful diverting of attention or temporarily suppressing negative emotions and thoughts away from undesirable sensations.&quot; (National Cancer Institute)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DistressOfHealthCareProfessional -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DistressOfHealthCareProfessional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EffectOfPsychoticSymptom"/>
        <rdfs:comment xml:lang="en">The presence of psychotic symptoms contribute to health care professional&apos;s distress.</rdfs:comment>
        <rdfs:label xml:lang="en">Distress of Health Care Professional</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DisturbingOtherPersonLivingInLongTermCareFacility -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DisturbingOtherPersonLivingInLongTermCareFacility">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EffectOfPsychoticSymptom"/>
        <ncit4:synonym xml:lang="en">Distress to Other Resident</ncit4:synonym>
        <rdfs:comment xml:lang="en">It refers to the effect that psychotic symptoms of person with dementia might disturb other person living in the same long-term care facility.</rdfs:comment>
        <rdfs:label xml:lang="en">Disturbing Other Person Living in Long Term Care Facility</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DiversionalTherapist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DiversionalTherapist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
        <ncit4:synonym xml:lang="en">Diversional Therapy Assistant, Lifestyle Officer, Leisure and Lifestyle Officer</ncit4:synonym>
        <rdfs:label xml:lang="en">Diversional Therapist</rdfs:label>
        <skos:definition xml:lang="en">&quot;Diversional therapists provide recreational and leisure services for individuals in healthcare centres and in the community to encourage them to take part in activities, assist in their social development and promote a sense of wellbeing.&quot; - The Good Universities Guide</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DiversionalTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DiversionalTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IndividualTherapyForPsychoticSymptom"/>
        <ncit4:abbreviation xml:lang="en">DT</ncit4:abbreviation>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:46964002</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0204581</umls5:cui>
        <rdfs:label xml:lang="en">Diversional Therapy</rdfs:label>
        <skos:definition xml:lang="en">&quot;Diversional therapy focuses, not just on physical programs to keep the body in shape, but it also focuses on improving the social and emotional wellbeing of participants.&quot; - Skills Training Australia</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DrugAllergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DrugAllergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Allergy"/>
        <ncit4:crossReference xml:lang="en">MESH:D004342
SNOMEDCT:416098002</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Drug Hypersensitivity, Medication Allergy, Medicine Allergy, Allergic Reaction to Drug</ncit4:synonym>
        <umls5:cui xml:lang="en">C0013182</umls5:cui>
        <rdfs:label xml:lang="en">Drug Allergy</rdfs:label>
        <skos:definition xml:lang="en">&quot;An allergy to a pharmaceutical product.&quot; (HL7V3.0)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DurationOfPsychoticSymptom -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DurationOfPsychoticSymptom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FeatureOfPsychoticSymptom"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isDurationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">It refers to the time during which psychotic symptoms continues.</rdfs:comment>
        <rdfs:label xml:lang="en">Duration of Psychotic Symptom</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DustAllergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DustAllergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Allergy"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:390952000</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Allergy to Dust</ncit4:synonym>
        <umls5:cui xml:lang="en">C0740914</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the allergic reaction to dust.</rdfs:comment>
        <rdfs:label xml:lang="en">Dust Allergy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Echolalia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Echolalia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/VerballyNonaggressiveBehaviour"/>
        <ncit4:crossReference xml:lang="en">MESH:D004454
SNOMEDCT:64712007</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Echo Speech, Echophrasia, Echologia</ncit4:synonym>
        <umls5:cui xml:lang="en">C0013528</umls5:cui>
        <rdfs:label xml:lang="en">Echolalia</rdfs:label>
        <skos:definition xml:lang="en">MESH: &quot;Involuntary (&quot;parrot-like&quot;), meaningless repetition of a recently heard word, phrase, or song.&quot; (From Adams et al, Principles of Neurology, th6 ed, p485)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EducationToHealthCareProfessional -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EducationToHealthCareProfessional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessionalFocusedIntervention"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SupportToHealthCareProfessional"/>
        <rdfs:comment xml:lang="en">It refers to the education and training that provide health care professionals with knowledge and skills needed to care people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Education to Health Care Professional</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EducationalStatus -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EducationalStatus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DemographicInformation"/>
        <ncit4:crossReference xml:lang="en">MESH:D004522
SNOMEDCT:266981003</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Educational Achievement, Level of Educational Attainment, Educational Qualification, Education Level Completed, Level of Education Attained</ncit4:synonym>
        <umls5:cui xml:lang="en">C0013658</umls5:cui>
        <rdfs:label xml:lang="en">Educational Status</rdfs:label>
        <skos:definition xml:lang="en">&quot;Educational attainment or level of education of an individual&quot; (MESH)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EffectOfPsychoticSymptom -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EffectOfPsychoticSymptom">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isEffectOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">It refers to the consequence causing by dementia-related psychotic symptoms.</rdfs:comment>
        <rdfs:label xml:lang="en">Effect of Psychotic Symptom</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EmotionalDistress -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EmotionalDistress">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Agitation"/>
        <umls5:cui xml:lang="en">C0700361</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the highly unpleasant emotional reaction.</rdfs:comment>
        <rdfs:label xml:lang="en">Emotional Distress</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EmotionalSupport -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EmotionalSupport">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneralNursingCareIntervention"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:133921002</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Psychological Support</ncit4:synonym>
        <umls5:cui xml:lang="en">C0600015</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to actions of providing love, support, acceptance and encouragement to a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Emotional Support</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EndTime -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EndTime">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Time"/>
        <umls5:cui xml:lang="en">C1522314</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the time when something/event has ceased.</rdfs:comment>
        <rdfs:label xml:lang="en">End Time</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EndocrineImbalance -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EndocrineImbalance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MedicalIllness"/>
        <ncit4:crossReference xml:lang="en">MESH:D004700
SNOMEDCT:362969004</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Endocrine Disorder, Endocrine System Disease</ncit4:synonym>
        <umls5:cui xml:lang="en">C0014130</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the condition when there is too much or too little of a hormone in the bloodstream. Hormones are chemicals that are produced by glands in the endocrine system.</rdfs:comment>
        <rdfs:label xml:lang="en">Endocrine Imbalance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EnrolledNurse -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EnrolledNurse">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HealthCareProfessional"/>
        <rdfs:label xml:lang="en">Enrolled Nurse</rdfs:label>
        <skos:definition xml:lang="en">Australian Nursing and Midwifery Federation defined Enrolled Nurse as &quot;an enrolled nurse is a person who has successfully completed an education program of study accredited by the Australian Nursing and Midwifery Accreditation Council and approved by the Nursing and Midwifery Board of Australia. The enrolled nurse provides nursing care, working under the direction, delegation and supervision of the registed nurse.&quot;</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EnvironmentRelatedToTraumaticExperience -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EnvironmentRelatedToTraumaticExperience">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EnvironmentalCausativeFactor"/>
        <rdfs:comment xml:lang="en">It refers to the environment related to traumatic experience that could trigger the manifestation of psychotic symptoms in person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Environment Related to Traumatic Experience</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EnvironmentalCausativeFactor -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EnvironmentalCausativeFactor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PrecipitatingFactor"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IntrapersonalCausativeFactor"/>
        <rdfs:comment xml:lang="en">It refers to the environmental factors that can cause psychotic symptoms in dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Environmental Causative Factor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EnvironmentalIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EnvironmentalIntervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonWithDementiaFocusedIntervention"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:32051004</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Environmental Modification, Environmental Rearrangement, Institutional Environmental Intervention</ncit4:synonym>
        <umls5:cui xml:lang="en">C0204546</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the intervention of modifying environment of people living with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Environmental Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ErotomanicDelusion -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ErotomanicDelusion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Delusion"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:14144000</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Erotomanic Delusion Disorder</ncit4:synonym>
        <umls5:cui xml:lang="en">C0270490</umls5:cui>
        <rdfs:label xml:lang="en">Erotomanic Delusion</rdfs:label>
        <skos:definition xml:lang="en">&quot;A delusion that another person, usually of higher status, is in love with the individual.&quot; (ICD-11)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EthnicBackground -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EthnicBackground">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DemographicInformation"/>
        <ncit4:crossReference xml:lang="en">MESH:D005006
SNOMEDCT:398089004</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Ethnic Group, Ethnicity</ncit4:synonym>
        <umls5:cui xml:lang="en">C0015031</umls5:cui>
        <rdfs:label xml:lang="en">Ethnic Background</rdfs:label>
        <skos:definition xml:lang="en">&quot;A group of people with a common cultural heritage that sets them apart from others in a variety of social relationships. (MESH)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EtiologicalAssessmentOfPsychoticSymptomsInDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EtiologicalAssessmentOfPsychoticSymptomsInDementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomAssessmentTool"/>
        <ncit4:abbreviation xml:lang="en">EAPSID</ncit4:abbreviation>
        <rdfs:label xml:lang="en">Etiological Assessment of Psychotic Symptoms in Dementia</rdfs:label>
        <skos:definition xml:lang="en">The Etiological Assessment of Psychotic Symptoms in Dementia evaluates psychosis in dementia from an etiological perspective. From Cohen-Mansfield et al. 2017 &quot;Rethinking Psychosis in Dementia: An Analysis of Antecedents and Explanations&quot;</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Evaluation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Evaluation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomManagementActivity"/>
        <ncit4:synonym xml:lang="en">Effectiveness Assessment, Efficacy Assessment</ncit4:synonym>
        <umls5:cui xml:lang="en">C0220825</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the activity of evaluating the effectiveness of the intervention, after the administration of the intervention.</rdfs:comment>
        <rdfs:label xml:lang="en">Evaluation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ExecutiveDysfunction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ExecutiveDysfunction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CognitiveImpairment"/>
        <ncit4:synonym xml:lang="en">Executive Function Deficit, Executive Function Disorder, Impaired Executive Functioning</ncit4:synonym>
        <umls5:cui xml:lang="en">C2748208</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the disruption to the efficacy of the executive functions, which is a grouop of cognitive processes that regulate, control, and manage other cognitive processes.</rdfs:comment>
        <rdfs:label xml:lang="en">Executive Dysfunction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Exercise -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Exercise">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RecreationalActivity"/>
        <ncit4:crossReference xml:lang="en">MESH:D015444
SNOMEDCT:256235009</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Physical Exercise</ncit4:synonym>
        <umls5:cui xml:lang="en">C0015259</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the activity requiring physical effort for sustaining or improving health and fitness.</rdfs:comment>
        <rdfs:label xml:lang="en">Exercise</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ExppressingEmpathy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ExppressingEmpathy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneralNursingCareIntervention"/>
        <ncit4:synonym xml:lang="en">Express Empathy with Individual&apos;s Feelings</ncit4:synonym>
        <umls5:cui xml:lang="en">C0511268</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the activity of expressing insightful awareness of the feelings, mood, sufferings, situations and behavior of another person.</rdfs:comment>
        <rdfs:label xml:lang="en">Expressing Empathy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FactorAffectingImplementationOfNonpharmacologicalInterventionToPsychoticSymptom -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FactorAffectingImplementationOfNonpharmacologicalInterventionToPsychoticSymptom">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/affects"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NonpharmacologicalIntervention"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">It refers to the factors that could affect the implementation of nonpharmacological interventions to psychotic symptoms in dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Factor Affecting Implementation of Nonpharmacological Intervention to Psychotic Symptom</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Fall -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Fall">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/HarmToSelf"/>
        <ncit4:crossReference xml:lang="en">MESH:D000058
SNOMEDCT:217082002</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Accidental fall, Falling</ncit4:synonym>
        <umls5:cui xml:lang="en">C0000921</umls5:cui>
        <rdfs:label xml:lang="en">Fall</rdfs:label>
        <skos:definition xml:lang="en">&quot;Falls due to slipping or tripping which may result in injury.&quot; (from MeSH 2020)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyImmigration -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyImmigration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ImmigrationType"/>
        <rdfs:comment xml:lang="en">It refers to the type of immigration that people choose to live in another country to join their families.</rdfs:comment>
        <rdfs:label xml:lang="en">Family Immigration</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyMember -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyMember">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isFamilyMemberOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonWithDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit4:crossReference xml:lang="en">MESH:D005190
SNOMEDCT:303071001</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Person in the Family</ncit4:synonym>
        <umls5:cui xml:lang="en">C0086282</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the family members of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Family Member</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyMemberFocusedIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyMemberFocusedIntervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/NonpharmacologicalIntervention"/>
        <rdfs:comment xml:lang="en">It refers to the interventions targeting family members of people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Family Member Focused Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FamilyMemberVisit -->

