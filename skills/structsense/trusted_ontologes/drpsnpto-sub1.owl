        <ncit4:abbreviation xml:lang="en">CBT</ncit4:abbreviation>
        <ncit4:crossReference xml:lang="en">MESH:D015928
SNOMEDCT:228553007</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Cognitive Behaviour Modification, Behavioral Cognitive Therapy, Cognitive Therapy</ncit4:synonym>
        <umls5:cui xml:lang="en">C0009244</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to an integrated approach to psychotherapy that combines the techniques of cognitive and behaviour therapy.</rdfs:comment>
        <rdfs:label xml:lang="en">Cognitive Behavioural Therapy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CognitiveImpairment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CognitiveImpairment">
