        <rdfs:comment xml:lang="en">It refers to the activity that health care professionals identify antecedent events that are associated with manifestation of problem behaviour.</rdfs:comment>
        <rdfs:label xml:lang="en">Identifying Antecedent of Behaviour</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IdentifyingConsequenceOfBehaviour -->

