        <ncit4:crossReference xml:lang="en">SNOMEDCT:248162009</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Inappropriately Dressed</ncit4:synonym>
        <umls5:cui xml:lang="en">C0424472</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the behaviour of wearing clothes that are not suitable or proper in the circumstances.</rdfs:comment>
        <rdfs:label xml:lang="en">Inappropriate Dressing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/InappropriateSexualBehaviour -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/InappropriateSexualBehaviour">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyAggressiveBehaviour"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:248099006</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0474420</umls5:cui>
        <rdfs:label xml:lang="en">Inappropriate Sexual Behaviour</rdfs:label>
        <skos:definition xml:lang="en">It refers to the behaviour that is a sexual act which is inappropriate within the context in which it is performed. By Hooren and Waterink 2015 &quot;Uncontrolled Sexual Behaviour in Dementia&quot; DOI:10.5772/59979</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/InappropriateUndressing -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/InappropriateUndressing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyNonaggressiveBehaviour"/>
        <ncit4:synonym xml:lang="en">Inappropriate Disrobing</ncit4:synonym>
        <rdfs:comment xml:lang="en">It refers to the behaviour of taking off clothes in the inappropriate circumstances.</rdfs:comment>
        <rdfs:label xml:lang="en">Inappropriate Undressing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/InappropriatelyHandlingObject -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/InappropriatelyHandlingObject">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyNonaggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">It refers to the behaviour of handling objects inappropriately, such as dumping water jug, and twisting phone card.</rdfs:comment>
        <rdfs:label xml:lang="en">Inappropriately Handling Object</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Incontinence -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Incontinence">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MedicalIllness"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:48340000</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0021167</umls5:cui>
        <rdfs:label xml:lang="en">Incontinence</rdfs:label>
        <skos:definition xml:lang="en">&quot;Involuntary passage of stool or urine from the body.&quot; (National Cancer Institute)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IncreasedLikehihoodOfAdmissionToLongTermCareFacility -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IncreasedLikehihoodOfAdmissionToLongTermCareFacility">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EffectOfPsychoticSymptom"/>
        <rdfs:comment xml:lang="en">It refers to the concept that dementia-related psychotic symptoms can increase the likelihood of placing person with dementia in a long-term care facility.</rdfs:comment>
        <rdfs:label xml:lang="en">Increased Likehihood of Admission to Long Term Care Facility</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IncreasedResourceUtilization -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IncreasedResourceUtilization">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EffectOfPsychoticSymptom"/>
        <rdfs:comment xml:lang="en">It refers to the concept that psychotic symptoms in dementia increase extensive resource utilization.</rdfs:comment>
        <rdfs:label xml:lang="en">Increased Resource Utilization</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IndividualTherapyForPsychoticSymptom -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IndividualTherapyForPsychoticSymptom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonWithDementiaFocusedIntervention"/>
        <rdfs:comment xml:lang="en">It refers to the individual therapy used for managing psychotic symptoms in dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Individual Therapy for Psychotic Symptom</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Infection -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Infection">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MedicalIllness"/>
        <ncit4:crossReference xml:lang="en">MESH:D007239</ncit4:crossReference>
        <umls5:cui xml:lang="en">C3714514</umls5:cui>
        <rdfs:label xml:lang="en">Infection</rdfs:label>
        <skos:definition xml:lang="en">&quot;Invasion of the host organism by microorganisms or their toxins or by parasites that can cause pathological conditions or diseases.&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/InformingDoctor -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/InformingDoctor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneralNursingCareIntervention"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:304562007</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Contacting Physician, Physician Contact</ncit4:synonym>
        <umls5:cui xml:lang="en">C0582446</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the action of communicating with a physician.</rdfs:comment>
        <rdfs:label xml:lang="en">Informing Doctor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/InformingRelative -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/InformingRelative">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneralNursingCareIntervention"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:304563002</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Talking to Relative, Speaking to Relative</ncit4:synonym>
        <umls5:cui xml:lang="en">C0582447</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the act of informing the relative of a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Informing Relative</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/InroomIntercom -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/InroomIntercom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EnvironmentalCausativeFactor"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:462246006</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Inroom Intercom System, Wireless Intercom System</ncit4:synonym>
        <umls5:cui xml:lang="en">C3879062</umls5:cui>
        <rdfs:comment xml:lang="en">In-room intercoms can present inappropriate sensory stimulation and can be interpreted as hearing voices talking from the walls.</rdfs:comment>
        <rdfs:label xml:lang="en">Inroom Intercom</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Insecurity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Insecurity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EnvironmentalCausativeFactor"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:54038000</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0233497</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the concept that a person does not feeling confident in a situation he/she are in.</rdfs:comment>
        <rdfs:label xml:lang="en">Insecurity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Insomnia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Insomnia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/SleepDisturbance"/>
        <ncit4:crossReference xml:lang="en">MESH:D007319
SNOMEDCT:193462001</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Sleeplessness, Insomnia Disorder</ncit4:synonym>
        <umls5:cui xml:lang="en">C0917801</umls5:cui>
        <rdfs:comment xml:lang="en">Insomnia is a sleep disorder in which a person has trouble falling and/or staying asleep.</rdfs:comment>
        <rdfs:label xml:lang="en">Insomnia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Institutionalization -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Institutionalization">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EnvironmentalCausativeFactor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/causes"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/JealousDelusion"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit4:crossReference xml:lang="en">MESH:D007326</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0021629</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the caring for individuals in institutions. Institutionalization can cause some psychotic symptoms in dementia. For example, a person with dementia may have the delusion that he or she is abandoned by his or her family members when the person is placed in a long-term care facility.</rdfs:comment>
        <rdfs:label xml:lang="en">Institutionalization</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/InternetGamingAddiction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/InternetGamingAddiction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Addiction"/>
        <ncit4:crossReference xml:lang="en">MESH:D000082424</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Video Game Addiction, Internet Gaming Disorder</ncit4:synonym>
        <umls5:cui xml:lang="en">C4760905</umls5:cui>
        <rdfs:label xml:lang="en">Internet Gaming Addiction</rdfs:label>
        <skos:definition xml:lang="en">&quot;It is generally defined as the problematic, compulsive use of video games that results in significant impairment to an individual&apos;s ability to function in various life domains over a prolonged period of time.&quot; (Wikipedia)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/InterpersonalSkillTraning -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/InterpersonalSkillTraning">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychosocialRehabilitation"/>
        <rdfs:comment xml:lang="en">It refers to the behaviours and tactics a person uses to interact with others effectively.</rdfs:comment>
        <rdfs:label xml:lang="en">Interpersonal Skill Training</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Interpreter -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Interpreter">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isInterpreterOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PersonWithDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:40570005</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0150646</umls5:cui>
        <rdfs:label xml:lang="en">Interpreter</rdfs:label>
        <skos:definition xml:lang="en">&quot;It refers to someone who mediates between speakers of different languages.&quot; (National Cancer Institute)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/InterpretingNonverbalCommunication -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/InterpretingNonverbalCommunication">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CommunicatingActionSuggested"/>
        <rdfs:comment xml:lang="en">It refers to the communication technique of interpreting nonverbal communication, such as gestures, facial expressions, eye contact, tone of voice, body language, and other ways people using for cammunicating without using language.</rdfs:comment>
        <rdfs:label xml:lang="en">Interpreting Nonverbal Communication</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/InterpretingVerbalCommunication -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/InterpretingVerbalCommunication">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CommunicatingActionSuggested"/>
        <rdfs:comment xml:lang="en">It refers to the communication technique of interpreting confused verbal communication.</rdfs:comment>
        <rdfs:label xml:lang="en">Interpreting Verbal Communication</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Intervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Intervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomManagementActivity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/hasOutcome"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomManagementOutcome"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/reducesPsychoticSymptomCausedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomCausativeFactor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/treats"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PsychoticSymptomInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit4:crossReference xml:lang="en">MESH:D008722
SNOMEDCT:71388002</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Interventional Procedure, Intervention Strategy, Procedure</ncit4:synonym>
        <umls5:cui xml:lang="en">C0184661</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the actual treatments and actions that are performed to treat, or improve psychotic symptoms of a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IntrapersonalCausativeFactor -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IntrapersonalCausativeFactor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PrecipitatingFactor"/>
        <rdfs:comment xml:lang="en">It refers to the things that can cause psychotic symptoms exclusively related to himself/herself.</rdfs:comment>
        <rdfs:label xml:lang="en">Intrapersonal Causative Factor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IntroducingOneselfEachEncounter -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IntroducingOneselfEachEncounter">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CommunicatingActionSuggested"/>
        <rdfs:comment xml:lang="en">It refers to the concept that health care professionals should introduce themselves to people with dementia with each encounter positively.</rdfs:comment>
        <rdfs:label xml:lang="en">Introducing Oneself Each Encounter</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/InvestigatingSuspicion -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/InvestigatingSuspicion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ComprehensiveInitialAssessment"/>
        <ncit4:synonym xml:lang="en">Suspicion Investigation</ncit4:synonym>
        <rdfs:comment xml:lang="en">It refers to the activity that health care professionals investigate suspicions to check their accuracy. For example, if a resident&apos;s belonging was really stolen by other people or it&apos;s a delusion.</rdfs:comment>
        <rdfs:label xml:lang="en">Investigating Suspicion</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IronDeficiency -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IronDeficiency">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Malnutrition"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:35240004</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0240066</umls5:cui>
        <rdfs:label xml:lang="en">Iron Deficiency</rdfs:label>
        <skos:definition xml:lang="en">&quot;Subnormal concentrations of iron resulting from low iron intake, inefficient iron absorption in the gastrointestinal tract, or increased iron loss.&quot; - National Cancer Institute</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Irritability -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Irritability">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/EmotionalDistress"/>
        <ncit4:crossReference xml:lang="en">MESH:D007508
SNOMEDCT:55929007</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Irritable Mood, Fussiness, Feeling Irritable</ncit4:synonym>
        <umls5:cui xml:lang="en">C0022107</umls5:cui>
        <rdfs:label xml:lang="en">Irritability</rdfs:label>
        <skos:definition xml:lang="en">&quot;Abnormal or excessive excitability with easily triggered anger, annoyance, or impatience.&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Isolation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Isolation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IndividualTherapyForPsychoticSymptom"/>
        <rdfs:comment xml:lang="en">It refers to the intervention of keeping people alone or apart from others.</rdfs:comment>
        <rdfs:label xml:lang="en">Isolation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/JealousDelusion -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/JealousDelusion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Delusion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/isCausedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Institutionalization"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:8330006</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Delusion of Infidelity, Infidelity Delusion, Delusional Jealousy, Othello Syndrome</ncit4:synonym>
        <umls5:cui xml:lang="en">C0233689</umls5:cui>
        <rdfs:label xml:lang="en">Jealous Delusion</rdfs:label>
        <skos:definition xml:lang="en">&quot;A delusion that one&apos;s sexual partner is unfaithful.&quot; (ICD-11) A person with dementia may accuse his or her spouse of infidelity.  Because when a married person is placed in a long-term care facility, he or she frequently experiences feelings of betrayal and a loss of trust. Accusing his or her spouse of infidelity can represent the person&apos;s attempt to explain these feelings.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Kicking -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Kicking">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/PhysicallyAggressiveBehaviour"/>
        <umls5:cui xml:lang="en">C2371406</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the behaviour of hitting or striking someone or something with the foot.</rdfs:comment>
        <rdfs:label xml:lang="en">Kicking</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/KnittingHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/KnittingHobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Hobby"/>
        <rdfs:comment xml:lang="en">It refers to the hobby of knitting.</rdfs:comment>
        <rdfs:label xml:lang="en">Knitting Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/KnowledgeAboutEnvironmentalEtiologyOfPsychoticSymptom -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/KnowledgeAboutEnvironmentalEtiologyOfPsychoticSymptom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/KnowledgeOfHealthCareProfessional"/>
        <rdfs:comment xml:lang="en">It refers to the environmental causes of psychotic symptoms in dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Knowledge about Environmental Etiology of Psychotic Symptom</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/KnowledgeOfHealthCareProfessional -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/KnowledgeOfHealthCareProfessional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/FactorAffectingImplementationOfNonpharmacologicalInterventionToPsychoticSymptom"/>
        <rdfs:comment xml:lang="en">It refers to the knowledge that health care professionals have about nonpharmacological intervention to pscyhotic symptoms in dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Knowledge of Health Care Professional</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/LanguageInformation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/LanguageInformation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/DemographicInformation"/>
        <rdfs:comment xml:lang="en">It refers to the information about language used by a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Language Information</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/LegalStatus -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/LegalStatus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/BackgroundOfPersonWithDementia"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:303186005</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0580275</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the legal status of patient.</rdfs:comment>
        <rdfs:label xml:lang="en">Legal Status</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/LiaisingWithPharmacist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/LiaisingWithPharmacist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneralNursingCareIntervention"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:709757003</ncit4:crossReference>
        <umls5:cui xml:lang="en">C4041532</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the act of cooperating with the pharmacist of a person with dementia on a matter of mutual concern.</rdfs:comment>
        <rdfs:label xml:lang="en">Liaising with Pharmacist</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/LiaisingWithPhysician -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/LiaisingWithPhysician">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneralNursingCareIntervention"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:709755006</ncit4:crossReference>
        <umls5:cui xml:lang="en">C4041416</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the act of cooperating with the physician of a person with dementia on a matter of mutual concern.</rdfs:comment>
        <rdfs:label xml:lang="en">Liaising with Physician</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/LiasingWithRelative -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/LiasingWithRelative">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneralNursingCareIntervention"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:225968000</ncit4:crossReference>
        <umls5:cui xml:lang="en">C1279781</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the act of cooperating with relatives of a person with dementia on a matter of mutual concern.</rdfs:comment>
        <rdfs:label xml:lang="en">Liaising with Relative</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Loneliness -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/Loneliness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/IntrapersonalCausativeFactor"/>
        <ncit4:crossReference xml:lang="en">MESH:D008132
SNOMEDCT:267076002</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Feeling Lonely</ncit4:synonym>
        <umls5:cui xml:lang="en">C0023974</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the concept of feeling sad and unhappy as a result of lack of companionship or being separated from others.</rdfs:comment>
        <rdfs:label xml:lang="en">Loneliness</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/LunchTime -->

