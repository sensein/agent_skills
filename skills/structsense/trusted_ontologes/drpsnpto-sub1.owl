        <umls5:cui xml:lang="en">C0525045</umls5:cui>
        <rdfs:label xml:lang="en">Mood Disorder</rdfs:label>
        <skos:definition xml:lang="en">&quot;Those disorders that have a disturbance in mood as their predominant feature.&quot; - MESH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MoodSwing -->

