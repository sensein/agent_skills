        <rdfs:comment xml:lang="en">It refers to the preference to clothing.</rdfs:comment>
        <rdfs:label xml:lang="en">Clothing Preference</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CognitiveAbility -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CognitiveAbility">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/RemainingAbility"/>
        <ncit4:crossReference xml:lang="en">SNOMEDCT:413384008</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Ability to Perform Cognitive Activity</ncit4:synonym>
        <umls5:cui xml:lang="en">C0392334</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the general mental capability of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Cognitive Ability</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CognitiveBehaviouralTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/CognitiveBehaviouralTherapy">
