        <umls5:cui xml:lang="en">C0585039</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the time of people having midday meal.</rdfs:comment>
        <rdfs:label xml:lang="en">Lunch Time</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MOUSEPAD -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MOUSEPAD">
