        <umls5:cui xml:lang="en">C0233794</umls5:cui>
        <rdfs:label xml:lang="en">Memory Impairment</rdfs:label>
        <skos:definition xml:lang="en">&quot;Deterioration in memory function&quot; (National Cancer Institute)</skos:definition>
    </owl:Class>
    


