        <ncit4:crossReference xml:lang="en">MESH:D003248
SNOMEDCT:14760008</ncit4:crossReference>
        <umls5:cui xml:lang="en">C0009806</umls5:cui>
        <rdfs:comment xml:lang="en">Constipation is the passing of hard, dry bowel motions (stools) that may be infrequent or difficult to pass.</rdfs:comment>
        <rdfs:label xml:lang="en">Constipation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ContactInformation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/ContactInformation">
