SNOMEDCT:263495000</ncit4:crossReference>
        <ncit4:synonym xml:lang="en">Sex</ncit4:synonym>
        <umls5:cui xml:lang="en">C0079399</umls5:cui>
        <rdfs:label xml:lang="en">Gender Identity</rdfs:label>
        <skos:definition xml:lang="en">MESH: &quot;Socially-constructed identity of male or female.&quot;</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneralNursingCareIntervention -->

