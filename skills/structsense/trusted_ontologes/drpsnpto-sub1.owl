        <umls5:cui xml:lang="en">C0204650</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the basic care practices that health care professionals can provide to intervene the psychotic symptoms in dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">General Nursing Care Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneralPractitioner -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/GeneralPractitioner">
