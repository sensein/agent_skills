        <umls5:cui xml:lang="en">C0025517</umls5:cui>
        <rdfs:comment xml:lang="en">A metabolic disorder occurs when the metabolism fails and causes the body to have either too much or too little of the essential substances needed to stay healthy.</rdfs:comment>
        <rdfs:label xml:lang="en">Metabolic Disorder</rdfs:label>
    </owl:Class>
    


