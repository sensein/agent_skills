        <umls5:cui xml:lang="en">C0030695</umls5:cui>
        <rdfs:comment xml:lang="en">It refers to the act of regularly watch and check a person or condition to see if there is any change.</rdfs:comment>
        <rdfs:label xml:lang="en">Monitoring</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MoodDisorder -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2020/DRPSNPTO/MoodDisorder">
