    <!-- http://www.purl.org/NDDO/NDDO_10002255 -->

    <owl:Class rdf:about="http://www.purl.org/NDDO/NDDO_10002255">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/NDDO/NDDO_00000103"/>
        <metadata:prefixIRI>NDDO:NDDO_10002255</metadata:prefixIRI>
        <rdfs:isDefinedBy>The scale for clock drawing assessment goes from 0 to 5 points. 







1 point - Approximately circular face. 



1 point - Symmetry of number placement.



1 point - Correctness of numbers. All numbers must be present and in the correct order, and inside the face of the clock.



1 point - Presence of two hands. Two hands (and only two hands) must be present on the clock face to receive credit for this item.



1 point - Presence of two hands set to ten after eleven.



 



Total: 5 points.</rdfs:isDefinedBy>
        <rdfs:label>Clock Drawing Assessment Scale</rdfs:label>
    </owl:Class>
    


