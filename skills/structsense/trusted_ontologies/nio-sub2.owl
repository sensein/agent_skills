    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/UO_0000176">
        <obo:IAO_0000111>milligram per milliliter</obo:IAO_0000111>
        <obo:IAO_0000115>A mass unit density which is equal to mass of an object in milligrams divided by the volume in milliliters.</obo:IAO_0000115>
        <obo:IAO_0000118>mg per ml</obo:IAO_0000118>
        <obo:IAO_0000118>mg/ml</obo:IAO_0000118>
