    <!-- http://purl.obolibrary.org/obo/NBO_0000285 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000285">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000286"/>
