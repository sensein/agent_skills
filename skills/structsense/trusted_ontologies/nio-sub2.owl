    <!-- http://scai.fraunhofer.de/AlzheimerOntology#geriatric_depression_scale -->

    <owl:Class rdf:about="http://scai.fraunhofer.de/AlzheimerOntology#geriatric_depression_scale">
        <rdfs:subClassOf rdf:resource="http://scai.fraunhofer.de/AlzheimerOntology#Mood_Evaluation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/alba/ontologies/2020/10/NIO#is_used_in"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0500027"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI>AlzheimerOntology:geriatric_depression_scale</metadata:prefixIRI>
        <NDDUO:Reference>from manual annotation of text corpus</NDDUO:Reference>
        <rdfs:comment xml:lang="en">The Geriatric Depression Scale (GDS) is a 30-item self-report assessment used to identify depression in the elderly, where questions are answered &quot;yes&quot; or &quot;no.&quot; A five-category response set is not utilized in order to ensure that the scale is simple enough to be used when testing ill or moderately cognitively impaired individuals, for whom a more complex set of answers may be confusing, or lead to inaccurate recording of responses.

--Wikipedia--</rdfs:comment>
        <rdfs:label>Geriatric Depression Scale</rdfs:label>
    </owl:Class>
    


