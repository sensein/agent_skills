        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>body posture</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000357 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000357">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000355"/>
        <metadata:prefixIRI>NBO:0000357</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
