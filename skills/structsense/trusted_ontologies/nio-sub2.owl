        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>resting posture</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000359 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000359">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000013"/>
        <metadata:prefixIRI>NBO:0000359</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T09:44:37Z</obo:creation_date>
        <obo:def>&quot;Behavior associated with surface locomotion.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>terrestrial locomotory behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000360 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000360">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000366"/>
        <metadata:prefixIRI>NBO:0000360</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T09:47:57Z</obo:creation_date>
        <obo:def>&quot;Behavior related to the upward thrust produced by the rapid, simultaneous extension of the hind legs with the intend to cross wide gaps in the locomotor surface.&quot; [MBP:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>saltation</obo:synonym>
        <rdfs:label>leaping behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000361 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000361">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000342"/>
        <metadata:prefixIRI>NBO:0000361</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T10:07:23Z</obo:creation_date>
        <obo:def>&quot;The pattern of movement of the limbs of animals, characterized by elements of progression, stability, speed and length over the ground.&quot; [MP:0001406]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>gait</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000362 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000362">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000361"/>
        <metadata:prefixIRI>NBO:0000362</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T10:08:59Z</obo:creation_date>
        <obo:def>&quot;A behavioral pattern characterized by the distance covered by as many steps as there are legs.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>stride</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000363 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000363">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000359"/>
        <metadata:prefixIRI>NBO:0000363</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T11:39:16Z</obo:creation_date>
        <obo:def>&quot;Behavior related to the movement resulting by dragging the body close to the ground.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>crawling behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000364 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000364">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000368"/>
        <metadata:prefixIRI>NBO:0000364</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T11:40:46Z</obo:creation_date>
        <obo:def>&quot;Behavior related to the locomotion of animals in trees.&quot; [wikipedia:Arboreal_locomotion]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>arboreal locomotion behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000365 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000365">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000364"/>
        <metadata:prefixIRI>NBO:0000365</metadata:prefixIRI>
        <obo:comment>Arguably the epitome of arboreal locomotion, it involves swinging with the arms from one handhold to another.</obo:comment>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T11:42:31Z</obo:creation_date>
        <obo:def>&quot;A form arboreal locomotion used by primates to moves very rapidly while hanging beneath branches.&quot; [wikipedia:Arboreal_locomotion]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>brachiation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000366 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000366">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000013"/>
        <metadata:prefixIRI>NBO:0000366</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T11:44:55Z</obo:creation_date>
        <obo:def>&quot;Behavior related to the movement of an organism from one location to another through the air.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>aerial locomotion behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000367 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000367">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000366"/>
        <metadata:prefixIRI>NBO:0000367</metadata:prefixIRI>
        <obo:alt_id>NBO:0000072</obo:alt_id>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T11:45:51Z</obo:creation_date>
        <obo:def>&quot;Behavior related to the self-propelled movement of an organism from one location to another through the air, usually by means of active wing movement.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>flying</obo:synonym>
        <obo:xref>GO:0007629</obo:xref>
        <rdfs:label>flight behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000368 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000368">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000013"/>
        <metadata:prefixIRI>NBO:0000368</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T11:46:00Z</obo:creation_date>
        <obo:def>&quot;Behavior related to the ascending a steep object.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>climbing behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000369 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000369">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000366"/>
        <metadata:prefixIRI>NBO:0000369</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T12:20:11Z</obo:creation_date>
        <obo:def>&quot;Behavior related to the expansion lateral surface of the body with the intention of increasing the wind resistance against the body and hence reducing the speed of falling.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>gliding behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000370 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000370">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000016"/>
        <metadata:prefixIRI>NBO:0000370</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T12:25:30Z</obo:creation_date>
        <obo:def>&quot;Behavior related to the upward thrust produced by the rapid, simultaneous extension of the hind legs with the intend to rise in the air.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>hopping</obo:synonym>
        <rdfs:label>saltation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000371 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000371">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000013"/>
        <metadata:prefixIRI>NBO:0000371</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T12:33:07Z</obo:creation_date>
        <obo:def>&quot;Behavior related to the movement of an organism from one location to another through a liquid medium.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>swimming</obo:synonym>
        <rdfs:label>aquatic locomotion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000372 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000372">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000013"/>
        <metadata:prefixIRI>NBO:0000372</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T01:15:21Z</obo:creation_date>
        <obo:def>&quot;Behavior related to the control of the direction of locomotion.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>directional control of locomotion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000373 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000373">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000372"/>
        <metadata:prefixIRI>NBO:0000373</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T01:16:55Z</obo:creation_date>
        <obo:def>&quot;Behavior related to the ability of an animal to determine and to alter its position in the environment.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>locomotory orientation behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000374 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000374">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000373"/>
        <metadata:prefixIRI>NBO:0000374</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T01:17:18Z</obo:creation_date>
        <obo:def>&quot;Alteration of speed or direction of movement in response to a sensory stimulus.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:xref>GO:0042465</obo:xref>
        <rdfs:label>kinesis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000375 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000375">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000373"/>
        <metadata:prefixIRI>NBO:0000375</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T01:17:27Z</obo:creation_date>
        <obo:def>&quot;Locomotory orientation in a specific spatial relationship to a stimulus.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:xref>GO:0042330</obo:xref>
        <rdfs:label>taxis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000376 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000376">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000372"/>
        <metadata:prefixIRI>NBO:0000376</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T01:18:17Z</obo:creation_date>
        <obo:def>&quot;Behavior related to the mechanical alteration of the locomotor pattern through which the animal adjusts its position.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>steering behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000377 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000377">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000375"/>
        <metadata:prefixIRI>NBO:0000377</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T01:23:34Z</obo:creation_date>
        <obo:def>&quot;Locomotory orientation in response to specific chemical concentration gradient.&quot; [GO:0006935]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>chemotaxis</obo:synonym>
        <obo:xref>GO:0006935</obo:xref>
        <rdfs:label>chemotactic behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000378 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000378">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000375"/>
        <metadata:prefixIRI>NBO:0000378</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T01:27:22Z</obo:creation_date>
        <obo:def>&quot;Locomotory orientation in response to gravity.&quot; [GO:0048062]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>geotactic behaviour</obo:synonym>
        <obo:synonym>gravitaxis</obo:synonym>
        <obo:xref>GO:0042332</obo:xref>
        <rdfs:label>gravitactic behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000379 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000379">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000378"/>
        <metadata:prefixIRI>NBO:0000379</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T01:32:49Z</obo:creation_date>
        <obo:def>&quot;Locomotory orientation away from the source of gravity.&quot; [GO:0048060]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>negative geotactic behaviour</obo:synonym>
        <obo:synonym>negative gravitaxis</obo:synonym>
        <obo:xref>GO:0048060</obo:xref>
        <rdfs:label>negative gravitactic behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000380 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000380">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000378"/>
        <metadata:prefixIRI>NBO:0000380</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T01:34:24Z</obo:creation_date>
        <obo:def>&quot;Locomotory orientation towards the source of gravity.&quot; [GO:0048061]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>positive geotactic behaviour</obo:synonym>
        <obo:synonym>positive gravitaxis</obo:synonym>
        <obo:xref>GO:0048061</obo:xref>
        <rdfs:label>positive gravitactic behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000381 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000381">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000386"/>
        <metadata:prefixIRI>NBO:0000381</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T01:45:18Z</obo:creation_date>
        <obo:def>&quot;Locomotory orientation in response to touch.&quot; [GO:0001966]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>stereotaxis</obo:synonym>
        <rdfs:label>thigmotaxis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000382 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000382">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000375"/>
        <metadata:prefixIRI>NBO:0000382</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T01:47:46Z</obo:creation_date>
        <obo:def>&quot;Locomotory orientation in response to physical parameters involved in energy generation.&quot; [GO:0009453]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:xref>GO:0009453</obo:xref>
        <rdfs:label>energy taxis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000383 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000383">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000382"/>
        <metadata:prefixIRI>NBO:0000383</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T01:48:33Z</obo:creation_date>
        <obo:def>&quot;Locomotory orientation in response to light.&quot; [GO:0042331]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>phototaxis</obo:synonym>
        <obo:xref>GO:0042331</obo:xref>
        <rdfs:label>phototactic behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000384 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000384">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000382"/>
        <metadata:prefixIRI>NBO:0000384</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T01:50:19Z</obo:creation_date>
        <obo:def>&quot;Locomotory orientation in response to a temperature gradient.&quot; [GO:0043052]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:xref>GO:0043052</obo:xref>
        <rdfs:label>thermotaxis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000385 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000385">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000386"/>
        <metadata:prefixIRI>NBO:0000385</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T01:58:40Z</obo:creation_date>
        <obo:def>&quot;Locomotory orientation in response to sound.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>phonotaxis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000386 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000386">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000375"/>
        <metadata:prefixIRI>NBO:0000386</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T01:59:20Z</obo:creation_date>
        <obo:def>&quot;Locomotory orientation in response to mechanical stimulus.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>mechanical stimulus taxis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000387 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000387">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000386"/>
        <metadata:prefixIRI>NBO:0000387</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T02:01:21Z</obo:creation_date>
        <obo:def>&quot;Locomotory orientation in response to pressure.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>barotaxis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000388 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000388">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000338"/>
        <metadata:prefixIRI>NBO:0000388</metadata:prefixIRI>
        <obo:comment>Movevents listed here are involuntary, but may be also generated by free will, like blinking of the eyelids and respiratory movements.</obo:comment>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T02:35:38Z</obo:creation_date>
        <obo:def>&quot;Behavior related to movements that occur independent of planning.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>involuntary movement behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000389 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000389">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000388"/>
        <metadata:prefixIRI>NBO:0000389</metadata:prefixIRI>
        <obo:alt_id>NBO:0000004</obo:alt_id>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T02:36:55Z</obo:creation_date>
        <obo:def>&quot;Behavior related to involuntary movement in response to a stimulus.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>reflex behaviour</obo:synonym>
        <rdfs:label>reflexive behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000390 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000390">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000389"/>
        <metadata:prefixIRI>NBO:0000390</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T02:44:15Z</obo:creation_date>
        <obo:def>&quot;Reflex actions originating in the central nervous system that are exhibited by normal infants in response to particular stimuli.&quot; [wikipedia:Primitive_reflexes]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym> infant reflex</obo:synonym>
        <obo:synonym>infantile reflex</obo:synonym>
        <obo:synonym>newborn reflex</obo:synonym>
        <rdfs:label>primitive reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000391 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000391">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000389"/>
        <metadata:prefixIRI>NBO:0000391</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T02:55:21Z</obo:creation_date>
        <obo:def>&quot;An action or movement due to the application of a sudden unexpected stimulus.&quot; [wikipedia:Startle_reflex]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>alarm reaction</obo:synonym>
        <rdfs:label>startle reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000392 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000392">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000390"/>
        <metadata:prefixIRI>NBO:0000392</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T03:03:51Z</obo:creation_date>
        <obo:def>&quot;A reflex that arises when tilting the head back while lying on the back causes the back to stiffen and even arch backwards, the legs to straighten, stiffen, and push together, the toes to point, the arms to bend at the elbows and wrists, and the hands to become fisted or the fingers to curl.&quot; [wikipedia:Tonic_labyrinthine_reflex]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>TLR</obo:synonym>
        <rdfs:label>tonic labyrinthine reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000393 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000393">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000390"/>
        <metadata:prefixIRI>NBO:0000393</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T03:05:52Z</obo:creation_date>
        <obo:def>&quot;A reflex that assists in the birthing process and helps to develop muscle tone, kicking and stimulates vestibular function in utero.&quot; [wikipedia:Asymmetrical_tonic_neck_reflex]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>ATNR</obo:synonym>
        <obo:synonym>fencing reflex</obo:synonym>
        <rdfs:label>asymmetrical tonic neck reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000394 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000394">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000390"/>
        <metadata:prefixIRI>NBO:0000394</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T03:10:14Z</obo:creation_date>
        <obo:def>&quot;A reflex that causes the eyes to alternately fixate at far and near, expanding vision development from arms length to far away.&quot; [MBP:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>symmetrical tonic neck reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000395 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000395">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000390"/>
        <metadata:prefixIRI>NBO:0000395</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T03:11:13Z</obo:creation_date>
        <obo:def>&quot;It is elicited by holding the newborn in ventral suspension (face down) and stroking along the one side of the spine. A reflex that caused the laterally flex toward the stimulated side when a newborn is held in ventral suspension (face down) and stroking along the one side of the spine.&quot; [NBO:Galant_reflex]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>spinal galant</obo:synonym>
        <rdfs:label>galant reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000396 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000396">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000390"/>
        <metadata:prefixIRI>NBO:0000396</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T03:14:17Z</obo:creation_date>
        <obo:def>&quot;A reflex elicited by the application of pressure to both palms resulting varying responses such as head flexion, head rotation or opening of the mouth, or a combination of these responses.&quot; [wikipedia:Primitive_reflexes]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>babkin reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000397 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000397">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000390"/>
        <metadata:prefixIRI>NBO:0000397</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T03:15:57Z</obo:creation_date>
        <obo:def>&quot;A reflex that causes the infant to begin to paddle and kick in a swimming motion upon its placement face down in a pool of water.&quot; [NBO:Primitive_reflexes]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>swimming reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000398 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000398">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000390"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000404"/>
        <metadata:prefixIRI>NBO:0000398</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T03:18:52Z</obo:creation_date>
        <obo:def>&quot;A reflex elicited when the sole of the foot is stimulated with a blunt instrument.&quot; [wikipedia:Plantar_reflex]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>plantar reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000399 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000399">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000390"/>
        <metadata:prefixIRI>NBO:0000399</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T03:20:02Z</obo:creation_date>
        <obo:def>&quot;A reflex elicited by the placement of an object in the infant&apos;s hand and strokes their palm, causing its fingers to close and grasp it.&quot; [wikipedia:Primitive_reflexes]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>palmar grasp reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000400 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000400">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000390"/>
        <metadata:prefixIRI>NBO:0000400</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T03:22:48Z</obo:creation_date>
        <obo:def>&quot;A reflex that causes a newborn infant to turn his head toward anything that strokes his cheek or mouth, searching for the object by moving his head in steadily decreasing arcs until the object is found.&quot; [wikipedia:Primitive_reflexes]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>rooting reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000401 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000401">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000054"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000390"/>
        <metadata:prefixIRI>NBO:0000401</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T03:25:21Z</obo:creation_date>
        <obo:def>&quot;A reflex that causes the infant to instinctively suck at anything that touches the roof of their mouth and suddenly starts to suck simulating the way they naturally eat.&quot; [wikipedia:Primitive_reflexes]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>sucking reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000402 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000402">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000390"/>
        <metadata:prefixIRI>NBO:0000402</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T03:26:47Z</obo:creation_date>
        <obo:def>&quot;A reflex that causes the infant to attempt to &apos;walk&apos; by placing one foot in front of the other when the soles of their feet touch a flat surface.&quot; [wikipedia:Primitive_reflexes]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym> stepping reflex</obo:synonym>
        <rdfs:label>walking reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000403 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000403">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000338"/>
        <metadata:prefixIRI>NBO:0000403</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T03:32:28Z</obo:creation_date>
        <obo:def>&quot;Behavior related to movements executed with intent.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>voluntary movement behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000404 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000404">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000389"/>
        <metadata:prefixIRI>NBO:0000404</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T04:02:17Z</obo:creation_date>
        <obo:def>&quot;A muscle contraction in response to stretching within the muscle.&quot; [wikipedia:Stretch_reflex]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>deep tendon reflex</obo:synonym>
        <rdfs:label>stretch reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000405 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000405">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000404"/>
        <metadata:prefixIRI>NBO:0000405</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T04:06:11Z</obo:creation_date>
        <obo:def>&quot;A deep tendon reflex that elicits involuntary contraction of the biceps brachii muscle.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>biceps reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000406 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000406">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000404"/>
        <metadata:prefixIRI>NBO:0000406</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T04:07:37Z</obo:creation_date>
        <obo:def>&quot;A deep tendon reflex elicited by striking the lateral surface of the forearm proximal to the distal head of the radius, characterized by normal slight elbow flexion and forearm supination.&quot; [Medical disctionary:http\://medical-dictionary.thefreedictionary.com/brachioradialis+reflex]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>supinator reflex</obo:synonym>
        <rdfs:label>brachioradialis reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000407 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000407">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000404"/>
        <metadata:prefixIRI>NBO:0000407</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T04:09:37Z</obo:creation_date>
        <obo:def>&quot;A reflex that elicits involuntary contraction of the extensor digitorum muscle.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>BER</obo:synonym>
        <obo:synonym>Braunecker-Effenberg reflex</obo:synonym>
        <rdfs:label>extensor digitorum reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000408 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000408">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000404"/>
        <metadata:prefixIRI>NBO:0000408</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T04:12:22Z</obo:creation_date>
        <obo:def>&quot;A deep tendon reflex that elicits involuntary contraction of the triceps brachii muscle.&quot; [wikipedia:Triceps_reflex]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>triceps reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000409 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000409">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000404"/>
        <metadata:prefixIRI>NBO:0000409</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T04:18:23Z</obo:creation_date>
        <obo:def>&quot;A deep tendon reflex that elicits extension of the leg resulting from a sharp tap on the patellar tendon.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>knee-jerk reflex</obo:synonym>
        <rdfs:label>patellar reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000410 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000410">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000404"/>
        <metadata:prefixIRI>NBO:0000410</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T04:20:42Z</obo:creation_date>
        <obo:def>&quot;A reflex bending of the foot resulting from contraction of the calf muscles when the Achilles tendon is sharply struck.&quot; [Medical Dictionary:http\://medical-dictionary.thefreedictionary.com/Achilles+reflex]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym> triceps surae reflex</obo:synonym>
        <obo:synonym>Achilles reflex</obo:synonym>
        <obo:synonym>Achilles tendon reflex</obo:synonym>
        <obo:synonym>ankle reflex</obo:synonym>
        <rdfs:label>ankle jerk reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000411 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000411">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000389"/>
        <metadata:prefixIRI>NBO:0000411</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T04:28:27Z</obo:creation_date>
        <obo:def>&quot;A reflex that involves cranial nerves.&quot; [wikipedia:Reflex]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>cranial nerve related reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000412 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000412">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000411"/>
        <metadata:prefixIRI>NBO:0000412</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T04:28:58Z</obo:creation_date>
        <obo:def>&quot;A reflex that controls the diameter of the pupil, in response to the intensity (luminance) of light that falls on the retina of the eye, thereby assisting in adaptation to various levels of darkness and light, in addition to retinal sensitivity.&quot; [wikipedia:Pupillary_light_reflex]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>pupillary reflex</obo:synonym>
        <rdfs:label>pupillary light reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000413 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000413">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000411"/>
        <metadata:prefixIRI>NBO:0000413</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T04:29:55Z</obo:creation_date>
        <obo:def>&quot;A reflex action of the eye, in response to focusing on a near object, then looking at distant object (and vice versa), comprising coordinated changes in vergence, lens shape and pupil size.&quot; [wikipedia:Accommodation_reflex]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>accommodation reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000414 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000414">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000411"/>
        <metadata:prefixIRI>NBO:0000414</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T04:30:58Z</obo:creation_date>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>masseter reflex</obo:synonym>
        <rdfs:label>jaw jerk reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000415 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000415">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000411"/>
        <metadata:prefixIRI>NBO:0000415</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T06:08:06Z</obo:creation_date>
        <obo:def>&quot;An involuntary blinking of the eyelids elicited by stimulation of the cornea.&quot; [wikipedia:Corneal_reflex]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>blink reflex</obo:synonym>
        <obo:synonym>blinking</obo:synonym>
        <rdfs:label>corneal reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000416 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000416">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000411"/>
        <metadata:prefixIRI>NBO:0000416</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T06:11:09Z</obo:creation_date>
        <obo:def>&quot;A reflex eye movement that stabilizes images on the retina during head movement by producing an eye movement in the direction opposite to head movement, thus preserving the image on the center of the visual field.&quot; [wikipedia:Vestibulo-ocular_reflex]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>VOR</obo:synonym>
        <obo:synonym>oculovestibular reflex</obo:synonym>
        <obo:synonym>vestibuloocular reflex</obo:synonym>
        <rdfs:label>vestibulo-ocular reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000417 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000417">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000416"/>
        <metadata:prefixIRI>NBO:0000417</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T06:16:20Z</obo:creation_date>
        <obo:def>&quot;A form of involuntary eye movement that is part of the vestibulo-ocular reflex (VOR). It is characterized by alternating smooth pursuit in one direction and saccadic movement in the other direction.&quot; [wikipedia:Physiologic_nystagmus]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>physiologic nystagmus</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000418 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000418">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000411"/>
        <metadata:prefixIRI>NBO:0000418</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T06:17:32Z</obo:creation_date>
        <obo:def>&quot;A reflex contraction of the back of the throat, evoked by touching the soft palate.&quot; [wikipedia:Gag_reflex]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>gag reflex</obo:synonym>
        <obo:synonym>swallowing reflex</obo:synonym>
        <rdfs:label>pharyngeal reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000425 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000425">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000389"/>
        <metadata:prefixIRI>NBO:0000425</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-07T05:12:21Z</obo:creation_date>
        <obo:def>&quot;A reflex that results in the contraction of the muscles of the abdominal wall in response to stimulation of the overlying skin.&quot; [web:http\://www.merriam-webster.com/medical/abdominal%20reflex]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>abdominal reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000426 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000426">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000389"/>
        <metadata:prefixIRI>NBO:0000426</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-07T05:12:40Z</obo:creation_date>
        <obo:def>&quot;Reflexive contraction of the external anal sphincter upon stroking of the skin around the anus.&quot; [wikipedia:Anal_wink]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>anal reflex</obo:synonym>
        <obo:synonym>anal wink</obo:synonym>
        <obo:synonym>perineal reflex</obo:synonym>
        <rdfs:label>anocutaneous reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000427 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000427">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000389"/>
        <metadata:prefixIRI>NBO:0000427</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-07T05:15:36Z</obo:creation_date>
        <obo:def>&quot;A reflex is elicited by lightly stroking the superior and medial (inner) part of the thigh resulting in a contraction of the cremaster muscle that pulls up the scrotum and testis on the side stroked.&quot; [wikipedia:Cremasteric_reflex]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>cremasteric reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000428 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000428">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000389"/>
        <metadata:prefixIRI>NBO:0000428</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-07T05:16:44Z</obo:creation_date>
        <obo:def>&quot;A reflex in mammals which optimises respiration to allow staying underwater for extended periods of time.&quot; [wikipedia:Mammalian_diving_reflex]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>mammalian diving reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000429 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000429">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000425"/>
        <metadata:prefixIRI>NBO:0000429</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-07T05:18:30Z</obo:creation_date>
        <obo:def>&quot;An increase in tonus (normal tension) of the tissues of the abdominal muscles resulting from painful stimuli originating in a viscus.&quot; [:http\://www.wordinfo.info/words/index/inf]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>visceromotor reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000430 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000430">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000429"/>
        <metadata:prefixIRI>NBO:0000430</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-07T05:20:21Z</obo:creation_date>
        <obo:def>&quot;A reflex of the abdominal muscles to contract upon mechanical force to the abdomen, and serves as protection.&quot; [wikipedia:Muscular_defense]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>muscular defense</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000431 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000431">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000057"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000389"/>
        <metadata:prefixIRI>NBO:0000431</metadata:prefixIRI>
        <obo:alt_id>NBO:0000021</obo:alt_id>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-07T05:21:15Z</obo:creation_date>
        <obo:def>&quot;A response to activation of sensory neurons whose peripheral terminals are located on the surface of the body.&quot; [wikipedia:Scratch_reflex]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>self-scratching</obo:synonym>
        <rdfs:label>scratch reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000432 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000432">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000391"/>
        <metadata:prefixIRI>NBO:0000432</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-07T05:31:27Z</obo:creation_date>
        <obo:def>&quot;An action or movement due to the application of a sudden unexpected loud noise.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>acoustic startle reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000433 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000433">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000404"/>
        <metadata:prefixIRI>NBO:0000433</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-07T05:35:05Z</obo:creation_date>
        <obo:def>&quot;A reflex where the body reacts to pain or unpleasant stimuli by trying to move itself away from the source.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>flexor withdrawal reflex</obo:synonym>
        <obo:synonym>nociceptive reflex</obo:synonym>
        <rdfs:label>withdrawal reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000434 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000434">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000433"/>
        <metadata:prefixIRI>NBO:0000434</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-07T05:39:15Z</obo:creation_date>
        <obo:def>&quot;A reflex where the flexors in the withdrawing limb contract and the extensors relax, while in the other limb, the opposite occurs.&quot; [wikipedia:Crossed_extensor_reflex]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>crossed extensor reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000435 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000435">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000389"/>
        <metadata:prefixIRI>NBO:0000435</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-07T05:41:07Z</obo:creation_date>
        <obo:def>&quot;An involuntary muscle contraction that occurs in the middle ear of mammals in response to high-intensity sound stimuli.&quot; [wikipedia:Acoustic_reflex]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym> attenuation reflex</obo:synonym>
        <obo:synonym>auditory reflex</obo:synonym>
        <obo:synonym>stapedius reflex</obo:synonym>
        <rdfs:label>acoustic reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000436 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000436">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000389"/>
        <metadata:prefixIRI>NBO:0000436</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-07T05:42:50Z</obo:creation_date>
        <obo:def>&quot;A reflex in which joint movement can reflexively cause muscle activation or inhibition.&quot; [wikpedia:Arthrokinetic_reflex]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>arthrokinetic reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000437 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000437">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000389"/>
        <metadata:prefixIRI>NBO:0000437</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-07T05:45:22Z</obo:creation_date>
        <obo:def>&quot;A reflex by which the body rids the lower respiratory tract of any irritant that enters through the air and less frequently any fluids (drinks) and solids (food) that may spill into the respiratory tract.&quot; [XX:http\://www.healthhype.com/cough-reflex-physiology-process-ear-cough-reflexes.html]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>cough reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000438 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000438">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000390"/>
        <metadata:prefixIRI>NBO:0000438</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-07T05:47:28Z</obo:creation_date>
        <obo:def>&quot;A pouting or pursing of the lips that is elicited by light tapping of the closed lips near the midline.&quot; [wikipedia:Snout_reflex]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>snout reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000439 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000439">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000390"/>
        <metadata:prefixIRI>NBO:0000439</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-07T05:48:07Z</obo:creation_date>
        <obo:def>&quot;A reflex elicited by repetitive tapping on the forehead which result in blinking to the first several taps.&quot; [wikipedia:Glabellar_reflex]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>glabellar tap sign</obo:synonym>
        <rdfs:label>glabellar reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000440 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000440">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000389"/>
        <metadata:prefixIRI>NBO:0000440</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T12:01:59Z</obo:creation_date>
        <obo:def>&quot;A skeletal muscle contraction causes the muscle to simultaneously lengthen and relax.&quot; [wikipedia:Golgi_tendon_reflex]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>inverse myotatic reflex</obo:synonym>
        <rdfs:label>Golgi tendon reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000441 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000441">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000389"/>
        <metadata:prefixIRI>NBO:0000441</metadata:prefixIRI>
        <obo:comment>The shivering reflex is triggered to maintain homeostasis.</obo:comment>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T12:05:40Z</obo:creation_date>
        <obo:def>&quot;A reflex in which muscle groups around the vital organs begin to shake in small movements in an attempt to create warmth by expending energy.&quot; [wikipedia:Shivering]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>shivering reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000442 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000442">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000389"/>
        <metadata:prefixIRI>NBO:0000442</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T12:08:31Z</obo:creation_date>
        <obo:def>&quot;A reflex in which mucus containing foreign particles or irritants is expelled and the nasal cavity is cleanses.&quot; [wikipedia:Sneeze]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>sneeze</obo:synonym>
        <obo:synonym>sneezing</obo:synonym>
        <rdfs:label>sternutation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000443 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000443">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000389"/>
        <metadata:prefixIRI>NBO:0000443</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T12:10:27Z</obo:creation_date>
        <obo:def>&quot;A contraction of muscles in the gastrointestinal tract in response to distension of the tract following consumption of food and drink.&quot; [wikipedia:Vagus_reflex]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>vagovagal reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000444 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000444">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000001"/>
        <metadata:prefixIRI>NBO:0000444</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T12:22:02Z</obo:creation_date>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>eye movement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000445 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000445">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000001"/>
        <metadata:prefixIRI>NBO:0000445</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T12:22:13Z</obo:creation_date>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>tail movement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000446 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000446">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000444"/>
        <metadata:prefixIRI>NBO:0000446</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T12:25:53Z</obo:creation_date>
        <obo:def>&quot;Selectively track a moving object.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>visual pursuit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000447 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000447">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000403"/>
        <metadata:prefixIRI>NBO:0000447</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T12:27:51Z</obo:creation_date>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>locomotor activation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000448 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000448">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000013"/>
        <metadata:prefixIRI>NBO:0000448</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T12:28:10Z</obo:creation_date>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>vertical activity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000449 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000449">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000447"/>
        <metadata:prefixIRI>NBO:0000449</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T12:28:25Z</obo:creation_date>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>spontaneous movement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000450 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000450">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000011"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000027"/>
        <metadata:prefixIRI>NBO:0000450</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T12:35:02Z</obo:creation_date>
        <obo:def>&quot;Behavior related to the activity in which individuals in a group clean or maintain one another&apos;s body or appearance.&quot; [wikipedia:Social_grooming]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>allogrooming</obo:synonym>
        <rdfs:label>social grooming</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000451 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000451">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000027"/>
        <metadata:prefixIRI>NBO:0000451</metadata:prefixIRI>
        <obo:alt_id>NBO:0000058</obo:alt_id>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T12:35:54Z</obo:creation_date>
        <obo:def>&quot;Behavior related to the promotion of personal hygiene.&quot; [wikipedia:Social_grooming]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>auto-grooming</obo:synonym>
        <obo:synonym>preening</obo:synonym>
        <obo:synonym>self-grooming</obo:synonym>
        <rdfs:label>personal grooming</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000452 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000452">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000065"/>
        <metadata:prefixIRI>NBO:0000452</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T12:50:34Z</obo:creation_date>
        <obo:def>&quot;Behavior related to the state or ability to perceive, to feel, or to be conscious of events, objects or sensory patterns.&quot; [wikipedia:Awareness]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>awareness</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000453 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000453">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000065"/>
        <metadata:prefixIRI>NBO:0000453</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T12:52:15Z</obo:creation_date>
        <obo:is_obsolete>true</obo:is_obsolete>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>behavior related to feelings experiencing</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000455 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000455">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000308"/>
        <metadata:prefixIRI>NBO:0000455</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T01:02:16Z</obo:creation_date>
        <obo:def>&quot;The sustained focus of cognitive resources on information while filtering or ignoring extraneous information.  Intended to encompass only attention to perceptual stimuli. &quot; [wikipedia:Attention]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>attention behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000456 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000456">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000455"/>
        <metadata:prefixIRI>NBO:0000456</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T01:04:04Z</obo:creation_date>
        <obo:def>&quot;Behavior involving responding discretely to specific visual, auditory or tactile stimuli.&quot; [wikipedia:Attention]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>focused attention behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000457 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000457">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000455"/>
        <metadata:prefixIRI>NBO:0000457</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T01:05:54Z</obo:creation_date>
        <obo:def>&quot;Behavior involving maintaining a behavioral or cognitive set in the face of distracting or competing stimuli.&quot; [wikipedia:Attention]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>selective attention behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000458 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000458">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000455"/>
        <metadata:prefixIRI>NBO:0000458</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T01:05:58Z</obo:creation_date>
        <obo:def>&quot;Behavior involving mental flexibility that allows individuals to shift their focus of attention and move between tasks having different cognitive requirements.&quot; [wikipedia:Attention]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>alternating attention behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000459 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000459">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000455"/>
        <metadata:prefixIRI>NBO:0000459</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T01:06:00Z</obo:creation_date>
        <obo:def>&quot;Behavior involving maintaining a consistent behavioral response during continuous and repetitive activity.&quot; [wikipedia:Attention]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>vigilance</obo:synonym>
        <rdfs:label>sustained attention behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000460 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000460">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000455"/>
        <metadata:prefixIRI>NBO:0000460</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T01:08:36Z</obo:creation_date>
        <obo:def>&quot;Behavior involving responding simultaneously to multiple tasks or multiple task demands.&quot; [wikipedia:Attention]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>divided attention behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000461 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000461">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000225"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000746"/>
        <metadata:prefixIRI>NBO:0000461</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T01:15:31Z</obo:creation_date>
        <obo:def>&quot;The perception of familiar objects as approximately the same size regardless of their distance from the observer.&quot; [Jrank:http\://science.jrank.org/pages/5094/Perception.html]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>size constancy behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000462 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000462">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000225"/>
        <metadata:prefixIRI>NBO:0000462</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T01:16:53Z</obo:creation_date>
        <obo:def>&quot;The perception of a color as constant under changing conditions of illumination.&quot; [wikipedia:Color_constancy]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>colour constancy behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000463 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000463">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000225"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000465"/>
        <metadata:prefixIRI>NBO:0000463</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T01:18:00Z</obo:creation_date>
        <obo:def>&quot;The perception of familiar objects as approximately the same shape regardless of their distance or angle of view from the observer.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>shape constancy behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000464 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000464">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000308"/>
        <metadata:prefixIRI>NBO:0000464</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T01:23:16Z</obo:creation_date>
        <obo:def>&quot;Perception relating to the process of inferring the speed and direction of elements in a scene based on visual, vestibular and proprioceptive inputs.&quot; [wikipedia:Motion_perception]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>perception of motion behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000465 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000465">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000308"/>
        <metadata:prefixIRI>NBO:0000465</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T01:25:53Z</obo:creation_date>
        <obo:def>&quot;Perception related to the identification of objects and their distinction from each other.&quot; [:http\://science.jrank.org/pages/5094/Perception.html]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>form perception behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000466 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000466">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000746"/>
        <metadata:prefixIRI>NBO:0000466</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T01:29:05Z</obo:creation_date>
        <obo:def>&quot;Behavior involving an active reception and coordination of information relating to depth received through the sensory systems in order to perceive the three-dimensionality of the world and objects within it.&quot; [:erceiving the three-dimensionality of the world and objects  Read more\: Perception - Perceptual Systems\, Historical Background\, Innate And Learned - Classical perceptual phenomena\, Broad theoretical approaches\, Current research/future developments http\://science.jrank.org/pages/5094/Perception.html#ixzz1It3oOobp]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>depth perception behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000467 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000467">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000746"/>
        <metadata:prefixIRI>NBO:0000467</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T01:31:08Z</obo:creation_date>
        <obo:def>&quot;Perception of the distance of an object.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>distance perception behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000468 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000468">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000308"/>
        <metadata:prefixIRI>NBO:0000468</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T01:32:16Z</obo:creation_date>
        <obo:def>&quot;Misperception of stimuli, where what is perceived does not correspond to the actual dimensions or qualities of the physical stimulus.&quot; [jrank:http\://science.jrank.org/pages/5094/Perception.html]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>perceptual illusion behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000469 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000469">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0007610"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000313"/>
        <metadata:prefixIRI>NBO:0000469</metadata:prefixIRI>
        <obo:comment>It refers to the consequence of the failure of an organism to respond adequately to mental, emotional or physical demands, whether actual or imagined.</obo:comment>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T01:52:36Z</obo:creation_date>
        <obo:def>&quot;Behavior related to how the body reacts to a stressor ( a stimulus that causes stress), real or imagined.&quot; [wikipedia:Stress_(biological)]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>stress related behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000470 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000470">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000469"/>
        <metadata:prefixIRI>NBO:0000470</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T01:55:58Z</obo:creation_date>
        <obo:def>&quot;Behavior related to the identification or realization of a threat or a stressor.&quot; [wikipedia:Stress_(biological)]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>behavioral alarm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000471 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000471">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000088"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000127"/>
        <metadata:prefixIRI>NBO:0000471</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T02:00:36Z</obo:creation_date>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>predator avoidance behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000472 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000472">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000469"/>
        <metadata:prefixIRI>NBO:0000472</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-08T02:06:24Z</obo:creation_date>
        <obo:def>&quot;Behavior related to the depletion of the body resources for coping to stress.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>behavioral exhaustion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000513 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000513">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000368"/>
        <metadata:prefixIRI>NBO:0000513</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-09T10:51:13Z</obo:creation_date>
        <obo:def>&quot;Behavior related to the ascending stairs.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>climbing stairs</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000536 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000536">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000084"/>
        <metadata:prefixIRI>NBO:0000536</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-10T02:18:47Z</obo:creation_date>
        <obo:def>&quot;Any process in which an organism modulates its heart rate at different values with a regularity of approximately 24 hours.&quot; [GOC:rl]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:xref>GO:0003053</obo:xref>
        <rdfs:label>circadian regulation of heart rate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000537 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000537">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000084"/>
        <metadata:prefixIRI>NBO:0000537</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-10T02:21:01Z</obo:creation_date>
        <obo:def>&quot;Any process in which an organism modulates its blood pressure at different values with a regularity of approximately 24 hours.&quot; [GO:GO\:0003052]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>circadian regulation of systemic arterial blood pressure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000538 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000538">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000051"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000084"/>
        <metadata:prefixIRI>NBO:0000538</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-10T02:22:58Z</obo:creation_date>
        <obo:def>&quot;Any homeostatic process in which an organism modulates its internal body temperature at different values with a regularity of approximately 24 hours.&quot; [GOC:dbh]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>circadian thermoregulation</obo:synonym>
        <rdfs:label>circadian temperature homeostasis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000545 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000545">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000079"/>
        <metadata:prefixIRI>NBO:0000545</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-10T10:39:39Z</obo:creation_date>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>swallowing</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000548 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000548">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000034"/>
        <metadata:prefixIRI>NBO:0000548</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-10T10:41:10Z</obo:creation_date>
        <obo:def>&quot;Behaviour related to the male activity which primary purpose is the sexual reproduction.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>male sexual activity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000549 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000549">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000034"/>
        <metadata:prefixIRI>NBO:0000549</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-10T10:41:10Z</obo:creation_date>
        <obo:def>&quot;Behaviour related to the female activity which primary purpose is the sexual reproduction.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>female sexual activity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000550 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000550">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000185"/>
        <metadata:prefixIRI>NBO:0000550</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T01:53:29Z</obo:creation_date>
        <obo:def>&quot;Ability to correctly remember something that has been encountered before.&quot; [wikipedia:Recognition_memory]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>recognition memory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000551 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000551">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000550"/>
        <metadata:prefixIRI>NBO:0000551</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T01:56:14Z</obo:creation_date>
        <obo:def>&quot;Ability to perceive the physical properties of an object (such as shape, colour and texture) and apply semantic attributes to the object, which includes the understanding of its use, previous experience with the object and how it relates to others.&quot; [wikipedia:Cognitive_Neuroscience_of_Visual_Object_Recognition]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>visual object recognition</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000552 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000552">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000551"/>
        <metadata:prefixIRI>NBO:0000552</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T02:02:11Z</obo:creation_date>
        <obo:def>&quot;A visual object recognition that lasts hours to months and critically depends on a transfer of the information from short term object recognition memory using repeated rehearsals.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>long term object recognition memory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000553 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000553">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000554"/>
        <metadata:prefixIRI>NBO:0000553</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T02:03:00Z</obo:creation_date>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>short term object recognition memory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000554 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000554">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000180"/>
        <metadata:prefixIRI>NBO:0000554</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T02:09:28Z</obo:creation_date>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>visual short term memory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000555 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000555">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000180"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000556"/>
        <metadata:prefixIRI>NBO:0000555</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T02:10:17Z</obo:creation_date>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>spatial working memory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000556 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000556">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000306"/>
        <metadata:prefixIRI>NBO:0000556</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T02:14:26Z</obo:creation_date>
        <obo:def>&quot;A type of memory responsible for recording information about one&apos;s environment and its spatial orientation.&quot; [wikipedia:Spatial_memory]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>spatial memory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000557 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000557">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000556"/>
        <metadata:prefixIRI>NBO:0000557</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T02:17:28Z</obo:creation_date>
        <obo:def>&quot;A type of memory that allows one to temporarily store and manage information about one&apos;s environment and its spatial orientation.&quot; [wikipedia:Spatial_memory]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>short term spatial memory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000558 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000558">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000185"/>
        <metadata:prefixIRI>NBO:0000558</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T02:19:43Z</obo:creation_date>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>long term spatial memory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000559 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000559">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000152"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000450"/>
        <metadata:prefixIRI>NBO:0000559</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T07:58:09Z</obo:creation_date>
        <obo:def>&quot;Behavior related to the activity in which a mother cleans or maintains the body or the appearance of her offsprings.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>maternal grooming</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000560 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000560">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000027"/>
        <metadata:prefixIRI>NBO:0000560</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T08:03:48Z</obo:creation_date>
        <obo:def>&quot;Behavior relating to the plucking of fur/hair or whiskers/vibrissae.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>barbering behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000561 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000561">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000560"/>
        <metadata:prefixIRI>NBO:0000561</metadata:prefixIRI>
        <obo:alt_id>NBO:0000083</obo:alt_id>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T08:04:13Z</obo:creation_date>
        <obo:def>&quot;Behavior related to the barbering of other individuals of a cohort.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>whisker trimming</obo:synonym>
        <obo:xref>MP:0001446</obo:xref>
        <rdfs:label>hetero-barbering</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000562 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000562">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000560"/>
        <metadata:prefixIRI>NBO:0000562</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T08:05:32Z</obo:creation_date>
        <obo:def>&quot;Behavior related to the barbering of oneself.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>self-barbering</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000570 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000570">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000020"/>
        <metadata:prefixIRI>NBO:0000570</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T08:39:38Z</obo:creation_date>
        <obo:def>&quot;Movement of the head in the vertical plane.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>head nodding</obo:synonym>
        <rdfs:label>head bobbing</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000571 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000571">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000020"/>
        <metadata:prefixIRI>NBO:0000571</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T08:43:33Z</obo:creation_date>
        <obo:def>&quot;Movement of the head in multiple directions.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>mutlidirectional head movement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000574 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000574">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000411"/>
        <metadata:prefixIRI>NBO:0000574</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T09:20:48Z</obo:creation_date>
        <obo:def>&quot;A reflex allows the eye to follow objects in motion when the head remains stationary.&quot; [wikipedia:Optokinetic_reflex]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>optokinetic reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000575 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000575">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000389"/>
        <metadata:prefixIRI>NBO:0000575</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T10:15:17Z</obo:creation_date>
        <obo:def>&quot;A reflex that elucidates goose bumps (bumps on a person&apos;s skin at the base of body hairs) which may involuntarily develop when a person is cold or experiences strong emotions such as fear, awe, admiration or sexual arousal&quot; [wikipedia:Goose_bumps]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym> piloerection</obo:synonym>
        <obo:synonym>horripilation</obo:synonym>
        <rdfs:label>pilomotor reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000576 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000576">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000389"/>
        <metadata:prefixIRI>NBO:0000576</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T10:19:59Z</obo:creation_date>
        <obo:def>&quot;A reflex that elucidates a characteristic ear twitch in response to an auditory stimulus.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>Preyer&apos;s reflex</obo:synonym>
        <rdfs:label>pinna reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000577 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000577">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000389"/>
        <metadata:prefixIRI>NBO:0000577</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T10:24:14Z</obo:creation_date>
        <obo:def>&quot;A reflex that maintains body position and equilibrium either during rest or during movement.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>postural reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000578 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000578">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000577"/>
        <metadata:prefixIRI>NBO:0000578</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T10:28:56Z</obo:creation_date>
        <obo:def>&quot;A reflex process in which an animal immediately tries to turn over after being placed in a supine position.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>righting response</obo:synonym>
        <rdfs:label>righting reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000580 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000580">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000577"/>
        <metadata:prefixIRI>NBO:0000580</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T10:42:28Z</obo:creation_date>
        <obo:def>&quot;A reflex that elucidates an automatic positioning of the limbs in response to a movement of the head on trunk (neck).&quot; [web:http\://www.dizziness-and-balance.com/anatomy/vspine.htm]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>TNR</obo:synonym>
        <obo:synonym>cervicospinal reflex</obo:synonym>
        <rdfs:label>tonic neck reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000581 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000581">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000577"/>
        <metadata:prefixIRI>NBO:0000581</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T10:44:18Z</obo:creation_date>
        <obo:def>&quot;A reflex which results from activation of afferents from the vestibular organs and uses neck movements to stabilize the head position in space.&quot; [JAX:]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>VCR</obo:synonym>
        <rdfs:label>vestibulocollic reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000582 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000582">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000577"/>
        <metadata:prefixIRI>NBO:0000582</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T10:47:03Z</obo:creation_date>
        <obo:def>&quot;A reflex that originates with vestibular stimulation and control body posture.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>vestibulospinal reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000583 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000583">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000389"/>
        <metadata:prefixIRI>NBO:0000583</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T10:52:19Z</obo:creation_date>
        <obo:def>&quot;Change position in response to stimulation of the whiskers.&quot; [JAX:&lt;new dbxref&gt;]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>vibrissa reflex</obo:synonym>
        <rdfs:label>vibrissae reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000584 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000584">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000389"/>
        <metadata:prefixIRI>NBO:0000584</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T10:55:22Z</obo:creation_date>
        <obo:def>&quot;A mouse reflex that elicidated the clasping of front and/or hind feet almost immediately upon being lifted by tail.&quot; [EUROPHENOME:]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>hindlimb extension reflex</obo:synonym>
        <obo:synonym>limb clasping</obo:synonym>
        <obo:synonym>limb grasping</obo:synonym>
        <rdfs:label>clutching reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000599 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000599">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000556"/>
        <metadata:prefixIRI>NBO:0000599</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T01:43:30Z</obo:creation_date>
        <obo:def>&quot;A type of memory that allows one to store and manage information about one&apos;s environment and its spatial orientation lasting hours to months.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>long-term spatial memory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000600 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000600">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000129"/>
        <metadata:prefixIRI>NBO:0000600</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T03:03:58Z</obo:creation_date>
        <obo:def>&quot;Agitation characterised by a series of unintentional and purposeless motions that stem from mental tension and anxiety of an individual.&quot; [wikipedia:Psychomotor_agitation]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>psychomotor agitation behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000604 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000604">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000011"/>
        <metadata:prefixIRI>NBO:0000604</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T03:33:25Z</obo:creation_date>
        <obo:def>&quot;A social behavior characterised by conscious or unconscious constraint of a behavior that might be considered objectionable in a social setting.&quot; [wikipedia:Social_inhibition]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>social inhibition</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000605 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000605">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000011"/>
        <metadata:prefixIRI>NBO:0000605</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T03:34:29Z</obo:creation_date>
        <obo:def>&quot;A social behavior characterised by conscious or unconscious constraint or curtailment of behavior relating to specific sexual matters or practices.&quot; [wikipedia:Sexual_inhibition]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>sexual inhibition</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000607 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000607">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0007610"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000313"/>
        <metadata:prefixIRI>NBO:0000607</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T03:51:13Z</obo:creation_date>
        <obo:def>&quot;Behaviour related to cognitive processes.&quot; [NBO:JH]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>cognitive behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000608 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000608">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000308"/>
        <metadata:prefixIRI>NBO:0000608</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T03:52:31Z</obo:creation_date>
        <obo:def>&quot;Perception in the absence of a stimulus.&quot; [wikipedia:Hallucination]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:xref>HP:0000738</obo:xref>
        <rdfs:label>hallucination</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000609 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000609">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000608"/>
        <metadata:prefixIRI>NBO:0000609</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T03:54:02Z</obo:creation_date>
        <obo:def>&quot;A form of hallucination that involves perceiving images without visual stimulus.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>paracusia</obo:synonym>
        <obo:xref>HP:0008765</obo:xref>
        <rdfs:label>visual hallucination</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000610 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000610">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000608"/>
        <metadata:prefixIRI>NBO:0000610</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T03:56:24Z</obo:creation_date>
        <obo:def>&quot;A form of hallucination that involves perceiving sounds without auditory stimulus.&quot; [wikipedia:Auditory_hallucination]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:xref>HP:0002367</obo:xref>
        <rdfs:label>auditory hallucination</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000611 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000611">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000608"/>
        <metadata:prefixIRI>NBO:0000611</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T03:58:15Z</obo:creation_date>
        <obo:def>&quot;A form of hallucination that involves perceiving odors without odor stimulus.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>phantosmia </obo:synonym>
        <rdfs:label>olfactory hallucination</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000612 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000612">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000011"/>
        <metadata:prefixIRI>NBO:0000612</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T04:39:42Z</obo:creation_date>
        <obo:def>&quot;A social behavior related to the activity of conveying information.&quot; [wikipedia:Communication]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>communicating</obo:synonym>
        <rdfs:label>communication behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000613 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000613">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000612"/>
        <metadata:prefixIRI>NBO:0000613</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T04:40:59Z</obo:creation_date>
        <obo:def>&quot;Communication behavior related to the process of conveying meaning in the form of non-word messages through for example gesture, body language or posture; facial expression and eye contact etc.&quot; [wikipedia:.wikipedia.org/wiki/Nonverbal_communication]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>non-verbal communication behaviour</obo:synonym>
        <obo:synonym>nonverbal communication behaviour</obo:synonym>
        <rdfs:label>nonverbal communication behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000614 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000614">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000612"/>
        <metadata:prefixIRI>NBO:0000614</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T04:42:57Z</obo:creation_date>
        <obo:def>&quot;Communication behavior related to the conveyance of ideas and information through creation of visual representations.&quot; [wikipedia:Visual_communication]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>visual communication behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000615 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000615">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000612"/>
        <metadata:prefixIRI>NBO:0000615</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T04:44:04Z</obo:creation_date>
        <obo:def>&quot;Communication behavior related to the process of conveying meaning in the form of word messages.&quot; [wikipedia:Oral_communication#Oral_communication]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>oral communication behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000616 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000616">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000613"/>
        <metadata:prefixIRI>NBO:0000616</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T04:46:09Z</obo:creation_date>
        <obo:def>&quot;A nonverbal communication behavior that is characterised by the meeting the eyes between two individuals.&quot; [wikipedia:Eye_contact]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>eye contact</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000617 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000617">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000003"/>
        <metadata:prefixIRI>NBO:0000617</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T04:51:05Z</obo:creation_date>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>laughing behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000618 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000618">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000003"/>
        <metadata:prefixIRI>NBO:0000618</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T04:52:56Z</obo:creation_date>
        <obo:def>&quot;The behavior in which an organism sheds tears, often accompanied by non-verbal vocalizations and in response to external or internal stimuli.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>crying behaviour</obo:synonym>
        <obo:xref>GO:0060273</obo:xref>
        <rdfs:label>crying behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000619 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000619">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000293"/>
        <metadata:prefixIRI>NBO:0000619</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T04:57:19Z</obo:creation_date>
        <obo:def>&quot;Behavior stemming from understanding of a specific cause and effect in a specific context.&quot; [wikipedia:Insight]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>behavior stemming from insight</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000620 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000620">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000003"/>
        <metadata:prefixIRI>NBO:0000620</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-14T05:00:59Z</obo:creation_date>
        <obo:def>&quot;An emotional behavior that arises from the perceived resistance to the fulfillment of individual will.&quot; [wikipedia:Frustration]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>frustration behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000624 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000624">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000075"/>
        <metadata:prefixIRI>NBO:0000624</metadata:prefixIRI>
        <obo:comment>Object play is important in developing skills important in adulthood, especially hunting.</obo:comment>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-19T10:51:54Z</obo:creation_date>
        <obo:def>&quot;Play behavior associated with the manipulation of objects.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>object play</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000626 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000626">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000049"/>
        <metadata:prefixIRI>NBO:0000626</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-19T10:52:50Z</obo:creation_date>
        <obo:def>&quot;Behavior associated with interactions which resemble sexual behavior but do not lead to copulation.&quot; [web:http\://www.bio.davidson.edu/people/vecase/behavior/Spring2009/Sacco/Pages/Sex%20Play.html]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>love play</obo:synonym>
        <rdfs:label>sexual play</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000627 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000627">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000049"/>
        <metadata:prefixIRI>NBO:0000627</metadata:prefixIRI>
        <obo:comment>Play fighting helps learning to evaluate oneself and an opponent. This skill is crucial for serious adult situations. Being able to size up an opponent quickly is very important in knowing when to give up or fight for a resource (food, mate, territory, etc. ). Play fighting is one of the most important categories of play because it prepares animals for actual fighting.</obo:comment>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-19T10:53:55Z</obo:creation_date>
        <obo:def>&quot;Play behavior associated to fighting simulation, although fighting is much slower and gentler with no intention of actual hurt.&quot; [web:http\://www.bio.davidson.edu/people/vecase/behavior/Spring2009/Sacco/Pages/Play%20Fighting.html]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>play fight</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000628 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000628">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000049"/>
        <metadata:prefixIRI>NBO:0000628</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-19T10:54:09Z</obo:creation_date>
        <obo:def>&quot;Play behavior that is associated with the pursuit of an individual.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>play chasing</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000629 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000629">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000049"/>
        <metadata:prefixIRI>NBO:0000629</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-19T11:03:02Z</obo:creation_date>
        <obo:def>&quot;Play behavior associated with the exhibition of parenting behavior by non-parents.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>nursing play</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000630 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000630">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000075"/>
        <metadata:prefixIRI>NBO:0000630</metadata:prefixIRI>
        <obo:comment>Imitative play is an excellent means of learning how to perform a task that an adult has perfected. Therefore, imitative play is one of the best ways for animals to learn from the adults in the group.</obo:comment>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-19T11:07:20Z</obo:creation_date>
        <obo:def>&quot;Play behavior related to the copying the actions of another.&quot; [web:http\://www.bio.davidson.edu/people/vecase/behavior/Spring2009/Sacco/Pages/Imitative%20Play.html]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>imitative play</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000631 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000631">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000087"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000741"/>
        <metadata:prefixIRI>NBO:0000631</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-19T01:44:21Z</obo:creation_date>
        <obo:def>&quot;An aggressive behavior which elucidated when individuals of a certain species mob a predator by cooperatively attacking or harassing it, usually to protect their offspring.&quot; [wikipedia:Mobbing_(animal_behavior)]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>mobbing behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000632 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000632">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000631"/>
        <metadata:prefixIRI>NBO:0000632</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-19T01:46:33Z</obo:creation_date>
        <obo:def>&quot;Behavior associated with signals made by the mobbing species while harassing a predator.&quot; [wikipedia:Mobbing_(animal_behavior)]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>mobbing calling</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000633 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000633">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000105"/>
        <metadata:prefixIRI>NBO:0000633</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-19T02:02:11Z</obo:creation_date>
        <obo:def>&quot;Aggressive behavior related to the defence of a fixed area against intruders, typically conspecifics.&quot; [GOC:hjd]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>territorial aggression</obo:synonym>
        <obo:synonym>territorial aggressive behaviour</obo:synonym>
        <obo:xref>GO:0002124</obo:xref>
        <rdfs:label>territorial aggressive behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000634 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000634">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000741"/>
