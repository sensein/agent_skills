    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0070998 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0070998">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0007600"/>
        <obo:IAO_0000115>The series of events required for an organism to receive a gravitational stimulus, convert it to a molecular signal, and recognize and characterize the signal. This is a neurological process.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/go.owl"/>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <rdfs:label>sensory perception of gravity</rdfs:label>
        <skos:notation>GO:0070998</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0071063 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0071063">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0050954"/>
        <obo:IAO_0000115>The series of events required for an organism to receive sensory mechanical stimulus resulting from air flow, convert it to a molecular signal, and recognize and characterize the signal.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/go.owl"/>
        <oboInOwl:hasExactSynonym>perception of wind</oboInOwl:hasExactSynonym>
