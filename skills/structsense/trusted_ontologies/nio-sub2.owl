        <obo:IAO_0000234>NCI BBRB</obo:IAO_0000234>
        <rdfs:label>Stage IB (FIGO)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0002331 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/OBI_0002331">
        <obo:IAO_0000111>Stage IB1 (FIGO)</obo:IAO_0000111>
