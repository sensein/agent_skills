        <obo:IAO_0000117 xml:lang="en">Alba G.-Valadés Batanero</obo:IAO_0000117>
        <NDDUO:Synonym xml:lang="en">Peaks loops</NDDUO:Synonym>
        <NDDUO:Synonym xml:lang="en">Peaks plateau loops</NDDUO:Synonym>
        <NDDUO:Synonym xml:lang="en">Peaks-plateau loops</NDDUO:Synonym>
        <rdfs:comment xml:lang="en">Sum of the scores obtained in both copying tests peak-plateau and loops.</rdfs:comment>
