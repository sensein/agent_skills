    <!-- http://purl.obolibrary.org/obo/NPT_0011029 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NPT_0011029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NPT_0011016"/>
        <obo:IAO_0000115>A cognitive functioning assay design that attempts to generate a Folstein mini mental examination cognitive functioning numerical measurement datum that can be used in conjunction with other data to classify individuals on the basis of their level of cognitive functioning by means of the results of a cognitive task in which the evaluant&apos;s ability to recall a list of three short words immediately after they are said out loud by the evaluator is tested.

*** REVIEW ***</obo:IAO_0000115>
        <obo:IAO_0000117>Alexander P. Cox</obo:IAO_0000117>
        <rdfs:label>MMSE immediate recall assay design</rdfs:label>
