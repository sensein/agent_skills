        <metadata:prefixIRI>MF:0000051</metadata:prefixIRI>
        <rdfs:label xml:lang="en">capability to understand language</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MF_0000052 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MF_0000052">
