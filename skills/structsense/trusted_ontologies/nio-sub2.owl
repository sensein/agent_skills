        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>limb posture</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000358 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000358">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000355"/>
        <metadata:prefixIRI>NBO:0000358</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-06T09:31:29Z</obo:creation_date>
