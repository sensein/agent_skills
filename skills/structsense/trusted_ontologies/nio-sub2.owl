        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-03-31T03:24:52Z</obo:creation_date>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>circadian phase</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000170 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000170">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000006"/>
        <metadata:prefixIRI>NBO:0000170</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-01T01:49:03Z</obo:creation_date>
        <obo:def>&quot;Behavior related with the ability of an organism&apos;s ability to store, retain, and recall information and experiences.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>memory behaviour</obo:synonym>
        <obo:xref>GO:0007613</obo:xref>
        <rdfs:label>memory behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000171 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000171">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000022"/>
        <metadata:prefixIRI>NBO:0000171</metadata:prefixIRI>
        <obo:comment>The formation of associations among stimuli and responses.</obo:comment>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-01T01:49:32Z</obo:creation_date>
        <obo:def>&quot;Learning by associating a stimulus (the cause) with a particular outcome (the effect).&quot; [Wikipedia:Learning#Associative_learning]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>conditional learning</obo:synonym>
        <obo:xref>GO:0008306</obo:xref>
        <rdfs:label>associative learning behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000172 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000172">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000641"/>
        <metadata:prefixIRI>NBO:0000172</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-01T01:54:09Z</obo:creation_date>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:xref>GO:0008355</obo:xref>
        <rdfs:label>olfactory learning behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000173 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000173">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000641"/>
        <metadata:prefixIRI>NBO:0000173</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-01T01:54:15Z</obo:creation_date>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:xref>GO:0008542</obo:xref>
        <rdfs:label>visual learning behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000174 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000174">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000171"/>
        <metadata:prefixIRI>NBO:0000174</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-01T01:56:08Z</obo:creation_date>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>motor learning</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000175 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000175">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000171"/>
        <metadata:prefixIRI>NBO:0000175</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-01T01:57:20Z</obo:creation_date>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>spatial learning</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000176 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000176">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000171"/>
        <metadata:prefixIRI>NBO:0000176</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-01T01:58:41Z</obo:creation_date>
        <obo:def>&quot;A behavioral process whose outcome is a relatively long-lasting adaptive behavioral change whereby an organism modifies innate vocalizations to imitate or create new sounds.&quot; [GO:0042297]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:xref>GO:0042297</obo:xref>
        <rdfs:label>vocal learning</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000177 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000177">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000022"/>
        <metadata:prefixIRI>NBO:0000177</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-01T03:18:40Z</obo:creation_date>
        <obo:def>&quot;A decrease in a behavioral response to a repeated stimulus.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>nonassociative learning</obo:synonym>
        <obo:synonym>unconditional response</obo:synonym>
        <obo:xref>GO:0046958</obo:xref>
        <rdfs:label>non-associative learning</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000178 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000178">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000177"/>
        <metadata:prefixIRI>NBO:0000178</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-01T03:19:06Z</obo:creation_date>
        <obo:def>&quot;Gradual decrease in behavioral responses with repeated encounters of a particular stimulus, which proves of no consequence.&quot; [wikipedia:Habituation]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:xref>GO:0046959</obo:xref>
        <rdfs:label>habituation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000179 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000179">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000177"/>
        <metadata:prefixIRI>NBO:0000179</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-01T03:54:55Z</obo:creation_date>
        <obo:def>&quot;An increase in behavioral responses following repeated applications of a particular stimulus.&quot; [wikipedia:Sensitization]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>sensitization</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000180 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000180">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000306"/>
        <metadata:prefixIRI>NBO:0000180</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-01T03:59:07Z</obo:creation_date>
        <obo:def>&quot;A type of memory that allows the recall of something from several seconds to as long as a minute.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:xref>GO:0007614</obo:xref>
        <rdfs:label>short-term memory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000181 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000181">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000306"/>
        <metadata:prefixIRI>NBO:0000181</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-01T03:59:10Z</obo:creation_date>
        <obo:def>&quot;This type of memory, lasting hours to months, critically depends on a transfer of the information from short term memory using repeated rehearsal.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:xref>GO:0007616</obo:xref>
        <rdfs:label>long-term memory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000182 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000182">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000306"/>
        <metadata:prefixIRI>NBO:0000182</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-01T03:59:19Z</obo:creation_date>
        <obo:def>&quot;Report great detail about a complex stimulus immediately following its presentation. This ability forms within a few tens of milliseconds and decays again rapidly within a few hundred milliseconds.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>sensory memory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000183 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000183">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000306"/>
        <metadata:prefixIRI>NBO:0000183</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-01T04:00:48Z</obo:creation_date>
        <obo:def>&quot;A memory that last for months to lifetime.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>long-lasting memory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000184 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000184">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000306"/>
        <metadata:prefixIRI>NBO:0000184</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-01T04:01:02Z</obo:creation_date>
        <obo:def>&quot;A type of memory that allows the recall of something from minutes to several hours.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:xref>GO:0072375</obo:xref>
        <rdfs:label>medium term memory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000185 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000185">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000181"/>
        <metadata:prefixIRI>NBO:0000185</metadata:prefixIRI>
        <obo:comment>Encoded by the hippocampus, entorhinal cortex, and perirhinal cortex but store possibly in the medial temporal lobe.</obo:comment>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-02T07:38:45Z</obo:creation_date>
        <obo:def>&quot;Ability to become conscious of, or declare, facts and experiences.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>explicit memory</obo:synonym>
        <rdfs:label>declarative memory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000186 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000186">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000185"/>
        <metadata:prefixIRI>NBO:0000186</metadata:prefixIRI>
        <obo:comment>Medial temporal lobe, diencephalon.</obo:comment>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-02T07:40:26Z</obo:creation_date>
        <obo:def>&quot;Ability to consciously recall knowledge of facts that are independent of a specific time and place.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>semantic memory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000187 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000187">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000185"/>
        <metadata:prefixIRI>NBO:0000187</metadata:prefixIRI>
        <obo:comment>Medial temporal lobe, diencephalon.</obo:comment>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-02T07:41:30Z</obo:creation_date>
        <obo:def>&quot;Ability to explicitly recall information about a specific event that has occurred at a specific time and place.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>episodic memory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000188 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000188">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000181"/>
        <metadata:prefixIRI>NBO:0000188</metadata:prefixIRI>
        <obo:alt_id>NBO:0000189</obo:alt_id>
        <obo:comment>Encoded and probably stored by the cerebellum and the striatum but store in the amygdala.</obo:comment>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-02T07:42:37Z</obo:creation_date>
        <obo:def>&quot;Non-declarative memory type of memory, which does not need to involve conscious awareness in the act of recollection.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>implicit memory</obo:synonym>
        <obo:synonym>procedural memory</obo:synonym>
        <rdfs:label>non-declarative memory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000190 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000190">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000188"/>
        <metadata:prefixIRI>NBO:0000190</metadata:prefixIRI>
        <obo:comment>Depends on the cerebellum and basal ganglia.</obo:comment>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-02T07:54:40Z</obo:creation_date>
        <obo:def>&quot;Consolidating a specific motor task into memory through repetition.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>muscle memory</obo:synonym>
        <rdfs:label>motor memory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000191 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000191">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000181"/>
        <metadata:prefixIRI>NBO:0000191</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-02T07:59:16Z</obo:creation_date>
        <obo:def>&quot;A type of memory associated with emotional experiences.&quot; [wikipedia:http\://www.scholarpedia.org/article/Emotional_memory]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>emotional memory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000192 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000192">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000185"/>
        <metadata:prefixIRI>NBO:0000192</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-02T08:16:36Z</obo:creation_date>
        <obo:def>&quot;Remembering to perform an intended action.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>prospective memory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000193 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000193">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000192"/>
        <metadata:prefixIRI>NBO:0000193</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-02T08:19:20Z</obo:creation_date>
        <obo:def>&quot;Remembering to perform an intended action in respect to a particular event.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>event-based prospective memory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000194 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000194">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000192"/>
        <metadata:prefixIRI>NBO:0000194</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-02T08:19:37Z</obo:creation_date>
        <obo:def>&quot;Remembering to perform an intended action in respect to a particular time reference.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>time-based prospective memory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000195 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000195">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000187"/>
        <metadata:prefixIRI>NBO:0000195</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-02T08:27:14Z</obo:creation_date>
        <obo:def>&quot;A type of memory for particular events within one&apos;s own life.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>autobiographical memory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000196 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000196">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000185"/>
        <metadata:prefixIRI>NBO:0000196</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-02T08:33:27Z</obo:creation_date>
        <obo:def>&quot;Ability to store and retrieve previously experienced visual sensations and perceptions when the stimuli that originally evoked them are no longer present.&quot; [wikipedia:Visual_memory]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>visual memory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000197 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000197">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000182"/>
        <metadata:prefixIRI>NBO:0000197</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-02T08:37:43Z</obo:creation_date>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>iconic memory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000198 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000198">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000182"/>
        <metadata:prefixIRI>NBO:0000198</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-02T08:39:24Z</obo:creation_date>
        <obo:def>&quot;The ability to recall images, sounds, or objects in memory with extreme precision and in abundant volume.&quot; [wikipedia:Eidetic_memory]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>photographic memory</obo:synonym>
        <rdfs:label>eidetic memory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000199 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000199">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000185"/>
        <metadata:prefixIRI>NBO:0000199</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-02T08:42:17Z</obo:creation_date>
        <obo:def>&quot;Ability to orient oneself in space, to recognize and follow an itinerary, or to recognize familiar places.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>topographic memory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000200 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000200">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000307"/>
        <metadata:prefixIRI>NBO:0000200</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-02T08:50:59Z</obo:creation_date>
        <obo:def>&quot;An implicit memory effect in which exposure to a stimulus influences response to a later stimulus.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>priming</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000201 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000201">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000200"/>
        <metadata:prefixIRI>NBO:0000201</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-02T08:55:04Z</obo:creation_date>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>repetition</obo:synonym>
        <rdfs:label>direct priming</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000202 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000202">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000200"/>
        <metadata:prefixIRI>NBO:0000202</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-02T08:56:35Z</obo:creation_date>
        <obo:def>&quot;A type of priming where the prime and the target are from the same semantic category and share features.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>semantic priming</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000203 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000203">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000200"/>
        <metadata:prefixIRI>NBO:0000203</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-02T08:57:44Z</obo:creation_date>
        <obo:def>&quot;A type of priming where the target is a word that has a high probability of appearing with the prime, and is \&quot;associated\&quot; with it but not necessarily related in semantic features.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>associative priming</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000204 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000204">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000200"/>
        <metadata:prefixIRI>NBO:0000204</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-02T08:58:44Z</obo:creation_date>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>response priming</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000205 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000205">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000200"/>
        <metadata:prefixIRI>NBO:0000205</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-02T08:59:42Z</obo:creation_date>
        <obo:def>&quot;A type of priming based on the meaning of a stimulus and is enhanced by semantic task.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>conceptual priming</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000206 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000206">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000200"/>
        <metadata:prefixIRI>NBO:0000206</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-02T09:00:27Z</obo:creation_date>
        <obo:def>&quot;A type priming based on the form of the stimulus and is enhanced by the match between the early and later stimuli.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>perceptual priming</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000207 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000207">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000178"/>
        <metadata:prefixIRI>NBO:0000207</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-02T09:07:54Z</obo:creation_date>
        <obo:def>&quot;Change in the responsiveness of a sensory system when confronted with a constant stimulus.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>sensory adaptation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000208 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000208">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000171"/>
        <metadata:prefixIRI>NBO:0000208</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-03T08:57:28Z</obo:creation_date>
        <obo:def>&quot;A form of associative learning that requires an unconditional reflex, where an unconditional stimulus (US)brings about an automatic, unlearned (unconditional) response (UR). If a neutral stimulus (NS) tends to precede it, an association is made and the conditional response (CR) becomes transferred onto the (previously neutral) conditional strimulus (CS); a conditional reflex has been learned.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>Pavlovian conditioning</obo:synonym>
        <obo:synonym>respondent conditioning</obo:synonym>
        <rdfs:label>classical conditioning</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000209 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000209">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000778"/>
        <metadata:prefixIRI>NBO:0000209</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-03T08:58:27Z</obo:creation_date>
        <obo:def>&quot;A type of associative learning that allows organisms to acquire affective responses, such as fear, in situations where a particular context or stimulus is predictably elicits fear via an aversive context.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>fear conditioning</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000210 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000210">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000171"/>
        <metadata:prefixIRI>NBO:0000210</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-03T09:01:08Z</obo:creation_date>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>avoidance learning behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000211 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000211">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000208"/>
        <metadata:prefixIRI>NBO:0000211</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-03T09:04:57Z</obo:creation_date>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>Garcia conditioning</obo:synonym>
        <obo:xref>GO:0001661</obo:xref>
        <rdfs:label>conditioned taste aversion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000212 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000212">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000171"/>
        <metadata:prefixIRI>NBO:0000212</metadata:prefixIRI>
        <obo:comment>Operant conditioning is distinguished from classical conditioning in that operant conditioning deals with the modification of &quot;voluntary behavior&quot; or operant behavior.</obo:comment>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-03T09:05:54Z</obo:creation_date>
        <obo:def>&quot;Operant conditioning is the use of a behavior&apos;s antecedent and/or its consequence to influence the occurrence and form of behavior.&quot; [wikipedia:Operant_conditioning]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>instrumental conditioning</obo:synonym>
        <obo:synonym>instrumental learning</obo:synonym>
        <obo:xref>GO:0035106</obo:xref>
        <rdfs:label>operant conditioning behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000213 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000213">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000171"/>
        <metadata:prefixIRI>NBO:0000213</metadata:prefixIRI>
