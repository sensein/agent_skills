        <skos:notation>GO:0097270</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000001">
