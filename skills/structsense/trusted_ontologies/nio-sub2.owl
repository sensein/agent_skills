        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>chemically-elicited antinociception behaviour</obo:synonym>
        <rdfs:label>chemically-elicited antinociceptive behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000337 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000337">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000330"/>
        <metadata:prefixIRI>NBO:0000337</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-05T02:06:22Z</obo:creation_date>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>pressure related behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000338 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000338">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0007610"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000313"/>
        <metadata:prefixIRI>NBO:0000338</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-05T02:08:47Z</obo:creation_date>
        <obo:def>&quot;Behavior related to the movement of the body&apos;s muscles, tendons, and joints.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>kinesthetic behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000339 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000339">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000317"/>
        <metadata:prefixIRI>NBO:0000339</metadata:prefixIRI>
        <obo:alt_id>NBO:0000340</obo:alt_id>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-05T03:32:44Z</obo:creation_date>
        <obo:def>&quot;The coordination of combinations of body movements created with the kinematic (such as spatial direction) and kinetic (force) parameters that result in intended actions.&quot; [wikipedia:Motor_coordination]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>motor coordination</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000341 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000341">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000348"/>
        <metadata:prefixIRI>NBO:0000341</metadata:prefixIRI>
        <obo:comment>Optic apraxia - total inability of a person to coordinate eye and hand movements.\nOptic ataxia - inability of a person to coordinate eye and hand movements.</obo:comment>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-05T03:43:28Z</obo:creation_date>
        <obo:def>&quot;The coordinated control of eye movement with hand movement, and the processing of visual input to guide reaching and grasping along with the use of proprioception of the hands to guide the eyes.&quot; [wikipedia:Eye%E2%80%93hand_coordination]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>hand eye coordination</obo:synonym>
        <rdfs:label>eye-hand coordination</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000342 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000342">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000347"/>
        <metadata:prefixIRI>NBO:0000342</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-05T03:49:12Z</obo:creation_date>
        <obo:def>&quot;The coordination of limb movement.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>limb coordination</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000343 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000343">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000346"/>
        <metadata:prefixIRI>NBO:0000343</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-05T03:57:56Z</obo:creation_date>
        <obo:def>&quot;Coordination that results in spatial and temporal planning of reaching and grasping.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>intra-limb coordination</obo:synonym>
        <rdfs:label>intralimb coordination</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000344 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000344">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000346"/>
        <metadata:prefixIRI>NBO:0000344</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-05T03:58:29Z</obo:creation_date>
        <obo:def>&quot;Coordination that results in bimanual synchronization and temporal association of the hands.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>inter-limb coordination</obo:synonym>
        <rdfs:label>interlimb coordination</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000345 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000345">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000342"/>
        <metadata:prefixIRI>NBO:0000345</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-05T04:05:31Z</obo:creation_date>
        <obo:def>&quot;The coordination of lower limb movement.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>lower limb coordination</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000346 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000346">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000342"/>
        <metadata:prefixIRI>NBO:0000346</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-05T04:05:44Z</obo:creation_date>
        <obo:def>&quot;The coordination of upper limb movement.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>upper limb coordination</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000347 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000347">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000339"/>
        <metadata:prefixIRI>NBO:0000347</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-05T04:10:52Z</obo:creation_date>
        <obo:def>&quot;The coordination of large muscle groups and whole body movement.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>large muscle coordination</obo:synonym>
        <obo:synonym>whole body coordination</obo:synonym>
        <rdfs:label>gross motor coordination</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000348 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000348">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000339"/>
        <metadata:prefixIRI>NBO:0000348</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-05T04:14:38Z</obo:creation_date>
        <obo:def>&quot;Coordination of small muscle movements which occur usually in coordination with the eye.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>fine motor coordination</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000349 -->

