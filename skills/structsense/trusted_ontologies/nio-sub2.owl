        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_67165"/>
        <obo:IAO_0000115>Material anatomical entity which is generated by coordinated expression of the organism&apos;s own genes that guide its morphogenesis; has inherent 3D shape; its parts are connected and spatially related to one another in patterns determined by coordinated gene expression. Examples: heart, right ventricle, mitral valve, myocardium, endothelium, lymphocyte, fibroblast, thorax, cardiovascular system, hemoglobin, T cell receptor.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Biological structure</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fma</oboInOwl:hasOBONamespace>
        <rdfs:label>Anatomical structure</rdfs:label>
    </owl:Class>
    


