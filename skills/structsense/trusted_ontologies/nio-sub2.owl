    <!-- http://purl.obolibrary.org/obo/UO_0000195 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/UO_0000195">
        <obo:IAO_0000111>degree Fahrenheit</obo:IAO_0000111>
        <obo:IAO_0000115>A temperature unit which is equal to 5/9ths of a kelvin. Negative 40 degrees Fahrenheit is equal to negative 40 degrees Celsius.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:label>degree Fahrenheit</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000196 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/UO_0000196">
        <obo:IAO_0000111>pH</obo:IAO_0000111>
        <obo:IAO_0000115>A dimensionless concentration notation which denotes the acidity of a solution in terms of activity of hydrogen ions (H+).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:label>pH</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000207 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/UO_0000207">
        <obo:IAO_0000111>milliliter per liter</obo:IAO_0000111>
        <obo:IAO_0000115>A volume per unit volume unit which is equal to one millionth of a liter of solute in one liter of solution.</obo:IAO_0000115>
        <obo:IAO_0000118>ml per L</obo:IAO_0000118>
        <obo:IAO_0000118>ml/l</obo:IAO_0000118>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
