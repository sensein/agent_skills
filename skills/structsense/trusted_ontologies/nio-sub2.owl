        <obo:IAO_0000118>Folstein test</obo:IAO_0000118>
        <obo:IAO_0000118>MMSE</obo:IAO_0000118>
        <obo:IAO_0000118>MMSE assay</obo:IAO_0000118>
        <obo:IAO_0000118>mini mental state exam</obo:IAO_0000118>
        <obo:IAO_0000118>mini mental state examination</obo:IAO_0000118>
        <obo:IAO_0000118>mini-mental state exam</obo:IAO_0000118>
        <obo:IAO_0000118>mini-mental state examination</obo:IAO_0000118>
