        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0002234"/>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:def>&quot;A regulation of consumption of an addictive sustance behavior process associated with the preference over the type of addictive sustance that is consumed. &quot; [NBO:GVG]</obo:def>
        <rdfs:label xml:lang="en">regulation of addictive substance consumption preference</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/behavior.owl/NBO_0002916 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/behavior.owl/NBO_0002916">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/behavior.owl/NBO_0002869"/>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:def>&quot;A regulation of consumption of an addictive sustance behavior process associated with the preference over cocaine consumption. &quot; [NBO:GVG]</obo:def>
        <rdfs:label xml:lang="en">regulation of cocaine consumption preference</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/behavior.owl/NBO_0002948 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/behavior.owl/NBO_0002948">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/behavior.owl/NBO_0002603"/>
        <obo:def>&quot;A regulation of sexual activity process associated with the preference over a males or females.&quot; [NBO:GVG]</obo:def>
        <rdfs:label xml:lang="en">regulation of mating preference</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/behavior.owl/NBO_0002950 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/behavior.owl/NBO_0002950">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000416"/>
        <obo:def>A vestibular reflex by which a response to an angular acceleration stimulus begins with an afferent nerve impulse from a receptor in the semi-circular canal and ends with the compensatory action of eye muscles. Signaling never reaches a level of consciousness. [GOC:dph]</obo:def>
        <obo:xref>GO:0060006 </obo:xref>
        <rdfs:label xml:lang="en">angular vestibuloocular reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/behavior.owl/NBO_0002952 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/behavior.owl/NBO_0002952">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000416"/>
        <obo:def>A vestibular reflex by which a response to a linear acceleration stimulus begins with an afferent nerve impulse from a receptor in the otolith and ends with the compensatory action of eye muscles. [GOC:dph]</obo:def>
        <obo:xref>GO:0060007</obo:xref>
        <rdfs:label xml:lang="en">linear vestibuloocular reflex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/behavior.owl/NBO_0002986 -->

