    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/UO_0000165">
        <obo:IAO_0000111>volume percentage</obo:IAO_0000111>
        <obo:IAO_0000115>A dimensionless concentration unit which denotes the volume of the solute in mL per 100 mL of the resulting solution.</obo:IAO_0000115>
        <obo:IAO_0000118>% v/v</obo:IAO_0000118>
        <obo:IAO_0000118>percent vol per vol</obo:IAO_0000118>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:label>volume percentage</rdfs:label>
    </owl:NamedIndividual>
    


