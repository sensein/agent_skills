        <obo:IAO_0000115>An assay objective to measure one or more mental functions of the evaluant.</obo:IAO_0000115>
        <obo:IAO_0000117>Alexander P. Cox</obo:IAO_0000117>
        <rdfs:label>mental function measurement objective</rdfs:label>
    </owl:Class>
    


