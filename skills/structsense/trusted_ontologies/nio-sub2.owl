    <!-- http://www.semanticweb.org/alba/ontologies/2020/10/NIO#Mini_examen_cognoscitivo -->

    <owl:Class rdf:about="http://www.semanticweb.org/alba/ontologies/2020/10/NIO#Mini_examen_cognoscitivo">
        <rdfs:subClassOf rdf:resource="http://scai.fraunhofer.de/AlzheimerOntology#Cognitive_Tests"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/alba/ontologies/2020/10/NIO#evaluate"/>
                <owl:someValuesFrom rdf:resource="http://scai.fraunhofer.de/NDDUO#Stages"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000117>Alba G.-Valadés Batanero</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">Spanish version of the MMSE, with equivalent tests, and a total score of 35.
Like in MMSE, the cut score are 23-24 in geriatric patients, and 27-28 in non-geriatric patients.</rdfs:comment>
        <rdfs:label>Mini-examen cognoscitivo</rdfs:label>
    </owl:Class>
    


