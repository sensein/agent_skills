        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-04T09:19:33Z</obo:creation_date>
        <obo:def>&quot;A helping behavior (without expectation of extrinsic rewards and sometimes involving personal risk or sacrifice) that benefits individuals or society.&quot; [NBO:GVG]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>altruism behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000286 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000286">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000011"/>
        <metadata:prefixIRI>NBO:0000286</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-04T09:22:04Z</obo:creation_date>
        <obo:def>&quot;Prosocial behavior is caring about the welfare and rights of others, feeling concern and empathy for them, and acting in ways that benefit others.&quot; [wikipedia:Prosocial_behavior]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>prosocial behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000287 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000287">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000286"/>
        <metadata:prefixIRI>NBO:0000287</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-04T09:23:26Z</obo:creation_date>
        <obo:def>&quot;Helping behavior refers to voluntary actions intended to help the others, with reward regarded or disregarded.&quot; [wikipedia:Helping_behavior]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>helping behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000288 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000288">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000286"/>
        <metadata:prefixIRI>NBO:0000288</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-04T09:25:04Z</obo:creation_date>
        <obo:def>&quot;Reciprocal altruism is the idea that the incentive for an individual to help in the present is based on the expectation of the potential receipt in the future.&quot; [wikipedia:Helping_behavior]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>reciprocal altruism</rdfs:label>
    </owl:Class>
    


