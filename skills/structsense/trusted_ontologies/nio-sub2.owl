        <dc:creator xml:lang="en">Alba Gómez-Valadés Batanero</dc:creator>
        <dc:title xml:lang="en">Neuropsychological Integrative Ontology</dc:title>
        <dc:title>Ontology for describing data on neurodegenerative diseases in patients</dc:title>
        <dc:type>Ontology</dc:type>
        <rdfs:label xml:lang="en">Alzheimer Ontology</rdfs:label>
        <owl:versionInfo xml:lang="en">v.1.1</owl:versionInfo>
    </owl:Ontology>
    


