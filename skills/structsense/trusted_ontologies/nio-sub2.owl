    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/UO_0000208">
        <obo:IAO_0000111>gram per deciliter</obo:IAO_0000111>
        <obo:IAO_0000115>A mass density unit which is equal to mass of an object in grams divided by the volume in deciliters.</obo:IAO_0000115>
        <obo:IAO_0000118>g/dl</obo:IAO_0000118>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
