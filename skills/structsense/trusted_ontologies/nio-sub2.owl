    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000052">
        <ace_lexicon:TV_pl>BFO_0000052</ace_lexicon:TV_pl>
        <ace_lexicon:TV_sg>BFO_0000052s</ace_lexicon:TV_sg>
