    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/UO_0000175">
        <obo:IAO_0000111>gram per liter</obo:IAO_0000111>
        <obo:IAO_0000115>A mass unit density which is equal to mass of an object in grams divided by the volume in liters.</obo:IAO_0000115>
        <obo:IAO_0000118>g per L</obo:IAO_0000118>
        <obo:IAO_0000118>g/L</obo:IAO_0000118>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:label>gram per liter</rdfs:label>
    </owl:NamedIndividual>
    


