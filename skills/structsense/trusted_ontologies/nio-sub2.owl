        <obo:namespace>behavior_ontology</obo:namespace>
        <obo:synonym>courtship behaviour</obo:synonym>
        <obo:xref>GO:0007619</obo:xref>
        <rdfs:label>courtship behavior</rdfs:label>
    </owl:Class>
    


