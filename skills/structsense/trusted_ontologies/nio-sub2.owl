                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NPT_0015003"/>
                        </owl:oneOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A categorical measurement datum used to record the results of a cognitive functioning examination as either normal cognitive functioning, mildly impaired cognitive functioning, moderately impaired cognitive functioning, or severely impaired cognitive functioning.</obo:IAO_0000115>
        <obo:IAO_0000117>Alexander P. Cox</obo:IAO_0000117>
        <rdfs:label>level of cognitive functioning categorical measurement datum</rdfs:label>
    </owl:Class>
    


