        <obo:IAO_0000111>mass unit</obo:IAO_0000111>
        <obo:IAO_0000115>A unit which is a standard measure of the amount of matter/energy of a physical object.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:label>mass unit</rdfs:label>
    </owl:Class>
    


