        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>irritable aggressive behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000635 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000635">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000233"/>
        <metadata:prefixIRI>NBO:0000635</metadata:prefixIRI>
        <obo:created_by>George Gkoutos</obo:created_by>
        <obo:creation_date>2011-04-19T03:36:00Z</obo:creation_date>
        <obo:def>&quot;Behavior related to the activity seen in animals exposed to adverse stimuli, in which the tendency to act defensively is stronger than the tendency to attack.&quot; [web:http\://www.britannica.com/EBchecked/topic/45916/avoidance-behavior]</obo:def>
        <obo:namespace>behavior_ontology</obo:namespace>
        <rdfs:label>avoidance behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000636 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0000636">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000635"/>
