    <!-- http://purl.obolibrary.org/obo/NPT_0020174 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NPT_0020174">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NPT_0011006"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000123"/>
        <obo:IAO_0000115>TO DO</obo:IAO_0000115>
