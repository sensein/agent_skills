        <metadata:prefixIRI>MF:0000048</metadata:prefixIRI>
        <rdfs:label xml:lang="en">mental capability</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MF_0000049 -->

