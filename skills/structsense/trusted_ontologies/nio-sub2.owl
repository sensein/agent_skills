            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000132"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MF_0000020"/>
                            <owl:Class>
                                <owl:complementOf rdf:resource="http://purl.obolibrary.org/obo/MF_0000017"/>
                            </owl:Class>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MF_0000018 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MF_0000018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MF_0000020"/>
        <metadata:prefixIRI>MF:0000018</metadata:prefixIRI>
        <obo:IAO_0000115>the process whereby relevant aspects of our mental experience are focused on specific targets</obo:IAO_0000115>
        <rdfs:label xml:lang="en">attending</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MF_0000019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MF_0000019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MF_0000020"/>
        <metadata:prefixIRI>MF:0000019</metadata:prefixIRI>
        <obo:IAO_0000115>a mental process which is a) produced by a causal process (for example involving light rays or air vibrations) involving a part of the environment of the organism, and b) is experienced by the organism as being so caused, and c) in
which the relevant part of the environment is thereby represented to the organism</obo:IAO_0000115>
        <rdfs:label>perception</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MF_0000020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MF_0000020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000060"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MF_0000033"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MF_0000021 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MF_0000021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000060"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MF_0000022 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MF_0000022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MF_0000203"/>
        <metadata:prefixIRI>MF:0000022</metadata:prefixIRI>
        <obo:IAO_0000115 xml:lang="en">A personality trait manifesting itself in individual behavioral characteristics that are perceived as kind, sympathetic, cooperative, warm, and considerate.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">Development and Validation of International English Big-Five Mini-Markers. Edmund R. Thomspson. Personality and Individual Differences, Volume 45, Issue 6, October 2008.  http://www.sciencedirect.com/science/article/pii/S0191886908002195</obo:IAO_0000119>
        <oboInOwl:hasAlternativeId>http://www.github.com/no/ontologies/2017/PAO/Agreeableness</oboInOwl:hasAlternativeId>
        <rdfs:comment xml:lang="en">Associated adjectives: appreciative, forgiving, generous, kind, sympathetic, and trusting.</rdfs:comment>
        <rdfs:label xml:lang="en">agreeableness</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MF_0000023 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MF_0000023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000060"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000117"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MF_0000021"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MF_0000024 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MF_0000024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MF_0000019"/>
        <metadata:prefixIRI>MF:0000024</metadata:prefixIRI>
        <obo:IAO_0000118>visual perception</obo:IAO_0000118>
        <rdfs:label xml:lang="en">seeing</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MF_0000026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MF_0000026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MF_0000203"/>
        <metadata:prefixIRI>MF:0000026</metadata:prefixIRI>
        <rdfs:label xml:lang="en">introversion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MF_0000027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MF_0000027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MF_0000020"/>
        <metadata:prefixIRI>MF:0000027</metadata:prefixIRI>
        <obo:IAO_0000115>A mental process that involves mentally manipulating representations of steps in an imagined process which has some objective, e.g. to bring about a desired state of affairs. The outcome of this mental process is a plan which has the potential to be followed to bring about the desired outcome.</obo:IAO_0000115>
        <rdfs:label>planning</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MF_0000028 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MF_0000028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MF_0000203"/>
        <metadata:prefixIRI>MF:0000028</metadata:prefixIRI>
        <obo:IAO_0000115 xml:lang="en">A personality trait manifesting itself in individual behavioral characteristics that are perceived as careful, self-disciplined, dependable, vigilant, dutiful, and goal-oriented.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>http://www.github.com/no/ontologies/2017/PAO/Conscientiousness</oboInOwl:hasAlternativeId>
        <rdfs:comment xml:lang="en">Associated adjectives: efficient, organized, planful, reliable, responsible, and thorough.</rdfs:comment>
        <rdfs:label xml:lang="en">conscientiousness</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MF_0000029 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MF_0000029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MF_0000203"/>
        <metadata:prefixIRI>MF:0000029</metadata:prefixIRI>
        <obo:IAO_0000115>A mental disposition to frequent or easily incited outbursts of anger. </obo:IAO_0000115>
        <rdfs:label xml:lang="en">irascibility</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MF_0000030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MF_0000030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
        <metadata:prefixIRI>MF:0000030</metadata:prefixIRI>
        <obo:IAO_0000115>A dependent continuant which is about a portion of reality.</obo:IAO_0000115>
        <obo:IAO_0000119>http://www.jbiomedsem.com/content/1/1/10</obo:IAO_0000119>
        <rdfs:label>representation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MF_0000031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MF_0000031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MF_0000030"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MF_0000032 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MF_0000032">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
        <metadata:prefixIRI>MF:0000032</metadata:prefixIRI>
        <obo:IAO_0000115>A bodily disposition is a disposition that inheres in some extended organism. Examples are: my disposition to catch a cold when exposed to a virus, my ability to speak the English language.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bodily disposition</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MF_0000033 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MF_0000033">
