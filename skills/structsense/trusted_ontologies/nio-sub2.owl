        <obo:IAO_0000111>micromole</obo:IAO_0000111>
        <obo:IAO_0000115>A substance unit equal to a millionth of a mol or 10^[-6] mol.</obo:IAO_0000115>
        <obo:IAO_0000118>umol</obo:IAO_0000118>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
