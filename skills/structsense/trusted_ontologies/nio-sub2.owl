        <obo:IAO_0000111>microliters per minute</obo:IAO_0000111>
        <obo:IAO_0000115>A volumetric flow rate unit which is equal to one microliter volume through a given surface in one minute.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:label>microliters per minute</rdfs:label>
    </owl:NamedIndividual>
    


