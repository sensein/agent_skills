        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
        <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002090"/>
        <obo:IAO_0000117>David Osumi-Sutherland</obo:IAO_0000117>
