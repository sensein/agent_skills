    <!-- http://purl.obolibrary.org/obo/PATO_0000011 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0000011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001237"/>
        <obo:IAO_0000111>age</obo:IAO_0000111>
        <obo:IAO_0000115>A time quality inhering in a bearer by virtue of how long the bearer has existed.</obo:IAO_0000115>
        <obo:IAO_0000412>http://purl.obolibrary.org/obo/pato.owl</obo:IAO_0000412>
        <obo:xref xml:lang="en">http://scai.fraunhofer.de/NDDUO#Age</obo:xref>
        <NDDUO:Synonym xml:lang="en">age at onset</NDDUO:Synonym>
        <rdfs:label>age</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0000186 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0000186">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001237"/>
        <obo:IAO_0000111>behavioral quality</obo:IAO_0000111>
        <obo:IAO_0000115>An organismal quality inhering in a bearer by virtue of the bearer&apos;s behavior aggregate of the responses or reactions or movements in a given situation.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pato.owl"/>
        <rdfs:label>behavioral quality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001237 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001237">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <obo:IAO_0000111 xml:lang="en">quality of a single physical entity</obo:IAO_0000111>
        <obo:IAO_0000115 xml:lang="en">A physical object quality which inheres in a single-bearer.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pato.owl"/>
        <rdfs:label xml:lang="en">quality of a single physical entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0002201 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0002201">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000186"/>
        <obo:IAO_0000111>handedness</obo:IAO_0000111>
        <obo:IAO_0000115>A behavioral quality inhering ina bearer by virtue of the bearer&apos;s unequal distribution of fine motor skill between its left and right hands or feet.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pato.owl"/>
        <rdfs:label>handedness</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0002202 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0002202">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002201"/>
        <obo:IAO_0000111>left handedness</obo:IAO_0000111>
        <obo:IAO_0000115>Handedness where the organism preferentially uses the left hand or foot for tasks requiring the use of a single hand or foot or a dominant hand or foot.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pato.owl"/>
        <rdfs:label>left handedness</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0002203 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0002203">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002201"/>
        <obo:IAO_0000111>right handedness</obo:IAO_0000111>
        <obo:IAO_0000115>Handedness where the organism preferentially uses the right hand or foot for tasks requiring the use of a single hand or foot or a dominant hand or foot.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pato.owl"/>
        <rdfs:label>right handedness</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0002204 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0002204">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002201"/>
        <obo:IAO_0000111>ambidextrous handedness</obo:IAO_0000111>
        <obo:IAO_0000115>Handedness where the organism exhibits no overall dominance in the use of right or left hand or foot in the performance of tasks that require one hand or foot or a dominant hand or foot.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pato.owl"/>
        <rdfs:label>ambidextrous handedness</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0000481 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000481">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_83153"/>
        <obo:IAO_0000111>multi-tissue structure</obo:IAO_0000111>
        <obo:IAO_0000115>Anatomical structure that has as its parts two or more portions of tissue of at least two different types and which through specific morphogenetic processes forms a single distinct structural unit demarcated by bona-fide boundaries from other distinct structural units of different types.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <rdfs:label>multi-tissue structure</rdfs:label>
    </owl:Class>
    


