        <obo:IAO_0000111>nanomole</obo:IAO_0000111>
        <obo:IAO_0000115>A substance unit equal to one thousandth of one millionth of a mole or 10^[-9] mol.</obo:IAO_0000115>
        <obo:IAO_0000118>nmol</obo:IAO_0000118>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:label>nanomole</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000042 -->

