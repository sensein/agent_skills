    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0002269 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/OBI_0002269">
        <obo:IAO_0000111>pT3c (ovary)</obo:IAO_0000111>
