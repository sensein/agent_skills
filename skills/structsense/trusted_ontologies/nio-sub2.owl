    <!-- http://www.purl.org/NDDO/NDDO_20004592 -->

    <owl:Class rdf:about="http://www.purl.org/NDDO/NDDO_20004592">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/NDDO/NDDO_00000103"/>
        <metadata:prefixIRI>NDDO:NDDO_20004592</metadata:prefixIRI>
        <NDDO:NDDO_20000345 xml:lang="en">http://www.semanticweb.org/ontologies/2011/1/Ontology1296772722296.owl#Hoehn_and_Yahr_stage_scale</NDDO:NDDO_20000345>
        <NDDO:NDDO_20000370 xml:lang="en">PDON</NDDO:NDDO_20000370>
        <rdfs:comment xml:lang="en">Range from 0-5



0: Asymptomatic.

1: Unilateral involvement only.

2: Bilateral involvement without impairment of balance.

3: Mile to moderate involvement; some postural instability but physically independent; needs assistance to recover from pull test.

4: Severe disability; still able to walk or stand unassisted.

5: Wheelchair bound or bedridden unless aided.</rdfs:comment>
        <rdfs:label xml:lang="en">Hoehn and Yahr Stage Scale</rdfs:label>
    </owl:Class>
    


