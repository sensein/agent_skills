        <metadata:prefixIRI>MF:0000052</metadata:prefixIRI>
        <rdfs:label xml:lang="en">capability to speak</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MF_0000054 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MF_0000054">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MF_0000019"/>
        <metadata:prefixIRI>MF:0000054</metadata:prefixIRI>
        <rdfs:label xml:lang="en">tasting</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MF_0000055 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MF_0000055">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MF_0000019"/>
        <metadata:prefixIRI>MF:0000055</metadata:prefixIRI>
        <obo:IAO_0000118>olfactory perception</obo:IAO_0000118>
        <rdfs:label xml:lang="en">smelling</rdfs:label>
    </owl:Class>
    


