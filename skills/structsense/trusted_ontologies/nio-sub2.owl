        <obo:IAO_0000111 xml:lang="en">scatter plot</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">Comparison of gene expression values in two samples can be displayed in a scatter plot</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">A scatterplot is a graph which uses Cartesian coordinates to display values for two variables for a set of data. The data is displayed as a collection of points, each having the value of one variable determining the position on the horizontal axis and the value of the other variable determining the position on the vertical axis.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">PERSON:Chris Stoeckert</obo:IAO_0000117>
        <obo:IAO_0000117 xml:lang="en">PERSON:James Malone</obo:IAO_0000117>
        <obo:IAO_0000117 xml:lang="en">PERSON:Melanie Courtot</obo:IAO_0000117>
        <obo:IAO_0000118 xml:lang="en">scattergraph</obo:IAO_0000118>
        <obo:IAO_0000119 xml:lang="en">WEB: http://en.wikipedia.org/wiki/Scatterplot</obo:IAO_0000119>
        <rdfs:label xml:lang="en">scatter plot</rdfs:label>
    </owl:Class>
    


