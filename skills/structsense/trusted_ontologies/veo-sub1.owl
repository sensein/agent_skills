<?xml version="1.0"?>
<rdf:RDF xmlns="http://sbmi.uth.tmc.edu/ontology/VEO#"
     xml:base="http://sbmi.uth.tmc.edu/ontology/VEO"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:protege="http://protege.stanford.edu/plugins/owl/protege#"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#"
     xmlns:ace_lexicon="http://attempto.ifi.uzh.ch/ace_lexicon#">
    <owl:Ontology rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO">
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/MFOEM.owl"/>
        <dc:description>Visual Emotion Ontology (VEO) is an ontology that links visualizations with specific emotions from the Ortony, Clore, and Collins&apos; description of human emotions.</dc:description>
        <terms:creator>Cui Tao</terms:creator>
        <terms:creator>Muhammad &quot;Tuan&quot; Amith</terms:creator>
        <terms:creator>Rebecca Lin</terms:creator>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/elements/1.1/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/description"/>
    


    <!-- http://purl.org/dc/elements/1.1/source -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/source"/>
    


    <!-- http://purl.org/dc/terms/abstract -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/abstract"/>
    


    <!-- http://purl.org/dc/terms/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://sbmi.uth.tmc.edu/ontology/VEO#concernsActionsOf -->

    <owl:ObjectProperty rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#concernsActionsOf">
        <rdfs:domain rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Emotion"/>
        <rdfs:range rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Action"/>
        <dc:description>an emotion concerns the actions of an agent</dc:description>
    </owl:ObjectProperty>
    


    <!-- http://sbmi.uth.tmc.edu/ontology/VEO#concernsAspect -->

    <owl:ObjectProperty rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#concernsAspect">
        <rdfs:domain rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Emotion"/>
        <rdfs:range rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Aspect"/>
        <dc:description>an emotion concerns the aspect of an object</dc:description>
    </owl:ObjectProperty>
    


    <!-- http://sbmi.uth.tmc.edu/ontology/VEO#concernsConsequence -->

    <owl:ObjectProperty rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#concernsConsequence">
        <rdfs:domain rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Emotion"/>
        <rdfs:range rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Consequence"/>
        <dc:description>an emotion concerns the consequence of an event</dc:description>
    </owl:ObjectProperty>
    


    <!-- http://sbmi.uth.tmc.edu/ontology/VEO#confirms -->

    <owl:ObjectProperty rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#confirms">
        <rdfs:domain rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Actual_Consequence"/>
        <rdfs:range rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Prospective_Consequence"/>
        <owl:propertyDisjointWith rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#disconfirms"/>
    </owl:ObjectProperty>
    


    <!-- http://sbmi.uth.tmc.edu/ontology/VEO#disconfirms -->

    <owl:ObjectProperty rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#disconfirms">
        <rdfs:domain rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Actual_Consequence"/>
        <rdfs:range rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Prospective_Consequence"/>
    </owl:ObjectProperty>
    


    <!-- http://sbmi.uth.tmc.edu/ontology/VEO#hasColor -->

    <owl:ObjectProperty rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#hasColor">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#Lines"/>
                    <rdf:Description rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#Shape"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Color"/>
    </owl:ObjectProperty>
    


    <!-- http://sbmi.uth.tmc.edu/ontology/VEO#hasCompositeVisualization -->

    <owl:ObjectProperty rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#hasCompositeVisualization">
        <rdfs:domain rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Composite_Visualization"/>
        <rdfs:range rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Composite_Visualization"/>
    </owl:ObjectProperty>
    


    <!-- http://sbmi.uth.tmc.edu/ontology/VEO#hasLines -->

    <owl:ObjectProperty rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#hasLines">
        <rdfs:domain rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Composite_Visualization"/>
        <rdfs:range rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Lines"/>
    </owl:ObjectProperty>
    


    <!-- http://sbmi.uth.tmc.edu/ontology/VEO#hasShape -->

    <owl:ObjectProperty rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#hasShape">
        <rdfs:domain rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Composite_Visualization"/>
        <rdfs:range rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Shape"/>
    </owl:ObjectProperty>
    


    <!-- http://sbmi.uth.tmc.edu/ontology/VEO#isEmotionallyLinkedTo -->

    <owl:ObjectProperty rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#isEmotionallyLinkedTo">
        <rdfs:domain rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Composite_Visualization"/>
        <rdfs:range rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Emotion"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://sbmi.uth.tmc.edu/ontology/VEO#hasNumberOfLines -->

    <owl:DatatypeProperty rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#hasNumberOfLines">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Lines"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://sbmi.uth.tmc.edu/ontology/VEO#has_an_image -->

    <owl:DatatypeProperty rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#has_an_image">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Visualization"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/GO_0007610 -->

    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GO_0007610">
        <owl:equivalentClass rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Action"/>
    </rdf:Description>
    


    <!-- http://purl.obolibrary.org/obo/MFOEM_000001 -->

    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MFOEM_000001">
        <owl:equivalentClass rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Emotion"/>
    </rdf:Description>
    


    <!-- http://purl.obolibrary.org/obo/MFOEM_000009 -->

    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MFOEM_000009">
        <owl:equivalentClass rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Anger"/>
    </rdf:Description>
    


    <!-- http://purl.obolibrary.org/obo/MFOEM_000019 -->

    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MFOEM_000019">
        <owl:equivalentClass rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Disgust"/>
    </rdf:Description>
    


    <!-- http://purl.obolibrary.org/obo/MFOEM_000026 -->

    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MFOEM_000026">
        <owl:equivalentClass rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Fear"/>
    </rdf:Description>
    


    <!-- http://purl.obolibrary.org/obo/MFOEM_000032 -->

    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MFOEM_000032">
        <owl:equivalentClass rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Surprise"/>
    </rdf:Description>
    


    <!-- http://purl.obolibrary.org/obo/MFOEM_000033 -->

    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MFOEM_000033">
        <owl:equivalentClass rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Interest"/>
    </rdf:Description>
    


    <!-- http://purl.obolibrary.org/obo/MFOEM_000035 -->

    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MFOEM_000035">
        <owl:equivalentClass rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Pleased"/>
    </rdf:Description>
    


    <!-- http://purl.obolibrary.org/obo/MFOEM_000041 -->

    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MFOEM_000041">
        <owl:equivalentClass rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Pride"/>
    </rdf:Description>
    


    <!-- http://purl.obolibrary.org/obo/MFOEM_000042 -->

    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MFOEM_000042">
        <owl:equivalentClass rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Joy"/>
    </rdf:Description>
    


    <!-- http://purl.obolibrary.org/obo/MFOEM_000051 -->

    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MFOEM_000051">
        <owl:equivalentClass rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Disappointment"/>
    </rdf:Description>
    


    <!-- http://purl.obolibrary.org/obo/MFOEM_000055 -->

    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MFOEM_000055">
        <owl:equivalentClass rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Shame"/>
    </rdf:Description>
    


    <!-- http://purl.obolibrary.org/obo/MFOEM_000056 -->

    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MFOEM_000056">
        <owl:equivalentClass rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Distress"/>
    </rdf:Description>
    


    <!-- http://purl.obolibrary.org/obo/MFOEM_000177 -->

    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MFOEM_000177">
        <owl:equivalentClass rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Hope"/>
    </rdf:Description>
    


    <!-- http://purl.obolibrary.org/obo/MFOEM_000211 -->

    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MFOEM_000211">
        <owl:equivalentClass rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Positive_Emotion"/>
    </rdf:Description>
    


    <!-- http://purl.obolibrary.org/obo/MFOEM_000212 -->

    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MFOEM_000212">
        <owl:equivalentClass rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Negative_Emotion"/>
    </rdf:Description>
    


    <!-- http://sbmi.uth.tmc.edu/ontology/VEO#Action -->

    <owl:Class rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#Action">
        <obo:IAO_0000115>something done or performed; act; deed</obo:IAO_0000115>
        <obo:IAO_0000119>http://www.dictionary.com/browse/action</obo:IAO_0000119>
    </owl:Class>
    


    <!-- http://sbmi.uth.tmc.edu/ontology/VEO#Action_Of_Other_Agent -->

    <owl:Class rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#Action_Of_Other_Agent">
        <rdfs:subClassOf rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Action"/>
        <obo:IAO_0000115>something done or performed by another person</obo:IAO_0000115>
    </owl:Class>
    


    <!-- http://sbmi.uth.tmc.edu/ontology/VEO#Action_Of_Self_Agent -->

    <owl:Class rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#Action_Of_Self_Agent">
        <rdfs:subClassOf rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Action"/>
        <obo:IAO_0000115>something done or performed by oneself</obo:IAO_0000115>
    </owl:Class>
    


    <!-- http://sbmi.uth.tmc.edu/ontology/VEO#Actual_Consequence -->

    <owl:Class rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#Actual_Consequence">
        <rdfs:subClassOf rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Consequence"/>
        <obo:IAO_0000115>an effect, result, or outcome that did happen</obo:IAO_0000115>
    </owl:Class>
    


    <!-- http://sbmi.uth.tmc.edu/ontology/VEO#Admiration -->

    <owl:Class rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#Admiration">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#Approving"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#concernsActionsOf"/>
                        <owl:someValuesFrom rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Action_Of_Other_Agent"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000115>approving of someone else&apos;s action</obo:IAO_0000115>
        <dc:description>pink circle surrounded by curved red lines</dc:description>
        <dc:source>https://drive.google.com/open?id=14OMyADQ0sQ4VpW7_pKDBGg8OTle5JFUT4fg1xNekJ9w</dc:source>
    </owl:Class>
    


    <!-- http://sbmi.uth.tmc.edu/ontology/VEO#Anger -->

    <owl:Class rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#Anger">
        <rdfs:subClassOf rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Distress"/>
        <rdfs:subClassOf rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Reproach"/>
        <obo:IAO_0000115>reproach about an action and distress about a related consequence</obo:IAO_0000115>
        <dc:description>red triangle pointing down surrounded by double sharp black lines</dc:description>
        <dc:source>https://drive.google.com/open?id=1COGqrwCvnrr70KY45CC84t0c77pRNgwjfDRLdnP71h4</dc:source>
    </owl:Class>
    


    <!-- http://sbmi.uth.tmc.edu/ontology/VEO#Approving -->

    <owl:Class rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#Approving">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#Positive_Emotion"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#concernsActionsOf"/>
                        <owl:someValuesFrom rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Action"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000115>being positive about an action (of an agent)</obo:IAO_0000115>
    </owl:Class>
    


    <!-- http://sbmi.uth.tmc.edu/ontology/VEO#Aspect -->

    <owl:Class rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#Aspect">
        <obo:IAO_0000115>nature; quality; character</obo:IAO_0000115>
        <obo:IAO_0000119>http://www.dictionary.com/browse/aspect</obo:IAO_0000119>
    </owl:Class>
    


    <!-- http://sbmi.uth.tmc.edu/ontology/VEO#Black -->

    <owl:Class rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#Black">
        <rdfs:subClassOf rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Color"/>
    </owl:Class>
    


    <!-- http://sbmi.uth.tmc.edu/ontology/VEO#Black_Curved_Line -->

    <owl:Class rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#Black_Curved_Line">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#Composite_Visualization"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#hasColor"/>
                        <owl:someValuesFrom rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Black"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#hasLines"/>
                        <owl:allValuesFrom rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Curved_Line"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://sbmi.uth.tmc.edu/ontology/VEO#Black_Downward_Pointing_Triangle -->

    <owl:Class rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#Black_Downward_Pointing_Triangle">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#Composite_Visualization"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#hasColor"/>
                        <owl:someValuesFrom rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Black"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#hasShape"/>
                        <owl:allValuesFrom rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Downward_Pointing_Triangle"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://sbmi.uth.tmc.edu/ontology/VEO#Black_Sharp_Line -->

    <owl:Class rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#Black_Sharp_Line">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#Composite_Visualization"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#hasColor"/>
                        <owl:someValuesFrom rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Black"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#hasLines"/>
                        <owl:allValuesFrom rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Sharp_Line"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://sbmi.uth.tmc.edu/ontology/VEO#Black_Sharp_Lines_Doubled -->

    <owl:Class rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#Black_Sharp_Lines_Doubled">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#Composite_Visualization"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#hasColor"/>
                        <owl:someValuesFrom rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Black"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#hasLines"/>
                        <owl:allValuesFrom rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Sharp_Lines_Doubled"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://sbmi.uth.tmc.edu/ontology/VEO#Blue -->

    <owl:Class rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#Blue">
        <rdfs:subClassOf rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Color"/>
    </owl:Class>
    


    <!-- http://sbmi.uth.tmc.edu/ontology/VEO#Blue_Curved_Line -->

    <owl:Class rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#Blue_Curved_Line">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sbmi.uth.tmc.edu/ontology/VEO#Composite_Visualization"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#hasColor"/>
                        <owl:someValuesFrom rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#Blue"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://sbmi.uth.tmc.edu/ontology/VEO#hasLines"/>
