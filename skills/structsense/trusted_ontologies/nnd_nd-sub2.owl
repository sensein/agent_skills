        <oboInOwl:id>Congophilic_Angiopathy</oboInOwl:id>
        <rdfs:label>Congophilic Angiopathy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/Control_Brain -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/Control_Brain">
        <obo:Definition>Donors without cognitive decline or dementia, who neuropathologically do not meet the criteria for any neurodegenerative disease.</obo:Definition>
        <obo:abbreviation>CON</obo:abbreviation>
        <oboInOwl:id>Control_Brain</oboInOwl:id>
        <rdfs:label>Control Brain</rdfs:label>
    </owl:Class>
    


