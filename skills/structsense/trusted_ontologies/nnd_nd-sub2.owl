    <!-- http://purl.obolibrary.org/obo/Senile_Involutive_Cortical_Changes -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/Senile_Involutive_Cortical_Changes">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/Neuropathophysiological_Traits"/>
        <obo:Definition>SICC is a term used by the Netherlands Brain Bank since the beginning. At first it was only about the progress of amyloid plagues and neurofibrillary tangles, but not sufficient enough to meet the criteria for Alzheimer’s disease. Over the years, the neuropathological field has developed, and by now SICC encompasses both amyloid plaques (up to Thal phase 3 out of 5) and tangles (Braak 1, 2 and 3), but also ARTAG (age-related tau-astrogliopathy)  and mild cerebral amyloid angiopathy. In the present these findings are all written down separately.</obo:Definition>
        <obo:abbreviation>SICC</obo:abbreviation>
        <obo:synonym>ARTAG</obo:synonym>
        <oboInOwl:id>Senile_Involutive_Cortical_Changes</oboInOwl:id>
        <rdfs:label>Senile Involutive Cortical Changes</rdfs:label>
    </owl:Class>
    


