<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/irholtman/ontologies/2023/5/untitled-ontology-7#"
     xml:base="http://www.semanticweb.org/irholtman/ontologies/2023/5/untitled-ontology-7"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#"
     xmlns:untitled-ontology-7="http://purl.obolibrary.org/obo/http://www.semanticweb.org/irholtman/ontologies/2023/5/untitled-ontology-7#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/irholtman/ontologies/2023/5/untitled-ontology-7">
        <oboInOwl:hasOBOFormatVersion>1.2</oboInOwl:hasOBOFormatVersion>
    </owl:Ontology>
    


    <!-- 
