        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/Frontotemporal_Dementia"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/Picks_Disease"/>
        <obo:Definition>Frontoterporal lobe degeneration with FUS (Fused in sarcoma) accumulations.</obo:Definition>
        <obo:abbreviation>FTD-FUS</obo:abbreviation>
        <oboInOwl:id>Frontotemporal_Dementia_FUS</oboInOwl:id>
        <IsProgressiveNeurodegenerativeDisease rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</IsProgressiveNeurodegenerativeDisease>
        <rdfs:label>Frontotemporal Dementia FUS</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/Frontotemporal_Dementia_TDP -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/Frontotemporal_Dementia_TDP">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/Frontotemporal_Dementia"/>
        <obo:Definition>Donors with frontotomporal lobe degeneration with TDP-43 pathology.</obo:Definition>
        <obo:abbreviation>FTD-TDP</obo:abbreviation>
        <obo:database_cross_reference>https://pubmed.ncbi.nlm.nih.gov/21644037/</obo:database_cross_reference>
        <oboInOwl:id>Frontotemporal_Dementia_TDP</oboInOwl:id>
        <IsProgressiveNeurodegenerativeDisease rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</IsProgressiveNeurodegenerativeDisease>
        <rdfs:label>Frontotemporal Dementia TDP</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/Frontotemporal_Dementia_TDP_Undefined -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/Frontotemporal_Dementia_TDP_Undefined">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/Frontotemporal_Dementia_TDP"/>
        <obo:Definition>Donors belonging to the category &quot;Frontotemporal Dementia TDP Undefined&quot; are known to have FTD-TDP. However, the subtype (A, B, or C) could not be distinguished.</obo:Definition>
        <obo:abbreviation>FTD-TDP_undefined</obo:abbreviation>
        <oboInOwl:id>Frontotemporal_Dementia_TDP_Undefined</oboInOwl:id>
        <IsProgressiveNeurodegenerativeDisease rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</IsProgressiveNeurodegenerativeDisease>
        <rdfs:label>Frontotemporal Dementia TDP Undefined</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/Frontotemporal_Dementia_TDP_type_A -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/Frontotemporal_Dementia_TDP_type_A">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/Frontotemporal_Dementia_TDP"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/Frontotemporal_Dementia_TDP_type_B"/>
        <obo:Definition>FTD with TDP-43 pathology, charactarized by numerous short dystrophic neurites and crescentic or oval neuronal cytoplasmatic inclusions, concentrated primarely in neocortical layer II.</obo:Definition>
        <obo:abbreviation>FTD-TDP-A</obo:abbreviation>
        <oboInOwl:id>Frontotemporal_Dementia_TDP_type_A</oboInOwl:id>
        <IsProgressiveNeurodegenerativeDisease rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</IsProgressiveNeurodegenerativeDisease>
        <rdfs:label>Frontotemporal Dementia TDP type A</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/Frontotemporal_Dementia_TDP_type_B -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/Frontotemporal_Dementia_TDP_type_B">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/Frontotemporal_Dementia_TDP"/>
        <obo:Definition>FTD with TDP-43 pathology, charactarized by a moderate numbers of neuronal cytoplasmatic inclusions, in all cortical layers, but with only few dystrophic neurites.</obo:Definition>
        <obo:abbreviation>FTD-TDP-B</obo:abbreviation>
        <oboInOwl:id>Frontotemporal_Dementia_TDP_type_B</oboInOwl:id>
        <IsProgressiveNeurodegenerativeDisease rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</IsProgressiveNeurodegenerativeDisease>
        <rdfs:label>Frontotemporal Dementia TDP type B</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/Frontotemporal_Dementia_TDP_type_C -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/Frontotemporal_Dementia_TDP_type_C">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/Frontotemporal_Dementia_TDP"/>
        <obo:Definition>FTD with TDP-43 pathology, characterized by a predominance of elongated dystrophic neurites in upper cortical layers with only few neuronal cytoplasmatic inclusions.</obo:Definition>
        <obo:abbreviation>FTD-TDP-C</obo:abbreviation>
        <oboInOwl:id>Frontotemporal_Dementia_TDP_type_C</oboInOwl:id>
        <IsProgressiveNeurodegenerativeDisease rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</IsProgressiveNeurodegenerativeDisease>
        <rdfs:label>Frontotemporal Dementia TDP type C</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/Frontotemporal_Dementia_Tauopathy -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/Frontotemporal_Dementia_Tauopathy">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/Frontotemporal_Dementia"/>
        <obo:Definition>Donors with FTD characterized by abnormal intracellular accumulation of hyperphosphorilated tau.</obo:Definition>
        <obo:abbreviation>FTD-TAU</obo:abbreviation>
        <obo:database_cross_reference>https://pubmed.ncbi.nlm.nih.gov/27306735/</obo:database_cross_reference>
        <oboInOwl:id>Frontotemporal_Dementia_Tauopathy</oboInOwl:id>
        <IsProgressiveNeurodegenerativeDisease rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</IsProgressiveNeurodegenerativeDisease>
        <rdfs:label>Frontotemporal Dementia Tauopathy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/Frontotemporal_Dementia_Ubiquitine -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/Frontotemporal_Dementia_Ubiquitine">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/Frontotemporal_Dementia"/>
        <obo:Definition>Donors with frontotemporal lobar degeneration with ubiquitin or P62 only immunoreactive inclusions (negative for all other proteins, as well as cases that have not yet been analyzed with FUS or TDP-43)</obo:Definition>
        <obo:abbreviation>FTD-UPS</obo:abbreviation>
        <obo:database_cross_reference>https://pubmed.ncbi.nlm.nih.gov/21810890/</obo:database_cross_reference>
        <oboInOwl:id>Frontotemporal_Dementia_Ubiquitine</oboInOwl:id>
        <IsProgressiveNeurodegenerativeDisease rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</IsProgressiveNeurodegenerativeDisease>
        <rdfs:label>Frontotemporal Dementia Ubiquitine</rdfs:label>
    </owl:Class>
    


