        <obo:abbreviation>CVA</obo:abbreviation>
        <obo:database_cross_reference>MESH: http://purl.bioontology.org/ontology/MESH/D020521
DOID: http://purl.obolibrary.org/obo/DOID_6713</obo:database_cross_reference>
        <oboInOwl:id>Cerebrovascular_Accident</oboInOwl:id>
        <rdfs:label>Cerebrovascular Accident</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/Congophilic_Angiopathy -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/Congophilic_Angiopathy">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/Neuropathophysiological_Traits"/>
        <obo:abbreviation>CA</obo:abbreviation>
        <obo:database_cross_reference>MESH:http://purl.bioontology.org/ontology/MESH/D016657
