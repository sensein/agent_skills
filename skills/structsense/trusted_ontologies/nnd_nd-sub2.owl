    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/Adrenoleukodystrophy -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/Adrenoleukodystrophy">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/Leukodystrophy"/>
        <obo:abbreviation>LDA</obo:abbreviation>
        <obo:database_cross_reference>ICD10:http://purl.bioontology.org/ontology/ICD10CM/E71.52
MESH:http://purl.bioontology.org/ontology/MESH/D000326
Human Disease Ontology:http://purl.obolibrary.org/obo/DOID_10588</obo:database_cross_reference>
        <oboInOwl:id>Adrenoleukodystrophy</oboInOwl:id>
        <rdfs:label>Adrenoleukodystrophy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/Alexanders_Disease -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/Alexanders_Disease">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/Leukodystrophy"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/Downs_Syndrome"/>
        <obo:abbreviation>ALEX</obo:abbreviation>
        <obo:database_cross_reference>MESH:http://purl.bioontology.org/ontology/MESH/D038261
Human Disease Ontology:http://purl.obolibrary.org/obo/DOID_4252</obo:database_cross_reference>
        <oboInOwl:id>Alexanders_Disease</oboInOwl:id>
        <rdfs:label>Alexander&apos;s Disease</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/Alpha-Synucleinopathy_Disorders -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/Alpha-Synucleinopathy_Disorders">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/Progressive_Neurodegenerative_Diseases"/>
        <obo:Definition>Group of neurodegenerative disorders in which the main pathological observation is abnormal accumulation of alpha-synuclein.</obo:Definition>
        <oboInOwl:id>Alpha-Synucleinopathy_Disorders</oboInOwl:id>
        <IsProgressiveNeurodegenerativeDisease rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</IsProgressiveNeurodegenerativeDisease>
        <rdfs:label>Alpha-Synucleinopathy Disorders</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/Alzheimers_Disease -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/Alzheimers_Disease">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/Progressive_Neurodegenerative_Diseases"/>
        <obo:abbreviation>AD</obo:abbreviation>
        <obo:database_cross_reference>ICD10:http://purl.bioontology.org/ontology/ICD10/G30
MESH:http://purl.bioontology.org/ontology/MESH/D000544
Human Phenotype Ontology:http://purl.obolibrary.org/obo/HP_0002511
Human Disease Ontology:http://purl.obolibrary.org/obo/DOID_10652</obo:database_cross_reference>
        <oboInOwl:id>Alzheimers_Disease</oboInOwl:id>
        <IsProgressiveNeurodegenerativeDisease rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</IsProgressiveNeurodegenerativeDisease>
        <rdfs:label>Alzheimer&apos;s Disease</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/Amyotrophic_Lateral_Sclerosis -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/Amyotrophic_Lateral_Sclerosis">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/Motor_Neuron_Diseases"/>
        <obo:abbreviation>ALS</obo:abbreviation>
        <obo:database_cross_reference>ICD10:http://purl.bioontology.org/ontology/ICD10CM/G12.21
MESH:http://purl.bioontology.org/ontology/MESH/D000690
Human Phenotype Ontology:http://purl.obolibrary.org/obo/HP_0007354
Human Disease Ontology:http://purl.obolibrary.org/obo/DOID_332</obo:database_cross_reference>
        <oboInOwl:id>Amyotrophic_Lateral_Sclerosis</oboInOwl:id>
        <IsProgressiveNeurodegenerativeDisease rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</IsProgressiveNeurodegenerativeDisease>
        <rdfs:label>Amyotrophic Lateral Sclerosis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/Argyrophilic_Grain_Disease -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/Argyrophilic_Grain_Disease">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/Neuropathophysiological_Traits"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/Congophilic_Angiopathy"/>
        <obo:abbreviation>AGD</obo:abbreviation>
        <obo:database_cross_reference>SNOMEDCT: http://purl.bioontology.org/ontology/SNOMEDCT/230281007</obo:database_cross_reference>
        <oboInOwl:id>Argyrophilic_Grain_Disease</oboInOwl:id>
        <rdfs:label>Argyrophilic Grain Disease</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/Attention_Deficit_Hyperactivity_Disorder -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/Attention_Deficit_Hyperactivity_Disorder">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/Psychiatric_Disorders"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/Autism_Spectrum_Disorder"/>
        <obo:abbreviation>ADHD</obo:abbreviation>
        <obo:database_cross_reference>ICD10:http://purl.bioontology.org/ontology/ICD10CM/F90
MESH:http://purl.bioontology.org/ontology/MESH/D001289
Human Phenotype Ontology:http://purl.obolibrary.org/obo/HP_0007018
Human Disease Ontology:http://purl.obolibrary.org/obo/DOID_1094</obo:database_cross_reference>
        <oboInOwl:id>Attention_Deficit_Hyperactivity_Disorder</oboInOwl:id>
        <rdfs:label>Attention Deficit Hyperactivity Disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/Atypical_Parkinsons_Disease -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/Atypical_Parkinsons_Disease">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/Alpha-Synucleinopathy_Disorders"/>
        <obo:Definition>Patient&apos;s who have an alphasynucleinopathy or so called &quot;Lewy body disease&quot;, however, they do not have the typical neuropathological picture of PD.  In these cases additional neuropathological findings are considered to contribute to the clinical picture. These additional neuropathological findings vary between cases. Hence the &quot;atypical Parkinson&apos;s disease&quot;</obo:Definition>
        <obo:abbreviation>ATPD</obo:abbreviation>
        <oboInOwl:id>Atypical_Parkinsons_Disease</oboInOwl:id>
        <IsProgressiveNeurodegenerativeDisease rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</IsProgressiveNeurodegenerativeDisease>
        <rdfs:label>Atypical Parkinson&apos;s Disease</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/Autism_Spectrum_Disorder -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/Autism_Spectrum_Disorder">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/Psychiatric_Disorders"/>
        <obo:abbreviation>ASD</obo:abbreviation>
        <obo:database_cross_reference>ICD10:http://purl.bioontology.org/ontology/ICD10/F84.0, http://purl.bioontology.org/ontology/ICD10/F84.1, http://purl.bioontology.org/ontology/ICD10/F84.5
MESH:http://purl.bioontology.org/ontology/MESH/D000067877
Human Phenotype Ontology:http://purl.obolibrary.org/obo/HP_0000717
Human Disease Ontology:http://purl.obolibrary.org/obo/DOID_0060041</obo:database_cross_reference>
        <oboInOwl:id>Autism_Spectrum_Disorder</oboInOwl:id>
        <rdfs:label>Autism Spectrum Disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/Autosomal_Dominant_Cerebellar_Ataxia -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/Autosomal_Dominant_Cerebellar_Ataxia">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/Cerebellar_Ataxia"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/Friedreichs_Ataxia"/>
        <obo:abbreviation>ADCA</obo:abbreviation>
        <obo:database_cross_reference>Human Phenotype Ontology: http://purl.obolibrary.org/obo/HP_0001251
Human Disease Ontology: http://purl.obolibrary.org/obo/DOID_1441</obo:database_cross_reference>
        <oboInOwl:id>Autosomal_Dominant_Cerebellar_Ataxia</oboInOwl:id>
        <IsProgressiveNeurodegenerativeDisease rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</IsProgressiveNeurodegenerativeDisease>
        <rdfs:label>Autosomal Dominant Cerebellar Ataxia</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/Binswangers_Disease -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/Binswangers_Disease">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/Progressive_Neurodegenerative_Diseases"/>
        <obo:abbreviation>BINSW</obo:abbreviation>
        <obo:database_cross_reference>MESH:http://purl.bioontology.org/ontology/MESH/D015140</obo:database_cross_reference>
        <oboInOwl:id>Binswangers_Disease</oboInOwl:id>
        <IsProgressiveNeurodegenerativeDisease rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</IsProgressiveNeurodegenerativeDisease>
        <rdfs:label>Binswanger&apos;s Disease</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/Bipolar_Disorder -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/Bipolar_Disorder">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/Psychiatric_Disorders"/>
        <obo:abbreviation>BP</obo:abbreviation>
        <obo:database_cross_reference>ICD10:http://purl.bioontology.org/ontology/ICD10CM/F31
MESH:http://purl.bioontology.org/ontology/MESH/D001714
Human Phenotype Ontology:http://purl.obolibrary.org/obo/HP_0007302</obo:database_cross_reference>
        <oboInOwl:id>Bipolar_Disorder</oboInOwl:id>
        <rdfs:label>Bipolar Disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/Brain_Cancer -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/Brain_Cancer">
        <obo:Definition>Category including neoplasms of the brain, both primary (benign/malignant) and secondary (metastatic) forms.</obo:Definition>
        <oboInOwl:id>Brain_Cancer</oboInOwl:id>
        <rdfs:label>Brain Cancer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/C9ORF72 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/C9ORF72">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/Mutation"/>
        <obo:Definition>Donors with C9ORF72 mutation mostly show FTD-TDP-B pathology, but FTD-TDP A is also seen.</obo:Definition>
        <obo:abbreviation>C9ORF72</obo:abbreviation>
        <obo:database_cross_reference>MESH: http://purl.bioontology.org/ontology/MESH/D016657</obo:database_cross_reference>
        <oboInOwl:id>C9ORF72</oboInOwl:id>
        <rdfs:label>C9ORF72</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/Cerebellar_Ataxia -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/Cerebellar_Ataxia">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/Neurological_Disorders"/>
        <obo:Definition>Group of disorders in which the main symptom is ataxia.</obo:Definition>
        <obo:abbreviation>ATAXIA</obo:abbreviation>
        <obo:database_cross_reference>ICD10: http://purl.bioontology.org/ontology/ICD10CM/G11
MESH: http://purl.bioontology.org/ontology/MESH/D002524
Human phenotype ontology: http://purl.obolibrary.org/obo/HP_0001251
Human Disease Ontology: http://purl.obolibrary.org/obo/DOID_0050753</obo:database_cross_reference>
        <oboInOwl:id>Cerebellar_Ataxia</oboInOwl:id>
        <IsProgressiveNeurodegenerativeDisease rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</IsProgressiveNeurodegenerativeDisease>
        <rdfs:label>Cerebellar Ataxia</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/Cerebral_Autosomal_Dominant_Arteriopathy_with_Sub-cortical_Infarcts_and_Leukoencephalopathy -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/Cerebral_Autosomal_Dominant_Arteriopathy_with_Sub-cortical_Infarcts_and_Leukoencephalopathy">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/Neurological_Disorders"/>
        <obo:abbreviation>VDCAD</obo:abbreviation>
        <obo:database_cross_reference>ICD10:http://purl.bioontology.org/ontology/ICD10CM/I67.850
MESH:http://purl.bioontology.org/ontology/MESH/D046589
Human Disease Ontology:http://purl.obolibrary.org/obo/DOID_13945</obo:database_cross_reference>
        <obo:synonym>Cerebral Autosomal Dominant Arteriopathy with Sub-cortical Infarcts and Leukoencephalopathy</obo:synonym>
        <oboInOwl:id>Cerebral_Autosomal_Dominant_Arteriopathy_with_Sub-cortical_Infarcts_and_Leukoencephalopathy</oboInOwl:id>
        <IsProgressiveNeurodegenerativeDisease rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</IsProgressiveNeurodegenerativeDisease>
        <rdfs:label>CADASIL</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/Cerebrovascular_Accident -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/Cerebrovascular_Accident">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/Vascular_Pathology"/>
