    <!-- http://purl.obolibrary.org/obo/Diffuse_Axonal_Injury -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/Diffuse_Axonal_Injury">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/Neuropathophysiological_Traits"/>
