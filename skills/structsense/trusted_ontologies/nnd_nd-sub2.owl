    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/Definition -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/Definition"/>
    


    <!-- http://purl.obolibrary.org/obo/abbreviation -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/abbreviation"/>
    


    <!-- http://purl.obolibrary.org/obo/database_cross_reference -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/database_cross_reference"/>
    


    <!-- http://purl.obolibrary.org/obo/synonym -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/synonym"/>
    


    <!-- http://www.geneontology.org/formats/oboInOwl#hasOBOFormatVersion -->

    <owl:AnnotationProperty rdf:about="http://www.geneontology.org/formats/oboInOwl#hasOBOFormatVersion">
        <rdfs:label>has_obo_format_version</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.geneontology.org/formats/oboInOwl#id -->

    <owl:AnnotationProperty rdf:about="http://www.geneontology.org/formats/oboInOwl#id"/>
    


    <!-- http://www.semanticweb.org/irholtman/ontologies/2023/5/untitled-ontology-7#IsProgressiveNeurodegenerativeDisease -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/irholtman/ontologies/2023/5/untitled-ontology-7#IsProgressiveNeurodegenerativeDisease"/>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#label -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#label"/>
    


