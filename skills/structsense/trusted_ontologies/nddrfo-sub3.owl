                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/Parkinson_disease"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <PMID>PMID:18307243</PMID>
        <PMID>PMID:26952952</PMID>
        <Synonyms>Wine intake</Synonyms>
        <Synonyms>vino</Synonyms>
        <definition>An alcoholic beverage created from fermented juice of fresh grapes or of other fruit or plant products.
http://purl.obolibrary.org/obo/NCIT_C66822</definition>
        <description>&gt; 21 glasses/week: 0.21 (0.05, 0.93)
Controls drank more alcohol than did cases and the risk of MSA decreased with increasing alcohol consumption (P = 0.04).</description>
        <description>Wine: OR(95%CI): 28.28(6.65, 125)
PD was found to be positively associated with coffee and alcohol consumption.</description>
        <reference>NCIT:C66822</reference>
        <rdfs:label>Wine</rdfs:label>
    </owl:Class>
    


