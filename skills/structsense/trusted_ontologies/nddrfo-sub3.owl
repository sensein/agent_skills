    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#episodic_memory_impairment -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#episodic_memory_impairment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#cognitive_symptom"/>
        <obo:IAO_0000115>A mental impairment in the ability to learn and retain new information, or recall information about a specific event that has occurred at a specific time and place.</obo:IAO_0000115>
        <obo:IAO_0000118>memory impairment</obo:IAO_0000118>
        <obo:OGG_0000000030 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</obo:OGG_0000000030>
        <obo:hasDbXref>https://pubmed.ncbi.nlm.nih.gov/21514249/</obo:hasDbXref>
        <ado:CommentOnDefinition>Modified definition</ado:CommentOnDefinition>
        <oboInOwl:hasExactSynonym>impairment in episodic memory</oboInOwl:hasExactSynonym>
        <rdfs:label>episodic memory impairment</rdfs:label>
    </owl:Class>
    


