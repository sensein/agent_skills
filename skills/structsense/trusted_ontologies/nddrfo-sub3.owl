    <!-- http://www.semanticweb.org/NDDRFO#preservation_of_independence_in_functional_abilities -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#preservation_of_independence_in_functional_abilities">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#behavioral_symptom"/>
        <obo:IAO_0000115>A symptom that entails mild problems performing complex functional tasks which they used to perform previously, such as paying bills, preparing a meal, or shopping. The person requires more time, is less efficient, and makes more errors at performing such activities than in the past. Nevertheless, the person generally maintains their independence of function in daily life.</obo:IAO_0000115>
        <obo:OGG_0000000030 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</obo:OGG_0000000030>
        <obo:hasDbXref>https://pubmed.ncbi.nlm.nih.gov/21514249/</obo:hasDbXref>
        <rdfs:label>preservation of independence in functional abilities</rdfs:label>
    </owl:Class>
    


