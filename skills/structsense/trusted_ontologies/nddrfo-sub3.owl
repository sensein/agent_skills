        <rdfs:isDefinedBy>Dystonia in one leg plus trunk or both legs.</rdfs:isDefinedBy>
        <rdfs:label>Crural dystonia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Current_drinker -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Current_drinker">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Alcohol"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/NDDRFO#beneficial_effect"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_9255"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/NDDRFO#harmful_effect"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/Parkinson_disease"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <PMID>PMID:22791740</PMID>
        <PMID>PMID:26952952</PMID>
        <PMID>PMID:28946566</PMID>
        <definition>An individual who drinks at least once per week with regularity.
http://purl.obolibrary.org/obo/NCIT_C126383</definition>
        <description>Alcohol consumption is associated with a reduced risk of ALS[0.52(0.4, 0.75)], further corroborating the role of lifestyle factors in the pathogenesis of ALS.</description>
        <description>Any alcoholic beverages: OR(95%CI): 5.00(2.84, 8.81)
PD was found to be positively associated with coffee and alcohol consumption.</description>
        <description>The risk of FTD was decreased by alcohol consumption (adj. OR 0.30, 95% CI 0.14-0.63); risk reduction was significant in current alcohol consumers (adj. OR 0.22, 95% CI 0.10-0.52).</description>
        <reference>Current drinker of alcohol</reference>
        <reference>NCIT:C126383</reference>
        <rdfs:label>Current drinker</rdfs:label>
    </owl:Class>
    


