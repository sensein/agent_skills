            </owl:Restriction>
        </rdfs:subClassOf>
        <PMID>PMID:24440006</PMID>
        <Synonyms>soybean food product</Synonyms>
        <definition>A seed of a soyabean plant (Glycine max).
A soybean food product is a product derived from the soybean plant.
http://purl.obolibrary.org/obo/FOODON_00002266</definition>
        <definition>Consumption of soy food products may contribute to the increasing incidence of Alzheimer&apos;s dementia and other dementiae.</definition>
        <reference>FOODON:00002266</reference>
        <rdfs:label>Soy food products</rdfs:label>
    </owl:Class>
    


