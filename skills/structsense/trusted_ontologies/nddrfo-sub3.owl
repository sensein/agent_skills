    <!-- http://www.semanticweb.org/NDDRFO#Incontinence -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Incontinence">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Non-motor_symptom_of_Parkinson_disease"/>
        <Ontology1296772722296:Reference>Mosley A.D., Romaine D.S. &amp; Samii A. (2010) The Encyclopedia of Parkinson&apos;s Disease. Infobase Publishing.</Ontology1296772722296:Reference>
        <rdfs:isDefinedBy>The inability to retain urine or feces. In the person with Parkinson’s, this usually results from the loss of muscle control of the sphincter muscles in the bladder and rectum, typically in later stages of the disease.</rdfs:isDefinedBy>
        <rdfs:label>Incontinence</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Infection -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Infection">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Disease"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/NDDRFO#harmful_effect"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_11949"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/NDDRFO#harmful_effect"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_332"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/NDDRFO#harmful_effect"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/Parkinson_disease"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/NDDRFO#harmful_effect"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/NDDRFO#Alzheimer_disease"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <Synonyms>Infection, NOS</Synonyms>
        <definition>The invasion of an organism&apos;s body tissues by disease-causing agents and their multiplication, as well as the reaction by the host to these organisms and/or toxins that the organisms produce.
http://purl.obolibrary.org/obo/NCIT_C128320</definition>
        <reference>NCIT:C128320</reference>
        <rdfs:label>Infection</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Inflammation -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Inflammation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Disease"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#general_symptom"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/NDDRFO#beneficial_effect"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_332"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/NDDRFO#harmful_effect"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/Parkinson_disease"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/NDDRFO#harmful_effect"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/NDDRFO#Alzheimer_disease"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <Synonyms>inflammatory</Synonyms>
        <definition>A finding of a localized protective response resulting from injury or destruction of tissues. Inflammation serves to destroy, dilute, or wall off both the injurious agent and the injured tissue. In the acute phase, inflammation is characterized by the signs of pain, heat, redness, swelling, and loss of function. Histologically, inflammation involves a complex series of events, including dilatation of arterioles, capillaries, and venules, with increased permeability and blood flow; exudation of fluids, including plasma proteins; and leukocyte migration into the site of inflammation. 
[url:http://purl.obolibrary.org/obo/NCIT_C3137]</definition>
        <reference>NCIT:C3137</reference>
        <rdfs:label>Inflammation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Influencing_factor -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Influencing_factor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#NDDRFO"/>
        <Synonyms>influencing factors</Synonyms>
        <definition>Other conditions with the power to have an effect on health status. 
[url:http://purl.obolibrary.org/obo/ExO_0000103]</definition>
        <reference>ExO:0000103</reference>
        <rdfs:label>Influencing factor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Inherited_dystonia -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Inherited_dystonia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Primary_dystonia"/>
        <Ontology1296772722296:Reference>Jankovic, J. J. T. E., &amp; Tolosa. (2007). Parkinson&apos;s disease and movement disorders. E. Tolosa (Ed.). Lippincott Williams &amp; Wilkins.</Ontology1296772722296:Reference>
        <rdfs:isDefinedBy>Dystonia that is passed on genetically from parent or ancestor to a child.</rdfs:isDefinedBy>
        <rdfs:label>Inherited dystonia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Intention_tremor -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Intention_tremor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Kinetic_tremor"/>
        <Ontology1296772722296:Reference>Jankovic, J. J. T. E., &amp; Tolosa. (2007). Parkinson&apos;s disease and movement disorders. E. Tolosa (Ed.). Lippincott Williams &amp; Wilkins.</Ontology1296772722296:Reference>
        <rdfs:isDefinedBy>Intention tremor is present when the amplitude increases during visually guided movements toward a target.</rdfs:isDefinedBy>
        <rdfs:label>Intention tremor</rdfs:label>
    </owl:Class>
    


