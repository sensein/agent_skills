    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Tomato -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Tomato">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Vegetable"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/NDDRFO#beneficial_effect"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/NDDRFO#Alzheimer_disease"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <PMID>PMID:33577362</PMID>
        <Synonyms>tomatoes</Synonyms>
        <definition>tomato, Solanum lycopersicum, is a plant whose fruit is an edible berry that is eaten as a vegetable. The tomato is a member of the nightshade family that includes tobacco, potato, and chili peppers. It originated from western South America, and may have been domesticated there or in Mexico.
http://purl.obolibrary.org/obo/NCIT_C72019
https://en.wikipedia.org/wiki/Tomato</definition>
        <description>development of promising nutritional strategies to increase the levels of tomato consumption for the prevention or treatment of AD and other dementias.</description>
        <reference>NCIT:C72019</reference>
        <rdfs:label>Tomato</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Torsion_dystonia -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Torsion_dystonia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Centralized_dystonia"/>
        <Ontology1296772722296:Reference>Jankovic, J. J. T. E., &amp; Tolosa. (2007). Parkinson&apos;s disease and movement disorders. E. Tolosa (Ed.). Lippincott Williams &amp; Wilkins.</Ontology1296772722296:Reference>
        <rdfs:isDefinedBy>Also known as dystonia musculorum deformans, is a disease characterized by painful muscle contractions resulting in uncontrollable distortions.</rdfs:isDefinedBy>
        <rdfs:label>Torsion dystonia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Tourette_Syndrome -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Tourette_Syndrome">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Heredodegenerative_Disorders,_Nervous_System"/>
        <Synonyms>Syndrome, Tourette</Synonyms>
        <Synonyms>Tourette Disease</Synonyms>
        <Synonyms>Tourette Disorder</Synonyms>
        <Synonyms>Tourette&apos;s Disease</Synonyms>
        <Synonyms>Tourette&apos;s Disorder</Synonyms>
        <Synonyms>Tourette&apos;s Syndrome</Synonyms>
        <Synonyms>Tourettes Disease</Synonyms>
        <Synonyms>Tourettes Disorder</Synonyms>
        <Synonyms>Tourettes Syndrome</Synonyms>
        <definition>A neuropsychological disorder related to alterations in DOPAMINE metabolism and neurotransmission involving frontal-subcortical neuronal circuits. Both multiple motor and one or more vocal tics need to be present with TICS occurring many times a day, nearly daily, over a period of more than one year. The onset is before age 18 and the disturbance is not due to direct physiological effects of a substance or another medical condition. The disturbance causes marked distress or significant impairment in social, occupational, or other important areas of functioning. (From DSM-IV, 1994; Neurol Clin 1997 May;15(2):357-79)
http://id.nlm.nih.gov/mesh/D005879</definition>
        <reference>mesh:D005879</reference>
        <rdfs:label>Tourette Syndrome</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Trace_element -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Trace_element">
