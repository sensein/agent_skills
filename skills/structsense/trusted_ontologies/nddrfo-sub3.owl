    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Sleep_attack -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Sleep_attack">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Sleep_disturbance"/>
