    <!-- http://www.semanticweb.org/NDDRFO#Keeping_a_pet -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Keeping_a_pet">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Habit"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/NDDRFO#beneficial_effect"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/Parkinson_disease"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/NDDRFO#harmful_effect"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_11949"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <Synonyms>Keep pets</Synonyms>
        <Synonyms>Keeping animals</Synonyms>
        <Synonyms>Keeps pets</Synonyms>
        <definition>A pet, or companion animal, is an animal kept primarily for a person&apos;s company or entertainment rather than as a working animal, livestock, or a laboratory animal. Popular pets are often considered to have attractive/cute appearances, intelligence, and relatable personalities, but some pets may be taken in on an altruistic basis (such as a stray animal) and accepted by the owner regardless of these characteristics.
https://en.wikipedia.org/wiki/Pet</definition>
        <definition>http://snomed.info/id/224152001</definition>
        <reference>SNOMED:224152001</reference>
        <rdfs:label>Keeping a pet</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Kinesia_paradoxica -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Kinesia_paradoxica">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Motor_symptom_of_Parkinson_disease"/>
        <Ontology1296772722296:Reference>Jankovic, J. (2008). Parkinson’s disease: clinical features and diagnosis. Journal of Neurology, Neurosurgery &amp; Psychiatry, 79(4), 368-376.</Ontology1296772722296:Reference>
        <Ontology1296772722296:synonyms>paradoxical kinesia</Ontology1296772722296:synonyms>
        <rdfs:isDefinedBy>Immobile patients who become excited may be able to make quick movement.</rdfs:isDefinedBy>
        <rdfs:label>Kinesia paradoxica</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Kinesigenic_dyskinesia -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Kinesigenic_dyskinesia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Paroxysmal_dyskinesia"/>
        <Ontology1296772722296:Reference>Hankey, G. J., &amp; Wardlaw, J. M. (2008). Clinical neurology. Manson publishing.</Ontology1296772722296:Reference>
        <Ontology1296772722296:synonyms>PKD</Ontology1296772722296:synonyms>
        <Ontology1296772722296:synonyms>paroxysmal kinesigenic choreoathetosis</Ontology1296772722296:synonyms>
        <Ontology1296772722296:synonyms>paroxysmal kinesigenic dyskinesia</Ontology1296772722296:synonyms>
        <rdfs:isDefinedBy>Abrupt onset of episodes of abnormal involuntary movements after a sudden voluntary movement. </rdfs:isDefinedBy>
        <rdfs:label>Kinesigenic dyskinesia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Kinesigenic_dystonia -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Kinesigenic_dystonia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Paroxysmal_dystonia"/>
        <Ontology1296772722296:Reference>Jankovic, J. J. T. E., &amp; Tolosa. (2007). Parkinson&apos;s disease and movement disorders. E. Tolosa (Ed.). Lippincott Williams &amp; Wilkins.</Ontology1296772722296:Reference>
        <Ontology1296772722296:synonyms>PKD</Ontology1296772722296:synonyms>
        <rdfs:isDefinedBy>An autosomal-dominant disorder with a significant variable expressivity and an apparent male predominance.The paroxysms are triggered by sudden movement and are usually short and can occur hundreds of times each day.</rdfs:isDefinedBy>
        <rdfs:label>Kinesigenic dystonia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Kinetic_tremor -->

