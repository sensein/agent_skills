    <!-- http://www.semanticweb.org/NDDRFO#beneficial_effect -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/NDDRFO#beneficial_effect">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/NDDRFO#contradictory_effect"/>
        <Synonyms>Factor, Protective</Synonyms>
        <Synonyms>Factors, Protective</Synonyms>
        <Synonyms>Protective Factor</Synonyms>
        <definition>An aspect of personal behavior or lifestyle, environmental exposure, or inborn or inherited characteristic, which, on the basis of epidemiologic evidence, is known to be associated with prevention or mitigation of a health-related condition considered important to prevent.
http://id.nlm.nih.gov/mesh/D065840</definition>
        <reference>mesh:D065840</reference>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/NDDRFO#caused_by -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/NDDRFO#caused_by">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/NDDRFO#Influencing_factor"/>
        <Synonyms>caused by</Synonyms>
        <label>caused_by</label>
        <reference>SCDO:1000202</reference>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/NDDRFO#contradictory_effect -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/NDDRFO#contradictory_effect">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/NDDRFO#harmful_effect -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/NDDRFO#harmful_effect">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


