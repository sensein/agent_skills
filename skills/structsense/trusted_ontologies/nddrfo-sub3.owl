    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#insomnia -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#insomnia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#general_symptom"/>
        <obo:IAO_0000115>Insomnia is a sleep disturbance characterized by prolonged and usually abnormal inability to obtain adequate sleep.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/symp.owl"/>
        <oboInOwl:hasDbXref>ICD9CM_2005:780.52</oboInOwl:hasDbXref>
