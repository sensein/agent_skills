        <Synonyms>Antihyperlipidemic</Synonyms>
        <Synonyms>Antihyperlipidemics</Synonyms>
        <Synonyms>Antilipemic Agents</Synonyms>
        <Synonyms>Antilipemic Drug</Synonyms>
        <Synonyms>Hypolipidemic Agents</Synonyms>
        <Synonyms>Hypolipidemic Drug</Synonyms>
        <definition>Substances that lower the levels of certain LIPIDS in the BLOOD. They are used to treat HYPERLIPIDEMIAS.
http://id.nlm.nih.gov/mesh/D000960</definition>
        <reference>mesh:D000960</reference>
        <rdfs:label>Lipid-lowering drugs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Lipopolysaccharide -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Lipopolysaccharide">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Nutrient_substance"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/NDDRFO#beneficial_effect"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/NDDRFO#Alzheimer_disease"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <Synonyms>LPS</Synonyms>
        <Synonyms>lipopolysaccharide (LPS)</Synonyms>
        <definition>An endotoxin and biologically active component of the Gram-negative bacterial cell wall that is a Toll-like receptor 4 (TLR4) agonist with potential immunostimulatory activity. Upon internalization, lipopolysaccharide (LPS) activates TLR4 which in turn activates the NFkappaB pathway, in addition to mitogen-activated protein kinases signaling pathways. This leads to the release of proinflammatory cytokines and stimulates an innate immune response against vaccine antigens.
http://purl.obolibrary.org/obo/NCIT_C101788</definition>
        <reference>NCIT:C101788</reference>
        <rdfs:label>Lipopolysaccharide</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Liquor -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Liquor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Alcohol"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/NDDRFO#harmful_effect"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/Parkinson_disease"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <PMID>PMID:23840473</PMID>
        <Synonyms>Liquor intake</Synonyms>
        <definition>An alcoholic beverage in which the initial fermentation mixture is distilled in order to concentrate the alcohol, generally resulting in a mixture that is at least 35% alcohol by volume.
http://purl.obolibrary.org/obo/NCIT_C66826</definition>
        <description>More than 26g/day: OR(95%CI): 1.28 (0.98, 1.67)
Low to moderate beer consumption with lower PD risk and greater liquor consumption with higher risk.</description>
        <reference>NCIT:C66826</reference>
        <rdfs:label>Liquor</rdfs:label>
    </owl:Class>
    


