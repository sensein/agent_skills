                <owl:onProperty rdf:resource="http://www.semanticweb.org/NDDRFO#harmful_effect"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/Parkinson_disease"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/NDDRFO#harmful_effect"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/NDDRFO#Alzheimer_disease"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <Synonyms>Agent, Antipsychotic</Synonyms>
        <Synonyms>Agent, Neuroleptic</Synonyms>
        <Synonyms>Antipsychotic</Synonyms>
        <Synonyms>Antipsychotic Agent</Synonyms>
        <Synonyms>Antipsychotic Agents</Synonyms>
        <Synonyms>Antipsychotic Drug</Synonyms>
        <Synonyms>Antipsychotic Drugs</Synonyms>
        <Synonyms>Antipsychotic Medication</Synonyms>
        <Synonyms>Antipsychotics</Synonyms>
        <Synonyms>Drug, Antipsychotic</Synonyms>
        <Synonyms>Drug, Neuroleptic</Synonyms>
        <Synonyms>Major Tranquilizer</Synonyms>
        <Synonyms>Major Tranquilizing Agents</Synonyms>
        <Synonyms>Medication, Antipsychotic</Synonyms>
        <Synonyms>Neuroleptic</Synonyms>
        <Synonyms>Neuroleptic Agent</Synonyms>
        <Synonyms>Neuroleptic Drug</Synonyms>
        <definition>Agents that control agitated psychotic behavior, alleviate acute psychotic states, reduce psychotic symptoms, and exert a quieting effect. They are used in SCHIZOPHRENIA; senile dementia; transient psychosis following surgery; or MYOCARDIAL INFARCTION; etc. These drugs are often referred to as neuroleptics alluding to the tendency to produce neurological side effects, but not all antipsychotics are likely to produce such effects. Many of these drugs may also be effective against nausea, emesis, and pruritus.
http://id.nlm.nih.gov/mesh/D014150</definition>
        <reference>mesh:D014150</reference>
        <rdfs:label>Neuroleptics</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Neuropsychiatric_dysfunction -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Neuropsychiatric_dysfunction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Non-motor_symptom_of_Parkinson_disease"/>
        <Ontology1296772722296:Reference>Jankovic, J. J. T. E., &amp; Tolosa. (2007). Parkinson&apos;s disease and movement disorders. E. Tolosa (Ed.). Lippincott Williams &amp; Wilkins.</Ontology1296772722296:Reference>
        <rdfs:isDefinedBy>A variety of alterations in mood, initiative, hedonistic tone, and cognitive functioning. </rdfs:isDefinedBy>
        <rdfs:label>Neuropsychiatric dysfunction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Non-kinesigenic_dyskinesia -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Non-kinesigenic_dyskinesia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Paroxysmal_dyskinesia"/>
        <Ontology1296772722296:Reference>Hankey, G. J., &amp; Wardlaw, J. M. (2008). Clinical neurology. Manson publishing.</Ontology1296772722296:Reference>
        <Ontology1296772722296:synonyms>PNKD</Ontology1296772722296:synonyms>
        <Ontology1296772722296:synonyms>nonkinesigenic dyskinesia</Ontology1296772722296:synonyms>
        <Ontology1296772722296:synonyms>paroxysmal nonkinesigenic dyskinesia</Ontology1296772722296:synonyms>
        <rdfs:isDefinedBy>Spontaneous onset of attacks of abnormal involuntary movements.</rdfs:isDefinedBy>
        <rdfs:label>Non-kinesigenic dyskinesia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Non-motor_symptom_of_Amyotrophic_lateral_sclerosis -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Non-motor_symptom_of_Amyotrophic_lateral_sclerosis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Symptom_of_Amyotrophic_lateral_sclerosis"/>
        <definition>Although ALS is characterized by progressive motor dysfunction, nonmotor features accompany motor dysfunction in up to 50 percent of patients at diagnosis.
https://www.uptodate.com/contents/clinical-features-of-amyotrophic-lateral-sclerosis-and-other-forms-of-motor-neuron-disease#H3992271448</definition>
        <rdfs:label>Non-motor symptom of Amyotrophic lateral sclerosis</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Non-motor_symptom_of_Parkinson_disease -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Non-motor_symptom_of_Parkinson_disease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Symptom_of_Parkinson_disease"/>
        <Synonyms>non-motor features</Synonyms>
        <Synonyms>non-motor impairment</Synonyms>
        <Synonyms>non-motor symptoms</Synonyms>
        <Synonyms>pre-motor stage</Synonyms>
        <Synonyms>premotor stage</Synonyms>
        <reference>Jankovic, J. (2008). Parkinson’s disease: clinical features and diagnosis. Journal of Neurology, Neurosurgery &amp; Psychiatry, 79(4), 368-376.</reference>
        <rdfs:isDefinedBy>Non-motor symptoms are a common and under appreciated feature of PD. These include autonomic dysfunction, cognitive/neurobehavioral disorders, and sensory and sleep abnormalities.</rdfs:isDefinedBy>
        <rdfs:label>Non-motor symptom of Parkinson disease</rdfs:label>
    </owl:Class>
    


