    <!-- http://www.semanticweb.org/NDDRFO#Amino_acids -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Amino_acids">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Nutrient_substance"/>
