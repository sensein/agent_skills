    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Isolated_chin_tremor -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Isolated_chin_tremor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Other_essential_tremor"/>
        <Ontology1296772722296:Reference>Jankovic, J. J. T. E., &amp; Tolosa. (2007). Parkinson&apos;s disease and movement disorders. E. Tolosa (Ed.). Lippincott Williams &amp; Wilkins.</Ontology1296772722296:Reference>
        <rdfs:isDefinedBy>It is a rare, autosomal dominant hereditary tremor syndrome characterized by attacks of high-frequency tremor of the mentalis muscles or of the chin. </rdfs:isDefinedBy>
        <rdfs:label>Isolated chin tremor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Isolated_voice_tremor -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Isolated_voice_tremor">
