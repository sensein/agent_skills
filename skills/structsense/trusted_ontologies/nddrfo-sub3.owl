        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Neuropsychiatric_dysfunction"/>
        <Ontology1296772722296:Reference>Dodd, M. L., Klos, K. J., Bower, J. H., Geda, Y. E., Josephs, K. A., &amp; Ahlskog, J. E. (2005). Pathological gambling caused by drugs used to treat Parkinson disease. Archives of Neurology, 62(9), 1377.</Ontology1296772722296:Reference>
        <rdfs:isDefinedBy>Pathological gambling is a rare potential complication related to treatment of Parkinson disease (PD).</rdfs:isDefinedBy>
        <rdfs:label>Pathological gambling</rdfs:label>
    </owl:Class>
    


