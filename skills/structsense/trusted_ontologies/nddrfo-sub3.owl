    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#digestive_system_symptom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Sytmptom_of_Alzheimer_disease"/>
