                <owl:onProperty rdf:resource="http://www.semanticweb.org/NDDRFO#harmful_effect"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_4752"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>chromosome 5</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#chromosome_9p21.3 -->

