        <rdfs:label>Parkinsonism and supranuclear gaze palsy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Paroxysmal_dyskinesia -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Paroxysmal_dyskinesia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Dyskinesia"/>
        <Ontology1296772722296:Reference>Kompoliti K. &amp; Metman L. V. (2010) The Encyclopedia of Movement Disorders. Academic Press.</Ontology1296772722296:Reference>
        <Ontology1296772722296:synonyms>paroxysmal dyskinesias</Ontology1296772722296:synonyms>
        <rdfs:isDefinedBy>A heterogeneous group of disorders characterized by intermittent attacks of hyperkinetic involuntary movements.</rdfs:isDefinedBy>
        <rdfs:label>Paroxysmal dyskinesia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Paroxysmal_dystonia -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Paroxysmal_dystonia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Fluctuating_dystonia"/>
        <Ontology1296772722296:Reference>Jankovic, J. J. T. E., &amp; Tolosa. (2007). Parkinson&apos;s disease and movement disorders. E. Tolosa (Ed.). Lippincott Williams &amp; Wilkins.</Ontology1296772722296:Reference>
        <rdfs:isDefinedBy>Episodic movement disorder in which abnormal movements are only present during attacks.</rdfs:isDefinedBy>
        <rdfs:label>Paroxysmal dystonia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Pathological_gambling -->

