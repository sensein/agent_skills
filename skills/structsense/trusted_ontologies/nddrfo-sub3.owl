        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/NDDRFO#contradictory_effect"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_332"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
