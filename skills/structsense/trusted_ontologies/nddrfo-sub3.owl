    <!-- http://www.semanticweb.org/NDDRFO#Resistance_Training -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Resistance_Training">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Physical_activity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/NDDRFO#beneficial_effect"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/Parkinson_disease"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/NDDRFO#beneficial_effect"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/NDDRFO#Alzheimer_disease"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <Synonyms>Exercise Program, Weight-Bearing</Synonyms>
        <Synonyms>Exercise Program, Weight-Lifting</Synonyms>
        <Synonyms>Strengthening Program, Weight-Bearing</Synonyms>
        <Synonyms>Training, Resistance</Synonyms>
        <definition>A type of strength-building exercise program that requires the body muscle to exert a force against some form of resistance, such as weight, stretch bands, water, or immovable objects. Resistance exercise is a combination of static and dynamic contractions involving shortening and lengthening of skeletal muscles.
http://id.nlm.nih.gov/mesh/D055070</definition>
        <reference>mesh:D055070</reference>
        <rdfs:label>Resistance Training</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Respiratory_impairment -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Respiratory_impairment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Motor_symptom_of_Amyotrophic_lateral_sclerosis"/>
        <definition>Weakness of the diaphragm in ALS produces progressive dyspnea leading to orthopnea and decreased vocal volume and culminating in dyspnea with talking and eventually also at rest. Sleep-disordered breathing is an early sign of neuromuscular respiratory insufficiency.
Diaphragmatic muscle weakness can lead to respiratory failure, the most common life-threatening manifestation of the disorder.
https://www.uptodate.com/contents/clinical-features-of-amyotrophic-lateral-sclerosis-and-other-forms-of-motor-neuron-disease#H3992271448</definition>
        <rdfs:label>Respiratory impairment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Resting_tremor -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Resting_tremor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Parkinsonian_tremor"/>
        <Ontology1296772722296:Reference>Jankovic, J. J. T. E., &amp; Tolosa. (2007). Parkinson&apos;s disease and movement disorders. E. Tolosa (Ed.). Lippincott Williams &amp; Wilkins.</Ontology1296772722296:Reference>
        <Ontology1296772722296:synonyms>Type II tremor</Ontology1296772722296:synonyms>
        <rdfs:isDefinedBy>Resting tremor occurs in a body part that is not voluntarily activatedand is completely supported against gravity.</rdfs:isDefinedBy>
        <rdfs:label>Resting tremor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Restless_legs_syndrome -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Restless_legs_syndrome">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Sleep_disturbance"/>
        <Ontology1296772722296:Reference>Mosley A.D., Romaine D.S. &amp; Samii A. (2010) The Encyclopedia of Parkinson&apos;s Disease. Infobase Publishing.</Ontology1296772722296:Reference>
        <Ontology1296772722296:synonyms>RLS</Ontology1296772722296:synonyms>
        <Ontology1296772722296:synonyms>leg restlessness</Ontology1296772722296:synonyms>
        <rdfs:isDefinedBy>A condition in which the legs twitch involuntarily usually when sitting or lying quietly at rest. It may be mild, with occasional tingling and small areas of twitching, or severe enough that the legs appear to be walking or running of their own volition.</rdfs:isDefinedBy>
        <rdfs:label>Restless legs syndrome</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Retropulsion -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Retropulsion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Gait_disturbance"/>
        <Ontology1296772722296:Reference>Mosley, A. D., Romaine, D. S., &amp; Samii, A. (2010). The Encyclopedia of Parkinson&apos;s Disease. Infobase Publishing.</Ontology1296772722296:Reference>
        <rdfs:isDefinedBy>Retropulsion is the tendency to step back.</rdfs:isDefinedBy>
        <rdfs:label>Retropulsion</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Rigidity -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Rigidity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Motor_symptom_of_Parkinson_disease"/>
        <Ontology1296772722296:Reference>Jankovic, J. (2008). Parkinson’s disease: clinical features and diagnosis. Journal of Neurology, Neurosurgery &amp; Psychiatry, 79(4), 368-376.</Ontology1296772722296:Reference>
        <rdfs:isDefinedBy>Rigidity is characterised by increased resistance, usually accompanied by the “cogwheel” phenomenon, particularly when associated with an underlying tremor, present throughout the range of passive movement of a limb (flexion, extension or rotation about a joint). It may occur proximally (eg, neck, shoulders, hips) and distally (eg, wrists, ankles).</rdfs:isDefinedBy>
        <rdfs:label>Rigidity</rdfs:label>
    </owl:Class>
    


