        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Influencing_factor"/>
        <Synonyms>Lifestyle</Synonyms>
        <definition>A manner of living that reflects the person&apos;s values and attitudes.
http://purl.obolibrary.org/obo/NCIT_C16795</definition>
        <definition>The consideration of unspecified lifestyle factors as variables in disease incident, transmission, and control.
http://purl.obolibrary.org/obo/NCIT_C20201</definition>
        <reference>Life style</reference>
        <reference>Lifestyle Factor</reference>
        <reference>NCIT:C16795</reference>
        <reference>NCIT:C20201</reference>
        <rdfs:label>Lifestyle factor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Light-moderate_alcohol_drinker -->

