        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Dairy_products"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/NDDRFO#harmful_effect"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/Parkinson_disease"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <PMID>PMID:12447934</PMID>
        <Synonyms>cheese</Synonyms>
        <Synonyms>cream cheese spread</Synonyms>
        <definition>Soft unripened cheese made of sweet milk and cream
http://snomed.info/id/226849005</definition>
        <description>&gt;1 servings/week: RR(95%CI): 1.7 (1.0, 2.9)
Among men, PD risk increased significantly with greater intakes of cream cheese, other cheese, and sour cream, and marginally with skim or low fat milk intake</description>
        <reference>SNOMED:226849005</reference>
        <rdfs:label>Cream cheese</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#Crural_dystonia -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Crural_dystonia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Segmental_dystonia"/>
