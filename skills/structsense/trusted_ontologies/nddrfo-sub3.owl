    <!-- http://www.semanticweb.org/NDDRFO#Sour_cream -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#Sour_cream">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Dairy_products"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/NDDRFO#harmful_effect"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/Parkinson_disease"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <PMID>PMID:12447934</PMID>
        <Synonyms>soured cream</Synonyms>
        <definition>SIREN DB annotation: * semisolid with smooth consistency FOODON:03430119 * partially heat-treated FOODON:03440018 * cream food product FOODON:00001216 * lactic acid fermentation process FOODON:03460101 * food homogenization or emulsification process FOODON:03460306 * pasteurization by heating FOODON:03470135
http://purl.obolibrary.org/obo/FOODON_03302515</definition>
        <description>&gt;1 servings/week: RR(95%CI): 1.7 (1.0, 2.9)
Among men, PD risk increased significantly with greater intakes of cream cheese, other cheese, and sour cream, and marginally with skim or low fat milk intake</description>
        <reference>FOODON:03302515</reference>
        <rdfs:label>Sour cream</rdfs:label>
    </owl:Class>
    


