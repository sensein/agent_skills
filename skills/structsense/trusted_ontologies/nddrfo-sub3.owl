        <definition>A chromosome band present on 9p.
http://purl.obolibrary.org/obo/NCIT_C26056</definition>
        <reference>NCIT:C26056</reference>
        <rdfs:label>chromosome_9p21.3</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#chronic_intracranial_subdural_hematoma -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#chronic_intracranial_subdural_hematoma">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#Cerebrovascular_disease"/>
        <Synonyms>chronic intracranial subdural haematomac</Synonyms>
        <Synonyms>chronic subdural hematoma</Synonyms>
        <reference>OMIT:0020116</reference>
        <reference>SNOMED:304831001</reference>
