    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#heartburn -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#heartburn">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#pain"/>
        <obo:IAO_0000115>Heartburn is a pain characterized by a painful burning feeling in your chest or throat that happens when stomach acid backs up into your esophagus.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/symp.owl"/>
        <oboInOwl:hasExactSynonym>acid indigestion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000439</oboInOwl:id>
        <rdfs:label>heartburn</rdfs:label>
    </owl:Class>
    


