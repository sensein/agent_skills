        <rdfs:label>digestive system symptom</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/NDDRFO#dizziness -->

    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#dizziness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#neurological_and_physiological_symptom"/>
        <obo:IAO_0000115>Dizziness is a neurological and physiological symptom characterized by a sensation of unsteadiness accompanied by a feeling of movement within the head.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/symp.owl"/>
        <oboInOwl:hasDbXref>ICD9CM_2005:780.4</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0476206</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0243727</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>dizzy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000610</oboInOwl:id>
        <rdfs:label>dizziness</rdfs:label>
    </owl:Class>
    


