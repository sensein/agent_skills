        </rdfs:subClassOf>
        <Synonyms>amino acids</Synonyms>
        <reference>XCO:0000119</reference>
        <rdfs:label>Amino acids</rdfs:label>
        <rdfs:label>This is any condition in which the main influencing factor is an amino acid, any naturally occurring or synthetic organic compound containing an amino group, a carboxylic acid group and a side chain. An amino acid may be administered as a nutritional supplement or as a drug.
http://purl.obolibrary.org/obo/XCO_0000119</rdfs:label>
    </owl:Class>
    


