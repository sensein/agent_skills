        <Synonyms>job</Synonyms>
        <Synonyms>occupation</Synonyms>
        <definition>The principal activity that a person does to earn money. 
[url:http://purl.obolibrary.org/obo/NCIT_C25193]</definition>
        <reference>NCIT:C25193</reference>
        <rdfs:label>Occupation</rdfs:label>
    </owl:Class>
    


