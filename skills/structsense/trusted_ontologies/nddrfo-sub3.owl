     xmlns:Ontology1296772722296="http://www.semanticweb.org/ontologies/2011/1/Ontology1296772722296.owl#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/NDDRFO">
        <owl:versionIRI rdf:resource="http://www.semanticweb.org/NDDRFO/1.0.0"/>
        <dc:creator>Cheng Bi</dc:creator>
        <dc:description>Neurodegenerative Diseases Risk Factor Ontology (NDDRFO) is a disease-specific ontology that characterizes the knowledge field of risk factors for neurodegenerative diseases.</dc:description>
        <dc:language>En</dc:language>
        <dc:title>Neurodegenerative Diseases Risk Factor Ontology (NDDRFO)</dc:title>
        <owl:versionInfo>V1.0.0</owl:versionInfo>
    </owl:Ontology>
    


