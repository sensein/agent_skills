    <owl:Class rdf:about="http://www.semanticweb.org/NDDRFO#GAL3ST1">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/NDDRFO#protein-coding_gene"/>
        <rdfs:subClassOf>
