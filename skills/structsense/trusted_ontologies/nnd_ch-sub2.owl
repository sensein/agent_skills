    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/Weight_loss"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/definition"/>
        <owl:annotatedTarget>Description: “Several neurologic illnesses, including stroke, dementia, Parkinson disease, and amyotrophic lateral sclerosis, can lead to weight loss. Weight loss may be due to one or more deficits, such as altered cognition, motor dysfunction, and dysphagia, associated with these disorders”.</owl:annotatedTarget>
        <rdfs:citation>Evans A, Gupta R. Approach to the patient with unintentional weight loss. UpToDate. 2016. https://www.uptodate.com/contents/approach-to-the-patient-with-unintentional-weight-loss. Published 2021. Accessed.</rdfs:citation>
    </owl:Axiom>
