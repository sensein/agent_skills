     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#"
     xmlns:NND-clinical_history="http://purl.obolibrary.org/obo/http://www.semanticweb.org/irholtman/ontologies/2023/NND-clinical_history#">
