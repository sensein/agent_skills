        <Synonym>nucleus ventralis anterior</Synonym>
        <Synonym>nucleus ventralis anterior (DeWulf)</Synonym>
        <Synonym>pars parvicellularis</Synonym>
        <Synonym>parvicellular part</Synonym>
        <Synonym>ventral anterior thalamic nucleus</Synonym>
        <reference>http://neurolex.org/wiki/Category:Parvicellular_part_of_ventral_anterior_nucleus</reference>
        <rdfs:label>Parvicellular part of ventral anterior nucleus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Parvicellular_part_of_ventral_posteromedial_nucleus -->

