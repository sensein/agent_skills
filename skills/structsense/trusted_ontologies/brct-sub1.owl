        <Synonym>lateral vestibular nucleus (Deiters)</Synonym>
        <Synonym>nucleus of Deiters</Synonym>
        <reference>http://neurolex.org/wiki/Category:Lateral_vestibular_nucleus</reference>
        <rdfs:label>Lateral vestibular nucleus</rdfs:label>
    </owl:Class>
    


