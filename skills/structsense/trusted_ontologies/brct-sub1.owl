        <Synonym>commissure of Gudden</Synonym>
        <reference>http://neurolex.org/wiki/Category:Ventral_supraoptic_decussation</reference>
        <rdfs:label>Ventral supraoptic decussation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Ventral_tegmental_area -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Ventral_tegmental_area">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Midbrain_tegmentum"/>
        <Synonym>ventral tegmental area of Tsai</Synonym>
        <Synonym>ventromedial mesencephalic tegmentum</Synonym>
        <reference>http://neurolex.org/wiki/Category:Ventral_tegmental_area</reference>
        <rdfs:isDefinedBy>Unpaired midbrain region situated in the ventromedial portion of the reticular formation. The VTA is medial to the substantia nigra and ventral to the red nucleus, and extends caudally from the posterior hypothalamus in the diencephalon. The VTA contains dopamine neurons that project to various limbic and cortical areas and is a critical component of the brain&apos;s reward circuitry</rdfs:isDefinedBy>
        <rdfs:label>Ventral tegmental area</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Ventral_tegmental_area_dopamine_neuron -->

