        <reference>http://umcd.humanconnectomeproject.org/umcd/default/index</reference>
        <rdfs:label>Frontal pole cortex to rostral middle frontal cortex</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Fronto-orbital_gyrus -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Fronto-orbital_gyrus">
