        <Synonym>glia</Synonym>
        <Synonym>neuroglial cell</Synonym>
        <reference>http://neurolex.org/wiki/Category:CNS_glial_cell</reference>
        <rdfs:isDefinedBy>Any glial cell (FBbt_00005144) that is part of some central nervous system (FBbt_00005094).</rdfs:isDefinedBy>
        <rdfs:label>Glial cell</rdfs:label>
    </owl:Class>
    


