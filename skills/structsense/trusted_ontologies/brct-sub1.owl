    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Caudal_middle_frontal_gyrus -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Caudal_middle_frontal_gyrus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Frontal_lobe"/>
        <reference>http://neurolex.org/wiki/Category:Caudal_middle_frontal_gyrus</reference>
        <rdfs:isDefinedBy>Component of the middl frontal gyrus. The rostral boundary of the middle frontal gyrus was the rostral extent of the middle frontal gyrus whereas the caudal boundary was the precentral gyrus. The medial and lateral boundaries were designated as the superior frontal sulcus and the inferior frontal sulcus respectively (Christine Fennema-Notestine).</rdfs:isDefinedBy>
        <rdfs:label>Caudal middle frontal gyrus</rdfs:label>
    </owl:Class>
    


