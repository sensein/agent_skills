    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Neocortex_Dorsolateral_prefrontal_area_layer_3_glutamatergic_cell -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Neocortex_Dorsolateral_prefrontal_area_layer_3_glutamatergic_cell">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Dorsolateral_prefrontal_cortex_layer_3"/>
        <reference>http://neurolex.org/wiki/Category:Neocortex_Dorsolateral_prefrontal_area_layer_3_glutamatergic_cell</reference>
        <rdfs:isDefinedBy>This basic type of glutamatergic neuron in the layer 3 of human dorsolateral prefrontal cortex is characterized by both pyramidal and non-pyramidal morphologies. The pyramidal morphology is more common in deep layer 3 and shows dense spines while the non-pyramidal glutamatergic cells show fusiform morphology. Both the pyramidal and non-pyramidal cells stain positive for specific glutamatergic markers</rdfs:isDefinedBy>
        <rdfs:label>Neocortex Dorsolateral prefrontal area layer 3 glutamatergic cell</rdfs:label>
    </owl:Class>
    


