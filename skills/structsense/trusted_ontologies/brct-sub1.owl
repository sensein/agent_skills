        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Neocortex"/>
        <reference>http://neurolex.org/wiki/Category:Parietal_cortex</reference>
        <rdfs:isDefinedBy>Gray matter of the parietal region of the neocortex, located in the parietal lobe of gyrencephalic animals. It is continuous anteriorly with the frontal cortex, posteriorly with the occipital cortex and medially with the insular cortex and with the temporal cortex on the posterior/inferior border.</rdfs:isDefinedBy>
        <rdfs:label>Parietal cortex</rdfs:label>
    </owl:Class>
    


