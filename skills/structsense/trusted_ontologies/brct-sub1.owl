        <Synonym>Sulcus parietooccipitalis</Synonym>
        <Synonym>parieto-occipital fissure</Synonym>
        <Synonym>parieto-occipital incisure</Synonym>
        <Synonym>parietooccipital sulcus</Synonym>
        <reference>http://neurolex.org/wiki/Category:Parieto-occipital_sulcus</reference>
        <rdfs:label>Parieto-occipital sulcus</rdfs:label>
    </owl:Class>
    


