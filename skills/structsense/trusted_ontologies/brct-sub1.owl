        <Synonym>Sulcus parieto-occipitalis anterior</Synonym>
        <Synonym>medial parieto-occipital fissure</Synonym>
        <reference>http://neurolex.org/wiki/Category:Anterior_parieto-occipital_sulcus</reference>
        <rdfs:label>Anterior parieto-occipital sulcus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Anterior_parolfactory_sulcus -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Anterior_parolfactory_sulcus">
