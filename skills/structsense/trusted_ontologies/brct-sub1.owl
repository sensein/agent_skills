        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Projection"/>
        <Species>Macaca mulatta</Species>
        <reference>brainmaps.org</reference>
        <rdfs:label>Cortical area 3a to dorsal horn</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#cortical_area_3b -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#cortical_area_3b">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Projection"/>
        <Projection_strength>Moderate</Projection_strength>
        <Species>Macaca mulatta</Species>
        <reference>brainmaps.org</reference>
        <rdfs:label>Cortical area 3b to cortical areas 1 and 2</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#cortical_areas_1_and_2_to_dorsal_horn -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#cortical_areas_1_and_2_to_dorsal_horn">
