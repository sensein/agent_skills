        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Axosomatic_synapse"/>
        <Synonym>calyx of held</Synonym>
        <reference>http://www.annualreviews.org/doi/abs/10.1146/annurev-physiol-020911-153236?journalCode=physiol</reference>
        <rdfs:isDefinedBy>The calyx of Held synapse is a giant axosomatic synapse in the auditory brainstem that functions as a fast, inverting, relay synapse.</rdfs:isDefinedBy>
        <rdfs:label>Calyx of Held synapse</rdfs:label>
    </owl:Class>
    


