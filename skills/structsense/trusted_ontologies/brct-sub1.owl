        <Synonym>Gyrus occipitotemporalis lateralis</Synonym>
        <Synonym>lateral occipito-temporal gyrus</Synonym>
        <Synonym>lateral occipitotemporal gyrus</Synonym>
        <Synonym>occipitotemporal gyrus</Synonym>
        <reference>http://neurolex.org/wiki/Category:Fusiform_gyrus</reference>
        <rdfs:label>Fusiform gyrus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Genu_of_corpus_callosum -->

