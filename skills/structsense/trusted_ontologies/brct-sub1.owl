        <Synonym> layer V of neocortex</Synonym>
        <Synonym>internal pyramidal cell layer of neocortex</Synonym>
        <Synonym>layer 5</Synonym>
        <Synonym>layer 5 of neocortex</Synonym>
        <Synonym>neocortex internal pyramidal cell layer</Synonym>
        <Synonym>neocortex layer V</Synonym>
        <Synonym>neocortical layer 5</Synonym>
        <Synonym>neocortical layer V</Synonym>
        <reference>http://neurolex.org/wiki/Category:Neocortex_layer_5</reference>
        <rdfs:isDefinedBy>Layer of neocortex lying deep to the internal granule cell layer (layer 4) defined cytoarchitecturally by the predominance of large pyramidal cell bodies</rdfs:isDefinedBy>
        <rdfs:label>Neocortex layer 5</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Neocortex_layer_5A -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Neocortex_layer_5A">
