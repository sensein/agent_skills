    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Caudate_to_thalamus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Projection"/>
        <Projection_strength>61</Projection_strength>
        <Species>Homo sapiens</Species>
        <reference>http://umcd.humanconnectomeproject.org/umcd/default/index</reference>
        <rdfs:label>Caudate to thalamus</rdfs:label>
    </owl:Class>
    


