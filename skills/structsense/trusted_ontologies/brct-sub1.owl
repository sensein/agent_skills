        <rdfs:label>Medial forebrain</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_forebrain_bundle -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_forebrain_bundle">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Hypothalamus"/>
        <reference>http://neurolex.org/wiki/Category:Medial_forebrain_bundle</reference>
        <rdfs:label>Medial forebrain bundle</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_geniculate_body -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_geniculate_body">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Metathalamus"/>
        <Synonym>corpus geniculatum mediale</Synonym>
        <Synonym>medial geniculate complex</Synonym>
        <Synonym>medial geniculate nucleus</Synonym>
        <reference>http://neurolex.org/wiki/Category:Medial_geniculate_body</reference>
        <rdfs:isDefinedBy>Nuclear complex of the thalamus situated on the caudal, subpial aspect of the thalamus.</rdfs:isDefinedBy>
        <rdfs:label>Medial geniculate body</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_geniculate_body_lateral_nucleus -->

