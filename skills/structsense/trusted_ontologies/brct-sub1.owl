        <Synonym>nucleus anterior thalami dorsalis</Synonym>
        <Synonym>nucleus anterodorsalis</Synonym>
        <Synonym>nucleus anterodorsalis (Hassler)</Synonym>
        <Synonym>nucleus anterodorsalis thalami</Synonym>
        <Synonym>nucleus anterosuperior</Synonym>
        <Synonym>nucleus thalamicus anterodorsalis</Synonym>
        <reference>http://neurolex.org/wiki/Category:Anterodorsal_nucleus</reference>
