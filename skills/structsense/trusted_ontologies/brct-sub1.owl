        <Synonym>Nucleus accumbens core</Synonym>
        <reference>http://neurolex.org/wiki/Category:Core_of_nucleus_accumbens</reference>
        <rdfs:label>Core of nucleus accumbens</rdfs:label>
    </owl:Class>
    


