        <Species>Macaca mulatta</Species>
        <reference>brainmaps.org</reference>
        <rdfs:label>Primary visual cortex to dorsal lateral geniculate nucleus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Primary_visual_cortex_to_reticular_nucleus_of_thalamus -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Primary_visual_cortex_to_reticular_nucleus_of_thalamus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Projection"/>
        <Species>Macaca mulatta</Species>
        <reference>brainmaps.org</reference>
        <rdfs:label>Primary visual cortex to reticular nucleus of thalamus</rdfs:label>
    </owl:Class>
    


