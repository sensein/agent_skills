    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Ventral_striatum -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Ventral_striatum">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Striatum"/>
        <reference>http://neurolex.org/wiki/Category:Ventral_striatum</reference>
        <rdfs:isDefinedBy>A composite structure of the telencephalon that is defined in the striatopallidal system by connectivity and neurochemical staining. It includes the nucleus accumbens, the most ventral portions of the caudate nucleus and the putamen, the rostrolateral portion of the anterior perforated substance, the islands of Calleja and a rostral subcommissural portion of substantia innominata. The boundary between the ventral striatum and dorsal striatum is indistinct in sections stained for Nissl substance (Heimer-1995; adapted from Brain Info).</rdfs:isDefinedBy>
        <rdfs:label>Ventral striatum</rdfs:label>
    </owl:Class>
    


