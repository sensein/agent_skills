    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Caudal_anterior_cingulate_cortex -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Caudal_anterior_cingulate_cortex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Anterior_cingulate_cortex"/>
        <reference>http://neurolex.org/wiki/Category:Caudal_anterior_cingulate_cortex</reference>
        <rdfs:isDefinedBy>Component of the cingulate cortex. The rostral boundary was the first appearance of the genu of the corpus callosum whereas the caudal boundary was established as the first appearance of the mammillary bodies. The medial boundary was the medial aspect of the cortex. The supero-lateral boundary was the superior frontal gyrus whereas the infero-lateral boundary was the corpus callosum (Christine Fennema-Notestine).</rdfs:isDefinedBy>
        <rdfs:label>Caudal anterior cingulate cortex</rdfs:label>
    </owl:Class>
    


