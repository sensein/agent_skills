        <reference>http://neurolex.org/wiki/Category:Medial_pontine_reticular_formation</reference>
        <rdfs:label>Medial pontine reticular formation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_precentral_sulcus -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_precentral_sulcus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Suclus"/>
        <reference>http://neurolex.org/wiki/Category:Medial_precentral_sulcus</reference>
        <rdfs:isDefinedBy>Sulcus of the frontal lobe that extends from the dorsal surface onto the medial surface of the superior frontal gyrus (Ono-90). </rdfs:isDefinedBy>
        <rdfs:label>Medial precentral sulcus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_prefrontal_cortex -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_prefrontal_cortex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Prefrontal_cortex"/>
        <reference>http://neurolex.org/wiki/Category:Medial_prefrontal_cortex</reference>
        <rdfs:isDefinedBy>Region of prefrontal cortex comprising the rostral insular cortex and the rostromedial tip of the cingulate gyrus, also referred to as the infrslimbic and prelimbic areas</rdfs:isDefinedBy>
        <rdfs:label>Medial prefrontal cortex</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_pulvinar -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_pulvinar">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Pulvinar"/>
        <reference>http://neurolex.org/wiki/Category:Medial_pulvinar</reference>
        <rdfs:label>Medial pulvinar</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_pulvinar_nucleus -->

