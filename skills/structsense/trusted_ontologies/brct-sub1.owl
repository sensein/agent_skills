        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Striatum"/>
        <Synonym>Caudate</Synonym>
        <reference>http://neurolex.org/wiki/Category:Caudate_nucleus</reference>
        <rdfs:isDefinedBy>Subcortical nucleus of telecephalic origin consisting of an elongated gray mass lying lateral to and bordering the lateral ventricle. It is divided into a head, body and tail in some species.</rdfs:isDefinedBy>
        <rdfs:label>Caudate nucleus</rdfs:label>
    </owl:Class>
    


