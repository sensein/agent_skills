        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Superior_olive"/>
        <reference>http://neurolex.org/wiki/Category:Lateral_superior_olivary_nucleus</reference>
        <rdfs:isDefinedBy>One of two recognized nuclei comprising the superior olive. The lateral superior olivary nucleus is much less prominent in humans than in many rodents and carnivores. In the latter species, it is frequently described as S- or V-shaped</rdfs:isDefinedBy>
        <rdfs:label>Lateral superior olivary nucleus</rdfs:label>
    </owl:Class>
    


