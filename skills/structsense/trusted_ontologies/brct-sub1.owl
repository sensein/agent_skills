    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Corona_radiata -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Corona_radiata">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Telencephalon"/>
        <reference>http://neurolex.org/wiki/Category:Corona_radiata</reference>
        <rdfs:isDefinedBy>Fan shaped white matter mass comprised of afferent and efferent fibers from the cerebral cortex arranged in radially arrayed bundles, converging towards the internal capsule</rdfs:isDefinedBy>
        <rdfs:label>Corona radiata</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Corpus_callosum -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Corpus_callosum">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Telencephalon"/>
        <reference>http://neurolex.org/wiki/Category:Corpus_callosum</reference>
        <rdfs:isDefinedBy>White matter structure containing massive numbers of commissural fibers connecting cortical areas in the two cerebral hemispheres.it is subdivided into a genu, a rostrum, a body, and a splenium. (MM)</rdfs:isDefinedBy>
        <rdfs:label>Corpus callosum</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Cortex_insula_to_caudate -->

