        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Pulvinar"/>
        <Synonym> nucleus pulvinaris thalami</Synonym>
        <Synonym>nucleus pulvinaris medialis</Synonym>
        <Synonym>nucleus pulvinaris medialis thalami</Synonym>
        <Synonym>pars medialis</Synonym>
        <reference>http://neurolex.org/wiki/Category:Medial_pulvinar_nucleus</reference>
        <rdfs:label>Medial pulvinar nucleus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_septum -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_septum">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Septum"/>
        <reference>http://neurolex.org/wiki/Category:Medial_septum</reference>
        <rdfs:label>Medial septum</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_striatum -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_striatum">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Striatum"/>
        <Synonym>lobus parolfactorius</Synonym>
        <reference>http://neurolex.org/wiki/Category:Medial_striatum</reference>
        <rdfs:label>Medial striatum</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_subnucleus_of_solitary_tract -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_subnucleus_of_solitary_tract">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Solitary_nucleus"/>
        <Synonym>nucleus of the solitary tract, medial part</Synonym>
        <reference>http://neurolex.org/wiki/Category:Medial_subnucleus_of_solitary_tract</reference>
        <rdfs:label>Medial subnucleus of solitary tract</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_substantia_nigra_pars_compacta -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_substantia_nigra_pars_compacta">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Substantia_nigra_pars_compacta"/>
        <reference>http://neurolex.org/wiki/Category:Medial_substantia_nigra_pars_compacta</reference>
        <rdfs:label>Medial substantia nigra pars compacta</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_superior_colliculus -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_superior_colliculus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Superior_colliculus"/>
        <reference>http://neurolex.org/wiki/Category:Medial_superior_colliculus</reference>
        <rdfs:label>Medial superior colliculus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_superior_olivary_nucleus -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_superior_olivary_nucleus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Superior_olive"/>
        <reference>http://neurolex.org/wiki/Category:Medial_superior_olivary_nucleus</reference>
        <rdfs:isDefinedBy>One of two subnuclei of the superior olive located within the caudal pontine tegmentum. Appears as a parasagittal row of transversely oriented bipolar neurons in transverse sections of human, with elongated somata in humans and other primates and large caliber dendrites</rdfs:isDefinedBy>
        <rdfs:label>Medial superior olivary nucleus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_thalamus -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_thalamus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Thalamus"/>
        <reference>http://neurolex.org/wiki/Category:Medial_thalamus</reference>
        <rdfs:label>Medial thalamus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_transverse_frontopolar_gyrus -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_transverse_frontopolar_gyrus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Transverse_frontopolar_gyri_complex"/>
        <reference>http://neurolex.org/wiki/Category:Medial_transverse_frontopolar_gyrus</reference>
        <rdfs:label>Medial transverse frontopolar gyrus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_ventral_tegmental_area -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medial_ventral_tegmental_area">
