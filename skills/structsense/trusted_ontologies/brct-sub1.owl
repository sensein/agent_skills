        <Synonym> vestibulocochlear nerve fibers</Synonym>
        <Synonym>central part of vestibulocochlear nerve</Synonym>
        <Synonym>cochlear-vestibular nerve</Synonym>
        <Synonym>statoacoustic nerve fibers</Synonym>
        <Synonym>vestibular root of vestibulocochlear nerve</Synonym>
        <Synonym>vestibulocochlear nerve roots</Synonym>
        <reference>http://neurolex.org/wiki/Category:Vestibulocochlear_nerve_fiber_bundle</reference>
        <rdfs:label>Vestibulocochlear nerve fiber bundle</rdfs:label>
    </owl:Class>
    


