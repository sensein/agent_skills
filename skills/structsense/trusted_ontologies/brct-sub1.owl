    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Cortex_pyramidal_cell -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Cortex_pyramidal_cell">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Cerebral_cortex"/>
        <Synonym> Cortical pyramidal cell</Synonym>
        <Synonym>Cortex pyramidal neuron</Synonym>
        <Synonym>Cortical pyramidal neuron</Synonym>
        <Synonym>General cortex pyramidal cell</Synonym>
        <reference>http://neurolex.org/wiki/Category:Cortex_pyramidal_cell</reference>
        <rdfs:isDefinedBy>Any pyramidal neuron whose cell some is located in the cerebral cortex or any of its parts</rdfs:isDefinedBy>
        <rdfs:label>Cortex pyramidal cell</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Cortical_amygdaloid_nucleus -->

