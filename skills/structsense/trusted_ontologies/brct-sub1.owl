        <Synonym>parvicellular part</Synonym>
        <Synonym>parvicellular part of dorsomedial nucleus</Synonym>
        <Synonym>parvicellular part of medial dorsal nucleus</Synonym>
        <reference>http://neurolex.org/wiki/Category:Parvicellular_part_of_medial_dorsal_nucleus</reference>
        <rdfs:label>Parvicellular part of medial dorsal nucleus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Parvicellular_part_of_ventral_anterior_nucleus -->

