        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Synaptic_component"/>
        <Synonym>Post-synaptic density</Synonym>
        <Synonym>Postsynaptic density</Synonym>
        <reference>http://www.biologymad.com/nervoussystem/synapses.htm</reference>
        <rdfs:isDefinedBy>A postsynaptic ending that contains receptor sites for neurotransmitters .</rdfs:isDefinedBy>
        <rdfs:label>Postsynaptic ending</rdfs:label>
    </owl:Class>
    


