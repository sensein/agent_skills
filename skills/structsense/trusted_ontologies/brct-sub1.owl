        <Synonym> posterior cortical amygdaloid nucleus</Synonym>
        <Synonym>posterior amygdaloid area</Synonym>
        <Synonym>posterior cortical nucleus</Synonym>
        <reference>http://neurolex.org/wiki/Category:Cortical_amygdaloid_nucleus</reference>
        <rdfs:isDefinedBy>Three layered structure that is located in the caudal aspect of the amygdala bordering the periamygdaloid cortex laterally.</rdfs:isDefinedBy>
        <rdfs:label>Cortical amygdaloid nucleus</rdfs:label>
    </owl:Class>
    


