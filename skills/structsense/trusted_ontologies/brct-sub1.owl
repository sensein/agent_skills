        <Synonym>Mediodorsal thalamus</Synonym>
        <Synonym>dorsomedial nucleus</Synonym>
        <Synonym>medial dorsal thalamic nucleus</Synonym>
        <Synonym>medial thalamic nuclei</Synonym>
        <Synonym>medial thalamic nucleus</Synonym>
        <Synonym>mediodorsal nucleus</Synonym>
        <Synonym>mediodorsal thalamic nucleus</Synonym>
