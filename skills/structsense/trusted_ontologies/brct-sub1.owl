        <Synonym>Paraolfactory sulci</Synonym>
        <Synonym>Set of paraolfactory sulci</Synonym>
        <Synonym>Sulcus parolfactorius anterior</Synonym>
        <Synonym>paraolfactory sulcus</Synonym>
        <reference>http://neurolex.org/wiki/Category:Anterior_parolfactory_sulcus</reference>
        <rdfs:label>Anterior parolfactory sulcus</rdfs:label>
    </owl:Class>
    


