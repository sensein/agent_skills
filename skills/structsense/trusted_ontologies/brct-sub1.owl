        <Synonym>	nucleus juxtasolitarius</Synonym>
        <Synonym>nucleus fasciculus solitarius</Synonym>
        <reference>http://neurolex.org/wiki/Category:Parasolitary_nucleus</reference>
        <rdfs:label>Parasolitary nucleus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Parasubiculum -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Parasubiculum">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Hippocampal_formation"/>
        <Synonym>parasubicular area</Synonym>
        <reference>http://neurolex.org/wiki/Category:Parasubiculum</reference>
        <rdfs:isDefinedBy>A transitional zone between the presubiculum and the entorhinal area in the mouse (Paxinos-2001), the rat (Swanson-1998) and the primate (Zilles-1990). Defined on the basis of cytoarchitecture, it is more similar to the presubiculum than to the entorhinal area (Zilles-1990).</rdfs:isDefinedBy>
        <rdfs:label>Parasubiculum</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Parasubiculum_to_retrosplenial_cortex -->

