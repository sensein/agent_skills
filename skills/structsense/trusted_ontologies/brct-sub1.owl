        <Synonym>	Descending vestibular nucleus</Synonym>
        <Synonym>spinal vestibular nucleus</Synonym>
        <reference>http://neurolex.org/wiki/Category:Inferior_vestibular_nucleus</reference>
        <rdfs:label>Inferior vestibular nucleus</rdfs:label>
    </owl:Class>
    


