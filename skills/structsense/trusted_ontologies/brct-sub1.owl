        <Synonym>	Ventral tegmental area DA cell</Synonym>
        <Synonym> VTA dopaminergic neuron</Synonym>
        <Synonym>ventral tegmental area dopaminergic neuron</Synonym>
        <reference>http://neurolex.org/wiki/Category:Ventral_tegmental_area_dopamine_neuron</reference>
        <rdfs:isDefinedBy>Principal neuron of the ventral tegmental area</rdfs:isDefinedBy>
        <rdfs:label>Ventral tegmental area dopamine neuron</rdfs:label>
    </owl:Class>
    


