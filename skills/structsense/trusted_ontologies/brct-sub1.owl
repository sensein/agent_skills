    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Visual_cortex_primary -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Visual_cortex_primary">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Occipital_cortex"/>
        <Synonym>V1</Synonym>
        <Synonym>primary visual cortex</Synonym>
        <Synonym>striate cortex</Synonym>
        <reference>http://neurolex.org/wiki/Category:Visual_cortex_primary</reference>
        <rdfs:isDefinedBy>Region of visual cortex that receives visual input from the eyes through the lateral geniculate nuclei</rdfs:isDefinedBy>
        <rdfs:label>Visual cortex primary</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Visual_cortex_primary_layer_1 -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Visual_cortex_primary_layer_1">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Visual_cortex_primary"/>
        <Synonym>Primary visual cortex layer 1</Synonym>
        <Synonym>primary visual cortex layer I</Synonym>
        <reference>http://neurolex.org/wiki/Category:Visual_cortex_primary_layer_1</reference>
        <rdfs:isDefinedBy>Most superficial layer of the primary visual cortex</rdfs:isDefinedBy>
        <rdfs:label>Visual cortex primary layer 1</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Visual_cortex_primary_layer_2 -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Visual_cortex_primary_layer_2">
