        <reference>http://neurolex.org/wiki/Category:Lower_bank_of_the_intraparietal_sulcus</reference>
        <rdfs:label>Lower bank of the intraparietal sulcus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Lunate_sulcus -->

