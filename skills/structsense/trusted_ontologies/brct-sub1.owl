        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Entorhinal_cortex"/>
        <reference>http://neurolex.org/wiki/Category:Entorhinal_cortex_pyramidal_cell</reference>
        <rdfs:isDefinedBy>provides the major input into the dentate gyrus in a unidirectional perforant path</rdfs:isDefinedBy>
        <rdfs:label>Entorhinal cortex pyramidal cell</rdfs:label>
    </owl:Class>
    


