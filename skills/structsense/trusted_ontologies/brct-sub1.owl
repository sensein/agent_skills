        <reference>http://neurolex.org/wiki/Category:Matrix_part_of_head_of_caudate_nucleus</reference>
        <rdfs:isDefinedBy>Matrix compartment located in the head of the caudate nucleus</rdfs:isDefinedBy>
        <rdfs:label>Matrix part of head of caudate nucleus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Matrix_part_of_tail_of_caudate_nucleus -->

