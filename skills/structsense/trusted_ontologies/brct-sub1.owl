        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Brainstem"/>
        <Synonym>	M-cell</Synonym>
        <reference>http://neurolex.org/wiki/Category:Mauthner_cell</reference>
