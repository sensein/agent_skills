        <reference>http://neurolex.org/wiki/Category:Commissure_of_superior_colliculus</reference>
        <rdfs:label>Commissure of superior colliculus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Copula_pyramidis -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Copula_pyramidis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Hemispheric_lobule_VIII"/>
        <Synonym>Copula of the pyramis</Synonym>
        <reference>http://neurolex.org/wiki/Category:Copula_pyramidis</reference>
        <rdfs:isDefinedBy>A part of the cerebellar hemisphere in the mouse ( Paxinos-2001 ) and the rat ( Swanson-1998 ) that corresponds laterally to the pyramis of the vermis of the cerebellum. It is regarded as the rodent homolog of the &apos;lateral belly&apos; of the the biventer lobule of the human (Voogd-1990)</rdfs:isDefinedBy>
        <rdfs:label>Copula pyramidis</rdfs:label>
    </owl:Class>
    


