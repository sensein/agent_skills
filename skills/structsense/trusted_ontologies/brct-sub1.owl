     xmlns:thalamus="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#thalamus,"
     xmlns:accessory="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Olfactory_bulb_(accessory)"
