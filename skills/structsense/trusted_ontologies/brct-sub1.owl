        <Synonym>external pyramidal cell layer of neocortex</Synonym>
        <Synonym>layer 3 of neocortex</Synonym>
        <Synonym>layer III of neocortex</Synonym>
        <Synonym>neocortex external pyramidal cell layer</Synonym>
        <Synonym>neocortex layer III</Synonym>
        <reference>http://neurolex.org/wiki/Category:Neocortex_layer_3</reference>
        <rdfs:isDefinedBy>Layer of neocortex lying deep to the external granule cell layer defined cytoarchitecturally by numerous small pyramidal neurons</rdfs:isDefinedBy>
        <rdfs:label>Neocortex layer 3</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Neocortex_layer_4 -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Neocortex_layer_4">
