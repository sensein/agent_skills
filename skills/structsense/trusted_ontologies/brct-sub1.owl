     xmlns:Colliculus_superior="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Colliculus_superior,"
     xmlns:Subnucleus_compactus="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Subnucleus_compactus,"
     xmlns:Ontology1255357986125="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#"
     xmlns:Ontology12553579861252="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#1321-"
     xmlns:Nucleus_subfascicularis="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Nucleus_subfascicularis,"
     xmlns:Nucleus_geniculatus_medialis="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Nucleus_geniculatus_medialis,"
     xmlns:Nucleus_habenularis_lateralis="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Nucleus_habenularis_lateralis,"
     xmlns:Nucleus_geniculatus_lateralis_ventralis="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Nucleus_geniculatus_lateralis_ventralis,">
    <owl:Ontology rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl">
        <rdfs:comment>The brain cell-type ontology describes the types of both neural and non-neural cells in the human brain. The cell types are integrated into their corresponding anatomical hierarchies.</rdfs:comment>
    </owl:Ontology>
    


