    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Solitary_tract -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Solitary_tract">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Medulla_oblongata"/>
