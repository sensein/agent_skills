        <Synonym>Central gray</Synonym>
        <Synonym>Central grey substance of midbrain</Synonym>
        <Synonym>Griseum centrale</Synonym>
        <Synonym>Substantia grisea centralis</Synonym>
        <Synonym>periaqueductal gray</Synonym>
        <Synonym>periaqueductal gray matter</Synonym>
        <Synonym>periaqueductal grey matter</Synonym>
        <reference>http://neurolex.org/wiki/Category:Periaqueductal_gray</reference>
        <rdfs:label>Periaqueductal gray</rdfs:label>
    </owl:Class>
    


