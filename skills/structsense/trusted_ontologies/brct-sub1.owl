    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Insula -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Insula">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Neocortex"/>
        <Synonym>Lobus insular</Synonym>
        <Synonym>central lobe</Synonym>
        <Synonym>insular gyrus</Synonym>
        <Synonym>insular lobe</Synonym>
        <Synonym>insular region</Synonym>
        <Synonym>insulary cortex</Synonym>
        <Synonym>island of Reil</Synonym>
        <reference>http://neurolex.org/wiki/Category:Insula</reference>
        <rdfs:isDefinedBy>Gray matter of the insular region of the neocortex. In gyrencephalic animals, it is part of the insular lobe and lies in the depths of the lateral fissure and covered by portions of the frontal, parietal and temporal lobes. It includes Brodmann areas 13-16.</rdfs:isDefinedBy>
        <rdfs:label>Insula</rdfs:label>
    </owl:Class>
    


