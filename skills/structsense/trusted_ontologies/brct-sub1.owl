        <Synonym>nucleus lateralis intermedius mediodorsalis situs ventralis medialis</Synonym>
        <Synonym>nucleus ventralis oralis</Synonym>
        <Synonym>nucleus ventrooralis internus</Synonym>
        <Synonym>nucleus ventrooralis internus (Hassler)</Synonym>
        <Synonym>superior part</Synonym>
        <reference>http://neurolex.org/wiki/Category:Area_X</reference>
        <rdfs:label>Area X</rdfs:label>
    </owl:Class>
    


