        <Synonym>Limen insulae</Synonym>
        <Synonym>angulus gyri olfactorii lateralis</Synonym>
        <reference>http://neurolex.org/wiki/Category:Limen_of_insula</reference>
        <rdfs:isDefinedBy>The anterior basal part of the insular cortex, which separates the lateral surface of the insula from the anterior perforated substance.</rdfs:isDefinedBy>
        <rdfs:label>Limen of insula</rdfs:label>
    </owl:Class>
    


