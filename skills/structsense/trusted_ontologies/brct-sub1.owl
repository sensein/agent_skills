        <Synonym>primary visual cortex layer III</Synonym>
        <reference>http://neurolex.org/wiki/Category:Visual_cortex_primary_layer_3</reference>
        <rdfs:label>Visual cortex primary layer 3</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Visual_cortex_primary_layer_4 -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Visual_cortex_primary_layer_4">
