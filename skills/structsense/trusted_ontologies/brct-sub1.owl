        <Synonym>nucleus pulvinar pars inferior</Synonym>
        <Synonym>nucleus pulvinaris inferior</Synonym>
        <Synonym>nucleus pulvinaris thalami</Synonym>
        <reference>http://neurolex.org/wiki/Category:Inferior_pulvinar_nucleus</reference>
        <rdfs:isDefinedBy>One of four subdivisions recognized in the primate pulvinar based on initially on topography, located ventrally between the medial and lateral geniculate bodies.</rdfs:isDefinedBy>
        <rdfs:label>Inferior pulvinar nucleus</rdfs:label>
    </owl:Class>
    


