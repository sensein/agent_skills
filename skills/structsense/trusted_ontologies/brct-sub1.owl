        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Posterior_lobe_of_the_cerebellum"/>
        <Synonym>Tuber</Synonym>
        <reference>http://neurolex.org/wiki/Category:Vermic_Lobule_VIIB</reference>
        <rdfs:label>Vermic Lobule VIIB</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#fronto-marginal_sulcus -->

