        <reference>http://neurolex.org/wiki/Category:Visual_cortex_primary_layer_2</reference>
        <rdfs:label>Visual cortex primary layer 2</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2009/9/Ontology1255357986125.owl#Visual_cortex_primary_layer_3 -->

