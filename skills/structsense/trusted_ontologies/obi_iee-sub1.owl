        <dc:source>ENCODE project</dc:source>
        <rdfs:label>carbon-copy chromosome conformation capture assay followed by sequencing assay</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0002043 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0002043">
