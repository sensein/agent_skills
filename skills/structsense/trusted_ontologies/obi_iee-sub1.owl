        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An immuno staining assay in which samples of intact cells are examined that have had most, if not all, of their surrounding extracellular matrix removed</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bjoern Peters</obo:IAO_0000117>
