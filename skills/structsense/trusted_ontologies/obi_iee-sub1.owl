        <obo:IAO_0000118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">baseline participant</obo:IAO_0000118>
        <rdfs:label xml:lang="en">baseline participant role</rdfs:label>
    </owl:Class>
    


