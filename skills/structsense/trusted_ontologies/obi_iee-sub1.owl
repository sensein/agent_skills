        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">actin polymerization-dependent cell motility</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0071604 -->

