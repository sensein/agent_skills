        <obo:IAO_0000115 xml:lang="en">nano-CAGE is a type of CAGE developed to work from very low amount (nanogram scale) of mRNA samples</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">PERSON:Philippe Rocca-Serra; Marcus Chibucos</obo:IAO_0000117>
        <obo:IAO_0000118 xml:lang="en">nano-CAGE</obo:IAO_0000118>
