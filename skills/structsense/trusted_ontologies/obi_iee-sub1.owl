        <obo:IAO_0000111 xml:lang="en">reverse transcription polymerase chain reaction assay</obo:IAO_0000111>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 xml:lang="en">an assay that evaluates the concentration of RNA in a sample in which an RNA strand is first reverse transcribed into its DNA complement (complementary DNA, or cDNA) using the enzyme reverse transcriptase, and the resulting cDNA is amplified using traditional or real-time PCR.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">PERSON: Chris Stoeckert, Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">GROUP: Penn Group</obo:IAO_0000119>
        <rdfs:label xml:lang="en">reverse transcription polymerase chain reaction assay</rdfs:label>
    </owl:Class>
    


