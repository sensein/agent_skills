    <!-- http://purl.obolibrary.org/obo/OBI_1000023 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_1000023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000047"/>
