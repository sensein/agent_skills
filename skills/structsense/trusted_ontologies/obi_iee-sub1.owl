        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">freezing storage</obo:IAO_0000111>
        <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a fozen pellet used for later assay</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A storage process in temperature that maintenance the frozen status of the stored entities.</obo:IAO_0000115>
        <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2010/3/3 Alan Ruttenberg: There is a question of whether we should have a separate objective to &quot;prepare for maintenance&quot;
2014/2/3 OBI dev call: &quot;prepare for maintenance&quot; is a separate process. For example, &apos;freezing&apos; and &apos;flash freezing&apos; are defined and can be used to produce frozen material for storage.
Updated both textual and logical definition. Both input and output material of freezing storage have quality frozen.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Person: Alan Ruttenberg, Mathias Brochhausen</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">MO_481 frozen_storage</obo:IAO_0000119>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OBI</obo:IAO_0000119>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">freezing storage</rdfs:label>
    </owl:Class>
    


