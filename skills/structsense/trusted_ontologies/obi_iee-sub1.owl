        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The appearance of a perforin protein due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/go.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">perforin production</rdfs:label>
