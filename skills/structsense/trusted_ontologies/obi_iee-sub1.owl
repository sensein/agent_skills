        <obo:IAO_0000115 xml:lang="en">a  standard compliance rule is a compliance rule which defines conformity to a representation standard</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">PRS</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">PRS</obo:IAO_0000119>
