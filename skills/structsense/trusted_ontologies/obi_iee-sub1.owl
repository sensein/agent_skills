                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0000415"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nucleic acid template role</obo:IAO_0000111>
        <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a model or standard for making comparisons; wordnet.princeton.edu/perl/webwn 19 feb 2009</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000123"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a reference substance role which inheres in nucleic acid material entity and is realized in the process of using the nucleic acid bearing the template role as a reference during synthesis of a reverse copy.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">nucleic acid template role</rdfs:label>
    </owl:Class>
    


