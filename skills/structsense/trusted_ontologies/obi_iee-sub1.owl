    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/OBI_0000309">
        <rdfs:subPropertyOf rdf:resource="http://www.geneontology.org/formats/oboInOwl#ObsoleteProperty"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">obsoleted_utilizes_reagent</obo:IAO_0000111>
