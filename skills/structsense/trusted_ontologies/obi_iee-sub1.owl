        </rdfs:subClassOf>
        <obo:IAO_0000111 xml:lang="en">artificially induced methylation</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">the use of enzymes to add methyl groups to DNA molecules</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 xml:lang="en">A planned process of adding methyl groups to polymers</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">PERSON:Kevin Clancy</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">OBI branch derived</obo:IAO_0000119>
        <rdfs:label xml:lang="en">artificially induced methylation</rdfs:label>
    </owl:Class>
    


