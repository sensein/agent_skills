                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001146"/>
        <obo:IAO_0000111 xml:lang="en">far-Western blot</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">Studying protein-protein interactions via blot overlay or Far Western blot.
Hall RA.
Methods Mol Biol. 2004;261:167-74. Review.
PMID: 15064457</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">is a adaptation on the western blot assay to explore protein-protein interaction. The assay involves separating target proteins on an SDS-PAGE gel, blotting to a membrane, hybridization with a protein probe and visualization using a probe-directed antibody.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">PERSON:Philippe Rocca-Serra; Marcus Chibucos</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">adapted from ECO, PMID:18079728</obo:IAO_0000119>
        <rdfs:label xml:lang="en">far-Western blot</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001670 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001670">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000070"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
