        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001933"/>
        <obo:IAO_0000111 xml:lang="en">minimum age value specification</obo:IAO_0000111>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000123"/>
        <obo:IAO_0000115 xml:lang="en">A value specifcation that specifies the youngest age when specifying an age range.</obo:IAO_0000115>
