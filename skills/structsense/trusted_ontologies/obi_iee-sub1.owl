        <obo:IAO_0000412>http://purl.obolibrary.org/obo/FMA_10483</obo:IAO_0000412>
        <rdfs:label>zone of bone organ</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FMA_24010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_10483"/>
        <obo:IAO_0000111>zone of flat bone</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>Organ region of a skeletal feature possessing a flattened shape.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000119>Jason Bengtson</obo:IAO_0000119>
        <obo:IAO_0000232>imported from FMA ontology</obo:IAO_0000232>
        <obo:IAO_0000412>http://purl.obolibrary.org/obo/FMA_24010</obo:IAO_0000412>
        <rdfs:label>zone of flat bone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FMA_52870 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_52870">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_24010"/>
        <obo:IAO_0000111>zone of temporal bone</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>A spatial region of a temporal bone.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000119>Jason Bengtson</obo:IAO_0000119>
        <obo:IAO_0000232>imported from FMA ontology</obo:IAO_0000232>
        <obo:IAO_0000412>http://purl.obolibrary.org/obo/FMA_52870</obo:IAO_0000412>
        <rdfs:label>zone of temporal bone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FMA_55268 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_55268">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_67619"/>
        <obo:IAO_0000111>zone of organ</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>Organ region with one or more floating fiat boundaries. Examples: apical zone of lung, superior pole of kidney, gingiva, apex of prostate, ascending colon proper.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000232>imported from FMA ontology</obo:IAO_0000232>
        <obo:IAO_0000412>http://purl.obolibrary.org/obo/FMA_55268</obo:IAO_0000412>
        <rdfs:label>zone of organ</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FMA_55425 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_55425">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_52870"/>
        <obo:IAO_0000111>zone of petrous part of temporal bone</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>A region of the temporal bone located in that part falling between the sphenoid and occipital bones.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000119>Jason Bengtson</obo:IAO_0000119>
        <obo:IAO_0000232>imported from FMA ontology</obo:IAO_0000232>
        <obo:IAO_0000412>http://purl.obolibrary.org/obo/FMA_55425</obo:IAO_0000412>
        <rdfs:label>zone of petrous part of temporal bone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FMA_60182 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_60182">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_55425"/>
        <obo:IAO_0000111>subdivision of bony labyrinth</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>A region of the cavity in the temporal bone.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000119>Jason Bengtson</obo:IAO_0000119>
        <obo:IAO_0000232>imported from the FMA ontology</obo:IAO_0000232>
        <obo:IAO_0000412>http://purl.obolibrary.org/obo/FMA_60182</obo:IAO_0000412>
        <rdfs:label>subdivision of bony labyrinth</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FMA_60202 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_60202">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001844"/>
