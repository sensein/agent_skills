        <obo:IAO_0000115 xml:lang="en">A HEPES that is ethanesulfonic acid in which one of the methyl hydrogens is replaced by a 4-(2-hydroxyethyl)piperazin-1-yl group. A Good&apos;s buffer substance, pKa = 7.55 at 20 °C.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">sourced from CHEBI</obo:IAO_0000116>
        <obo:IAO_0000117 xml:lang="en">Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000118 xml:lang="en">4-(2-HYDROXYETHYL)-1-PIPERAZINE ETHANESULFONIC ACID</obo:IAO_0000118>
