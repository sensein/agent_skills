        <obo:IAO_0000112 xml:lang="en">Aliquots of a tissue subjected to parallel assays</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000123"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">technical replicate role is realized when two portions from one evaluant are used in replicate runs of an assay</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Person: Jennifer Fostel</obo:IAO_0000117>
        <obo:IAO_0000118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">technical replicate</obo:IAO_0000118>
        <rdfs:label xml:lang="en">technical replicate role</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0000250 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000250">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/REO_0000171"/>
        <obo:IAO_0000111 xml:lang="en">dye role</obo:IAO_0000111>
