        <obo:IAO_0000119 xml:lang="en">OBI branch derived</obo:IAO_0000119>
        <rdfs:label xml:lang="en">allotransplantation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0000059 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000059">
