    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/obi.owl">
        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/obi/2018-05-23/obi.owl"/>
        <dc:creator xml:lang="en">Pierre Grenon</dc:creator>
        <dc:creator xml:lang="en">Bjoern Peters</dc:creator>
        <dc:creator xml:lang="en">Matthew Pocock</dc:creator>
        <dc:creator xml:lang="en">Liju Fan</dc:creator>
