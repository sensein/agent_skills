    <!-- http://purl.obolibrary.org/obo/OBI_0600067 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0600067">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0600038"/>
        <obo:IAO_0000111 xml:lang="en">specific labeling</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">The addition of anti-CD8 antibody for an ICCS assay in order to selectively stain the CD8+ cells</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 xml:lang="en">a labeling in which the labeling reagent used  has a specificity to bind only certain components of the input material</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">PlanAndPlannedProcess Branch</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">OBI branch derived</obo:IAO_0000119>
        <obo:IAO_0000232 xml:lang="en">definition blessed by Allyson, Bjoern, Jay &amp; Randi</obo:IAO_0000232>
        <rdfs:label xml:lang="en">specific labeling</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0666666 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0666666">
