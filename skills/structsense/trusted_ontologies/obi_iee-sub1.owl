        <obo:IAO_0000412>http://purl.obolibrary.org/obo/PATO_0001241</obo:IAO_0000412>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">physical object quality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001338 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001338">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mixed sex</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A biological sex quality inhering in a population of multiple sexes.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pato.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mixed sex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001339 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001339">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001237"/>
