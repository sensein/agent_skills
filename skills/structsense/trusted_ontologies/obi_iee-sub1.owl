        <obo:IAO_0000117 xml:lang="en">Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000118 xml:lang="en">2,2&apos;,2&apos;&apos;,2&apos;&apos;&apos;-[ethane-1,2-diylbis(oxyethane-2,1-diylnitrilo)]tetraacetic acid</obo:IAO_0000118>
