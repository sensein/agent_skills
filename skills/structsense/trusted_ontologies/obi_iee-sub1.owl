                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0000453"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111 xml:lang="en">gamma counter</obo:IAO_0000111>
        <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Geiger counter</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">A processed material which measures gamma radiation</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Frank Gibson</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">http://en.wikipedia.org/wiki/Gamma_counter</obo:IAO_0000119>
