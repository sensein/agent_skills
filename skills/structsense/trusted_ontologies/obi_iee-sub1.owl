    <!-- http://purl.obolibrary.org/obo/OBI_0001855 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/OBI_0001855">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
        <rdf:type>
