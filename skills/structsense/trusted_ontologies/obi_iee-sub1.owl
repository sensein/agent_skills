    <!-- http://purl.obolibrary.org/obo/OBI_0001064 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001064">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000968"/>
