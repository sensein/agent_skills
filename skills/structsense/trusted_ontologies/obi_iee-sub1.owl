    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_50076 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_50076">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23367"/>
