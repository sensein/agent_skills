                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0000432"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0000439"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000417"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0000681"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0400140"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0400142"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111 xml:lang="en">electrophoresis</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">Loading a mixture of proteins into a polyacrylamide gel and the application of an electrical current to the gel to separate the proteins by size and change.</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">a protocol application that uses an electrical potential to move material through a defined matrix in order to separate it by its resistance to movement and its charge</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">PERSON:Kevin Clancy</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">OBI branch derived</obo:IAO_0000119>
        <obo:IAO_0000232 xml:lang="en">Need to define more terms like gel_separation, matrix,centrifugation, and the connection between the force used to separate materials and the medium or barriers.</obo:IAO_0000232>
        <rdfs:label xml:lang="en">electrophoresis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0600054 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0600054">
