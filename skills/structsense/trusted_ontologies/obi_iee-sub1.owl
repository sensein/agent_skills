                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0000885"/>
                                    </owl:Restriction>
