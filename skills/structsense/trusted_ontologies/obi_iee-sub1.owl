        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000123"/>
        <obo:IAO_0000115 xml:lang="en">Relationship between a protocol application and a substance that has role reagent that participates in the protocol application</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Alan Ruttenberg</obo:IAO_0000117>
        <obo:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000103"/>
        <rdfs:label xml:lang="en">obsoleted_utilizes_reagent</rdfs:label>
