        <obo:IAO_0000112 xml:lang="en">http://www.lifetechnologies.com/uk/en/home/life-science/epigenetics-noncoding-rna-research/chromatin-remodeling/chromatin-immunoprecipitation-chip.html</obo:IAO_0000112>
