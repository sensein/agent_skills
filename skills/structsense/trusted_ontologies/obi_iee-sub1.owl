        <obo:IAO_0000119>Arnold et al. (January 2013). &quot;Genome-Wide Quantitative Enhancer Activity Maps Identified by STARR-seq&quot;. Science 339 (6123): 1074-7.</obo:IAO_0000119>
        <dc:source>ENCODE project</dc:source>
        <rdfs:label>self-transcribing active regulatory region sequencing assay</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0002042 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0002042">
