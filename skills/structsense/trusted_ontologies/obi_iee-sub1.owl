    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001842 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001842">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000033"/>
        <obo:IAO_0000115 xml:lang="en">A concentration quality inhering in a bearer by virtue of the bearer&apos;s containing acid (hydrogen ions). [database_cross_reference: biology-online:biology-online]</obo:IAO_0000115>
