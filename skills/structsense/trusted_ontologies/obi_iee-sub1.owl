        <obo:IAO_0000111 xml:lang="en">forward PCR primer</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">SP6 promoter, forward primer (SP6 TTTAGGTGACACTATAG)</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">A short oligonucleotide complementary to target DNA (5&apos;-&gt;3&apos; on plus strand) that acts as the leader for DNA extension in a PCR reaction. The polymerase starts replication at the 3&apos;-end of the primer, and copies the opposite strand. A primer is characterized by its &apos;melting temperature&apos; (Tm) and pairs of primers should have similar Tm.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Philippe Rocca-Serra</obo:IAO_0000117>
        <obo:IAO_0000118 xml:lang="en">5&apos; primer</obo:IAO_0000118>
        <obo:IAO_0000118 xml:lang="en">forward primer</obo:IAO_0000118>
        <obo:IAO_0000118 xml:lang="en">sense primer</obo:IAO_0000118>
        <obo:IAO_0000119 xml:lang="en">adapted from http://www.ncbi.nlm.nih.gov/projects/genome/probe/doc/Glossary.shtml#p</obo:IAO_0000119>
        <rdfs:label xml:lang="en">forward PCR primer</rdfs:label>
    </owl:Class>
    


