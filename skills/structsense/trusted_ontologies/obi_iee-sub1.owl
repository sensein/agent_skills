        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000123"/>
        <obo:IAO_0000115 xml:lang="en">a worker role of being responsible for making the histopathology diagnoses associated with data from a study; this activity occurs outside the study timeline</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Person:Jennifer Fostel</obo:IAO_0000117>
