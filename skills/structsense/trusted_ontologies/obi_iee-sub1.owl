    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0007311 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0007311">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000463"/>
