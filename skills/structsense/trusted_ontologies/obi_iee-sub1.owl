        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000232>imported from the PATO ontology</obo:IAO_0000232>
        <obo:IAO_0000412>http://purl.obolibrary.org/obo/PATO_0002023</obo:IAO_0000412>
