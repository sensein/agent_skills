        <obo:IAO_0000115 xml:lang="en">Process of administering an object playing the role of immunogen to a living organism</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">IEDB</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">IEDB</obo:IAO_0000119>
