        <obo:OBI_0001847 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SNP analysis</obo:OBI_0001847>
        <rdfs:label xml:lang="en">genotyping assay</rdfs:label>
    </owl:Class>
    


