    <!-- http://purl.obolibrary.org/obo/GO_0032606 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0032606">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0001816"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">type I interferon production</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The appearance of type I interferon due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels. Type I interferons include the interferon-alpha, beta, delta, episilon, zeta, kappa, tau, and omega gene families.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/go.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">type I interferon production</rdfs:label>
    </owl:Class>
    


