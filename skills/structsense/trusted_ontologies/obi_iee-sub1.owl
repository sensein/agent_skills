    <!-- http://purl.obolibrary.org/obo/OBI_0100066 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0100066">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000047"/>
