        <obo:IAO_0000118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">isolation objective</obo:IAO_0000118>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BP</obo:IAO_0000119>
