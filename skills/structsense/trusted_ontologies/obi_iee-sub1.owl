                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0001174"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0001176"/>
                </owl:unionOf>
