    <!-- http://purl.obolibrary.org/obo/OBI_0001945 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001945">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001940"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SO_0000148"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000312"/>
                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0001872"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111 xml:lang="en">scaffold N50</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">Gigascience. 2012 Dec 27;1(1):18. doi: 10.1186/2047-217X-1-18.
PMID: 23587118. 

&quot;Here, the contig and scaffold N50 of the YH genome were ~20.9 kbp and ~22 Mbp&quot;</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115>N50 statistic computed for the scaffold produced by the assembly process. The method for computing the value is similar to that of contig N50 but uses scaffold information instead of contig information</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Alejandra Gonzalez-Beltran</obo:IAO_0000117>
        <obo:IAO_0000117 xml:lang="en">Philippe Rocca-Serra</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">adapted from: nature:http://www.nature.com/nrg/journal/v13/n5/box/nrg3174_BX1.html</obo:IAO_0000119>
        <rdfs:label xml:lang="en">scaffold N50</rdfs:label>
    </owl:Class>
    


