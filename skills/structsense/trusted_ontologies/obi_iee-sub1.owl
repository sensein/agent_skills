        <obo:IAO_0000111 xml:lang="en">table of abbreviations</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">IAO  information artifact ontology
OBI  ontology of biomedical investiations
GO   gene ontology</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A table where the constituent texts are abbreviations and their expansions</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">PERSON: Lawrence Hunter</obo:IAO_0000117>
        <rdfs:label xml:lang="en">table of abbreviations</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000308 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000308">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
