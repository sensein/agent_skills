        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fluorescence detection assay</obo:IAO_0000111>
        <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a laser to stimulate a cell culture that was previously labeled with fluorescent antibodies to detect light emmission at a different wavelength in order to determine the presence of surface markers the antibodies are specific for.</obo:IAO_0000112>
