        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GROUP: OBI Biomatrial Branch</obo:IAO_0000119>
        <rdfs:label xml:lang="en">extract</rdfs:label>
    </owl:Class>
    


