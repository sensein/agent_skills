        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://en.wikipedia.org/wiki/Chip-Sequencing</obo:IAO_0000119>
        <rdfs:label xml:lang="en">ChIP-seq design</rdfs:label>
    </owl:Class>
    


