        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>A quality which inheres in an process.</obo:IAO_0000115>
        <obo:IAO_0000116>imported from PATO Ontology</obo:IAO_0000116>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/PATO_0001236"/>
        <rdfs:label>process quality</rdfs:label>
    </owl:Class>
    


