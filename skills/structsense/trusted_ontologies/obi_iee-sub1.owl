    <!-- http://purl.obolibrary.org/obo/OBI_0002191 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0002191">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000577"/>
