        <obo:IAO_0000232 xml:lang="en">JZ: can we defined it logically as the output of some data transformation, like aggragate data transformation?</obo:IAO_0000232>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">scalar score from composite inputs</rdfs:label>
