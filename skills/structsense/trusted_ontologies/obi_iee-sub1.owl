        <rdfs:label xml:lang="en">synthesis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0600041 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0600041">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0600014"/>
