        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>A positional quality inhering in a bearer by virtue of the bearer&apos;s location of features or characteristics along an axis. [database_cross_reference: PATOC:MAH</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000232>imported from the PATO ontology</obo:IAO_0000232>
        <obo:IAO_0000412>http://purl.obolibrary.org/obo/PATO_0001769</obo:IAO_0000412>
        <rdfs:label>positional polarity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001792 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001792">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001631"/>
