        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cytochalasin</obo:IAO_0000111>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/chebi.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cytochalasin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_23995 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_23995">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23367"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">N-ethyl-N-nitrosourea</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A member of the class of N-nitrosoureas that is urea in which one of the nitrogens is substituted by ethyl and nitroso groups.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/chebi.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">N-ethyl-N-nitrosourea</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_24636 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_24636">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23367"/>
