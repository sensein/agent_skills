        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000123"/>
        <obo:IAO_0000115 xml:lang="en">A cartesion spatial coordinate datum that  uses three values to specify a position within a three dimensional spatial region</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Alan Ruttenberg</obo:IAO_0000117>
        <rdfs:label xml:lang="en">three dimensional cartesian spatial coordinate datum</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000408 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000408">
