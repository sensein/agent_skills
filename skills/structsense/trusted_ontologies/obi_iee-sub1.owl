        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000123"/>
        <obo:IAO_0000115 xml:lang="en">Protocol_testing_objective is a methodology_testing_objective role describing a study designed to examine the effects of using different protocols.</obo:IAO_0000115>
