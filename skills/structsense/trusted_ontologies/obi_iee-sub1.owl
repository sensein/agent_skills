    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000650">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000417"/>
