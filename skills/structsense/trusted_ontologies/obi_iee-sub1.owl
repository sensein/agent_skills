                                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0044030"/>
                                            </owl:Restriction>
