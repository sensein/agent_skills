            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">syringe</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">Accuracy of oral liquid measuring devices: comparison of dosing cup and oral dosing syringe.Ann Pharmacother. 2008 Jan;42(1):46-52. Epub 2007 Dec 4. PMID: 18056832</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">a processed material which is used to introduce or draw fluids from a material entity. A syringe is made of a piston and body. the movement of the piston in the body determines the amount/volume of fluid to inject or draw</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Philippe Rocca-Serra</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OBI Instrument adapted from Wikipedia</obo:IAO_0000119>
        <rdfs:label xml:lang="en">syringe</rdfs:label>
    </owl:Class>
    


