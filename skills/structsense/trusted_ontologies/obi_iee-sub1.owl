        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A composition quality inhering in an bearer by virtue of the bearer&apos;s homogeneity of a biomaterial.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pato.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biomaterial purity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001340 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001340">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001894"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hermaphrodite</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A biological sex quality inhering in an organism or a population with both male and female sexual organs in one individual.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/PATO_0001340"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hermaphrodite</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001341 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001341">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000047"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a mating type (yeast)</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A S. cerevisiae mating type cells that secrete a pheromone that in alpha haploids stimulates processes that lead to mating.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/PATO_0001341"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a mating type (yeast)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001344 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001344">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000047"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">alpha mating type (yeast)</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A S. cerevisiae mating type cells that secrete a pheromone that stimulates a haploids.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/PATO_0001344"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">alpha mating type (yeast)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001345 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001345">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000047"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">h minus</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A S. pombe mating type determined by the mat1-Mc and mat1-Mi on the mat1 locus.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/PATO_0001345"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">h minus</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001346 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001346">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000047"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">h plus</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A S. pombe mating type determined by the mat1-Pc and mat1-Pi on the mat1 locus.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/PATO_0001346"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">h plus</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001347 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001347">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000047"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">F mating type</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A bacterial mating type indicating the presence of F plasmid in a bacterial cell.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/PATO_0001347"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">F mating type</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001348 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001348">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000047"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">F minus mating type</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A bacterial mating type indicating the absence of F plasmid in a bacterial cell.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/PATO_0001348"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">F minus mating type</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001374 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001374">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001396"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ploidy</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A cellular quality inhering in a bearer by virtue of the bearer&apos;s number of homologous sets of chromosomes in the nucleus or primary chromosome-containing compartment of the cell, each set essentially coding for all the biological traits of the organism.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pato.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ploidy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001375 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001375">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001374"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">haploid</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A ploidy quality inhering in a bearer by virtue of the bearer&apos;s containing a single set of homologous chromosomes.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pato.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">haploid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001377 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001377">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001374"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">polyploid</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A ploidy quality inhering in a bearer by virtue of the bearer&apos;s containing more than two homologous sets of chromosomes.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pato.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">polyploid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001385 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001385">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001374"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aneuploid</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A ploidy quality inhering in a bearer by virtue of the bearer&apos;s containing a non-integral multiple of the monoploid number, due to extra or missing chromosomes.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pato.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aneuploid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001394 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001394">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001374"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">diploid</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A ploidy quality inhering in a bearer by virtue of the bearer&apos;s having two copies (homologs) of each chromosome, usually one from the mother and one from the father.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pato.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">diploid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001396 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001396">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001237"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cellular quality</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A monadic quality of continuant that exists at the cellular level of organisation.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pato.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cellular quality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001421 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001421">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001237"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">alive</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A viability quality inhering in a bearer by virtue of the bearer&apos;s condition before death.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pato.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">alive</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001422 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001422">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001237"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dead</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A viability quality inhering in a bearer by virtue of the cessation of the bearer&apos;s life.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pato.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dead</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001457 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001457">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002062"/>
        <obo:IAO_0000111>sensitivity of a process</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>A quality of a process inhering in bearer by virtue of the bearer&apos;s disposition to respond to stimulation.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000232>imported from the PATO ontology</obo:IAO_0000232>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/PATO_0001457"/>
        <rdfs:label>sensitivity of a process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001462 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001462">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001464"/>
        <obo:IAO_0000111>membrane potential</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>A quality inhering in a cell&apos;s plasma membrane by virtue of the electrical potential difference across it. [database_cross_reference: Wikipedia:http://en.wikipedia.org/wiki/Membrane_potential]</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000232>imported from the PATO Ontology</obo:IAO_0000232>
        <obo:IAO_0000412>http://purl.obolibrary.org/obo/PATO_0001462</obo:IAO_0000412>
        <rdfs:label>membrane potential</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001464 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001464">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001241"/>
        <obo:IAO_0000111>electric potential</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>A quality that is equal to the potential energy per unit charge associated with a static (time-invariant) electric field, also called the electrostatic potential. [database_cross_reference: Wikipedia:http://en.wikipedia.org/wiki/Electric_potential]</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000232>imported from the PATO Ontology</obo:IAO_0000232>
        <obo:IAO_0000412>http://purl.obolibrary.org/obo/PATO_0001464</obo:IAO_0000412>
        <rdfs:label>electric potential</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001546 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001546">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001237"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quality of a solid</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A physical quality inhering in a bearer by virtue of the bearer&apos;s exhibiting the physical characteristics of an entity characterized by particles arranged such that their shape and volume are relatively stable.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pato.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quality of a solid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001547 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001547">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001237"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quality of a gas</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A physical quality inhering in a bearer by virtue of the bearer&apos;s exhibiting the physical characteristics of an entity consisting of particles that have neither a defined volume nor defined shape.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pato.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quality of a gas</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001548 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001548">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001237"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quality of a liquid</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A physical quality inhering in an entity exhibiting the physical characteristics of an amorphous (non-crystalline) form of matter between a gas and a solid that has a definite volume, but no definite shape.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pato.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quality of a liquid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001574 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001574">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001906"/>
        <obo:IAO_0000111>flow rate</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>A physical quality inhering in a bearer by virtue of the bearer&apos;s motion characteristic. [database_cross_reference: WordNet:WordNet]</obo:IAO_0000115>
        <obo:IAO_0000117>Jason bengtson</obo:IAO_0000117>
        <obo:IAO_0000232>imported from the PATO Ontology</obo:IAO_0000232>
        <obo:IAO_0000412>http://purl.obolibrary.org/obo/PATO_0001574</obo:IAO_0000412>
        <rdfs:label>flow rate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001631 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001631">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001238"/>
        <obo:IAO_0000111 xml:lang="en">relational spatial quality</obo:IAO_0000111>
        <obo:IAO_0000115 xml:lang="en">A quality of related physical entities inhering in a bearer by virtue of the bearer&apos;s pertaining to or involving or having the nature of space in relation to another entity.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pato.owl"/>
        <rdfs:label xml:lang="en">relational spatial quality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001632 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001632">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001631"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">anterior to</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A spatial quality inhering in a bearer by virtue of the bearer&apos;s being located toward the front of an organism relative to another entity.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">frontal</obo:IAO_0000118>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pato.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">anterior to</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001701 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001701">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000261"/>
        <obo:IAO_0000111>mature</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>A quality inhering in a bearer by virtue of the bearer&apos;s exhibiting complete growth, differentiation, or development.</obo:IAO_0000115>
        <obo:IAO_0000116>imported from the PATO Ontology</obo:IAO_0000116>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000118>adult</obo:IAO_0000118>
        <obo:IAO_0000412>http://purl.obolibrary.org/obo/PATO_0001701</obo:IAO_0000412>
        <rdfs:label>mature</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001741 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001741">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">radioactive</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A radiation quality inhering in bearer by virtue of the bearer&apos;s exhibiting or being caused by radioactivity.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pato.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">radioactive</rdfs:label>
    </owl:Class>
    


