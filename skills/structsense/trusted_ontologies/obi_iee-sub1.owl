        <obo:IAO_0000115>A value specification that is specifies one category out of a fixed number of nominal categories</obo:IAO_0000115>
        <obo:IAO_0000117>PERSON:Bjoern Peters</obo:IAO_0000117>
        <rdfs:label>categorical value specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001931 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001931">
