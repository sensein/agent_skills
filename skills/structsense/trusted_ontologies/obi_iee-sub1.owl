        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">doi:10.1007/978-1-4614-7320-6_723-1</obo:IAO_0000119>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">local field potential recording</rdfs:label>
    </owl:Class>
    


