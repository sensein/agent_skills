                <owl:hasValue rdf:resource="http://purl.obolibrary.org/obo/OBI_0000776"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111>SOLiD 3 Plus System</obo:IAO_0000111>
        <obo:IAO_0000112>Vissers, Lisenka ELM, et al. &quot;A de novo paradigm for mental retardation.&quot; Nature genetics 42.12 (2010): 1109-1112. PMID:21076407</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115>A DNA sequencer which is manufacted by the Applied Biosystems corporation. Built upon SOLiD sequencing technology, the machine generates greater than 1 billion mappable reads per run.</obo:IAO_0000115>
        <obo:IAO_0000117>PERSON: Venkat Malladi, Chris Stoeckert, Jie Zheng, Alan Ruttenberg</obo:IAO_0000117>
        <obo:IAO_0000118>Applied Biosystems SOLiD 3 Plus System</obo:IAO_0000118>
        <obo:IAO_0000119>http://www3.appliedbiosystems.com/cms/groups/mcb_marketing/documents/generaldocuments/cms_072050.pdf</obo:IAO_0000119>
        <dc:source>ENCODE project</dc:source>
        <rdfs:label>SOLiD 3 Plus System</rdfs:label>
    </owl:Class>
    


