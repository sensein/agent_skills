        <obo:IAO_0000115 xml:lang="en">ACS is a format standard of a digital entity that is conformant with the Analytical Cytometry Standard. (http://www.isac-net.org/content/view/607/150/)</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">person:Jennifer Fostel</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">web-page:http://www.isac-net.org/content/view/607/150/</obo:IAO_0000119>
