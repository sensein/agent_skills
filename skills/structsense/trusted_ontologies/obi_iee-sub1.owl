                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Class>
                                        <owl:unionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CL_0000084"/>
                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CL_0000236"/>
                                        </owl:unionOf>
                                    </owl:Class>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000085"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_1110016"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">immunization</obo:IAO_0000111>
        <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Infection with influenza (the immunogen) leading to B cells producing antibodies (the effector function) against surface regions of the HA protein (the epitope).</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000123"/>
        <obo:IAO_0000115 xml:lang="en">The process of an epitope that is part of or derived from an immunogen coming into contact with adaptive immune cells resulting in these cells acquiring immune effector functions specific for the epitope.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">IEDB</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">IEDB</obo:IAO_0000119>
        <rdfs:label xml:lang="en">immunization</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_1110095 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_1110095">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0600014"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0000655"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">blood harvesting</obo:IAO_0000111>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000123"/>
        <obo:IAO_0000115 xml:lang="en">A material separation where blood is taken from an organism.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">IEDB</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">IEDB</obo:IAO_0000119>
        <rdfs:label xml:lang="en">blood harvesting</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_1110099 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_1110099">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CLO_0009828"/>
