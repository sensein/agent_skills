                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0000248"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NTP-2000</obo:IAO_0000111>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000123"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a material consisting of 14.5% protein, 8.5% fat and 9.5% fiber produced to feed rodents</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jennifer Fostel, Bjoern Peters</obo:IAO_0000117>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NTP-2000</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0000736 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000736">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000047"/>
