        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/PATO_0001995"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">organismal quality</rdfs:label>
    </owl:Class>
    


