        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temperature unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000006 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000003"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">substance unit</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A unit which is a standardised quantity of an element or compound with uniform composition.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">substance unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000051 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000051">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000003"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">concentration unit</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A unit which represents a standard measurement of how much of a given substance there is mixed with another substance.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">concentration unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000095 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000095">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000003"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">volume unit</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A unit which is a standard measure of the amount of space occupied by any substance, whether solid, liquid, or gas.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">volume unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000105 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000105">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000003"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">frequency unit</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A unit which is a standard measure of the number of repetitive actions in a particular time.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">frequency unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000109 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000109">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000003"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pressure unit</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A unit which is a standard measure of the force applied to a given area.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pressure unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000270 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000270">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000003"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">volumetric flow rate unit</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A unit which is a standard measure of the volume of fluid which passes through a given surface per unit time .</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">volumetric flow rate unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000280 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000280">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000003"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rate unit</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A unit which represents a standard measurement occurrence of a process per unit time.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rate unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <obo:IAO_0000111>vaccine</obo:IAO_0000111>
        <obo:IAO_0000115>A vaccine is a processed material with the function that when administered, it prevents or ameliorates a disorder in a target organism by inducing or modifying adaptive immune responses specific to the antigens in the vaccine.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/vo.owl"/>
        <rdfs:label>vaccine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0000002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0600007"/>
        <obo:IAO_0000111>vaccination</obo:IAO_0000111>
        <obo:IAO_0000115>a process of administering substance in vivo that involves in adding a vaccine into a host (e.g., human) in vivo with the intent to invoke a protective or therapeutic adaptive immune response.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/vo.owl"/>
        <rdfs:label>vaccination</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/http://purl.obolibrary.org/obo/PATO_0002027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/http://purl.obolibrary.org/obo/PATO_0002027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000033"/>
        <obo:IAO_0000115 xml:lang="en">A concentration quality inhering in a bearer by virtue of the bearer&apos;s amount of osmoles of solute per kilogram of solvent. [database_cross_reference: Wikipedia:http://en.wikipedia.org/wiki/Osmolarity]</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">sourced from PATO ontology</obo:IAO_0000116>
        <obo:IAO_0000117 xml:lang="en">Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000412 xml:lang="en">http://purl.obolibrary.org/obo/PATO_0002027</obo:IAO_0000412>
        <rdfs:label xml:lang="en">osmolality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl#data_set_of_predicted_values_after_fitting_to_2-state_Boltzmann -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl#data_set_of_predicted_values_after_fitting_to_2-state_Boltzmann">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/obi.owl/IEE_0000004"/>
        <obo:IAO_0000111>data set of predicted values after fitting to 2-state Boltzmann</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>The displacement charge versus membrane potential (Q vs V) and the non-linear membrane capacitance, NLC versus membrane potential (C vs V) were fit to 2-state Boltzmann function  and the maximum charge, potential of maximum sensitivity and voltage sensitivity were determined from the fit.</obo:IAO_0000115>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <rdfs:label>data set of predicted values after fitting to 2-state Boltzmann</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl#intracellular_electrophysiology_stimulus -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl#intracellular_electrophysiology_stimulus">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000447"/>
        <obo:IAO_0000111>intracellular electrophysiology stimulus</obo:IAO_0000111>
        <obo:IAO_0000112>The electrical stimulus was applied once the cell was voltage clamped and in the whole-cell mode when the voltage was ramped at 0.3 V/s from −0.100 to 0.100 V.</obo:IAO_0000112>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>The electrical protocol (e.g., pulse or ramp) used during an intracellular electrophysiology recording. For example the magnitude of the DC voltage used to clamp the membrane potential and the length of time this DC voltage is held at this magnitude.</obo:IAO_0000115>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <rdfs:label>intracellular electrophysiology stimulus</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl#maximum_displacement_charge -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl#maximum_displacement_charge">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/obi.owl/IEE_0000005"/>
        <obo:IAO_0000111>maximum displacement charge</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>The maximum displacement charge moved in response to a change in membrane potential over a range in the membrane potential.</obo:IAO_0000115>
        <obo:IAO_0000118>Qmax</obo:IAO_0000118>
        <obo:IAO_0000118>qmax</obo:IAO_0000118>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <obo:IAO_0000232>new for the Farrell data</obo:IAO_0000232>
        <rdfs:label>maximum displacement charge</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBA_VT0004399"/>
        <obo:IAO_0000111>cochlear outer hair cell lateral wall length</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>Length from cuticular plate to end of cylindrical part of cell.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <rdfs:label>cochlear outer hair cell lateral wall length</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_61268"/>
        <obo:IAO_0000111>cochlear turn</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>Positional quality along the apical-basal axis that corresponds to whole circular sections of the cochlea.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <rdfs:label>cochlear turn</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/obi.owl/IEE_0000030"/>
        <obo:IAO_0000111>data set of predicted values according to fitted curve</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>Predicted values obtained from transforming assay data by employing a fitted curve.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000119>Jason Bengtson</obo:IAO_0000119>
        <rdfs:label>data set of predicted values according to fitted curve</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000005 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002193"/>
        <obo:IAO_0000111>displacement charge</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>Under the influence of an membrane potential the charges within an dielectric (e.g., plasma membrane) move from a position of exact cancellation to a state when the charges (i.e., negative or positive or both) separate causing a change in the state of polarization. This changing state of polarization represents charge movement or displacement charge.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000118>charge movement</obo:IAO_0000118>
        <obo:IAO_0000118>q</obo:IAO_0000118>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <obo:IAO_0000232>new for the Farrell data</obo:IAO_0000232>
        <rdfs:label>displacement charge</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000006 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000272"/>
        <obo:IAO_0000111>electrical admittance with two sine stimulus</obo:IAO_0000111>
        <obo:IAO_0000112>The membrane potential was ramped from negative 0.18 to positive 0.18 V, and initially and finally held at membrane potential of negative 0.06 V.  This DC ramp was added to a dual-frequency stimulus. The dual-frequency stimulus was the sum of two 10 mV peak-to-peak sine waves at frequency, f1 and f2, (where f2 =2 times f1).  The membrane current was measured every 10 microseconds and a Fast Fourier Transform conducted from a series of current measurements equivalent to the time that 4 (f1) and 8 (f2) dual frequency sine waves were applied across the membrane.  The real and imaginary parts of the admittance were calculated by dividing the complex current by the complex voltage.</obo:IAO_0000112>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>A DC ramp was added to a dual-frequency stimulus. The dual-frequency stimulus is the sum of two sine waves at frequency, f1 and f2, (where f2 =2 times f1).  The membrane current was measured and a Fast Fourier Transform conducted from a series of current measurements equivalent to the time that n (f1) and 2n (f2) (where 2n= 2 times n) dual frequency sine waves were applied across the membrane.  The real and imaginary parts of the admittance were calculated by dividing the complex current by the complex voltage.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <rdfs:label>electrical admittance with two (2) sine stimulus</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001018"/>
        <obo:IAO_0000111>electrical admittance</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>The ease with which a circuit or device will permit the flow of current [database_cross_reference: https://en.wikipedia.org/wiki/Admittance]</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <rdfs:label>electrical admittance</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000008 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_75958"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0302729"/>
        <obo:IAO_0000111>extracellular solution</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>The solution usually aqueous and buffered that is used to bathe the cells during an intracellular electrophysiology recording.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <rdfs:label>extracellular solution</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000009 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/obi.owl/IEE_0000007"/>
        <obo:IAO_0000111>imaginary part of admittance</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>Imaginary component of electrical admittance. It is the susceptance that describes the dynamic (e.g. frequency-dependent) characteristics of capacitors and inductors within an electrical circuit.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000118>Im(Y)</obo:IAO_0000118>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <rdfs:label>imaginary part of admittance</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/obi.owl/IEE_0000027"/>
        <obo:IAO_0000111>linear (voltage-independent) data set</obo:IAO_0000111>
        <obo:IAO_0000112>Calculate the derivative of capacitance with respect to membrane potential. When the derivative is zero this represents the region when membrane capacitance is in the linear region.  Use this to determine linear capacitance</obo:IAO_0000112>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>The data was partitioned to separate the linear from non-linear electrical parameters. This was performed by calculating the sectional slope (Biophysical Journal 2012 102: 2715-2724) from the membrane capacitance versus membrane potential function and determining the region when the slope is zero. A derivative of zero represents the region when membrane capacitance is linear. The membrane and series resistance and voltage drop are then calculated within this region when there was no detectable voltage-dependent component.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <rdfs:label>linear (voltage-independent) data set</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000011 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000011">
        <rdfs:subClassOf rdf:resource="http://purl.org/incf/ontology/Computational_Neurosciences/cno_alpha.owl#cno_0000220"/>
        <obo:IAO_0000111>linear membrane capacitance</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>The charge stored in the capacitor is linearly proportional to potential. Linear capacitance  is the ratio of charge relative to potential (voltage).</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000118>integral membrane capacitance</obo:IAO_0000118>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <obo:IAO_0000232>new for the Farrell data</obo:IAO_0000232>
        <rdfs:label>linear membrane capacitance</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000012 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/obi.owl/IEE_0000014"/>
        <obo:IAO_0000111>maximum non-linear membrane capacitance</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>The value when non-linear capacitance is maximal.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000118>peak membrane capacitance</obo:IAO_0000118>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <obo:IAO_0000119>Jason Bengtson</obo:IAO_0000119>
        <obo:IAO_0000232>new for the Farrell data</obo:IAO_0000232>
        <rdfs:label>maximum non-linear membrane capacitance</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000272"/>
        <obo:IAO_0000111>membrane current, (I) as a function of membrane potential, (V) (IvsV plot)</obo:IAO_0000111>
        <obo:IAO_0000112>A square wave pulse with an amplitude of 0.01 volts was applied to the cell via the pipette to determine the membrane current as a function of membrane potential plot. The voltage was ramped from -0.13 to +0.13 volts in 0.01 volt steps and current was sampled every 100 microseconds for a 1000 times at each voltage. The conductance was calculated from the change in the steady-state part of the measured current relative to the change in the membrane potential, and the resistance determined from the reciprocal.</obo:IAO_0000112>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>A square wave pulse was applied to the cell via the patch pipette to determine the membrane current as a function of membrane potential plot. The voltage was ramped from a holding potential in incremental steps (e.g., 10 mV) and current was sampled. The conductance was calculated from the change in the steady-state part of the measured current relative to the change in the membrane potential, and the resistance determined from the reciprocal of the conductance.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <rdfs:label>membrane current, (I) as a function of membrane potential, (V) (IvsV plot)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000014 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000014">
        <rdfs:subClassOf rdf:resource="http://purl.org/incf/ontology/Computational_Neurosciences/cno_alpha.owl#cno_0000220"/>
        <obo:IAO_0000111>non-linear membrane capacitance</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>The non-linear capacitance is the partial derivative of the charge with respect to potential.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000118>differential membrane capacitance</obo:IAO_0000118>
        <obo:IAO_0000118>voltage-dependent membrane capacitance, NLC</obo:IAO_0000118>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <obo:IAO_0000232>new for the Farrell data</obo:IAO_0000232>
        <rdfs:label>non-linear membrane capacitance</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/obi.owl/IEE_0000027"/>
        <obo:IAO_0000111>non-linear (voltage-dependent) data set</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>The  non-linear electrical parameters were determined after subtracting the linear capacitance, LC from the membrane capacitance.  This provides the NLC versus potential function.  The displacement charge was determined by integrating the NLC with respect to membrane potential to determine the charge as a function of membrane potential i.e. obtain the q versus potential function with the maximum charge, Qmax found from this transformation. The peak capacitance (Cpeak) and voltage of maximum sensitivity (V0.5, Vpeak) was extracted from a plot of  membrane capacitance versus potential function. The voltage sensitvity was determined by calculating the derivative of normalized charge, q/Qmax as a function of membrane potential then finding the maximum of this derivative and multiplying it by 4.  The Vpeak or V0.5 was corrected for the measured voltage drop across the membrane.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <rdfs:label>non-linear (voltage-dependent) data set</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000016 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0002488"/>
        <obo:IAO_0000111>patch pipette</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>Pipette fabricated with a micron sized opening (e.g., 1-3 micron) and a short taper (e.g., 1-3 mm) and usually fabricated from borosilicate glass or quartz.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <rdfs:label>patch pipette</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0002182"/>
        <obo:IAO_0000111>patch-clamp voltage clamp assay</obo:IAO_0000111>
        <obo:IAO_0000115>A voltage-clamp technique which allows for the study of the electrical properties (e.g., capacitance ) of cell membranes especially the plasma membrane of cells.   In this  electrophysiology assay a patch pipette is sealed to the surface of a membrane to monitor electrical current originating at the membrane.   One key distinction of this technique is the electrical resistance of the seal between the cell membrane and the pipette is of the order 1-100 gigaohms, permitting  robust measurements  of small currents (magnitude: picoAmpere) over the area of the cell membrane probed. This area is determined by several different standard configurations. A second key distinction is the pipette is used to transfer both the electrical stimulus to the membrane, and is also used to record the generated currents at the membrane.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000118>voltage clamp electrophysiological recording</obo:IAO_0000118>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <rdfs:label>patch-clamp voltage clamp assay</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000018 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000832"/>
        <obo:IAO_0000111>pipette pressure clamp</obo:IAO_0000111>
        <obo:IAO_0000112>Measures the pressure at the pipette during a patch clamp electrophysiological assay and adjusts the pressure to the desired value.</obo:IAO_0000112>
        <obo:IAO_0000115>Measures and clamps the pressure to a desired level</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <rdfs:label>pipette pressure clamp</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001462"/>
        <obo:IAO_0000111>potential of maximum sensitivity</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>The voltage when the derivative of the  charge with respect to voltage peaks.  It is is the membrane potential when non-linear capacitance is maximum; the potential when one-half of the total displacement charge has moved,and for a two state system the voltage when each state is equally occupied.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000118>peak voltage, V_0.5, Vpeak, setpoint</obo:IAO_0000118>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <rdfs:label>potential of maximum sensitivity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/obi.owl/IEE_0000007"/>
        <obo:IAO_0000111>real part of admittance</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>It is the conductance, where electrical admittance is a measure of how easily a circuit allows current to flow.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000118>Re(Y)</obo:IAO_0000118>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <rdfs:label>real part of admittance</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000021 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000021">
        <rdfs:subClassOf rdf:resource="http://biomodels.net/SBO/#SBO:0000254"/>
        <obo:IAO_0000111>reciprocal of conductance, b</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>Sum of the membrane and series resistance determined in a whole-cell patch clamp voltage clamp assay.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000118>1/b</obo:IAO_0000118>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <rdfs:label>reciprocal of conductance, b</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000022 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001457"/>
        <obo:IAO_0000111>sensitivity of a process to voltage</obo:IAO_0000111>
        <obo:IAO_0000112>The ability of voltage sensors (e.g., some proteins found in membranes) to respond to a change in the membrane potential.</obo:IAO_0000112>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>A quality inherent in a bearer by virtue of the bearers disposition to respond to  a change in potential.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000118>voltage sensitivity, alpha</obo:IAO_0000118>
        <rdfs:label>sensitivity of a process to voltage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000023 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000023">
        <rdfs:subClassOf rdf:resource="http://biomodels.net/SBO/#SBO:0000254"/>
        <obo:IAO_0000111>series resistance</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>Is a measure of how difficult it is for current to flow through the patch pipette.  It is the ratio of the voltage drop across the pipette relative to the current flow through the pipette.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000118>Rs, Ra, access resistance</obo:IAO_0000118>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <rdfs:label>series resistance</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000024 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_75958"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0302729"/>
        <obo:IAO_0000111>solution in patch pipette</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>The solution usually aqueous and buffered  that is used to back-fill the patch pipette during an intracellular electrophysiology recording.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <rdfs:label>solution in patch pipette</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000025 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <obo:IAO_0000111>study design control variable</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>Those variables within the study design which do not produces changes which are of interest to the assay outcome, and which, as such, should be isolated.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000119>Jason Bengtson</obo:IAO_0000119>
        <rdfs:label>study design control variable</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000026">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000417"/>
        <obo:IAO_0000111>time interval from death</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>In this case it is the time interval between death of animal and commencement of assay.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <rdfs:label>time interval from death</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/obi.owl/IEE_0000030"/>
        <obo:IAO_0000111>transformed data set for protocol electrical admittance dual sine stimulus</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>Data transformed according to the dual sine stimulus protocol.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000119>Jason Bengtson</obo:IAO_0000119>
        <rdfs:label>transformed data set for protocol electrical admittance dual sine stimulus</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000028 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/obi.owl/IEE_0000030"/>
        <obo:IAO_0000111>transformed data set for protocol membrane current, I as a function of membrane potential, V (I vs V) plot</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>Data extracted after averaging the steady state current measured at each membrane potential, and calculating the slope between two points  from the change in mean current (y or ordinate) and change in mean membrane potential (x or abscissa).  The reciprocal of the conductance at each membrane potential is then calculated from the inverse of the slope.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <rdfs:label>transformed data set for protocol membrane current, I as a function of membrane potential, V (I vs V) plot</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000029 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001025"/>
        <obo:IAO_0000111>patch pipette pressure</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>pressure at patch pipette</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <rdfs:label>patch pipette pressure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000100"/>
        <obo:IAO_0000111>transformed data set</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>data set that results from one or more data transformation processes</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <rdfs:label>transformed data set</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/obi.owl/IEE_0000032"/>
        <obo:IAO_0000111>voltage drop across membrane</obo:IAO_0000111>
        <obo:IAO_0000112>In a whole cell patch clamp voltage clamp assay it is calculated from the ratio of membrane resistance, Rm to the  sum of series and membrane resistance Rm:(Rm+Rs)</obo:IAO_0000112>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>The fraction of the voltage supplied that falls across the membrane.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000118>VD</obo:IAO_0000118>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <rdfs:label>voltage drop across membrane</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000032 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000032">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C44256"/>
        <obo:IAO_0000111>voltage drop</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>Voltage drop describes how the energy supplied by a voltage source is reduced as electric current moves through the passive elements (elements that do not supply voltage) of an electrical circuit.  It is usually denoted as a fraction of the total voltage supplied.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <rdfs:label>voltage drop</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000033 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000033">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/obi.owl/IEE_0000017"/>
        <obo:IAO_0000111>whole-cell patch-clamp voltage clamp assay</obo:IAO_0000111>
        <obo:IAO_0000115>A patch-clamp configuration where the patch pipette electrode is left in place on the cell membrane until a gigaohm seal is formed between the membrane and the pipette. After which the membrane patch is perforated either chemically, or by application of pressure or by use of an electric field all applied through the pipette. These perforations provide for an electrical connection from the interior of the pipette to the intracellular space of the cell. Measurements made with this voltage clamp technique involve recording currents associated with the entire plasma membrane of a cell or the entire membrane of an organelle.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000118>whole-cell patch-clamp voltage clamp recording</obo:IAO_0000118>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <rdfs:label>whole-cell patch-clamp voltage clamp assay</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000034 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000034">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002023"/>
        <obo:IAO_0000111>apical</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>A positional quality inhering in a bearer by virtue of the bearer&apos;s location of features or characteristics on the side of an axis containing the apex of the feature being divided along that axis.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000119>Jason Bengtson</obo:IAO_0000119>
        <rdfs:label>apical</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000035 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000035">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002023"/>
        <obo:IAO_0000111>basal</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>A positional quality inhering in a bearer by virtue of the bearer&apos;s location of features or characteristics on the side of an axis containing the base of the feature being divided along that axis.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000119>Jason Bengtson</obo:IAO_0000119>
        <rdfs:label>basal</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/obi.owl/IEE_0000036 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/obi.owl/IEE_0000036">
        <rdfs:subClassOf rdf:resource="http://identifiers.org/opb/OPB_00318"/>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>The average of the charge flow rate values</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <obo:IAO_0000119>Jason Bengtson</obo:IAO_0000119>
        <obo:IAO_0000232>new for the Farrell data</obo:IAO_0000232>
        <rdfs:label>mean charge flow rate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/incf/ontology/Computational_Neurosciences/cno_alpha.owl#cno_0000220 -->

    <owl:Class rdf:about="http://purl.org/incf/ontology/Computational_Neurosciences/cno_alpha.owl#cno_0000220">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002205"/>
        <obo:IAO_0000111>membrane capacitance</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>Measure of the amount of electric charge stored (or separated) by the cellular membrane for a given electric potential. The unit of capacitance is the Farad.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000118>membrane current</obo:IAO_0000118>
        <obo:IAO_0000119>Dr. Brenda Farrell</obo:IAO_0000119>
        <obo:IAO_0000232>imported from the CNO ontology</obo:IAO_0000232>
        <obo:IAO_0000232>new for the Farrell data</obo:IAO_0000232>
        <obo:IAO_0000412 rdf:resource="http://purl.org/incf/ontology/Computational_Neurosciences/cno_alpha.owl#cno_0000220"/>
        <rdfs:label>membrane capacitance</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/incf/ontology/Computational_Neurosciences/cno_alpha.owl#cno_0000221 -->

    <owl:Class rdf:about="http://purl.org/incf/ontology/Computational_Neurosciences/cno_alpha.owl#cno_0000221">
        <rdfs:subClassOf rdf:resource="http://biomodels.net/SBO/#SBO:0000254"/>
        <obo:IAO_0000111>membrane resistance</obo:IAO_0000111>
        <obo:IAO_0000115>Measure of the degree to which the cellular membrane opposes the passage of an electric current. The SI unit of electrical resistance is the ohm.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000118>Rm</obo:IAO_0000118>
        <obo:IAO_0000232>imported from CNO Ontology</obo:IAO_0000232>
        <obo:IAO_0000412>http://purl.org/incf/ontology/Computational_Neurosciences/cno_alpha.owl#cno_0000221</obo:IAO_0000412>
        <rdfs:label>membrane resistance</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000417 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000417">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000416"/>
        <obo:IAO_0000111>time interval</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>A time internval is a contiguous temporal region having some duration.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000232>imported from SIO ontology</obo:IAO_0000232>
        <obo:IAO_0000412>http://semanticscience.org/resource/SIO_000417</obo:IAO_0000412>
        <rdfs:label>time interval</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000418 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000418">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000416"/>
        <obo:IAO_0000111>time instant</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>A time instant is a temporal region which occurs instantaneously, e.g. having no duration.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000232>imported from SIO ontology</obo:IAO_0000232>
        <obo:IAO_0000412 rdf:resource="http://semanticscience.org/resource/SIO_000418"/>
        <rdfs:label>time instant</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000669 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000669">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000418"/>
        <obo:IAO_0000111>start time</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>A start time is a time instant pertaining to the time at which a process begins. In this case it is the time that assay begins.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000119>Definition appended by Dr. Brenda Farrell</obo:IAO_0000119>
        <obo:IAO_0000232>imported from SIO ontology</obo:IAO_0000232>
        <obo:IAO_0000412 rdf:resource="http://semanticscience.org/resource/SIO_000669"/>
        <rdfs:label>start time</rdfs:label>
    </owl:Class>
    


