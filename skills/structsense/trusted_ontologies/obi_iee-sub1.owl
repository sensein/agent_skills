        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001146"/>
        <obo:IAO_0000111 xml:lang="en">electrophoretic mobility shift assay</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">Electrophoretic mobility shift assay reveals a novel recognition sequence for Setaria italica NAC protein.
Puranik S, Kumar K, Srivastava PS, Prasad M.
Plant Signal Behav. 2011 Oct;6(10):1588-90. Epub 2011 Oct 1.
PMID: 21918373</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">is an assay which aims to provide information about Protein-DNA or Protein-RNA interaction and which used gel electrophoresis and relies on the fact the molecular interactions will cause the heterodimer to be retarded on the gel when compared to controls corresponding to protein extract alone and protein extract + neutral nucleic acid.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">PERSON:Philippe Rocca-Serra; Marcus Chibucos</obo:IAO_0000117>
        <obo:IAO_0000118 xml:lang="en">EMSA,gel shift assay, gel mobility shift assay, band shift assay, gel retardation assay</obo:IAO_0000118>
        <obo:IAO_0000119 xml:lang="en">PMID:6269071</obo:IAO_0000119>
        <rdfs:label xml:lang="en">electrophoretic mobility shift assay</rdfs:label>
    </owl:Class>
    


