        <obo:IAO_0000118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fragment library</obo:IAO_0000118>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">single fragment library</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0000737 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000737">
