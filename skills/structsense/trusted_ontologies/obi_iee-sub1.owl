        <rdfs:label>juvenile</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001193 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001193">
