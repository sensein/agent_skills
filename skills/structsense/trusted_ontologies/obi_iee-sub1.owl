    <!-- http://purl.obolibrary.org/obo/OBI_1110022 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_1110022">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GO_0019815"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GO_0042101"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GO_0042571"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0043234"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">adaptive immune receptor</obo:IAO_0000111>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000123"/>
        <obo:IAO_0000115 xml:lang="en">is a receptor produced by cells of the adaptive immune system with the purpose of binding epitopes.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">IEDB</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">IEDB</obo:IAO_0000119>
        <rdfs:label xml:lang="en">adaptive immune receptor</rdfs:label>
    </owl:Class>
    


