        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thymidine linked to the radioisotope tritium. Used to label DNA in the study of cellular and viral DNA synthesis.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/chebi.owl"/>
