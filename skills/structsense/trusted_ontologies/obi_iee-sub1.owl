        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">creating a mixture of molecules in solution</obo:IAO_0000111>
        <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The production of PBS</obo:IAO_0000112>
