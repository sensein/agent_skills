        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is realized in a planned process where the bearer participates</obo:IAO_0000115>
        <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AR: rent a DNA sequencer for a period of time. two realizations, payment for the service and also when the person who pays for the service uses it</obo:IAO_0000116>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">accessed material role</rdfs:label>
    </owl:Class>
    


