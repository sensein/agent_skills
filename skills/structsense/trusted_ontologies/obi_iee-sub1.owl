            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111 xml:lang="en">genetic transformation</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">The transduction of E. coli through the introduction of a plasmid encoding for M. avium p35</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">the introduction. alteration or integration of genetic material into a cell or organism</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">PERSON:Kevin Clancy</obo:IAO_0000117>
        <obo:IAO_0000118 xml:lang="en">genetic modification</obo:IAO_0000118>
        <obo:IAO_0000119 xml:lang="en">OBI branch derived</obo:IAO_0000119>
        <rdfs:label xml:lang="en">genetic transformation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0600044 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0600044">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0600005"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0600014"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000417"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0000639"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111 xml:lang="en">lavage</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">the collection of bronchoalveolar lavage fluid (BAL) from the lungs of mice in order to study the cytokines present</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 xml:lang="en">A protocol application to separate cells and/or cellular secretions from an anatomical space by the introduction and removal of fluid</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">This is not washing, in which case the material of interest is not the resulting fluid</obo:IAO_0000116>
        <obo:IAO_0000117 xml:lang="en">PlanAndPlannedProcess Branch</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">OBI branch derived</obo:IAO_0000119>
        <rdfs:label xml:lang="en">lavage</rdfs:label>
    </owl:Class>
    


