                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0000453"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">patch clamp device</obo:IAO_0000111>
        <obo:IAO_0000112>Measurements of whole-cell currents make use of the resistor-feedback mode of headstage i.e., the operational amplifier is in current-follower configuration. Measurements of patches of membranes make use of the capacitor feedback mode of the  headstage.</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A device used in electrophysiology that is designed to measure: small (pA) currents that originate from a membrane or  the potential (mV)  across the membrane. In addition to the electronics it requires a headstage that is designed to communicate with, and secure the patch pipette electrode that forms a high resistance seal with the membrane.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PERSON: Erik Segerdell</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dr. Brenda Farrell</obo:IAO_0000119>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">patch clamp device</rdfs:label>
    </owl:Class>
    


