        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115>A RNA-seq assay to sequence only mRNA protected by the ribosome during translation.</obo:IAO_0000115>
        <obo:IAO_0000117>Person: Venkat Malladi, Chris Stoeckert, Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000118>Ribo-seq</obo:IAO_0000118>
        <obo:IAO_0000118>Ribo-seq assay</obo:IAO_0000118>
        <obo:IAO_0000118>ribosomal profiling</obo:IAO_0000118>
        <obo:IAO_0000119>Ingolia, Nicholas T. (28 January 2014). &quot;Ribosome profiling: new views of translation, from single codons to genome scale&quot;. Nature Reviews Genetics 15 (3): 205-213. doi:10.1038/nrg3645. PMID 24468696.</obo:IAO_0000119>
        <dc:source>ENCODE project</dc:source>
        <rdfs:label>ribosomal profiling by sequencing assay</rdfs:label>
