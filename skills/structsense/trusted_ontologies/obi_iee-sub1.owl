    <!-- http://purl.obolibrary.org/obo/GO_0036262 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0036262">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
