        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 xml:lang="en">A material entity that represents generations of a primary culture.</obo:IAO_0000115>
        <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">had superclass axiom: is_specified_output_of some &apos;establishing cell culture&apos;</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PERSON: Susanna Sansone</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">GROUP: OBI Biomaterial Branch</obo:IAO_0000119>
        <obo:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000228"/>
        <obo:IAO_0100001 rdf:resource="http://purl.obolibrary.org/obo/CL_0007014"/>
