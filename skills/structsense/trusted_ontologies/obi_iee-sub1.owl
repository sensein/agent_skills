    <!-- http://purl.obolibrary.org/obo/OBI_0002039 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0002039">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000070"/>
