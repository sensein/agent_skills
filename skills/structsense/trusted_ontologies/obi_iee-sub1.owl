        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/go.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">helper T cell enhancement of adaptive immune response</rdfs:label>
