        <dc:creator xml:lang="en">Cristian Cocos</dc:creator>
        <dc:creator xml:lang="en">Stefan Wiemann</dc:creator>
        <dc:subject xml:lang="en">An ontology for the annotation of biomedical and functional genomics experiments.</dc:subject>
        <dc:creator xml:lang="en">Melanie Courtot</dc:creator>
        <dc:creator xml:lang="en">Helen Parkinson</dc:creator>
        <dc:creator xml:lang="en">Luisa Montecchi</dc:creator>
