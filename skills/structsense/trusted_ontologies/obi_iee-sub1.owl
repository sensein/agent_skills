        <obo:IAO_0000232 xml:lang="en">NMR device</obo:IAO_0000232>
        <rdfs:label xml:lang="en">liquid NMR probe</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0000560 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000560">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000038"/>
        <obo:IAO_0000111 xml:lang="en">ion exchange column</obo:IAO_0000111>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 xml:lang="en">An ion exchange column is a chromatography column that is used in ion exchange chromatography and anion or cation exchange resins to enable separation.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">PERSON:Daniel Schober</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">GROUP:&lt;http://msi-ontology.sourceforge.net&gt;</obo:IAO_0000119>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01105</obo:IAO_0000119>
        <rdfs:label xml:lang="en">ion exchange column</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0000561 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000561">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000516"/>
        <obo:IAO_0000111 xml:lang="en">Bruker NMR probe</obo:IAO_0000111>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 xml:lang="en">An NMR probe that is manufactured by Bruker.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">PERSON:Daniel Schober</obo:IAO_0000117>
