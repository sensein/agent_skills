                                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_1110023"/>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_1110001"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001000"/>
                                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_1110023"/>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
