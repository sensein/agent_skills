        <obo:IAO_0000111 xml:lang="en">enrollment</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">Enrollment of patients in a study.
Short-term outcome of neuropsychiatric events in systemic lupus erythematosus upon enrollment into an international inception cohort study. Arthritis Rheum. 2008 May 15;59(5):721-9. PMID: 18438902</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">enrollment is a process of identifying a set of objects for further use in an investigation based on a set of criteria or rules</obo:IAO_0000115>
        <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">merged with &apos;enrollment of human subjects</obo:IAO_0000116>
        <obo:IAO_0000117 xml:lang="en">Bjoern Peters</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">IEDB</obo:IAO_0000119>
        <obo:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000227"/>
        <rdfs:label xml:lang="en">obsolete_enrollment</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


