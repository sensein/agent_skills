        <rdfs:label xml:lang="en">imprinting design</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001409 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001409">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0500000"/>
