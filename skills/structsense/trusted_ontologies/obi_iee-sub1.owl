            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">epitope protection experiment based on survival</obo:IAO_0000111>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">an epitope protection experiment that determines the success of the epitope intervention based on increased survival of the host.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bjoern Peters</obo:IAO_0000117>
        <obo:OBI_9991118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">host survival after challenge</obo:OBI_9991118>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">epitope protection experiment based on survival</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001190 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001190">
