            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111 xml:lang="en">DNA transduction</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">The transfer of a recombinant bacterial plasmid into E.coli to facilitate amplification of a specific protein</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">a genetic transformation which relies on the use of lysogenic infection to transfer DNA sequences into an organism</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">PERSON:Kevin Clancy</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">OBI branch derived</obo:IAO_0000119>
