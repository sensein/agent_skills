            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000039"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000002"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111>mass value specification</obo:IAO_0000111>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000123"/>
        <obo:IAO_0000115>A value specification that specifies the mass of some thing.</obo:IAO_0000115>
        <obo:IAO_0000117>PERSON:Bjoern Peters</obo:IAO_0000117>
        <rdfs:label>mass value specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001930 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001930">
