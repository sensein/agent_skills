    <!-- http://purl.obolibrary.org/obo/OBI_0002032 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0002032">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001014"/>
