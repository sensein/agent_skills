    <!-- http://purl.obolibrary.org/obo/OBI_0002047 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0002047">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000047"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
