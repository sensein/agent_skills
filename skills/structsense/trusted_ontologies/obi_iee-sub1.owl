        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Storage of a blood specimen in a tube with anticoagulant</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Person:Alan Ruttenberg</obo:IAO_0000117>
