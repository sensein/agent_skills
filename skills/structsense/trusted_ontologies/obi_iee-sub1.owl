        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The appearance of granzyme A due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/go.owl"/>
