    <!-- http://purl.obolibrary.org/obo/OBI_0000162 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000162">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000204"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">complete nutrient role</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">Rat chow; RPMI medium + serum; use example:  CNS17 (Complete Nutrient System) Grow 3-2-4, http://www.kalyx.com/store/proddetail.cfm/ItemID/552307/CategoryID/12000/SubCatID/2755/file.htm</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000123"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nutrient role that inheres in a material entity and is realized in the use of that material entity by an organism to provide all needed nourishment.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Person: Jennifer Fostel</obo:IAO_0000117>
        <obo:IAO_0000118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">complete nutrient</obo:IAO_0000118>
        <rdfs:label xml:lang="en">complete nutrient role</rdfs:label>
    </owl:Class>
    


