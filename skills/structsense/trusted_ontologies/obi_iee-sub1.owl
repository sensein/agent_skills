        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">labeled DNA extract</obo:IAO_0000111>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a labeled specimen that is the output of a labeling process and has grain labeled DNA to be able to detect DNA in future experiments.</obo:IAO_0000115>
        <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Need to find out if we consider labeled nucleotides still nucleotides. It is after consulting with ChEBI group.
Added duirng Mar 1, 2010 dev call</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Group: OBI group</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Group: OBI group</obo:IAO_0000119>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">labeled DNA extract</rdfs:label>
