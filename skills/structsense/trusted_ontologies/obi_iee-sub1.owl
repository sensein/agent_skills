        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">diluted</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001167 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001167">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001237"/>
