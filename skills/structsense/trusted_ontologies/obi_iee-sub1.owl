        <obo:IAO_0000119 xml:lang="en">GROUP:&lt;http://msi-ontology.sourceforge.net&gt;</obo:IAO_0000119>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400246</obo:IAO_0000119>
        <obo:IAO_0000232 xml:lang="en">NMR instrument</obo:IAO_0000232>
        <rdfs:label xml:lang="en">tecmag NMR console</rdfs:label>
    </owl:Class>
    


