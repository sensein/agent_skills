    <!-- http://purl.obolibrary.org/obo/CHEBI_59055 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_59055">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23367"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(S)-1-(4-bromoacetamidobenzyl)EDTA</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A tetracarboxylic acid consisting of ethylenediaminetetraacetic acid having a 4-bromoacetamidobenzyl group at the C1-position and (S)-configuration.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/chebi.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(S)-1-(4-bromoacetamidobenzyl)EDTA</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_59056 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_59056">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23367"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EDTA methidiumpropylamide</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A combined intercalating and chelating reagent. The iron chelate, prepared by adding Fe(NH4)2(SO4)2, effects random oxidative cleavage of DNA in the presence of O2 and a reducing agent. This activity is useful as a footprinting probe.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/chebi.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EDTA methidiumpropylamide</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_59424 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_59424">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23367"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bromophenol blue</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3H-2,1-Benzoxathiole 1,1-dioxide in which both of the hydrogens at position 3 have been substituted by 3,5-dibromo-4-hydroxyphenyl groups. It is used as a laboratory indicator, changing from yellow below pH 3 to purple at pH 4.6, and as a size marker for monitoring the progress of agarose gel and polyacrylamide gel electrophoresis. It has also been used as an industrial dye.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/chebi.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bromophenol blue</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_59999 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_59999">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <obo:IAO_0000111>chemical substance</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>A chemical substance is a portion of matter of constant composition, composed of molecular entities of the same type or of different types.</obo:IAO_0000115>
        <obo:IAO_0000117>Jason Bengtson</obo:IAO_0000117>
        <obo:IAO_0000232>imported from the ChEBI ontology</obo:IAO_0000232>
        <obo:IAO_0000412>http://purl.obolibrary.org/obo/CHEBI_59999</obo:IAO_0000412>
        <rdfs:label>chemical substance</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_60004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_60004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_59999"/>
        <obo:IAO_0000111>chemical substance</obo:IAO_0000111>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115>A mixture is a chemical substance composed of multiple molecules, at least two of which are of a different kind.</obo:IAO_0000115>
