                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111 xml:lang="en">DNA polymerase amplification</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">The use of taq polymerase to amplify a DNA fragment during a PCR.</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 xml:lang="en">DNA polymerase amplification is an enzymatic amplification which uses DNA polymerase enzyme to make copies of a DNA contained in biomaterial used as input</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">PERSON:Kevin Clancy</obo:IAO_0000117>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Philippe Rocca-Serra</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">OBI branch derived</obo:IAO_0000119>
        <rdfs:label xml:lang="en">DNA polymerase amplification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0600050 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0600050">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000231"/>
        <obo:IAO_0000111 xml:lang="en">specific enzymatic cleavage</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">The use of a protease to digest a protein into peptides</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">a protocol application to digest the fraction of input material that is susceptible to that enzyme</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">PERSON:Kevin Clancy</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">OBI branch derived</obo:IAO_0000119>
