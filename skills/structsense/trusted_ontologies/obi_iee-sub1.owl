        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115>A value specification that specifies the value of the RNA Integrity Number as a real value between 1 (most degraded) and 10 (most intact).</obo:IAO_0000115>
        <obo:IAO_0000117>Chris Stoeckert, Bjoern Peters</obo:IAO_0000117>
        <obo:IAO_0000118>RIN value specification</obo:IAO_0000118>
        <obo:IAO_0000119>OBI</obo:IAO_0000119>
        <rdfs:label xml:lang="en">RNA Integrity Number value specification</rdfs:label>
    </owl:Class>
    


