        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">environmental exposure to infectious agent</obo:IAO_0000111>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000123"/>
        <obo:IAO_0000115 xml:lang="en">Is a process in which an infectious agent is in direct contact with a potential host organism in its habitat. This is preceded by proximity to the infectious agent</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">IEDB</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">IEDB</obo:IAO_0000119>
        <rdfs:label xml:lang="en">environmental exposure to infectious agent</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_1110026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_1110026">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0100026"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_1110083"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0100026"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">host of immune response</obo:IAO_0000111>
        <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mouse that is vaccinated with a peptide and develops protective immunity. A human exposed to bacteria that are killed by pre-existing immune responses.</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 xml:lang="en">An organism in which an immune response process occurs.</obo:IAO_0000115>
        <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In immune response processes in the context of infectious diseases and allergy, there are often multiple organisms involved, which requires calling out the &apos;host&apos;. This terminology is expanded to allergy, cancer and  transplantation.</obo:IAO_0000116>
        <obo:IAO_0000117 xml:lang="en">IEDB</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">IEDB</obo:IAO_0000119>
        <rdfs:label xml:lang="en">host of immune response</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_1110028 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_1110028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CLO_0009828"/>
