                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0400008"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0400082"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0400104"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0400115"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111 xml:lang="en">substance detection</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">the detection of phycoerytherin by means of flow cytometry</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">any protocol which results in the detection of a specified substance</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">PERSON:Kevin Clancy</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">OBI branch derived</obo:IAO_0000119>
        <rdfs:label xml:lang="en">substance detection</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0600026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0600026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000070"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
