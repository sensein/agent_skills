        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001192"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">T cell epitope specific immune intervention</obo:IAO_0000111>
