    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_59053 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_59053">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23367"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">N-cyclohexyl-N&apos;-(2-(4-morpholinyl)ethyl)carbodiimide</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A carbodiimide having cyclcohexyl and 2-(4-morpholinyl)ethyl as the two N-substituents.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/chebi.owl"/>
