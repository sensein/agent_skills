        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">X-ray crystallography assay</obo:IAO_0000111>
        <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Crystallizing an antibody:antigen complex, and recording the diffraction pattern of a synchrotron beam, and assembling the 3d complex structure based on homologous complexes.</obo:IAO_0000112>
