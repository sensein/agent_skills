        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trypsination</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">The use of mild trypsinization conditions in the detachment of endothelial cells to promote subsequent endothelialization on synthetic surfaces. Biomaterials. 2007 Sep;28(27):3928-35. PMID: 17570483</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">trypsination is a protease cleavage which uses enzyme trypsin to act on proteins present in an input material entity</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Philippe Rocca-Serra</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OBI PA</obo:IAO_0000119>
        <rdfs:label xml:lang="en">trypsination</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0302892 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0302892">
