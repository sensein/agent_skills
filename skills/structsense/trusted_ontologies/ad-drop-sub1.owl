<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/AD-DROP#"
     xml:base="http://www.semanticweb.org/AD-DROP"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:AD-DROP="http://www.semanticweb.org/AD-DROP#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/AD-DROP">
        <rdfs:label>Alzheimer Disease Relevance Ontology by Process</rdfs:label>
        <rdfs:seeAlso>AD-DROP</rdfs:seeAlso>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/AD-DROP#part_of -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/AD-DROP#part_of">
        <rdfs:label>part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/AD-DROP#Lancet_score -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/AD-DROP#Lancet_score">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/AD-DROP#pathogenic_intensity_level"/>
        <rdfs:label>Lancet score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/AD-DROP#frequency_score -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/AD-DROP#frequency_score">
        <rdfs:label>frequency score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/AD-DROP#pathogenic_intensity_level -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/AD-DROP#pathogenic_intensity_level">
        <rdfs:label>pathogenic intensity level</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/AD-DROP#specificity_level -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/AD-DROP#specificity_level">
        <rdfs:label>specificity level</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/AD-DROP#AlzheimerDiseaseTypedisease-relevantProcess -->

    <owl:Class rdf:about="http://www.semanticweb.org/AD-DROP#AlzheimerDiseaseTypedisease-relevantProcess">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/AD-DROP#disease-relevantProcessBySpecificity"/>
        <rdfs:isDefinedBy>&apos;identified disease-relevant process&apos;(?x), &apos;specificity level&apos;(?x, ?SL), equal(?SL, 6) -&gt; &apos;Alzheimer Disease type disease-relevant process&apos;(?x)</rdfs:isDefinedBy>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Process that appears relevant for Alzheimer disease (AD) with a value equal to 6 the specificity toward AD</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Alzheimer Disease type disease-relevant process</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Alzheimer Disease type DRP</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/AD-DROP#AlzheimerDiseasedisease-relevantProcess -->

    <owl:Class rdf:about="http://www.semanticweb.org/AD-DROP#AlzheimerDiseasedisease-relevantProcess">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/AD-DROP#disease-relevantProcessBySpecificity"/>
        <rdfs:isDefinedBy>&apos;identified disease-relevant process&apos;(?x), &apos;specificity level&apos;(?x, ?SL), equal(?SL, 5) -&gt; &apos;Alzheimer Disease disease-relevant process&apos;(?x)</rdfs:isDefinedBy>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Process that appears relevant for Alzheimer disease (AD) with a value equal to 5 the specificity toward AD</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Alzheimer Disease disease-relevant process</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Alzheimer Disease DRP</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/AD-DROP#classifieddisease-relevantProcessByProperties -->

    <owl:Class rdf:about="http://www.semanticweb.org/AD-DROP#classifieddisease-relevantProcessByProperties">
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Upper class of a branch where DRPs are classified through their properties of specificity, frequency and/or pathogenic intensity toward Alzheimer disease. No DRPs should be asserted in this branch, they will be classified according logical reasoning.</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Process that appears relevant for Alzheimer disease (AD) with at least one value for one of the specificity, frequency or pathogenic intensity toward AD</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">classified disease-relevant process by properties</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">classified DRP by properties</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/AD-DROP#communlyFrequentdisease-relevantProcess -->

    <owl:Class rdf:about="http://www.semanticweb.org/AD-DROP#communlyFrequentdisease-relevantProcess">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/AD-DROP#disease-relevantProcessByFrequency"/>
        <rdfs:isDefinedBy>&apos;identified disease-relevant process&apos;(?x), &apos;frequency score&apos;(?x, ?FS), greaterThanOrEqual(?FS, 25), lessThan(?FS, 50)  -&gt; &apos;communly frequent disease-relevant process&apos;(?x)</rdfs:isDefinedBy>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Process that appears relevant for Alzheimer disease (AD) with a value between 25 and 49% for its frequency toward AD</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communly frequent disease-relevant process</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Communly frequent DRP</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/AD-DROP#disease-relevantProcessByFrequency -->

    <owl:Class rdf:about="http://www.semanticweb.org/AD-DROP#disease-relevantProcessByFrequency">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/AD-DROP#classifieddisease-relevantProcessByProperties"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DRP by pathogenic intensity is the upper class of 4 classes wich represente 4 levels of frequency on a scale from occasional DRP to very frequent DRP. These levels depend to the DRP value (occasional [1-24%], commun [25-49%], frequent [50-74%] and very frequent [75-100])</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Process that appears relevant for Alzheimer disease (AD) with one value for frequency toward AD</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">disease-relevant process by Frequency</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DRP by Frequency</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/AD-DROP#disease-relevantProcessByPathogenicIntensity -->

    <owl:Class rdf:about="http://www.semanticweb.org/AD-DROP#disease-relevantProcessByPathogenicIntensity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/AD-DROP#classifieddisease-relevantProcessByProperties"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DRP by pathogenic intensity is the upper class of 3 classes wich represente 3 levels of pathogenic intensity on a scale from lowly intense DRP to highly DRP. These levels depend to the DRP value (low [1-3], middle [4-7], high [8-] according lancet score (Lancet&apos;s “population attributable fraction” attributed to this DRP (p. 428, Livingston et al., 2020)))</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Process that appears relevant for Alzheimer disease (AD) with at least one value for pathogenic intensity toward AD</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">disease-relevant process by pathogenic intensity</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DRP by pathogenic intensity</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/AD-DROP#disease-relevantProcessBySpecificity -->

    <owl:Class rdf:about="http://www.semanticweb.org/AD-DROP#disease-relevantProcessBySpecificity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/AD-DROP#classifieddisease-relevantProcessByProperties"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DRP by specificity is the upper class of 7 classes wich represente 7 levels of specificities on a scale from individual DRP to life-style DRP. These levels depend to the DRP value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Process that appears relevant for Alzheimer disease (AD) with one value for one of the specificity toward AD</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">disease-relevant process by specificity</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DRP by specificity</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/AD-DROP#environmentaldisease-relevantProcess -->

    <owl:Class rdf:about="http://www.semanticweb.org/AD-DROP#environmentaldisease-relevantProcess">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/AD-DROP#identifieddisease-relevantProcess"/>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DRP identified as belonging to environmental level.</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">environmental disease-relevant process</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">environmental DRP</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/AD-DROP#frequentdisease-relevantProcess -->

    <owl:Class rdf:about="http://www.semanticweb.org/AD-DROP#frequentdisease-relevantProcess">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/AD-DROP#disease-relevantProcessByFrequency"/>
        <rdfs:isDefinedBy>&apos;identified disease-relevant process&apos;(?x), &apos;frequency score&apos;(?x, ?FS), greaterThanOrEqual(?FS, 50), lessThan(?FS, 75) -&gt; &apos;frequent disease-relevant process&apos;(?x)</rdfs:isDefinedBy>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Process that appears relevant for Alzheimer disease (AD) with a value between 50 and 74% for its frequency toward AD</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">frequent disease-relevant process</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Frequent DRP</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/AD-DROP#gene-relateddisease-relevantProcess -->

    <owl:Class rdf:about="http://www.semanticweb.org/AD-DROP#gene-relateddisease-relevantProcess">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/AD-DROP#identifieddisease-relevantProcess"/>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DRP identified as belonging to gene level.</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gene-related disease-relevant process</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gene-related DRP</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/AD-DROP#highlyImpactingdisease-relevantProcess -->

    <owl:Class rdf:about="http://www.semanticweb.org/AD-DROP#highlyImpactingdisease-relevantProcess">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/AD-DROP#disease-relevantProcessByPathogenicIntensity"/>
        <rdfs:isDefinedBy>&apos;identified disease-relevant process&apos;(?x), &apos;pathogenic intensity level&apos;(?x, ?PIL), greaterThan(?PIL, 7) -&gt; &apos;highly impacting disease-relevant process&apos;(?x)</rdfs:isDefinedBy>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Process that appears relevant for Alzheimer disease (AD) with a value greater than 8 to its intensity toward AD</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">highly impacting disease-relevant process</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">highly impacting DRP</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/AD-DROP#identifieddisease-relevantProcess -->

    <owl:Class rdf:about="http://www.semanticweb.org/AD-DROP#identifieddisease-relevantProcess">
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Upper class of a branch where DRPs are classified through their traditionnal biological level (gene-related, molecular, physiological…). Any DRPs should be asserted in this branch.</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Process that appears relevant for Alzheimer disease.</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identified disease-relevant process</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identified DRP</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/AD-DROP#individualdisease-relevantProcess -->

    <owl:Class rdf:about="http://www.semanticweb.org/AD-DROP#individualdisease-relevantProcess">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/AD-DROP#disease-relevantProcessBySpecificity"/>
        <rdfs:isDefinedBy>&apos;identified disease-relevant process&apos;(?x), &apos;specificity level&apos;(?x, ?SL), equal(?SL, 7) -&gt; &apos;individual disease-relevant process&apos;(?x)</rdfs:isDefinedBy>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Process that appears relevant for Alzheimer disease (AD) with a value equal to 7 the specificity toward AD</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">individual disease-relevant process</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">individual DRP</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/AD-DROP#life-styledisease-relevantProcess -->

    <owl:Class rdf:about="http://www.semanticweb.org/AD-DROP#life-styledisease-relevantProcess">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/AD-DROP#disease-relevantProcessBySpecificity"/>
        <rdfs:isDefinedBy>&apos;identified disease-relevant process&apos;(?x), &apos;specificity level&apos;(?x, ?SL), equal(?SL, 2) -&gt; &apos;life-style disease-relevant process&apos;(?x)</rdfs:isDefinedBy>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Process that appears relevant for Alzheimer disease (AD) with a value equal to 2 the specificity toward AD</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">life-style disease-relevant process</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">life-style DRP</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/AD-DROP#lifedisease-relevantProcess -->

    <owl:Class rdf:about="http://www.semanticweb.org/AD-DROP#lifedisease-relevantProcess">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/AD-DROP#disease-relevantProcessBySpecificity"/>
        <rdfs:isDefinedBy>&apos;identified disease-relevant process&apos;(?x), &apos;specificity level&apos;(?x, ?SL), equal(?SL, 1) -&gt; &apos;life disease-relevant process&apos;(?x)</rdfs:isDefinedBy>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Process that appears relevant for Alzheimer disease (AD) with a value equal to 1 the specificity toward AD</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">life disease-relevant process</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">life DRP</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/AD-DROP#lowlyImpactingdisease-relevantProcess -->

    <owl:Class rdf:about="http://www.semanticweb.org/AD-DROP#lowlyImpactingdisease-relevantProcess">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/AD-DROP#disease-relevantProcessByPathogenicIntensity"/>
        <rdfs:isDefinedBy>&apos;identified disease-relevant process&apos;(?x), &apos;pathogenic intensity level&apos;(?x, ?PIL), greaterThanOrEqual(?PIL, 1), lessThan(?PIL, 3) -&gt; &apos;lowly impacting disease-relevant process&apos;(?x)</rdfs:isDefinedBy>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Process that appears relevant for Alzheimer disease (AD) with a value between 4 and 7 for its the pathogenic intensity toward AD</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lowly impacting disease-relevant process</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lowly impacting DRP</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/AD-DROP#midlyImpactingdisease-relevantProcess -->

    <owl:Class rdf:about="http://www.semanticweb.org/AD-DROP#midlyImpactingdisease-relevantProcess">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/AD-DROP#disease-relevantProcessByPathogenicIntensity"/>
        <rdfs:isDefinedBy>&apos;identified disease-relevant process&apos;(?x), &apos;pathogenic intensity level&apos;(?x, ?PIL), greaterThanOrEqual(?PIL, 4), lessThan(?PIL, 8) -&gt; &apos;midly impacting disease-relevant process&apos;(?x)</rdfs:isDefinedBy>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Process that appears relevant for Alzheimer disease (AD) with a value between 1 and 3 for its the pathogenic intensity toward AD</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">midly impacting disease-relevant process</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">midly impacting DRP</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/AD-DROP#moleculardisease-relevantProcess -->

    <owl:Class rdf:about="http://www.semanticweb.org/AD-DROP#moleculardisease-relevantProcess">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/AD-DROP#identifieddisease-relevantProcess"/>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DRP identified as belonging to molecular level.</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">molecular disease-relevant process</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Molecular DRP</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/AD-DROP#neurodegenerativeDiseasedisease-relevantProcess -->

    <owl:Class rdf:about="http://www.semanticweb.org/AD-DROP#neurodegenerativeDiseasedisease-relevantProcess">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/AD-DROP#disease-relevantProcessBySpecificity"/>
        <rdfs:isDefinedBy>&apos;identified disease-relevant process&apos;(?x), &apos;specificity level&apos;(?x, ?SL), equal(?SL, 4) -&gt; &apos;neurodegenerative disease disease-relevant process&apos;(?x)</rdfs:isDefinedBy>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Process that appears relevant for Alzheimer disease (AD) with a value equal to 4 the specificity toward AD</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">neurodegenerative disease disease-relevant process</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">neurodegenerative disease DRP</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/AD-DROP#occasionaldisease-relevantProcess -->

    <owl:Class rdf:about="http://www.semanticweb.org/AD-DROP#occasionaldisease-relevantProcess">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/AD-DROP#disease-relevantProcessByFrequency"/>
        <rdfs:isDefinedBy>&apos;identified disease-relevant process&apos;(?x), &apos;frequency score&apos;(?x, ?FS), greaterThanOrEqual(?FS, 1), lessThan(?FS, 25)  -&gt; &apos;occasional disease-relevant process&apos;(?x)</rdfs:isDefinedBy>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Process that appears relevant for Alzheimer disease (AD) with a value between 1 and 24% for its frequency toward AD</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">occasional disease-relevant process</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Occasional DRP</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/AD-DROP#otherdisease-relevantProcess -->

    <owl:Class rdf:about="http://www.semanticweb.org/AD-DROP#otherdisease-relevantProcess">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/AD-DROP#identifieddisease-relevantProcess"/>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Identified DRP that do not refer to any discribed biological level.</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">other disease-relevant process</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Other DRP</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/AD-DROP#pathogenicdisease-relevantProcess -->

    <owl:Class rdf:about="http://www.semanticweb.org/AD-DROP#pathogenicdisease-relevantProcess">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/AD-DROP#disease-relevantProcessBySpecificity"/>
        <rdfs:isDefinedBy>&apos;identified disease-relevant process&apos;(?x), &apos;specificity level&apos;(?x, ?SL), equal(?SL, 3) -&gt; &apos;pathogenic disease-relevant process&apos;(?x)</rdfs:isDefinedBy>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Process that appears relevant for Alzheimer disease (AD) with a value equal to 3 the specificity toward AD</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pathogenic disease-relevant process</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pathogenic DRP</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/AD-DROP#pathologicaldisease-relevantProcess -->

    <owl:Class rdf:about="http://www.semanticweb.org/AD-DROP#pathologicaldisease-relevantProcess">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/AD-DROP#identifieddisease-relevantProcess"/>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DRP identified as belonging to pathological level.</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pathological disease-relevant process</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pathological DRP</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/AD-DROP#physiologicaldisease-relevantProcess -->

    <owl:Class rdf:about="http://www.semanticweb.org/AD-DROP#physiologicaldisease-relevantProcess">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/AD-DROP#identifieddisease-relevantProcess"/>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DRP identified as belonging to physiological level.</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">physiological disease-relevant process</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physiological DRP</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/AD-DROP#veryFrequentdisease-relevantProcess -->

    <owl:Class rdf:about="http://www.semanticweb.org/AD-DROP#veryFrequentdisease-relevantProcess">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/AD-DROP#disease-relevantProcessByFrequency"/>
        <rdfs:isDefinedBy>&apos;identified disease-relevant process&apos;(?x), &apos;frequency score&apos;(?x, ?FS), greaterThanOrEqual(?FS, 75) -&gt; &apos;very frequent disease-relevant process&apos;(?x)</rdfs:isDefinedBy>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Process that appears relevant for Alzheimer disease (AD) with a value between 75 and 100% for its frequency toward AD</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">very frequent disease-relevant process</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Very frequent DRP</rdfs:seeAlso>
    </owl:Class>
    


