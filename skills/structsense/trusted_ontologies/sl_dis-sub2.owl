                <owl:someValuesFrom rdf:resource="http://example.org/ontology/Breath_abnormalities_complaint"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology#possibleCauseOf"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/Breath_abnormalities_observation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
