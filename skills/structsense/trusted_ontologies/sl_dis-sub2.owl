    <!-- http://example.org/ontology/CaffeineConsumption -->

    <owl:Class rdf:about="http://example.org/ontology/CaffeineConsumption">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/LifestylePattern"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology#possibleCauseOf"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/Autonomic_symptoms"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology#possibleCauseOf"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/Insomnia_initiating"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology#possibleCauseOf"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/Insomnia_maintaining"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology#possibleCauseOf"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/Myoclonic_jerks_icsd"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology#possibleCauseOf"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/Short_sleep_time"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <Concept_name>Caffeine consumption</Concept_name>
