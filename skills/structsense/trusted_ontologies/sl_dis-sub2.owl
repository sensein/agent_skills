    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotations
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <rdf:Description rdf:about="http://example.org/ontology/Abnormal_responsiveness">
        <Concept_name>Abnormal responsiveness</Concept_name>
        <rdfs:comment>Not reacting normally to the environment, people, or stimuli</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/Absent_of_major_sleep_period">
        <Concept_name>Absent of major sleep period</Concept_name>
        <rdfs:comment>Lack of consolidated primary sleep episode</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/Advance_in_the_sleep_period">
        <Concept_name>Advance in sleep period</Concept_name>
        <rdfs:comment>Earlier than normal sleep onset and wake times</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/AdvancedSleepWakePhaseDisorder">
        <Concept_name>Advanced sleep wake phase disorder</Concept_name>
        <obo:IAO_0000115>A circadian rhythm sleep-wake disorder in which sleep quality and duration are normal but sleep onset and wake times are earlier than desired or earlier than socially acceptable times.</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/AdvancedSleepWakePhaseDisorder"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A circadian rhythm sleep-wake disorder in which sleep quality and duration are normal but sleep onset and wake times are earlier than desired or earlier than socially acceptable times.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.uptodate.com/contents/advanced-sleep-wake-phase-disorder/print</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/Affective_symptoms">
        <Concept_name>Affective symptoms</Concept_name>
        <rdfs:comment>Emotional disturbances such as anxiety, depression, or irritability</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/Altered_oniric_activity">
        <Concept_name>Altered oniric activity</Concept_name>
        <rdfs:comment>Disturbances in the dreaming process during sleep, especially in REM sleep, when most vivid dreams occur</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/Ambulation">
        <Concept_name>Ambulation</Concept_name>
        <rdfs:comment>Waling or moving around, often assessed during sleep disorders such as sleepwalking (somnambulism)</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/Amnesia">
        <Concept_name>Amnesia</Concept_name>
        <rdfs:comment>Loss of memory, particularly the inability to recall experiences during or immediately after sleep</rdfs:comment>
        <skos:closeMatch>http://purl.obolibrary.org/obo/SYMP_0000543</skos:closeMatch>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/Autonomic_symptoms">
        <Concept_name>Autonomic symptoms</Concept_name>
        <rdfs:comment>Physiological responses mediated by the autonomic nervous system during sleep</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/Behavioral_symptoms_during_sleep">
        <Concept_name>Behavioural symptoms during sleep</Concept_name>
        <rdfs:comment>Observable motor or vocal activities during sleep that are abnormal or excessive</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/BenignSleepMyoclonusOfInfancy">
        <Concept_name>Benign sleep myoclonus of infancy</Concept_name>
        <obo:IAO_0000115>A movement disorder that typically starts within the first 15 days of life, occurs during sleep, and consists of intermittent repetitive jerks of the limbs at two to three per second. It is often evoked by gently restraining the child. Benign sleep myoclonus of infancy is usually not associated with any other neurologic impairment and spontaneously subsides within the first year of life.</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/BenignSleepMyoclonusOfInfancy"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A movement disorder that typically starts within the first 15 days of life, occurs during sleep, and consists of intermittent repetitive jerks of the limbs at two to three per second. It is often evoked by gently restraining the child. Benign sleep myoclonus of infancy is usually not associated with any other neurologic impairment and spontaneously subsides within the first year of life.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.medlink.com/articles/benign-sleep-myoclonus-of-infancy</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/Breath_abnormalities_complaint">
        <Concept_name>Breath abnormalities complaints</Concept_name>
        <rdfs:comment>Patient-reported breathing issues during sleep, like snoring, choking, or apnea</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/Breath_abnormalities_observation">
        <Concept_name>Breath abnormalities observations</Concept_name>
        <rdfs:comment>CLinician or partner-observed abnormal brathing during sleep</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/Cataplexy">
        <Concept_name>Cataplexy</Concept_name>
        <rdfs:comment>Sudden, transient loss of voluntary muscle tone triggered by strong emotions, typically in narcolepsy type1</rdfs:comment>
        <skos:closeMatch>http://purl.obolibrary.org/obo/SYMP_0000408</skos:closeMatch>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/CentralSleepApneaDueToHighAltitudePeriodicBreathing">
        <Concept_name>Central sleep apnea due to high altitude periodic breathing</Concept_name>
        <obo:IAO_0000115>Instability in the ventilatory system induced by altitude can lead to the development of periodic breathing and central apneas during sleep.</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/CentralSleepApneaDueToHighAltitudePeriodicBreathing"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Instability in the ventilatory system induced by altitude can lead to the development of periodic breathing and central apneas during sleep.</owl:annotatedTarget>
        <obo:IAO_0000119>https://pmc.ncbi.nlm.nih.gov/articles/PMC3227706/</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/CentralSleepApneaWithCheyneStokesBreathing">
        <Concept_name>Central sleep apnea with Cheyne Stokes breathing</Concept_name>
        <obo:IAO_0000115>A form of periodic breathing, commonly observed in patients with heart failure</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/CentralSleepApneaWithCheyneStokesBreathing"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A form of periodic breathing, commonly observed in patients with heart failure</owl:annotatedTarget>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/18250216/</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/Circadian_period_gt_24h">
        <Concept_name>Circadian period &gt; 24H</Concept_name>
        <rdfs:comment>Intrinsic sleep wake cycle longer than 24 hours</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/ConfusionalArousals">
        <Concept_name>Confusional arousals</Concept_name>
        <obo:IAO_0000115>Episodes where you partially wake up from non-rapid eye movement (NREM) sleep with confusion and disorientation. You might mumble or stare off into space or be unable to respond when someone talks to you. Then, you’ll fall back to sleep.</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/ConfusionalArousals"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Episodes where you partially wake up from non-rapid eye movement (NREM) sleep with confusion and disorientation. You might mumble or stare off into space or be unable to respond when someone talks to you. Then, you’ll fall back to sleep.</owl:annotatedTarget>
        <obo:IAO_0000119>https://my.clevelandclinic.org/health/diseases/confusional-arousals</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/Daytime_sleepiness">
        <Concept_name>Daytime sleepiness</Concept_name>
        <rdfs:comment>Excessive propensity to fall asleep during the day</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/Delay_in_the_sleep_period">
        <Concept_name>Delay in the sleep period</Concept_name>
        <rdfs:comment>Later than normal sleep onset and wake times</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/DelayedSleepWakePhaseDisorder">
        <Concept_name>Delayed sleep wake phase disorder</Concept_name>
        <obo:IAO_0000115>Defined by a delay in the major sleep episode relative to desired or required sleep and wake times.</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/DelayedSleepWakePhaseDisorder"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Defined by a delay in the major sleep episode relative to desired or required sleep and wake times.</owl:annotatedTarget>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/31890097/</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/Disturbed_sleep_period">
        <Concept_name>Disturbed sleep period</Concept_name>
        <rdfs:comment>Disrupted or fragmented sleep</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/Eating_symptoms">
        <Concept_name>Eating symptoms</Concept_name>
        <rdfs:comment>Abnormal eating behaviours occuring during sleep</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/ExplodingHeadSyndrome">
        <Concept_name>Exploding head Syndrome</Concept_name>
        <obo:IAO_0000115>A benign sensory parasomnia characterized by the sensation of hearing a loud sound, such as an explosion or gunshot, during transitions between sleep and wakefulness. This sensation often leads to abrupt awakening, accompanied by distress but without significant pain.</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/ExplodingHeadSyndrome"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A benign sensory parasomnia characterized by the sensation of hearing a loud sound, such as an explosion or gunshot, during transitions between sleep and wakefulness. This sensation often leads to abrupt awakening, accompanied by distress but without significant pain.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/books/NBK560817/</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/Fatigue">
        <Concept_name>Fatigue</Concept_name>
        <rdfs:comment>A subjective sense of tiredness or lack of energy, distinct from sleepiness</rdfs:comment>
        <skos:closeMatch>http://purl.jp/bio/11/csso/CSSO_000119</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/SYMP_0019177</skos:closeMatch>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/Fright_behavior">
        <Concept_name>Fright behaviour</Concept_name>
        <rdfs:comment>Sudden, intense fear or panic response during sleep</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/HypersomniaAssociatedWithPsychiatricDisorder">
        <Concept_name>Hypersomnia Associated With Psychiatric disorder</Concept_name>
        <obo:IAO_0000115>An excessive sleepiness that is not caused by a medical condition, substance use, or sleep disorder, but is instead associated with a mental health condition.</obo:IAO_0000115>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/IdiopathicHypersomnia">
        <Concept_name>Idiopathic Hypersomnia</Concept_name>
        <obo:IAO_0000115>An excessive daytime sleepiness after getting a full night&apos;s rest.</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/IdiopathicHypersomnia"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An excessive daytime sleepiness after getting a full night&apos;s rest.</owl:annotatedTarget>
        <obo:IAO_0000119>https://my.clevelandclinic.org/health/diseases/idiopathic-hypersomnia</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/Incomplete_awakening">
        <Concept_name>Incomplete awakening</Concept_name>
        <rdfs:comment>Partial arousal from sleep where the patient is confused, disoriented, or not fully conscious</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/InsomniaDisorderChronic">
        <Concept_name>Chronic insomnia</Concept_name>
        <obo:IAO_0000115>Occurs 3 or more nights a week, lasts more than 3 months, and cannot be fully explained by another health problem.</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/InsomniaDisorderChronic"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Occurs 3 or more nights a week, lasts more than 3 months, and cannot be fully explained by another health problem.</owl:annotatedTarget>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/30252392/</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/InsomniaDisorderShortTerm">
        <Concept_name>Short-term Insomnia</Concept_name>
        <obo:IAO_0000115>Episodes of insomnia that last a few days at a time (less than 3 months)</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/InsomniaDisorderShortTerm"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Episodes of insomnia that last a few days at a time (less than 3 months)</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.hopkinsmedicine.org/health/conditions-and-diseases/insomnia</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/Insomnia_early">
        <Concept_name>Insomnia early</Concept_name>
        <rdfs:comment>Difficulty maintaining sleep or waking too early in the sleep period</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/Insomnia_initiating">
        <Concept_name>Insomnia initiating</Concept_name>
        <rdfs:comment>Difficulty falling asleep at the beginning of the sleep period</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/Insomnia_maintaining">
        <Concept_name>Insomnia maintaining</Concept_name>
        <rdfs:comment>Difficulty staying asleep throught the night, frquent awakenings</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/InsufficientSleepSyndrome">
        <Concept_name>Insufficient Sleep Syndrome</Concept_name>
        <obo:IAO_0000115>A voluntary sleep disorder, meaning that it results from the choices that individuals make about sleeping rather than any underlying medical, emotional, or environmental cause.</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/InsufficientSleepSyndrome"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A voluntary sleep disorder, meaning that it results from the choices that individuals make about sleeping rather than any underlying medical, emotional, or environmental cause.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.baptisthealth.com/care-services/conditions-treatments/insufficient-sleep-syndrome</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/IrregularSleepWakeRhythmDisorder">
        <Concept_name>Irregular sleep wake rhythmic disorder</Concept_name>
        <obo:IAO_0000115>Characterized by the relative absence of a circadian pattern in an individual’s sleep-wake cycle.</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/IrregularSleepWakeRhythmDisorder"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Characterized by the relative absence of a circadian pattern in an individual’s sleep-wake cycle.</owl:annotatedTarget>
        <obo:IAO_0000119>https://pmc.ncbi.nlm.nih.gov/articles/PMC2768129/</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/JetLagDisorder">
        <Concept_name>Jet lag disorder</Concept_name>
        <obo:IAO_0000115>A temporary sleep problem that can affect anyone who quickly travels across several time zones.</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/JetLagDisorder"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A temporary sleep problem that can affect anyone who quickly travels across several time zones.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.mayoclinic.org/diseases-conditions/jet-lag/symptoms-causes/syc-20374027</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/KleineLevinSyndrome">
        <Concept_name>Kleine Levin Syndrome</Concept_name>
        <obo:IAO_0000115>An extremely rare condition that causes intermittent episodes where you sleep for long periods of time.</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/KleineLevinSyndrome"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An extremely rare condition that causes intermittent episodes where you sleep for long periods of time.</owl:annotatedTarget>
        <obo:IAO_0000119>https://my.clevelandclinic.org/health/diseases/23484-kleine-levin-syndrome</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/Lapses_into_sleep">
        <Concept_name>Lapses into sleep</Concept_name>
        <rdfs:comment>Sudden, brief episodes of sleep during wakefulness</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/Leg_sensory_discomfort">
        <Concept_name>Leg sensory discomfort</Concept_name>
        <rdfs:comment>Unpleasant sensations in the legs, often described as crawling, tingling, or aching</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/Legs_movement">
        <Concept_name>Legs movement</Concept_name>
        <rdfs:comment>Involuntary or repetitive leg movements during sleep</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/Long_sleep_time">
        <Concept_name>Long sleep time</Concept_name>
        <rdfs:comment>Prolonged total sleep duration beyond normal limits</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/NarcolepsyType1">
        <Concept_name>Narcolepsy type1</Concept_name>
        <obo:IAO_0000115>A chronic neurologic disorder, associated with uncontrollable sleep urges and cataplexy</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/NarcolepsyType1"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A chronic neurologic disorder, associated with uncontrollable sleep urges and cataplexy</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.orpha.net/en/disease/detail/2073</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/NarcolepsyType2">
        <Concept_name>Narcolepsy type2</Concept_name>
        <obo:IAO_0000115>A chronic neurologic disorder, associated with uncontrollable sleep urges but NO cataplexy</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/NarcolepsyType2"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A chronic neurologic disorder, associated with uncontrollable sleep urges but NO cataplexy</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.orpha.net/fr/disease/detail/83465</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/NightmareDisorder">
        <Concept_name>Nightmare disorder</Concept_name>
        <obo:IAO_0000115>Defined by the repeated occurrence of nightmares that cause clinically significant distress or impairment in social, occupational or other important areas of functioning, which are not attributable to the physiological effects of a substance (e.g. drug abuse or medication) and which cannot be adequately explained by coexisting mental and medical disorders</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/NightmareDisorder"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Defined by the repeated occurrence of nightmares that cause clinically significant distress or impairment in social, occupational or other important areas of functioning, which are not attributable to the physiological effects of a substance (e.g. drug abuse or medication) and which cannot be adequately explained by coexisting mental and medical disorders</owl:annotatedTarget>
        <obo:IAO_0000119>https://pmc.ncbi.nlm.nih.gov/articles/PMC6850667/</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/Non24HourSleepWakeRhythmDisorder">
        <Concept_name>Non 24-hour sleep wake rhythm disorder</Concept_name>
        <obo:IAO_0000115>A circadian rhythm sleep disorder in which an individual’s biological clock fails to synchronize to a 24-hour day.</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/Non24HourSleepWakeRhythmDisorder"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A circadian rhythm sleep disorder in which an individual’s biological clock fails to synchronize to a 24-hour day.</owl:annotatedTarget>
        <obo:IAO_0000119>https://rarediseases.org/rare-diseases/non-24-hour-sleep-wake-disorder/</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/Non_restorative_sleep">
        <Concept_name>Non-restorative sleep</Concept_name>
        <rdfs:comment>Sleep of normal duration that fails to leave the patient feeling refreshed</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/Normal_responsiveness">
        <Concept_name>Normal responsiveness</Concept_name>
        <rdfs:comment>Appropriate reaction to environmental stimuli, indicating intact neurological and cognitive function</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/ObstructiveSleepApneaAdult">
        <Concept_name>Obstructive sleep apnea adult</Concept_name>
        <obo:IAO_0000115>A sleep disorder characterized by repeated episodes of complete (apnea) or partial (hypopnea) collapse of the upper airway, causing oxygen desaturation or sleep arousal</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/ObstructiveSleepApneaAdult"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A sleep disorder characterized by repeated episodes of complete (apnea) or partial (hypopnea) collapse of the upper airway, causing oxygen desaturation or sleep arousal</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/books/NBK459252/</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/ObstructiveSleepApneaPediatric">
        <Concept_name>Obstructive sleep apnea pediatric</Concept_name>
        <obo:IAO_0000115>A childhood disorder in which there is upper airway dysfunction causing complete or partial airway obstruction during sleep leading to decreased oxygen saturation or arousals from sleep.</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/ObstructiveSleepApneaPediatric"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A childhood disorder in which there is upper airway dysfunction causing complete or partial airway obstruction during sleep leading to decreased oxygen saturation or arousals from sleep.</owl:annotatedTarget>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32491542/</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/PrimaryCentralSleepApnea">
        <Concept_name>Primary central sleep apnea</Concept_name>
        <obo:IAO_0000115>A sleep-related disorder in which respiratory effort is absent intermittently during sleep.</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/PrimaryCentralSleepApnea"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A sleep-related disorder in which respiratory effort is absent intermittently during sleep.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.mdpi.com/2077-0383/14/7/2369</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/PrimaryCentralSleepApneaOfInfancy">
        <Concept_name>Primary central sleep apnea of infancy</Concept_name>
        <obo:IAO_0000115>An unexplained episode of cessation of breathing lasting 20 seconds or longer, or a shorter respiratory pause associated with bradycardia, cyanosis, pallor, and/or marked hypotonia</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/PrimaryCentralSleepApneaOfInfancy"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An unexplained episode of cessation of breathing lasting 20 seconds or longer, or a shorter respiratory pause associated with bradycardia, cyanosis, pallor, and/or marked hypotonia</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/books/NBK441969/</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/PrimaryCentralSleepApneaOfPrematurity">
        <Concept_name>Primary central sleep apnea of prematurity</Concept_name>
        <obo:IAO_0000115>A sudden cessation of breathing that lasts for at least 20 seconds or is accompanied by bradycardia or oxygen desaturation (cyanosis) in an infant younger than 37 weeks gestational age.</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/PrimaryCentralSleepApneaOfPrematurity"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A sudden cessation of breathing that lasts for at least 20 seconds or is accompanied by bradycardia or oxygen desaturation (cyanosis) in an infant younger than 37 weeks gestational age.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/books/NBK441969/</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/PropriospinalMyoclonusAtSleepOnset">
        <Concept_name>Propriospinal myoclonus at sleep onset</Concept_name>
        <obo:IAO_0000115>A rare disorder with repetitive, usually flexor arrhythmic brief jerks of the trunk, hips, and knees in a fixed pattern</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/PropriospinalMyoclonusAtSleepOnset"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A rare disorder with repetitive, usually flexor arrhythmic brief jerks of the trunk, hips, and knees in a fixed pattern</owl:annotatedTarget>
        <obo:IAO_0000119>https://pmc.ncbi.nlm.nih.gov/articles/PMC4240434/</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/REMSleepBehaviorDisorder">
        <Concept_name>REM-sleep behaviour disorder</Concept_name>
        <obo:IAO_0000115>Is parasomnia strongly linked to neurodegenerative diseases, and it can also be very disturbing and lead to injury requiring medical attention.</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/REMSleepBehaviorDisorder"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Is parasomnia strongly linked to neurodegenerative diseases, and it can also be very disturbing and lead to injury requiring medical attention.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/books/NBK555928/</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/RecurrentIsolatedSleepParalysis">
        <Concept_name>Recurrent isolated sleep paralysis</Concept_name>
        <obo:IAO_0000115>Is characterised by repeated episodes of sleep paralysis (a temporary inability to move or speak that occurs directly after falling asleep or waking up) , occurring independently of other sleep disorders.</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/RecurrentIsolatedSleepParalysis"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Is characterised by repeated episodes of sleep paralysis (a temporary inability to move or speak that occurs directly after falling asleep or waking up) , occurring independently of other sleep disorders.</owl:annotatedTarget>
        <obo:IAO_0000119>https://cpdonline.co.uk/knowledge-base/mental-health/recurrent-isolated-sleep-paralysis/</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/RestlessLegsSyndrome">
        <Concept_name>Restless legs syndrome</Concept_name>
        <obo:IAO_0000115>A condition that causes a very strong urge to move the legs. The urge to move usually is caused by an uncomfortable feeling in the legs.</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/RestlessLegsSyndrome"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A condition that causes a very strong urge to move the legs. The urge to move usually is caused by an uncomfortable feeling in the legs.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.mayoclinic.org/diseases-conditions/restless-legs-syndrome/symptoms-causes/syc-20377168</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/ShiftWorkDisorder">
        <Concept_name>Shift work disorder</Concept_name>
        <obo:IAO_0000115>A condition that primarily affects people who work night, early morning, and rotating shifts for their jobs</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/ShiftWorkDisorder"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A condition that primarily affects people who work night, early morning, and rotating shifts for their jobs</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.sleepfoundation.org/shift-work-disorder</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/Short_sleep_time">
        <Concept_name>Short sleep time</Concept_name>
        <rdfs:comment>Total sleep duration consistently below physiological needs</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/SleepRelatedBruxism">
        <Concept_name>Sleep related bruxism</Concept_name>
        <obo:IAO_0000115>Defined as the repetitive jaw muscle activity characterized by the clenching or grinding of teeth during sleep.</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/SleepRelatedBruxism"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Defined as the repetitive jaw muscle activity characterized by the clenching or grinding of teeth during sleep.</owl:annotatedTarget>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/23121262/</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/SleepRelatedEatingDisorder">
        <Concept_name>Sleep related eating disorder</Concept_name>
        <obo:IAO_0000115>A non-rapid-eye movement parasomnia typified by recurrent episodes of eating/drinking following arousals, with associated partial/complete amnesia.</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/SleepRelatedEatingDisorder"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A non-rapid-eye movement parasomnia typified by recurrent episodes of eating/drinking following arousals, with associated partial/complete amnesia.</owl:annotatedTarget>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/38368069/</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/SleepRelatedHallucinations">
        <Concept_name>Sleep related hallucinations</Concept_name>
        <obo:IAO_0000115>Seeing, hearing, feeling, or smelling something that isn&apos;t actually there while you&apos;re falling asleep or waking up</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/SleepRelatedHallucinations"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Seeing, hearing, feeling, or smelling something that isn&apos;t actually there while you&apos;re falling asleep or waking up</owl:annotatedTarget>
        <obo:IAO_0000119>https://my.clevelandclinic.org/health/symptoms/23350-hallucinations</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/SleepRelatedLegCramps">
        <Concept_name>Sleep related leg cramps</Concept_name>
        <obo:IAO_0000115>A sleep-related movement disorder whereby painful contractions of the calf or foot muscles arise during time in bed</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/SleepRelatedLegCramps"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A sleep-related movement disorder whereby painful contractions of the calf or foot muscles arise during time in bed</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.medlink.com/articles/sleep-related-leg-cramps</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/SleepRelatedRhythmicMovementDisorder">
        <Concept_name>Sleep related rhythmic movement disorder</Concept_name>
        <obo:IAO_0000115>A neurological disorder characterized by repetitive movements of large muscle groups immediately before and during sleep. Occurs in both infants and children and rarely occurs or persists in adolescence or adulthood.</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/SleepRelatedRhythmicMovementDisorder"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A neurological disorder characterized by repetitive movements of large muscle groups immediately before and during sleep. Occurs in both infants and children and rarely occurs or persists in adolescence or adulthood.</owl:annotatedTarget>
        <obo:IAO_0000119>https://pmc.ncbi.nlm.nih.gov/articles/PMC11294141/</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/SleepTerrors">
        <Concept_name>Sleep terrors</Concept_name>
        <obo:IAO_0000115>A common childhood parasomnia characterized by episodes of extreme terror and panic that occur suddenly out of NREM, slow-wave sleep.</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/SleepTerrors"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A common childhood parasomnia characterized by episodes of extreme terror and panic that occur suddenly out of NREM, slow-wave sleep.</owl:annotatedTarget>
        <obo:IAO_0000119>https://pmc.ncbi.nlm.nih.gov/articles/PMC8193803/</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/Sleep_inertia">
        <Concept_name>Sleep inertia</Concept_name>
        <rdfs:comment>Impaired alertness and cognitive performance immediatley after awakening</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/Sleep_resistance">
        <Concept_name>Sleep resistance</Concept_name>
        <rdfs:comment>Active opposition to going to bed or falling asleep, usually seen in childrenbut also in behavioral insomnia</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/Sleepwalking">
        <Concept_name>Sleep walking</Concept_name>
        <obo:IAO_0000115>Also known as Somnambulism,  includes undesirable actions, such as walking, that occur during abrupt but limited arousals from non-rapid eye movement (NREM) slow-wave sleep.</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontology/Sleepwalking"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Also known as Somnambulism,  includes undesirable actions, such as walking, that occur during abrupt but limited arousals from non-rapid eye movement (NREM) slow-wave sleep.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/books/NBK559001/</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://example.org/ontology/Snoring">
        <Concept_name>Snoring</Concept_name>
        <rdfs:comment>Noisy breathing during sleep caused by turbulent airflow through upper airways</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/ontology/Vocalisation">
        <Concept_name>Vocalisation</Concept_name>
        <rdfs:comment>Sounds made during sleep, including talking, screaming, or moaning</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.co-ode.org/ontologies/ont.owl#SleepEnuresis">
        <Concept_name>Sleep enuresis</Concept_name>
        <obo:IAO_0000115>A prevalent pediatric condition, characterized by involuntary urination during sleep at least twice a week for 3 months in children older than 5.</obo:IAO_0000115>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.co-ode.org/ontologies/ont.owl#SleepEnuresis"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prevalent pediatric condition, characterized by involuntary urination during sleep at least twice a week for 3 months in children older than 5.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/books/NBK545181/</obo:IAO_0000119>
    </owl:Axiom>
    <rdf:Description rdf:about="http://www.co-ode.org/ontologies/ont.owl#Unvolontary_voiding">
        <Concept_name>Unvoluntary voiding</Concept_name>
        <rdfs:comment>Involuntary urination during sleep</rdfs:comment>
        <skos:closeMatch>http://purl.obolibrary.org/obo/SYMP_0000606</skos:closeMatch>
    </rdf:Description>
</rdf:RDF>



