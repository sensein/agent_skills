<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/ontology#"
     xml:base="http://example.org/ontology"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://example.org/ontology">
        <rdfs:comment>This ontology aims to facilitate- the diagnostic procedure of sleep disorders</rdfs:comment>
        <rdfs:creator>Ghada Jaouani</rdfs:creator>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/ontology#Concept_name -->

    <owl:AnnotationProperty rdf:about="http://example.org/ontology#Concept_name"/>
    


    <!-- http://example.org/ontology#SNOMEDCT_ID -->

    <owl:AnnotationProperty rdf:about="http://example.org/ontology#SNOMEDCT_ID"/>
    


    <!-- http://example.org/ontology#Sleep_ID -->

    <owl:AnnotationProperty rdf:about="http://example.org/ontology#Sleep_ID"/>
    


    <!-- http://example.org/ontology#UMLS_CUI -->

    <owl:AnnotationProperty rdf:about="http://example.org/ontology#UMLS_CUI"/>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000115 -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/IAO_0000115">
        <rdfs:label>definition</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000119 -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/IAO_0000119">
        <rdfs:label>definition source</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://purl.org/dc/elements/1.1/source -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/source"/>
    


    <!-- http://purl.org/dc/terms/bibliographicCitation -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/bibliographicCitation"/>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#creator -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#creator"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#closeMatch -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#closeMatch"/>
    


    <!-- http://www.w3.org/ns/prov#wasDerivedFrom -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#wasDerivedFrom"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/ontology#involvesSymptom -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology#involvesSymptom">
        <rdfs:domain rdf:resource="http://example.org/ontology#SymptomRelation"/>
        <rdfs:range rdf:resource="http://example.org/ontology/Symptom"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/ontology#involvesTrouble -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology#involvesTrouble">
        <rdfs:domain rdf:resource="http://example.org/ontology#SymptomRelation"/>
        <rdfs:range rdf:resource="http://example.org/ontology/Disorder"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/ontology#possibleCauseOf -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology#possibleCauseOf">
        <rdfs:domain rdf:resource="http://example.org/ontology/ExternalFactor"/>
        <rdfs:range rdf:resource="http://example.org/ontology/Symptom"/>
    </owl:ObjectProperty>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#hasSymptom -->

    <owl:ObjectProperty rdf:about="http://www.co-ode.org/ontologies/ont.owl#hasSymptom">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/ontology/Disorder"/>
        <rdfs:range rdf:resource="http://example.org/ontology/Symptom"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/ontology#weight -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontology#weight">
        <rdfs:domain rdf:resource="http://example.org/ontology#SymptomRelation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/ontology#Sleep -->

    <owl:Class rdf:about="http://example.org/ontology#Sleep"/>
    


    <!-- http://example.org/ontology#SymptomRelation -->

    <owl:Class rdf:about="http://example.org/ontology#SymptomRelation">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:Class>
    


    <!-- http://example.org/ontology/AbnormalSleepPattern -->

    <owl:Class rdf:about="http://example.org/ontology/AbnormalSleepPattern">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/SleepPattern"/>
        <Concept_name>Abnormal sleep pattern</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10001.0</Sleep_ID>
        <UMLS_CUI>C1849174</UMLS_CUI>
    </owl:Class>
    


    <!-- http://example.org/ontology/Abnormal_responsiveness -->

    <owl:Class rdf:about="http://example.org/ontology/Abnormal_responsiveness">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/BehaviouralSymptom"/>
    </owl:Class>
    


    <!-- http://example.org/ontology/Absent_of_major_sleep_period -->

    <owl:Class rdf:about="http://example.org/ontology/Absent_of_major_sleep_period">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/SleepPeriodSymptom"/>
    </owl:Class>
    


    <!-- http://example.org/ontology/Advance_in_the_sleep_period -->

    <owl:Class rdf:about="http://example.org/ontology/Advance_in_the_sleep_period">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/SleepPeriodSymptom"/>
    </owl:Class>
    


    <!-- http://example.org/ontology/AdvancedSleepWakePhaseDisorder -->

    <owl:Class rdf:about="http://example.org/ontology/AdvancedSleepWakePhaseDisorder">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/SleepWakeDisorder"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.co-ode.org/ontologies/ont.owl#hasSymptom"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/Advance_in_the_sleep_period"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.co-ode.org/ontologies/ont.owl#hasSymptom"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/Daytime_sleepiness"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.co-ode.org/ontologies/ont.owl#hasSymptom"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/Insomnia_early"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://example.org/ontology/Affective_symptoms -->

    <owl:Class rdf:about="http://example.org/ontology/Affective_symptoms">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/PsychiatricSymptom"/>
    </owl:Class>
    


    <!-- http://example.org/ontology/AlcoholConsumption -->

    <owl:Class rdf:about="http://example.org/ontology/AlcoholConsumption">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/LifestylePattern"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology#possibleCauseOf"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/Altered_oniric_activity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology#possibleCauseOf"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/Autonomic_symptoms"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology#possibleCauseOf"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/Breath_abnormalities_observation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology#possibleCauseOf"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/Daytime_sleepiness"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology#possibleCauseOf"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/Insomnia_maintaining"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology#possibleCauseOf"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/Non_restorative_sleep"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology#possibleCauseOf"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/Snoring"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <Concept_name>Alcohol consumption</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10118.0</Sleep_ID>
        <UMLS_CUI>C0001948</UMLS_CUI>
        <prov:wasDerivedFrom>http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#AlcoholConsumption</prov:wasDerivedFrom>
    </owl:Class>
    


    <!-- http://example.org/ontology/Altered_oniric_activity -->

    <owl:Class rdf:about="http://example.org/ontology/Altered_oniric_activity">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/BehaviouralSymptom"/>
    </owl:Class>
    


    <!-- http://example.org/ontology/Altered_perception_icsd -->

    <owl:Class rdf:about="http://example.org/ontology/Altered_perception_icsd">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/PsychiatricSymptom"/>
        <Concept_name>Altered perception</Concept_name>
        <rdfs:comment>Abnormal experiences of sensations or reality, often at sleep-wake transitions</rdfs:comment>
    </owl:Class>
    


    <!-- http://example.org/ontology/Ambulation -->

    <owl:Class rdf:about="http://example.org/ontology/Ambulation">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/BehaviouralSymptom"/>
    </owl:Class>
    


    <!-- http://example.org/ontology/Amnesia -->

    <owl:Class rdf:about="http://example.org/ontology/Amnesia">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/BehaviouralSymptom"/>
    </owl:Class>
    


    <!-- http://example.org/ontology/Anxiety -->

    <owl:Class rdf:about="http://example.org/ontology/Anxiety">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/PsychologicalFactor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology#possibleCauseOf"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/Affective_symptoms"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology#possibleCauseOf"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/Altered_oniric_activity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology#possibleCauseOf"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/Autonomic_symptoms"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology#possibleCauseOf"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/Behavioral_symptoms_during_wake_icsd"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology#possibleCauseOf"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/Cognitive_symptoms_icsd"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology#possibleCauseOf"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/Insomnia_initiating"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology#possibleCauseOf"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/Insomnia_maintaining"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology#possibleCauseOf"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/Non_restorative_sleep"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <Concept_name>Anxiety</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10005.0</Sleep_ID>
        <UMLS_CUI>C0003467</UMLS_CUI>
        <obo:IAO_0000115>Emotional tension or energy characterized by unexplained feelings of apprehension, uneasiness or dread associated to an anticipated, actual or imagined stressor.</obo:IAO_0000115>
        <prov:wasDerivedFrom>http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#Anxiety</prov:wasDerivedFrom>
    </owl:Class>
    


    <!-- http://example.org/ontology/AttributeOfSleep -->

    <owl:Class rdf:about="http://example.org/ontology/AttributeOfSleep">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology#Sleep"/>
        <dc:source>http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14</dc:source>
        <prov:wasDerivedFrom>http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#AttributeOfSleep</prov:wasDerivedFrom>
    </owl:Class>
    


    <!-- http://example.org/ontology/Autonomic_symptoms -->

    <owl:Class rdf:about="http://example.org/ontology/Autonomic_symptoms">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/GeneralSymptom"/>
    </owl:Class>
    


    <!-- http://example.org/ontology/BedtimeRitual -->

    <owl:Class rdf:about="http://example.org/ontology/BedtimeRitual">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/ExternalFactor"/>
        <Concept_name>Bedtime (qualifier value); Ritual</Concept_name>
        <Sleep_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10008.0</Sleep_ID>
        <UMLS_CUI>C0521112; C2945764</UMLS_CUI>
        <prov:wasDerivedFrom>http://www.semanticweb.org/hyewon/ontologies/2024/3/untitled-ontology-14#BedtimeRitual</prov:wasDerivedFrom>
    </owl:Class>
    


    <!-- http://example.org/ontology/Behavioral_symptoms_during_sleep -->

    <owl:Class rdf:about="http://example.org/ontology/Behavioral_symptoms_during_sleep">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/BehaviouralSymptom"/>
    </owl:Class>
    


    <!-- http://example.org/ontology/Behavioral_symptoms_during_wake_icsd -->

    <owl:Class rdf:about="http://example.org/ontology/Behavioral_symptoms_during_wake_icsd">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/PsychiatricSymptom"/>
        <Concept_name>Behavioural symptoms during wake</Concept_name>
        <rdfs:comment>Abnormal behaviours while awake, often linked to sleep deprivation</rdfs:comment>
    </owl:Class>
    


    <!-- http://example.org/ontology/BehaviouralSymptom -->

    <owl:Class rdf:about="http://example.org/ontology/BehaviouralSymptom">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/Symptom"/>
        <Concept_name>Behavioural symptoms</Concept_name>
    </owl:Class>
    


    <!-- http://example.org/ontology/BenignSleepMyoclonusOfInfancy -->

    <owl:Class rdf:about="http://example.org/ontology/BenignSleepMyoclonusOfInfancy">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/SleepMotorDisorder"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.co-ode.org/ontologies/ont.owl#hasSymptom"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/Myoclonic_jerks_icsd"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://example.org/ontology/Breath_abnormalities_complaint -->

    <owl:Class rdf:about="http://example.org/ontology/Breath_abnormalities_complaint">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/RespiratorySymptom"/>
    </owl:Class>
    


    <!-- http://example.org/ontology/Breath_abnormalities_observation -->

    <owl:Class rdf:about="http://example.org/ontology/Breath_abnormalities_observation">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/RespiratorySymptom"/>
    </owl:Class>
    


    <!-- http://example.org/ontology/BreathingDifficulty -->

    <owl:Class rdf:about="http://example.org/ontology/BreathingDifficulty">
