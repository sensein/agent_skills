    <!-- http://example.org/ontology/Disorder -->

    <owl:Class rdf:about="http://example.org/ontology/Disorder">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology#Sleep"/>
        <rdfs:subClassOf>
            <owl:Restriction>
