        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Weik, M. (2000).  Computer science and communications dictionary (1st ed., Vols. 1-2). Boston: Kluwer Academic Publishers.</NEMO_annot:definition_source>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">attenuation</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">attenuation is a process... [incomplete]</NEMO_annot:onto_definition>
