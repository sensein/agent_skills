    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_1189000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_1189000">
        <rdfs:label rdf:datatype="&xsd;string">global_explained_variance</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_4358000"/>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-05-08</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-08</NEMO_annot:created_date>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">GEV</NEMO_annot:acronym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">global_explained_variance</NEMO_annot:pref_label>
        <NEMO_annot:definition rdf:datatype="&xsd;string">global_explained_variance (GEV) is the portion of  variance in a data set that can be attributed to a specific condition (cause). GEV measures the extent to which a mathematical model accounts for the variation (i.e. apparent randomness) in a  data set. The higher the explained variance relative to the total variance, the stronger the statistical model.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">global_explained_variance is a descriptive_statistic that is_about SOME data_set</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Explained_variation</NEMO_annot:definition_source>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://wikidoc.org/index.php/Explained_variance</NEMO_annot:definition_source>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


