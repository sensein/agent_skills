    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_8653000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_8653000">
        <rdfs:label rdf:datatype="&xsd;string">skull_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000195"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;location_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_6903000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0550000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-03-24</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-04-22</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A skull_region is a three-dimensional spatial region, whose coordinates are defined with respect to anatomical landmarks on and within the skull.  The spatial subdivisions of the skull are named after the four major lobes of the cerebral cortex — i.e., frontal, temporal, parietal, and occipital.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A skull_region is an anatomical_region that is the exact location_of some skull.</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">We need to specify class restriction:  &quot;...that is the location_of [some part of] the skull.&quot; This in turn suggests that we may need an appropriate class, such as skull_part.</NEMO_annot:comment>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Human_skull</NEMO_annot:definition_source>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">skull_region</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_8660000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_8660000">
        <rdfs:label xml:lang="en">cognitive_control</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_2650000"/>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-07-23</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-07-23</NEMO_annot:created_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Cognitive_control is a disposition that inheres in some brain or brain part and gives rise to self-regulation, strategic and controlled processes.</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


