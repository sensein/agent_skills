    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_6402000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_6402000">
        <rdfs:label rdf:datatype="&xsd;string">reading_assessment</rdfs:label>
