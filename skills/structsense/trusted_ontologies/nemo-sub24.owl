        <rdfs:label rdf:datatype="&xsd;string">is_quality_measurement_of</rdfs:label>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-05-27</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-28</NEMO_annot:created_date>
