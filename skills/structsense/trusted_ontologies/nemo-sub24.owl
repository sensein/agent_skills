    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_7393000">
        <rdfs:label rdf:datatype="&xsd;string">postal_address</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_3261000"/>
        <NEMO_annot:synonym rdf:datatype="&xsd;string"> http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#Postal_Address</NEMO_annot:synonym>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-31</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A postal address is a collection of information presented in (country dependent) standardized fixed format used to describe a physical location that a person or an organization use for the purpose of receiving postal mail delivery. Political boundaries and street names are generally used as references, along with other identifiers such as house or apartment numbers.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">UMLS C1550707</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Address_(geography)</NEMO_annot:definition_source>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">postal_address</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">postal_address is an address that is_about some spatial_region</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
