    <!-- http://purl.obolibrary.org/obo/IAO_0000032 -->

    <owl:Class rdf:about="&obo;IAO_0000032">
        <rdfs:label rdf:datatype="&xsd;string">scalar_measurement_datum</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;IAO_0000109"/>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-04-24</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-15</NEMO_annot:created_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A scalar measurement datum is a measurement datum that is composed of two parts, numerals and a unit label.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Imported into NEMO_data</NEMO_annot:comment>
        <NEMO_annot:source_ontology rdf:datatype="&xsd;string">Information Artifact Ontology (IAO)</NEMO_annot:source_ontology>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_imported_classes</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://purl.obolibrary.org/obo/IAO_0000032</NEMO_annot:definition_source>
