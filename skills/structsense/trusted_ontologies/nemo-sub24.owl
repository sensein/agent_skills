    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4119000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4119000">
        <rdfs:label rdf:datatype="&xsd;string">elliptical_head_model</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_1656000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-11-26</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-26</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">An elliptical head model  is a computational model that describes the propagation of electrical fields through a medium with a particular set of material properties. This model represents the human head as an elliptical object composed of two (or more) nested concentric ellipses (aka &quot;surfaces&quot;), e.g., representing human brain, skull and scalp. Each ellipse is assigned its own thickness and conductivity value; however, these values are assumed to be homogenous and isotropic within each surface.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">An elliptical_head_model is_a head_model...</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Cuffin, B., N. (1990) Effect of head shape on EEG&apos;s and MEG&apos;s. IEEE Transactions on Biomedical Engineering, Vol. 37. No. 1, January 1990.</NEMO_annot:definition_source>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Mosher, C. J., Leahy, R. M., Lewis, P. S.(1999) EEG and MEG: Forward solutions for inverse methods. IEEE Transactions on Biomedical Engineering, Vol. 46. No. 3, March 1999.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">elliptical_head_model</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4123000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4123000">
        <rdfs:label rdf:datatype="&xsd;string">magnitude_statistic</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_6525000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-08</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:comment rdf:datatype="&xsd;string">A statistic that refers to the ratio of two quantities.</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">PATO_0002016</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Magnitude_(mathematics)</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.org/obo/owl/PATO#PATO_0002016</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://www.dictionary.net//magnitude</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">magnitude</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">magnitude_statistic</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">magnitude_statistic is a descriptive_statistic that is_about SOME size</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">magnitude_statistic is a statistic that represents the size (amplitude or extent) of an object, as compared with other objects of the same kind.</NEMO_annot:definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


