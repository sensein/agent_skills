    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_8789000">
        <rdfs:label>fN400_frontocentral_negativity</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_0000093"/>
                    <owl:Class>
