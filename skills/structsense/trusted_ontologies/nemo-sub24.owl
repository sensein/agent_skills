    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_3946000">
        <rdfs:label rdf:datatype="&xsd;string">russian</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_5315000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-08</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Lewis, M. Paul (ed.), 2009. Ethnologue: Languages of the World, Sixteenth edition. Dallas, TX.: SIL International. Online version: http://ethnologue.com/.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_functional</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Russian is a SVO (Subject-Verb-Object) language belonging to East sub-branch of Slavic branch of Indo-European language family.</NEMO_annot:comment>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Russian is an SVO (Subject-Verb-Object) language belonging to the East sub-branch of Slavic branch of the Indo-European language family. It is spoken by over 145 million people primarily living in Russian Federation, and also in Armenia, Azerbaijan, Belarus, Bulgaria, Canada, China, Croatia, Czech Republic, Estonia, Finland, Georgia, Germany, Greece, Israel, Kazakhstan, Kyrgyzstan, Latvia, Lithuania, Moldova, Mongolia, Mozambique, Norway, Poland, Romania, Serbia, Slovakia, Tajikistan, Turkmenistan, Ukraine, United States, Uruguay and Uzbekistan.</NEMO_annot:definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Russian language</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">SNOMED CT ID 297876005</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Writing script: Cyrillic.</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/SNOMEDCT/297514005</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">russian</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">russian is_a human_language that...[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


