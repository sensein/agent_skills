        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A latency_onset_measurement_datum is a temporal_measurement_datum that inheres_in an ERP dataset  [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A latency_onset_measurement_datum specifies the time (in milliseconds) of onset of an event.</NEMO_annot:definition>
