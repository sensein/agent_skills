        <rdfs:subClassOf rdf:resource="&obo;OBI_0000011"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2011-08-07</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-08-07</NEMO_annot:modified_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_functional</NEMO_annot:namespace>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">experimental_condition_execution is a planned_process that...[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">the execution of an experimental condition (protocol for presentation of a stimulus, delivery of experiment instruction, and collection of behavioral and brain responses), which is a proper part of some experimental paradigm.</NEMO_annot:definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
