    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_9463000">
        <rdfs:label rdf:datatype="&xsd;string">brain_anatomical_point</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_1111115"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-26</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-04-28</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A brain_anatomical_point is an anatomical point in space, where the space is subdivided according to brain anatomical landmarks, boundaries, and axes, resulting in a brain anatomical coordinate system (e.g., MNI space, Talaraich space).</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A brain_anatomical_point is an anatomical_point that is a proper_part_of some brain_region.</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">brain_anatomical_point</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_9466000 -->

