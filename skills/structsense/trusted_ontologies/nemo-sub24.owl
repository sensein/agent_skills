        <NEMO_annot:definition rdf:datatype="&xsd;string">An anatomical_region is a 3-dimensional region occupied (and by implication, shaped) by an anatomical object.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">An anatomical_region is a three_dimensional_region that is the exact location_of some anatomical_object.</NEMO_annot:onto_definition>
