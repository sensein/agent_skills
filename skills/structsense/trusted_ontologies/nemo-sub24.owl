        <NEMO_annot:created_date rdf:datatype="&xsd;string">2011-07-02</NEMO_annot:created_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">An experiment condition in which the target stimulus is a string of letters (or other orthographic symbols) that has a high degree of orthographic overlap with the prime stimulus.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_functional</NEMO_annot:namespace>
