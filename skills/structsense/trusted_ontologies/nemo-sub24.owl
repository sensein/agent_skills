    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_7730000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_7730000">
        <rdfs:label rdf:datatype="&xsd;string">electrical_capacitance</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_1750000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&OBO_REL;inheres_in"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000172"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">CSP 2322-8160</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Computer Retrieval of Information on Scientific Projects (CRISP) ID 2322-8160</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">E = (1/2) CV2</NEMO_annot:comment>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Electrical_apacitance is the ability of a material to store an electrical charge.  It is typically measured in farads (F).  The property of a capacitor that determines the amount of electrical energy it can store by applying a given voltage is given by the relation of energy (E) set equal to one-half of the capacitance multiplied by voltage squared.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">Electrical_capacitance is a disposition that inheres_in some biomaterial_object and [... incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">MSH D025802</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Medical Subject Headings ID D025802</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NCI C0242264</NEMO_annot:synonym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
