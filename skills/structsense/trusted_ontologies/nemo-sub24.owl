    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_7365000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_7365000">
        <rdfs:label rdf:datatype="&xsd;string">space_constant</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;OBI_0000654"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A space constant is a distance at which a local change in a membrane potential has decayed by 63% of its initial value.  Typical values are in the range of 0.1 to 1.0 mm.</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Kandel, E.R., Schwartz, J.H., &amp; Jessell, T.M. (Eds.). (1995). Essentials of neural science and behavior ( 1st Ed.), (pp. 708). Stamford, CT: Appleton &amp; Lange.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Submitted to NIF in November 2010.</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">lambda</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">length_constant</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">membrane_length_constant</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">space_constant</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">space_constant is a device_setting that ... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Anita_Bandrowski"/>
