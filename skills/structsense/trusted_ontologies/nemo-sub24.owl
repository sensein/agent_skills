        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">inferior is a spatial_anatomical_quality that is disjoint with superior and middle.</NEMO_annot:onto_definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">inferior is disjoint with superior and middle.</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">ventral</NEMO_annot:synonym>
