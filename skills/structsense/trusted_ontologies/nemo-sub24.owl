        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-06-30</NEMO_annot:modified_date>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator</NEMO_annot:definition_source>
        <NEMO_annot:definition rdf:datatype="&xsd;string">The motor division(s) of the PNS are responsible for control of the visceral (internal, aka &quot;autonomic&quot;) and somatic (external bodily) muscles. </NEMO_annot:definition>
