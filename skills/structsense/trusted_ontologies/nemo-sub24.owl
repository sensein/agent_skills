            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_5003000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-06-18</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-06-18</NEMO_annot:created_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A left_inferior_occipitotemporal_scalp_surface_region is a region of the scalp surface that is inferior to some left_occipital_scalp_surface_region.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A left_inferior_occipitotemporal_scalp_surface_region is a scalp_surface_region that is the exact location_of some  left_occipitotemporal_scalp_surface.</NEMO_annot:onto_definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">only measured in high-density EEG recording systems with coverage inferior to the canthal-meadal line (e.g., systems with 128 or more electrodes)</NEMO_annot:comment>
        <NEMO_annot:comment>See also definition of &quot;occipital&quot; (NEMO_3632000) and &quot;inferior&quot; (NEMO_0000193) and &quot;left temporal&quot; (NEMO_8302000). The &lt;left_inferior_occipitotemporal_scalp_surface region&gt; has_quality &lt;occipital&gt; and has_quality &lt;left temporal&gt; and has_quality &lt;inferior&gt;.</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


