    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_9784001">
        <rdfs:label rdf:datatype="&xsd;string">ERP_percent_laterality_threshold</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_1453000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-01</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-05-05</NEMO_annot:modified_date>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">ERP_percent_laterality_threshold</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">ERP_percent_laterality_threshold is a setting_specification... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition rdf:datatype="&xsd;string">References a user-specified threshold for determining if the distributions of positive and negative electrical potential over the measured scalp-surface are left-localized, right-localized or bilateral. LatIndex_Threshold sets the level at which the mean positive and negative electrical potentials at their respective scalp-surface regions differ substantively from the mean positive and negative electrical potentials at their corresponding homologous, opposite-hemisphere, scalp-surface regions. LatIndex_Threshold is specified as a percent relative difference.</NEMO_annot:definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


