    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_6771000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_6771000">
        <rdfs:label rdf:datatype="&xsd;string">reference_electrode</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_5952000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-08-07</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-07-02</NEMO_annot:modified_date>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Fisch, B. J. (1999). Fisch and Spehlmann&apos;s EEG Primer: Basic Principles of Digital and Analog EEG. Elsevier, pp. 452.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition rdf:datatype="&xsd;string">The reference electrode is an electrode that is taken to be the electrical reference (or theoretical &quot;0&quot;) for all EEG voltage measures. It therefore serves as a theoretical &quot;0&quot; or baseline for measuring changes in voltage at each recording site. Technically, there is no ideal reference for EEG recordings, since the reference electrode is never very far from the recording electrodes, and thus the reference is a poor approximation to &quot;0&quot;. Thus, EEG measurements are (technically) all bipolar and should be reported as Fz-Ref, Cz-Ref, etc. So-called &quot;reference independent&quot; measures re-reference the EEG at each recording site to a weighted average over all the EEG electrodes. When electrodes are located over most of the head surface and at a sufficient density, the mathmatical average (or weighted average) may serve as a reasonable approximation to &quot;0&quot;.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Wikipedia: &quot;Voltage  is a differential quantity. To measure the voltage of a single point, a reference point must be selected to measure against. This common reference point is called &quot;ground&quot; and considered to have zero voltage. This signal ground may or may not actually be connected to a power ground. A system where the system ground is not actually connected to another circuit or to earth (though there may still be AC coupling) is often referred to as a floating ground.&quot;</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">floating ground</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Reference_electrode</NEMO_annot:definition_source>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">ontoDefinition text goes HERE</NEMO_annot:onto_definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">reference</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">reference_electrode</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_6777000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_6777000">
        <rdfs:label rdf:datatype="&xsd;string">nuchal_anatomical_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7737000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;location_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_7890000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_5003000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-06-06</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-05-27</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A nuchal_scalp_surface_region is a region of the scalp surface that is inferior to the occipital_scalp_surface_region.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A nuchal_scalp_surface_region is a regional_part_of_scalp_surface_region that is the exact location_of some  nuchal_scalp_surface.</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">only measured in high-density EEG recording systems with coverage inferior to the canthal-meadal line (e.g., systems with 128 or more electrodes)</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_6783000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_6783000">
        <rdfs:label rdf:datatype="&xsd;string">ERP_event</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_2012000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-08</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-07-08</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">An ERP_event is the role that a process (e.g., onset_stimulus_presentation) plays in an ERP experiment. ERPs are created by averaging across EEG segments, time-locking to an event of interest.</NEMO_annot:definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">ERP_event</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">ERP_event is a role that...[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_6790000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_6790000">
        <rdfs:label rdf:datatype="&xsd;string">auditory_frontocentral_P100</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_0000093"/>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="&ro;has_proper_part"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_6902000"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="&obo;IAO_0000221"/>
                                                <owl:someValuesFrom>
                                                    <owl:Class>
                                                        <owl:intersectionOf rdf:parseType="Collection">
                                                            <rdf:Description rdf:about="&PATO;PATO_0000049"/>
                                                            <owl:Restriction>
                                                                <owl:onProperty rdf:resource="&OBO_REL;inheres_in"/>
                                                                <owl:someValuesFrom>
                                                                    <owl:Class>
                                                                        <owl:intersectionOf rdf:parseType="Collection">
                                                                            <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_8225000"/>
                                                                            <owl:Restriction>
                                                                                <owl:onProperty rdf:resource="&OBO_REL;unfolds_in"/>
                                                                                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000005"/>
                                                                            </owl:Restriction>
                                                                        </owl:intersectionOf>
                                                                    </owl:Class>
                                                                </owl:someValuesFrom>
                                                            </owl:Restriction>
                                                        </owl:intersectionOf>
                                                    </owl:Class>
                                                </owl:someValuesFrom>
                                            </owl:Restriction>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_7943000"/>
                                                <owl:someValuesFrom>
                                                    <rdfs:Datatype>
                                                        <owl:onDatatype rdf:resource="&xsd;decimal"/>
                                                        <owl:withRestrictions rdf:parseType="Collection">
                                                            <rdf:Description>
                                                                <xsd:minInclusive rdf:datatype="&xsd;decimal">.4</xsd:minInclusive>
                                                            </rdf:Description>
                                                        </owl:withRestrictions>
                                                    </rdfs:Datatype>
                                                </owl:someValuesFrom>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_0000495"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="&obo;IAO_0000136"/>
                                                <owl:someValuesFrom>
                                                    <owl:Class>
                                                        <owl:intersectionOf rdf:parseType="Collection">
                                                            <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_8225000"/>
                                                            <owl:Restriction>
                                                                <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_0367000"/>
                                                                <owl:someValuesFrom>
                                                                    <owl:Class>
                                                                        <owl:intersectionOf rdf:parseType="Collection">
                                                                            <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_4762000"/>
                                                                            <owl:Restriction>
                                                                                <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_1568000"/>
                                                                                <owl:someValuesFrom>
                                                                                    <owl:Class>
                                                                                        <owl:intersectionOf rdf:parseType="Collection">
                                                                                            <rdf:Description rdf:about="&snap;Object"/>
                                                                                            <owl:Restriction>
                                                                                                <owl:onProperty rdf:resource="&obo;OBI_0000298"/>
                                                                                                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000452"/>
                                                                                            </owl:Restriction>
                                                                                            <owl:Restriction>
                                                                                                <owl:onProperty rdf:resource="&obo;OBI_0000316"/>
                                                                                                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000468"/>
                                                                                            </owl:Restriction>
                                                                                        </owl:intersectionOf>
                                                                                    </owl:Class>
                                                                                </owl:someValuesFrom>
                                                                            </owl:Restriction>
                                                                        </owl:intersectionOf>
                                                                    </owl:Class>
                                                                </owl:someValuesFrom>
                                                            </owl:Restriction>
                                                        </owl:intersectionOf>
                                                    </owl:Class>
                                                </owl:someValuesFrom>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&ro;has_proper_part"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_0745000"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_7943000"/>
                                        <owl:someValuesFrom>
                                            <rdfs:Datatype>
                                                <owl:intersectionOf rdf:parseType="Collection">
                                                    <rdfs:Datatype>
                                                        <owl:onDatatype rdf:resource="&xsd;decimal"/>
                                                        <owl:withRestrictions rdf:parseType="Collection">
                                                            <rdf:Description>
                                                                <xsd:minInclusive rdf:datatype="&xsd;decimal">60</xsd:minInclusive>
                                                            </rdf:Description>
                                                        </owl:withRestrictions>
                                                    </rdfs:Datatype>
                                                    <rdfs:Datatype>
                                                        <owl:onDatatype rdf:resource="&xsd;decimal"/>
                                                        <owl:withRestrictions rdf:parseType="Collection">
                                                            <rdf:Description>
                                                                <xsd:maxInclusive rdf:datatype="&xsd;decimal">80</xsd:maxInclusive>
                                                            </rdf:Description>
                                                        </owl:withRestrictions>
                                                    </rdfs:Datatype>
                                                </owl:intersectionOf>
                                            </rdfs:Datatype>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-14</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-06-08</NEMO_annot:modified_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Nagamoto, H. T., Adler, L. E.,Waldo, M. C., Griffith, J.,&amp;Freedman, R. (1991). Gating of auditory response in schizophrenics and normal controls. Effects of recording site and stimulation interval on the P50 wave. Schizophrenia Research, 4(1), 31–40.</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">P1</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">P50</NEMO_annot:synonym>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">The auditory_frontocentral_P100 is a scalp-recorded_ERP_extracted_pattern 
      
and has_proper_part SOME peak_latency_measurement_datum
       that has_numeric_value SOME decimal[&gt;=&quot;60&quot;, &lt;=&quot;80&quot;]

and has_proper_part SOME intensity_measurement_datum
       that has_numeric_value SOME decimal[&gt;=&quot;0.4&quot;]
       that is_quality_measurement_of SOME intensity
            that inheres_in SOME scalp_recorded_ERP
                that unfolds_in SOME frontocentral_scalp_surface_region

and proper_part_of SOME averaged_EEG_data_set
       that has_provenance_specification SOME event_type_label
            that has_character_string_value SOME &quot;stimulus_onset&quot;
       and has_provenance_specification SOME stimulus_type_label
            that has_character_string_value SOME &quot;object&quot;
       and has_provenance_specification SOME stimulus_modality_label
            that has_character_string_value SOME &quot;auditory&quot;</NEMO_annot:onto_definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">auditory_frontocentral_P1</NEMO_annot:pref_label>
        <NEMO_annot:definition rdf:datatype="&xsd;string">auditory_frontocentral_P100 is a positivity over frontocentral scalp regions at about 60-80ms after the onset of an auditory stimulus.</NEMO_annot:definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_6798000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_6798000">
