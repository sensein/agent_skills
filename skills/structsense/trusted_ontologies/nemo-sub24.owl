    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_1705000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_1705000">
        <rdfs:label rdf:datatype="&xsd;string">COP_ROI_mean_intensity_comparison_condition</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_9201000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-01</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-06-13</NEMO_annot:modified_date>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">COP_ROI_mean_intensity_comparison_condition</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">COP_ROI_mean_intensity_comparison_condition is a ... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">For some set of scalp EEG measurement values, specifies the mean electrical potential, in microvolts, over all electrodes within the region-of-interest (as specified by the COP) at the time of maximal positive intensity. COP_ROI_mean_intensity_comparison_condition applies to the spatiotemporal components of the ERP data obtained under the comparison condition.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Has corresponding term in Bob Frank&apos;s NEMO_ERP_Metric_Extraction matlab script: COP_ROI_Mean_Intensity_Comparison_Condition</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">is_a average_value; located_in?? some regional_part_of_scalp_surface_region; is_quality_measurement_of electrical_potential_difference</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
