    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_2471000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_2471000">
        <rdfs:label xml:lang="en">right_central_scalp_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_5088000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;location_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_2882000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_5088000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-06-08</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2013-10-14</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A left_parietal_scalp_surface_region is a region of the scalp surface that includes electrodes C3 and P3 (international 10-20 system) and electrode CP3 (international 10-10 system). 

It is right of the left_posterotemporal_scalp_region, rostral to the left_occipital_scalp_region, and caudal to the left_frontocentral_scalp_region.</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:comment rdf:datatype="&xsd;string">In the NEMO toolkit, the right_central_scalp_surface_region includes the following international 10-10 channels: FC4, FC6, C4, and C6.</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">left_parietal_scalp_surface_region is a parietal_scalp_surface_region that...</NEMO_annot:onto_definition>
        <NEMO_annot:comment>See also definition of &quot;central&quot; (NEMO_0000188) and &quot;right&quot; (NEMO_0000192). The &lt;right_central_scalp_surface region&gt; has_quality &lt;central&gt; and has_quality &lt;right&gt;.</NEMO_annot:comment>
        <NEMO_annot:synonym>RCENT</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


