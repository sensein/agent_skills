    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_8875000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_8875000">
        <rdfs:label rdf:datatype="&xsd;string">microelectrode</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000501"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-25</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-03-28</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A microelectrode is a type of electrode that it is used for intracellular recording, that is, measurement of neuroelectric activity generated by a single cell.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A microelectrode is an electrode that is disjoint with macroelectrode.</NEMO_annot:onto_definition>
