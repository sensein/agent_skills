        <NEMO_annot:definition rdf:datatype="&xsd;string">&quot;The thumb is the first digit of the [human] hand. When a person is standing in the medical anatomical position (where the palm is stretched forward), the thumb is the lateral-most digit. The Medical Latin English adjective for thumb is pollical&quot; (slightly modified from http://en.wikipedia.org/wiki/Thumb).</NEMO_annot:definition>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2011-01-15</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-01-15</NEMO_annot:modified_date>
