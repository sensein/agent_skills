    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_7572000">
        <rdfs:label rdf:datatype="&xsd;string">agraphia</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_3717000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-30</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-07-02</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Agraphia involves the inability to use graphemic symbols.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Agraphia is often a consequence of cerebrovascular accident, brain trauma or presence of tumors of the parietal lobe which involve the dominant cerebral hemisphere. This condition rarely occurs in isolation, and often accompanies alexia.</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">MSH2010_2010_02_22:D000381</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NCI Metathesaurus ID C0750890</NEMO_annot:synonym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_functional</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">SNOMEDCT_2010_1_31:158321001</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">SNOMEDCT_2010_1_31:206990000</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">SNOMEDCT_2010_1_31:27206009</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">UMLS_CUI:C0001825</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">agraphia</NEMO_annot:pref_label>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">dysgraphia</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://medical-dictionary.thefreedictionary.com/agraphia</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/NCIM/C0750890</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.org/obo/owl/DOID#DOID_4540</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://www.online-medical-dictionary.org/Acquired+Agraphia.asp?q=Acquired+Agraphia</NEMO_annot:definition_source>
