    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_5512000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_5512000">
        <rdfs:label rdf:datatype="&xsd;string">alpha_wave_activity</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_2392000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-26</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-09-02</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Alpha wave activity is an oscillation in brain electrical (EEG) activity in the frequency range of 8-12 Hz.</NEMO_annot:definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">C0002219</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">D000513</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">MSH Definition: One of four types of brain waves characterized by a relatively high voltage or amplitude and a frequency of 8-13 Hz. They constitute the majority of waves recorded by EEG registering the activity of the parietal and occipital lobes when the individual is awake, but relaxed with the eyes closed.</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Neurolex def: 	an electromagnetic oscillation in the frequency range of 8–12 Hz arising from synchronous and coherent (in phase / constructive) electrical activity. In mammals, thalamic pacemaker cells exhibit alpha oscillations (adapted from Wikipedia). </NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">alpha oscillation</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">alpha rhythm</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">alpha wave</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">alpha_wave_activity</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">alpha_wave_activity is a type of oscillatory_brain_electrical_activity that... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://ncim-stage.nci.nih.gov/ncimbrowser/ConceptReport.jsp?dictionary=NCI%20MetaThesaurus&amp;code=C0002219</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


