                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2013-07-26</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2013-07-26</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">An unnamed_positive_RCTEMP_effect  is a positivity that is significant over the right centrotemporal region of the scalp.</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
