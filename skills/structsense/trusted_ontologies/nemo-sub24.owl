    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4937000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4937000">
        <rdfs:label xml:lang="en">effect_size_statistic</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_6525000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;IAO_0000221"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_4124000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-05-19</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-05-19</NEMO_annot:modified_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">curator</NEMO_annot:definition_source>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">effect_size_statistic is a descriptive_statistic that is_about SOME effect_size</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">effect_size_statistic is a quantitative measure of the strength of the relationship between two variables in a statistical population, or a sample-based estimate of that quantity.</NEMO_annot:definition>
        <NEMO_annot:comment>Compare effect_size_quality, which is a qualitative, rather than a quantitative attribute of effect size</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4940001 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4940001">
