    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_3260000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_3260000">
        <rdfs:label rdf:datatype="&xsd;string">variance</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_4358000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-08</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Field, Andy. (2009) Discovering Statistics Using SPSS (Introducing Statistical Methods) 3rd Ed. Sage Publications, Ltd. London, UK. </NEMO_annot:definition_source>
        <NEMO_annot:comment rdf:datatype="&xsd;string">NCI Thesaurus ID C48918</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NPO_1803</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">NanoParticleOntology ID NPO_1803</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Variance</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#Variance</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/npo#NPO_1803</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://purl.org/net/OCRe/statistics.owl#Variance</NEMO_annot:definition_source>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">variance</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">variance is a descriptive_statistic that is_about SOME data_set</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">variance is an estimate of average variability (spread) of data points that describes how far, on average, the individual values deviate from the mean.  The variance of a random variable is equal to the mean of the squared deviation of that variable from its expected value.  Population variance is computed as the sum of squares (SS), divided by the number of values on which the sum of squares is based (n); that is, (SS/n) Sample variance is computed as SS/(n-1).</NEMO_annot:definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_3261000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_3261000">
        <rdfs:label rdf:datatype="&xsd;string">address</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;IAO_0000030"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-31</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">An address is a standardized representation of the physical location of a person&apos;s residence, business, building, or organization, or a unique numeric identifier assigned to each communication device connected to the Internet.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">address</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">address is an information_artifact_entity that is_about SOME spatial_region</NEMO_annot:onto_definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#Address</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://www.webopedia.com/TERM/A/address.html</NEMO_annot:definition_source>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


