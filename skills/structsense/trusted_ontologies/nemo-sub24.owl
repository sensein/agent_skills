    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_8018000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_8018000">
        <rdfs:label rdf:datatype="&xsd;string">scalp_recorded_negativity</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_5288000"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&OBO_REL;bearer_of"/>
                        <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_9811000"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&ro;has_participant"/>
                        <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_1000000"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-08-07</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-12-29</NEMO_annot:modified_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Scalp_recorded_negativity is the negative (sink) portion of a scalp_recorded_ERP.</NEMO_annot:definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">scalp_recorded_negativity</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">scalp_recorded_negativity is an event_related_brain_electrical_potential that is a proper_part_of some scalp_recorded_ERP and is is generated by an electromagnetic field that is the bearer_of some negative_polarity.</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


