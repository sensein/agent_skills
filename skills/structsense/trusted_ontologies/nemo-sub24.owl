        <NEMO_annot:definition rdf:datatype="&xsd;string">A generator potential is a graded electrical potential produced in a receptor cell by an appropriate physical stimulus (e.g., the depolarization produced by a touch receptor or a stretch receptor in the afferent fiber).</NEMO_annot:definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">Kandel, E.R., Schwartz, J.H., &amp; Jessell, T.M. (Eds.). (1995). Essentials of neural science and behavior. Stamford, CT: Appleton &amp; Lange.</NEMO_annot:pref_label>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">generator_potential</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">generator_potential is a electrical_potential that...[incomplete]</NEMO_annot:onto_definition>
