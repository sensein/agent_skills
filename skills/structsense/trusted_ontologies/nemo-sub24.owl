        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#direct_import"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000001 -->

    <owl:Class rdf:about="&obo;IAO_0000001">
        <rdfs:label rdf:datatype="&xsd;string">conditional_specification</rdfs:label>
