    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0715000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0715000">
        <rdfs:label xml:lang="en">perceptual_discrimination</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_4320000"/>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-04-23</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-04-23</NEMO_annot:created_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">a cognitive_process is a mental process engaging one or more systems in the intermediary or integrative processing of signals from the internal (visceral) and external (somatic) environments. It is often the result of a sensory_process (bottom-up cognition). It may be mediated by an emotion_process (motivated cognition) or by another cognitive_process, such as memory or expectancy based on prior experience (top-down cognition).</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">mental_process is a brain_physiological_process that...[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:synonym>http://ontology.neuinfo.org/NIF/Function/NIF-Function.owl#birnlex_1800</NEMO_annot:synonym>
        <NEMO_annot:definition_source>curator.</NEMO_annot:definition_source>
        <rdfs:comment>To be replaced by concepts from cogATLAS....</rdfs:comment>
        <NEMO_annot:synonym>cognition</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0745000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0745000">
        <rdfs:label rdf:datatype="&xsd;string">peak_latency_measurement_datum</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;IAO_0000416"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;IAO_0000221"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000524"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-06-06</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-06-29</NEMO_annot:modified_date>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A peak_latency_measurement_datum is a temporal_measurement_datum that inheres_in an ERP dataset  [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A peak_latency_measurement_datum specifies the time (in milliseconds) of maximal intensity of an event. Note that peak latency is defined here as an absolute value: it represents the time at which a measurement is either maximally positive or maximally negative with respect to baseline.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Has corresponding term in Bob Frank&apos;s NEMO_ERP_Metric_Extraction matlab script: Peak_Latency</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">has_measurement_unit_label (millisecond_unit_label); has_proper_part (numeral)</NEMO_annot:comment>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">peak_latency_measurement_datum</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


