    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_8769000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_8769000">
        <rdfs:label rdf:datatype="&xsd;string">edf_data_format</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_1194000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-25</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-07-02</NEMO_annot:modified_date>
        <NEMO_annot:comment rdf:datatype="&xsd;string">An .edf  data file contains one uninterrupted digitized polygraphic recording. A data file consists of a header record followed by data records. The variable-length header record identifies the patient and specifies the technical characteristics of the recorded signals. The data records contain consecutive fixed-duration epochs of the polygraphic recording.</NEMO_annot:comment>
        <NEMO_annot:definition rdf:datatype="&xsd;string">EDF is a standard data format for exchange and storage of multichannel continuous biological and physical signals, independent of the data acquisition system.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">EDF was published in 1992 in Electroencephalography and Clinical Neurophysiology, 82: 391-39 and has since became the de-facto standard for EEG and PSG recordings in commercial equipment and multicenter research projects.</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">edf_data_format</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">edf_data_format is a data_format that inheres_in some data_item and is the concretization of some edf_data_format_specification.</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://tech.groups.yahoo.com/group/EDF/</NEMO_annot:definition_source>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://www.edfplus.info/</NEMO_annot:definition_source>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


