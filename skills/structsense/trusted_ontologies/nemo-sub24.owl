    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_8843000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_8843000">
        <rdfs:label rdf:datatype="&xsd;string">x_scalp_surface_axis</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_6023000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-06-06</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-04-22</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">An x_scalp_surface_axis is a directional term that is defined in reference to a two-dimensional scalp_surface coordinate system.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">An x_scalp_surface_axis is a one_dimensional_region that is the proper_part_of some scalp_surface_region.</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">laterality_axis</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">x_scalp_surface_axis</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


