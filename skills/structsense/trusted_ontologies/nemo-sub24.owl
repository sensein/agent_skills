    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_9281000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_9281000">
        <rdfs:label rdf:datatype="&xsd;string">lateral_CON_cluster_label</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;IAO_0000009"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-01</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-06-13</NEMO_annot:modified_date>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Has corresponding term in Bob Frank&apos;s NEMO_ERP_Metric_Extraction matlab script: Lateral_CON_Cluster_Label</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Specifies for each spatiotemporal component pair the degree of lateral symmetry manifest in the negative electrical potential over the measured scalp-surface. The Lateral_CON_Cluster_Label algorithm first computes the relative difference between the mean electrical potential at CON_ROI_Label and the mean electrical potential at its homologous, opposite hemisphere, scalp-surface region. The computed relative difference is then compared to LatIndex_Threshold: if LatIndex_Threshold is exceeded, Laterality_CON_Cluster is labeled as Right or Left in accordance with the hemisphere containing CON_ROI. Otherwise, Laterality_CON_Cluster is labeled as Bilateral to accord with lateral symmetry. If CON_ROI is initially part of a medial scalp-surface region, the procedure is applied to the scalp-surface regions to the right of and left of the medial CON_ROI_Label.</NEMO_annot:definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">lateral_CON_cluster_label</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">lateral_CON_cluster_label is a ... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


