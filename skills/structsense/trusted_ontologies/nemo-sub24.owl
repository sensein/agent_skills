    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0000001 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0000001">
        <rdfs:label rdf:datatype="&xsd;string">ERP_topography</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_5336000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2009-05-07</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-07-22</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">ERP_spatial_pattern</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">ERP_topography</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">ERP_topography is a Quality (incomplete)</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">ERP_topography is the pattern or distribution of positive (source) and negative (sink) electrical potentials over an anatomical_region (over a two-dimensional scalp_surface_region if measured on the head surface, and over a three-dimensional brain_region if measured intracranially or if scalp-measured patterns have been source modeled). It has a strength (amplitude, measured in microvolts), which can vary over time.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0000003 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0000003">
        <rdfs:label rdf:datatype="&xsd;string">scalp_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000195"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;location_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000176"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0550000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2009-05-07</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-04-22</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A scalp_region is a three-dimensional spatial region, whose coordinates are defined with respect to anatomical landmarks on and within the scalp.  The spatial subdivisions of the scalp reflect subdivisions of the skull, which are named after the four major lobes of the cerebral cortex — i.e., frontal, temporal, parietal, and occipital.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A scalp_region is an anatomical_region that is the exact location_of some scalp</NEMO_annot:onto_definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Human_skull</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">scalp ROI</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">scalp_region</NEMO_annot:pref_label>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">scalp_region_of_interest</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0000005 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0000005">
        <rdfs:label rdf:datatype="&xsd;string">frontal_scalp_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_5003000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;location_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_9718000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_5003000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_0000035"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_5088000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="&ontology;NEMO.owl#NEMO_0000006"/>
        <owl:disjointWith rdf:resource="&ontology;NEMO.owl#NEMO_0000007"/>
        <owl:disjointWith rdf:resource="&ontology;NEMO.owl#NEMO_5088000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2009-05-07</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-06-08</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A frontocentral_scalp_surface_region is a region of the scalp surface that includes electrodes Fz, F1, F2, AFz, AF1, AF2, F3, F5, AF3, AF5, F4, F6, AF4, AF6, F7, F9, AF7, F8, F10, and AF8 (international 10-10 system). 

It is rostral to the central_scalp_surface_region and medial to the left and right frontotemporal scalp regions.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A frontocentral_scalp_surface_region is a regional_part_of_scalp_surface_region that is the exact location_of some  frontocentral_scalp_surface.</NEMO_annot:onto_definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:comment>See also definition of &quot;rostral&quot; (NEMO_0000189). The &lt;frontal_scalp_surface region&gt; has_quality &lt;frontal&gt;.</NEMO_annot:comment>
        <rdfs:comment>In the NEMO toolkit, the frontocentral_scalp_surface_region includes the following international 10-10 channels: Fz, FCz, F1, FC1, F2, FC2 (mid); F3, FC3, F5, FC5 (left); and F4, FC4, F6, FC6 (right). </rdfs:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0000006 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0000006">
        <rdfs:label rdf:datatype="&xsd;string">parietal_scalp_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_5003000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_0000035"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_5003000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;location_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0895000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="&ontology;NEMO.owl#NEMO_0000007"/>
        <owl:disjointWith rdf:resource="&ontology;NEMO.owl#NEMO_5088000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2009-05-07</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-06-08</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A parietal_scalp_surface_region is a region of the scalp surface that includes electrodes CPz, CP1, CP2, Cz, C1, C2, CP3, CP4, CP5, CP6, P3, P5, P4, and P6 (international 10-10 system). 

It is rostral to the occipital_scalp_surface_region, caudal to the central_scalp_surface_region, and medial to the left and right posterotemporal scalp surface regions.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A parietal_scalp_surface_region is a regional_part_of_scalp_surface_region that is the exact location_of some  parietal_scalp_surface.</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:comment>In the NEMO toolkit, the parietal_scalp_surface_region includes the following international 10-10 channels: Cz, C1, C2 CPz, CP1, CP2, Pz, P1, P2 (mid); C3, C5, CP3, CP5, P3, P5 (left); and C4, C6, CP4, CP6, P4, P6 (right).</NEMO_annot:comment>
        <NEMO_annot:comment>See also definition of &quot;parietal&quot; (NEMO_3212000). The &lt;parietal_scalp_surface region&gt; has_quality &lt;parietal&gt;.</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0000007 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0000007">
        <rdfs:label rdf:datatype="&xsd;string">occipital_scalp_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_5003000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;location_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_5231000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_5003000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="&ontology;NEMO.owl#NEMO_5088000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2009-05-07</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2013-09-16</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">An occipital_scalp_surface_region is a region of the scalp surface that includes electrodes Oz, O1, and O2 (international 10-20 system) and electrodes POz, PO1, PO2, PO3, PO4, PO5, and PO6 (international 10-10 system). 

It is caudal to the parietal_scalp_region and medial to the left and right posterotemporal scalp regions.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">An occipital_scalp_surface_region is a regional_part_of_scalp_surface_region that is the exact location_of some  occipital_scalp_surface.</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:comment rdf:datatype="&xsd;string">In the NEMO toolkit, the occipital_scalp_surface_region includes the following international 10-10 channels: POz, PO1, PO2 (mid); O1, PO3, PO5, PO7 (left); and O2, PO4, PO6, PO8 (right).</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:comment>See also definition of &quot;occipital&quot; (NEMO_3632000). The &lt;occipital_scalp_surface region&gt; has_quality &lt;occipital&gt;.</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0000008 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0000008">
        <rdfs:label rdf:datatype="&xsd;string">frontopolar_scalp_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO_annotation_properties.owl#_limbo"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2009-05-07</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-06-08</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A frontopolar_scalp_surface_region is a region of the scalp surface that includes electrodes FP1 and FP2 (international 10-20 system) and electrodes AF3 and AF4 (international 10-10 system). 

It is rostral to the frontotemporal scalp region.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A frontopolar_scalp_surface_region is a regional_part_of_scalp_surface_region that is the exact location_of some  frontopolar_scalp_surface.</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <rdfs:comment rdf:datatype="&xsd;string">In the NEMO toolkit, the frontopolar_scalp_surface_region includes the following international 10-10 channels: FPz, AFz, AF1, AF2 (mid); FP1, AF3, AF5, AF7  (left); and FP2, AF4, AF6, AF8  (right).</rdfs:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">orbitofrontal _scalp_region</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0000009 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0000009">
        <rdfs:label rdf:datatype="&xsd;string">frontotemporal_scalp_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO_annotation_properties.owl#_limbo"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2009-05-07</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2013-09-16</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A frontotemporal_scalp_surface_region is a region of the scalp surface that includes electrode F7, T7 and F8, T8 (international 10-20 system) and electrodes FT7 and FT8 (international 10-10 system). 

It is lateral to the frontal scalp surface region and rostral to the centrotemporal scalp surface region.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A frontotemporal_scalp_surface_region is a regional_part_of_scalp_surface_region that is the exact location_of some  frontotemporal_scalp_surface.</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">anterotemporal_scalp_region</NEMO_annot:synonym>
        <NEMO_annot:comment>See left_frontotemporal_scalp_surface_region and right_frontotemporal_scalp_surface_region</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0000010 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0000010">
        <rdfs:label rdf:datatype="&xsd;string">parietotemporal_scalp_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO_annotation_properties.owl#_limbo"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2009-05-07</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2013-10-14</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A posterotemporal_scalp_surface_region is a region of the scalp surface that includes electrode P7 and P8 (international 10-20 system) and electrode TP7 and TP8 (international 10-10 system). 

It is lateral to the parietal scalp region and caudal to the centrotemporal scalp surface regions.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A posterotemporal_scalp_surface_region is a regional_part_of_scalp_surface_region that is the exact location_of some  posterotemporal_scalp_surface.</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:comment rdf:datatype="&xsd;string">In the NEMO toolkit, the posterotemporal_scalp_surface_region includes the following international 10-10 channels: P7, P9, TP7, and TP9 (left); P8, P10, TP8, and TP10 (right). </NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">posterotemporal_scalp_surface_region</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0000011 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0000011">
        <rdfs:label rdf:datatype="&xsd;string">left_frontotemporal_scalp_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000005"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000009"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;location_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_8640000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2009-05-07</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2013-10-14</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A left_frontotemporal_scalp_surface_region is a region of the scalp surface that includes electrode F7, T7 (international 10-20 system) and electrodes F9, FT7, FT9, and T9 (international 10-10 system). 

It is left of the left_frontocentral_scalp_region and rostral to the left_posterotemporal_scalp_region.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">Curator.</NEMO_annot:onto_definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">In the NEMO toolkit, the left_frontotemporal_scalp_surface_region includes the following international 10-10 channels: F7, F9, AF7, and AF9.</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:synonym>LFTEMP</NEMO_annot:synonym>
        <NEMO_annot:comment>See also definition of &quot;rostral&quot; (NEMO_0000189) and &quot;left temporal&quot; (NEMO_8302000). The &lt;left_frontotemporal_scalp_surface region&gt; has_quality &lt;rostral&gt; and has_quality &lt;left temporal&gt;.</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0000012 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0000012">
        <rdfs:label rdf:datatype="&xsd;string">right_frontotemporal_scalp_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000005"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;location_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_1345000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000009"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2009-05-07</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2013-10-14</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A right_frontotemporal_scalp_surface_region is a region of the scalp surface that includes electrode F8, T8 (international 10-20 system) and electrodes F10 FT8, FT10, and T10 (international 10-10 system). 

It is right of the right_frontocentral_scalp_region and rostral to the right_posterotemporal_scalp_region.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">In the NEMO toolkit, the right_frontotemporal_scalp_surface_region includes the following international 10-10 channels: F8, F10, AF8, and AF10.</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">right_frontotemporal_scalp_surface_region is a frontotemporal_scalp_surface_region that...[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:synonym>RFTEMP</NEMO_annot:synonym>
        <NEMO_annot:comment>See also definition of &quot;rostral&quot; (NEMO_0000189) and &quot;right temporal&quot; (NEMO_3587000). The &lt;right_frontotemporal_scalp_surface region&gt; has_quality &lt;rostral&gt; and has_quality &lt;right temporal&gt;.</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0000013 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0000013">
        <rdfs:label rdf:datatype="&xsd;string">left_frontal_scalp_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000005"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;location_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0406000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000005"/>
            </owl:Restriction>
