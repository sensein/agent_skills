        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-05-12</NEMO_annot:created_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">An unnamed_negative_LPAR_effect is a negativity that is significant over the left parietal region of the scalp.</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
