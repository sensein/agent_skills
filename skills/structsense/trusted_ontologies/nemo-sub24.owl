    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_1431000">
        <rdfs:label rdf:datatype="&xsd;string">besa_data_format</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_1194000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-25</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-07-02</NEMO_annot:modified_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">besa_data_format</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">besa_data_format is a quality that inheres_in some data_item and is the concretization of some besa_data_format_specification.</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">besa_data_format refers to a family of data formats created by research or clinical software applications for source analysis of EEG and MEG data, built and distributed by BESA GmbH (Brain Electrical Source Analysis). </NEMO_annot:definition>
