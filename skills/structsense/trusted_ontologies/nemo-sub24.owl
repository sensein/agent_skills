    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_3357000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_3357000">
        <rdfs:label xml:lang="en">sympathetic_nervous_system</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_6191000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000174"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:definition rdf:datatype="&xsd;string">&quot;The sympathetic nervous system is responsible for up- and down-regulating many homeostatic mechanisms in living organisms. Fibers from the SNS innervate tissues in almost every organ system, providing at least some regulatory function to things as diverse as pupil diameter, gut motility, and urinary output. It is perhaps best known for mediating the neuronal and hormonal stress response commonly known as the fight-or-flight response. .&quot; (wikipedia)</NEMO_annot:definition>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-06-30</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-06-30</NEMO_annot:created_date>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Sympathetic_nervous_system#Function</NEMO_annot:definition_source>
        <NEMO_annot:acronym>SNS</NEMO_annot:acronym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


