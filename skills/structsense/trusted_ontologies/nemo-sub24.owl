     xmlns:NIFSTD="http://ontology.neuinfo.org/NIF/DigitalEntities/NIF-Investigation.owl#"
     xmlns:ro2="http://obofoundry.org/ro/ro.owl#"
     xmlns:UO="http://purl.org/obo/owl/UO#"
     xmlns:snap="http://www.ifomis.org/bfo/1.1/snap#"
     xmlns:ontology="http://purl.bioontology.org/NEMO/ontology/"
     xmlns:BiomedicalResourceOntology="http://bioontology.org/ontologies/BiomedicalResourceOntology.owl#"
