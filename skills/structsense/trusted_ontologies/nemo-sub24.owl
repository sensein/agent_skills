        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-07-02</NEMO_annot:modified_date>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Field, Andy. (2009) Discovering Statistics Using SPSS (Introducing Statistical Methods) 3rd Ed. Sage Publications, Ltd. London, UK, p. 734.</NEMO_annot:definition_source>
