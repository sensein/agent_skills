        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;location_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_2935000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000006"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2009-05-07</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2013-10-14</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A right_parietal_scalp_surface_region is a region of the scalp surface that includes electrodes CP4, CP6, C4, and C6 (international 10-10 system). 

It is right of the medial_parietal_scalp_region, rostral to the right_occipital_scalp_region, and caudal to the right_frontocentral_scalp_region.</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:comment rdf:datatype="&xsd;string">In the NEMO toolkit, the right_parietal_scalp_surface_region includes the following international 10-10 channels: C4, C6, CP4, CP6, P4, P6.</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">right_parietal_scalp_surface_region is parietal_scalp_surface_region that..</NEMO_annot:onto_definition>
        <NEMO_annot:comment>See also definition of &quot;parietal&quot; (NEMO_3212000) and &quot;right&quot; (NEMO_0000192). The &lt;right_parietal_scalp_surface region&gt; has_quality &lt;parietal&gt; and has_quality &lt;right&gt;.</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0000024 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0000024">
        <rdfs:label rdf:datatype="&xsd;string">left_parietotemporal_scalp_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000010"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;location_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_9570000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2009-05-07</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2013-10-14</NEMO_annot:modified_date>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:comment rdf:datatype="&xsd;string">In the NEMO toolkit, the left_posterotemporal_scalp_surface_region includes the following international 10-10 channels: P7, P9, TP7, and TP9 (left).</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">left_posterotemporal_scalp_surface_region</NEMO_annot:synonym>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">left_posterotemporal_scalp_surface_region is posterotemporal_scalp_surface_region that...</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">left_posterotemporal_scalp_surface_region is the left part of the posterotemporal_scalp_region. It is left of the left_parietal_scalp_region and caudal to the left_frontotemporal_scalp_region.</NEMO_annot:definition>
        <NEMO_annot:synonym>LPTEMP</NEMO_annot:synonym>
        <NEMO_annot:comment>See also definition of  &quot;parietal&quot; (NEMO_3212000). and &quot;left temporal&quot; (NEMO_8302000). The &lt;left_parietotemporal_scalp_surface region&gt; has_quality &lt;parietal&gt; and has_quality &lt;left temporal&gt;.</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0000025 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0000025">
        <rdfs:label rdf:datatype="&xsd;string">right_parietotemporal_scalp_surface_region</rdfs:label>
