    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_8744000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_8744000">
        <rdfs:label rdf:datatype="&xsd;string">Brodmann_area_20_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7920000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-22</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-01-04</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Area temporalis inferior</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">B09-20</NEMO_annot:synonym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">B09-20</NEMO_annot:acronym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">BA20</NEMO_annot:acronym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Bowden, D. M., &amp; Dubach, M. F. (2003). NeuroNames 2002. Neuroinformatics, 1(1), 43-59.</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann (1909) area 20</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann area 20</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">Brodmann_area_20_surface_region</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">Brodmann_area_20_surface_region is a two_dimensional_region that is the location of SOME regional_part_of_cortical_surface</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Brodmann_area_20_surface_region refers to a subdivision of the cerebral cortex of the guenon defined on the basis of cytoarchitecture. It is cytoarchitecturally homologous to the inferior temporal area 20 of the human (Brodmann-1909). Distinctive features (Brodmann-1905): area 20 is similar to area 19 of Brodmann-1909 in the relative abundance of small cell types relative to the number of larger pyramidal cells; a very dense, wide internal granular layer (IV) composed almost exclusively of granule cells, as in area 18 of Brodmann-1909; a broad, clear internal pyramidal layer (V) with few cells; and a distinct multiform layer (VI). The major differences from areas 18 and 19 are somewhat lesser cell density; absence of a division of the external pyramidal layer (III) into sublayers 3a and 3b; layer V is more clearly distinguished from layer VI and, on average, has a greater density of pyramidal ganglion cells than in the other areas; layer VI is wider, more diffuse and has fewer cells that are concentrated in the outer part of the layer to produce a denser sublayer 6a and a less dense sublayer 6b.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Formerly NN-74 in NeuroNames</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-318378271</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-932</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">NeuroNames concept ID NN-2112</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Umlscui C1272538</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 20 of Brodmann (human)</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 20 of Brodmann-1909</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">birnlex_1751</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">inferior temporal</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">inferior temporal area 20</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


