    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4397000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4397000">
        <rdfs:label rdf:datatype="&xsd;string">Brodmann_area_19_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7920000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-22</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-12-15</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Area peristriata</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Area peristriata of Smith</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Area praeoccipitalis</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">B09-19</NEMO_annot:synonym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">B09-19</NEMO_annot:acronym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">BA19</NEMO_annot:acronym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Bowden, D. M., &amp; Dubach, M. F. (2003). NeuroNames 2002. Neuroinformatics, 1(1), 43-59.</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann (1909) area 19</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann area 19</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann&apos;s area 19</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">Brodmann_area_19_surface_region</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">Brodmann_area_19_surface_region is a two_dimensional_region that is the location of SOME regional_part_of_cortical_surface</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Brodmann_area_19_surface_region refers to a subdivision of the cerebral cortex of the guenon defined on the basis of cytoarchitecture. It is cytoarchitecturally homologous to the peristriate area 19 of the human (Brodmann-1909). Distinctive features (Brodmann-1905): Compared to area 18 of Brodmann-1909, the pyramidal cells of sublayer 3b of the external pyramidal layer (III) are not as densely distributed, the layer is not as narrow, and its boundary with the internal granular layer (IV) is not as distinct; the cells in sublayer 3b are concentrated at its outer boundary leaving a narrow clear zone with no large pyramidal cells adjacent to layer IV; the granule cells of layer IV are less densely distributed and are intermixed with larger polymorphic cells so that, while the layer is still quite dark and prominent, it is somewhat widened and not as self-contained; the internal pyramidal layer (V) is characterized by large pyramidal ganglion cells, most in small groups, a pattern not seen in area 18; the cells in the multiform layer (VI) are clearly larger than in area 18; overall area 19 is somewhat thicker and less densely populated than area 18.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Formerly NN-416 in NeuroNames</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-1185</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-1190</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-1191</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-1193</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-1194</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-1195</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-1196</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-37990288</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-75941646</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">NeuroNames concept ID NN-2111</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Umlscui C1272537</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 19</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 19 of Brodmann (human)</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 19 of Brodmann-1909</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">birnlex_1750</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">peristriate</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">peristriate area</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">peristriate area 19</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">pre-occipital cortex</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">preoccipital cortex</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">visual area III</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


