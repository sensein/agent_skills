    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_2371000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_2371000">
        <rdfs:label rdf:datatype="&xsd;string">Brodmann_area_52_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7920000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-22</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-01-14</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Area parainsularis</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">B09-52</NEMO_annot:synonym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">B09-52</NEMO_annot:acronym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">BA52</NEMO_annot:acronym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann (1909) area 52</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann area 52</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">Brodmann_area_52_surface_region</NEMO_annot:pref_label>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Brodmann_area_52_surface_region is a subdivision of the cytoarchitecturally defined temporal region of cerebral cortex. It is located in the bank of the lateral sulcus on the dorsal surface of the temporal lobe. Its medial boundary corresponds approximately to the junction between the temporal lobe and the insula. Cytoarchitecturally it is bounded laterally by the anterior transverse temporal area 41 (H) (Brodmann-1909).</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">Brodmann_area_52_surface_region is a two_dimensional_region that is the location of SOME regional_part_of_cortical_surface</NEMO_annot:onto_definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Formerly NN-76 in NeuroNames</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-1845148203</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-947</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">NeuroNames concept ID NN-2414</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Umlscui C1272514</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 52 of Brodmann (human)</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">birnlex_1792</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://psychology.wikia.com/wiki/Brodmann_area_52</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">parainsular</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">parainsular area 52</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">parainsular_cortex</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


