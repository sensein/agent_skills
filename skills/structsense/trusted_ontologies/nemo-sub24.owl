        <rdfs:label>success</rdfs:label>
        <rdfs:subClassOf rdf:resource="&PATO;PATO_0001236"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2011-05-28</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-05-28</NEMO_annot:modified_date>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">success</NEMO_annot:pref_label>
        <NEMO_annot:definition rdf:datatype="&xsd;string">success is a planned_process quality that indicates whether the process achieved the desired outcome</NEMO_annot:definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_1686000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_1686000">
        <rdfs:label rdf:datatype="&xsd;string">audio_speaker</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo2;OBI_0400003"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-30</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-03-28</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">An audio_speaker is a device that converts electrical audio-frequency signals into sound waves by means of a vibrating conical diaphragm.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">audio_speaker is a device that is an instrument_of some planned_process (sound production)</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://wordnetweb.princeton.edu/perl/webwn?s=loudspeaker</NEMO_annot:definition_source>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://www.thefreedictionary.com/loudspeaker</NEMO_annot:definition_source>
