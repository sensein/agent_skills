        <rdfs:subClassOf rdf:resource="&UO;UO_0000190"/>
        <NEMO_annot:comment rdf:datatype="&xsd;string">&quot;A unit of relative electrical, acoustical, or optical power equal to one-tenth of a bel (B)&quot; (Weik, M. (2000). Computer science and communications dictionary (1st ed., Vols. 1-2). Boston: Kluwer Academic Publishers.</NEMO_annot:comment>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-24</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-12</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A ratio unit which is an indicator of sound power per unit area.</NEMO_annot:definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NCI_C0439497</NEMO_annot:synonym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_imported_classes</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">National Cancer Institute Metathesaurus ID NCI_C0439497</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Previously imported into NEMO_data</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">SNOMEDCT_259042002</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Submitted to NIF in November 2010.</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Systemathized Nomenclature of Medicine - CLinical Terms ID SNOMEDCT_259042002.</NEMO_annot:comment>
        <NEMO_annot:source_ontology rdf:datatype="&xsd;string">Units of measurement ontology (UO)</NEMO_annot:source_ontology>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">dB</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">decibel</NEMO_annot:pref_label>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">decibel_qualifier_value </NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://purl.org/obo/owl/UO#UO_0000259</NEMO_annot:definition_source>
