    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_8902000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_8902000">
        <rdfs:label rdf:datatype="&xsd;string">max_electrode_intensity_baseline</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_8708000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-01</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-06-13</NEMO_annot:modified_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">The NEMO_ERP_Toolkit computes the baseline value as the mean electrical potential at the peak-positive-intensity electrode location over a user-specified time interval centered on a user-specified reference timepoint. The computed baseline value is then subtracted from max_electrode_intensity: max_electrode_intensity_baseline = max_electrode_intensity - computed_baseline_value.</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">is_a maximum_value; located_in?? some regional_part_of_scalp_surface_region; is_quality_measurement_of electrical_potential_difference</NEMO_annot:comment>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">max_electrode_intensity_baseline</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">max_electrode_intensity_baseline is a ... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">max_electrode_intensity_baseline specifies the max_electrode_intensity, in microvolts, with respect to some baseline value. </NEMO_annot:definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


