    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_2532000 -->

    <owl:ObjectProperty rdf:about="&ontology;NEMO.owl#NEMO_2532000">
        <rdfs:label rdf:datatype="&xsd;string">object_of</rdfs:label>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-27</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-07-27</NEMO_annot:modified_date>
        <NEMO_annot:comment rdf:datatype="&xsd;string">In linguistics, most arguments (NPs) of a relation can be classified in terms of three core participant (or &apos;thematic&apos;, &apos;theta&apos;) roles: &lt;AGENT&gt;, &lt;PATIENT&gt; (here termed &apos;object&apos;), and &lt;INSTRUMENT&gt;. Because these three argument roles are so central to the way humans conceptualize events, we are representing all three as subclasses of &lt;PARTICIPANT&gt;. We plan to have all three types of &lt;PARTICIPANT&gt; represented as subclasses of BFO:role if we maintain these relations. See also BioTop (bio-upper-ontology).</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">In linguistics, the term &apos;patient&apos; would be used, rather than &apos;object&apos; but it may be more subject to misinterpretation. </NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_relations</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://www.co-ode.org/ontologies/basic-bio/advanced-relational-properties.owl#acts_on</NEMO_annot:definition_source>
        <NEMO_annot:comment rdf:datatype="&xsd;string">is_specified_output_of may be a subclass; is_specified_input_of may be a subclass</NEMO_annot:comment>
        <NEMO_annot:definition rdf:datatype="&xsd;string">object_in is a type of relation that takes a non-agentive object (continuant) as its domain and a process as its range.</NEMO_annot:definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">object_of</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
        <rdfs:range rdf:resource="&span;Occurrent"/>
        <rdfs:subPropertyOf rdf:resource="&ro;participates_in"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_2618001 -->

