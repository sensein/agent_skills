    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_7123000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_7123000">
        <rdfs:label rdf:datatype="&xsd;string">COP_ROI_mean_intensity_standard_minus_comparison</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_9201000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-01</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-06-06</NEMO_annot:modified_date>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">COP_ROI_mean_intensity_standard_minus_comparison</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">COP_ROI_mean_intensity_standard_minus_comparison is a ... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">For some set of scalp EEG measurement values, specifies the mean electrical potential, in microvolts, over all electrodes within the region-of-interest (as specified by the COP) at the time of maximal positive intensity for an experimental condition of interest minus a comparison condition.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Has corresponding term in Bob Frank&apos;s NEMO_ERP_Metric_Extraction matlab script: CON_ROI_Mean_Intensity_Standard_Minus_Comparison_Condition</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">The NEMO_ERP_Toolkit algorithm computes COP_ROI_mean_intensity_standard_minus_comparison as COP_ROI_mean_intensity - COP_ROI_mean_intensity_comparison_condition, which for both tPCA and sICA guarantees that their respective spatiotemporal component pairs share the same temporal component.</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">is_a average_value; located_in?? some regional_part_of_scalp_surface_region; is_quality_measurement_of electrical_potential_difference</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


