    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_8302000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_8302000">
        <rdfs:label xml:lang="en">left_temporal</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000185"/>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-06-21</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-06-21</NEMO_annot:created_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Spatial concepts in NEMO refer to objects located on, in, or near the head. They may not generalize to spatial relations among other objects.</NEMO_annot:comment>
        <NEMO_annot:definition rdf:datatype="&xsd;string">left temporal refers to the part of the head surface that can be considered either &quot;left of left&quot; or &quot;left and inferior.&quot; For NEMO purposes, we are treating this region as a subdivision of laterality, because we have partitioned electrodes into 5 laterality clusters (mid, left, right, left temporal and right temporal).</NEMO_annot:definition>
        <NEMO_annot:comment>left temporal refers to the part of the head surface that can be considered either &quot;left of left&quot; or &quot;left and inferior.&quot; For NEMO purposes, we are treating this region as a subdivision of laterality, because we have partitioned electrodes into 5 laterality clusters (mid, left, right, left temporal and right temporal).</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


