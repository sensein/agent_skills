    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_8161000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_8161000">
        <rdfs:label xml:lang="en">jpg_data_format</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_1194000"/>
        <NEMO_annot:definition rdf:datatype="&xsd;string">&quot;JPEG (.jpg) is a commonly used method of lossy compression for digital photography (image). The degree of compression can be adjusted, allowing a selectable tradeoff between storage size and image quality. JPEG typically achieves 10:1 compression with little perceptible loss in image quality.&quot; (wikipedia)</NEMO_annot:definition>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-09-07</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-09-07</NEMO_annot:modified_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/JPEG</NEMO_annot:definition_source>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">jpg_data_format is a data_format that inheres_in some data_item and is the concretization of some jpg_data_format_specification.</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


