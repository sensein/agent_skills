        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#direct_import"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000033 -->

    <owl:Class rdf:about="&obo;IAO_0000033">
        <rdfs:label rdf:datatype="&xsd;string">directive_information_entity</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;IAO_0000030"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-22</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-05-15</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A directive_information_entity is an information content entity whose concretizations indicate to their bearer how to realize them in a process.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Imported into NEMO_data, NEMO_functional</NEMO_annot:comment>
        <NEMO_annot:source_ontology rdf:datatype="&xsd;string">Information Artifact Ontology (IAO)</NEMO_annot:source_ontology>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_imported_classes</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">directive_information_entity</NEMO_annot:pref_label>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://purl.obolibrary.org/obo/IAO_0000033</NEMO_annot:definition_source>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#direct_import"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000064 -->

    <owl:Class rdf:about="&obo;IAO_0000064">
        <rdfs:label rdf:datatype="&xsd;string">algorithm</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;IAO_0000104"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2009-06-06</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-07-16</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A plan specification which describes inputs, output of mathematical functions as well as workflow of execution for achieving an predefined objective. Algorithms are realized usually by means of implementation as computer programs for execution by automata.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Imported into NEMO_data</NEMO_annot:comment>
        <NEMO_annot:source_ontology rdf:datatype="&xsd;string">Information Artifact Ontology (IAO)</NEMO_annot:source_ontology>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_imported_classes</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">algorithm</NEMO_annot:pref_label>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://purl.obolibrary.org/obo/IAO_0000064</NEMO_annot:definition_source>
        <NEMO_annot:comment rdf:datatype="&xsd;string">maybe change the name of this class (and subclasses) to algorithm_specification per discussion IAO listerv</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#direct_import"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000098 -->

    <owl:Class rdf:about="&obo;IAO_0000098">
        <rdfs:label rdf:datatype="&xsd;string">data_format_specification</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;IAO_0000033"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-24</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-05-15</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A data format specification is the information content borne by the document published defining the specification. Example: The ISO document specifying what encompasses an XML document; The instructions in a XSD file</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Imported into NEMO_data</NEMO_annot:comment>
        <NEMO_annot:source_ontology rdf:datatype="&xsd;string">Information Artifact Ontology (IAO)</NEMO_annot:source_ontology>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_imported_classes</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">data_format_specification</NEMO_annot:pref_label>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://purl.obolibrary.org/obo/IAO_0000098</NEMO_annot:definition_source>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#direct_import"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000100 -->

    <owl:Class rdf:about="&obo;IAO_0000100">
        <rdfs:label rdf:datatype="&xsd;string">data_set</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;IAO_0000027"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2009-06-07</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-04-22</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A data set is an information content entity that is an aggregate of other information_content_entities that have something in common and are considered to form a unit.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Imported into NEMO_data</NEMO_annot:comment>
