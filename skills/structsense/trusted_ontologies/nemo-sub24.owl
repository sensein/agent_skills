    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_5891000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_5891000">
        <rdfs:label rdf:datatype="&xsd;string">electrophysiological_artifact</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_4396000"/>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-04-22</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-22</NEMO_annot:created_date>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">An electrophysiological_artifact is an artifact that inheres_in an electrophysiological_data_set</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Electrophysiological artifacts are anomalous (interfering signals) that originate from some source other than the electrophysiological structure being studied. These artifact signals may stem from, but are not limited to: light sources; monitoring equipment issues; utility frequency (50Hz and 60Hz); or undesired electrophysiological signals such as EMG presenting on an EEG-, EP-, ECG-, or EOG- signal. Offending artifacts may obscure, distort, or completely misrepresent the true underlying electrophysiological signal sought.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">electrophysiological_artefact</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">electrophysiological_artifact</NEMO_annot:pref_label>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Artifact_%28error%29</NEMO_annot:definition_source>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Chris_Bird"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_5896000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_5896000">
        <rdfs:label rdf:datatype="&xsd;string">Brodmann_area_33_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7920000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-22</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-01-14</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Area infraradiata ventralis</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Area praegenualis</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">B09-33</NEMO_annot:synonym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">B09-33</NEMO_annot:acronym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">BA33</NEMO_annot:acronym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann (1909) area 33</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann area 33</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann&apos;s area 33</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">Brodmann_area_33_surface_region</NEMO_annot:pref_label>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Brodmann_area_33_surface_region is a subdivision of the cytoarchitecturally defined cingulate region of cerebral cortex. It is a narrow band located in the anterior cingulate gyrus adjacent to the supracallosal gyrus in the depth of the callosal sulcus. Cytoarchitecturally it is bounded by the ventral anterior cingulate area 24 and the supracallosal gyrus (Brodmann-1909).</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">Brodmann_area_33_surface_region is a two_dimensional_region that is the location of SOME regional_part_of_cortical_surface</NEMO_annot:onto_definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Formerly NN-89 in NeuroNames</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-1370897127</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-994</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-997</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-999</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">NeuroNames concept ID NN-2423</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Umlscui C1272494</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 33 of Brodmann (human)</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 33 of Brodmann-1909</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">birnlex_1766</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://psychology.wikia.com/wiki/Brodmann_area_33</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">pregenual</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">pregenual area 33</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


