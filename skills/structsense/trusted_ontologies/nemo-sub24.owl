    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_2911000">
        <rdfs:label rdf:datatype="&xsd;string">false_font</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000409"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-11-18</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-07-02</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A false-font is a meaningless letter-like character, immediately preceded and followed by blank space.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_functional</NEMO_annot:namespace>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">a letter is a linguistic_object that has_quality visual and.... [incomplete]</NEMO_annot:onto_definition>
