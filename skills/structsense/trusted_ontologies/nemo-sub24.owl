        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2013-07-26</NEMO_annot:modified_date>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Has corresponding term in Bob Frank&apos;s NEMO_ERP_Metric_Extraction matlab script: Mean_Intensity_MCENT</NEMO_annot:comment>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">mean_intensity_MORB is a mean_intensity_measurement_datum 
  and (is_quality_measurement_of SOME intensity 
     and (inheres_in SOME scalp_recorded_ERP 
          and (unfolds_in SOME mid_frontocentral_scalp_surface_region)))</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">mean_intensity_MORB specifies the mean electrical potential, in microvolts, over all electrodes within the mid frontopolar scalp ROI.</NEMO_annot:definition>
