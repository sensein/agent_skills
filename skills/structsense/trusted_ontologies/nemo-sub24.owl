        <NEMO_annot:pref_label rdf:datatype="&xsd;string">central</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">central is a spatial_anatomical_quality that is disjoint with rostral and caudal.</NEMO_annot:onto_definition>
