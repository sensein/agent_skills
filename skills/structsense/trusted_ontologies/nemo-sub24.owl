    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4142000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4142000">
        <rdfs:label rdf:datatype="&xsd;string">mean_intensity_ROCC</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_9201000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;IAO_0000221"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="&PATO;PATO_0000049"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="&OBO_REL;inheres_in"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_8225000"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="&OBO_REL;unfolds_in"/>
                                                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000279"/>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-01</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-12-30</NEMO_annot:modified_date>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Has corresponding term in Bob Frank&apos;s NEMO_ERP_Metric_Extraction matlab script: Mean_Intensity_ROCC</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">mean_intensity_ROCC</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">mean_intensity_ROCC is a mean_intensity_measurement_datum 
  and (is_quality_measurement_of SOME intensity 
     and (inheres_in SOME scalp_recorded_ERP 
          and (unfolds_in SOME right_occipital_scalp_surface_region)))</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">mean_intensity_ROCC specifies the mean electrical potential, in microvolts, over all electrodes within the right occipital scalp ROI.</NEMO_annot:definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
