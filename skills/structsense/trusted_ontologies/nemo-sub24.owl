        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">temporal_segmentation_algorithm</NEMO_annot:pref_label>
        <NEMO_annot:definition rdf:datatype="&xsd;string">temporal_segmentation_algorithm is an algorithm for transforming continuous time series data into discrete intervals based on discontinuities in global field power or shifts in global field distribution (i.e., shifts in topography of a pattern).</NEMO_annot:definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">windowing</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
