        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_1687000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_1687000">
        <rdfs:label rdf:datatype="&xsd;string">finite_impulse_response_filter_algorithm</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_3603000"/>
        <NEMO_annot:definition rdf:datatype="&xsd;string">&quot;A finite impulse response (FIR) filter is a type of a digital filter. The impulse response, the filter&apos;s response to a Kronecker delta input, is finite because it settles to zero in a finite number of sample intervals. This is in contrast to infinite impulse response (IIR) filters, which have internal feedback and may continue to respond indefinitely. The impulse response of an Nth-order FIR filter lasts for N+1 samples, and then dies to zero.&quot; (http://en.wikipedia.org/wiki/Filter_%28signal_processing%29</NEMO_annot:definition>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-22</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-04-27</NEMO_annot:modified_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">finite_impulse_response_filter is a ... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">finite_impulse_response_filter_algorithm</NEMO_annot:pref_label>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Finite_impulse_response</NEMO_annot:definition_source>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_1693000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_1693000">
        <rdfs:label rdf:datatype="&xsd;string">stimulus_modality_label</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;IAO_0000009"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_9366000"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000443"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-01</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-05-24</NEMO_annot:modified_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Specifies the functional modality of the event stimulus employed to invoke a cortical response at the onset of each EEG event-related segment.</NEMO_annot:definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">stimulus_modality_label</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">stimulus_modality_label is_label_of some stimulus_modality</NEMO_annot:onto_definition>
