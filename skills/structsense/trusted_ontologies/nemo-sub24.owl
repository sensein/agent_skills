    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4252000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4252000">
        <rdfs:label rdf:datatype="&xsd;string">ERP_component_analysis_method_label</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_4512000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_9366000"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_5263000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-20</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-06-13</NEMO_annot:modified_date>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">ERP_component_analysis_method_label</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">ERP_component_analysis_method_label is a ... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Has corresponding term in Bob Frank&apos;s NEMO_ERP_Metric_Extraction matlab script: ERP_Component_Analysis_Method_Label</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">See also http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_5263000</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">is_label_of (ERP_component_analysis_method, electrophysiological_pattern_extraction_method)</NEMO_annot:comment>
        <NEMO_annot:definition rdf:datatype="&xsd;string">textDefinition: Specifies the label for the algorithm(s) employed for decomposing or segmenting multichannel spatiotemporal ERP data to reveal latent ERP components. Data decomposition techniques factor the data into latent pairs of spatial and temporal factors, termed observed components, one or more of which may correspond to ERP components of interest. Data decomposition techniques are typically guided by the patterns of covariance (PCA) or statistical independence (ICA) woven through the data, by the spatial (spatial PCA/ICA) or temporal (temporal PCA/ICA) dimension from which the covariance or independence is extracted, and by the degree of component retention (unrestricted or restricted). Data segmentation techniques, such as Microstate Analysis, window the data into temporally disjoint subintervals specified by periods of stable topography, which correspond to stable cortical generator configurations, and are typically quantified by positive and negative centroid location, global map dissimilarity or global field power.</NEMO_annot:definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4273000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4273000">
        <rdfs:label rdf:datatype="&xsd;string">voltage_amplifier_lowpass_filter_setting</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_1142000"/>
        <NEMO_annot:definition rdf:datatype="&xsd;string">&quot;In an RC circuit, the value of the time constant (in seconds) is equal to the product of the circuit resistance (in ohms) and the circuit capacitance  (in farads), i.e. τ = R × C. It is the time required to charge the capacitor, through the resistor, to 63.2 (≈ 63) percent of full charge; or to discharge it to 36.8 (≈ 37) percent of its initial voltage. These values are derived from the mathematical constant e, specifically 1 − e − 1 and e − 1 respectively.&quot; (http://en.wikipedia.org/wiki/RC_time_constant).</NEMO_annot:definition>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-04-22</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-22</NEMO_annot:created_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/RC_time_constant</NEMO_annot:definition_source>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">voltage_amplifier_lowpass_filter_setting</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">voltage_amplifier_lowpass_filter_setting is a ... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Chris_Bird"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


