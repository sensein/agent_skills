                                        <owl:someValuesFrom>
                                            <rdfs:Datatype>
                                                <owl:intersectionOf rdf:parseType="Collection">
                                                    <rdfs:Datatype>
                                                        <owl:onDatatype rdf:resource="&xsd;decimal"/>
                                                        <owl:withRestrictions rdf:parseType="Collection">
                                                            <rdf:Description>
                                                                <xsd:minInclusive rdf:datatype="&xsd;decimal">150</xsd:minInclusive>
                                                            </rdf:Description>
                                                        </owl:withRestrictions>
                                                    </rdfs:Datatype>
                                                    <rdfs:Datatype>
                                                        <owl:onDatatype rdf:resource="&xsd;decimal"/>
                                                        <owl:withRestrictions rdf:parseType="Collection">
                                                            <rdf:Description>
                                                                <xsd:maxInclusive rdf:datatype="&xsd;decimal">275</xsd:maxInclusive>
                                                            </rdf:Description>
                                                        </owl:withRestrictions>
                                                    </rdfs:Datatype>
                                                </owl:intersectionOf>
                                            </rdfs:Datatype>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-14</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-01-13</NEMO_annot:modified_date>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Holcomb, P. J., Ackerman, P. T., &amp; Dykman, R. A. (1986). Auditory event-related potentials in attention and reading disabled boys . International Journal of Psychophysiology, 3, 263–273.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">P2</NEMO_annot:synonym>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">The auditory_frontocentral_P200 is a scalp-recorded_ERP_extracted_pattern 

and has_proper_part SOME peak_latency_measurement_datum
       that has_numeric_value SOME decimal[&gt;=&quot;150&quot;, &lt;=&quot;275&quot;]

and has_proper_part SOME intensity_measurement_datum
       that has_numeric_value SOME decimal[&gt;=&quot;0.4&quot;]
       that is_quality_measurement_of SOME intensity
            that inheres_in SOME scalp_recorded_ERP
                that unfolds_in SOME frontocentral_scalp_surface_region

and proper_part_of SOME averaged_EEG_data_set
       that has_provenance_specification SOME event_type_label
            that has_character_string_value SOME &quot;stimulus_onset&quot;
       and has_provenance_specification SOME stimulus_type_label
            that has_character_string_value SOME &quot;object&quot;
       and has_provenance_specification SOME stimulus_modality_label
            that has_character_string_value SOME &quot;auditory&quot;</NEMO_annot:onto_definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">auditory P2</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">auditory P200</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">auditory_frontocentral_P200</NEMO_annot:pref_label>
        <NEMO_annot:definition rdf:datatype="&xsd;string">auditory_frontocentral_P200 is a scalp-recorded_ERP that is time-locked to an auditory_stimulus and has increased positive amplitude over parietal scalp ROI, about 150-275 ms after the onset of the stimulus.</NEMO_annot:definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">vertex positivity</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">vertex potential</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_3561000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_3561000">
        <rdfs:label rdf:datatype="&xsd;string">ITT_Nz_location</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_6911000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_0000035"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000237"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2011-08-31</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-11-05</NEMO_annot:modified_date>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:definition rdf:datatype="&xsd;string">International 10-10 channel Nz (ITT_Nz) is a standard location on the scalp surface that is located in the frontopolar_scalp_surface_region. It is just rostral to ITT_Fpz.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">nasion_location is an ITT_electrode_location that is rostral to Fpz.</NEMO_annot:onto_definition>
        <NEMO_annot:synonym>nasion</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_3572000 -->

