    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_2459000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_2459000">
        <rdfs:label rdf:datatype="&xsd;string">cingulate_cortex</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0339000"/>
        <NEMO_annot:comment rdf:datatype="&xsd;string">&quot;The only elements labelled &quot;cingulate cortex&quot; in neuronames related to mouse brain parcellations both from Swanson and from Paxinos. No &quot;cingulate cortex&quot; is listed for primates. There are the many cortical areas defined by Brodmann&apos;s parcellation scheme present in NeuroNames, and they are obviously the mans by which cortical parenchyma regions are accessed. (BB).&quot; (Neurolex Editorial Note)</NEMO_annot:comment>
        <NEMO_annot:definition rdf:datatype="&xsd;string">...[incomplete]</NEMO_annot:definition>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-10-09</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-12-15</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">C0598179</NEMO_annot:synonym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">birnlex_934</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">cingulate_cortex</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">cingulate_cortex is a two_dimensional_region that is the location of SOME regional_part_of_cortical_surface</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
