    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4534000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4534000">
        <rdfs:label rdf:datatype="&xsd;string">gaussian</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7237000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-25</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-07-02</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Gaussian functions (probability density functions) that have characteristic symmetric &quot;bell curve&quot; shape that quickly falls off towards plus/minus infinity. Gaussian functions are widely used to describe the normal distribution, a continuous probability distribution that is often used as a first approximation to describe real-valued random variables that tend to cluster around a mean value.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">gaussian</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">gaussian is a shape_data_distribution that inheres_in some data_set.</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


