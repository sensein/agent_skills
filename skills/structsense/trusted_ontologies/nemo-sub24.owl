    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_9734000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_9734000">
        <rdfs:label rdf:datatype="&xsd;string">sampling_rate</rdfs:label>
        <rdfs:subClassOf rdf:resource="&PATO;PATO_0000161"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-22</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-12</NEMO_annot:modified_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Sampling rate is the frequency or rate at which an analog signal is sampled (i.e., digitized). It is expressed as number of samples or cycles,  per unit of time (e.g., 250 hz = 250 cycles per second) or space (e.g., pixels or other spatial units).</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">See also Nyquist theorem, sampling density.</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Submitted to NIF in November 2010.</NEMO_annot:comment>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Weik, M. (2000). Computer science and communications dictionary (1st ed., Vols. 1-2). Boston: Kluwer Academic Pub.</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">sampling_frequency</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">sampling_rate</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">sampling_rate is a rate that... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Anita_Bandrowski"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Chris_Bird"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Usman_Khan"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_9738000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_9738000">
        <rdfs:label rdf:datatype="&xsd;string">human_vocal_sound</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000411"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-30</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-04-01</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A human_vocal_sound is a vocal sound that is produced by vibration of vocal cords (vocal folds) of the human larynx and is modified by the resonance chambers of the human vocal tract. Human vocal sounds include linguistic utterances (i.e., speech) and both voluntary and involuntary nonspeech sounds (e.g., singing, laughing, screaming, humming).</NEMO_annot:definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">CRISP Thesaurus 1578-9012</NEMO_annot:synonym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_functional</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">The vocal folds (vocal cords) constitute a vibrating valve that chops up the airflow from the lungs into audible pulses that form the laryngeal sound source.</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">UMLS CUI C0037833</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">UMLS CUI C0037834</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">UMLS CUI C0042939</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Human_voice</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/CSP/1578-9012</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://www.cogpo.org/ontologies/Nonverbal Vocal Sounds</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://www.cogpo.org/ontologies/Nonverbal Vocal Sounds</NEMO_annot:synonym>
