    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_1479000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_1479000">
        <rdfs:label rdf:datatype="&xsd;string">cell_comparison_condition_label</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000536"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-20</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-08-07</NEMO_annot:modified_date>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Has corresponding term in Bob Frank&apos;s NEMO_ERP_Metric_Extraction matlab script: Cell_Comparison_Condition_Label</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Represents &quot;comparison condition&quot;, and specifies the experimental condition under which the respective ERP data were obtained. It stands in contrast to the &quot;standard condition&quot;: a distinct experimental condition under which a seperate set of ERP data were obtained for the purpose of contrasting ERP components induced under two distinct experimental conditions.</NEMO_annot:definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">cell_comparison_condition_label</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">cell_comparison_condition_label is label_of cell_comparison_condition</NEMO_annot:onto_definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">label_of (cell_comparison_condition_label, cell_comparison_condition)</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


