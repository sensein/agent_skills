    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4680000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4680000">
        <rdfs:label rdf:datatype="&xsd;string">mean_intensity_LOTEMP_EXT</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_9201000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;IAO_0000221"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="&PATO;PATO_0000049"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="&OBO_REL;inheres_in"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_8225000"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="&OBO_REL;unfolds_in"/>
                                                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_6160000"/>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-01</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-06-18</NEMO_annot:modified_date>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Has corresponding term in Bob Frank&apos;s NEMO_ERP_Metric_Extraction matlab script: Mean_Intensity_LOTEMP_Ext</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition rdf:datatype="&xsd;string">mean_intensity_LOTEMP_EXT specifies the mean electrical potential, in microvolts, over all electrodes within the left inferior occipital scalp ROI.</NEMO_annot:definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4682000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4682000">
        <rdfs:label rdf:datatype="&xsd;string">left_inferior_frontotemporal_scalp_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000005"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;location_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_5962000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_5003000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-06-06</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-06-18</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A left_inferior_frontotemporal_scalp_surface_region is a region of the scalp surface that is inferior to some left_frontotemporal_scalp_surface_region.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A left_inferior_frontotemporal_scalp_surface_region is a scalp_surface_region that is the exact location_of some  left_inferior_frontotemporal_scalp_surface.</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">only measured in high-density EEG recording systems with coverage inferior to the canthal-meadal line (e.g., systems with 128 or more electrodes)</NEMO_annot:comment>
        <NEMO_annot:comment>See also definition of &quot;rostral&quot; (NEMO_0000189) and &quot;inferior&quot; (NEMO_0000193) and &quot;left temporal&quot; (NEMO_8302000). The &lt;left_inferior_frontaltemporal_scalp_surface region&gt; has_quality &lt;rostral&gt; and has_quality &lt;left temporal&gt; and has_quality &lt;inferior&gt;.</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4690000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4690000">
        <rdfs:label rdf:datatype="&xsd;string">segmented_EEG_data_set</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_2662000"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;OBI_0000293"/>
                        <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000494"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;OBI_0000312"/>
                        <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000513"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2009-06-09</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-12-29</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A segmented EEG data set is a type of data set that characterizes single-trial evoked (aka event-related) potentials (ERPs) and is the result of segmenting continuous EEG data, time-locking to an event of interest.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A segmented_EEG_data_set is an electrophysiological_data_set that is_about some electrophysiological_activity. It is_specified_output_of some data_segmentation process that has_specified_input some continuous_EEG_data_set</NEMO_annot:onto_definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">segmented_EEG_data_set</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


