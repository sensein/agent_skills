        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-12-13</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-12-13</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A word_repetition_paradigm is an experimental_paradigm in which an auditory word (or word-like sound sequence) is presented, and the participant is asked to repeat (say) the word, typically out loud.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_functional</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">pronunciation</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">reading aloud</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">stimulus modality = auditory
stimulus type = word</NEMO_annot:comment>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">word_repetition_paradigm</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">word_repetition_paradigm is an experimental_paradigm that ...[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


