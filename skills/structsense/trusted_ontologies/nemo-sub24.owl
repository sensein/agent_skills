        <NEMO_annot:definition rdf:datatype="&xsd;string">A co-investigator is a responsible party role played by a person who is not the principal investigator but who shares responsibility for the overall conduct of a study.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_functional</NEMO_annot:namespace>
