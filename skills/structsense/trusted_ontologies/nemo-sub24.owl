        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-11-12</NEMO_annot:created_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">AOD_ 0000007630</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Also see electroencephalogram, electroencephalographic_activity (NEMO_1000195), and evoked_brain_potential (NEMO_4990000).</NEMO_annot:comment>
        <NEMO_annot:definition rdf:datatype="&xsd;string">An evoked potential (or EP) is a pattern of electrical activity that is recorded from a nerve, muscle, sensory receptor, or other area of the central nervous system, typically following stimulation. More generally, an EP is a pattern of bio-electric activity that is time-locked to an observable event (e.g., onset of a stimulus or response, or peak of the QRS wave). </NEMO_annot:definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">EP</NEMO_annot:synonym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">EP</NEMO_annot:acronym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">EP
evoked_potentials
AOD_ 0000007630,
SNOMEDCT_386205007
NCI_C0015214
MSH_D005071
[[UK -- SNOMEDCT = Systematized Nomenclature of Medicine – Clinical Terms
NCI = National Cancer Institute Metathesaurus
MSH = Medical Subject Headings
AOD = Alcohol and Other Drug Thesaurus]]</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">MSH_D005071</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NCI_C0015214</NEMO_annot:synonym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">SNOMEDCT_386205007</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Submitted to NIF in November 2010.</NEMO_annot:comment>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">electrical_dipole_potential is a electrical_potential that...[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">evoked_brain_potential</NEMO_annot:pref_label>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">evoked_potentials</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://ncimeta.nci.nih.gov/ncimbrowser/ConceptReport.jsp?dictionary=NCI%20MetaThesaurus&amp;code=C0015214</NEMO_annot:definition_source>
