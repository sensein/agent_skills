            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-06-18</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2013-10-02</NEMO_annot:modified_date>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Has corresponding term in Bob Frank&apos;s NEMO_ERP_Metric_Extraction matlab script: Mean_Intensity_LCENT</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">mean_intensity_LCENT is a mean_intensity_measurement_datum 
  and (is_quality_measurement_of SOME intensity 
     and (inheres_in SOME scalp_recorded_ERP 
          and (unfolds_in SOME left_central_scalp_surface_region)))</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">mean_intensity_LCENT specifies the mean electrical potential, in microvolts, over all electrodes within the left central scalp ROI.</NEMO_annot:definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_6977000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_6977000">
        <rdfs:label rdf:datatype="&xsd;string">membrane_potential_threshold</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;IAO_0000001"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-10-09</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-10-09</NEMO_annot:modified_date>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A membrane_potential_threshold is a... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A membrane_potential_threshold is the critical level of a membrane potential that, if exceeded by the onset of a sufficient depolarizing current, will result in the triggering of a all-or-none action potential. </NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Koester, J. (1991).  Membrane potential. In E.R. Kandel, J.H. Schwartz, &amp; T.M. Jessell (Eds.), Principles of neural science (3rd ed.), (pp.82-83). New York: Elsevier.</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NCI C0449864</NEMO_annot:synonym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">PATO_0000152</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">SNOMEDCT 246510005 </NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">membrane_potential_threshold</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Anita_Bandrowski"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Usman_Khan"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_6984000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_6984000">
        <rdfs:label rdf:datatype="&xsd;string">Brodmann_area_39_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7920000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-22</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-01-14</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Area angularis</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">B09-39</NEMO_annot:synonym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">B09-39</NEMO_annot:acronym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">BA39</NEMO_annot:acronym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann (1909) area 39</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann area 39</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">Brodmann_area_39_surface_region</NEMO_annot:pref_label>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Brodmann_area_39_surface_region corresponds to the angular gyrus surrounding the caudal tip of the superior temporal sulcus. Dorsally it is bounded approximately by the intraparietal sulcus. Cytoarchitecturally it is bounded rostrally by the supramarginal area 40 (H), dorsally and caudally by the peristriate area 19, and ventrally by the occipitotemporal area 37 (H) (Brodmann-1909).</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">Brodmann_area_39_surface_region is a two_dimensional_region that is the location of SOME regional_part_of_cortical_surface</NEMO_annot:onto_definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Formerly NN-69 in NeuroNames</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-2006561779</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-914</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">NeuroNames concept ID NN-2409</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Umlscui C1272500</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">angular</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">angular area 39</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 39 of Brodmann</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 39 of Brodmann-1909</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">birnlex_1772</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://psychology.wikia.com/wiki/Brodmann_area_39</NEMO_annot:definition_source>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_6994000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_6994000">
        <rdfs:label rdf:datatype="&xsd;string">std_dev_intensity_LPTEMP_EXT</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_2049000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-06-13</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-08-22</NEMO_annot:modified_date>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Has corresponding term in Bob Frank&apos;s NEMO_ERP_Metric_Extraction matlab script: Std_Dev_LPTEMP_Ext</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">std_dev_intensity_LPTEMP_EXT</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">std_dev_intensity_LPTEMP_EXT is a ... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">std_dev_intensity_LPTEMP_EXT specifies the standard deviation in electrical potential over all electrodes within the extended left posterotemporal scalp ROI.</NEMO_annot:definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_7006000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_7006000">
        <rdfs:label rdf:datatype="&xsd;string">global_field_power</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_4123000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-08</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">GFP</NEMO_annot:acronym>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Global Field Power (GFP) is a measure of EEG/MEG response strength over time. It is computed as the standard deviation (or, more precisely, the root-mean-square) of the potentials over all electrodes at a given time. </NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Lehmann, D. and Skrandies, W. (1980) Reference-free identification of components of checkerboard-evoked multichannel potential fields. Electroencephalography and Clinical Neurophysiology, vol. 48 pp. 609-621.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">global_field_power</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">global_field_power is a descriptive_statistic that is_about SOME electrophysiological_data_set</NEMO_annot:onto_definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">global_field_strength</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


