        <NEMO_annot:comment rdf:datatype="&xsd;string">domain =processual entity; range = temporal entity</NEMO_annot:comment>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">occurs_throughout</NEMO_annot:pref_label>
        <NEMO_annot:definition rdf:datatype="&xsd;string">occurs_throughout is the processual equivalent of located_in, where where the subject is an extended process or a punctate event), and the predicate specifies a time interval (similar to an extended spatial_region). Implies that processual entity is present throughout interval.</NEMO_annot:definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Usman_Khan"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:ObjectProperty>
    


