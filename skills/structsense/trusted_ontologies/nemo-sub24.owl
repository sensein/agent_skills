    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4705000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4705000">
        <rdfs:label rdf:datatype="&xsd;string">spherical_head_model</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_1656000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2009-06-06</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-26</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A spherical head model  is a computational model that describes the propagation of electrical fields through a medium with a particular set of material properties. This model represents the human head as a spherical object composed of two (or more) nested concentric spheres (aka &quot;surfaces&quot;), e.g., representing human brain, skull and scalp. Each sphere is assigned its own thickness and conductivity value; however, these values are assumed to be homogenous and isotropic within each surface.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A spherical_head_model is_a head_model...</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Cuffin, B., N. (1990) Effect of head shape on EEG&apos;s and MEG&apos;s. IEEE Transactions on Biomedical Engineering, Vol. 37. No. 1, January 1990.</NEMO_annot:definition_source>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Mosher, C. J., Leahy, R. M., Lewis, P. S.(1999) EEG and MEG: Forward solutions for inverse methods. IEEE Transactions on Biomedical Engineering, Vol. 46. No. 3, March 1999.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">spherical_head_model</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


