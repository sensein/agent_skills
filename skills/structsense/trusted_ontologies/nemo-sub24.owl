    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_5062000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_5062000">
        <rdfs:label rdf:datatype="&xsd;string">action_potential_overshoot</rdfs:label>
