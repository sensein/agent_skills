    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_8849000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_8849000">
        <rdfs:label rdf:datatype="&xsd;string">event_window</rdfs:label>
        <rdfs:subClassOf rdf:resource="&span;TemporalInterval"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000320"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-06-27</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-07-26</NEMO_annot:modified_date>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">An event_window is a temporal_interval that is the proper_part_of some event_related_temporal_interval, and some event onset occurs_within this event_related_duration.</NEMO_annot:onto_definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Defined as event_offset minus event_onset. Implication is that event of interest (e.g., P100 pattern) was present throughout this interval. Whereas event_related_temporal_interval refers to a window of time during which an event occurred. A particular event_onset_latency falls within some event_related_temporal_interval, but this does not imply that the event (e.g., ERP activity) was present throughout the interval.</NEMO_annot:comment>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Event_window is the temporal interval during which a process or event occurs. Measurement of event_window is with respect to measures of event_onset_latency and event_offset_latency.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_temporal</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">duration</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">event_related_duration</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">event_window</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_8854000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_8854000">
        <rdfs:label rdf:datatype="&xsd;string">delta_wave_activity</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_2392000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-26</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-08-07</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">C0011227</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">D003700</NEMO_annot:synonym>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Delta wave activity is an oscillation in brain electrical (EEG) activity in the frequency range of 1-4 Hz.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">MSH Definition: One of the four types of brain waves seen on EEG characterized by a high amplitude and a frequency of 4 Hz and below. They are considered the &quot;deep sleep waves&quot; observed during sleep in dreamless states, infancy, and in some brain disorders.</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Neurolex def: is a high amplitude brain wave with a frequency of 1–4 hertz which can be recorded with an electroencephalogram (EEG) and is usually associated with slow-wave sleep. Delta wave activity occurs most frequently during stage N3 slow-wave sleep, accounting for 20% or more of the EEG record during this stage. These waves are believed to originate in the thalamus in coordination with the reticular formation (adapted from Wikipedia). </NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">delta oscillation</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">delta rhythm</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">delta wave</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">delta_wave_activity</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">delta_wave_activity is a kind of oscillatory_brain_electrical_activity that...[incomple</NEMO_annot:onto_definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://ncim-stage.nci.nih.gov/ncimbrowser/ConceptReport.jsp?dictionary=NCI%20MetaThesaurus&amp;code=C0011227  </NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_8859000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_8859000">
        <rdfs:label rdf:datatype="&xsd;string">neural_synchronization</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_5798000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;has_participant"/>
