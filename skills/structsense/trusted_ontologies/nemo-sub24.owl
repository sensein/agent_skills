        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_5252000"/>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-08-01</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-08-01</NEMO_annot:created_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_functional</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">modal_age_study_subjects_retained_for_analysis</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">modal_age_study_subjects_retained_for_analysis is a group_age that...[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">modal_age_study_subjects_retained_for_analysis is a quality that indicates the modal age of all subjects who participated in a study or study group and were retained for analysis</NEMO_annot:definition>
