    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_6826000">
        <rdfs:label rdf:datatype="&xsd;string">mat_data_format</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_1194000"/>
        <NEMO_annot:definition rdf:datatype="&xsd;string">.mat is a data format created and used by MATLAB software toolkit and that is basically a container of data stored in binary form. Stored data may include arrays, variables, functions, and other types of data; can be saved in different formats by choosing a version within the MATLAB Preferences. </NEMO_annot:definition>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-25</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-07-02</NEMO_annot:modified_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://maxwell.me.gu.edu.au/spl/matlab-page/matfile_format.pdf</NEMO_annot:definition_source>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://www.fileinfo.com/extension/mat</NEMO_annot:definition_source>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">mat_data_format</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">mat_data_format is a quality that inheres_in some data_item and is the concretization of some mat_data_format_specification.</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


