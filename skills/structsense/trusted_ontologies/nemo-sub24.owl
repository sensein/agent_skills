        <NEMO_annot:definition rdf:datatype="&xsd;string">An unnamed_positive_RPTEMP_effect  is a positivity that is significant over the right posterotemporal region of the scalp.</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
