    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_9634000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_9634000">
        <rdfs:label rdf:datatype="&xsd;string">infinite_impulse_response_filter_algorithm</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_3603000"/>
        <NEMO_annot:definition rdf:datatype="&xsd;string">&quot;Infinite impulse response (IIR) is a property of signal processing systems. Systems with this property are known as IIR systems or, when dealing with filter systems, as IIR filters. IIR systems have an impulse response function that is non-zero over an infinite length of time. This is in contrast to finite impulse response filters (FIR), which have fixed-duration impulse responses. The simplest analog IIR filter is an RC filter made up of a single resistor  (R) feeding into a node shared with a single capacitor  (C). This filter has an exponential impulse response characterized by an RC time constant.&quot; (http://en.wikipedia.org/wiki/Infinite_impulse_response).</NEMO_annot:definition>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-22</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-04-27</NEMO_annot:modified_date>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">An infinite_impulse_response_filter is a filter_algorithm that... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Infinite_impulse_response</NEMO_annot:definition_source>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">infinite_impulse_response_filter_algorithm</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Chris_Bird"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_9643000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_9643000">
