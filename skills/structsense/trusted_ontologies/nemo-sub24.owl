        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">Neural_summation is a biological process... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">SNOMEDCT 85098000</NEMO_annot:synonym>
