    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4618000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4618000">
        <rdfs:label rdf:datatype="&xsd;string">Brodmann_area_48_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7920000"/>
