        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-07-23</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A process or event occurs in response to some other process or event. </NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:comment rdf:datatype="&xsd;string">In NEMO, the subjects is typically an event_related_potential (ERP) pattern or component,  and the object is an ERP event (e.g., stimulus_onset or response_onset).</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_relations</NEMO_annot:namespace>
