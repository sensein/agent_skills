        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_3591000"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000376"/>
