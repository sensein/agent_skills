        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_ERP</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">National Cancer Institute Metathesaurus ID C0027880</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">SNOMEDCT 417641001</NEMO_annot:synonym>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Synaptic plasticity is an increase or decrease of synaptic strength, for short or long periods, following activity.  Thought to be critically involved in learning.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">Synaptic_plasticity is a disposition that inheres_in some....</NEMO_annot:onto_definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Systematized Nomenclature of Medicine – Clinical Terms ID 417641001</NEMO_annot:comment>
