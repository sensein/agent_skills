        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_5571000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_5571000">
        <rdfs:label rdf:datatype="&xsd;string">wavelet_algorithm</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000480"/>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-04-25</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-25</NEMO_annot:created_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A wavelet_algorithm is an algorithm that aims to represent a time-varying signal as a combination of wavelets, which are wave-like oscillations with an amplitude that starts out at zero, increases, and then decreases back to zero (i.e., it is localized in time). Wavelet analysis methods are an extension and refinement of joint_time_frequency_decomposition methods.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A wavelet_algorithm is an algorithm that is realized through implementation of (code)....</NEMO_annot:onto_definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Wavelet</NEMO_annot:definition_source>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">wavelet_algorithm</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_5580000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_5580000">
        <rdfs:label xml:lang="en">feedback_stimulus</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000468"/>
