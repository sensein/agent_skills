    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0595000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0595000">
        <rdfs:label rdf:datatype="&xsd;string">CON_zCoord_3D</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_9503000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-01</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-06-13</NEMO_annot:modified_date>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">CON_zCoord_3D</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">CON_zCoord_3D is a ... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Has corresponding term in Bob Frank&apos;s NEMO_ERP_Metric_Extraction matlab script: CON_zCoord_3D</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Specifies for each spatiotemporal component pair the z-coordinate, in arbitrary units, of its center of electrical negativity (CON) in 3-D space. It is based upon the distribution of negative electrical potential at montage-specific, scalp-surface electrode locations that are part of a reference scalp-surface region. The center of negativity (CON) is the point in 3-D space at which all negative electrical potential at the scalp-surface electrodes can be equivalently located. Computationally, it is analogous to a center of mass calculation with electrode potentials replaced by point masses. Note that CON_zCoord_3D is part of the head region, not the scalp-surface region, and does not index a scalp-surface region of interest.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">is_about (a point along an axis in three_dimensional_spatial_region); is_about (CON_1D); proper_part_of (CON_3D_coordinate_datum); has_coordinate_unit_label (??)</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0596000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0596000">
        <rdfs:label xml:lang="en">left_occipitotemporal_scalp_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000007"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_5003000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;location_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0236000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-06-18</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2013-10-14</NEMO_annot:modified_date>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A left_inferior_occipitotemporal_scalp_surface_region is a scalp_surface_region that is the exact location_of some  left_occipitotemporal_scalp_surface.</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A left_occipitotemporal_scalp_surface_region is a region of the scalp surface that is left of some left_occipital_scalp_surface_region.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:comment>See also definition of &quot;occipital&quot; (NEMO_3632000) and &quot;left temporal&quot; (NEMO_8302000). The &lt;left_occipitotemporal_scalp_surface region&gt; has_quality &lt;occipital&gt; and has_quality &lt;left temporal&gt;.</NEMO_annot:comment>
        <NEMO_annot:synonym>LOTEMP</NEMO_annot:synonym>
        <rdfs:comment>In the NEMO toolkit, the left_occipitotemporal_scalp_surface_region includes the following international 10-10 channels: PO7 and PO9.</rdfs:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0603000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0603000">
        <rdfs:label xml:lang="en">mean_intensity_MPAR</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_9201000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;IAO_0000221"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="&PATO;PATO_0000049"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="&OBO_REL;inheres_in"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_8225000"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="&OBO_REL;unfolds_in"/>
                                                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000022"/>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-05-20</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-05-20</NEMO_annot:modified_date>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Has corresponding term in Bob Frank&apos;s NEMO_ERP_Metric_Extraction matlab script: Mean_Intensity_MPAR</NEMO_annot:comment>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">mean_intensity_MPAR is a mean_intensity_measurement_datum 
  and (is_quality_measurement_of SOME intensity 
     and (inheres_in SOME scalp_recorded_ERP 
          and (unfolds_in SOME mid_parietal_scalp_surface_region)))</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">mean_intensity_MPAR specifies the mean electrical potential, in microvolts, over all electrodes within the mid parietal scalp ROI.</NEMO_annot:definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0606000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0606000">
        <rdfs:label rdf:datatype="&xsd;string">electrostatic_field</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_1000000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-26</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-07-07</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">An electric field is a spatial quality that inheres in an electrically charged particle (or multiple charged particles).</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">electrostatic_field is a materilal_entity_quality that...[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">electrosttic_field</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0615000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0615000">
        <rdfs:label xml:lang="en">weakly_negatively_aroused</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7709000"/>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-07-23</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-07-23</NEMO_annot:created_date>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Weakly_negatively_aroused is a quality that momentarily inheres in some brain or brain part and that constitutes a &quot;snapshot&quot; in time of certain types of emotional process (e.g., relaxation).</NEMO_annot:definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0616000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0616000">
        <rdfs:label xml:lang="en">left_mastoid_bone_surface</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_6118000"/>
