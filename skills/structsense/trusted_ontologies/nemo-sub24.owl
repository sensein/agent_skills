        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 42 of Brodmann-1909</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">auditory association area</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">birnlex_1775</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://psychology.wikia.com/wiki/Brodmann_area_41</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">posterior transverse temporal</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">posterior transverse temporal area 42</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
