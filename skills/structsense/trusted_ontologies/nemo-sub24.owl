        <NEMO_annot:definition_source rdf:datatype="&xsd;string">...[incomplete]</NEMO_annot:definition_source>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-20</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-01-13</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">CNV</NEMO_annot:synonym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">CNV</NEMO_annot:acronym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:definition rdf:datatype="&xsd;string">The contingent_negative_variation is a scalp-recorded ERP that is time-locked to a XXXXX and has increased XXXX amplitude over XXXXX scalp ROI between about XXXX ms after the onset of the response. ????</NEMO_annot:definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">contingent_negative_variation</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">contingent_negativity_variation is a scalp-recorded_ERP_extracted_pattern 

and has_proper_part SOME peak_latency_measurement_datum
       that has_numeric_value SOME decimal[&gt;=&quot;-500&quot;, &lt;=&quot;-50&quot;]

and has_proper_part SOME intensity_measurement_datum
       that has_numeric_value SOME decimal[&lt;=&quot;-0.4&quot;]
       that is_quality_measurement_of SOME intensity
            that inheres_in SOME scalp_recorded_ERP
                that unfolds_in SOME frontocentral_scalp_surface_region

and proper_part_of SOME averaged_EEG_data_set
       that has_provenance_specification SOME event_type_label
            that has_character_string_value SOME &quot;stimulus_onset&quot;
       and has_provenance_specification SOME stimulus_type_label
            that has_character_string_value SOME &quot;object&quot;</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_1823000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_1823000">
        <rdfs:label xml:lang="en">sensory_division_of_peripheral_nervous_system</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0559000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000174"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-06-30</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-06-30</NEMO_annot:modified_date>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Sensory systems are responsible for registering changes in the visceral (internal bodily) and somatic (external bodily) systems. Somatic sense receptors include chemical, mechanical, photo (light),  thermal (heat), and nocio (pain) receptors in the eyes, ears, nose, and skin. Visceral sense receptors register changes in bloodflow, cardiac, gastrointenstinal, respiratory and reproductive systems. They conduct signals to other parts of the autonomic system that are responsible for control of visceral and somatic muscles (i.e., motor output).</NEMO_annot:definition>
        <NEMO_annot:synonym>afferent division of peripheral nervous system</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


