        <NEMO_annot:definition rdf:datatype="&xsd;string">A right_central_scalp_surface is a part of the scalp surface that is approximately centered about ITT electrode FC1/FC3.</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
