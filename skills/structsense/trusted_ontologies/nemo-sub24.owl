        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_3261000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A network_address is a binary representation of a unique numeric identifier (e.g. 208.77.188.166 or 2001:db8:0:1234:0567) assigned to a communication device connected to the Internet (e.g. server, router, switch etc.), used for network host interface identification and location addressing.  </NEMO_annot:definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">IP address</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">Internet Protocol address</NEMO_annot:pref_label>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/IP_address</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#Network_Address</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">internet address</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">network_address</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">network_address is an information_artifact_entity that is_about SOME spatial_region</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
