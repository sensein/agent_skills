    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4948000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4948000">
        <rdfs:label xml:lang="en">t_statistic</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7981000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2011-11-22</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-03-02</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A t_statistic is used to determine whether two samples are likely to be drawn from two different populations. It is calculated as the ratio of deviation of an estimated parameter from its notional value divided by standard error. </NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/T-statistic</NEMO_annot:definition_source>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">inferential_statistic is a data_item that is_about SOME data_set</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4954000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4954000">
        <rdfs:label>group_behavioral_quality</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_5336000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2011-05-29</NEMO_annot:created_date>
