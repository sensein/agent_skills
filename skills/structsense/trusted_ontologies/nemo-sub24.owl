        <NEMO_annot:definition_source rdf:datatype="&xsd;string">The neural correlates of intentional learning of verbal materials: A PET study in humans. Kapur S, Tulving E, Cabeza R, McIntosh A R, Houle S, Craik F I M. J Cogn Neurosci 1996 Nov; 4:243-249; PMID = 8957565.</NEMO_annot:definition_source>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">encode</NEMO_annot:pref_label>
