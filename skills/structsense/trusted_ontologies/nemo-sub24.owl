        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_imported_classes</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Not sure whether this properly contains the class |label| or not</NEMO_annot:comment>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://purl.obolibrary.org/obo/IAO_0000028</NEMO_annot:definition_source>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">symbol</NEMO_annot:pref_label>
