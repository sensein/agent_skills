    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_3323000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_3323000">
        <rdfs:label rdf:datatype="&xsd;string">supergaussian</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7237000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-25</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-07-02</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A supergaussian shape is &quot;peaked&quot; around the mean. This means there is a lower probability than a normally distributed variable of values near the mean and that the probability distribution function has flatter tails (that is, a higher probability of extreme values).</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">shape_data_distribution  is a quality that inheres_in some data_set.</NEMO_annot:onto_definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">supergaussian</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


