    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4655000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4655000">
        <rdfs:label rdf:datatype="&xsd;string">mean</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_8955000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-05</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Field, Andy. (2009) Discovering Statistics Using SPSS (Introducing Statistical Methods) 3rd Ed. Sage Publications, Ltd. London, UK.</NEMO_annot:definition_source>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">Mean is a descriptive_statistic that is_about SOME data_set</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Mean is the arithmetic average of a set of data points. It is a simple statistical model of the center of a data distribution.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">NCI Thesaurus ID C53319</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
