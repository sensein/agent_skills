        <NEMO_annot:synonym rdf:datatype="&xsd;string">Umls CUI C0441469</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://dictionary.reference.com/browse/pictures</NEMO_annot:definition_source>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#Picture</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://www.cogpo.org/ontologies/COGPO_00172</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://www.thefreedictionary.com/picture</NEMO_annot:definition_source>
