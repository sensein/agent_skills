        <NEMO_annot:comment rdf:datatype="&xsd;string">NanoParticle Ontology ID NPO_1800</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">SNOMED CT ID 255586005</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">average</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#Statistical_Mean</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/SNOMEDCT/255586005</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.obolibrary.org/obo/OBI_0000679</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.org/OCRe/statistics.owl#Mean</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">mean</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


