    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_1730000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_1730000">
        <rdfs:label xml:lang="en">disposition_to_positive_arousal</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_2060000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-07-23</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-07-23</NEMO_annot:modified_date>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:definition rdf:datatype="&xsd;string">disposition_to_positive_arousal is a disposition that inheres in some brain or brain part and gives rise to positively valenced states and processes (e.g., pleasure, elation).</NEMO_annot:definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
