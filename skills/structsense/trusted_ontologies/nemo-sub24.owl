    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_5708000">
        <rdfs:label rdf:datatype="&xsd;string">pinkie_finger</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7214000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_2386000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2011-01-15</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-01-15</NEMO_annot:modified_date>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A pinkie finger is a finger... [incomplete].</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:definition rdf:datatype="&xsd;string">The pinkie finger is the fifth digit of the human hand. When a person is standing in the medical anatomical position (where the palm is stretched forward), the pinkie finger is the most medial digit (closest to the center of the body (modified from http://en.wikipedia.org/wiki/Thumb).</NEMO_annot:definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">pinkie_finger</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


