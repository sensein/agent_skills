    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_2300000 -->

    <owl:ObjectProperty rdf:about="&ontology;NEMO.owl#NEMO_2300000">
        <rdfs:label rdf:datatype="&xsd;string">superior_to</rdfs:label>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-05</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-05-16</NEMO_annot:modified_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_relations</NEMO_annot:namespace>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Object A is superior to object B just in case object A is located closer to the top of the head (vertex) and object B is located closer to the neck.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Spatial relations in NEMO refer to objects located on, in, or near the head. They may not generalize to spatial relations among other objects.</NEMO_annot:comment>
        <NEMO_annot:example rdf:datatype="&xsd;string">The eyes are superior_to the nose.</NEMO_annot:example>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">superior_to</NEMO_annot:pref_label>
        <NEMO_annot:comment rdf:datatype="&xsd;string">superior_to is the inverse_to inferior_to.</NEMO_annot:comment>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">www.upstate.edu/cdb/grossanat/glossary.shtml</NEMO_annot:definition_source>
        <owl:inverseOf rdf:resource="&ontology;NEMO.owl#NEMO_2400001"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_2317000 -->

    <owl:ObjectProperty rdf:about="&ontology;NEMO.owl#NEMO_2317000">
        <rdfs:label rdf:datatype="&xsd;string">occurs_at</rdfs:label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">..[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-07-23</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-23</NEMO_annot:created_date>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_relations</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">domain = process boundary; range = temporal instant</NEMO_annot:comment>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">occurs_at</NEMO_annot:pref_label>
        <NEMO_annot:definition rdf:datatype="&xsd;string">occurs_at is the processual equivalent of located_in, where the subject is a punctate event (e.g., onset or offset of a process), then the predicate specifies single time point (similar to a point in space).</NEMO_annot:definition>
        <owl:inverseOf rdf:resource="&ontology;NEMO.owl#NEMO_3591000"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_2400001 -->

    <owl:ObjectProperty rdf:about="&ontology;NEMO.owl#NEMO_2400001">
        <rdfs:label rdf:datatype="&xsd;string">inferior_to</rdfs:label>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-05</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-05-16</NEMO_annot:modified_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_relations</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Spatial relations in NEMO refer to objects located on, in, or near the head. They may not generalize to spatial relations among other objects.</NEMO_annot:comment>
        <NEMO_annot:example rdf:datatype="&xsd;string">The nose is inferior to the eyes.</NEMO_annot:example>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">inferior_to</NEMO_annot:pref_label>
        <NEMO_annot:comment rdf:datatype="&xsd;string">inferior_to is the inverse to superior_to.</NEMO_annot:comment>
        <NEMO_annot:definition rdf:datatype="&xsd;string">textDefinition: Object A is inferior to object B just in case object A is located closer to the neck and object B is located closer to the top of the head.</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">www.upstate.edu/cdb/grossanat/glossary.shtml</NEMO_annot:definition_source>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_2442000 -->

