    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_1893000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_1893000">
        <rdfs:label rdf:datatype="&xsd;string">beta_wave_activity</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_2392000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-26</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-08-07</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Beta wave activity is an oscillation in brain electrical (EEG) activity in the frequency range of 12-25 Hz. Beta waves can be divided into three subclasses: High Beta Waves (19Hz+); Beta Waves (15-18Hz); and Low Beta Waves (12-15Hz).</NEMO_annot:definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">C0005167</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">D001611</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">MSH Definition: Brain waves with frequency greater than 13 Hz seen on EEG during wakefulness.</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Neurolex def: is the term used to designate the frequency range of brain activity between 12 and 30 Hz (12 to 30 transitions or cycles per second). Beta waves are split into three sections: High Beta Waves (19Hz+); Beta Waves (15-18Hz); and Low Beta Waves (12-15Hz). Beta states are the states associated with normal waking consciousness (adapted from Wikipedia). </NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">beta oscillation</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">beta rhythm</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">beta wave</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">beta_wave_activity</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">beta_wave_activity is a type of oscillatory_brain_electrical_activity that...[incomplete] </NEMO_annot:onto_definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://ncim-stage.nci.nih.gov/ncimbrowser/ConceptReport.jsp?dictionary=NCI%20MetaThesaurus&amp;code=C0005167</NEMO_annot:synonym>
