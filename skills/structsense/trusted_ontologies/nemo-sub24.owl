    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_3483000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_3483000">
        <rdfs:label xml:lang="en">unnamed_positive_LFTEMP_effect</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_0877000"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&ro;has_proper_part"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_9763000"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&obo;OBI_0000298"/>
                                        <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_9658000"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_7943000"/>
                                        <owl:someValuesFrom>
                                            <rdfs:Datatype>
                                                <owl:onDatatype rdf:resource="&xsd;decimal"/>
                                                <owl:withRestrictions rdf:parseType="Collection">
                                                    <rdf:Description>
                                                        <xsd:minExclusive rdf:datatype="&xsd;decimal">0.0</xsd:minExclusive>
                                                    </rdf:Description>
                                                </owl:withRestrictions>
                                            </rdfs:Datatype>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
