        <NEMO_annot:created_date rdf:datatype="&xsd;string">2011-07-02</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-08-07</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A morpheme is a linguistic category that is concretized as a morph, which is a sequence of visual, auditory, or tactile marks that express linguistic meaning.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">morpheme is_a linguistic_category that is concretized_as a morph</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
