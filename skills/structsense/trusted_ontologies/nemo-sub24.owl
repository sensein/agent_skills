    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_2306000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_2306000">
        <rdfs:label rdf:datatype="&xsd;string">left_inferior_parietotemporal_scalp_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;location_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_4965000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_5003000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-06-06</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2013-10-14</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A left_inferior_posterotemporal_scalp_surface_region is a region of the scalp surface that is inferior to some left_posterotemporal_scalp_surface_region.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A left_inferior_posterotemporal_scalp_surface_region is a scalp_surface_region that is the exact location_of some  left_inferior_posterotemporal_scalp_surface.</NEMO_annot:onto_definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">left_inferior_posterotemporal_scalp_surface_region</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">only measured in high-density EEG recording systems with coverage inferior to the canthal-meadal line (e.g., systems with 128 or more electrodes)</NEMO_annot:comment>
        <NEMO_annot:comment>See also definition of &quot;parietal&quot; (NEMO_3212000) and &quot;inferior&quot; (NEMO_0000193) and &quot;left temporal&quot; (NEMO_8302000). The &lt;left_inferior_parietotemporal_scalp_surface region&gt; has_quality &lt;parietal&gt; and has_quality &lt;left temporal&gt; and has_quality &lt;inferior&gt;.</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_2314000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_2314000">
        <rdfs:label xml:lang="en">somatosensory_representation</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_8593000"/>
        <NEMO_annot:definition rdf:datatype="&xsd;string">*A mental representation is an information_artifact_entity that &quot;is about&quot; some other entity.* 

*When a mental representation is about a perceived entity outside the body, it involves sensory-motor mapping, i.e., representation and control of the external environment.* 

*When it is about a perceived change within the body, it involves homeostatic processes, that is, representation or mapping and control of the internal milieux.* 

*A cognitive representation is the result of intermediate stages of processing that involve integration/coherence of multiple maps (e.g., multimodal processing, perceptual integration or &quot;binding&quot; of representations).*

*A mental representation is concretized as a particular  physiological state (i.e., pattern of activity) within the nervous system.*</NEMO_annot:definition>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-04-23</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-05-10</NEMO_annot:modified_date>
        <NEMO_annot:synonym>mental map</NEMO_annot:synonym>
        <NEMO_annot:definition_source>curator.</NEMO_annot:definition_source>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_2322000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_2322000">
        <rdfs:label rdf:datatype="&xsd;string">frequency</rdfs:label>
        <rdfs:subClassOf rdf:resource="&PATO;PATO_0001236"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-08</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-07-07</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A physical quality that exists in a bearer by virtue of the number of a bearer&apos;s repetitive actions in a particular time.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:source_ontology rdf:datatype="&xsd;string">Phenotypic Quality Ontology (PATO)</NEMO_annot:source_ontology>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">frequency</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">frequency is a material_entity_quality that...[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.org/obo/owl/PATO#PATO_0000044</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://purl.org/obo/owl/PATO#PATO_0000044</NEMO_annot:definition_source>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_2327000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_2327000">
        <rdfs:label xml:lang="en">left_central_scalp_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_5088000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;location_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_9314000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_5088000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-06-08</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2013-10-14</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A left_parietal_scalp_surface_region is a region of the scalp surface that includes electrodes C3 and P3 (international 10-20 system) and electrode CP3 (international 10-10 system). 

It is right of the left_posterotemporal_scalp_region, rostral to the left_occipital_scalp_region, and caudal to the left_frontocentral_scalp_region.</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:comment rdf:datatype="&xsd;string">In the NEMO toolkit, the left_central_scalp_surface_region includes the following international 10-10 channels: FC3, FC5, C3, and C5.</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">left_parietal_scalp_surface_region is a parietal_scalp_surface_region that...</NEMO_annot:onto_definition>
        <NEMO_annot:comment>See also definition of &quot;central&quot; (NEMO_0000188) and &quot;left&quot; (NEMO_0000190). The &lt;left_central_scalp_surface region&gt; has_quality &lt;central&gt; and has_quality &lt;left&gt;.</NEMO_annot:comment>
        <NEMO_annot:synonym>LCENT</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


