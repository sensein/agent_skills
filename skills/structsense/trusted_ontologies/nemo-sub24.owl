    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4297000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4297000">
        <rdfs:label xml:lang="en">mean_intensity_LCTEMP</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_9201000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;IAO_0000221"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="&PATO;PATO_0000049"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="&OBO_REL;inheres_in"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_8225000"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="&OBO_REL;unfolds_in"/>
                                                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_5937000"/>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-06-18</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-06-18</NEMO_annot:created_date>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Has corresponding term in Bob Frank&apos;s NEMO_ERP_Metric_Extraction matlab script: Mean_Intensity_LCTEMP</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">mean_intensity_LCTEM is a mean_intensity_measurement_datum 
  and (is_quality_measurement_of SOME intensity 
     and (inheres_in SOME scalp_recorded_ERP 
          and (unfolds_in SOME left_centrotemporal_scalp_surface_region)))</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">mean_intensity_LCTEMP specifies the mean electrical potential, in microvolts, over all electrodes within the left centrotemporal scalp ROI.</NEMO_annot:definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4299000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4299000">
        <rdfs:label rdf:datatype="&xsd;string">electrophysiological_data_analysis_reference</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_4114000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-22</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-04-22</NEMO_annot:modified_date>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">An electrophysiological_data_analysis_reference is a physiological_data_analysis_protocol that... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Since an EEG voltage signal represents a difference between the voltages at two electrodes, the display of the EEG for the reading encephalographer may be set up in one of several ways. The representation of the EEG channels is referred to as a reference schema. With digital EEG, all signals are typically digitized and stored in a particular (usually referential) montage; since any montage can be constructed mathematically from any other, the EEG can be viewed by the electroencephalographer in any display montage that is desired. (http://en.wikipedia.org/wiki/Electroencephalography).</NEMO_annot:definition>
        <NEMO_annot:example rdf:datatype="&xsd;string">average reference, mastoid reference, bipolar reference</NEMO_annot:example>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">electrophysiological_data_analysis_reference</NEMO_annot:pref_label>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Electroencephalography</NEMO_annot:definition_source>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Chris_Bird"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4301000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4301000">
        <rdfs:label rdf:datatype="&xsd;string">min_electrode_intensity</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_6390000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-01</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-06-13</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">For some set of scalp EEG measurement values, specifies the electrical potential, in microvolts, at a scalp-surface electrode location that has the greatest negativity at the time of maximum negative intensity.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Has corresponding term in Bob Frank&apos;s NEMO_ERP_Metric_Extraction matlab script: Min_Electrode_Intensity</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">In the NEMO_ERP_Toolkit, the min_electrode_intensity algorithm also identifies the peak-negative-intensity electrode location for subsequent use.</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">is_a minimum_value; located_in?? some regional_part_of_scalp_surface_region; is_quality_measurement_of electrical_potential_difference</NEMO_annot:comment>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">min_electrode_intensity</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">min_electrode_intensity is a ... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


