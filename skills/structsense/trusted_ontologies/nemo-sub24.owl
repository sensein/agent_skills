        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A neuraxis is a one_dimensional_region that is the location_of some central_nervous_system</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">The neuraxis is the axis of the central nervous system. It denotes the direction in which the central nervous system lies. During embryological development, the neuraxis is bent by various flexures, contributing to the mature structure of the brain and spinal cord.</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Neuraxis</NEMO_annot:definition_source>
        <NEMO_annot:synonym>CNS</NEMO_annot:synonym>
