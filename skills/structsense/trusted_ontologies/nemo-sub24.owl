    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_3724000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_3724000">
        <rdfs:label rdf:datatype="&xsd;string">synaptic_unit_potential</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0920000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-09-22</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-12</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A synaptic unit potential is a postsynaptic potential of fixed (unit) size that is produced the release of a discrete (unit) amount of neurotransmitter.</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Kandel, E.R. (1991). Transmitter release. In E.R. Kandel, J.H. Schwartz, &amp; T.M. Jessell (Eds.), Principles of neural science (3rd ed.), (pp.206-209). New York: Elsevier.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Submitted to NIF in November 2010.</NEMO_annot:comment>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">synaptic_unit_potential</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">synaptic_unit_potential is a postsynaptic_potential that...[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">unit_synaptic_potential</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Anita_Bandrowski"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Usman_Khan"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_3724001 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_3724001">
        <rdfs:label rdf:datatype="&xsd;string">macroelectrode</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000501"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-25</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-03-28</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A macroelectrode is a type of electrode that it is used for extracellular recording, that is, measurement of neuroelectric activity (i.e., electrical field potentials) that are generated by multiple cells.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A macroelectrode is an electrode that is disjoint with microelectrode.</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Daube, J. R., and Rubin, D., I. (2009) Clinical Neurophysiology. 3rd Edition. Oxford University Press, Oxford, UK. pp.410.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://www.bookrags.com/tandf/electrode-tf/</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">macro needle</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_3725000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_3725000">
        <rdfs:label rdf:datatype="&xsd;string">phonological_mapping_negativity</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_0000093"/>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="&ro;has_proper_part"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_6902000"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="&obo;IAO_0000221"/>
                                                <owl:someValuesFrom>
                                                    <owl:Class>
                                                        <owl:intersectionOf rdf:parseType="Collection">
                                                            <rdf:Description rdf:about="&PATO;PATO_0000049"/>
                                                            <owl:Restriction>
                                                                <owl:onProperty rdf:resource="&OBO_REL;inheres_in"/>
                                                                <owl:someValuesFrom>
                                                                    <owl:Class>
                                                                        <owl:intersectionOf rdf:parseType="Collection">
                                                                            <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_8225000"/>
                                                                            <owl:Restriction>
                                                                                <owl:onProperty rdf:resource="&OBO_REL;unfolds_in"/>
                                                                                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000005"/>
                                                                            </owl:Restriction>
                                                                        </owl:intersectionOf>
                                                                    </owl:Class>
                                                                </owl:someValuesFrom>
                                                            </owl:Restriction>
                                                        </owl:intersectionOf>
                                                    </owl:Class>
                                                </owl:someValuesFrom>
                                            </owl:Restriction>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_7943000"/>
                                                <owl:someValuesFrom>
                                                    <rdfs:Datatype>
                                                        <owl:onDatatype rdf:resource="&xsd;decimal"/>
                                                        <owl:withRestrictions rdf:parseType="Collection">
                                                            <rdf:Description>
                                                                <xsd:minInclusive rdf:datatype="&xsd;decimal">.4</xsd:minInclusive>
                                                            </rdf:Description>
                                                        </owl:withRestrictions>
                                                    </rdfs:Datatype>
                                                </owl:someValuesFrom>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_0000495"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="&obo;IAO_0000136"/>
                                                <owl:someValuesFrom>
                                                    <owl:Class>
                                                        <owl:intersectionOf rdf:parseType="Collection">
                                                            <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_8225000"/>
                                                            <owl:Restriction>
                                                                <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_0367000"/>
                                                                <owl:someValuesFrom>
                                                                    <owl:Class>
                                                                        <owl:intersectionOf rdf:parseType="Collection">
                                                                            <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_4762000"/>
                                                                            <owl:Restriction>
                                                                                <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_1568000"/>
                                                                                <owl:someValuesFrom>
                                                                                    <owl:Class>
                                                                                        <owl:intersectionOf rdf:parseType="Collection">
                                                                                            <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_0000409"/>
                                                                                            <owl:Restriction>
                                                                                                <owl:onProperty rdf:resource="&obo;OBI_0000316"/>
                                                                                                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000468"/>
                                                                                            </owl:Restriction>
                                                                                        </owl:intersectionOf>
                                                                                    </owl:Class>
                                                                                </owl:someValuesFrom>
                                                                            </owl:Restriction>
                                                                        </owl:intersectionOf>
                                                                    </owl:Class>
                                                                </owl:someValuesFrom>
                                                            </owl:Restriction>
                                                        </owl:intersectionOf>
                                                    </owl:Class>
                                                </owl:someValuesFrom>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&ro;has_proper_part"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_0745000"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_7943000"/>
                                        <owl:someValuesFrom>
                                            <rdfs:Datatype>
                                                <owl:intersectionOf rdf:parseType="Collection">
                                                    <rdfs:Datatype>
                                                        <owl:onDatatype rdf:resource="&xsd;decimal"/>
                                                        <owl:withRestrictions rdf:parseType="Collection">
                                                            <rdf:Description>
                                                                <xsd:minInclusive rdf:datatype="&xsd;decimal">270</xsd:minInclusive>
                                                            </rdf:Description>
                                                        </owl:withRestrictions>
                                                    </rdfs:Datatype>
                                                    <rdfs:Datatype>
                                                        <owl:onDatatype rdf:resource="&xsd;decimal"/>
                                                        <owl:withRestrictions rdf:parseType="Collection">
                                                            <rdf:Description>
                                                                <xsd:maxInclusive rdf:datatype="&xsd;decimal">335</xsd:maxInclusive>
                                                            </rdf:Description>
                                                        </owl:withRestrictions>
                                                    </rdfs:Datatype>
                                                </owl:intersectionOf>
                                            </rdfs:Datatype>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <NEMO_annot:comment rdf:datatype="&xsd;string">&quot;A process that is distinctive and precedes the N400.&quot; (D&apos;Arcy et al, 2002)</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">&quot;Likely reflects earlier (pre-semantic/sublexical) stages of word recognition processes, or in other words, a process sensitive to the unexpectedness of the intial phoneme of a word (as determined by the contextual constraint of the sentence)&quot; (D&apos;Arcy, et al., 2002)</NEMO_annot:comment>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-15</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-06-08</NEMO_annot:modified_date>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Connolly, J.F., &amp; Phillips, N.A. (1994).  Event-related potential components reflect phonological and semantic processing of the terminal word of spoken sentences. Journal of Cognitive Neuroscience, 6, 256-266. </NEMO_annot:definition_source>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">D&apos;Arcy,  R. C. N., Marchand, Y., Eskes, G. A., Harrison, E. R., Phillips, S. J., Major, A., and Connolly, J. F. (2002). Electrophysiological assessment of language function following stroke. Clinical Neurophysiology, 114, 662-672.</NEMO_annot:definition_source>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Hagoort P, Brown C (2000): ERP effects of listening to speech:Semantic ERP effect. Neuropsychologia 38:1518 –1530.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">PMN</NEMO_annot:acronym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">PMN</NEMO_annot:synonym>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">The phonological_mapping_negativity is_a scalp-recorded_ERP_extracted_pattern 
      
and has_proper_part SOME peak_latency_measurement_datum
       that has_numeric_value SOME decimal[&gt;=&quot;270&quot;, &lt;=&quot;350&quot;]

and has_proper_part SOME intensity_measurement_datum
       that has_numeric_value SOME decimal[&lt;=&quot;-0.4&quot;]
       that is_quality_measurement_of SOME intensity
            that inheres_in SOME scalp_recorded_ERP
                that unfolds_in SOME frontocentral_scalp_surface_region

and proper_part_of SOME averaged_EEG_data_set
       that has_provenance_specification SOME event_type_label
            that has_character_string_value SOME &quot;stimulus_onset&quot;
       and has_provenance_specification SOME stimulus_type_label
            that has_character_string_value SOME &quot;linguistic_object&quot;</NEMO_annot:onto_definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">phonological_mapping_negativity</NEMO_annot:pref_label>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">phonological_mismatch_negativity</NEMO_annot:synonym>
        <NEMO_annot:definition rdf:datatype="&xsd;string">phonological_mismatch_negativity is a negativity that is maximal over frontocentral scalp regions at about 270-335 ms after the onset of an auditory word.</NEMO_annot:definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#John_Connolly"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
        <NEMO_annot:evidence_code rdf:resource="&ontology;NEMO_annotation_properties.owl#traceable_author_statement"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_3752000 -->

