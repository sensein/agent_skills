    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_3595000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_3595000">
        <rdfs:label rdf:datatype="&xsd;string">MEG_data_set</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000493"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-09-10</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-10-12</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A type of data set characterizing magnetoencephalographic activity.</NEMO_annot:definition>
