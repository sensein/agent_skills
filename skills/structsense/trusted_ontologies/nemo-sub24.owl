        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_3302000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_3302000">
        <rdfs:label rdf:datatype="&xsd;string">word_naming_paradigm</rdfs:label>
