    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_3756009 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_3756009">
        <rdfs:label xml:lang="en">lexical_semantic_priming_paradigm</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000379"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2013-06-05</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2013-06-05</NEMO_annot:modified_date>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_functional</NEMO_annot:namespace>
        <NEMO_annot:definition rdf:datatype="&xsd;string">behavioral paradigm that assesses a response to a word (target) that is preceded by a word that is either semantically related or unrelated to the target.</NEMO_annot:definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">lexical_semantic_priming_paradigm is an experimental_paradigm that...[incomplete]</NEMO_annot:pref_label>
