        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-12</NEMO_annot:modified_date>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Kandel, E.R. &amp; Schwartz, J.H. (1991). Directly gated transmission at central synapses. In E.R. Kandel, J.H. Schwartz, &amp; T.M. Jessell (Eds.), Principles of neural science (3rd ed.), (pp.166-167). New York: Elsevier.</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NCI_C0234109</NEMO_annot:synonym>
