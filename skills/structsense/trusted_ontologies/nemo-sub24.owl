    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_1541000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_1541000">
        <rdfs:label xml:lang="en">higher_cognitive_representation</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_9092000"/>
        <NEMO_annot:definition rdf:datatype="&xsd;string">*A mental representation is an information_artifact_entity that &quot;is about&quot; some other entity.* 

*When a mental representation is about a perceived entity outside the body, it involves sensory-motor mapping, i.e., representation and control of the external environment.* 

*When it is about a perceived change within the body, it involves homeostatic processes, that is, representation or mapping and control of the internal milieux.* 

*A cognitive representation is the result of intermediate stages of processing that involve integration/coherence of multiple maps (e.g., multimodal processing, perceptual integration or &quot;binding&quot; of representations).*

*A mental representation is concretized as a particular  physiological state (i.e., pattern of activity) within the nervous system.*</NEMO_annot:definition>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-04-23</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-05-10</NEMO_annot:modified_date>
        <NEMO_annot:synonym>mental map</NEMO_annot:synonym>
        <NEMO_annot:definition_source>curator.</NEMO_annot:definition_source>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_1542000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_1542000">
