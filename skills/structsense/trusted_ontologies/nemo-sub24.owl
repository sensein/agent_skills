        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-04-22</NEMO_annot:modified_date>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A right frontopolar_scalp_surface is a frontopolar_scalp_surface...[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A right_frontopolar_scalp_surface is a part of the scalp surface that is approximately centered about ITT electrode FP2.</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
