    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_6437000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_6437000">
        <rdfs:label rdf:datatype="&xsd;string">negative_centroid_measurement_datum</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_5968000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-25</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-26</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A centroid measurement datum is a measurement result that defines the geographic center of the negative (sink) region of an electromagnetic field.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A negative_centroid_measurement_datumm is a scalar_measurement_datum that is the result of measuring a zero_dimensional object location.</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Koening, T., and Ginaotti, L. R. R. (2009) Scalp fields and their characterization. In Michel, C. M., Koening, T., Brandeis, D., Ginaotti, L. R. R., Wackermann, J. ed. (2009) Electrical neuroimaging. Cambridge University Press, Cambridge, UK, pp.25-47.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">negative_centroid_measurement_datum</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


