        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">CON_laterality_index is a setting_specification that ... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Has corresponding term in Bob Frank&apos;s NEMO_ERP_Metric_Extraction matlab script: CON_Laterality_Index</NEMO_annot:comment>
