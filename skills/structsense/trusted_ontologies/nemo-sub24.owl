    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0546000">
        <rdfs:label rdf:datatype="&xsd;string">CON_ROI_mean_intensity_comparison_condition</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_9201000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-01</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-06-13</NEMO_annot:modified_date>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">CON_ROI_mean_intensity_comparison_condition</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">CON_ROI_mean_intensity_comparison_condition is a ... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">For some set of scalp EEG measurement values, specifies the mean electrical potential, in microvolts, over all electrodes within the region-of-interest (as specified by the CON) at the time of maximal negative intensity. CON_ROI_mean_intensity_comparison_condition applies to the spatiotemporal components of the ERP data obtained under the comparison condition.</NEMO_annot:definition>
