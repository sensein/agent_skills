    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4917001">
        <rdfs:label rdf:datatype="&xsd;string">electrotonic_potential</rdfs:label>
        <rdfs:subClassOf rdf:resource="&PATO;PATO_0001464"/>
        <NEMO_annot:comment rdf:datatype="&xsd;string">&quot;A passive or analog electrical potential, that decays in space and time according to the time and space constants” (NIF).</NEMO_annot:comment>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-09-22</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-10-09</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">An electrotonic potential is an electrical potential within a cell membrane that passively depolarizes or hyperpolarizes the local gradient in response to current flow.</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Koester, J. (1991).  Membrane potential. In E.R. Kandel, J.H. Schwartz, &amp; T.M. Jessell (Eds.), Principles of neural science (3rd ed.), (pp.82-83). New York: Elsevier.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Submitted to NIF in November 2010.</NEMO_annot:comment>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">electrotonic_potential</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">electrotonic_potential is a electrical_potential that...[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://ncimeta.nci.nih.gov/ncimbrowser/ConceptReport.jsp?dictionary=NCI%20MetaThesaurus&amp;code=C0015214</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">subthreshold_potential</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Anita_Bandrowski"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Usman_Khan"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4918000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4918000">
        <rdfs:label xml:lang="en">p_statistic</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_1195000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-03-02</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-03-02</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A p-value is about some study finding. It is the probability of obtaining by random chance a result that is at least as extreme as the observed result, assuming the NULL hypothesis is true.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
