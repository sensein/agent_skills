        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:created_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">MSH D003344</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Medical Subject Headings ID D009473</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NCI C0010114</NEMO_annot:synonym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">National Cancer Institute Metathesaurus ID C0010114</NEMO_annot:comment>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Neural_synchronization is a simultaneous activation of multiple synapses from a single axon terminal.  It can also refer to a simultaneous activation of subsequent processes as a result of activity in some initial process.</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Shepherd, G.M. (2004).  Introduction to synaptic currents. In G.M. Shepherd (Ed.), The synaptic organization of the brain (5th ed.), (pp.8-10). New York: Oxford University Press.</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">cortical_synchronization</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D003344</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">neural_synchronization</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">neural_synchronization is a biological process... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Anita_Bandrowski"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Usman_Khan"/>
