    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_9172000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_9172000">
        <rdfs:label xml:lang="en">right_occipitotemporal_scalp_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000007"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;location_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0594000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_5003000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-06-18</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2013-10-14</NEMO_annot:modified_date>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A right_inferior_occipitotemporal_scalp_surface_region is a scalp_surface_region that is the exact location_of some right_occipitotemporal_scalp_surface.</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A right_occipitotemporal_scalp_surface_region is a region of the scalp surface that is right of some right_occipital_scalp_surface_region.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <rdfs:comment>In the NEMO toolkit, the right_occipitotemporal_scalp_surface_region includes the following international 10-10 channels: PO8 and PO10.</rdfs:comment>
        <NEMO_annot:synonym>ROTEMP</NEMO_annot:synonym>
        <NEMO_annot:comment>See also definition of &quot;occipital&quot; (NEMO_3632000) and &quot;right temporal&quot; (NEMO_3587000). The &lt;right_occipitotemporal_scalp_surface region&gt; has_quality &lt;occipital&gt; and has_quality &lt;right temporal&gt;.</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


