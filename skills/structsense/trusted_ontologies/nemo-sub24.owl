    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4625000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4625000">
        <rdfs:label rdf:datatype="&xsd;string">theta_wave_activity</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_2392000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-26</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-08-07</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">C0039829</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">D013826</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">MSH Definition: One of four types of brain waves, characterized by a frequency of 4-7 Hz, usually observed in the temporal lobes when the individual is awake, but relaxed and sleepy.</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Neurolex def: is an oscillatory pattern recorded either from inside the brain or from electrodes glued to the scalp. Two types of theta rhythm have been described. The &quot;hippocampal theta rhythm&quot; (6–10 Hz) is a strong oscillation that can be observed in the hippocampus and other brain structures in numerous species of mammals including rodents, rabbits, dogs, cats, bats, and marsupials. &quot;Cortical theta rhythms&quot; (4–7 Hz) are low-frequency components of scalp EEG, usually recorded from humans (adapted from Wikipedia). </NEMO_annot:comment>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Theta wave activity is an oscillation in brain electrical (EEG) activity in the frequency range of 4-7 Hz.</NEMO_annot:definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://ncim-stage.nci.nih.gov/ncimbrowser/ConceptReport.jsp?dictionary=NCI%20MetaThesaurus&amp;code=C0039829</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">theta oscillation</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">theta rhythym</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">theta wave</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">theta_wave_activity</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">theta_wave_activity is an oscillatory_brain_electrical_activity that...[incomplete] </NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4647000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4647000">
        <rdfs:label rdf:datatype="&xsd;string">COP_xCoord_2D</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_9128000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-01</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-06-13</NEMO_annot:modified_date>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">COP_xCoord_2D</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">COP_xCoord_2D is an one_dimensional_xccordnate_datum that ... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Has corresponding term in Bob Frank&apos;s NEMO_ERP_Metric_Extraction matlab script: COP_xCoord_2D</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Specifies for each spatiotemporal component pair the x-coordinate, in arbitrary units, of its center of electrical positivity (COP) in 2-D space.  It is based upon the distribution of positive electrical potential at montage-specific, scalp-surface electrode locations that are part of a reference scalp-surface region projected onto a 2-D plane or flat map. The center of positivity (COP) is the point on the 2-D flat map at which all positive electrical potential at the scalp-surface electrodes can be equivalently located. Computationally, it is analogous to a center of mass calculation with electrode potentials replaced by point masses.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">is_about (a point along an axis in two_dimensional_spatial_region); is_about (COP_1D); proper_part_of (COP_2D_coordinate_datum); has_coordinate_unit_label (??)</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


