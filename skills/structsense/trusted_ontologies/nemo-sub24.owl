        <NEMO_annot:definition_source rdf:datatype="&xsd;string">BrainMapLex.xls</NEMO_annot:definition_source>
        <NEMO_annot:source_ontology rdf:datatype="&xsd;string">Cognitive Protocol Ontology (CogPO)</NEMO_annot:source_ontology>
        <NEMO_annot:comment rdf:datatype="&xsd;string">DEPRECATE? OR RENAME -- IMPORT CogPO/cogAtlas contrast classes &amp; relation</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_functional</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">experiment_contrast</NEMO_annot:pref_label>
        <NEMO_annot:definition rdf:datatype="&xsd;string">experiment_contrast is defined as the dimension along which two experiment conditions are different.  These differences are the possible sources for differences in experiment_response and physiological_response.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">experiment_contrast is protocol that...[incomplete]</NEMO_annot:onto_definition>
