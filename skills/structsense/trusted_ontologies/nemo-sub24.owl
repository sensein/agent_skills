    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_5779000">
        <rdfs:label rdf:datatype="&xsd;string">developmental_dyslexia</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_3717000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-30</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-07-02</NEMO_annot:modified_date>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Developmental dyslexia is a familial disorder with autosomal dominant inheritance. It occurs more frequently in males.</NEMO_annot:comment>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Developmental dyslexia is an impairment in reading ability that emerges in childhood and is not explained by a lack of general intelligence, learning opportunities, motivation, or sensory acuity. Symptoms and signs include impaired visual, verbal coding, short-term memory, order perception and sequencing.</NEMO_annot:definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Developmental reading disorder</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Habib, M. (1999) The neurological basis of developmental dyslexia. An overview and working hypothesis. Brain (2000), 123, 2373-2399.</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">ICD9CM_2010:315.09</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">International Classification of Diseases ID 315.02</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">McLoughlin, D., Fitzgibbon, G., Youn, V. (1994) Adult dyslexia assessment counseling and training. Gateshead, Athenaeum Press Ltd.</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NCI Metathesaurus ID C0920296</NEMO_annot:synonym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_functional</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">UMLS_CUI:C0154631</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">developmental_dyslexia</NEMO_annot:pref_label>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Dyslexia</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://ihtsdo.org/snomedct/clinicalFindings#192138007</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/CSP/4007-0042</NEMO_annot:definition_source>
