        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_8974000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_8974000">
        <rdfs:label xml:lang="en">effect_size_quality</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7399000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_4124000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-05-19</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-05-19</NEMO_annot:created_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition rdf:datatype="&xsd;string">effect_size_quality is a qualitative value that refers to the strength of the relationship between two variables in a statistical population, or a sample-based estimate of that quantity</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">effect_size_quality is a quality that inheres_in some effect_size.</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Effect_size</NEMO_annot:definition_source>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_8980000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_8980000">
        <rdfs:label rdf:datatype="&xsd;string">nsf_data_format</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_1194000"/>
        <NEMO_annot:definition rdf:datatype="&xsd;string">.nsf is a data format created and used by Net Station EEG data acquisition and analysis software.</NEMO_annot:definition>
