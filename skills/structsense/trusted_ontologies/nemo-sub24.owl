    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0000495 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0000495">
        <rdfs:label rdf:datatype="&xsd;string">averaged_EEG_data_set</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_2662000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_2361000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;OBI_0000312"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_0000511"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="&obo;OBI_0000293"/>
                                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_4690000"/>
                            </owl:Restriction>
