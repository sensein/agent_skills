    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_7677000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_7677000">
        <rdfs:label rdf:datatype="&xsd;string">frequency_measurement_datum</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;IAO_0000032"/>
