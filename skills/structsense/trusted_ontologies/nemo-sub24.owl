    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_8541000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_8541000">
        <rdfs:label rdf:datatype="&xsd;string">neurotransmission</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_5798000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;has_participant"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000315"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:comment rdf:datatype="&xsd;string"> “The communication from a neuron to a target (neuron, muscle, or secretory cell) across a synapse. In chemical synaptic transmission, the presynaptic neuron releases a neurotransmitter that diffuses across the synaptic cleft and binds to specific synaptic receptors, activating them. The activated receptors modulate specific ion channels and/or second-messenger systems in the postsynaptic cell. In electrical synaptic transmission, electrical signals are communicated as an ionic current flow across electrical synapses.” (Medical Subject Headings Definition). </NEMO_annot:comment>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-09-10</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">AOD 0000002791</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Alcohol and Other Drug Thesaurus ID 0000002791</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">CSP 2059-2161</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Computer Retrieval of Information on Scientific Projects (CRISP) ID 2059-2161</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">GO_0007268</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Gene Ontology ID 0007268</NEMO_annot:comment>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Kandel, E.R., Schwartz, J.H., &amp; Jessell, T.M. (Eds.). (1995). Essentials of neural science and behavior. Stamford, CT: Appleton &amp; Lange.</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">MSH D009435</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Medical Subject Headings ID D009435</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NCI C0027793</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NCI C21575</NEMO_annot:synonym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">National Cancer Institute Metathesaurus ID C0027793</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">National Cancer Institute Metathesaurus ID C21575</NEMO_annot:comment>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Neurotransmission is a mechanism by which one neuron influences excitability in another.  These mechanisms of transmission can be chemical or electrical in nature.  Electrical synaptic transmission is mediated by current flow through a gap junction joining two neurons.  Chemical synaptic transmission is mediated by the release of a chemical neurotransmitter from the presynaptic cell acting on receptors in the postsynaptic cell.</NEMO_annot:definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">SNOMEDCT 55859003</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Submitted to NIF in November 2010.</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Systematized Nomenclature of Medicine – Clinical Terms ID 55859003</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/CSP/2059-2161</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D009435</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/SNOMEDCT/123037004</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.org/obo/owl/GO#GO_0007268</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">nerve_pulse_transmission</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">neural_transmission</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">neuronal_transmission</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">neurotransmission</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">neurotransmission is a biological process... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">regulation_of_synapse</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">synaptic_transmission</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">transmission_of_nerve_impulse</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Anita_Bandrowski"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Usman_Khan"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


