    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_3687000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_3687000">
        <rdfs:label rdf:datatype="&xsd;string">phone</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000409"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-12-13</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-07-02</NEMO_annot:modified_date>
        <NEMO_annot:comment rdf:datatype="&xsd;string">A phone (i.e. speech sound) often corresponds to a particular phoneme. However, there is not necessarily a one-to-one mapping between  phonemes and  phones (speech sounds); speech sounds often undergo changes that are triggered by different phonological contexts. The contextual variants of a particular phone are called allophones (or &quot;speech sound variants&quot;) of a particular phoneme.
</NEMO_annot:comment>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A phone is the physical realization of a phoneme, which is the smallest distinctive unit of the phonological system within a language.</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Crystal, D. (2003) A Dictionary of Linguistics and Phonetics. 5th Ed. Blackwell Publishing, Oxford, UK, pp. 347-348.</NEMO_annot:definition_source>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Kenstowicz, M. (1993) Phonology in Generative Grammar. Blackwell Publishing, Oxford, UK. pp. 65-69.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_functional</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">allophone</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">allophones</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">has_quality (auditory)</NEMO_annot:comment>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">ontoDefinition text goes HERE</NEMO_annot:onto_definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">speech sound</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">speech sound variant</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">speech sounds</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


