        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-11-05</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A scalp-recorded ERP data set that is derived by subtracting ERPs in two experimental conditions</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">scalp_recorded_ERP_diffwave is an averaged_EEG_data_set 
     that is_specified_output_of SOME subtraction_data_transformation
              that has_specified_input SOME averaged_EEG_data_set
                       that is_about SOME scalp_recorded_ERP
                                 that occurs_in_response_to SOME experimental_paradigm_execution
                                           that is_realization_of SOME plan
                                                   that is_concretization of SOME experiment_paradigm</NEMO_annot:onto_definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">scalp_reported_ERP_diffwave_component</NEMO_annot:pref_label>
