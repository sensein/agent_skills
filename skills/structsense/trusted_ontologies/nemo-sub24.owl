        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-05-12</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-05-12</NEMO_annot:created_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">An unnamed_positive_LOCC_effect  is a positivity that is significant over the left occipital region of the scalp.</NEMO_annot:definition>
