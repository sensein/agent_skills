    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_8225000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_8225000">
        <rdfs:label rdf:datatype="&xsd;string">scalp_recorded_ERP</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_2361000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&OBO_REL;unfolds_in"/>
                <owl:someValuesFrom rdf:resource="&snap;SpatialRegion"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_4917000"/>
                <owl:someValuesFrom rdf:resource="&span;TemporalInterval"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_0367000"/>
                <owl:someValuesFrom rdf:resource="&span;ProcessualEntity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-11-10</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-16</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">EP</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">ERP</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">ERP_activity</NEMO_annot:synonym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">scalp_recorded_ERP</NEMO_annot:pref_label>
        <NEMO_annot:definition rdf:datatype="&xsd;string">scalp_recorded_ERP is a process that occurs when there are changes in brain electrical potentials (ERPs) in response to a stimulus, response, or internal (e.g., other psychophysiological) event and when these changes are propogated to the scalp-surface where they can be measured with surface electrodes.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">scalp_recorded_ERP is electroencephalographic_activity that unfolds_in some scalp_surface.</NEMO_annot:onto_definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">unfolds in (scalp_recorded_ERP, some (scalp_surface))</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


