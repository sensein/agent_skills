        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/SNOMEDCT/85098000</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">neural_summation</NEMO_annot:pref_label>
