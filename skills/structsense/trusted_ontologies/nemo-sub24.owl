    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_1540000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_1540000">
        <rdfs:label rdf:datatype="&xsd;string">magnetoencephalographic_activity</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_5217000"/>
