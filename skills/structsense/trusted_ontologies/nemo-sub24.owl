        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000182"/>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-06-21</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-06-21</NEMO_annot:created_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Spatial concepts in NEMO refer to objects located on, in, or near the head. They may not generalize to spatial relations among other objects.</NEMO_annot:comment>
        <NEMO_annot:definition rdf:datatype="&xsd;string">[incomplete]</NEMO_annot:definition>
        <NEMO_annot:comment>The caudal part of the head surface can be divided into occipital (caudal-most region) and parietal (region just anterior to occipital area).</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_3226000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_3226000">
        <rdfs:label rdf:datatype="&xsd;string">EEG_topographic_map</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;IAO_0000308"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-05</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-26</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">An EEG_topographic_map is a figure that displays EEG data for multiple channels interpolated over a 2D surface representation of the head surface at a single timepoint. EEG voltage values are represented along a color spectrum, where the two ends of the spectrum represent values that are more or less positive (often shown in red hues) or negative (often depicted in blue hues). More extreme values are represented by more intense colors.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">An EEG_topographic_map is_a figure that is_about some electrophysiological_data_set.</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator</NEMO_annot:definition_source>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">EEG_topographic_map</NEMO_annot:pref_label>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


