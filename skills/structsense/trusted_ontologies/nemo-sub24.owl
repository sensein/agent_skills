    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_8793000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_8793000">
        <rdfs:label rdf:datatype="&xsd;string">Brodmann_area_38_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7920000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-22</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-01-14</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Area temporopolaris</NEMO_annot:synonym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">B09-38</NEMO_annot:acronym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">B09-38</NEMO_annot:synonym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">BA38</NEMO_annot:acronym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann (1909) area 38</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann area 38</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">Brodmann_area_38_surface_region</NEMO_annot:pref_label>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Brodmann_area_38_surface_region is a subdivision of the cytoarchitecturally defined temporal region of cerebral cortex. It is located primarily in the most rostral portions of the superior temporal gyrus and the middle temporal gyrus. Cytoarchitecturally it is bounded caudally by the inferior temporal area 20, the middle temporal area 21, the superior temporal area 22 and the ectorhinal area 36 (Brodmann-1909).</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">Brodmann_area_38_surface_region is a two_dimensional_region that is the location of SOME regional_part_of_cortical_surface</NEMO_annot:onto_definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-1559906037</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-928</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">NeuroNames concept ID NN-2412</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Umlscui C1272499</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 38 of Brodmann (human)</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 38 of Brodmann-1909</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">birnlex_1771</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">formerly NN-72 in NeuroNames</NEMO_annot:comment>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://psychology.wikia.com/wiki/Brodmann_area_38</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">temporopolar</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">temporopolar area 38</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_8803000 -->

