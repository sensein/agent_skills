        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-26</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-07-30</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A physiological_event_boundary is an instanteous (or punctate) event that involves one or more physiological states (e.g., increase in rate of spiking, maintenance of resting potential, shift in brain electrophysiological state).</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A physiological_process is a process that has_participant some physiological_state.</NEMO_annot:onto_definition>
