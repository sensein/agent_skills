        <NEMO_annot:comment rdf:datatype="&xsd;string">domain = data_item; range = entity</NEMO_annot:comment>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">is_quality_measurement_of</NEMO_annot:pref_label>
        <NEMO_annot:definition rdf:datatype="&xsd;string">m is a quality measurement of q at t when q is a quality there is a measurement process p that has specified output m, a measurement datum, that is about q</NEMO_annot:definition>
