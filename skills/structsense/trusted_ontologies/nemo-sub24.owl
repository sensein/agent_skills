        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Attenuation is the loss of power that occurs between the input and the output of a device.  In a signal, beam, or wave propagating in a medium, the decrease in field strength is caused by the absorption of energy by the medium and the scattering caused by the medium, not by geometric spreading.</NEMO_annot:definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">MS_1000848</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Mass Spectrometry ID  1000848</NEMO_annot:comment>
