        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-06-06</NEMO_annot:modified_date>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">CON_min_electrode_intensity_comparison_condition</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">CON_min_electrode_intensity_comparison_condition is a ... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">For some set of scalp EEG measurement values, specifies the electrical potential, in microvolts, at the center of negativity electrode at the time of minimal intensity. CON_min_electrode_intensity_comparison_condition applies to the spatiotemporal components of the ERP data obtained under the comparison condition.</NEMO_annot:definition>
