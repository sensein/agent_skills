    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_2886000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_2886000">
        <rdfs:label rdf:datatype="&xsd;string">finite_difference_model</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_1656000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2009-06-06</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-26</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A finite difference model (FDM) is a computational model that describes the propagation of electrical fields through a medium of a particular set of material properties. FDM use Kirchoff&apos;s law to compute values at each node within a a three-dimensional grid, yielding a system of differential equations that are solved by application of the Finite Difference Method.</NEMO_annot:definition>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">FDM</NEMO_annot:acronym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">In this method, the entire head is divided into equal-sized cubical voxels, and a conductance is assigned to each voxel according to the tissue type contained in the voxel. Current sources and sinks are then directly modeled by injecting or extracting current from the corresponding voxels, this current then passes to other voxels in proportion to their conductance (Kirchoff&apos;s Law), and the entire model is allowed to converge to a solution. [From Marino et al. (1993)]</NEMO_annot:comment>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Marino, F., Halgren, E., Badier, J-M., Gee, M., Nenov, V. (1993). The finite difference model of electric field propagation in the human head: Implementation and validation. Proceedings of the 1993 IEEE Nineteenth Annual Northeast, pp. 82-85.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">finite_difference_model</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">finite_difference_model is an anatomical_data_set that...</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_2887000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_2887000">
        <rdfs:label rdf:datatype="&xsd;string">word_repetition_paradigm</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000379"/>
