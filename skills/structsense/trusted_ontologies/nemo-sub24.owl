    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_1087000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_1087000">
        <rdfs:label rdf:datatype="&xsd;string">recursive_digital_filter_algorithm</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7669000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A recursive digital filter is a type of filter that has feedback; its output depends not only on present and past input values but on past output values as well.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A recursive_digital_filter_algorithm is a filter_algorithm that... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">IIR filters</NEMO_annot:synonym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Parker, S.P. (Ed.). (2003). McGraw-Hill dictionary of science and technical terms (7th ed.) New York: McGraw-Hill.</NEMO_annot:definition_source>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Submitted to NIF in November 2010.</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">infinite impulse response filters</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">recursive_digital_filter_algorithm</NEMO_annot:pref_label>
        <NEMO_annot:comment rdf:datatype="&xsd;string">“The output of a recursive filter depends not only on the inputs, but on the previous outputs as well. That is, the filter has some time-dependent ‘memory’” (Sherman-Gold, R. (1993). The axon guide for electrophysiology &amp; biophysics laboratory techniques.  Sunnyvale, CA: Molecular Devices.).</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Usman_Khan"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


