        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_4320000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-04-23</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-04-23</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">a cognitive_process is a mental process engaging one or more systems in the intermediary or integrative processing of signals from the internal (visceral) and external (somatic) environments. It is often the result of a sensory_process (bottom-up cognition). It may be mediated by an emotion_process (motivated cognition) or by another cognitive_process, such as memory or expectancy based on prior experience (top-down cognition).</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">mental_process is a brain_physiological_process that...[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:synonym>cognition</NEMO_annot:synonym>
        <NEMO_annot:definition_source>curator.</NEMO_annot:definition_source>
        <rdfs:comment>To be replaced by concepts from cogATLAS....</rdfs:comment>
        <NEMO_annot:synonym>http://ontology.neuinfo.org/NIF/Function/NIF-Function.owl#birnlex_1800</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


