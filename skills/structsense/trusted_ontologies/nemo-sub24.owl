    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_8054000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_8054000">
        <rdfs:label rdf:datatype="&xsd;string">sentence</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000409"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-12-13</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-07-02</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A sentence is a sequence of words that forms a syntactic unit consisting of a grammatical subject  and a predicate that includes at least one finite verb.</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Crystal, D. (2003) A Dictionary of Linguistics and Phonetics. 5th Ed. Blackwell Publishing, Oxford, UK, pp. 414-415.</NEMO_annot:definition_source>
