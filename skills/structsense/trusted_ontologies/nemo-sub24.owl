        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_5035000"/>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">...[incomplete]</NEMO_annot:definition_source>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">...[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-08</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-07-27</NEMO_annot:modified_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_functional</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">needs to be linked to human_language</NEMO_annot:comment>
        <NEMO_annot:definition rdf:datatype="&xsd;string">refers to a spanish language learned first as a child.</NEMO_annot:definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">spanish_speaking</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Chris_Bird"/>
