    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_9824000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_9824000">
        <rdfs:label rdf:datatype="&xsd;string">root_mean_square</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_4123000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-08</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NCI C73485</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">NCI Thesaurus ID C73485</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">RMS</NEMO_annot:acronym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Root_mean_square</NEMO_annot:definition_source>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#Root_Mean_Square</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#Root_Mean_Square</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">quadratic_mean</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">root_mean_square</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">root_mean_square is a magnitude_statistic that is_about SOME data_set</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">root_mean_square is a statistical measure of the magnitude of a set of values. It is computed as the square root of the arithmetic mean (average) of the squares of the original values (e.g., the square of the function that defines the continuous waveform). It is a special case of the generalized mean with exponent p = 2.</NEMO_annot:definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


