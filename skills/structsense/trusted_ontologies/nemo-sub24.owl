                <owl:onProperty rdf:resource="&ro;has_proper_part"/>
                <owl:someValuesFrom rdf:resource="&obo;IAO_0000109"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-10-13</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-12-29</NEMO_annot:modified_date>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">An EEG_data_set is an electrophysiological_data_set that is_about some electrencephalographic_activity</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">An electrophysiological data set is a type of data set that characterizes electroencephalographic activity.</NEMO_annot:definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">EEG_data_set</NEMO_annot:pref_label>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Hamalainen, M., Hari, R., Ilmoniemi, R. J., Knuutila, J., &amp; Lounasmaa, O. V. (1993). Magnetoencephalography - theory, instrumentation, and applications to noninvasive studies of the working human brain. Reviews of Modern Physics, 65(2), 413-505.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
