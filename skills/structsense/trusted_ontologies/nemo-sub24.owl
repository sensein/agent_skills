        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">Extracellular_field is material_entity_quality that ...[incomplete]...</NEMO_annot:onto_definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:definition rdf:datatype="&xsd;string">The extracellular field is the electromagnetic field that is recorded outside a cell and is due to the summed activity of multiple cells in the vicinity of the recorded cell.</NEMO_annot:definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">extracellular_field</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Anita_Bandrowski"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Usman_Khan"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_9871000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_9871000">
        <rdfs:label rdf:datatype="&xsd;string">finite_element_model</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_1656000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2009-06-06</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-26</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A finite element model (FEM) is a computational model that describes the propagation of electrical fields through a medium with a particular set of material properties. FEM is based on estimation of the potential field around each mesh element that represents the geometric, material and electric properties of the head volume conductor.</NEMO_annot:definition>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">FEM</NEMO_annot:acronym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Wen.,P. and Li., Y. (2006) EEG human head modeling based on heterogenous tissue conductivity. Australian Physical and Engineering Sciences in Medicine, Vol. 29, Number 3, 2006.</NEMO_annot:definition_source>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Wolters, C. H. (2007) SIAM, Vol. 40, Number 2, March 2007.</NEMO_annot:definition_source>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">finite_element_model</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">finite_element_model is a head_model that...</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_9874000 -->

