                            <owl:Restriction>
                                <owl:onProperty rdf:resource="&ro;has_proper_part"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_6902000"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="&obo;IAO_0000221"/>
                                                <owl:someValuesFrom>
                                                    <owl:Class>
                                                        <owl:intersectionOf rdf:parseType="Collection">
                                                            <rdf:Description rdf:about="&PATO;PATO_0000049"/>
                                                            <owl:Restriction>
                                                                <owl:onProperty rdf:resource="&OBO_REL;inheres_in"/>
                                                                <owl:someValuesFrom>
                                                                    <owl:Class>
                                                                        <owl:intersectionOf rdf:parseType="Collection">
                                                                            <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_8225000"/>
                                                                            <owl:Restriction>
                                                                                <owl:onProperty rdf:resource="&OBO_REL;unfolds_in"/>
                                                                                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000005"/>
                                                                            </owl:Restriction>
                                                                        </owl:intersectionOf>
                                                                    </owl:Class>
                                                                </owl:someValuesFrom>
                                                            </owl:Restriction>
                                                        </owl:intersectionOf>
                                                    </owl:Class>
                                                </owl:someValuesFrom>
                                            </owl:Restriction>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_7943000"/>
                                                <owl:someValuesFrom>
                                                    <rdfs:Datatype>
                                                        <owl:onDatatype rdf:resource="&xsd;decimal"/>
                                                        <owl:withRestrictions rdf:parseType="Collection">
                                                            <rdf:Description>
                                                                <xsd:maxInclusive rdf:datatype="&xsd;decimal">-.4</xsd:maxInclusive>
                                                            </rdf:Description>
                                                        </owl:withRestrictions>
                                                    </rdfs:Datatype>
                                                </owl:someValuesFrom>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_0000495"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="&obo;IAO_0000136"/>
                                                <owl:someValuesFrom>
                                                    <owl:Class>
                                                        <owl:intersectionOf rdf:parseType="Collection">
                                                            <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_8225000"/>
                                                            <owl:Restriction>
                                                                <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_0367000"/>
                                                                <owl:someValuesFrom>
                                                                    <owl:Class>
                                                                        <owl:intersectionOf rdf:parseType="Collection">
                                                                            <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_4762000"/>
                                                                            <owl:Restriction>
                                                                                <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_1568000"/>
                                                                                <owl:someValuesFrom>
                                                                                    <owl:Class>
                                                                                        <owl:intersectionOf rdf:parseType="Collection">
                                                                                            <rdf:Description rdf:about="&snap;Object"/>
                                                                                            <owl:Restriction>
                                                                                                <owl:onProperty rdf:resource="&obo;OBI_0000316"/>
                                                                                                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000468"/>
                                                                                            </owl:Restriction>
                                                                                        </owl:intersectionOf>
                                                                                    </owl:Class>
                                                                                </owl:someValuesFrom>
                                                                            </owl:Restriction>
                                                                        </owl:intersectionOf>
                                                                    </owl:Class>
                                                                </owl:someValuesFrom>
                                                            </owl:Restriction>
                                                        </owl:intersectionOf>
                                                    </owl:Class>
                                                </owl:someValuesFrom>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&ro;has_proper_part"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_0745000"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_7943000"/>
                                        <owl:someValuesFrom>
                                            <rdfs:Datatype>
                                                <owl:intersectionOf rdf:parseType="Collection">
                                                    <rdfs:Datatype>
                                                        <owl:onDatatype rdf:resource="&xsd;decimal"/>
                                                        <owl:withRestrictions rdf:parseType="Collection">
                                                            <rdf:Description>
                                                                <xsd:minInclusive rdf:datatype="&xsd;decimal">300</xsd:minInclusive>
                                                            </rdf:Description>
                                                        </owl:withRestrictions>
                                                    </rdfs:Datatype>
                                                    <rdfs:Datatype>
                                                        <owl:onDatatype rdf:resource="&xsd;decimal"/>
                                                        <owl:withRestrictions rdf:parseType="Collection">
                                                            <rdf:Description>
                                                                <xsd:maxInclusive rdf:datatype="&xsd;decimal">500</xsd:maxInclusive>
                                                            </rdf:Description>
                                                        </owl:withRestrictions>
                                                    </rdfs:Datatype>
                                                </owl:intersectionOf>
                                            </rdfs:Datatype>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-15</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-01-13</NEMO_annot:modified_date>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curran, T. (1999: p. 771-785). Full citation: Curran, T. (1999). The electrophysiology of incidental and intentional retrieval: ERP old/new effects in lexical decision and recognition memory. Neuropsychologia, 37, 771–785.</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">N4</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">N400</NEMO_annot:synonym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Rugg, M. D., &amp; Curran, T. (2007). Event-related potentials and recognition memory. Trends in Cognitive Sciences, 11, 251-257</NEMO_annot:definition_source>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">The fN400_old_new_effect is a scalp-recorded_ERP_extracted_pattern 
       that is_about SOME scalp_reported_ERP 
             that occurs_in_response_to SOME onset_stimulus_presentation
      
and has_proper_part SOME peak_latency_measurement_datum
       that has_numeric_value (300-500ms)

and has_proper_part SOME intensity_measurement_datum
       that is_about SOME scalp_report_ERP
            that bearer_of SOME negative_polarity
       and that unfolds_in SOME frontocentral_scalp_surface_region</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">The fN400_old_new_effect is a scalp_recorded_ERP that is time-locked to a stimulus and has increased negative amplitude over frontocentral scalp ROI at about 300-500 ms after the onset of the stimulus.</NEMO_annot:definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">fN400</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">frontocentral_N400</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Tim_Curran"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
        <NEMO_annot:evidence_code rdf:resource="&ontology;NEMO_annotation_properties.owl#traceable_author_statement"/>
    </owl:Class>
    


