    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_9427000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_9427000">
        <rdfs:label rdf:datatype="&xsd;string">Brodmann_area_5_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7920000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-22</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-12-15</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Area praeparietalis</NEMO_annot:synonym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">B09-5</NEMO_annot:acronym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">B09-5</NEMO_annot:synonym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">BA5</NEMO_annot:acronym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Bowden, D. M., &amp; Dubach, M. F. (2003). NeuroNames 2002. Neuroinformatics, 1(1), 43-59.</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann (1909) area 5</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann area 5</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">Brodmann_area_5_surface_region</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">Brodmann_area_5_surface_region is a two_dimensional_region that is the location of SOME regional_part_of_cortical_surface</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Brodmann_area_5_surface_region refers to a subdivision of the parietal lobe of the guenon defined on the basis of cytoarchitecture. It occupies primarily the superior parietal lobule. Brodmann-1909 considered it topologically and cytoarchitecturally homologous to the preparietal area 5 of the human. Distinctive features (Brodmann-1905): compared to area 4 of Brodmann-1909 area 5 has a thick self-contained internal granular layer (IV); lacks a distinct internal pyramidal layer (V); has a marked sublayer 3b of pyramidal cells in the external pyramidal layer (III); has a distinct boundary between the internal pyramidal layer (V) and the multiform layer (VI); and has ganglion cells in layer V beneath its boundary with layer IV that are separated from layer VI by a wide clear zone.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Formerly NN-65 in NeuroNames</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-897</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-923142041</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">NeuroNames concept ID NN-2406</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Umlscui C1272527</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 5 of Brodmann (human)</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 5 of Brodmann-1909</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">birnlex_1736</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">preparietal</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">preparietal area 5</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_9450000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_9450000">
        <rdfs:label rdf:datatype="&xsd;string">Brodmann_area_8_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7920000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-22</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-12-15</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Area frontalis intermedia</NEMO_annot:synonym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">B09-8</NEMO_annot:acronym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">B09-8</NEMO_annot:synonym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">BA8</NEMO_annot:acronym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Bowden, D. M., &amp; Dubach, M. F. (2003). NeuroNames 2002. Neuroinformatics, 1(1), 43-59.</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann (1909) area 8</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann area 8</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">Brodmann_area_8_surface_region</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">Brodmann_area_8_surface_region is a two_dimensional_region that is the location of SOME regional_part_of_cortical_surface</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Brodmann_area_8_surface_region refers to a cytoarchitecturally defined portion of the frontal lobe of the guenon. Located rostral to the arcuate sulcus, it was not considered by Brodmann-1909 to be topographically homologous to the intermediate frontal area 8 of the human. Distinctive features (Brodmann-1905): compared to area 6 of Brodmann-1909, area 8 has a diffuse but clearly present internal granular layer (IV);sublayer 3b of the external pyramidal layer (III) has densely distributed medium sized pyramidal cells; the internal pyramidal layer (V) has larger ganglion cells densely distributed with some granule cells interspersed; the external granular layer (II) is denser and broader; cell layers are more distinct; the abundance of cells is somewhat greater.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Formerly NN-45 in NeuroNames</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">In addition to BA8, birnlex additionaly lists Brodmann area 8a. Birnlex ID birnlex_1762. Synonyms for Brodmann area 8a: area 8a of Brodmann-1909, B09-8a and Brodmann (1909) area 8a.</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-281719780</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-852</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">NeuroNames concept ID NN-2396</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Umlscui C1272530</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 8 of Brodmann (human)</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 8 of Brodmann-1909</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">birnlex_1739</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">intermediate frontal</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">intermediate frontal area 8</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


