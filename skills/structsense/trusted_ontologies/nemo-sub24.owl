    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0000469 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0000469">
        <rdfs:label rdf:datatype="&xsd;string">behavioral_process</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000319"/>
