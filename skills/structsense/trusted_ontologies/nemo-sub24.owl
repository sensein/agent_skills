        <NEMO_annot:pref_label rdf:datatype="&xsd;string">regional_part_of_scalp_surface</NEMO_annot:pref_label>
        <NEMO_annot:definition rdf:datatype="&xsd;string">regional_part_of_scalp_surface is a part of the scalp_surface that is delimited by specific anaromical landmarks.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">regional_part_of_scalp_surface is a regional_part_of_anatomical_surface that is a proper_part_of some scalp_surface.</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
