    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_6697000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_6697000">
        <rdfs:label rdf:datatype="&xsd;string">number_trials</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_4867000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-05</NEMO_annot:created_date>
