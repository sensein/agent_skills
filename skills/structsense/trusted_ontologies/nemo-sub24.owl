    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_5930000">
        <rdfs:label rdf:datatype="&xsd;string">semantically_primed_condition</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000382"/>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-07-02</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2011-07-02</NEMO_annot:created_date>
