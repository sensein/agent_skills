    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0000315 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0000315">
        <rdfs:label rdf:datatype="&xsd;string">physiological_state</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_8791000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&OBO_REL;inheres_in"/>
