        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0000483 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0000483">
        <rdfs:label rdf:datatype="&xsd;string">clustering_algorithm</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000479"/>
