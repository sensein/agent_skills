    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_8955000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_8955000">
        <rdfs:label rdf:datatype="&xsd;string">central_tendency_statistic</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_6525000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-05</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">central_tendency</NEMO_annot:synonym>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">central_tendency_measurement is a descriptive_statistic that is_about SOME data_set</NEMO_annot:onto_definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">central_tendency_statistic</NEMO_annot:pref_label>
        <NEMO_annot:definition rdf:datatype="&xsd;string">central_tendency_statistic is a statistical measure that describes the center (central tendency) of a data distribution. Three estimates of central tendency are the mean (average), the median, and the mode.</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Descriptive_statistics</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.obolibrary.org/obo/OBI_0000679</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_8967000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_8967000">
        <rdfs:label rdf:datatype="&xsd;string">regional_part_of_cortical_region</rdfs:label>
