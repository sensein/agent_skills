        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2009-08-06</NEMO_annot:modified_date>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">spatial_anatomical_quality</NEMO_annot:pref_label>
        <NEMO_annot:definition rdf:datatype="&xsd;string">spatial_anatomical_quality is a spatial property of an entity that is located in an anatomically defined spatial region.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">spatial_anatomical_quality is...</NEMO_annot:onto_definition>
