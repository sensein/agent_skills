                                                <owl:withRestrictions rdf:parseType="Collection">
                                                    <rdf:Description>
                                                        <xsd:maxExclusive rdf:datatype="&xsd;decimal">0.0</xsd:maxExclusive>
                                                    </rdf:Description>
                                                </owl:withRestrictions>
                                            </rdfs:Datatype>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-04-10</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-04-10</NEMO_annot:modified_date>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curran, T. (1999: p. 771-785). Full citation: Curran, T. (1999). The electrophysiology of incidental and intentional retrieval: ERP old/new effects in lexical decision and recognition memory. Neuropsychologia, 37, 771–785.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">P600</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Rugg, M. D., &amp; Curran, T. (2007). Event-related potentials and recognition memory. Trends in Cognitive Sciences, 11, 251-257</NEMO_annot:definition_source>
        <NEMO_annot:definition rdf:datatype="&xsd;string">The parietal_new_old_effect is the inverse of the parietal_new_old_effect.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">The parietal_old_new_effect is_a scalp_recorded_ERP_diffwave
     that is_specified_output_of SOME subtraction_data_transformation
           that has_specified_input SOME averaged_EEG_data_set
                 that is_about SOME scalp_recorded_ERP
                        that occurs_in_response_to SOME experimental_paradigm_execution
                               that is_realization_of SOME plan
                                     that is_concretization of SOME old_new_episodic_memory_paradigm 

and has_proper_part SOME peak_latency_measurement_datum
       that has_numeric_value SOME decimal[&gt;=&quot;400&quot;, &lt;=&quot;700&quot;]

and has_proper_part SOME intensity_measurement_datum
       that has_numeric_value SOME decimal[&gt;=&quot;0.4&quot;]
       that is_quality_measurement_of SOME intensity
            that inheres_in SOME scalp_recorded_ERP
                that unfolds_in SOME parietal_scalp_surface_region
</NEMO_annot:onto_definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">memory_related_P600</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Tim_Curran"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
        <NEMO_annot:evidence_code rdf:resource="&ontology;NEMO_annotation_properties.owl#traceable_author_statement"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_7018000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_7018000">
        <rdfs:label xml:lang="en">centrotemporal_scalp_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO_annotation_properties.owl#_limbo"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-06-08</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2013-09-16</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A centrotemporal_scalp_surface_region is a region of the scalp surface that includes electrodes  A left_parietal_scalp_surface_region is a region of the scalp surface that includes electrodes FT7, FT9, FT8, FT10, T7, T9, T8, and T10 (international 10-10 system). 

It is lateral to the central scalp surface region and rostral to the posterotemporal scalp surface region.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A frontotemporal_scalp_surface_region is a regional_part_of_scalp_surface_region that is the exact location_of some  frontotemporal_scalp_surface.</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">anterotemporal_scalp_region</NEMO_annot:synonym>
        <NEMO_annot:comment>In the NEMO toolkit, the centrotemporal_scalp_surface_region includes the following international 10-10 channels: FT7, FT9, T7, and T9 (left); FT8, FT10, T8, and T10 (right). </NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


