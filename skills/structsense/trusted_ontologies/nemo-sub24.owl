    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_1139000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_1139000">
        <rdfs:label rdf:datatype="&xsd;string">overshoot</rdfs:label>
        <rdfs:subClassOf rdf:resource="&span;Process"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;has_participant"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000315"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Overshoot is a process that leads to increased amplitude of a portion of a nonsinusoidal wave caused by the particular characteristics of an amplifier.  It may be used to decrease the response time of a signal by decreasing the rise time, decreasing the fall time, or both.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Submitted to NIF in November 2010.</NEMO_annot:comment>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Weik, M. (2000).  Computer science and communications dictionary (1st ed., Vols. 1-2). Boston: Kluwer Academic Publishers.</NEMO_annot:definition_source>
        <NEMO_annot:comment rdf:datatype="&xsd;string">When the phase shift in the pass band is not linearly dependent on the frequency of the sinusoidal component, the filtered signal generally exhibits overshoot” (Sherman-Gold, R. (1993). The axon guide for electrophysiology &amp; biophysics laboratory techniques.  Sunnyvale, CA: Molecular Devices.).</NEMO_annot:comment>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">overshoot</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">overshoot is a process... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Anita_Bandrowski"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Usman_Khan"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


