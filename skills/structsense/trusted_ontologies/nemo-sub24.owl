                                                            <rdf:Description>
                                                                <xsd:minInclusive rdf:datatype="&xsd;decimal">350</xsd:minInclusive>
                                                            </rdf:Description>
                                                        </owl:withRestrictions>
                                                    </rdfs:Datatype>
                                                    <rdfs:Datatype>
                                                        <owl:onDatatype rdf:resource="&xsd;decimal"/>
                                                        <owl:withRestrictions rdf:parseType="Collection">
                                                            <rdf:Description>
                                                                <xsd:maxInclusive rdf:datatype="&xsd;decimal">550</xsd:maxInclusive>
                                                            </rdf:Description>
                                                        </owl:withRestrictions>
                                                    </rdfs:Datatype>
                                                </owl:intersectionOf>
                                            </rdfs:Datatype>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-11-16</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-06-08</NEMO_annot:modified_date>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Johnson &amp; Hamm, 2000; Frishkoff, et al., 2004</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">P4</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">P400</NEMO_annot:synonym>
        <NEMO_annot:definition rdf:datatype="&xsd;string">The frontopolar_P400 is a positivity that is maximal over frontopolar scalp regions at about 350-550 ms after onset of a meaningful stimulus (typically, a word) and is more positive when the stimulus is semantically unexpected or hard to integrate with the preceding context. </NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">The frontopolar_P400 is_a scalp-recorded_ERP_extracted_pattern 

and has_proper_part SOME peak_latency_measurement_datum
       that has_numeric_value SOME decimal[&gt;=&quot;350&quot;, &lt;=&quot;550&quot;]

and has_proper_part SOME intensity_measurement_datum
       that has_numeric_value SOME decimal[&gt;=&quot;0.4&quot;]
       that is_quality_measurement_of SOME intensity
            that inheres_in SOME scalp_recorded_ERP
                that unfolds_in SOME frontopolar_scalp_surface_region

and proper_part_of SOME averaged_EEG_data_set
       that has_provenance_specification SOME event_type_label
            that has_character_string_value SOME &quot;stimulus_onset&quot;
       and has_provenance_specification SOME stimulus_type_label
            that has_character_string_value SOME &quot;linguistic_object&quot;</NEMO_annot:onto_definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">frontopolar_P400</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
        <NEMO_annot:evidence_code rdf:resource="&ontology;NEMO_annotation_properties.owl#traceable_author_statement"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_7933000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_7933000">
        <rdfs:label rdf:datatype="&xsd;string">electrical_admittance</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_1750000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&OBO_REL;inheres_in"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000172"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Electrical admittance is the disposition of a material to admit to an electric current when a potential difference (i.e., a voltage) is applied.  </NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">Electrical_admittance is a disposition that inheres_in some biomaterial_object and [... incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">See also Ohm&apos;s Law</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Systems Biology Ontology ID 0000254</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">The reciprocal of electrical_admittance is electrical_impedance.</NEMO_annot:comment>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Weik, M. (2000). Computer science and communications dictionary (1st ed., Vols. 1-2). Boston: Kluwer Academic Publishers.</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">admittance</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">electrical_admittance</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Anita_Bandrowski"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Usman_Khan"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_7944000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_7944000">
        <rdfs:label rdf:datatype="&xsd;string">global_map_dissimilarity_algorithm</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000481"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2009-06-06</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-04-25</NEMO_annot:modified_date>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A global_map_dissimilarity_algorithm is an algorithm that is realized through implementation of (code)....</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Murray, M. M., Brunet, D., &amp; Michel, C. M. (2008). Topographic ERP analyses: a step-by-step tutorial review. Brain Topogr, 20(4), 249-264.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">global_map_dissimilarity_algorithm</NEMO_annot:pref_label>
        <NEMO_annot:definition rdf:datatype="&xsd;string">global_map_dissimilarity_algorithm is an algorithm for transforming continuous time series data into discrete intervals based on discontinuities in global (topographic ERP) maps.</NEMO_annot:definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">microstate_analysis</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_7969000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_7969000">
        <rdfs:label rdf:datatype="&xsd;string">CON_ROI_label</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;IAO_0000009"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-01</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-06-13</NEMO_annot:modified_date>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">CON_ROI_label</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">CON_ROI_label is label_of some CON_ROI?</NEMO_annot:onto_definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Has corresponding term in Bob Frank&apos;s NEMO_ERP_Metric_Extraction matlab script: CON_ROI_Label</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Specifies for each spatiotemporal component pair the scalp-surface region of interest containing the CON_EGI / CON_ITT electrode label location. The CON_ROI_Label is the concatenation of the scalp-surface region&apos;s position on a lateral (Left, Right, Bilateral) and anterior-posterior axis (Orbitofrontal, Frontal, Anterotemporal, Parietal, Posterotemporal, Occipital), respectively.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">deprecate?</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_7977000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_7977000">
        <rdfs:label xml:lang="en">correlation_statistic</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0709000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2011-11-22</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-11-22</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A correlation_statistic, often abbreviated as r, measures the degree of relationship between pairs of interval variables in a sample. The range of correlation is from -1.00 to zero to +1.00. 2) A non-cause and effect relationship between two variables.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://writing.colostate.edu/guides/research/glossary/</NEMO_annot:definition_source>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">inferential_statistic is a data_item that is_about SOME data_set</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_7981000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_7981000">
        <rdfs:label xml:lang="en">inferential_test_statistic</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0264000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-05-11</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-05-11</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">An inferential test statistic is a test statistic that is calculated for a given sample (dataset) and provides an estimate of the corresponding population parameter. </NEMO_annot:definition>
