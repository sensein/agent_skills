    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4603000">
        <rdfs:label rdf:datatype="&xsd;string">electrical_resistance</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_1750000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&OBO_REL;inheres_in"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000172"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:created_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">AOD 0000001076</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Alcohol and Other Drug Thesaurus ID 0000001076</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">CSP 0996-9979</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Computer Retrieval of Information on Scientific Projects (CRISP) ID 0996-9979</NEMO_annot:comment>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Electrical resistance is the disposition of a material to oppose to an electric current when a potential difference (i.e., a voltage) is applied.    Resistance (R) is equal to the voltage applied across the resistor (V) over the electric current through the resistor (I).</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">Electrical_resistance is a disposition that inheres_in some biomaterial_object and [... incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">MSH D017097</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Medical Subject Headings ID D017097</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NCI C0162535</NEMO_annot:synonym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">National Cancer Institute Metathesaurus ID C0162535</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Ontology of Physics for Biology ID 00151</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">R = V/I</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">SBO_0000254</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">See also Ohm&apos;s Law</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Systems Biology Ontology ID 0000254</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">The reciprocal of electrical_resistance is electrical_conductance.</NEMO_annot:comment>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Weik, M. (2000). Computer science and communications dictionary (1st ed., Vols. 1-2). Boston: Kluwer Academic Publishers.</NEMO_annot:definition_source>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">electrical_resistance</NEMO_annot:pref_label>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://bhi.washington.edu/OPB#OPB_00151</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/CSP/0996-9979</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D017097</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.org/obo/owl/SBO#SBO_0000254</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">measured in siemans</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">ohmic_resistance</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">resistance</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Anita_Bandrowski"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
