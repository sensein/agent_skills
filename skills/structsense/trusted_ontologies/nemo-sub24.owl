    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_6329000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_6329000">
        <rdfs:label rdf:datatype="&xsd;string">global_map_dissimilarity</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_6525000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-08</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">GMD</NEMO_annot:synonym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">GMD</NEMO_annot:acronym>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Global Map Dissimilarity is equal to the Global Field Power (root mean square across all electrodes) of a difference map computed from two normalized EEG or MEG topographic maps.</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Lehmann, D. and Skrandies, W. (1980) Reference-free identification of components of checkerboard-evoked multichannel potential fields. Electroencephalography and Clinical Neurophysiology, vol. 48 pp. 609-621.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">global_map_dissimilarity</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">global_map_dissimilarity is a descriptive_statistic that is_about SOME electrophysiological_data_set</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://www.acnp.org/G4/GN401000090/CH089.html</NEMO_annot:definition_source>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_6332000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_6332000">
