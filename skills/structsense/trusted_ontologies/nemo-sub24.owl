        <NEMO_annot:created_date rdf:datatype="&xsd;string">2013-06-09</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2013-06-09</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">An experiment condition in which the target stimulus is a word or other meaningful object that has been affectively primed.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_functional</NEMO_annot:namespace>
