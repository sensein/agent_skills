    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_6767000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_6767000">
        <rdfs:label xml:lang="en">mid_central_scalp_surface</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7291000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_7291000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-06-18</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-06-18</NEMO_annot:modified_date>
