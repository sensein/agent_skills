    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_2796000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_2796000">
        <rdfs:label xml:lang="en">f_statistic</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7981000"/>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-05-11</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-05-11</NEMO_annot:created_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">An f_statistic is used to determine whether three or more samples are likely to have been drawn from the same or different distributions (i.e., whether the central tendency and spread are statistically equivalent, or not). It is computed as the ratio of two scaled sums of squares, each of which follows a scaled chi-squared distribution.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Analysis_of_variance</NEMO_annot:definition_source>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">inferential_statistic is a data_item that is_about SOME data_set</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_2813000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_2813000">
        <rdfs:label rdf:datatype="&xsd;string">condition_of_interest</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_2012000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-06-06</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-08-07</NEMO_annot:modified_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">See also condition_for_comparison. Derived measures based on difference between condition_of_interest and condition_for comparison define a contrast in a particular analysis (e.g., for computing t-tests or difference waves in an ERP experiment).</NEMO_annot:comment>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Specifies the experimental condition under which the respective ERP data were obtained. It stands in contrast to the &quot;comparison condition&quot;: a distinct experimental condition under which a separate set of ERP data were obtained for the purpose of contrasting ERP components induced under two distinct experimental conditions.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">condition_of-interest is a role that inheres_in a... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">condition_of_interest</NEMO_annot:pref_label>
        <NEMO_annot:comment rdf:datatype="&xsd;string">has_label (condition_of_interest, cell_standard_condition_label)</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_2816000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_2816000">
        <rdfs:label xml:lang="en">mean_intensity_MORB</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO_annotation_properties.owl#_limbo"/>
