    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_8449000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_8449000">
        <rdfs:label rdf:datatype="&xsd;string">Brodmann_area_36_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7920000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-22</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-01-14</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Area ectorhinalis</NEMO_annot:synonym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">B09-36</NEMO_annot:acronym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">B09-36</NEMO_annot:synonym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">BA36</NEMO_annot:acronym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann (1909) area 36</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann Area 36</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann area 36</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann.36</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">Brodmann_area_36_surface_region</NEMO_annot:pref_label>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Brodmann_area_36_surface_region is a subdivision of the cytoarchitecturally defined temporal region of cerebral cortex. With its medial boundary corresponding approximately to the rhinal sulcus it is located primarily in the fusiform gyrus. Cytoarchitecturally it is bounded laterally and caudally by the inferior temporal area 20, medially by the perirhinal area 35 and rostrally by the temporopolar area 38 (H) (Brodmann-1909).</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">Brodmann_area_36_surface_region is a two_dimensional_region that is the location of SOME regional_part_of_cortical_surface</NEMO_annot:onto_definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Formerly NN-70 in NeuroNames</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-600975193</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-918</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">NeuroNames concept ID NN-2410</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Umlscui C1272497</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 36 of Brodmann (human)</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 36 of Brodmann-1909</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">birnlex_1769</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">ectorhinal</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">ectorhinal area 36</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://psychology.wikia.com/wiki/Brodmann_area_36</NEMO_annot:definition_source>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
