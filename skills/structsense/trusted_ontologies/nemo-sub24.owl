        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://www.w3.org/TR/owl-features/</NEMO_annot:definition_source>
        <NEMO_annot:definition rdf:datatype="&xsd;string">owl data format uses a family of knowledge representation languages for building ontologies (OWL-DL, OWL-Lite, OWL-S etc.). These languages are characterised by strict formal semantics and RDF/XML based serializations suitable for the Semantic Web applications.</NEMO_annot:definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">owl_data_format</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">owl_data_format is a quality that inheres_in some data_item and is the concretization of some owl_data_format_specification.</NEMO_annot:onto_definition>
