    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_1582000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_1582000">
        <rdfs:label rdf:datatype="&xsd;string">chinese</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_5315000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-24</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Alternate names for Chinese are: Beifang Fangyan, Guanhua, Guoyu, Hanyu, Mandarin, Northern Chinese, Putonghua, Standard Chinese. </NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Chinese is SOV (Subject-Verb-Object) language belonging to Chinese makro-language of Sino-Tibetan family.</NEMO_annot:comment>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Chinese is an SOV (Subject-Verb-Object) language belonging to Chinese makro-language of the Sino-Tibetan family. It is spoken by over 850 million people living primarily in the People&apos;s Republic of China, and also in Brunei, Cambodia, Canada, Indonesia (Java and Bali), Laos, Libya, Malaysia (Peninsular), Mauritius, Mongolia, Mozambique, Philippines, Russian Federation (Asia), Singapore, Taiwan, Thailand, United Kingdom, United States, Viet Nam and Zambia. </NEMO_annot:definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Chinese language</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Lewis, M. Paul (ed.), 2009. Ethnologue: Languages of the World, Sixteenth edition. Dallas, TX.: SIL International. Online version: http://ethnologue.com/.</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Mandarin</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Modern Standard Chinese</NEMO_annot:synonym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_functional</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Putonghua</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">SNOMED CT ID 297876005</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Standard Mandarin</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Writing systems used for Chinese are: Han script simplified variant (jiantizi) in use from 1956 CE, Han script traditional variant (fantizi), Bopomofo script. </NEMO_annot:comment>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">chinese</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">chinese is_a human_language....</NEMO_annot:onto_definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/SNOMEDCT/297876005</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_1591000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_1591000">
        <rdfs:label rdf:datatype="&xsd;string">range_statistic</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_4358000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-08</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A range_statistic is a statistical measurement that represents the spread (or dispersion) of a set of data points. It is defined as the length of the smallest interval that contains all the data. It is calculated by subtracting the smallest value in a data aset (sample_minimum) from the largest value (sample_maximum).</NEMO_annot:definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NCI C38013</NEMO_annot:synonym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://bobhall.tamu.edu/FiniteMath/Module8/Introduction.html</NEMO_annot:definition_source>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Range_(statistics)</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#Range</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.org/net/OCRe/statistics.owl#Range</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">range</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">range value is measured in the same units as the data. Since it only depends on two of the observations, it is a poor and weak measure of dispersion except when the sample size is large.</NEMO_annot:comment>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">range_statistic</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">range_statistic is a descriptive_statistic that is_about SOME data_set</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_1599000 -->

