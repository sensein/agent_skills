        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-08-02</NEMO_annot:modified_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_temporal</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">temporal_quality</NEMO_annot:pref_label>
        <NEMO_annot:definition rdf:datatype="&xsd;string">temporal_quality is a quality that inheres in an entity that is temporally extended (i.e., an occurrent).</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">temporal_quality is a quality that...</NEMO_annot:onto_definition>
