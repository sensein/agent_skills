    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0541000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0541000">
        <rdfs:label xml:lang="en">unnamed_positive_MPAR_effect</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_0877000"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&ro;has_proper_part"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_0603000"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&obo;OBI_0000298"/>
                                        <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_9658000"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_7943000"/>
                                        <owl:someValuesFrom>
                                            <rdfs:Datatype>
                                                <owl:onDatatype rdf:resource="&xsd;decimal"/>
                                                <owl:withRestrictions rdf:parseType="Collection">
                                                    <rdf:Description>
                                                        <xsd:minExclusive rdf:datatype="&xsd;decimal">0.0</xsd:minExclusive>
                                                    </rdf:Description>
                                                </owl:withRestrictions>
                                            </rdfs:Datatype>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-05-20</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-05-20</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">An unnamed_positive_MPAR_effect is a positivity that is significant over the mid parietal region of the scalp.</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


