        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.org/OCRe/statistics.owl#Median</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://www.cvrgrid.org/files/ECGOntologyv0.1.7.owl#ECG_000000169</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">median</NEMO_annot:pref_label>
        <NEMO_annot:definition rdf:datatype="&xsd;string">median is the middle value of a set of ordered observations. When there is an even number of observations the median is the average of two values that fall either side of what would be the middle value.</NEMO_annot:definition>
