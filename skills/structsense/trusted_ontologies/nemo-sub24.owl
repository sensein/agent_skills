    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_7899000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_7899000">
        <rdfs:label rdf:datatype="&xsd;string">CON_3D_coordinate_datum</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;IAO_0000403"/>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-05-05</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-06</NEMO_annot:created_date>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">CON_3D is a three_dimensional_cartesian_spatial_coordinate_datum that inheres_in... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">CON_3D_coordinate_datum</NEMO_annot:pref_label>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Specifies the center of negativity (CON) as a point on the 3-D flat map at which all negative electrical potential at the scalp-surface electrodes can be equivalently located. Computationally, it is analogous to a center of mass calculation with electrode potentials replaced by point masses.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">has_part (CON_xCoord_3D); has_part (CON_yCoord_3D); has_part (CON_zCoord_3D); is_about (CON_3D); has_coordinate_unit_label (??)</NEMO_annot:comment>
