    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0993000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0993000">
        <rdfs:label rdf:datatype="&xsd;string">morph</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000409"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-12-13</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-07-02</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A morph is the physical realization of a morpheme, which is the smallest distinctive unit of a language that has a meaning or grammatical function (or both).</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">A morph is usually the realization of a particular morpheme. However, there is not always a one-to-one mapping between morphemes and morphs; some morphemes are realized by more than one morph, depending on their position in a word or a sentence. Alternative forms of a morph are called allomorphs or morphemic variants. For example, in English the plural suffix morpheme /-Z/ is realized by several distinct allomorphs ( [s], [z], [SCHWAz] and [-iz]).</NEMO_annot:comment>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Crystal, D. (2003) A Dictionary of Linguistics and Phonetics. 5th Ed. Blackwell Publishing, Oxford, UK, pp. 300.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_functional</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Spencer, A. (1991) Morphological Theory. Blackwell Publishing, Oxford, UK, pp. 4-6, 40-42.</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">allomorph</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">allomorphs</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">has_quality (auditory or visual)
has_proper_part (sound or letter)</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">morphemic variant</NEMO_annot:synonym>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">ontoDefinition text goes HERE</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0994000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0994000">
