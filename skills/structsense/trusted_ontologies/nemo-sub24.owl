        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">Action_potential_overshoot is a biological process... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Purves D, Augustine GJ, Fitzpatrick D, et al. (Eds.), 2001. Neuroscience (2nd ed). Sunderland (MA): Sinauer Associates.</NEMO_annot:definition_source>
        <NEMO_annot:definition rdf:datatype="&xsd;string">The overshoot of an action potential is the peak, positive-going phase of the action potential, caused by high membrane permeability to a cation such as Na+ or Ca2+.</NEMO_annot:definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">action_potential_overshoot</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Anita_Bandrowski"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Usman_Khan"/>
