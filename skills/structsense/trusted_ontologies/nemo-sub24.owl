    <!-- http://purl.obolibrary.org/obo/IAO_0000003 -->

    <owl:Class rdf:about="&obo;IAO_0000003">
        <rdfs:label rdf:datatype="&xsd;string">measurement_unit_label</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;IAO_0000009"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-22</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-05-26</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A measurement unit label is as a label that is part of a scalar measurement datum and denotes a unit of measure.</NEMO_annot:definition>
        <NEMO_annot:source_ontology rdf:datatype="&xsd;string">Information Artifact Ontology (IAO)</NEMO_annot:source_ontology>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_imported_classes</NEMO_annot:namespace>
