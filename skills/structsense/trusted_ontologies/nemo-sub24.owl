        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:created_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Distributed neural processing is simultaneous, coordinated processing of information in multiple, spatially separated areas in the brain. </NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Kandel, E.R., Schwartz, J.H., &amp; Jessell, T.M. (Eds.). (1995). Essentials of neural science and behavior. Stamford, CT: Appleton &amp; Lange.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Submitted to NIF in November 2010.</NEMO_annot:comment>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">Synaptic_integration is a biological process... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">distributed_neural_processing</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Anita_Bandrowski"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Usman_Khan"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4867000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4867000">
        <rdfs:label rdf:datatype="&xsd;string">data_dimensionality</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7399000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-25</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-05-06</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Data_dimensionality is the dimension of a space or object that is characterized by the minimum number of coordinates needed to specify each point within it. In algebraic terms, the dimension of a data set is the number of vectors in any basis for the data space, i.e. the number of coordinates necessary to specify any vector. This notion of dimension (the cardinality of a basis) is often referred to as the Hamel dimension or algebraic dimension to distinguish it from other notions of dimension. The dimension of a vector space may alternatively be characterized as the trace of the identity operator.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">cardinality of a basis set</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">data_dimensionality</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">data_dimensionality  is a quality that inheres_in some data_set.</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Dimension#Dimension_of_a_vector_space</NEMO_annot:definition_source>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Dimension_%28vector_space%29</NEMO_annot:definition_source>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4869000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4869000">
        <rdfs:label rdf:datatype="&xsd;string">xls_data_format</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_1194000"/>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">...[incomplete]</NEMO_annot:definition_source>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-25</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-07-02</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A data format created by Microsoft Excel software that conforms to Excel Binary File Format (.xls) Structure Specification that specifies the Excel Binary File Format which is collection of records and structures that specify  a workbook content, which can include unstructured or semi-structured tables of numbers, text, or  both numbers and text, formulas, external data connections, charts and images. Workbook content is typically organized in a grid based layout, and often includes numeric data, structured data, and formulas.
</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">xls_data_format</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">xls_data_format  is a quality that inheres_in some data_item and is the concretization of some xls_data_format_specification.</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4870000 -->

