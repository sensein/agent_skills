    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_6644000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_6644000">
        <rdfs:label rdf:datatype="&xsd;string">Brodmann_area_3_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7920000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-22</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-10-14</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Area postcentralis oralis</NEMO_annot:synonym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">B09-3</NEMO_annot:acronym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">B09-3</NEMO_annot:synonym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">BA3</NEMO_annot:acronym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Bowden, D. M., &amp; Dubach, M. F. (2003). NeuroNames 2002. Neuroinformatics, 1(1), 43-59.</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann (1909) area 3</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann area 3</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">Brodmann_area_3_surface_region</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">Brodmann_area_3_surface_region is a two_dimensional_region that is the location of SOME regional_part_of_cortical_surface</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Brodmann_area_3_surface_region refers to a cytoarchitecturally defined portion of cerebral cortex of the guenon that is located predominantly in the postcentral gyrus, but ventrally in a portion of the precentral gyrus as well. Brodmann-1909 regarded it as topographically and cytoarchitecturally homologous to the human rostral postcentral area 3. Distinctive features (Brodmann-1905): compared to area 1 of Brodmann-1909 and area 2 of Brodmann-1909 the cortical thickness of area 3 is unusually thin, in fact, among the thinnest areas of the cerebral cortex; the cells of sublayer 3b of the external pyramidal layer (III) are smaller, plumper and more densely distributed in a tighter strip; cells of the internal granular layer (IV) are distributed more sparsely; the internal pyramidal layer (V) is relatively clear with scattered large to very large pyramid shaped ganglion cells separated by tangentially oriented fiber bundles; the multiform layer (VI) is composed of a dense population of homogeneously distributed cells such that sublayers are absent and the boundary with the subcortical white matter is distinct. According to Roberts-63 the external granular layer (II), layer III and layer IV are not clearly demarcated from each other and are all densely packed with small cells.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Formerly NN-35 in NeuroNames</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-1757604902</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-829</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">NeuroNames concept ID NN-2393</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Umlscui C1272525</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 3 of Brodmann (human)</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 3 of Brodmann-1909</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">birnlex_1734</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">rostral postcentral</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">rostral postcentral area 3</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_6651000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_6651000">
        <rdfs:label rdf:datatype="&xsd;string">phrase</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000409"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-12-13</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-07-02</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A phrase is a unit of syntactic structure that consists of two or more words, but lacks the subject-predicate structure that is typical of a clause. It is seen as a part of a structural hierarchy, falling between words and clauses.
</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Crystal, D. (2003) A Dictionary of Linguistics and Phonetics. 5th Ed. Blackwell Publishing, Oxford, UK, pp. 214-215, 352-353.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_functional</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">The defining element in a phrase is called the grammatical &quot;head.&quot; The head of a clause is distributionally equivalent to the phrase as a whole and determines the type of the phrase. For example the head of a noun phrase (NP) is a noun, the head of a prepositional phrase (PP)  is a preposition, and the head of a verb phrase (VP) is a verb.</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">has_quality (auditory or visual)
has_proper_part (word)</NEMO_annot:comment>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Phrase</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://semanticscience.org/resource/SIO_000483</NEMO_annot:synonym>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">ontoDefinition text goes HERE</NEMO_annot:onto_definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">phrases</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_6663000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_6663000">
        <rdfs:label rdf:datatype="&xsd;string">y_scalp_surface_axis</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_6023000"/>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-06-06</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2011-04-22</NEMO_annot:created_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A y_scalp_surface_axis is a directional term that is defined in reference to a two-dimensional scalp_surface coordinate system.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A y_scalp_surface_axis is a one_dimensional_region that is the proper_part_of some scalp_surface_region.</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">caudality_axis</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">y_scalp_surface_axis</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_6677000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_6677000">
        <rdfs:label rdf:datatype="&xsd;string">email_address</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_9801000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-31</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">An email_address is a sequence of alpha-numeric characters used as unique identifier of an email box, that is located on a particular email server, and  which is used by a person or an organization for purposes of email delivery or sending (i.e. email communication). Email address has two parts, the part before the &quot;@&quot; sign is the local-part of the address, often the username of the recipient, and the part after the &quot;@&quot; sign which is a domain name to which the e-mail message will be sent.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">email_address</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">email_address is a network_address that is_about SOME spatial_region</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Email_address</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#Email_Address</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/EDAM/EDAM_0001691</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_6688000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_6688000">
