    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_1000195">
        <rdfs:label rdf:datatype="&xsd;string">electroencephalographic_activity</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_5217000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;has_participant"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_1331000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-26</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-07-08</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A process that occurs when there is one or more changes in the brain&apos;s electrophysiological state. These changes may include modulation of global intensity of neural activity (e.g., a global increase or decrease) or modulation of intensity of activity in one or more brain regions.</NEMO_annot:definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">EEG_activity</NEMO_annot:synonym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">brain_electrophysiological_activity</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">electroencephalographic_activity</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">electroencephalographic_activity is physiological_brain_activity that...[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:synonym>brain electrical activity</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_1003000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_1003000">
        <rdfs:label>experimental_paradigm_execution</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;OBI_0000011"/>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-07-02</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2011-07-02</NEMO_annot:created_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_functional</NEMO_annot:namespace>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">presentation_of_a_stimulus is a study_design_execution that...[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">the execution of an experimental paradigm (protocol for presentation of a stimulus, delivery of experiment instruction, and collection of behavioral and brain responses).</NEMO_annot:definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_1009000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_1009000">
        <rdfs:label xml:lang="en">gustatory_representation</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_8593000"/>
        <NEMO_annot:definition rdf:datatype="&xsd;string">*A mental representation is an information_artifact_entity that &quot;is about&quot; some other entity.* 

*When a mental representation is about a perceived entity outside the body, it involves sensory-motor mapping, i.e., representation and control of the external environment.* 

*When it is about a perceived change within the body, it involves homeostatic processes, that is, representation or mapping and control of the internal milieux.* 

*A cognitive representation is the result of intermediate stages of processing that involve integration/coherence of multiple maps (e.g., multimodal processing, perceptual integration or &quot;binding&quot; of representations).*

*A mental representation is concretized as a particular  physiological state (i.e., pattern of activity) within the nervous system.*</NEMO_annot:definition>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-04-23</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-05-10</NEMO_annot:modified_date>
        <NEMO_annot:definition_source>curator.</NEMO_annot:definition_source>
        <NEMO_annot:synonym>mental map</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


