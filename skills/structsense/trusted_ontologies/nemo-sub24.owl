    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_1938000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_1938000">
        <rdfs:label rdf:datatype="&xsd;string">time_constant</rdfs:label>
