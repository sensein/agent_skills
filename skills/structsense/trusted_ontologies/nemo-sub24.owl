    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_1023000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_1023000">
        <rdfs:label rdf:datatype="&xsd;string">arabic</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_5315000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-08</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Al-Arabiyya</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Al-Fusha</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Alternate names for Arabic include Al-Arabiyya, Al-Fusha, Literary Arabic.</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Arabic is a VSO (Verb-Subject-Object) language that belongs to Southern sub-branch of Central Semitic languages of Afro-Asiatic language family.</NEMO_annot:comment>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Arabic is a VSO (Verb-Subject-Object) language that belongs to the Southern sub-branch of the Central Semitic languages of the Afro-Asiatic language family. It is spoken by over 206 million people (all Arabic varieties combined) primarily living in Saudi Arabia, and also in lgeria, Bahrain, Chad, Comoros, Djibouti, Egypt, Eritrea, Iraq, Israel, Jordan, Kuwait, Lebanon, Libya, Morocco, Oman, Palestinian West Bank and Gaza, Qatar, Somalia, Sudan, Syria, Tanzania, Tunisia, United Arab Emirates and Yemen.</NEMO_annot:definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Arabic language</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Arabic script is used for writing all varieties of Arabic.</NEMO_annot:comment>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Lewis, M. Paul (ed.), 2009. Ethnologue: Languages of the World, Sixteenth edition. Dallas, TX.: SIL International. Online version: http://ethnologue.com/.</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Literary Arabic</NEMO_annot:synonym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_functional</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">SNOMED CT ID 297324003</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Term definition refers to standard Arabic.</NEMO_annot:comment>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">arabic</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">arabic is a human_language that...[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/SNOMEDCT/297324003</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


