    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0125000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0125000">
        <rdfs:label rdf:datatype="&xsd;string">COP_ROI_label</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;IAO_0000009"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-01</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-08-07</NEMO_annot:modified_date>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">COP_ROI_label</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">COP_ROI_label is label_of some COP_ROI?</NEMO_annot:onto_definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Has corresponding term in Bob Frank&apos;s NEMO_ERP_Metric_Extraction matlab script: COP_ROI_Label</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Specifies for each spatiotemporal component pair the scalp-surface region of interest containing the COP_EGI / COP_ITT electrode label location. The COP_ROI_Label is the concatenation of the scalp-surface region&apos;s position on a lateral (Left, Right, Bilateral) and anterior-posterior axis (Orbitofrontal, Frontal, Anterotemporal, Parietal, Posterotemporal, Occipital), respectively.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">deprecate?</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0131000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0131000">
        <rdfs:label rdf:datatype="&xsd;string">large_adult_head_size</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_3917000"/>
        <NEMO_annot:definition rdf:datatype="&xsd;string">...[incompete]</NEMO_annot:definition>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-05-05</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-05</NEMO_annot:created_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">large_adult_head_size</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">large_adult_head_size is a head_size_quality that inheres in some head.</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
