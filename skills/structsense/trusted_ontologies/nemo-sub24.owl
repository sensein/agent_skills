    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_3085000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_3085000">
        <rdfs:label rdf:datatype="&xsd;string">scalp_electrode_impedance</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_4928000"/>
        <NEMO_annot:definition rdf:datatype="&xsd;string">.. [incomplete]</NEMO_annot:definition>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-22</NEMO_annot:created_date>
