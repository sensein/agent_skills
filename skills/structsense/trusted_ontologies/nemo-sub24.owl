    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4094000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4094000">
        <rdfs:label xml:lang="en">mean_intensity_RCTEMP_EXT</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_9201000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;IAO_0000221"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="&PATO;PATO_0000049"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="&OBO_REL;inheres_in"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_8225000"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="&OBO_REL;unfolds_in"/>
                                                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_4305000"/>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-06-18</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-06-18</NEMO_annot:created_date>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Has corresponding term in Bob Frank&apos;s NEMO_ERP_Metric_Extraction matlab script: Mean_Intensity_RCTEMP_EXT</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">mean_intensity_RCTEMP_EXT is a mean_intensity_measurement_datum 
  and (is_quality_measurement_of SOME intensity 
     and (inheres_in SOME scalp_recorded_ERP 
          and (unfolds_in SOME right_inferior_centrotemporal_scalp_surface_region)))</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">mean_intensity_RCTEMP_EXT specifies the mean electrical potential, in microvolts, over all electrodes within the right inferior centrotemporal scalp ROI.</NEMO_annot:definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4098000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4098000">
        <rdfs:label xml:lang="en">z_statistic</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7981000"/>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-11-22</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2011-11-22</NEMO_annot:created_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A z_statistic (aka &quot;standard score&quot;) indicates how many standard deviations an observation or datum is above or below the mean. It is a dimensionless quantity derived by subtracting the population mean from an individual raw score and then dividing the difference by the population standard deviation. </NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Z_statistic</NEMO_annot:definition_source>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">inferential_statistic is a data_item that is_about SOME data_set</NEMO_annot:onto_definition>
        <NEMO_annot:synonym>z-score</NEMO_annot:synonym>
        <NEMO_annot:synonym>normal score</NEMO_annot:synonym>
        <NEMO_annot:synonym>z-value</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4101000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4101000">
        <rdfs:label rdf:datatype="&xsd;string">electrical_dipole_field</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_1000000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-09-08</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-09-10</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">An electrical dipole field (a charge dipole, not a current dipole) at any location of the scalp (or brain) is the &quot;net&quot; field due to presence of both charges. Two (fixed) charges of equal magnitude but opposite sign form an charge dipole.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Nunez, P.L. &amp; Srinivasan, R. (2006). Electric fields of the brain: The neurophysics of EEG (2nd Ed.), (pp. 108-111). New York: Oxford University Press.</NEMO_annot:definition_source>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">electrical_dipole_field</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">electrical_dipole_field is a material_entity_quality that...[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Anita_Bandrowski"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Usman_Khan"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


