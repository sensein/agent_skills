    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4612000">
        <rdfs:label rdf:datatype="&xsd;string">standard_deviation</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_4358000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-05</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Field, Andy. (2009) Discovering Statistics Using SPSS (Introducing Statistical Methods) 3rd Ed. Sage Publications, Ltd. London, UK.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NPO_1804</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">NanoParticleOntology ID NPO_1804</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">SNOMED CT ID R-10047</NEMO_annot:comment>
        <NEMO_annot:definition rdf:datatype="&xsd;string">The standard_deviation of a data set is an estimate of the average variability (spread) of the data distribution, measured in the same units of measurement as the original data. It is equal to the positive square root of the variance. </NEMO_annot:definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#Variance</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/SNOMEDCT?3866136009</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/npo#NPO_1804</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">standard_deviation</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">standard_deviation is a descriptive_statistic that is_about SOME data_set</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


