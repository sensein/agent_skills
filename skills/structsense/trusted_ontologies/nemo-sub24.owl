    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4334000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4334000">
        <rdfs:label rdf:datatype="&xsd;string">maximum_value</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_8203000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-06</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Sample_maximum_and_minimum</NEMO_annot:definition_source>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://www.mathworks.com/help/toolbox/stats/brn2ivz-29.html</NEMO_annot:definition_source>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">maximum_value</NEMO_annot:pref_label>
        <NEMO_annot:definition rdf:datatype="&xsd;string">maximum_value is a summary statistic used to represent the largest value in a set of independent, identically distributed random values.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">maximum_value is an extreme_value that is_about SOME data_set</NEMO_annot:onto_definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">sample maximum</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4335000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4335000">
        <rdfs:label rdf:datatype="&xsd;string">ground_electrode</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_5952000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-08-07</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-11-19</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">CMR</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Daube, J. R., Rubin, D. I. (2009) Clinical Neurophysiology (Contemporary Neurology). Oxford University Press, UK, pp. 19.</NEMO_annot:definition_source>
        <NEMO_annot:comment rdf:datatype="&xsd;string">EEG recording from a human subject is conductively isolated from the ground of the power supply. The amplifier internal ground is also isolated from the ground of the power supply. Cerebral sources and electrophysiological artifacts generate scalp potential differences V2(t) - V1(t) (where a  time &apos;t&apos; may be interpreted as a post stimulus onset latency). Environmental electric and magnetic fields also generate scalp potentials typically due mostly to capacitive coupling </NEMO_annot:comment>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Fisch, B. J. (Fisch and Spehlmann&apos;s EEG Primer: Basic Principles of Digital and Analog EEG.(1999) Elsevier, p. 69.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Nunez, P. L., Srinivasan, Ramesh (2006) Electric fields of the brain. The neurophysics of EEG. Oxford University Press, pp. 277.</NEMO_annot:definition_source>
        <NEMO_annot:definition rdf:datatype="&xsd;string">The ground electrode is linked to the &quot;common&quot; (zero level) of power supply to the EEG system amplifer. Note that this power supply is actually isolated from the electrode ground (by law). Indeed, the &quot;ground&quot; electrode is *never* linked to the electrical ground; doing so could create ground loops, which would present a safety hazard (risk of electrical shock). The term &quot;ground&quot; is therefore a misnomer, strictly speaking, and the term &quot;isolated common&quot; is sometimes used instead. Note that the EEG ground (isolated common) is distinct from the EEG reference electrode.</NEMO_annot:definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">common_mode_rejection</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">ground_electrode</NEMO_annot:pref_label>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://www.focused-technology.com/electrode.htm</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">internal ground electrode</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">isolated common</NEMO_annot:synonym>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">ontoDefinition text goes HERE</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


