        <NEMO_annot:synonym rdf:datatype="&xsd;string">D003700 </NEMO_annot:synonym>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Gamma wave activity is an oscillation in brain electrical (EEG) activity in the frequency range of 25-80 Hz.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Neurolex Def: &quot;is a pattern of brain waves, with a frequency between 25 to 100 Hz, though 40 Hz is prototypical. According to a popular theory, gamma waves may be implicated in creating the unity of conscious perception (aka the binding problem) (adapted from Wikipedia). &quot;</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Not in NCI metathesaurus (http://ncim-stage.nci.nih.gov)</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">gamma oscillation</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">gamma rhythym</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">gamma wave</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">gamma_wave_activity</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">gamma_wave_activity</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">gamma_wave_activity is a type of oscillatory_brain_electrical_activity that...[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
