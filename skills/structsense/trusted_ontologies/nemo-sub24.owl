    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_1514000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_1514000">
        <rdfs:label rdf:datatype="&xsd;string">Brodmann_area_23_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7920000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-22</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-01-04</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Area cingularis posterior ventralis</NEMO_annot:synonym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">B09-23</NEMO_annot:acronym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">B09-23</NEMO_annot:synonym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">BA23</NEMO_annot:acronym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Bowden, D. M., &amp; Dubach, M. F. (2003). NeuroNames 2002. Neuroinformatics, 1(1), 43-59.</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann (1909) area 23</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann area 23</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">Brodmann_area_23_surface_region</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">Brodmann_area_23_surface_region is a two_dimensional_region that is the location of SOME regional_part_of_cortical_surface</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Brodmann_area_23_surface_region refers to a subdivision of the cerebral cortex of the guenon defined on the basis of cytoarchitecture. Brodmann regarded it as topographically and cytoarchitecturally homologous to the combined ventral posterior cingulate area 23 and dorsal posterior cingulate area 31 of the human (Brodmann-1909). Distinctive Features (Brodmann-1905): the cortex is relatively thin; smaller cells predominate; the cell density of the multiform layer (VI) is great, producing a distinct boundary with the subcortical white matter; the internal granular layer (IV) is rather well developed; the internal pyramidal layer (V) contains a dense population of round, medium-sized ganglion cells concentrated at the border with layer IV; layers V and VI are narrow with a distinct mutual boundary.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Formerly NN-79 in NeuroNames</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-206874266</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-961</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">NeuroNames concept ID NN-2107</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Umlscui C1272541</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 23 of Brodmann (human)</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 23 of Brodmann-1909</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">birnlex_1754</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">ventral posterior cingulate</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">ventral posterior cingulate area 23</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_1518000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_1518000">
        <rdfs:label xml:lang="en">shifting_attention</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_4320000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-04-23</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-04-23</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">a cognitive_process is a mental process engaging one or more systems in the intermediary or integrative processing of signals from the internal (visceral) and external (somatic) environments. It is often the result of a sensory_process (bottom-up cognition). It may be mediated by an emotion_process (motivated cognition) or by another cognitive_process, such as memory or expectancy based on prior experience (top-down cognition).</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">mental_process is a brain_physiological_process that...[incomplete]</NEMO_annot:onto_definition>
        <rdfs:comment>To be replaced by concepts from cogATLAS....</rdfs:comment>
        <NEMO_annot:definition_source>curator.</NEMO_annot:definition_source>
        <NEMO_annot:synonym>http://ontology.neuinfo.org/NIF/Function/NIF-Function.owl#birnlex_1800</NEMO_annot:synonym>
        <NEMO_annot:synonym>cognition</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_1525000 -->

