        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-15</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-03-19</NEMO_annot:modified_date>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curran, T. (1999: p. 771-785). Full citation: Curran, T. (1999). The electrophysiology of incidental and intentional retrieval: ERP old/new effects in lexical decision and recognition memory. Neuropsychologia, 37, 771–785.</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">N4</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">N400</NEMO_annot:synonym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Rugg, M. D., &amp; Curran, T. (2007). Event-related potentials and recognition memory. Trends in Cognitive Sciences, 11, 251-257</NEMO_annot:definition_source>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">The fN400_old_new_effect is a scalp_recorded_ERP_diffwave
     that is_specified_output_of SOME subtraction_data_transformation
           that has_specified_input SOME averaged_EEG_data_set
                 that is_about SOME scalp_recorded_ERP
                        that occurs_in_response_to SOME experimental_paradigm_execution
                               that is_realization_of SOME plan
                                     that is_concretization of SOME 

(old_new_episodic_memory_paradigm OR word_repetition_paradigm)
      
and has_proper_part SOME peak_latency_measurement_datum
       that has_numeric_value (300-500ms)

and has_proper_part SOME intensity_measurement_datum
       that is_about SOME scalp_report_ERP
            that bearer_of SOME negative_polarity
       and that unfolds_in SOME frontocentral_scalp_surface_region</NEMO_annot:onto_definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">fN400</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">fN400_new_old_effect</NEMO_annot:pref_label>
        <NEMO_annot:definition rdf:datatype="&xsd;string">fN400_old_new_effect is a negativity over frontocentral scalp ROI at about 300-500 ms after the onset of a stimulus that is significantly larger (more negative) to unfamiliar (novel) versus familiar stimuli.</NEMO_annot:definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">frontocentral_N400</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Tim_Curran"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
        <NEMO_annot:evidence_code rdf:resource="&ontology;NEMO_annotation_properties.owl#traceable_author_statement"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_6718000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_6718000">
        <rdfs:label rdf:datatype="&xsd;string">tonal_sound</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000411"/>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">...[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-03-30</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2011-03-30</NEMO_annot:created_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A tonal_sound is a sound wave with a periodic frequency that is characterized by its duration, pitch, intensity (loudness), and timbre (quality).</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_functional</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Tones</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Musical_tone</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://www.cogpo.org/ontologies/COGPO_00164</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">musical tone</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">tone</NEMO_annot:synonym>
