    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4132000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4132000">
        <rdfs:label rdf:datatype="&xsd;string">surface_electrocorticogram_measurement_protocol</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_2504000"/>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-04-25</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-25</NEMO_annot:created_date>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A surface_electrocorticogram_measurement_protocol is a protocol that...</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A surface_electroencephalographic_data_measurement_protocol is a protocol that specifies the experiment context in which electroencaphalographic data are measured on the cortical (brain) surface.</NEMO_annot:definition>
