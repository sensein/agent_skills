    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_2390877 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_2390877">
        <rdfs:label>unnamed_positive_LCENT_effect</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
