        <NEMO_annot:pref_label rdf:datatype="&xsd;string">regional_part_of_cortical_surface_region</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">regional_part_of_cortical_surface_region is a two_dimensional_region that is the location_of some regional_part_of_cortical_surface.</NEMO_annot:onto_definition>
