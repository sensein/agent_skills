    <!-- http://purl.obolibrary.org/obo/IAO_0000030 -->

    <owl:Class rdf:about="&obo;IAO_0000030">
        <rdfs:label rdf:datatype="&xsd;string">information_content_entity</rdfs:label>
        <rdfs:subClassOf rdf:resource="&snap;GenericallyDependentContinuant"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2009-06-07</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-04-24</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">An information content entity is an entity that is generically dependent on some artifact and stands in relation of aboutness to some entity.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Be careful to distinguish from realizable_information_entity</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Imported into NEMO_data, NEMO_functional</NEMO_annot:comment>
        <NEMO_annot:source_ontology rdf:datatype="&xsd;string">Information Artifact Ontology (IAO)</NEMO_annot:source_ontology>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_imported_classes</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://purl.obolibrary.org/obo/IAO_0000030</NEMO_annot:definition_source>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">information_content_entity</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#direct_import"/>
    </owl:Class>
    


