    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_2361000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_2361000">
        <rdfs:label rdf:datatype="&xsd;string">evoked_electroencephalographic_activity</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_1000195"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_4917000"/>
                <owl:someValuesFrom rdf:resource="&span;TemporalInterval"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&OBO_REL;unfolds_in"/>
                <owl:someValuesFrom rdf:resource="&snap;SpatialRegion"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_0367000"/>
                <owl:someValuesFrom rdf:resource="&span;ProcessualEntity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-06-13</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-12-29</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">EP</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">ERP</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">ERP_activity</NEMO_annot:synonym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">averaged_electroencephalographic_activity</NEMO_annot:pref_label>
        <NEMO_annot:definition rdf:datatype="&xsd;string">event-related brain activity is a process that occurs when there are changes in brain electrical potentials (ERPs) over time in response to some (internal or external) event, e.g, the onset of a stimulus, response, or psychophysiological process (such as the peak of the QRS complex). </NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">event_related_brain_electrical_activity is electroencephalographic_activity that unfolds_in some brain and occurs_in_response_to some process (such as the onset of a visual or auditory stimulus).</NEMO_annot:onto_definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">evoked brain electrical activity</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_2367000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_2367000">
        <rdfs:label>prime_stimulus</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000468"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2011-05-29</NEMO_annot:created_date>
