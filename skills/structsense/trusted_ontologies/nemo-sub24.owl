    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_3717000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_3717000">
        <rdfs:label rdf:datatype="&xsd;string">language_disorder</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_5159000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-30</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-07-02</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A language disorder is a communication disorder characterized by an impaired ability of comprehension or expression of spoken and/or written forms of human language. It includes both acquired and developmental language disorders.</NEMO_annot:definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">CRISP Thesaurus ID 1579-3194</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Language disorders are characterized by one or more of the following features: sound substitutions in words, difficulty in processing sounds into syllables and words, improper use of words, confusion about their meaning, difficulty in expressing ideas and thoughts, inappropriate use of grammatical forms, limited vocabulary development and inability to follow directions, remember questions or numbers and letters in sequence.</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">MSH2010_2010_02_22:D007806</NEMO_annot:synonym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_functional</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">National Drug File ID C3736</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">OMIM2009_05_01:MTHU006526</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">SNOMEDCT_2010_1_31:62305002</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">UMLS CUI C0023015</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">UMLS CUI C0454651</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/CSP/1579-3194</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/CSP/1579-3194</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/NDFRT/C3736</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.org/obo/owl/DOID#DOID_93</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://www.enotes.com/nursing-encyclopedia/language-disorders</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">language disorders</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">language_disorder</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">language_disorder is a disease_state that...[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


