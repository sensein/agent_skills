    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4995000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4995000">
        <rdfs:label rdf:datatype="&xsd;string">Brodmann_area_11_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7920000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-22</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-12-15</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Area praefrontalis</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">B09-11</NEMO_annot:synonym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">B09-11</NEMO_annot:acronym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">BA11</NEMO_annot:acronym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Bowden, D. M., &amp; Dubach, M. F. (2003). NeuroNames 2002. Neuroinformatics, 1(1), 43-59.</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann (1909) area 11</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann area 11</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">Brodmann_area_11_surface_region</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">Brodmann_area_11_surface_region is a two_dimensional_region that is the location of SOME regional_part_of_cortical_surface</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Brodmann_area_11_surface_region refers to a subdivision of the frontal lobe of the guenon defined on the basis of cytoarchitecture (Brodmann-1905). Distinctive features: area 11 lacks an internal granular layer (IV); larger pyramidal cells of sublayer 3b of the external pyramidal layer (III) merge with a denser self-contained collection of cells in the internal pyramidal layer (V); similar to area 10 of Brodmann-1909 is the presence in the multiform layer (VI) of trains of cells oriented parallel to the cortical surface separated by acellular fiber bundles; a thick molecular layer (I); a relatively narrow overall cortical thickness; and a gradual transition from the multiform layer (VI) to the subcortical white matter.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Formerly NN-63 in NeuroNames</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-891</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-892</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">NeuroNames concept ID NN-2117</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Umlscui C1272533</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 11 of Brodmann (human)</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 11 of Brodmann-1909</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">birnlex_1742</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">prefrontal</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">prefrontal area 11</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_5003000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_5003000">
        <rdfs:label rdf:datatype="&xsd;string">regional_part_of_scalp_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7737000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_7737000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;location_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_9466000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-14</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-06-08</NEMO_annot:modified_date>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A regional_part_of_scalp_surface_region is a regional_part_of_anatomical_surface_region that is the location_of some regional_part_of_scalp_surface.</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A regional_part_of_scalp_surface_region is a two-dimensional spatial region, whose coordinates are defined with respect to anatomical landmarks on and within the scalp. The spatial subdivisions of the scalp reflect subdivisions of the skull, which are named after the four major lobes of the cerebral cortex — i.e., frontal, temporal, parietal, and occipital. Subclasses of regional_part_of_scalp_surface_region are also referred to as scalp regions-of-interest (ROI). These ROI define the 2-D spatial coordinates for defining EEG and ERP patterns that are measured on the scalp surface.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">As of May 2012, the NEMO ERP consortium has adopted a revised electrode clustering scheme, which is characterized by a 4 (caudality) by 5 (laterality) design.</NEMO_annot:comment>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">regional_part_of_scalp_surface_region</NEMO_annot:pref_label>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">scalp ROI</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">scalp region-of-interest</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_5028000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_5028000">
        <rdfs:label xml:lang="en">strongly_negatively_aroused</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7709000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-07-23</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-07-23</NEMO_annot:modified_date>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Strongly_negatively aroused is a quality that momentarily inheres in some brain or brain part and that constitutes a &quot;snapshot&quot; in time of certain types of emotional process (e.g., anxiety, anger, panic, stress, fear).</NEMO_annot:definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


