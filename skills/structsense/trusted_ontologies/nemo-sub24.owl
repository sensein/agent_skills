    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0816000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0816000">
        <rdfs:label rdf:datatype="&xsd;string">motor_bereitschaftspotential</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_0000093"/>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="&ro;has_proper_part"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_6902000"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="&obo;IAO_0000221"/>
                                                <owl:someValuesFrom>
                                                    <owl:Class>
                                                        <owl:intersectionOf rdf:parseType="Collection">
                                                            <rdf:Description rdf:about="&PATO;PATO_0000049"/>
                                                            <owl:Restriction>
                                                                <owl:onProperty rdf:resource="&OBO_REL;inheres_in"/>
                                                                <owl:someValuesFrom>
                                                                    <owl:Class>
                                                                        <owl:intersectionOf rdf:parseType="Collection">
                                                                            <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_8225000"/>
                                                                            <owl:Restriction>
                                                                                <owl:onProperty rdf:resource="&OBO_REL;unfolds_in"/>
                                                                                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000006"/>
                                                                            </owl:Restriction>
                                                                        </owl:intersectionOf>
                                                                    </owl:Class>
                                                                </owl:someValuesFrom>
                                                            </owl:Restriction>
                                                        </owl:intersectionOf>
                                                    </owl:Class>
                                                </owl:someValuesFrom>
                                            </owl:Restriction>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_7943000"/>
                                                <owl:someValuesFrom>
                                                    <rdfs:Datatype>
                                                        <owl:onDatatype rdf:resource="&xsd;decimal"/>
                                                        <owl:withRestrictions rdf:parseType="Collection">
                                                            <rdf:Description>
                                                                <xsd:maxInclusive rdf:datatype="&xsd;decimal">-.4</xsd:maxInclusive>
                                                            </rdf:Description>
                                                        </owl:withRestrictions>
                                                    </rdfs:Datatype>
                                                </owl:someValuesFrom>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_0000495"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="&obo;IAO_0000136"/>
                                                <owl:someValuesFrom>
                                                    <owl:Class>
                                                        <owl:intersectionOf rdf:parseType="Collection">
                                                            <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_8225000"/>
                                                            <owl:Restriction>
                                                                <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_0367000"/>
                                                                <owl:someValuesFrom>
                                                                    <owl:Class>
                                                                        <owl:intersectionOf rdf:parseType="Collection">
                                                                            <rdf:Description rdf:about="&ontology;NEMO.owl#NEMO_5167000"/>
                                                                            <owl:Restriction>
                                                                                <owl:onProperty rdf:resource="&obo;OBI_0000316"/>
                                                                                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000467"/>
                                                                            </owl:Restriction>
                                                                        </owl:intersectionOf>
