    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_3238000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_3238000">
        <rdfs:label rdf:datatype="&xsd;string">web_address</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_9801000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-31</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A web_address (website_address) is a unique identifier assigned to a web server connected to the Internet that serves as a host to some website. web_address may have a form of a human readable sequence of alpha-numeric characters, i.e. Universal Resource Locator (URL, e.g. http://nemo.nic/uoregon.edu), or it may be in form of the human readable sequence of dot (or colon) separated numbers, i.e. IP address (e.g. 131.96.164.31 in IPv4 or 2001:db8:0:1234:0567 in IPv6).</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">URL</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Uniform Resource Location</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">web_address</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">web_address is a network_address that is_about SOME spatial_region</NEMO_annot:onto_definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">website address</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


