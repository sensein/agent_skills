        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-07-23</NEMO_annot:modified_date>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A physiological_state is a disposition that inheres_in some biomaterial_object </NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A physiological_state is a momentary quality of some biomaterial entity and constitutes a &quot;snapshot&quot; of some ongoing physiological process.</NEMO_annot:definition>
