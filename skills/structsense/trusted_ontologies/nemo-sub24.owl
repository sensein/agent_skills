    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_6265000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_6265000">
        <rdfs:label rdf:datatype="&xsd;string">french</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_5315000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-08</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Francais</NEMO_annot:synonym>
        <NEMO_annot:definition rdf:datatype="&xsd;string">French is an SVO (Subject-Verb-Object) language that belongs to the Indo-European language family. It is part of the Oil subgroup of Gallo-Raetian group of Gallo-Romance languages within the Western Gallo_Iberian sub-branch of the Western Italo-Western sub-branch of the Italic Romance languages. It is spoken by over 68 million people primarily living in France, and also in Algeria, Andorra, Austria, Belgium, Benin, Burkina Faso, Burundi, Cambodia, Cameroon, Canada, Central African Republic, Chad, Comoros, Congo, Côte d’Ivoire, Democratic Republic of the Congo, Djibouti, Equatorial Guinea, French Guiana, French Polynesia, Gabon, Guadeloupe, Guinea, Haiti, India, Israel, Italy, Lebanon, Libya, Luxembourg, Madagascar, Mali, Martinique, Mauritania, Mauritius, Mayotte, Monaco, Morocco, Mozambique, New Caledonia, Niger, Philippines, Puerto Rico, Réunion, Rwanda, Saint Pierre and Miquelon, Saudi Arabia, Senegal, Seychelles, South Africa, Switzerland, Togo, Tunisia, United Arab Emirates, United Kingdom, United States, U.S. Virgin Islands, Vanuatu, and Wallis and Futuna.</NEMO_annot:definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">French language</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Lewis, M. Paul (ed.), 2009. Ethnologue: Languages of the World, Sixteenth edition. Dallas, TX.: SIL International. Online version: http://ethnologue.com/.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_functional</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">SNOMED CT ID 297499001</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Writing script: Latin.</NEMO_annot:comment>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">french</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">french is_a human_language....</NEMO_annot:onto_definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/SNOMEDCT/297499001</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


