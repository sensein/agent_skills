    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0000411 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0000411">
        <rdfs:label rdf:datatype="&xsd;string">sound</rdfs:label>
        <rdfs:subClassOf rdf:resource="&snap;Object"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2009-06-07</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-03-30</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A sound is a longitudinal mechanical wave that is composed of frquencies within the range of human hearing (approximately 20Hz - 20 kHz).</NEMO_annot:definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">CRISP Thesaurus 2322-9777</NEMO_annot:synonym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_functional</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">RCD Xa0xW</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">The subjective sensation of hearing is due to stimulation of hearing organs by sound vibrations.</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">UMLS CUI C0037709</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Sound</NEMO_annot:definition_source>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#Sound</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/CSP/2322-9777</NEMO_annot:synonym>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">ontoDefinition text goes HERE</NEMO_annot:onto_definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">sound wave</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">sound waves</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0000412 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0000412">
        <rdfs:label rdf:datatype="&xsd;string">picture</rdfs:label>
        <rdfs:subClassOf rdf:resource="&snap;Object"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2009-06-07</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-03-30</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A picture is a visual representation of one ore more objects, persons, or scenes, that is painted, drawn, photographed, or otherwise rendered on a physical surface.</NEMO_annot:definition>
