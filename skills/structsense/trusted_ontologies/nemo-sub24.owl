    <!-- http://purl.obolibrary.org/obo/OBI_0000066 -->

    <owl:Class rdf:about="&obo;OBI_0000066">
        <rdfs:label rdf:datatype="&xsd;string">investigation</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;OBI_0000011"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-23</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-05-16</NEMO_annot:modified_date>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Imported into NEMO_functional</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_imported_classes</NEMO_annot:namespace>
        <NEMO_annot:source_ontology rdf:datatype="&xsd;string">Ontology for Biomedical Investigations (OBI)</NEMO_annot:source_ontology>
        <NEMO_annot:definition rdf:datatype="&xsd;string">a planned process that consists of parts: planning, study design execution, documentation and which produce conclusion(s).</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">has_part: study_design_execution, presentation_of_a_stimulus, experiment_instruction instructions to subject; i.e., task), assay (recording biological and behavioral response to stimulus)</NEMO_annot:comment>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://purl.obolibrary.org/obo/OBI_0000066</NEMO_annot:definition_source>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">investigation</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#direct_import"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0000097 -->

