        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">SNOMEDCT_252792007</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Submitted to NIF in November 2010.</NEMO_annot:comment>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">magnetoencephalographic_activity</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">magnetoencephalographic_activity is a physiological_brain_activity that...</NEMO_annot:onto_definition>
