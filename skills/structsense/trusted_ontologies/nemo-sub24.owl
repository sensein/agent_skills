                                        <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                                        <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000495"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_7943000"/>
                                        <owl:someValuesFrom>
                                            <rdfs:Datatype>
                                                <owl:onDatatype rdf:resource="&xsd;decimal"/>
                                                <owl:withRestrictions rdf:parseType="Collection">
                                                    <rdf:Description>
                                                        <xsd:maxExclusive rdf:datatype="&xsd;decimal">0.0</xsd:maxExclusive>
                                                    </rdf:Description>
                                                </owl:withRestrictions>
                                            </rdfs:Datatype>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2011-07-03</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-03-19</NEMO_annot:modified_date>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">MMN</NEMO_annot:acronym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">MMN</NEMO_annot:synonym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Naatanen, R., Paavilainen, P., Rinne, T., &amp; Alho, K. (2007). The mismatch negativity (MMN) in basic research of central auditory processing: a review. Clin Neurophysiol, 118(12), 2544-2590.</NEMO_annot:definition_source>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">The auditory_mismatch_negativity is_a scalp_recorded_ERP_diffwave
     that is_specified_output_of SOME subtraction_data_transformation
           that has_specified_input SOME averaged_EEG_data_set
                 that is_about SOME scalp_recorded_ERP
                        that occurs_in_response_to SOME experimental_paradigm_execution
                               that is_realization_of SOME plan
                                     that is_concretization of SOME 

(auditory_oddball_discrimination_paradigm OR auditory_mismatch_negativity_paradigm)

and has_proper_part SOME peak_latency_measurement_datum
       that has_numeric_value SOME decimal[&gt;=&quot;100&quot;, &lt;=&quot;200&quot;]

and has_proper_part SOME intensity_measurement_datum
       that has_numeric_value SOME decimal[&lt;=&quot;-0.4&quot;]
       that is_quality_measurement_of SOME intensity
            that inheres_in SOME scalp_recorded_ERP
                that unfolds_in SOME frontocentral_scalp_surface_region
</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">auditory_mismatch_negativity_effect is a signifcantly increased negativity  over frontocentral scalp regions at about 100-200 ms after onset of an auditory stimulus that is infrequent, unexpected, or rare (&quot;oddball condition), as compared with an auditory baseline (&quot;standard condition&quot;).</NEMO_annot:definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">mismatch_negativity</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0632000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0632000">
        <rdfs:label rdf:datatype="&xsd;string">turkish</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_5315000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-08</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Alternate names for Turkish include Anatolian, Türkçe, Türkisch.</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Anatolian</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Lewis, M. Paul (ed.), 2009. Ethnologue: Languages of the World, Sixteenth edition. Dallas, TX.: SIL International. Online version: http://ethnologue.com/</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_functional</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">SNOMED CT ID 297363005</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Turkce</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Turkisch</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Turkish is an SOV (Subject-Verb-Object) language that belongs to the Southern Turkic sub-branch of the Altaic language family.</NEMO_annot:comment>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Turkish is an SOV (Subject-Verb-Object) language that belongs to the Southern Turkic sub-branch of the Altaic language family. It is spoken by  over 50 million people primarily living in Turkey, and also in Australia, Austria, Azerbaijan, Belgium, Bosnia and Herzegovina, Bulgaria, Canada, Cyprus, Denmark, Egypt, El Salvador, Finland, France, Georgia, Germany, Greece, Honduras, Iran, Iraq, Israel, Kazakhstan, Kyrgyzstan, Macedonia, Netherlands, Romania, Russian Federation (Asia), Serbia, Sweden, Switzerland, Tajikistan, Ukraine, United Arab Emirates, United Kingdom, United States and Uzbekistan.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Writing script: Latin, since 1928/1929 CE.</NEMO_annot:comment>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">turkish</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">turkish is_a human_language....</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


