    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0949000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0949000">
        <rdfs:label rdf:datatype="&xsd;string">gain_measurement_datum</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;IAO_0000032"/>
        <NEMO_annot:definition rdf:datatype="&xsd;string">&quot;gain is a measure of the ability of a circuit (often an amplifier) to increase the power or amplitude of a signal from the input to the output. It is usually defined as the mean ratio of the signal output  of a system to the signal input  of the same system. It may also be defined on a logarithmic scale, in terms of the decimal logarithm of the same ratio (&quot;dB gain.&quot; (http://en.wikipedia.org/wiki/Gain)</NEMO_annot:definition>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-22</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-04-24</NEMO_annot:modified_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">gain_measurement_datum</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">gain_measurement_datum is a scalar_measurement_datum that is_about SOME gain</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Gain</NEMO_annot:definition_source>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Chris_Bird"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


