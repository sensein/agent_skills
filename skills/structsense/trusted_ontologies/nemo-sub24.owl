    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_9551000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_9551000">
        <rdfs:label rdf:datatype="&xsd;string">Brodmann_area_10_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7920000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-22</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-12-15</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Area frontopolaris</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">B09-10</NEMO_annot:synonym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">B09-10</NEMO_annot:acronym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">BA10</NEMO_annot:acronym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Bowden, D. M., &amp; Dubach, M. F. (2003). NeuroNames 2002. Neuroinformatics, 1(1), 43-59.</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann (1909) area 10</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann area 10</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">Brodmann_area_10_surface_region</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">Brodmann_area_10_surface_region is a two_dimensional_region that is the location of SOME regional_part_of_cortical_surface</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Brodmann_area_10_surface_region refers to a subdivision of the frontal lobe of the guenon defined on the basis of cytoarchitecture. Brodmann-1909 did not regard it as cytoarchitecturally homologous to his human frontopolar area 10. Distinctive features (Brodmann-1905): compared to area 9 of Brodmann-1909, the multiform layer (VI) of area 10 shows an unusual organization of cells into trains oriented parallel to the cortical surface that are separated from one another by narrow cell-free fiber bundles; less marked differences are an overall thinner cortical thickness and a somewhat thicker molecular layer (I). Compared to area 6 of Brodmann-1909, area 10 has a subtle but clearly present internal granular layer (IV); layer 3b of the of the external pyramidal layer (III) is weakly developed and composed of medium sized pyramidal cells; and the internal pyramidal layer (V) is more developed.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Formerly NN-56 in NeuroNames</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-858156939</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-864</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">NeuroNames concept ID NN-2405</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Umlscui C1272532</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 10 (H) of Brodmann</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 10 of Brodmann (human)</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 10 of Brodmann-1909</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">birnlex_1741</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">frontopolar</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">frontopolar area 10</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


