    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_8289000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_8289000">
        <rdfs:label xml:lang="en">depression</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7984000"/>
