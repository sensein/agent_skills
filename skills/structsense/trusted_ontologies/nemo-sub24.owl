        <NEMO_annot:definition rdf:datatype="&xsd;string">An event_related_latency is a TemporalInstant for which the corresponding temporal_measurement_datum is time-locked to an ERP_event of interest.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">An event_related_latency is a temporal_instant that...[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_temporal</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">event_related_latency</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
