            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2009-05-07</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-04-28</NEMO_annot:modified_date>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">ITT_TP10_location</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">ITT_TP10_location is an ITT_electrode_location that is a proper_part_of some right_posterotemporal_scalp_surface_region and is disjoint with ITT_PO8, ITT_PO10, ITT_P8, ITT_P10, ITT_T8, ITT_TP8.</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">International 10-10 channel TP10 (ITT_TP10) is a standard location on the scalp surface that is located in the right_posterotemporal_scalp_surface_region. It is rostral_to ITT_P10 and right_of ITT_TP8.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
