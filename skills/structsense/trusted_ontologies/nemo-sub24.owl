    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_8306000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_8306000">
        <rdfs:label xml:lang="en">central_nervous_system</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_8651000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000174"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:definition rdf:datatype="&xsd;string">* Organ with organ cavity which consists of gray matter and white matter. Examples: There is only one neuraxis. (UWDA) * The main information-processing organs of the nervous system, consisting of the brain, spinal cord, and meninges. (MSH) * The part of the nervous system that consists of the brain, spinal cord, and meninges. (NCI) * main information processing organs of the nervous system, consisting of the brain, spinal cord, and meninges. (CSP)</NEMO_annot:definition>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-05-08</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-05-08</NEMO_annot:modified_date>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">CNS</NEMO_annot:acronym>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">central_nervous_system is a regional_part_of_anatomical_entity that has_proper_part some brain and has_proper_part some spinal_cord.</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://ontology.neuinfo.org/NIF/Backend/OBO_annotation_properties.owl#UMLS_defSource</NEMO_annot:definition_source>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#direct_import"/>
    </owl:Class>
    


