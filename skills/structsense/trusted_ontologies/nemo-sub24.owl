        <NEMO_annot:synonym rdf:datatype="&xsd;string">OPB_00446</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Ontology of Physics for Biology ID 00446</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">PATO_0002205</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Phenotypic Quality ID 0002205</NEMO_annot:comment>
