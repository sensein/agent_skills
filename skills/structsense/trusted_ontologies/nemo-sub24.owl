        <NEMO_annot:synonym rdf:datatype="&xsd;string">childhood dysphasia</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Specific_language_impairment</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://ihtsdo.org/snomedct/clinicalFinding#229746007</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/RCD/Ub1UY</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/SNOMEDCT/229746007</NEMO_annot:synonym>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">ontoDefinition text goes HERE</NEMO_annot:onto_definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">specific_language_impairment</NEMO_annot:pref_label>
