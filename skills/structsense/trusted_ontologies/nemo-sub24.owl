        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#Anomia</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D000849</NEMO_annot:synonym>
