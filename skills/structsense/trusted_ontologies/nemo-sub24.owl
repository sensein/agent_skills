        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-05-06</NEMO_annot:modified_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">has_measurement_unit_label (microvolt_unit_label);; has_proper_part (numeral)</NEMO_annot:comment>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">min_intensity_measurement_datum</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">min_intensity_measurement_datum is an intensity_measurement_datum that inheres in a data_set.</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">min_intensity_measurement_datum is an intensity_measurement_datum that specifies the minimum electrical potential, in microvolts, at some location and some time.</NEMO_annot:definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
