                                                            </rdf:Description>
                                                        </owl:withRestrictions>
                                                    </rdfs:Datatype>
                                                    <rdfs:Datatype>
                                                        <owl:onDatatype rdf:resource="&xsd;decimal"/>
                                                        <owl:withRestrictions rdf:parseType="Collection">
                                                            <rdf:Description>
                                                                <xsd:maxInclusive rdf:datatype="&xsd;decimal">600</xsd:maxInclusive>
                                                            </rdf:Description>
                                                        </owl:withRestrictions>
                                                    </rdfs:Datatype>
                                                </owl:intersectionOf>
                                            </rdfs:Datatype>
