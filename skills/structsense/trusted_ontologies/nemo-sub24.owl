        <NEMO_annot:comment rdf:datatype="&xsd;string">Computer Retrieval of Information on Scientific Projects (CRISP) ID 2059-2257</NEMO_annot:comment>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Kandel, E.R., Schwartz, J.H., &amp; Jessell, T.M. (Eds.). (1995). Essentials of neural science and behavior. Stamford, CT: Appleton &amp; Lange.</NEMO_annot:definition_source>
