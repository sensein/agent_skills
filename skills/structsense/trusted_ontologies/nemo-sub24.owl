     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:core="http://www.w3.org/2004/02/skos/core#"
     xmlns:NIF-Resource="http://ontology.neuinfo.org/NIF/DigitalEntities/NIF-Resource.owl#"
     xmlns:OBO_REL="http://purl.org/obo/owl/OBO_REL#"
     xmlns:span="http://www.ifomis.org/bfo/1.1/span#">
    <owl:Ontology rdf:about="&ontology;NEMO.owl">
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2009-08-11</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2013-10-21</NEMO_annot:modified_date>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">NEMO Ontologies</NEMO_annot:pref_label>
        <owl:incompatibleWith rdf:datatype="&xsd;string">NEMO.owl v1.20</owl:incompatibleWith>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Neural ElectroMagnetic Ontologies</NEMO_annot:synonym>
        <owl:versionInfo rdf:datatype="&xsd;string">v3.10</owl:versionInfo>
        <owl:imports rdf:resource="&ontology;NEMO_annotation_properties.owl"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <owl:imports rdf:resource="http://www.ifomis.org/bfo/1.1"/>
    </owl:Ontology>
    


