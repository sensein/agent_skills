    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_1194000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_1194000">
        <rdfs:label rdf:datatype="&xsd;string">data_format</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7399000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-25</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-07-02</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Data format specifies the structure of a computer file, that is, encoding of information that adheres to specifications pertaining to a specific type of the data to be stored, transferred or executed. There are different kinds of data formats for different kinds of information (including executable programs, word processing documents, graphic files and databases etc.), and within any data format type (e.g., word processor documents) there are typically several data formats.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">data_format</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">data_format  is a quality that inheres_in some data_item and is the concretization of some data_format_specification.</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://dret.net/glossary/dataformat</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.org/obo/owl/MS#MS_1011459</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.org/obo/owl/sep#sep_00047</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://www.pcmag.com/encyclopedia_term/0,2542,t=data+format&amp;i=43160,00.asp</NEMO_annot:definition_source>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">https://mli2.gov.mb.ca/glossary/a_d.html</NEMO_annot:definition_source>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">ttp://en.wikipedia.org/wiki/File_format</NEMO_annot:definition_source>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
