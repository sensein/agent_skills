    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_8086000">
        <rdfs:label rdf:datatype="&xsd;string">spanish</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_5315000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-08</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Alternate names: Castellano, Castilian, Español</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Castellano</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Castilian</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Espanol</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Lewis, M. Paul (ed.), 2009. Ethnologue: Languages of the World, Sixteenth edition. Dallas, TX.: SIL International. Online version: http://ethnologue.com/.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_functional</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">SNOMED CT ID 297510001</NEMO_annot:comment>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Spanish is an SVO (Subject-Verb-Object) language that belongs to the Indo-European language family. It is part of the Castilian subgroup of the West-Iberian group of Ibero-Romance languages, which belong to Western Gallo_Iberian sub-branch of the Western Italo-Western sub-branch of Italic Romance languages. It is spoken by over 320 million of people primarily living in Spain, but also in Andorra, Anguilla, Argentina, Aruba, Australia, Belgium, Belize, Bolivia, Canada, Cayman Islands, Chile, Colombia, Costa Rica, Cuba, Dominican Republic, Ecuador, El Salvador, Equatorial Guinea, Finland, France, Germany, Gibraltar, Guatemala, Honduras, Israel, Jamaica, Mexico, Morocco, Netherlands Antilles, Nicaragua, Norway, Panama, Paraguay, Peru, Philippines, Puerto Rico, Sweden, Switzerland, Trinidad and Tobago, United States, U.S. Virgin Islands, Uruguay and Venezuela.</NEMO_annot:definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Spanish language</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Writing script: Latin</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/SNOMEDCT/297510001</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">spanish</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">spanish is_a human_language....</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


