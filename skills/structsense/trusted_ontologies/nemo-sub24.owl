        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2013-09-16</NEMO_annot:modified_date>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A right_inferior_occipitotemporal_scalp_surface_region is a scalp_surface_region that is the exact location_of some right_occipitotemporal_scalp_surface.</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A right_occipitotemporal_scalp_surface_region is a region of the scalp surface that is right of some right_occipital_scalp_surface_region.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:comment>See also definition of &quot;occipital&quot; (NEMO_3632000) and &quot;right temporal&quot; (NEMO_3587000). The &lt;right_occipitotemporal_scalp_surface region&gt; has_quality &lt;occipital&gt; and has_quality &lt;right temporal&gt;.</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


