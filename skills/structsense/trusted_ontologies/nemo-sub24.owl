        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-26</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A frequency_measurement_datum is a measure of the frequency of occurrence of an event and is composed of two parts: a numeral (measured frequency value) and a unit label (Hz, referring to the SI unit of measure for frequency, where one Hertz equals one cycle per second).</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator</NEMO_annot:definition_source>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Definition for PATO_0000044 refers to frequency, not measurement of frequency.</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">PATO_0000044 </NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">frequency_measurement_datum</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">frequency_measurement_datum is a scalar_measurement_datum that is_about SOME frequency</NEMO_annot:onto_definition>
