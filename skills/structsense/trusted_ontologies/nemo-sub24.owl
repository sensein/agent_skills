    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_3116000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_3116000">
        <rdfs:label rdf:datatype="&xsd;string">COP_xCoord_3D</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_9128000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-01</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-06-13</NEMO_annot:modified_date>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">COP_xCoord_3D</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">COP_xCoord_3D is a ... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Has corresponding term in Bob Frank&apos;s NEMO_ERP_Metric_Extraction matlab script: COP_xCoord_3D</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Specifies for each spatiotemporal component pair the x-coordinate, in arbitrary units, of its center of electrical positivity (COP) in 3-D space. It is based upon the distribution of positive electrical potential  at montage-specific, scalp-surface electrode locations that are part of a reference scalp-surface region. The center of positivity (COP) is the point in 3-D space at which all positive electrical potential at the scalp-surface electrodes can be equivalently located. Computationally, it is analogous to a center of mass calculation with electrode potentials replaced by point masses. Note that COP_xCoord_3D is part of the head region, not the scalp-surface region, and does not index a scalp-surface region of interest.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">is_about (a point along an axis in three_dimensional_spatial_region)
is_about (COP_1D);
proper_part_of (COP_3D_coordinate_datum);
has_coordinate_unit_label (??)</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


