        <NEMO_annot:synonym rdf:datatype="&xsd;string">SNOMEDCT_15565008</NEMO_annot:synonym>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Spatial summation is the process by which temporally overlapping or consecutive signals add together or summate to produce a larger signal.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">Spatial_summation is a process... [incomplete]</NEMO_annot:onto_definition>
