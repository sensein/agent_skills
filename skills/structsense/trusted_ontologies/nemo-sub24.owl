        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000510"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-06</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-12</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A filtering_transformation is a process that separates and removes part of a signal or dataset in accordance with specified criteria.</NEMO_annot:definition>
