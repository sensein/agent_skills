    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_3091000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_3091000">
        <rdfs:label rdf:datatype="&xsd;string">Brodmann_area_24_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7920000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-22</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-01-04</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Area cingularis anterior ventralis</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">B09-24</NEMO_annot:synonym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">B09-24</NEMO_annot:acronym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">BA24</NEMO_annot:acronym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Bowden, D. M., &amp; Dubach, M. F. (2003). NeuroNames 2002. Neuroinformatics, 1(1), 43-59.</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann (1909) area 24</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann area 24</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">Brodmann_area_24_surface_region</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">Brodmann_area_24_surface_region is a two_dimensional_region that is the location of SOME regional_part_of_cortical_surface</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Brodmann_area_24_surface_region refers to a cytoarchitecturally defined cortical area that includes portions of the cingulate gyrus and the frontal lobe in the guenon. According to Walker-1940, in the macaque the molecular layer (I) is moderate in thickness; layer III is broad; layers V and VI are undifferentiated and narrow. The cells are of medium size, larger in the inner portion of layer III and outer portion of layer V, and irregularly dispersed. Walker regarded area 24 of the monkey as cytoarchitecturally homologous to the human ventral anterior cingulate area 24 and subgenual area 25.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Formerly NN-81 in NeuroNames</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-22855445</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-973</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">NeuroNames concept ID NN-2113</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Umlscui C1272542</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 24 of Brodmann (human)</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 24 of Brodmann-1909</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">birnlex_1755</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">ventral anterior cingulate</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">ventral anterior cingulate area 24</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_3096000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_3096000">
        <rdfs:label xml:lang="en">auditory_representation</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_8593000"/>
        <NEMO_annot:definition rdf:datatype="&xsd;string">*A mental representation is an information_artifact_entity that &quot;is about&quot; some other entity.* 

*When a mental representation is about a perceived entity outside the body, it involves sensory-motor mapping, i.e., representation and control of the external environment.* 

*When it is about a perceived change within the body, it involves homeostatic processes, that is, representation or mapping and control of the internal milieux.* 

*A cognitive representation is the result of intermediate stages of processing that involve integration/coherence of multiple maps (e.g., multimodal processing, perceptual integration or &quot;binding&quot; of representations).*

*A mental representation is concretized as a particular  physiological state (i.e., pattern of activity) within the nervous system.*</NEMO_annot:definition>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-04-23</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-05-10</NEMO_annot:modified_date>
        <NEMO_annot:synonym>mental map</NEMO_annot:synonym>
        <NEMO_annot:definition_source>curator.</NEMO_annot:definition_source>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


