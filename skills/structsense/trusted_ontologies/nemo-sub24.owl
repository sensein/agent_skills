        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-16</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-04-27</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A cortical_surface_region is a two dimensional spatial region that corresponds to the surface of brain cortex.</NEMO_annot:definition>
