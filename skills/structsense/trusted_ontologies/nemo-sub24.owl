    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_5451000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_5451000">
        <rdfs:label rdf:datatype="&xsd;string">CON_xCoord_2D</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_9128000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-01</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-06-13</NEMO_annot:modified_date>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">CON_xCoord_2D</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">CON_xCoord_2D is an one_dimensional_xccordinate_datum that... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Has corresponding term in Bob Frank&apos;s NEMO_ERP_Metric_Extraction matlab script: CON_xCoord_2D</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Specifies for each spatiotemporal component pair the x-coordinate, in arbitrary units, of its center of electrical negativity (CON) in 2-D space.  It is based upon the distribution of negative electrical potential at montage-specific, scalp-surface electrode locations that are part of a reference scalp-surface region projected onto a 2-D plane or flat map. The center of negativity (CON) is the point on the 2-D flat map at which all negative electrical potential at the scalp-surface electrodes can be equivalently located. Computationally, it is analogous to a center of mass calculation with electrode potentials replaced by point masses.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">is_about (a point along an axis in two_dimensional_spatial_region)
is_about (CON_1D);
proper_part_of (CON_2D_coordinate_datum);
has_coordinate_unit_label (??)</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_5452000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_5452000">
        <rdfs:label rdf:datatype="&xsd;string">acquired_dyslexia</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_3717000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-30</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-07-02</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Acquired dyslexia is a reading disorder that occurs following brain damage. Different patterns of brain damage are associated with different forms of acquired dyslexia. Peripheral dyslexias (neglect dyslexia, attentional dyslexia and pure alexia) that arise in the early visual perceptual processing stages affect the ability to process the visual forms of written words.  Central dyslexias (deep dyslexia, phonological dyslexia and surface dyslexia) affect the ability to understand and read aloud written words. </NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Ellis, A.W. (1993) Reading, Writing and Dyslexia, 2nd edn, Lawrence Erlbaum: Hove.</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">MSH2010_2010_02_22:D004411</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Medical Subject Headings (MSH) ID D004411</NEMO_annot:synonym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_functional</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">National Drug File (NDF) ID C2226</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Theories of the processing deficits underlying different forms of acquired dyslexia have been explained in terms of models of normal reading. One such model proposes a lexicon (or word store) of written (or orthographic) forms of words and a lexicon of spoken (or phonological) forms of words. These lexicons allow familiar orthographic and phonological word forms to be understood via pathways to the semantic system in which word meanings are stored. </NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">UMLS_CUI:C0013388</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">acquired alexia</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">acquired reading disorder</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">acquired word blindness</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">acquired_dyslexia</NEMO_annot:pref_label>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">alexia</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D004411</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D004411</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/NDRFT/C2226</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.org/obo/owl/DOID#DOID_4427</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://www.bookrags.com/tandf/acquired-dyslexia-tf/</NEMO_annot:definition_source>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">ontoDefinition text goes HERE</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_5454000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_5454000">
        <rdfs:label rdf:datatype="&xsd;string">spatial_sampling_rate</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_9734000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-09-10</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-09-10</NEMO_annot:modified_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">See also spatial_Nyquist,  sampling_density.</NEMO_annot:comment>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Spatial sampling rate is the frequency or rate at which an analog signal is sampled (i.e., digitized) over space. It is expressed as number of samples or cycles, per unit of space (e.g., per pixel).</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Weik, M. (2000). Computer science and communications dictionary (1st ed., Vols. 1-2). Boston: Kluwer Academic Pub.</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">spatial_sampling_frequency</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">spatial_sampling_rate</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">spatial_sampling_rate is a rate that... [incomplete]</NEMO_annot:onto_definition>
