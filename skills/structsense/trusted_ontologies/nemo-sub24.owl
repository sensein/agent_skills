    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_6160000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_6160000">
        <rdfs:label xml:lang="en">left_inferior_occipitotemporal_scalp_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000007"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;location_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_5550000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
