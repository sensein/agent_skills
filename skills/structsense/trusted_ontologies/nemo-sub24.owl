        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-04-27</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">An anatomical_surface_region is a two-dimensional region, whose coordinates are defined with respect to anatomical landmarks.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">An anatomical_surface_region is a two_dimensional_region that is the location_of an anatomical_surface.</NEMO_annot:onto_definition>
