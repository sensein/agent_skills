    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_5590000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_5590000">
        <rdfs:label xml:lang="en">peripheral_nervous_system</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_8651000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000174"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-05-08</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-05-08</NEMO_annot:created_date>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">PNS</NEMO_annot:acronym>
        <NEMO_annot:definition rdf:datatype="&xsd;string">The nervous system outside of the brain and spinal cord. The peripheral nervous system has autonomic and somatic divisions. The autonomic nervous system includes the enteric, parasympathetic, and sympathetic subdivisions. The somatic nervous system includes the cranial and spinal nerves and their ganglia and the peripheral sensory receptors.</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://ontology.neuinfo.org/NIF/Backend/OBO_annotation_properties.owl#MeSH_defSource</NEMO_annot:definition_source>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">peripheral_nervous_system is a regional_part_of_body that is disjoint with central_nervous_system.</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#direct_import"/>
    </owl:Class>
    


