        <NEMO_annot:synonym rdf:datatype="&xsd;string">neural_plasticity</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">neuronal_plasticity</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">neuroplasticity</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">plasticity</NEMO_annot:synonym>
