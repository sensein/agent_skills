    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_5088000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_5088000">
        <rdfs:label xml:lang="en">central_scalp_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_5003000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_0000035"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000006"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;location_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_7291000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ro;proper_part_of"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_5003000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2009-05-07</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2013-09-16</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A central_scalp_surface_region is a region of the scalp surface that includes electrodes FCz, FC1, FC2, Cz, C2, C2, FC3, FC5, C3, C5, FC4, FC6, C4, C6, FT7, FT9, T7, T9, FT8, FT10, T8, and T10 (international 10-10 system). 

It is rostral to the parietal_scalp_surface_region, caudal to the frontal_scalp_surface_region, and medial to the left and right centrotemporal scalp regions.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A frontocentral_scalp_surface_region is a regional_part_of_scalp_surface_region that is the exact location_of some  frontocentral_scalp_surface.</NEMO_annot:onto_definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">frontal_scalp_surface_region</NEMO_annot:synonym>
        <rdfs:comment>In the NEMO toolkit, the frontocentral_scalp_surface_region includes the following international 10-10 channels: Fz, FCz, F1, FC1, F2, FC2 (mid); F3, FC3, F5, FC5 (left); and F4, FC4, F6, FC6 (right). </rdfs:comment>
        <NEMO_annot:comment>See also definition of &quot;central&quot; (NEMO_0000188). The &lt;central_scalp_surface region&gt; has_quality &lt;central&gt;.</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


