    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_1684000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_1684000">
        <rdfs:label rdf:datatype="&xsd;string">digital_pen</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_8133000"/>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">...[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2011-03-28</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-03-28</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A digital_pen is a writing_device that captures the handwriting or brush strokes of a user, and digitizes the writing so that it can be uploaded to a computer and displayed on the computer monitor.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Typically, a digital pen comes with a Universal Serial Bus (USB) cradle, which is used to upload handwritten notes to a personal computer (PC). The pen looks like a regular ball-point pen and can be used as such, but requires special digital paper if the user wishes to digitally capture what she has written. A page of digital paper, which can be purchased in traditional pad or sticky-note size, has small dots on it that allow the pen to &quot;see&quot; what has been written.</NEMO_annot:comment>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Digital_pen</NEMO_annot:definition_source>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://searchmobilecomputing.techtarget.com/definition/digital-pen</NEMO_annot:definition_source>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_1685000 -->

