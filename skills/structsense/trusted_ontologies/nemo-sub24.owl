    <!-- http://purl.obolibrary.org/obo/OBI_0000174 -->

    <owl:Class rdf:about="&obo;OBI_0000174">
        <rdfs:label rdf:datatype="&xsd;string">study_group_role</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_2012000"/>
