        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-26</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-12</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">An event-related potential is an electrical potential (summation of PSP) that occurs in response to a sensory-motor, cognitive, or physiological event (such as stimulus onset or offset, eyeblink, motor response, etc.).</NEMO_annot:definition>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">ERP</NEMO_annot:acronym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Submitted to NIF in November 2010.</NEMO_annot:comment>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">event_related_potential</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">event_related_potential is an elctrical_potential that...[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
