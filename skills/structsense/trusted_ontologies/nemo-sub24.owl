    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_2342947 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_2342947">
        <rdfs:label>right_inferior_temporal</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000185"/>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2013-10-02</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2013-10-02</NEMO_annot:created_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Spatial concepts in NEMO refer to objects located on, in, or near the head. They may not generalize to spatial relations among other objects.</NEMO_annot:comment>
        <NEMO_annot:definition rdf:datatype="&xsd;string">left inferior temporal refers to the part of the head surface that is inferior to left temporal. It corresponds with electrodes F9, C9, P9, PO9, F10, C10, P10, PO10 </NEMO_annot:definition>
        <NEMO_annot:pref_label>right_inferior_temporal</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_2343000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_2343000">
        <rdfs:label xml:lang="en">left_mastoid_location</rdfs:label>
