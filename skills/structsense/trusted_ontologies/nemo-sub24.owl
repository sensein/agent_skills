        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000172"/>
        <NEMO_annot:definition rdf:datatype="&xsd;string">* Biomaterial object constituting the structural organization of a biological organism or an attribute of that organization. * A biomaterial object constituting a part of a complete organismal object.</NEMO_annot:definition>
