    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_6341000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_6341000">
        <rdfs:label rdf:datatype="&xsd;string">phase_shift</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0000040"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ontology;NEMO.owl#NEMO_2317000"/>
                <owl:someValuesFrom rdf:resource="&ontology;NEMO.owl#NEMO_0000375"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-10-09</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-12</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A phase shift is a change in any distinguishable state of a periodic phenomenon (e.g., electromagnetic wave) with respect to a reference point.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_temporal</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">SBO_0000477</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Submitted to NIF in November 2010.</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Systems Biology Ontology ID 0000477</NEMO_annot:comment>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Weik, M. (2000). Computer science and communications dictionary (1st ed., Vols. 1-2). Boston: Kluwer Academic Publishers.</NEMO_annot:definition_source>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">phase_shift</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">phase_shift is an event_boundary that occurs_at some phase_shift_latency</NEMO_annot:onto_definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">“The phase of sinusoidal components of the input signal is shifted by the filter” (Sherman-Gold, R. (1993). The axon guide for electrophysiology &amp; biophysics laboratory techniques. Sunnyvale, CA: Molecular Devices.).</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Anita_Bandrowski"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Usman_Khan"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_6345000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_6345000">
        <rdfs:label rdf:datatype="&xsd;string">Eprime_software</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;IAO_0000010"/>
        <NEMO_annot:definition rdf:datatype="&xsd;string">...[incomplete]</NEMO_annot:definition>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-24</NEMO_annot:created_date>
