    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_2142000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_2142000">
        <rdfs:label xml:lang="en">chi_squared_statistic</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0709000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2011-11-22</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-11-22</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A chi_squared_statistic is used to test whether paired observations on two variables, expressed in a contingency table, are independent of each other. It is calculated by finding the difference between each observed and theoretical frequency for each possible outcome, squaring them, dividing each by the theoretical frequency, and taking the sum of the results. </NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/Chi-square_statistic</NEMO_annot:definition_source>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">inferential_statistic is a data_item that is_about SOME data_set</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


