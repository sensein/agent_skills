        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-26</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A head model is a mathematical representation of a human head or  physiological process unfolding within a human head. Key head model parameters include number of surfaces (e.g., skull, scalp, CSF, grey and white matter) and the thickness, conductivity, and shape (geometry) of each surface. Head models are used for modeling (&quot;localization&quot;) of anatomical sources of surface-measured EEG and MEG data.</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
