    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0414000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0414000">
        <rdfs:label rdf:datatype="&xsd;string">structural_magnetic_resonance_data_set</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_2000000"/>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-26</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2011-11-05</NEMO_annot:created_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A structural magnetic_resonance_data_set is a collection of data magnetic resonance images (MRI) that represent anatomical structures within an object.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A structural_magnetic_resonance_imaging_data_set is a anatomical_data_set...</NEMO_annot:onto_definition>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">MRI</NEMO_annot:acronym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Symms, M., Jaeger, H. R., Schmierer, K., Yousry, T. A. (2004) A review of structural magnetic resonance neuroimaging. Journal of Neorology, Neurosurgery and Psychiatry with Practical Neurology, 2004, September, 75(9), pp. 1235-44.</NEMO_annot:definition_source>
        <NEMO_annot:comment rdf:datatype="&xsd;string">T2- and T1-weighted sequences are most frequently used for acquiring the structural data in the clinical setting, but other techniques such as T2* sequence, magnetisation transfer imaging (MTI), diffusion tensor imaging (DTI) and fluid attenuated inversion recovery (FLAIR) techniques are also used.</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">anatomical_MRI</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">magnetic_resonsance_image</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">structural_MRI</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">structural_magnetic_resonance_data_set</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


