        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-05-20</NEMO_annot:created_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">An unnamed_negative_MFRONT_effect  is a negativity that is significant over the mid frontocentral region of the scalp.</NEMO_annot:definition>
