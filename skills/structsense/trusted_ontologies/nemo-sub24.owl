        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_imported_classes</NEMO_annot:namespace>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">data_set</NEMO_annot:pref_label>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://purl.obofoundry.org/obo/IAO_0000100</NEMO_annot:definition_source>
        <NEMO_annot:synonym>http://knoesis.wright.edu/provenir/provenir.owl#data_collection</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
