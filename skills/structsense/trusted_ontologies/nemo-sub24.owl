    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_3383000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_3383000">
        <rdfs:label rdf:datatype="&xsd;string">voltage_amplifier_highpass_filter_setting</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_1142000"/>
        <NEMO_annot:definition rdf:datatype="&xsd;string">&quot;In an RC circuit, the value of the time constant (in seconds) is equal to the product of the circuit resistance (in ohms) and the circuit capacitance  (in farads), i.e. τ = R × C. It is the time required to charge the capacitor, through the resistor, to 63.2 (≈ 63) percent of full charge; or to discharge it to 36.8 (≈ 37) percent of its initial voltage. These values are derived from the mathematical constant e, specifically 1 − e − 1 and e − 1 respectively.&quot; (http://en.wikipedia.org/wiki/RC_time_constant)</NEMO_annot:definition>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-04-22</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-04-22</NEMO_annot:created_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">Time_constant is a ... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://en.wikipedia.org/wiki/RC_time_constant</NEMO_annot:definition_source>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">voltage_amplifier_highpass_filter_setting</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Chris_Bird"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_3385000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_3385000">
        <rdfs:label xml:lang="en">self_representation</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_1541000"/>
        <NEMO_annot:definition rdf:datatype="&xsd;string">*A mental representation is an information_artifact_entity that &quot;is about&quot; some other entity.* 

*When a mental representation is about a perceived entity outside the body, it involves sensory-motor mapping, i.e., representation and control of the external environment.* 

*When it is about a perceived change within the body, it involves homeostatic processes, that is, representation or mapping and control of the internal milieux.* 

*A cognitive representation is the result of intermediate stages of processing that involve integration/coherence of multiple maps (e.g., multimodal processing, perceptual integration or &quot;binding&quot; of representations).*

*A mental representation is concretized as a particular  physiological state (i.e., pattern of activity) within the nervous system.*</NEMO_annot:definition>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-04-23</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-05-10</NEMO_annot:modified_date>
        <NEMO_annot:definition_source>curator.</NEMO_annot:definition_source>
        <NEMO_annot:synonym>mental map</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


