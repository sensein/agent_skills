    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4358000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4358000">
        <rdfs:label rdf:datatype="&xsd;string">spread_statistic</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_6525000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-08</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-25</NEMO_annot:modified_date>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A spread_statistic is a descriptive_statistic that is_about SOME data_set.</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A spread_statistic is a number that represents the degree of variability among a set of data points, that is, the degree to which data points are clustered about or deviate from the mean value of a data distribution. If the spread is large, then there are large differences among the data points.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">dispersion</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://bobhall.tamu.edu/FiniteMath/Module8/Introduction.html</NEMO_annot:definition_source>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://www.stat.berkeley.edu/users/stark/SticiGui/Text/ch2.htm</NEMO_annot:definition_source>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">spread_statistic</NEMO_annot:pref_label>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">statistical dispersion</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">statistical variability</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">variability</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


