                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2011-07-03</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-03-19</NEMO_annot:modified_date>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Inhibitory N2 increases when subjects have less time to respond.</NEMO_annot:comment>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Jodo, et al. (1992: 477-482). Full citation: Jodo, E., and Kayama, Y. (1992). Relation of a negative ERP component to response inhibition in a Go/NoGo task. Electroencephalography &amp; Clinical Neurophysiology, 28, 82, 477–482.</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">N2</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">N200</NEMO_annot:synonym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">The inhibitory_N2 is_a scalp_recorded_ERP_diffwave
     that is_specified_output_of SOME subtraction_data_transformation
           that has_specified_input SOME averaged_EEG_data_set
                 that is_about SOME scalp_recorded_ERP
                        that occurs_in_response_to SOME experimental_paradigm_execution
                               that is_realization_of SOME plan
                                     that is_concretization of SOME go_nogo_paradigm

and has_proper_part SOME peak_latency_measurement_datum
       that has_numeric_value SOME decimal[&gt;=&quot;100&quot;, &lt;=&quot;300&quot;]

and has_proper_part SOME intensity_measurement_datum
       that has_numeric_value SOME decimal[&lt;=&quot;-0.4&quot;]
       that is_quality_measurement_of SOME intensity
            that inheres_in SOME scalp_recorded_ERP
                that unfolds_in SOME frontocentral_scalp_surface_region</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">The inhibitory_N200 is a signifcantly increased negativity over frontocenral scalp ROI about 100-300 ms after onset of a stimulus that to which the participant has been instructed to inhibit a behavioral response.</NEMO_annot:definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">nogo-N2</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4508000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4508000">
        <rdfs:label rdf:datatype="&xsd;string">min_electrode_intensity_baseline</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_6390000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-01</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-06-13</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">For some set of scalp EEG measurement values, specifies the min_electrode_intensity, in microvolts, with respect to some baseline value.</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Has corresponding term in Bob Frank&apos;s NEMO_ERP_Metric_Extraction matlab script: Min_Electrode_Intensity_Baseline</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">The NEMO_ERP_Toolkit computes baseline value as the mean electrical potential at the peak-negativity-intensity electrode location over a user-specified time interval centered on a user-specified reference timepoint. The computed baseline value is then subtracted from min_electrode_intensity: min_electrode_intensity_baseline = min_electrode_intensity - computed_baseline_value.</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">is_a minimum_value
located_in?? some regional_part_of_scalp_surface_region
is_quality_measurement_of electrical_potential_difference</NEMO_annot:comment>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">min_electrode_intensity_baseline</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">min_electrode_intensity_baseline is a ... [incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Robert_Frank"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4509000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_4509000">
        <rdfs:label rdf:datatype="&xsd;string">skull_conductivity</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_9240000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-08</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-09-24</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Electrical_conductivity is a measure of the ability of some skull to carry an electrical current while under the influence of an electrical field.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Weik, M. (2000). Computer science and communications dictionary (1st ed., Vols. 1-2). Boston: Kluwer Acadmic Publishers.</NEMO_annot:definition_source>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">skull_conductivity</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">skull_conductivity is an electrical_conductivity that...[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
