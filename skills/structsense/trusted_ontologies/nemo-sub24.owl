    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0000382 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_0000382">
        <rdfs:label rdf:datatype="&xsd;string">experiment_condition</rdfs:label>
