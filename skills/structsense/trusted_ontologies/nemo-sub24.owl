    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_2237000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_2237000">
        <rdfs:label rdf:datatype="&xsd;string">amplifier_pass_band</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_6957000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-10-09</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-11-12</NEMO_annot:modified_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Submitted to NIF in November 2010.</NEMO_annot:comment>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Weik, M. (2000). Computer science and communications dictionary (1st ed., Vols. 1-2). Boston: Kluwer Academic Publishers.</NEMO_annot:definition_source>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">amplifier_pass_band</NEMO_annot:pref_label>
        <NEMO_annot:definition rdf:datatype="&xsd;string">amplifier_pass_band is a band of frequencies, between specified limits, that a circuit (e.g., an amplifier or filter) is capable of handling.  All frequencies below the lower limit and above the upper limit are not allowed to pass.  The limiting frequencies are defined as those at which the relative intensity or power decreases to a specified fraction of the maximum intensity or power.  This decrease in power is often specified to be the half-power points (i.e., 3 dB below the maximum power). </NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">amplifier_pass_band is an artifact_entity_quality that inheres_in some [incomplete...]</NEMO_annot:onto_definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">passband</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">“Frequency region below the 3 db frequency ” (Sherman-Gold, R. (1993). The Axon guide for electrophysiology &amp; biophysics laboratory techniques. Sunnyvale, CA: Molecular Devices.).</NEMO_annot:comment>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Anita_Bandrowski"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Usman_Khan"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


