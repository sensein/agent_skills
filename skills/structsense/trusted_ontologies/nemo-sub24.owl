        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/SNOMEDCT/10325006</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">http://purl.org/obo/owl/DOID#DOID_4541</NEMO_annot:synonym>
