        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-07-21</NEMO_annot:modified_date>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">The skull is an anatomical_object that is a proper_part_of some head.</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">The skull is the skeleton of the head of a vertebrate forming a bony or cartilaginous case that encloses and protects the brain and chief sense organs and supports the jaws.</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://www.merriam-webster.com/dictionary/skull</NEMO_annot:definition_source>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">skull</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


