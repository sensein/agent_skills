    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_5669000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_5669000">
        <rdfs:label rdf:datatype="&xsd;string">Brodmann_area_46_surface_region</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_7920000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-09-02</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-01-14</NEMO_annot:modified_date>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Area frontalis media</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">B09-46</NEMO_annot:synonym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">B09-46</NEMO_annot:acronym>
        <NEMO_annot:acronym rdf:datatype="&xsd;string">BA46</NEMO_annot:acronym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann (1909) area 46</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Brodmann area 46</NEMO_annot:synonym>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">Brodmann_area_46_surface_region</NEMO_annot:pref_label>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">Brodmann_area_46_surface_region is a two_dimensional_region that is the location of SOME regional_part_of_cortical_surface</NEMO_annot:onto_definition>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Brodmann_area_46_surface_region occupies approximately the middle third of the middle frontal gyrus and the most rostral portion of the inferior frontal gyrus. Cytoarchitecturally it is bounded dorsally by the granular frontal area 9, rostroventrally by the frontopolar area 10 and caudally by the triangular area 45 (Brodmann-1909).</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Formerly NN-64 in NeuroNames</NEMO_annot:comment>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-880576905</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">NN-886</NEMO_annot:synonym>
        <NEMO_annot:comment rdf:datatype="&xsd;string">NeuroNames concept ID NN-2105</NEMO_annot:comment>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">Umlscui C1272512</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 46 of Brodmann (human)</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">area 46 of Brodmann-1909</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">birnlex_1778</NEMO_annot:synonym>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://psychology.wikia.com/wiki/Brodmann_area_46</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">middle frontal</NEMO_annot:synonym>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">middle frontal area 46</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#pending_final_vetting"/>
    </owl:Class>
    


