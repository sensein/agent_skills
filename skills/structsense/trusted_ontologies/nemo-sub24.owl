    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_8693000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_8693000">
        <rdfs:label xml:lang="en">covariate_statistic</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_0709000"/>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-11-22</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2011-11-22</NEMO_annot:created_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A covariate_statistic is a product of the correlation of two related variables times their standard deviations. Used in true experiments to measure the difference of treatment between them.</NEMO_annot:definition>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_data</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://writing.colostate.edu/guides/research/glossary/</NEMO_annot:definition_source>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">inferential_statistic is a data_item that is_about SOME data_set</NEMO_annot:onto_definition>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_8697000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_8697000">
        <rdfs:label rdf:datatype="&xsd;string">scalp_anatomical_point</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_1111115"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-07-22</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2011-04-28</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A scalp_anatomical_point is an anatomical point in space, where the space is subdivided according to scalp anatomical landmarks, boundaries, and axes, resulting in a scalp anatomical coordinate system.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">A scalp_anatomical_point is an anatomical_point that is a proper_part_of some scalp_region.</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Curator.</NEMO_annot:definition_source>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_spatial</NEMO_annot:namespace>
