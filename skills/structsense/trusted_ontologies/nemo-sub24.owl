        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-07-23</NEMO_annot:created_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Conscious is a quality that momentarily inheres in some brain and that constitutes a &quot;snapshot&quot; in time of a cognitive process that engages the global neuronal workspace.</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Dehaene, S., J. P. Changeux, et al. (2006). &quot;Conscious, preconscious, and subliminal processing: a testable taxonomy.&quot; Trends Cogn Sci 10(5): 204-211.</NEMO_annot:definition_source>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_4990000 -->

