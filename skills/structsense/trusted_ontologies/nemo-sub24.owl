        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#direct_import"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000009 -->

    <owl:Class rdf:about="&obo;IAO_0000009">
        <rdfs:label rdf:datatype="&xsd;string">label</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;IAO_0000028"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2009-07-21</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-05-15</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A label is a symbol that is part of some other datum and is used to either partially define  the denotation of that datum or to provide a means for identifying the datum as a member of the set of data with the same label</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Despite IAO definition, they have not positioned IAO:label as a subclass of IAO:symbol.</NEMO_annot:comment>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Imported into NEMO_data</NEMO_annot:comment>
        <NEMO_annot:source_ontology rdf:datatype="&xsd;string">Information Artifact Ontology (IAO)</NEMO_annot:source_ontology>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_imported_classes</NEMO_annot:namespace>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://purl.obolibrary.org/obo/IAO_0000009</NEMO_annot:definition_source>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">label</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#direct_import"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000010 -->

    <owl:Class rdf:about="&obo;IAO_0000010">
        <rdfs:label rdf:datatype="&xsd;string">software</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;IAO_0000104"/>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-04-24</NEMO_annot:modified_date>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2010-05-15</NEMO_annot:created_date>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Imported into NEMO_data</NEMO_annot:comment>
        <NEMO_annot:source_ontology rdf:datatype="&xsd;string">Information Artifact Ontology (IAO)</NEMO_annot:source_ontology>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_imported_classes</NEMO_annot:namespace>
        <NEMO_annot:definition rdf:datatype="&xsd;string">Software is a plan specification which is a series of encoded instructions that can be directly executed by a processing unit or transformed in to a form that can be. For programming texts that are syntactically correct and which are in a language that can be executed by an interpreter this would correspond to the tokenized version of the text stripped of comments.</NEMO_annot:definition>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://purl.obolibrary.org/obo/IAO_0000010</NEMO_annot:definition_source>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">software</NEMO_annot:pref_label>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#direct_import"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000027 -->

    <owl:Class rdf:about="&obo;IAO_0000027">
        <rdfs:label rdf:datatype="&xsd;string">data_item</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;IAO_0000030"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2009-06-07</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-04-24</NEMO_annot:modified_date>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Imported into NEMO_data</NEMO_annot:comment>
        <NEMO_annot:source_ontology rdf:datatype="&xsd;string">Information Artifact Ontology (IAO)</NEMO_annot:source_ontology>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_imported_classes</NEMO_annot:namespace>
        <NEMO_annot:definition rdf:datatype="&xsd;string">a data item is an information content entity that is intended to be a truthful statement about something (modulo, e.g., measurement precision or other systematic errors) and is constructed/acquired by a method which reliably tends to produce (approximately) truthful statements.</NEMO_annot:definition>
        <NEMO_annot:pref_label rdf:datatype="&xsd;string">data_item</NEMO_annot:pref_label>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">http://purl.obolibrary.org/obo/IAO_0000027</NEMO_annot:definition_source>
        <NEMO_annot:synonym>http://knoesis.wright.edu/provenir/provenir.owl#data</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Snezana_Nikolic"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#direct_import"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000028 -->

    <owl:Class rdf:about="&obo;IAO_0000028">
        <rdfs:label rdf:datatype="&xsd;string">symbol</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;IAO_0000030"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2009-07-21</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2010-05-15</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A symbol is an information content entity that is a smallish, word-like datum (i.e., a string).</NEMO_annot:definition>
        <NEMO_annot:comment rdf:datatype="&xsd;string">Imported into NEMO_data</NEMO_annot:comment>
