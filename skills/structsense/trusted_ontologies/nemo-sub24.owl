        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-05-07</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2013-05-26</NEMO_annot:modified_date>
        <NEMO_annot:definition_source rdf:datatype="&xsd;string">Bentin, S., Mouchetant-Rostaing, Y., Giard, M. H., Echallier, J. F., &amp; Pernier, J. (1999). ERP manifestations of processing printed words at different psycholinguistic levels: time course and scalp distribution. J Cogn Neurosci, 11(3), 235-260. 
</NEMO_annot:definition_source>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">MFN</NEMO_annot:synonym>
        <NEMO_annot:namespace rdf:datatype="&xsd;string">NEMO_erp</NEMO_annot:namespace>
        <NEMO_annot:definition rdf:datatype="&xsd;string">The MFN_lexicality_effect is a negativity over frontocentral scalp regions at 300-500 ms after onset of a pseudoword that signifcantly greater (more negative) compared with a word stimulus.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">The MFN_lexicality_effect is_a scalp_recorded_ERP_diffwave
     that is_specified_output_of SOME subtraction_data_transformation
           that has_specified_input SOME averaged_EEG_data_set
                 that is_about SOME scalp_recorded_ERP
                        that occurs_in_response_to SOME experimental_paradigm_execution
                               that is_realization_of SOME plan
                                     that is_concretization of SOME 

(lexical_priming_paradigm OR sentence_semantic_priming_paradigm OR discourse_semantic_priming_paradigm OR isolated_word_recognition_paradigm OR word_repetition_paradigm)
      
      
and has_proper_part SOME peak_latency_measurement_datum
       that has_numeric_value SOME decimal[&gt;=&quot;300&quot;, &lt;=&quot;500&quot;]

and has_proper_part SOME intensity_measurement_datum
       that has_numeric_value SOME decimal[&lt;=&quot;-0.4&quot;]
       that is_quality_measurement_of SOME intensity
            that inheres_in SOME scalp_recorded_ERP
                that unfolds_in SOME frontocentral_scalp_surface_region
</NEMO_annot:onto_definition>
        <NEMO_annot:synonym rdf:datatype="&xsd;string">fN400</NEMO_annot:synonym>
        <NEMO_annot:synonym>N3</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
        <NEMO_annot:evidence_code rdf:resource="&ontology;NEMO_annotation_properties.owl#traceable_author_statement"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_3057000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_3057000">
        <rdfs:label xml:lang="en">language_comprehension</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_4320000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-04-23</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-04-23</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">a cognitive_process is a mental process engaging one or more systems in the intermediary or integrative processing of signals from the internal (visceral) and external (somatic) environments. It is often the result of a sensory_process (bottom-up cognition). It may be mediated by an emotion_process (motivated cognition) or by another cognitive_process, such as memory or expectancy based on prior experience (top-down cognition).</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">mental_process is a brain_physiological_process that...[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:definition_source>curator.</NEMO_annot:definition_source>
        <rdfs:comment>To be replaced by concepts from cogATLAS....</rdfs:comment>
        <NEMO_annot:synonym>cognition</NEMO_annot:synonym>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_3076000 -->

    <owl:Class rdf:about="&ontology;NEMO.owl#NEMO_3076000">
        <rdfs:label xml:lang="en">mental_process</rdfs:label>
        <rdfs:subClassOf rdf:resource="&ontology;NEMO.owl#NEMO_5217000"/>
        <NEMO_annot:created_date rdf:datatype="&xsd;string">2012-04-23</NEMO_annot:created_date>
        <NEMO_annot:modified_date rdf:datatype="&xsd;string">2012-04-23</NEMO_annot:modified_date>
        <NEMO_annot:definition rdf:datatype="&xsd;string">A mental_process is a process engaging one or more brain_physiological_systems (CNS) in the monitoring and control of extrapersonal space (i.e., external organs) and internal milieux (i.e., visceral organs). Processes within the peripheral nervous system (PNS) may trigger or be triggered by a mental_process, but PNS processes are not necessary for a mental_process to occur.</NEMO_annot:definition>
        <NEMO_annot:onto_definition rdf:datatype="&xsd;string">mental_process is a brain_physiological_process that...[incomplete]</NEMO_annot:onto_definition>
        <NEMO_annot:synonym>http://ontology.neuinfo.org/NIF/Function/NIF-Function.owl#birnlex_1800</NEMO_annot:synonym>
        <NEMO_annot:definition_source>curator.</NEMO_annot:definition_source>
        <NEMO_annot:curator rdf:resource="&ontology;NEMO_annotation_properties.owl#Gwen_Frishkoff"/>
        <NEMO_annot:curation_status rdf:resource="&ontology;NEMO_annotation_properties.owl#definition_incomplete"/>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_3080001 -->

