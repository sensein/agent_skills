        <rdfs:label xml:lang="en">Ability to Concentrate</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AbilityToIdentifyEvent -->

