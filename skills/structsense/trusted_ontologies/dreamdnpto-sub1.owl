        <rdfs:comment xml:lang="en">Hobby of trying to catch fish.</rdfs:comment>
        <rdfs:label xml:lang="en">Fishing Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FishkeepingHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FishkeepingHobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PetKeepingHobby"/>
        <rdfs:comment xml:lang="en">Fishkeeping is a popular hobby, practiced by aquarists, concerned with keeping fish in a home aquarium or garden pond. From Wikepedia</rdfs:comment>
        <rdfs:label xml:lang="en">Fishkeeping Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FlexibilityExercise -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FlexibilityExercise">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalExerciseTherapy"/>
        <umls3:cui xml:lang="en">C2945658</umls3:cui>
        <rdfs:label xml:lang="en">Flexibility Exercise</rdfs:label>
        <skos:definition xml:lang="en">Flexibility exercises are activities that improve the ability of a joint to maintain the movement necessary for carrying out daily tasks and physical activity. From www.nhs.uk (https://www.nhs.uk/live-well/exercise/how-to-improve-strength-flexibility/)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FloorGame -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FloorGame">
