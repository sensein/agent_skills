        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfAllergy"/>
        <rdfs:comment xml:lang="en">The performance of allergic reactions to pets with fur, e.g., cats and dogs.</rdfs:comment>
        <rdfs:label xml:lang="en">Manifestation of Pet Allergy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfPollenAllergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfPollenAllergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfAllergy"/>
        <ncit2:synonym xml:lang="en">Manifestation of Hay Fever</ncit2:synonym>
        <rdfs:comment xml:lang="en">The performance of allergic reactions to pollen released by trees, grasses and weeds.</rdfs:comment>
        <rdfs:label xml:lang="en">Manifestation of Pollen Allergy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfShellfishAllergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfShellfishAllergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfFoodAllergy"/>
        <rdfs:comment xml:lang="en">The performance of allergic reactions to shellfish or shellfish products.</rdfs:comment>
        <rdfs:label xml:lang="en">Manifestation of Shellfish Allergy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfSoybeanAllergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfSoybeanAllergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfFoodAllergy"/>
        <rdfs:comment xml:lang="en">The performance of allergic reactions to soybean or soybean products.</rdfs:comment>
        <rdfs:label xml:lang="en">Manifestation of Soybean Allergy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfStimulantAddiction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfStimulantAddiction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfAddiction"/>
        <rdfs:comment xml:lang="en">The manifestation of addiction to stimulants which are a class of drugs, such as caffeine, amphetamines, and cocaine.</rdfs:comment>
        <rdfs:label xml:lang="en">Manifestation of Stimulant Addiction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfTreeNutAllergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfTreeNutAllergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfFoodAllergy"/>
        <rdfs:comment xml:lang="en">The performance of allergic reactions to tree nut (e.g., walnut and hazelnut) or tree nut products.</rdfs:comment>
        <rdfs:label xml:lang="en">Manifestation of Tree Nut Allergy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfWheatAllergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfWheatAllergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfFoodAllergy"/>
        <rdfs:comment xml:lang="en">The performance of allergic reactions to wheat.</rdfs:comment>
        <rdfs:label xml:lang="en">Manifestation of Wheat Allergy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MaritalStatus -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MaritalStatus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DemographicInformation"/>
        <umls3:cui xml:lang="en">C0024819</umls3:cui>
        <rdfs:label xml:lang="en">Marital Status</rdfs:label>
        <skos:definition xml:lang="en">A demographic parameter indicating a person&apos;s status with respect to marriage, divorce, widowhood, singleness, etc. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MassagePreference -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MassagePreference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Preference"/>
        <rdfs:comment xml:lang="en">Preference of a certain massage in terms of massage method and location of the body</rdfs:comment>
        <rdfs:label xml:lang="en">Massage Preference</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MassageTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MassageTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SensoryStimulationTherapy"/>
        <ncit2:synonym xml:lang="en">Massage</ncit2:synonym>
        <umls3:cui xml:lang="en">C3536731</umls3:cui>
        <rdfs:label xml:lang="en">Massage Therapy</rdfs:label>
        <skos:definition xml:lang="en">A treatment in which the soft tissues of the body are kneaded, rubbed, tapped, and stroked. Massage therapy may help people relax, relieve stress and pain, lower blood pressure, and improve circulation. It is being studied in the treatment of cancer symptoms such as lack of energy, pain, swelling, and depression. From the U.S. National Cancer Insitute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MatchingSocks -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MatchingSocks">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">The activity of matching socks.</rdfs:comment>
        <rdfs:label xml:lang="en">Matching Socks</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalHistory -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalHistory">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient"/>
        <umls3:cui xml:lang="en">C0262926</umls3:cui>
        <rdfs:label xml:lang="en">Medical History</rdfs:label>
        <skos:definition xml:lang="en">A collection of information about a person&apos;s health. It may include information about allergies, illness and surgeris, and dates and results of physical exams, tests, screenings, and immunizations. It may also include information about medicines taken and about diet and exercise. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <ncit2:synonym xml:lang="en">Medical Condition, Illness, Sickness</ncit2:synonym>
        <umls3:cui xml:lang="en">C0221423</umls3:cui>
        <rdfs:label xml:lang="en">Medical Illness</rdfs:label>
        <skos:definition xml:lang="en">A state of ill health, bodily malfunction, or discomfort. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalPractitioner -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalPractitioner">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessional"/>
        <ncit2:synonym xml:lang="en">Physician</ncit2:synonym>
        <umls3:cui xml:lang="en">C1306754</umls3:cui>
        <rdfs:label xml:lang="en">Medical Practitioner</rdfs:label>
        <skos:definition xml:lang="en">Medical Practitioner means a person registered or licensed as a medical practitioner under a law of a State or Territory that provides for the registration or licensing of medical practititioners. From Australian Government Department of Health</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicareNumber -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicareNumber">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DemographicInformation"/>
        <umls3:cui xml:lang="en">C1549712</umls3:cui>
        <rdfs:comment xml:lang="en">Medicare number of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Medicare Number</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicationChange -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicationChange">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicationEffect"/>
        <ncit2:synonym xml:lang="en">Change of Medication</ncit2:synonym>
        <umls3:cui xml:lang="en">C0580105</umls3:cui>
        <rdfs:comment xml:lang="en">The changes of medications prescribed for a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Medication Change</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicationEffect -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicationEffect">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <ncit2:synonym xml:lang="en">Medication Response</ncit2:synonym>
        <umls3:cui xml:lang="en">C1319171</umls3:cui>
        <rdfs:label xml:lang="en">Medication Effect</rdfs:label>
        <skos:definition xml:lang="en">Therapeutic and adverse effects of prescribed medication. From Nursing Outcome Classification</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicationInteraction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicationInteraction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicationEffect"/>
        <ncit2:synonym xml:lang="en">Drug Interaction, Drug-Drug Interaction</ncit2:synonym>
        <umls3:cui xml:lang="en">C0687133</umls3:cui>
        <rdfs:label xml:lang="en">Medication Interaction</rdfs:label>
        <skos:definition xml:lang="en">The action of a drug that may affect the activity, metabolism, or toxicity of another drug. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicationSideEffect -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicationSideEffect">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicationEffect"/>
        <ncit2:synonym xml:lang="en">Adverse Reaction to Drug, Drug Side Effect, Medication Adverse Effect, Medication Adverse Reaction, Adverse Drug Reaction, Drug-Induced Side Effect</ncit2:synonym>
        <umls3:cui xml:lang="en">C0041755</umls3:cui>
        <rdfs:label xml:lang="en">Medication Side Effect</rdfs:label>
        <skos:definition xml:lang="en">Any detrimental or unintended response associated with the use of a medication in humans. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MemoryImpairment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MemoryImpairment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveImpairment"/>
        <ncit2:synonym xml:lang="en">Memory Deficit, Poor Memory, Bad Memory, Memory Problem, Memory Disturbance, Memory Disorder, Disturbance of Memory, Impairment Memory, Impaired Memory, Memory Loss</ncit2:synonym>
        <umls3:cui xml:lang="en">C0233794</umls3:cui>
        <rdfs:label xml:lang="en">Memory Impairment</rdfs:label>
        <skos:definition xml:lang="en">Deterioration in memory function. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MemoryTraining -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MemoryTraining">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:synonym xml:lang="en">Memory Skills Training</ncit2:synonym>
        <umls3:cui xml:lang="en">C0729377</umls3:cui>
        <rdfs:label xml:lang="en">Memory Training</rdfs:label>
        <skos:definition xml:lang="en">Enhancement strategies to improve duration and retention of information. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MentalDisorder -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MentalDisorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:synonym xml:lang="en">Mental Illness, Psychiatric Disorder, Psychiatric Disease, Psychiatric Illness</ncit2:synonym>
        <umls3:cui xml:lang="en">C0004936</umls3:cui>
        <rdfs:label xml:lang="en">Mental Disorder</rdfs:label>
        <skos:definition xml:lang="en">Psychiatric illness or diseases manifested by breakdowns in the adaptational process expressed primarily as abnormalities of thought, feeling, and behavior producing either distress or impairment of function. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MetabolicDisease -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MetabolicDisease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:abbreviation xml:lang="en">MD</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Metabolic Disorder, Metabolism Disorder</ncit2:synonym>
        <umls3:cui xml:lang="en">C0025517</umls3:cui>
        <rdfs:label xml:lang="en">Metabolic Disease</rdfs:label>
        <skos:definition xml:lang="en">Generic term for diseases caused by an abnormal metabolic process. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Midnight -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Midnight">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Time"/>
        <umls3:cui xml:lang="en">C0332172</umls3:cui>
        <rdfs:label xml:lang="en">Midnight</rdfs:label>
        <skos:definition xml:lang="en">The middle period of the night. From Stanford Languages</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MildDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MildDementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StageOfDementia"/>
        <ncit2:synonym xml:lang="en">Early Stage of Dementia, Early Dementia</ncit2:synonym>
        <umls3:cui xml:lang="en">C3494623</umls3:cui>
        <rdfs:comment xml:lang="en">The early stage of dementia. People with mild dementia may still be able to function independently. However, they may experience memory lapses and occastional confusion and lapse in judgement that affect daily life.</rdfs:comment>
        <rdfs:label xml:lang="en">Mild Dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MilkAllergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MilkAllergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FoodAllergy"/>
        <ncit2:synonym xml:lang="en">Milk Hypersensitivity, Allergy to Milk</ncit2:synonym>
        <umls3:cui xml:lang="en">C0079840</umls3:cui>
        <rdfs:label xml:lang="en">Milk Allergy</rdfs:label>
        <skos:definition xml:lang="en">Allergic reaction to milk (usually cow&apos;s milk) or milk products. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MindBodyTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MindBodyTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <umls3:cui xml:lang="en">C0260173</umls3:cui>
        <rdfs:label xml:lang="en">Mind-Body Therapy</rdfs:label>
        <skos:definition xml:lang="en">Treatment methods or techniques which are based on the knowledge of mind and body interactions. These techniques can be used to reduce the feeling of tension and effect of stress, and to enhance the physiological and psychological well-being of an individual. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MiniInternationalNeuropsychiatricInterview -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MiniInternationalNeuropsychiatricInterview">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">MINI</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Mini Neuropsychiatric Interview</ncit2:synonym>
        <umls3:cui xml:lang="en">C4505426</umls3:cui>
        <rdfs:label xml:lang="en">Mini International Neuropsychiatric Interview</rdfs:label>
        <skos:definition xml:lang="en">The Mini International Neuropsychiatric Interview (MINI) was designed as a brief structured diagnostic interview for the major psychiatric disorders in DSM-III-R, DSM-IV and DSM-5 and ICD-10. From Harm Research Institute, https://harmresearch.org/mini-international-neuropsychiatric-interview-mini/</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MiniMartActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MiniMartActivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">The activity of shopping in a mini supermarket that is normally located inside the long-term care facility or set up regulary e.g., once a week.</rdfs:comment>
        <rdfs:label xml:lang="en">Mini Mart Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MiniMentalStateExamination -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MiniMentalStateExamination">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">MMSE</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Mini Mental State Exam, Folstein Mini-Mental State Examination, Folstein Mini-Mental Status Exam, Mini Mental Status Exame</ncit2:synonym>
        <umls3:cui xml:lang="en">C0451306</umls3:cui>
        <rdfs:label xml:lang="en">Mini-Mental Sate Examination</rdfs:label>
        <skos:definition xml:lang="en">A standardized and structured interview originally developed by Marshal Folstein, Susan Folstein and Paul McHugh (Journal of Psychiatric Research 1975), which is used to evaluate an individual&apos;s cognitive function. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MissingFamily -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MissingFamily">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <rdfs:comment xml:lang="en">A person may miss his/her family and feel sad because he/she cannot see his/her family members.</rdfs:comment>
        <rdfs:label xml:lang="en">Missing Family</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ModerateDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ModerateDementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StageOfDementia"/>
        <ncit2:synonym xml:lang="en">Middle Stage of Dementia</ncit2:synonym>
        <umls3:cui xml:lang="en">C3494871</umls3:cui>
        <rdfs:comment xml:lang="en">The middle stage of dementia. People with moderate dementia may experience greater memory loss and significant personality and behaviour changes. They may need assistance with daily tasks, such as bathing and grooming.</rdfs:comment>
        <rdfs:label xml:lang="en">Moderate Dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ModeratelyEffective -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ModeratelyEffective">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Effective"/>
        <terms:source xml:lang="en">Wiskow, K. M., Donaldson, J. M., &amp; Matter, A. L. (2017). An evaluation of generalization of compliance across response types. Behavior Analysis: Research and Practice, 17(4), 402-420. http://dx.doi.org/10.1037/bar0000087</terms:source>
        <rdfs:comment xml:lang="en">Moderately successful in producing a desired or intended result</rdfs:comment>
        <rdfs:label xml:lang="en">Moderately Effective</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MoldAllergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MoldAllergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Allergy"/>
        <ncit2:synonym xml:lang="en">Allergy to Mold</ncit2:synonym>
        <umls3:cui xml:lang="en">C1096734</umls3:cui>
        <rdfs:label xml:lang="en">Mold Allergy</rdfs:label>
        <skos:definition xml:lang="en">Mold and mildew are fungi. Since fungi grow in so many places, both indoors and outdoors, allergic reactions can occur year round. From Asthma and Allergy Foundation of America https://www.aafa.org/types-of-allergies/</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Monitoring -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Monitoring">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Patient Monitoring, Medical Monitoring, Monitor Patient, Monitoring Patient, Monitoring of Patient</ncit2:synonym>
        <umls3:cui xml:lang="en">C0030695</umls3:cui>
        <rdfs:label xml:lang="en">Monitoring</rdfs:label>
        <skos:definition xml:lang="en">The act of observing a disease, condition, or medical parameter over time. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MonitoringPersonTakingMedication -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MonitoringPersonTakingMedication">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithMedicationManagement"/>
        <rdfs:comment xml:lang="en">Observing and checking that a person is taking his/her medication</rdfs:comment>
        <rdfs:label xml:lang="en">Monitoring Person Taking Medication</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MonotonyOfLongTermCareFacilityEnvironment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MonotonyOfLongTermCareFacilityEnvironment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EnvironmentalCausativeFactor"/>
        <rdfs:comment xml:lang="en">The tedious sameness and uniformity of the environment in the long-term care facility.</rdfs:comment>
        <rdfs:label xml:lang="en">Monotony of Long Term Care Facility Environment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MontessoriIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MontessoriIntervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:synonym xml:lang="en">Montessori Method, Montessori Approach</ncit2:synonym>
        <rdfs:comment xml:lang="en">Montessori Approach of caregiving for dementia has a similar goal of engaging the senses in order to help person with dementia rediscover the world around them. Providing the most effective care means maximizing the opportunities these individuals have to reconnect with a world they are losing access to.</rdfs:comment>
        <rdfs:label xml:lang="en">Montessori Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MontgomeryAsbergDepressionRatingScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MontgomeryAsbergDepressionRatingScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#assesses"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DepressionInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:abbreviation xml:lang="en">MADRS</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Montgomery-Asberg Depression Rating Scale Questionnaire</ncit2:synonym>
        <umls3:cui xml:lang="en">C4054475</umls3:cui>
        <rdfs:label xml:lang="en">Montgomery-Asberg Depression Rating Scale</rdfs:label>
        <skos:definition xml:lang="en">A standardized rating scale developed by Montgomery and Asberg in in 1978, which is used to measure the severity of depressive symptoms in patients with depression. The questionnaire contains 10 items on a scale of 0 to 6. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MoodSwing -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MoodSwing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EmotionalDistress"/>
        <ncit2:synonym xml:lang="en">Emotional Instability, Mood Change, Emotional Lability, Altered Mood, Labile Mood, Unstable Mood</ncit2:synonym>
        <umls3:cui xml:lang="en">C0085633</umls3:cui>
        <rdfs:label xml:lang="en">Mood Swing</rdfs:label>
        <skos:definition xml:lang="en">Tendency to dispaly unpredictable and rapidly changing emotions or moods. From PsycINFO Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MoralFramework -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MoralFramework">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient"/>
        <rdfs:label xml:lang="en">Moral Framework</rdfs:label>
        <skos:definition xml:lang="en">Moral framework is understood in general as a set of reasonable and coherent moral beliefs and principles that distinguish a group of people, a culture, or common and accepted values in society. From Frederick, R. (1999). A companion to business ethics. Malden, MA: Wiley-Blackwell.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Morning -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Morning">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Time"/>
        <ncit2:synonym xml:lang="en">In the Morning, During Morning</ncit2:synonym>
        <umls3:cui xml:lang="en">C0332170</umls3:cui>
        <rdfs:label xml:lang="en">Morning</rdfs:label>
        <skos:definition xml:lang="en">The time period between dawn and noon. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Mother -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Mother">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
        <ncit2:synonym xml:lang="en">Mum</ncit2:synonym>
        <umls3:cui xml:lang="en">C0026591</umls3:cui>
        <rdfs:comment xml:lang="en">A female parent of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Mother</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MotorTension -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MotorTension">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfAnxietyInDementia"/>
        <rdfs:label xml:lang="en">Motor Tension</rdfs:label>
        <skos:definition xml:lang="en">A state of muscle tension in which the individual is restless and tires easily. This symptom is associated with generalized anxiety disorder. From American Psychological Association Dictionary of Psychology</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MultidimensionalObservationScaleForElderlySubjects -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MultidimensionalObservationScaleForElderlySubjects">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">MOSES</ncit2:abbreviation>
        <rdfs:label xml:lang="en">Multidimensional Observation Scale for Elderly Subjects</rdfs:label>
        <skos:definition xml:lang="en">The Multidimensional Observation Scale for Elderly Subjects (MOSES) was designed to provide a short yet multidimensional assessment procedure that can be completed by regular staff members without resident cooperation in most geriatric care settings. From Edward Helmes,  Kalman G. Csapo,  Judith-ann Short, Standardization and Validation of the Multidimensional Observation Scale for Elderly Subject, Journal of Gerontology, Volume 42, Issue 4, July 1987, Pages 395–405, https://doi.org/10.1093/geronj/42.4.395</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MultisensoryStimulation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MultisensoryStimulation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SensoryStimulationTherapy"/>
        <ncit2:abbreviation xml:lang="en">MSS</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Multisensory Stimulation Intervention, Multisensory Intervention, Psychotherapeutic Rehab Cognitive Multisensory Stimulation</ncit2:synonym>
        <umls3:cui xml:lang="en">C4480123</umls3:cui>
        <rdfs:label xml:lang="en">Multisensory Stimulation</rdfs:label>
        <skos:definition xml:lang="en">An intervention that stimulates two or more human faculties, via visual, tactile, auditory or olfactory stimuli. From Cheng et al. 2019 Use of multisensory stimulation interventions in the treatment of major neurocognitive disorders, in Psychiatry and Clinical Psychopharmacology, 29:4</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MusicHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MusicHobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hobby"/>
        <rdfs:comment xml:lang="en">Hobby that related to music, such as listenning to music and writing songs.</rdfs:comment>
        <rdfs:label xml:lang="en">Music Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MusicTherapeuticCaregiving -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MusicTherapeuticCaregiving">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:comment xml:lang="en">The intervention that caregivers sing during assisting a person with dementia to move from one position to another. From Gotell et al. 2012 Can caregiver singing improve person transfer situations in dementia care? Music and Medicine 4:4</rdfs:comment>
        <rdfs:label xml:lang="en">Music Therapeutic Caregiving</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MusicTherapist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MusicTherapist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Therapist"/>
        <umls3:cui xml:lang="en">C0586937</umls3:cui>
        <rdfs:label xml:lang="en">Music Therapist</rdfs:label>
        <skos:definition xml:lang="en">Music therapiests use music interventions to assess clients&apos; strengths and needs, develop goals, implement services, and evaluate and document progress for individuals of all ages. Music therapists facilitate changes in physical, cognitive, emotional, and/or psychosocial health. From The U.S. National Uniform Claim Committee - Health Care Provider Taxonomy</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MusicTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MusicTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SensoryStimulationTherapy"/>
        <ncit2:abbreviation xml:lang="en">MT</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Musical Intervention, Music Intervention</ncit2:synonym>
        <umls3:cui xml:lang="en">C0026868</umls3:cui>
        <rdfs:label xml:lang="en">Music Therapy</rdfs:label>
        <skos:definition xml:lang="en">The American Music Therapy Association (AMTA) defines music therapy as the clinical and evidenc-based use of music intervention to accomplish individualized goals within a therapeutic relationship by a credentialed professional who has completed an approved music therapy program. From American Music Therapy Association 2005</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NativeLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NativeLanguage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LanguageInformation"/>
        <umls3:cui xml:lang="en">C1510558</umls3:cui>
        <rdfs:label xml:lang="en">Native Language</rdfs:label>
        <skos:definition xml:lang="en">Language that a person has been exposed to from birth or within the critical period. From Wikipedia</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NatureOfBPSDTraining -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NatureOfBPSDTraining">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonCentredCareEudcationToHealthCareProfessional"/>
        <rdfs:comment xml:lang="en">The training that is provided to health care professionals about the nature of BPSD (behavioural and psychological symptoms of dementia).</rdfs:comment>
        <rdfs:label xml:lang="en">Nature of BPSD Training</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Nausea -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Nausea">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Discomfort"/>
        <umls3:cui xml:lang="en">C0027497</umls3:cui>
        <rdfs:label xml:lang="en">Nausea</rdfs:label>
        <skos:definition xml:lang="en">An unpleasant sensation in the stomach usually accompanied by the urge to vomit. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NeedForInterpreter -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NeedForInterpreter">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LanguageInformation"/>
        <umls3:cui xml:lang="en">C1278519</umls3:cui>
        <rdfs:comment xml:lang="en">Information about - if a person need of an interpreter to assist the conversation between this person with others.</rdfs:comment>
        <rdfs:label xml:lang="en">Need for Interpreter</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Negativism -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Negativism">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EmotionalDistress"/>
        <ncit2:synonym xml:lang="en">Demonstrated Behavior Negativism</ncit2:synonym>
        <umls3:cui xml:lang="en">C0027562</umls3:cui>
        <rdfs:label xml:lang="en">Negativism</rdfs:label>
        <skos:definition xml:lang="en">State of mind or behavior characterized by extreme skepticism and persistent opposition or resistance to outside suggestions or advice. From APA, Thesaurus of Psychological Index Terms, 1994</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NeglectByHealthCareProfessional -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NeglectByHealthCareProfessional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehaviourOfHealthCareProfessional"/>
        <rdfs:comment xml:lang="en">Care recipients are neglected (involving poor care or breached of duty that cause care recipients to suffer) by health care professional.</rdfs:comment>
        <rdfs:label xml:lang="en">Neglect by Health Care Professional</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Nephew -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Nephew">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
        <umls3:cui xml:lang="en">C0337579</umls3:cui>
        <rdfs:label xml:lang="en">Nephew</rdfs:label>
        <skos:definition xml:lang="en">A son of one&apos;s brother or sister. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Nephrologist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Nephrologist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalPractitioner"/>
        <umls3:cui xml:lang="en">C0260039</umls3:cui>
        <rdfs:label xml:lang="en">Nephrologist</rdfs:label>
        <skos:definition xml:lang="en">Qualified medical professionals who specialize in treating kidney disease. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NeurologicalAssessment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NeurologicalAssessment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthAssessment"/>
        <ncit2:synonym xml:lang="en">Neurological Examination, Neurologic Examination, Assessing Neurological Performance, Assessing Neurological Satus</ncit2:synonym>
        <umls3:cui xml:lang="en">C0027853</umls3:cui>
        <rdfs:label xml:lang="en">Neurological Assessment</rdfs:label>
        <skos:definition xml:lang="en">The assessment of the functionality of the brain, spinal column, and nerves. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Neuropathy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Neuropathy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:synonym xml:lang="en">Peripheral Neuropathy, Nerve Disorder</ncit2:synonym>
        <umls3:cui xml:lang="en">C0442874</umls3:cui>
        <rdfs:label xml:lang="en">Neuropathy</rdfs:label>
        <skos:definition xml:lang="en">A disorder affecting the cranial nerves or the peripheral nervous system. It manifests with pain, tingling, numbness, and muscle weakness. It may be the result of physical injury, toxic substances, viral diseases, diabetes, renal failure, cancer, and drugs. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NeuropsychiatricInventory -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NeuropsychiatricInventory">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">NPI</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Neuropsychiatric Inventory Questiojnnaire, Neuropsychiatric Interview</ncit2:synonym>
        <umls3:cui xml:lang="en">C3539727</umls3:cui>
        <rdfs:comment xml:lang="en">The Neuropsychiatric Inventory (NPI) was developed by Cummings et al. to access dementia-related behavioural symptoms. The NPI originally examined 10 sub-domains of behavioural functioning: delusions, hallucinations, agitation/aggression, dysphoria, anxiety, euphoria, apathy, disinhibition, irritability/lability, and aberrant motor activity. Two more sub-domains have been added since its development: night-time behavioural disturbances and appetite and eating abnormalities.</rdfs:comment>
        <rdfs:label xml:lang="en">Neuropsychiatric Inventory</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NeuropsychiatricInventoryClinicianRatingScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NeuropsychiatricInventoryClinicianRatingScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">NPI-C</ncit2:abbreviation>
        <rdfs:label xml:lang="en">Neuropsychiatric Inventory - Clinician Rating Scale</rdfs:label>
        <skos:definition xml:lang="en">Neuropsychiatric Inventory - Clinician Rating Scale is an assessment tool of neuropsychiatric symptoms in dementia. It is a revised version of the Neuropsychiatric Inventory (NPI), including expanded domains and items, and a clinician rating methodology. It was developed by Medeiros et al. in 2010.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NeuropsychiatricInventoryNursingHomeVersion -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NeuropsychiatricInventoryNursingHomeVersion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">NPI-NH</ncit2:abbreviation>
        <rdfs:comment xml:lang="en">Neuropsychiatric Inventory - Nursing Home (NPI-NH) Version was developed to help characterize the neuropsychiatric symptoms and psychopathology of patients with Alzheimer&apos;s disease and other dementia when the patients are residents in extended care facilities or other care settings where information is gathered from health care professionals. The NPI-NH was derived from the Neuropsychiatric Inventory (NPI), which was originally developed for the assessment of neuropsychiatric symptoms and psychopathology in community-dwelling patients where information was obtained from family caregivers. The content of the questions of the NPI and NPI-NH are identical but have been rephrased appropriately. In addition, the caregiver distress scale of the NPI has been changed to an occupational disruptiveness scale for the NPI-NH to allow an assessment of the impact of behavioral disturbances on professional caregivers.</rdfs:comment>
        <rdfs:label xml:lang="en">Neuropsychiatric Inventory - Nursing Home Version</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NicotineAddiction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NicotineAddiction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Addiction"/>
        <umls3:cui xml:lang="en">C5241305</umls3:cui>
        <rdfs:label xml:lang="en">Nicotine Addiction</rdfs:label>
        <skos:definition xml:lang="en">Nicotine addiction occurs when a person becomes addicted to nicotine, which is a chemical found in tobacco. From HealthLine.com</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Niece -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Niece">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
        <umls3:cui xml:lang="en">C0337578</umls3:cui>
        <rdfs:label xml:lang="en">Niece</rdfs:label>
        <skos:definition xml:lang="en">A daughter of one&apos;s brother or sister. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Night -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Night">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Time"/>
        <ncit2:synonym xml:lang="en">At Night, Nocturnal, Night Time</ncit2:synonym>
        <umls3:cui xml:lang="en">C0240526</umls3:cui>
        <rdfs:label xml:lang="en">Night</rdfs:label>
        <skos:definition xml:lang="en">The time in every 24 hour period when it is dark. From the U.Sl. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NightmareDisorder -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NightmareDisorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SleepDisturbance"/>
        <ncit2:synonym xml:lang="en">Dream Anxiety Disorder, Nightmare, Paroniria</ncit2:synonym>
        <umls3:cui xml:lang="en">C3887605</umls3:cui>
        <rdfs:label xml:lang="en">Nightmare Disorder</rdfs:label>
        <skos:definition xml:lang="en">A sleep disorder characterized by the repeated occurrence of frightening dreams which precipitate awakenings from sleep; on wakening, the individual becomes fully alert and oriented and has detailed recall of the nightmare, which usually involves imminent danger or extreme embarrassment to the individual. From the U.S. Nationa Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Noise -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Noise">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OverstimulationOfHearingSense"/>
        <ncit2:synonym xml:lang="en">Ambient Noise</ncit2:synonym>
        <umls3:cui xml:lang="en">C0028263</umls3:cui>
        <rdfs:label xml:lang="en">Noise</rdfs:label>
        <skos:definition xml:lang="en">Undesired sound, especially a random mix of different frequencies. From CRISP Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NoiseControl -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NoiseControl">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentalIntervention"/>
        <ncit2:synonym xml:lang="en">Reducing Noise, Control of Noise</ncit2:synonym>
        <umls3:cui xml:lang="en">C1822204</umls3:cui>
        <rdfs:comment xml:lang="en">The control or reduce undesirable or excessive noise.</rdfs:comment>
        <rdfs:label xml:lang="en">Noise Control</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NoiseFromAirConditioner -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NoiseFromAirConditioner">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Noise"/>
        <rdfs:comment xml:lang="en">The noise from air conditioner.</rdfs:comment>
        <rdfs:label xml:lang="en">Noise from Air Conditioner</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NoiseFromLawnMower -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NoiseFromLawnMower">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Noise"/>
        <rdfs:comment xml:lang="en">The noise from a lawn mower, that is also known as a mower and grass cutter.</rdfs:comment>
        <rdfs:label xml:lang="en">Noise from Lawn Mower</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NoiseFromMedicalEquipment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NoiseFromMedicalEquipment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Noise"/>
        <rdfs:comment xml:lang="en">The noise from medical equipments.</rdfs:comment>
        <rdfs:label xml:lang="en">Noise from Medical Equipment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NoiseFromOtherPeople -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NoiseFromOtherPeople">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Noise"/>
        <rdfs:comment xml:lang="en">The noise from other people in the long term care facility.</rdfs:comment>
        <rdfs:label xml:lang="en">Noise from Other People</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NoiseFromTV -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NoiseFromTV">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Noise"/>
        <rdfs:comment xml:lang="en">The noise from televisions.</rdfs:comment>
        <rdfs:label xml:lang="en">Noise from TV</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NoiseOfDoorBanging -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NoiseOfDoorBanging">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Noise"/>
        <rdfs:comment xml:lang="en">The sudden loud, sharp noise from door banging.</rdfs:comment>
        <rdfs:label xml:lang="en">Noise of Door Banging</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Nonbinary -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Nonbinary">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PerceivedGender"/>
        <rdfs:comment xml:lang="en">Gender identity that is outside of the man/woman gender binary.</rdfs:comment>
        <rdfs:label xml:lang="en">Non-Binary</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NonpharmacologicalIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NonpharmacologicalIntervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Intervention"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#hasDeliveryMode"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DeliveryModeOfNonpharmacologicalIntervention"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#hasEffectivenessLevel"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectivenessLevelOfNonpharmacologicalIntervention"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isAffectedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FactorAffectingImplementationOfNonpharmacologicalIntervention"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PharmacologicalIntervention"/>
        <ncit2:synonym xml:lang="en">Environmental and Psychosocial Intervention, Psychological, Behavioral, and Environmental Intervention, Non-drug Intervention, Nonpharmacologic Treatment, Nonpharmacological Treatment, Nonpharmacotherapeutic Intervention</ncit2:synonym>
        <rdfs:comment xml:lang="en">The intervention which does not use drugs.</rdfs:comment>
        <rdfs:label xml:lang="en">Nonpharmacological Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NonpharmacologicalInterventionTraining -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NonpharmacologicalInterventionTraining">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonCentredCareEudcationToHealthCareProfessional"/>
        <rdfs:comment xml:lang="en">The training that is provided to health care professionals about nonpharmacological intervention.</rdfs:comment>
        <rdfs:label xml:lang="en">Nonpharmacological Intervention Training</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NonpharmacologicalTreatmentKnowledgeOfHealthCareProfessional -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NonpharmacologicalTreatmentKnowledgeOfHealthCareProfessional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FactorAffectingImplementationOfNonpharmacologicalIntervention"/>
        <ncit2:synonym xml:lang="en">Health Care Professional&apos;s Knowledge in Nonpharmacological intervention</ncit2:synonym>
        <rdfs:comment xml:lang="en">The health care professionals&apos; knowledge of using non-drug approaches.</rdfs:comment>
        <rdfs:label xml:lang="en">Nonpharmacological Treatment Knowledge of Health Care Professional</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NotEffective -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NotEffective">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectivenessLevelOfNonpharmacologicalIntervention"/>
        <terms:source xml:lang="en">Wiskow, K. M., Donaldson, J. M., &amp; Matter, A. L. (2017). An evaluation of generalization of compliance across response types. Behavior Analysis: Research and Practice, 17(4), 402-420. http://dx.doi.org/10.1037/bar0000087</terms:source>
        <rdfs:comment xml:lang="en">Not producing intended results</rdfs:comment>
        <rdfs:label xml:lang="en">Not Effective</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NumberOfChildren -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NumberOfChildren">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DemographicInformation"/>
        <umls3:cui xml:lang="en">C2229974</umls3:cui>
        <rdfs:comment xml:lang="en">Number of children a person has.</rdfs:comment>
        <rdfs:label xml:lang="en">Number of Children</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Nurse -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Nurse">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessional"/>
        <ncit2:synonym xml:lang="en">Nursing Personnel, Professional Nurse</ncit2:synonym>
        <umls3:cui xml:lang="en">C0028661</umls3:cui>
        <rdfs:label xml:lang="en">Nurse</rdfs:label>
        <skos:definition xml:lang="en">Professionals qualified by graduation from an accredited school of nursing and by passage of a national licensing examination to practice nursing. They provide services to patients requiring assistance in recovering or maintaining their physical or mental health. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursePractitioner -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursePractitioner">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Nurse"/>
        <ncit2:abbreviation xml:lang="en">NP</ncit2:abbreviation>
        <umls3:cui xml:lang="en">C0028657</umls3:cui>
        <rdfs:label xml:lang="en">Nurse Practitioner</rdfs:label>
        <skos:definition xml:lang="en">Nurse Practitioners (NPs), are registered nurses with additional education and experience who are able to order and interpret diagnostic tests, communicate diagnoses, prescribe pharmaceuticals and perform specific procedures. From SNOMEDCT</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingManager -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingManager">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessional"/>
        <ncit2:synonym xml:lang="en">Nurse Manager</ncit2:synonym>
        <rdfs:comment xml:lang="en">A nursing manager is responsible for supervising nursing staff in a clinical setting.</rdfs:comment>
        <rdfs:label xml:lang="en">Nursing Manager</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonWithDementiaFocusedIntervention"/>
        <ncit2:synonym xml:lang="en">Nursing Care Intervention, General Nursing Care</ncit2:synonym>
        <umls3:cui xml:lang="en">C0204650</umls3:cui>
        <rdfs:comment xml:lang="en">The basic care practices that nurses can provide to intervene the emotional and mood disturbances in dementia</rdfs:comment>
        <rdfs:label xml:lang="en">Nursing Practice Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingStation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingStation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LocationOfManifestationOfEmotionalAndMoodDisturbance"/>
        <ncit2:synonym xml:lang="en">Nurse Station, Nurse&apos;s Station, Nurse Office</ncit2:synonym>
        <umls3:cui xml:lang="en">C0179662</umls3:cui>
        <rdfs:label xml:lang="en">Nursing Station</rdfs:label>
        <skos:definition xml:lang="en">An area in a clinic, unit, or ward in a health care facility that serves as the administrative center for nursing care. From Mosby&apos;s Medical Dictionary, 8th ed</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingTeamLeader -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingTeamLeader">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessional"/>
        <umls3:cui xml:lang="en">C0557544</umls3:cui>
        <rdfs:comment xml:lang="en">The nurse leader who oversees a team of nurses, makes decisions and directs patient care initiatives.</rdfs:comment>
        <rdfs:label xml:lang="en">Nursing Team Leader</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Nutritionist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Nutritionist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessional"/>
        <umls3:cui xml:lang="en">C0237083</umls3:cui>
        <rdfs:label xml:lang="en">Nutritionist</rdfs:label>
        <skos:definition xml:lang="en">Persons specially trained in nutrition sciences. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Observation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Observation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Patient Observation, Watchful Waiting, Active Surveillance, Expectant Management, Patient Status Observation, Deferred Therapy</ncit2:synonym>
        <umls3:cui xml:lang="en">C0700325</umls3:cui>
        <rdfs:label xml:lang="en">Observation</rdfs:label>
        <skos:definition xml:lang="en">Clinical management approach wherein immediate therapy is not provided but there is a period of observation during which periodic tests monitor patient and the progression of the illness. From Driffield T, Smith PC Med Decis Making. 2007 Mar-Apr; 27(2):178-188</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ObservedEmotionRatingScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ObservedEmotionRatingScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">OERS</ncit2:abbreviation>
        <rdfs:label xml:lang="en">Observed Emotion Rating Scale</rdfs:label>
        <skos:definition xml:lang="en">The Observed Emotion Rating Scale, previously named the Apparent Affect Rating Scale, is an observational tool for rating two positive emotions (pleasure and general alertness) and three negative emotions (anger, anxiety or fear, and sadness). From Lawton MP, Van Haitsma K, Klapper JA. Observed Emotion Rating Scale. 1999.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ObstructiveSleepApnea -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ObstructiveSleepApnea">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SleepDisturbance"/>
        <ncit2:abbreviation xml:lang="en">OSA</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Sleep Apnea Obstructive Syndrome, Obstructive Apnea, Apnea Obstructive Sleeping, Apnea Obstructive Sleep</ncit2:synonym>
        <umls3:cui xml:lang="en">C0520679</umls3:cui>
        <rdfs:label xml:lang="en">Obstructive Sleep Apnea</rdfs:label>
        <skos:definition xml:lang="en">A disorder characterized by recurrent apneas during sleep despite persistent respiratory efforts. It is due to upper airway obstruction. FromMeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ObtainingInformedConsent -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ObtainingInformedConsent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TreatmentPlanDevelopment"/>
        <ncit2:synonym xml:lang="en">Asking for Consent</ncit2:synonym>
        <umls3:cui xml:lang="en">C0514060</umls3:cui>
        <rdfs:comment xml:lang="en">The activity of obtaining the informed consent from a care recipient or his/her legal representative.</rdfs:comment>
        <rdfs:label xml:lang="en">Obtaining Informed Consent</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OccupationalDeprivation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OccupationalDeprivation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <rdfs:label xml:lang="en">Occupational Deprivation</rdfs:label>
        <skos:definition xml:lang="en">A state of preclusion from engagement in occupations of necessity and/or meaning due to factors that stand outside the immediate control of the individual. From Whiteford, G. (2010). When people cannot participate: occupational deprivation. In C.H. Christiansen &amp; E.A. Townsend (Eds.) Introduction to occupation: the art and science of living Second Edition. (pp.303-328) Upper Saddle Creek, NJ: Prentice Hall.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OccupationalTherapist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OccupationalTherapist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Therapist"/>
        <ncit2:abbreviation xml:lang="en">OT</ncit2:abbreviation>
        <umls3:cui xml:lang="en">C0028807</umls3:cui>
        <rdfs:label xml:lang="en">Occupational Therapist</rdfs:label>
        <skos:definition xml:lang="en">Professionals trained to help individuals develop or regain skills needed to achieve independence in their lives. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OccupationalTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OccupationalTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">OT</ncit2:abbreviation>
        <umls3:cui xml:lang="en">C1318464</umls3:cui>
        <rdfs:label xml:lang="en">Occupational Therapy</rdfs:label>
        <skos:definition xml:lang="en">Skilled treatment that helps individuals achieve independence in all facets of their lives. It assists in the development of skills needed for independent living. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Oedema -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Oedema">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:synonym xml:lang="en">Edema, Dropsy, Hydrops, Waterlogged</ncit2:synonym>
        <umls3:cui xml:lang="en">C0013604</umls3:cui>
        <rdfs:label xml:lang="en">Oedema</rdfs:label>
        <skos:definition xml:lang="en">Abnormal fluid accumulation in tissues or body cavities. Most cases of edema are present under the skin in subcutaneous tissue. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OfferingDrink -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OfferingDrink">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Providing Drink, Giving Drink, Offering Fluid</ncit2:synonym>
        <rdfs:comment xml:lang="en">The intervention of offering drink to a person with dementia, such as water, warm milk or tea.</rdfs:comment>
        <rdfs:label xml:lang="en">Offering Drink</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OfferingFood -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OfferingFood">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Providing Food</ncit2:synonym>
        <umls3:cui xml:lang="en">C3650749</umls3:cui>
        <rdfs:comment xml:lang="en">The intervention of offering food to a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Offering Food</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OfferingTwoChoices -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OfferingTwoChoices">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionSuggested"/>
        <rdfs:comment xml:lang="en">People should offer two choices (not too many choices) when communicating with a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Offering Two Choices</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OlfactoryImpairment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OlfactoryImpairment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SensoryImpairment"/>
        <ncit2:synonym xml:lang="en">Impaired Olfaction, Impaired Smell, Sense of Smell Impaired, Hyposmia, Reduced Sense of Smell, Decreased Sense of Smell, Impaired Sense of Smell</ncit2:synonym>
        <umls3:cui xml:lang="en">C2364082</umls3:cui>
        <rdfs:label xml:lang="en">Olfactory Impairment</rdfs:label>
        <skos:definition xml:lang="en">Decreased ability to smell. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OneOnOnePersonalContact -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OneOnOnePersonalContact">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialInteractionIntervention"/>
        <ncit2:synonym xml:lang="en">One on One Time, One to One Interaction, 1:1 time, 1x1 time, 1 on 1 time</ncit2:synonym>
        <rdfs:comment xml:lang="en">The intervention of one person (health care professional) to one care recipient.</rdfs:comment>
        <rdfs:label xml:lang="en">One on One Interaction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OpioidAddiction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OpioidAddiction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Addiction"/>
        <ncit2:synonym xml:lang="en">Opiate Addiction, Opioid Dependence, Opiate Dependence</ncit2:synonym>
        <umls3:cui xml:lang="en">C0524662</umls3:cui>
        <rdfs:comment xml:lang="en">Addiction to opioids which sometimes called narcotics.</rdfs:comment>
        <rdfs:label xml:lang="en">Opioid Addiction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Optometrist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Optometrist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessional"/>
        <umls3:cui xml:lang="en">C0029146</umls3:cui>
        <rdfs:label xml:lang="en">Optometrist</rdfs:label>
        <skos:definition xml:lang="en">Qualified professionals trained in primary eye and vision care, including measurement of visual abilities, diagnosing disorders of the visual system and provision of treatment such as prescriptions for correction of visual defects with lenses or glasses and vision therapy. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OralDisease -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OralDisease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:synonym xml:lang="en">Mouth Disease,  Disorder of Mouth, Oral Disorder</ncit2:synonym>
        <umls3:cui xml:lang="en">C0026636</umls3:cui>
        <rdfs:label xml:lang="en">Oral Disease</rdfs:label>
        <skos:definition xml:lang="en">Diseases involving the mouth. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OrganisationalCulture -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OrganisationalCulture">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FactorAffectingImplementationOfNonpharmacologicalIntervention"/>
        <ncit2:synonym xml:lang="en">Workplace Culture, Organizational Culture</ncit2:synonym>
        <umls3:cui xml:lang="en">C0029242</umls3:cui>
        <rdfs:label xml:lang="en">Organisational Culture</rdfs:label>
        <skos:definition xml:lang="en">Beliefs and values shared by all members of the organization. These shared values, which are subject to change, are reflected in the day to day management of the organization. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Outburst -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Outburst">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EmotionalDistress"/>
        <ncit2:synonym xml:lang="en">Emotional Outburst</ncit2:synonym>
        <umls3:cui xml:lang="en">C0679475</umls3:cui>
        <rdfs:comment xml:lang="en">The sudden release of strong emotion.</rdfs:comment>
        <rdfs:label xml:lang="en">Outburst</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Overnight -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Overnight">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Time"/>
        <umls3:cui xml:lang="en">C0439583</umls3:cui>
        <rdfs:label xml:lang="en">Overnight</rdfs:label>
        <skos:definition xml:lang="en">Occurring between nightfall and dawn. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OverstimulationFromEnvironment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OverstimulationFromEnvironment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentCausativeFactor"/>
        <rdfs:comment xml:lang="en">A person&apos;s senses are overstimulated by something from the environment.</rdfs:comment>
        <rdfs:label xml:lang="en">Overstimulation from Environment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OverstimulationOfHearingSense -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OverstimulationOfHearingSense">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OverstimulationFromEnvironment"/>
        <rdfs:comment xml:lang="en">The hearing sense of a person is overstimulated.</rdfs:comment>
        <rdfs:label xml:lang="en">Overstimulation of Hearing Sense</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OverstimulationOfSmellSense -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OverstimulationOfSmellSense">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OverstimulationFromEnvironment"/>
        <rdfs:comment xml:lang="en">The smell sense of a person is overstimulated.</rdfs:comment>
        <rdfs:label xml:lang="en">Overstimulation of Smell Sense</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OverstimulationOfTasteSense -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OverstimulationOfTasteSense">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OverstimulationFromEnvironment"/>
        <rdfs:comment xml:lang="en">The taste sense of a person is overstimulated.</rdfs:comment>
        <rdfs:label xml:lang="en">Overstimulation of Taste Sense</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OverstimulationOfTouchSense -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OverstimulationOfTouchSense">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OverstimulationFromEnvironment"/>
        <rdfs:comment xml:lang="en">The touch sense of a person is overstimulated.</rdfs:comment>
        <rdfs:label xml:lang="en">Overstimulation of Touch Sense</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OverstimulationOfVisionSense -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OverstimulationOfVisionSense">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OverstimulationFromEnvironment"/>
        <rdfs:comment xml:lang="en">The vision sense of a person is overstimulated.</rdfs:comment>
        <rdfs:label xml:lang="en">Overstimulation of Vision Sense</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PRIDEBathingApproach -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PRIDEBathingApproach">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:label xml:lang="en">PRIDE Bathing Approach</rdfs:label>
        <skos:definition xml:lang="en">PRIDE (privacy, reassurance, information, distraction, and evaluation) Bathing Approach: Privacy was stressed by encouraging caregivers to close the bathing room door or attend to not undressing a person with dementia before necessary. Reassurance to people with dementia was about repeatedly reminding the person with dementia that he or she was safe and not alone. Informaiton refers to the giving of information to people with dementia before and during the bath. Distraction refers to the use of distraction, such as a pleasant topic to distract a person with dementia. Evaluation refers to the constant awareness of how the person with dementia was responding. From Mickus et al. 2002 Developing effective bathing strategies for reducing problematic behavior for residents with dementia: the PRIDE approach. Journal of Mental Health and Aging, 8:1</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Pacing -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Pacing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyNonaggressiveBehaviour"/>
        <ncit2:synonym xml:lang="en">Pacing up and down</ncit2:synonym>
        <umls3:cui xml:lang="en">C0562458</umls3:cui>
        <rdfs:label xml:lang="en">Pacing</rdfs:label>
        <skos:definition xml:lang="en">The behaviour of walking with regular slow or fast paces, especially without a particular destination.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Pain -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Pain">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Discomfort"/>
        <umls3:cui xml:lang="en">C0030193</umls3:cui>
        <rdfs:comment xml:lang="en">A highly unpleasant sensation</rdfs:comment>
        <rdfs:label xml:lang="en">Pain</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PainAssessment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PainAssessment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthAssessment"/>
        <ncit2:synonym xml:lang="en">Assessing Pain, Staff Assessment for Pain</ncit2:synonym>
        <umls3:cui xml:lang="en">C2707300</umls3:cui>
        <rdfs:comment xml:lang="en">The actions performed by staff to assess the pain of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Pain Assessment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PaintingHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PaintingHobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hobby"/>
        <umls3:cui xml:lang="en">C3843875</umls3:cui>
        <rdfs:comment xml:lang="en">Hobby of painting.</rdfs:comment>
        <rdfs:label xml:lang="en">Painting Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PaintingPicture -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PaintingPicture">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">The activity of painting a picture.</rdfs:comment>
        <rdfs:label xml:lang="en">Painting Picture</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Palpitation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Palpitation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:synonym xml:lang="en">Heart Palpitations, Heart Throbbing</ncit2:synonym>
        <umls3:cui xml:lang="en">C0030252</umls3:cui>
        <rdfs:label xml:lang="en">Palpitation</rdfs:label>
        <skos:definition xml:lang="en">A sensation that the heart is pounding or racing, which is a non-specific sign but may be a manifestation of arrhythmia. From Human Phenotype Ontology</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PamperGroupActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PamperGroupActivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">The activity for ladies to come together regularly (e.g. once a month) and catch up whilst pampering yourself (nails and hair).</rdfs:comment>
        <rdfs:label xml:lang="en">Pamper Group Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Panic -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Panic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfAnxietyInDementia"/>
        <ncit2:synonym xml:lang="en">Panic State, Panic Reaction</ncit2:synonym>
        <umls3:cui xml:lang="en">C0030318</umls3:cui>
        <rdfs:label xml:lang="en">Panic</rdfs:label>
        <skos:definition xml:lang="en">A state of extreme acute, intense anxiety and unreasoning fear accompanied by disorganization of personality function. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PanicDisorder -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PanicDisorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AnxietyDisorder"/>
        <umls3:cui xml:lang="en">C0030319</umls3:cui>
        <rdfs:label xml:lang="en">Panic Disorder</rdfs:label>
        <skos:definition xml:lang="en">An anxiety disorder characterized by multiple unexpected panic attacks with persistent concern of recurring attacks. Panic disorder may or may not be accompanied by agoraphobia. From The U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ParticipatingActiveMusicTherapyByMovingBody -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ParticipatingActiveMusicTherapyByMovingBody">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ActiveMusicTherapy"/>
        <rdfs:comment xml:lang="en">The active music therapy that requries the participants to move their body with the music.</rdfs:comment>
        <rdfs:label xml:lang="en">Participating Active Music Therapy by Moving Body</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ParticipatingActiveMusicTherapyByPlayingMusicalInstrument -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ParticipatingActiveMusicTherapyByPlayingMusicalInstrument">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ActiveMusicTherapy"/>
        <rdfs:comment xml:lang="en">The active music therapy that requries the participatns to play musical instruments.</rdfs:comment>
        <rdfs:label xml:lang="en">Participating Active Music Therapy by Playing Musical Instrument</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ParticipatingActiveMusicTherapyBySinging -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ParticipatingActiveMusicTherapyBySinging">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ActiveMusicTherapy"/>
        <rdfs:comment xml:lang="en">The active music therapy that requires participants to sing with the music.</rdfs:comment>
        <rdfs:label xml:lang="en">Participating Active Music Therapy by Singing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ParticipatingActiveMusicTherapyByWritingSong -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ParticipatingActiveMusicTherapyByWritingSong">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ActiveMusicTherapy"/>
        <rdfs:comment xml:lang="en">The active music therapy that requires participatns to write a song.</rdfs:comment>
        <rdfs:label xml:lang="en">Participating Active Music Therapy by Writing Song</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PassiveMusicTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PassiveMusicTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MusicTherapy"/>
        <ncit2:synonym xml:lang="en">Receptive Music Therapy</ncit2:synonym>
        <rdfs:comment xml:lang="en">Passive Music Therapy encompasses techniques that allow the participant to listen to music as opposed to being an active contributor. The music used may be live or recorded and of any genre.</rdfs:comment>
        <rdfs:label xml:lang="en">Passive Music Therapy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PassivityInDementiaScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PassivityInDementiaScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">PDS</ncit2:abbreviation>
        <rdfs:label xml:lang="en">Passivity in Dementia Scale</rdfs:label>
        <skos:definition xml:lang="en">Passivity in Dementia Scale (PDS) is an observer rating scale of 42 behaviors: 12 passive behav- ior items scored in the negative, and 30 active behavior items scored in the positive. Lower scores indicate greater passivity. Five subscale scores are obtained: thinking, emotions, interaction with the environment, interaction with people, and activities. From Kolanowski et al. 2006 Factors that relate to activity engagement in nursing home residents. American Journal of Alzheimer&apos;s Disease and Other Dementias, 21:1</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PastOccupation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PastOccupation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient"/>
        <ncit2:synonym xml:lang="en">Past Work, Former Career</ncit2:synonym>
        <rdfs:comment xml:lang="en">Information about the past occupations (job or profession) of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Past Occupation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PastoralCare -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PastoralCare">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:synonym xml:lang="en">Pastoral Counseling</ncit2:synonym>
        <umls3:cui xml:lang="en">C0030643</umls3:cui>
        <rdfs:label xml:lang="en">Pastoral Care</rdfs:label>
        <skos:definition xml:lang="en">Counseling or comfort given by ministers, priests, rabbis, etc., to those in need of help with emotional problems or stressful situations. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PastoralCounselor -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PastoralCounselor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessional"/>
        <ncit2:synonym xml:lang="en">Pastoral Care Worker</ncit2:synonym>
        <umls3:cui xml:lang="en">Cc2985482</umls3:cui>
        <rdfs:label xml:lang="en">Pastoral Counselor</rdfs:label>
        <skos:definition xml:lang="en">A person trained in both psychology and theology who can provide psychological and spiritual guidance to individuals and families. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PatientHealthQuestionnaire9 -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PatientHealthQuestionnaire9">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">PHQ-9</ncit2:abbreviation>
        <umls3:cui xml:lang="en">C4083201</umls3:cui>
        <rdfs:label xml:lang="en">Patient Health Questionnaire - 9</rdfs:label>
        <skos:definition xml:lang="en">A 9-item scale using each of the 9 DSM-IV criteria with self-reported frequency of &quot;0&quot; (not at all) to &quot;3&quot; (nearly every day). One of the most widely used instruments to assess depression (Kroenke K, Spitzer RL, Williams JBW. The PHQ-9: Validity of a brief depression severity measure. J Gen Intern Med 2001; 16:606-613), PHQ-9 scores of 5, 10, 15, and 20 represent mild, moderate, moderately severe, and severe depression, respectively. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PayingCloseAttentionToSharpObject -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PayingCloseAttentionToSharpObject">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <rdfs:comment xml:lang="en">Staff need to pay close attention to a person with suicidal ideation during any time when around sharp objects.</rdfs:comment>
        <rdfs:label xml:lang="en">Paying Close Attention to Sharp Object</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PeanutAllergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PeanutAllergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FoodAllergy"/>
        <ncit2:synonym xml:lang="en">Allergy to Peanut, Peanut Hypersensitivity, Groundnut Hypersensitivity</ncit2:synonym>
        <umls3:cui xml:lang="en">C0559470</umls3:cui>
        <rdfs:label xml:lang="en">Peanut Allergy</rdfs:label>
        <skos:definition xml:lang="en">Allergic reaction to peanuts that is triggered by the immune system. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PerceivedGender -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PerceivedGender">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GenderIdentity"/>
        <rdfs:comment xml:lang="en">Gender of a person that is perceived by oneself.</rdfs:comment>
        <rdfs:label xml:lang="en">Perceived Gender</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PeripheralVascularDisease -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PeripheralVascularDisease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:abbreviation xml:lang="en">PVD</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Peripheral Angiopathies</ncit2:synonym>
        <umls3:cui xml:lang="en">C0085096</umls3:cui>
        <rdfs:label xml:lang="en">Peripheral Vascular Disease</rdfs:label>
        <skos:definition xml:lang="en">Any disorder affecting blood flow through the veins or arteries outside of the heart. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Person -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Person">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#conducts"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManagementActivityOfEmotionalAndMoodDisturbanceInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isAssistedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Volunteer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isTargetPersonOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManagementActivityOfEmotionalAndMoodDisturbanceInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#providesBackgroundInformation"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:synonym xml:lang="en">People</ncit2:synonym>
        <rdfs:comment xml:lang="en">Human beings related to the management of emotional and mood disturbances in people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Person</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonCentredCareEudcationToHealthCareProfessional -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonCentredCareEudcationToHealthCareProfessional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessionalFocusedIntervention"/>
        <ncit2:synonym xml:lang="en">Person Centred Care Training to Health Care Professional</ncit2:synonym>
        <rdfs:comment xml:lang="en">The education and training that provide health care professionals with knowledge and skills needed to deliver person centred care for people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Person Centred Care Education to Health Care Professional</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonCentredOrganisationalCulture -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonCentredOrganisationalCulture">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OrganisationalCulture"/>
        <ncit2:synonym xml:lang="en">Person-Centred Workplace Culture, Person-Centred Organizational Culture</ncit2:synonym>
        <rdfs:comment xml:lang="en">The organisational culture that the person is placed at the centre of the service and treated as a person first.</rdfs:comment>
        <rdfs:label xml:lang="en">Person-Centred Organisational Culture</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonName -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonName">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DemographicInformation"/>
        <umls3:cui xml:lang="en">C0027365</umls3:cui>
        <rdfs:label xml:lang="en">Person Name</rdfs:label>
        <skos:definition xml:lang="en">Word or set of words by which a person is known, addressed, or referred to. From SNOMEDCT</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonWithDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonWithDementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareRecipient"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#hasBackground"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#hasDementia"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#hasEmotionalAndMoodDisturbance"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EmotionalAndMoodDisturbanceInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#hasFamilyMember"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#hasFriend"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Friend"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#hasInterpreter"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Interpreter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#hasLegalRepresentative"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LegalRepresentative"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isCaredBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessional"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonWithoutDementia"/>
        <ncit2:abbreviation xml:lang="en">PwD</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">People with Dementia, Demented Person, Patient With Dementia</ncit2:synonym>
        <rdfs:comment xml:lang="en">People with dementia who is living in the long term care facility.</rdfs:comment>
        <rdfs:label xml:lang="en">Person with Dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonWithDementiaFocusedIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonWithDementiaFocusedIntervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NonpharmacologicalIntervention"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#matches"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The interventions targeting people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Person with Dementia Focused Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonWithoutDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonWithoutDementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareRecipient"/>
        <rdfs:comment xml:lang="en">People without dementia who is living in the long term care facility.</rdfs:comment>
        <rdfs:label xml:lang="en">Person without Dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonalHygienePreference -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonalHygienePreference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Preference"/>
        <umls3:cui xml:lang="en">C0582055</umls3:cui>
        <rdfs:comment xml:lang="en">Preference to personal hygiene, such as shaving preference, and hair care preference.</rdfs:comment>
        <rdfs:label xml:lang="en">Personal Hygiene Preference</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonalityOfHealthCareProfessional -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonalityOfHealthCareProfessional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FactorAffectingImplementationOfNonpharmacologicalIntervention"/>
        <rdfs:comment xml:lang="en">Behaviour-response patterns of health care professionals</rdfs:comment>
        <rdfs:label xml:lang="en">Personality of Health Care Professional</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonalityTrait -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonalityTrait">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient"/>
        <umls3:cui xml:lang="en">C0233849</umls3:cui>
        <rdfs:label xml:lang="en">Personality Trait</rdfs:label>
        <skos:definition xml:lang="en">The characteristics in behavior that a certain person has. from the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PessimisticThought -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PessimisticThought">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfDepressionInDementia"/>
        <umls3:cui xml:lang="en">C1821301</umls3:cui>
        <rdfs:comment xml:lang="en">Negative thoughts that tending to see the worst aspect of things or believe that the worst will happen.</rdfs:comment>
        <rdfs:label xml:lang="en">Pessimistic Thought</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PetAllergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PetAllergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Allergy"/>
        <rdfs:comment xml:lang="en">Allergies to pets (e.g., cats and dogs) with fur are common, especially among people who have other allergies or asthma.</rdfs:comment>
        <rdfs:label xml:lang="en">Pet Allergy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PetKeepingHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PetKeepingHobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hobby"/>
        <rdfs:comment xml:lang="en">Hobby of keeping domestic animals as pets.</rdfs:comment>
        <rdfs:label xml:lang="en">Pet Keeping Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PetTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PetTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AnimalAssistedTherapy"/>
        <ncit2:synonym xml:lang="en">Pet Facilitated Therapy</ncit2:synonym>
        <umls3:cui xml:lang="en">C2607895</umls3:cui>
        <rdfs:label xml:lang="en">Pet Therapy</rdfs:label>
        <skos:definition xml:lang="en">A type of therapy that uses dogs or other pets to improve the physical and mental health of patients with certain acute or chronic diseases. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Pharmacist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Pharmacist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessional"/>
        <ncit2:synonym xml:lang="en">Druggist</ncit2:synonym>
        <umls3:cui xml:lang="en">C0031323</umls3:cui>
        <rdfs:label xml:lang="en">Pharmacist</rdfs:label>
        <skos:definition xml:lang="en">Those persons legally qualified by education and training to engage in the practice of pharmacy. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PharmacologicalIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PharmacologicalIntervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Intervention"/>
        <rdfs:comment xml:lang="en">The intervention which uses drugs.</rdfs:comment>
        <rdfs:label xml:lang="en">Pharmacological Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhiladelphiaGeriatricCenterAffectRatingScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhiladelphiaGeriatricCenterAffectRatingScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">AARS</ncit2:abbreviation>
        <rdfs:label xml:lang="en">Philadelphia Geriatric Center Affect Rating Scale</rdfs:label>
        <skos:definition xml:lang="en">The 6-item Philadelphia Geriatric Center Affect Rating Scale was designed for the use of research and other staff in assessing positive affect (pleasure, interest, contentment) and negative affect (sadness, worry/anxiety, and anger) by direct observation of facial expression, body movement, and other cues that do not depend on self-report. From Lawton MP, Van Haitsma K, Klapper J. Observed affect in nursing home residents with Alzheimer&apos;s disease. J Gerontol B Psychol Sci Soc Sci. 1996 Jan;51(1):P3-14. doi: 10.1093/geronb/51b.1.p3. PMID: 8548515.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhoneCall -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhoneCall">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialInteractionIntervention"/>
        <rdfs:comment xml:lang="en">The treatment that involves having conversation with family members or friends of the person with dementia through the phone.</rdfs:comment>
        <rdfs:label xml:lang="en">Phone Call</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalAbility -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalAbility">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RemainingAbility"/>
        <ncit2:synonym xml:lang="en">Physical Functioning Ability, Ability to Perform General Purpose Physical Activities</ncit2:synonym>
        <umls3:cui xml:lang="en">C0565668</umls3:cui>
        <rdfs:comment xml:lang="en">Ability to perform some physical act, such as move freely and easily.</rdfs:comment>
        <rdfs:label xml:lang="en">Physical Ability</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalChangeInEnvironment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalChangeInEnvironment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentCausativeFactor"/>
        <rdfs:comment xml:lang="en">The physical changes in the environment of the long term care facility.</rdfs:comment>
        <rdfs:label xml:lang="en">Physical Change in Environment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentCausativeFactor -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentCausativeFactor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EnvironmentalCausativeFactor"/>
        <rdfs:comment xml:lang="en">The purely physical factors in the environment that may cause emotional and mood disturbances in people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Physical Environment Causative Factor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentalIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentalIntervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EnvironmentalModification"/>
        <rdfs:comment xml:lang="en">The intervention of modifying the physical environment of people living with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Physical Environmental Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalExamination -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalExamination">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthAssessment"/>
        <ncit2:abbreviation xml:lang="en">PE</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Physical Health Assessment, Assessment of Physical Health, Physical Exam, Physical Assessment</ncit2:synonym>
        <rdfs:label xml:lang="en">Physical Examination</rdfs:label>
        <skos:definition xml:lang="en">Systematic and thorough inspection of the patient for physical signs of disease or abnormality. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalExerciseHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalExerciseHobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hobby"/>
        <rdfs:comment xml:lang="en">Hobby of doing physical exercise regularly.</rdfs:comment>
        <rdfs:label xml:lang="en">Physical Exercise Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalExerciseTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalExerciseTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:synonym xml:lang="en">Physical Therapy Exercise, Rehavilitation Exercise, Therapuetic Exercise, Exercise Therapy, Exercise Intervention</ncit2:synonym>
        <umls3:cui xml:lang="en">C0452240</umls3:cui>
        <rdfs:label xml:lang="en">Physical Exercise Therapy</rdfs:label>
        <skos:definition xml:lang="en">Activities to promote physical functioning. From Clinical Care Classification</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalLimitation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalLimitation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <umls3:cui xml:lang="en">C5381941</umls3:cui>
        <rdfs:comment xml:lang="en">Having difficulty performing physical activities.</rdfs:comment>
        <rdfs:label xml:lang="en">Physical Limitation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalRestraint -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalRestraint">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Physical Restrictive Practice</ncit2:synonym>
        <umls3:cui xml:lang="en">C0035260</umls3:cui>
        <rdfs:comment xml:lang="en">The intervention of using physical means to restrict the movement of all or part of the body.</rdfs:comment>
        <rdfs:label xml:lang="en">Physical Restraint</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalTherapist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalTherapist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Therapist"/>
        <ncit2:abbreviation xml:lang="en">PT</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Physiotherapist</ncit2:synonym>
        <umls3:cui xml:lang="en">C2362565</umls3:cui>
        <rdfs:label xml:lang="en">Physical Therapist</rdfs:label>
        <skos:definition xml:lang="en">Persons trained in physical therapy specialty to make use of physical therapy modalities to prevent, correct, and alleviate movement dysfunction. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyAggressiveBehaviour -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyAggressiveBehaviour">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Agitation"/>
        <ncit2:synonym xml:lang="en">Physical Aggression, Hurting Behaviour, Hurting</ncit2:synonym>
        <umls3:cui xml:lang="en">C4534295</umls3:cui>
        <rdfs:comment xml:lang="en">The behaviour that is aggressive or combative to self or others.</rdfs:comment>
        <rdfs:label xml:lang="en">Physically Aggressive Behaviour</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyNonaggressiveBehaviour -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyNonaggressiveBehaviour">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Agitation"/>
        <rdfs:comment xml:lang="en">The behaviours that are not intending to cause physical harm, but departing from an accepted standard.</rdfs:comment>
        <rdfs:label xml:lang="en">Physically Nonaggressive Behaviour</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Physiotherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Physiotherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:synonym xml:lang="en">Physical Therapy</ncit2:synonym>
        <umls3:cui xml:lang="en">C0949766</umls3:cui>
        <rdfs:label xml:lang="en">Physiotherapy</rdfs:label>
        <skos:definition xml:lang="en">The therapies to prevent, correct, or alleviate dysfunction of anatomic or physiologic origin, employing physical phenomena such as temperature, light, water, and sound, as well as exercise and massage. From the Computer Retrieval of Information on Scientific Projects Thesaurus (CSP).</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PlayingBallGame -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PlayingBallGame">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">The exercise intervention involving some type of ball.</rdfs:comment>
        <rdfs:label xml:lang="en">Playing Ball Game</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PlayingBingoGame -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PlayingBingoGame">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">Bingo is a game of chance in which each player matches numbers/words/visual cues printed in different arrangements on cards.</rdfs:comment>
        <rdfs:label xml:lang="en">Playing Bingo Game</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PlayingBoardGame -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PlayingBoardGame">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <umls3:cui xml:lang="en">C2136072</umls3:cui>
        <rdfs:comment xml:lang="en">Playing the game that involves the movement of counters or other objects round a board.</rdfs:comment>
        <rdfs:label xml:lang="en">Playing Board Game</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PlayingBowling -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PlayingBowling">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PlayingBallGame"/>
        <ncit2:synonym xml:lang="en">Bowling Activity</ncit2:synonym>
        <umls3:cui xml:lang="en">C0336949</umls3:cui>
        <rdfs:label xml:lang="en">Playing Bowling</rdfs:label>
        <skos:definition xml:lang="en">A physical activity during which balls are rolled at an object or group of objects with the aim of knocking them over. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PlayingCardHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PlayingCardHobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hobby"/>
        <umls3:cui xml:lang="en">C2136032</umls3:cui>
        <rdfs:comment xml:lang="en">Hobby of playing cards.</rdfs:comment>
        <rdfs:label xml:lang="en">Playing Card Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PlayingCarpetBowels -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PlayingCarpetBowels">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PlayingBallGame"/>
        <rdfs:comment xml:lang="en">Carpet bowels is a form of bowls played indoors on a strip of carpet, at the centre of which lies an obstacle round which the bowl has to pass.</rdfs:comment>
        <rdfs:label xml:lang="en">Playing Carpet Bowels</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PlayingChairVolleyball -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PlayingChairVolleyball">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PlayingBallGame"/>
        <rdfs:comment xml:lang="en">Chair volleyball is played inside, players sit on chairs and the ball is a beach ball. Players can hit the ball as often as they want or need to get it over the net. Chair volleyball is intended to reduce stress and boost self-esteem and confidence.</rdfs:comment>
        <rdfs:label xml:lang="en">Playing Chair Volleyball</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PlayingVideoGame -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PlayingVideoGame">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">Playing a video game or computer game that is an electronic game involving interaction with a user interface or input device to generate visual feedback, e.g., Nintendo Wii Sports.</rdfs:comment>
        <rdfs:label xml:lang="en">Playing Video Game</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Podiatrist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Podiatrist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalPractitioner"/>
        <umls3:cui xml:lang="en">C0260145</umls3:cui>
        <rdfs:label xml:lang="en">Podiatrist</rdfs:label>
        <skos:definition xml:lang="en">A doctor who specializes in the care of the foot and ankle. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PoetryTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PoetryTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <umls3:cui xml:lang="en">C0871088</umls3:cui>
        <rdfs:label xml:lang="en">Poetry Therapy</rdfs:label>
        <skos:definition xml:lang="en">Poetry therapy is the use of language, symbol, and story in therapeutic, education, growth, and community-building capacities. It relies upon the use of poems, stories, song lyrics, imagery, and metaphor to facilitate personal growth, healing, and greater self-awareness. From The National Association for Poetry Therapy, Inc. (NAPT)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PointingFinger -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PointingFinger">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyNonaggressiveBehaviour"/>
        <ncit2:synonym xml:lang="en">Finger Pointing</ncit2:synonym>
        <rdfs:comment xml:lang="en">The behaviour of pointing at someone with a finger to accuse he/she or suggest he/she is guilty.</rdfs:comment>
        <rdfs:label xml:lang="en">Pointing Finger</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PolishingFavouriteObject -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PolishingFavouriteObject">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">The activity of polishing one&apos;s favourite objects.</rdfs:comment>
        <rdfs:label xml:lang="en">Polishing Favourite Object</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PoliticalRefugee -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PoliticalRefugee">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RefugeeImmigration"/>
        <umls3:cui xml:lang="en">C2242889</umls3:cui>
        <rdfs:label xml:lang="en">Political Refugee</rdfs:label>
        <skos:definition xml:lang="en">A person who has fled from a homeland because of political persecution. From Dictionary.com</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PollenAllergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PollenAllergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Allergy"/>
        <ncit2:synonym xml:lang="en">Hay Fever, Allergy to Pollen</ncit2:synonym>
        <umls3:cui xml:lang="en">C0018621</umls3:cui>
        <rdfs:label xml:lang="en">Pollen Allergy</rdfs:label>
        <skos:definition xml:lang="en">An allergy experienced as a particular time of year when trees or grasses pollinate and elicit an allergic reaction. From Human Phenotype Ontology</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PoorHygiene -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PoorHygiene">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnSelf"/>
        <ncit2:synonym xml:lang="en">Bad Hygiene</ncit2:synonym>
        <umls3:cui xml:lang="en">C0745076</umls3:cui>
        <rdfs:label xml:lang="en">Poor Hygiene</rdfs:label>
        <skos:definition xml:lang="en">Poor hygiene can be a sign of self-neglect, which is the inability or unwillingness to attend to one&apos;s personal needs. From Melissa Conrad Stöppler, 2019, Poor Hygiene: Symptoms &amp; Signs. https://www.medicinenet.com/script/main/art.asp?articlekey=41529</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PoorSleepHygiene -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PoorSleepHygiene">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <rdfs:comment xml:lang="en">The personal habits that cause poor quality of sleep.</rdfs:comment>
        <rdfs:label xml:lang="en">Poor Sleep Hygiene</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PoppingBubbleWrap -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PoppingBubbleWrap">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">The activity of popping bubble wrap.</rdfs:comment>
        <rdfs:label xml:lang="en">Popping Bubble Wrap</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PostTraumaticStressDisorder -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PostTraumaticStressDisorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AnxietyDisorder"/>
        <ncit2:abbreviation xml:lang="en">PTSD</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Post-Traumatic Stress Disorder, Post-Traumatic Neuroses</ncit2:synonym>
        <umls3:cui xml:lang="en">C0038436</umls3:cui>
        <rdfs:label xml:lang="en">Post Traumatic Stress Disorder</rdfs:label>
        <skos:definition xml:lang="en">Post-traumatic stress disorder (PTSD) is a mental health disorder that some people develop after they experience or see a traumatic event. From MEDLINEPLUS</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Preference -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Preference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient"/>
        <ncit2:synonym xml:lang="en">Predilection</ncit2:synonym>
        <umls3:cui xml:lang="en">C0558295</umls3:cui>
        <rdfs:label xml:lang="en">Preference</rdfs:label>
        <skos:definition xml:lang="en">The act, fact, or principle of giving advantages to some particular person, object, or course of action over others; designated as more desirable. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PreferredLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PreferredLanguage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LanguageInformation"/>
        <rdfs:comment xml:lang="en">Language most preferred by a person for communication.</rdfs:comment>
        <rdfs:label xml:lang="en">Preferred Language</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PreferredName -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PreferredName">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonName"/>
        <ncit2:synonym xml:lang="en">Patient Preferred Name</ncit2:synonym>
        <umls3:cui xml:lang="en">C1443234</umls3:cui>
        <rdfs:comment xml:lang="en">The name a person wishes to be known.</rdfs:comment>
        <rdfs:label xml:lang="en">Preferred Name</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PressureInjury -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PressureInjury">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Injury"/>
        <umls3:cui xml:lang="en">C4554531</umls3:cui>
        <rdfs:label xml:lang="en">Pressure Injury</rdfs:label>
        <skos:definition xml:lang="en">Injury to skin and underlying tissue resulting from prolonged pressure on the skin. From Mayo Clinic</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PressureOfSpeech -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PressureOfSpeech">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfEuphoriaInDementia"/>
        <ncit2:synonym xml:lang="en">Pressured Speech</ncit2:synonym>
        <umls3:cui xml:lang="en">C0233718</umls3:cui>
        <rdfs:label xml:lang="en">Pressure of Speech</rdfs:label>
        <skos:definition xml:lang="en">Abnormally increased rate and amount of speech, delivered with urgency. From The U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PreviousLifeEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PreviousLifeEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient"/>
        <ncit2:synonym xml:lang="en">Past Life Experience, Prior Experience, Past Experience</ncit2:synonym>
        <rdfs:comment xml:lang="en">Information about the previous life event of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Previous Life Event</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Priest -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Priest">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#conducts"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PastoralCare"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <umls3:cui xml:lang="en">C0558272</umls3:cui>
        <rdfs:label xml:lang="en">Priest</rdfs:label>
        <skos:definition xml:lang="en">A priest is a religious leader authorized to perform the sacred rituals of a religion. From Wikipedia</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProblemSolvingTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProblemSolvingTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Psychotherapy"/>
        <ncit2:abbreviation xml:lang="en">PST</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Structured Problem Solving</ncit2:synonym>
        <umls3:cui xml:lang="en">C1303140</umls3:cui>
        <rdfs:label xml:lang="en">Problem Solving Therapy</rdfs:label>
        <skos:definition xml:lang="en">Problem solving therapy involves patients learning new problem solving skills or reactivating previously learned ones. These skills can then be applied to specific life problems that are associated with psychological and somatic symptoms. From David Pierce, 2012,  Problem solving therapy: use and effectiveness in general practice, Psychological Strategies</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Prosopagnosia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Prosopagnosia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveImpairment"/>
        <ncit2:synonym xml:lang="en">Agnosia for Faces, Facial recognition Agnosia, Face Blindness, Facial Agnosia</ncit2:synonym>
        <umls3:cui xml:lang="en">C0234512</umls3:cui>
        <rdfs:comment xml:lang="en">The inability to recognize a familiar face or to learn to recognize new faces. From Cortex 1995 Jun:31(2)</rdfs:comment>
        <rdfs:label xml:lang="en">Prosopagnosia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingAVarietyOfSpaceInEnvironment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingAVarietyOfSpaceInEnvironment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentalIntervention"/>
        <rdfs:comment xml:lang="en">Providing a number of different space with various functions in the environment where people with dementia live</rdfs:comment>
        <rdfs:label xml:lang="en">Providing a Variety of Space in Environment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingActivityArea -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingActivityArea">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentalIntervention"/>
        <rdfs:comment xml:lang="en">Providing an identifiable space for activity that is accessible to people with dementia and where related equipment and materials are kept in an orderly fashion.</rdfs:comment>
        <rdfs:label xml:lang="en">Providing Activity Area</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingAdequateRest -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingAdequateRest">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Provide for Adequate Rest and Sleep, including Short-term, Daytime Naps, as Needed</ncit2:synonym>
        <umls3:cui xml:lang="en">C4713371</umls3:cui>
        <rdfs:comment xml:lang="en">Providing people with dementia adequate rest</rdfs:comment>
        <rdfs:label xml:lang="en">Providing Adequate Rest</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingCaffeineFreeBeverage -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingCaffeineFreeBeverage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Providing Non-Caffeinated Drink</ncit2:synonym>
        <rdfs:comment xml:lang="en">Providing drinks that do not contain caffeine</rdfs:comment>
        <rdfs:label xml:lang="en">Providing Caffeine-Free Beverage</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingCalmEnvironment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingCalmEnvironment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentalIntervention"/>
        <ncit2:synonym xml:lang="en">Creating a Calm and Comfortable Environment</ncit2:synonym>
        <umls3:cui xml:lang="en">C4713392</umls3:cui>
        <rdfs:comment xml:lang="en">The intervention of providing an environment that is relaxing and calm.</rdfs:comment>
        <rdfs:label xml:lang="en">Providing Calm Environment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingClearMarkedAccessToBathroom -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingClearMarkedAccessToBathroom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EnhancingVisualAccess"/>
        <rdfs:comment xml:lang="en">The intervention of providing clearly marked access to bathroom.</rdfs:comment>
        <rdfs:label xml:lang="en">Providing Clear Marked Access to Bathroom</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingClearMarkedAccessToPersonalBelonging -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingClearMarkedAccessToPersonalBelonging">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EnhancingVisualAccess"/>
        <rdfs:comment xml:lang="en">The intervention of providing clearly marked access to personal belonging.</rdfs:comment>
        <rdfs:label xml:lang="en">Providing Clear Marked Access to Personal Belonging</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingConcentratedOxygen -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingConcentratedOxygen">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Providing Oxygen Therapy</ncit2:synonym>
        <umls3:cui xml:lang="en">C2922275</umls3:cui>
        <rdfs:comment xml:lang="en">The activity of providing concentrated oxygen to a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Providing Concentrated Oxygen</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingContinenceAid -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingContinenceAid">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithContinenceCare"/>
        <ncit2:synonym xml:lang="en">Provide protective garments or incontinence pads, as needed</ncit2:synonym>
        <umls3:cui xml:lang="en">C4714635</umls3:cui>
        <rdfs:comment xml:lang="en">Providing continence product to a person who has continence needs</rdfs:comment>
        <rdfs:label xml:lang="en">Providing Continence Aid</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingCrashMatForBedsideSafety -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingCrashMatForBedsideSafety">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentalIntervention"/>
        <rdfs:comment xml:lang="en">Intervention of providing crash mats for bedside safety, crash mats will break a fall, as a result, reducing injury caused by the care recipient rolling off the bed</rdfs:comment>
        <rdfs:label xml:lang="en">Providing Crash Mat for Bedside Safety</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingDryingRackInRoom -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingDryingRackInRoom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentalIntervention"/>
        <rdfs:comment xml:lang="en">The intervention of providing a drying rack in the room of a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Providing Drying Rack In Room</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingEasyAccessToOutsideSpace -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingEasyAccessToOutsideSpace">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentalIntervention"/>
        <rdfs:comment xml:lang="en">Providing easy access for people with dementia to outside space in the long-term care facility</rdfs:comment>
        <rdfs:label xml:lang="en">Providing Easy Access to Outside Space</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingFavouriteFood -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingFavouriteFood">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <rdfs:comment xml:lang="en">The intervention of providing a person with dementia the food he/she like most.</rdfs:comment>
        <rdfs:label xml:lang="en">Providing Favourite Food</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingHoist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingHoist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentalIntervention"/>
        <ncit2:synonym xml:lang="en">Provision of Hoist</ncit2:synonym>
        <umls3:cui xml:lang="en">C0556542</umls3:cui>
        <rdfs:comment xml:lang="en">The provision of hoist devices designed for hoisting or lowering persons from one place to another.</rdfs:comment>
        <rdfs:label xml:lang="en">Providing Hoist</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingHomeLikeEnvironment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingHomeLikeEnvironment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentalIntervention"/>
        <ncit2:synonym xml:lang="en">Creating Home Familiarity in Environment, Creating Homelikeness, Simulate Homelike Environment</ncit2:synonym>
        <umls3:cui xml:lang="en">C4710627</umls3:cui>
        <rdfs:comment xml:lang="en">The intervention of creating homelikeness environment for people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Providing Home Like Environment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingPrivateBathroom -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingPrivateBathroom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentalIntervention"/>
        <rdfs:comment xml:lang="en">The intervention of providing a private bathroom for a person with dementia in the long-term care facility.</rdfs:comment>
        <rdfs:label xml:lang="en">Providing Private Bathroom</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingSafeOutsideSpace -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingSafeOutsideSpace">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentalIntervention"/>
        <rdfs:comment xml:lang="en">Long-term care facilities should provide safe outside space for people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Providing Safe Outside Space</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingSensorMat -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingSensorMat">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentalIntervention"/>
        <ncit2:synonym xml:lang="en">Providing Sensor Alarm Mat</ncit2:synonym>
        <rdfs:comment xml:lang="en">The intervention of providing a sensor alarm mat for fall prevention.</rdfs:comment>
        <rdfs:label xml:lang="en">Providing Sensor Mat</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingSingleBedroom -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingSingleBedroom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentalIntervention"/>
        <rdfs:comment xml:lang="en">The intervention of providing a single bedroom for a person with dementia in the long-term care facility.</rdfs:comment>
        <rdfs:label xml:lang="en">Providing Single Bedroom</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingSnack -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingSnack">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Providing Comfort Food, Offering Comfort Food</ncit2:synonym>
        <rdfs:comment xml:lang="en">The intervention of providing snacks to a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Providing Snack</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingSufficientLighting -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingSufficientLighting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentalIntervention"/>
        <rdfs:comment xml:lang="en">Providing adequate lighting in the environment that is suitable for people with dementia</rdfs:comment>
        <rdfs:label xml:lang="en">Providing Sufficient Lighting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PsychiatricComorbidity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PsychiatricComorbidity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <rdfs:label xml:lang="en">Psychiatric Comorbidity</rdfs:label>
        <skos:definition xml:lang="en">The co-existence of two or more psychiatric disorders. From Fridell, M., Bäckström, M., Hesse, M. et al. Prediction of psychiatric comorbidity on premature death in a cohort of patients with substance use disorders: a 42-year follow-up. BMC Psychiatry 19, 150 (2019). https://doi.org/10.1186/s12888-019-2098-3</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Psychiatrist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Psychiatrist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalPractitioner"/>
        <umls3:cui xml:lang="en">C0033872</umls3:cui>
        <rdfs:label xml:lang="en">Psychiatrist</rdfs:label>
        <skos:definition xml:lang="en">A medical doctor who specializes in the prevention, diagnose, and treatment of mental, emotional, and behavioral disorders. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Psychoeducation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Psychoeducation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <umls3:cui xml:lang="en">C0871175</umls3:cui>
        <rdfs:comment xml:lang="en">An evidence-based therapeutic intervention for people that provides information and support to better understand and cope with illness.</rdfs:comment>
        <rdfs:label xml:lang="en">Psychoeducation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Psychogeriatrician -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Psychogeriatrician">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalPractitioner"/>
        <ncit2:synonym xml:lang="en">Old Age Psychiatrist</ncit2:synonym>
        <umls3:cui xml:lang="en">C0586880</umls3:cui>
        <rdfs:comment xml:lang="en">The psychiatrist specializing in the diagnosis and treatment of mental illness in elderly people.</rdfs:comment>
        <rdfs:label xml:lang="en">Psychogeriatrician</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Psychologist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Psychologist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessional"/>
        <umls3:cui xml:lang="en">C0033908</umls3:cui>
        <rdfs:label xml:lang="en">Psychologist</rdfs:label>
        <skos:definition xml:lang="en">A specialist who can talk with patients and their families about emotional and personal matters, and can help them make decisions. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Psychosis -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Psychosis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MentalDisorder"/>
        <ncit2:synonym xml:lang="en">Psychotic Disorder, Psychoses</ncit2:synonym>
        <umls3:cui xml:lang="en">C0033975</umls3:cui>
        <rdfs:label xml:lang="en">Psychosis</rdfs:label>
        <skos:definition xml:lang="en">Disorders in which there is a loss of ego boundaries or a gross impairment in reality testing with delusions or prominent hallucinations. From DSM-IV, 1994</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PsychosomaticSymptom -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PsychosomaticSymptom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isManifestationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AnxietyInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isManifestationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DepressionInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <umls3:cui xml:lang="en">C4061539</umls3:cui>
        <rdfs:comment xml:lang="en">The real physical symptoms that caused by mental or emotional disturbance.</rdfs:comment>
        <rdfs:label xml:lang="en">Psychosomatic Symptom</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Psychotherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Psychotherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:synonym xml:lang="en">Psychological Therapy, Talking Therapy, Talk Therapy</ncit2:synonym>
        <umls3:cui xml:lang="en">C0033968</umls3:cui>
        <rdfs:comment xml:lang="en">Psychotherapy is the use of psychological methods, particularly when based on regular interaction with people, to help them change behaviour and overcome problems in desired ways.</rdfs:comment>
        <rdfs:label xml:lang="en">Psychotherapy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Punching -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Punching">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyAggressiveBehaviour"/>
        <ncit2:synonym xml:lang="en">Punching Other Person</ncit2:synonym>
        <umls3:cui xml:lang="en">C0562585</umls3:cui>
        <rdfs:comment xml:lang="en">The behaviour of stricking other person with the fist.</rdfs:comment>
        <rdfs:label xml:lang="en">Punching</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Pushing -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Pushing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyAggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The behaviour of moving forward by using force to pass people or cause them to move aside.</rdfs:comment>
        <rdfs:label xml:lang="en">Pushing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Queer -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Queer">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LGBTQ"/>
        <umls3:cui xml:lang="en">C4722209</umls3:cui>
        <rdfs:label xml:lang="en">Queer</rdfs:label>
        <skos:definition xml:lang="en">Used to describe a gender orientation that is not exclusively homosexual or heterosexual, or for individuals that don&apos;t identify with existing labels. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RacingThoughts -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RacingThoughts">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfEuphoriaInDementia"/>
        <umls3:cui xml:lang="en">C0554978</umls3:cui>
        <rdfs:label xml:lang="en">Racing Thoughts</rdfs:label>
        <skos:definition xml:lang="en">Abnormally rapid thoughts with or without abrupt changes from one topic to another. From The U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RamblingSpeech -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RamblingSpeech">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyNonaggressiveBehaviour"/>
        <umls3:cui xml:lang="en">C0423982</umls3:cui>
        <rdfs:comment xml:lang="en">The behaviour of talking at length in a confused or inconsequential way.</rdfs:comment>
        <rdfs:label xml:lang="en">Rambling Speech</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RapidCognitiveDecline -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RapidCognitiveDecline">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnSelf"/>
        <ncit2:synonym xml:lang="en">Rapid Progression of Cognitive Impairment</ncit2:synonym>
        <umls3:cui xml:lang="en">C2750110</umls3:cui>
        <rdfs:label xml:lang="en">Rapid Cognitive Decline</rdfs:label>
        <skos:definition xml:lang="en">Rapid cognitive decline (RCD) is defined as a deterioration of cognitive functions, as measured by a specific instrument for dementia, greater than the expected average decline. From Soto ME, Andrieu S, Arbus C, Ceccaldi M, Couratier P, Dantoine T, Dartigues JF, Gillette-Guyonette S, Nourhashémi F, Ousset JP, Poncet M, Portet F, Touchon J, Vellas B: Rapid cognitive decline in Alzheimer’s disease. Consensus paper. J Nutr Health Aging 2008;12: 703–713.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Rash -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Rash">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SkinProblem"/>
        <ncit2:synonym xml:lang="en">Exanthema, Eruption</ncit2:synonym>
        <umls3:cui xml:lang="en">C0015230</umls3:cui>
        <rdfs:label xml:lang="en">Rash</rdfs:label>
        <skos:definition xml:lang="en">An eruption in the skin which effects its appearance and/or texture. From the U.S. National Cancer Institution Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RatingAnxietyInDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RatingAnxietyInDementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#assesses"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AnxietyInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:abbreviation xml:lang="en">RAID</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Rating Anxiety in Dementia Scale, Rating for Anxiety in Dementia, Raging of Anxiety in Dementia Scale</ncit2:synonym>
        <rdfs:label xml:lang="en">Rating Anxiety in Dementia</rdfs:label>
        <skos:definition xml:lang="en">The Rating Anxiety in Dementia (RAID; Shankar, Walker, Frost &amp; Orrell, 1999)is a clinical rating scale comprising 18 items rated ona three-point scale, specifically developed to evaluate severity of anxiety in persons with dementia (PWD). Ten of the items rate somatic symptoms and five are about specific fears. From Snow, A Lynn et al. “Psychometric properties of a structured interview guide for the rating for anxiety in dementia.” Aging &amp; mental health vol. 16,5 (2012): 592-602. doi:10.1080/13607863.2011.644518</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReadingActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReadingActivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <ncit2:synonym xml:lang="en">Reading</ncit2:synonym>
        <umls3:cui xml:lang="en">C0034754</umls3:cui>
        <rdfs:label xml:lang="en">Reading Activity</rdfs:label>
        <skos:definition xml:lang="en">Acquiring information from text. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReadingBook -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReadingBook">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReadingActivity"/>
        <rdfs:comment xml:lang="en">The activity of reading a book.</rdfs:comment>
        <rdfs:label xml:lang="en">Reading Book</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReadingBookHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReadingBookHobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hobby"/>
        <rdfs:comment xml:lang="en">Hobby of reading books.</rdfs:comment>
        <rdfs:label xml:lang="en">Reading Book Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReadingMagazine -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReadingMagazine">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReadingActivity"/>
        <rdfs:comment xml:lang="en">The activity of reading a magazine.</rdfs:comment>
        <rdfs:label xml:lang="en">Reading Magazine</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReadingNewspaper -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReadingNewspaper">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReadingActivity"/>
        <rdfs:comment xml:lang="en">The activity of reading a newspaper.</rdfs:comment>
        <rdfs:label xml:lang="en">Reading Newspaper</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReadingNewspaperHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReadingNewspaperHobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hobby"/>
        <rdfs:comment xml:lang="en">Hobby of reading newspaper.</rdfs:comment>
        <rdfs:label xml:lang="en">Reading Newspaper Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RealityOrientationTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RealityOrientationTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Psychotherapy"/>
        <ncit2:abbreviation xml:lang="en">ROT</ncit2:abbreviation>
        <umls3:cui xml:lang="en">C3650753</umls3:cui>
        <rdfs:comment xml:lang="en">Reality orientation is a psychological therapy aimed at reducing confusion and inappropriate behaviours in people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Reality Orientation Therapy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Reassurance -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Reassurance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Providing Reassurance and Comfort, Reassuring</ncit2:synonym>
        <umls3:cui xml:lang="en">C0514711</umls3:cui>
        <rdfs:comment xml:lang="en">The intervention of letting the person with dementia know health care professionals are there and will keep him or her safe.</rdfs:comment>
        <rdfs:label xml:lang="en">Reassurance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RecreationRoom -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RecreationRoom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LocationOfManifestationOfEmotionalAndMoodDisturbance"/>
        <umls3:cui xml:lang="en">C0557650</umls3:cui>
        <rdfs:comment xml:lang="en">A room in a long-term care facility in which people can relax and play games.</rdfs:comment>
        <rdfs:label xml:lang="en">Recreation Room</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RecreationalTherapist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RecreationalTherapist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Therapist"/>
        <ncit2:synonym xml:lang="en">Recreational Activity Officer</ncit2:synonym>
        <rdfs:label xml:lang="en">Recreational Therapist</rdfs:label>
        <skos:definition xml:lang="en">Recreational therapists treat and help maintain the physical, mental, and emotional well-being of their clients by seeking to reduce depression, stress, and anxiety; recover basic motor functioning and reasoning abilities; build confidence; and socialize effectively. From National Council for Therapeutic Recreation Certification, https://www.nctrc.org/about-ncrtc/about-recreational-therapy/</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RecreationalTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RecreationalTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">RT</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Recreation Therapy, Therapeutic Recreation, Therapeutic Recreation Therapy</ncit2:synonym>
        <umls3:cui xml:lang="en">C0034873</umls3:cui>
        <rdfs:label xml:lang="en">Recreational Therapy</rdfs:label>
        <skos:definition xml:lang="en">Recreational therapy is a systemtic process that utilizes recreation and other activity-based interventions to address the assessed needs of individuals with illness and/or disabling condition, as a means to pschological and physical health, recovery and well-being. From National Council for Therapeutic Recreation Certification</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Redirection -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Redirection">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Use Diversion to Redirect Inappropriate Behavior, Diverting, Diversion</ncit2:synonym>
        <umls3:cui xml:lang="en">C0547409</umls3:cui>
        <rdfs:comment xml:lang="en">The intervention of assigning or directing a person something else to do as a substitute.</rdfs:comment>
        <rdfs:label xml:lang="en">Redirection</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReducedAffection -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReducedAffection">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfApathyInDementia"/>
        <ncit2:synonym xml:lang="en">Less Affectionate, Flattened Affect, Blunted Affect</ncit2:synonym>
        <rdfs:comment xml:lang="en">The reduced result or consequence of an action or other cause.</rdfs:comment>
        <rdfs:label xml:lang="en">Reduced Affection</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReducedInitiation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReducedInitiation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfMotivation"/>
        <ncit2:synonym xml:lang="en">Reduced Initiative, Dimished Initiative</ncit2:synonym>
        <rdfs:comment xml:lang="en">The reduced action of beginning something.</rdfs:comment>
        <rdfs:label xml:lang="en">Reduced Initiation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReducedWillingnessToMakeEffort -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReducedWillingnessToMakeEffort">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isManifestationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApathyInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isManifestationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DepressionInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Reduced willingness to make an effort in activities of daily life, such as maintain hygiene</rdfs:comment>
        <rdfs:label xml:lang="en">Reduced Willingness to Make Effort</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReducingClutter -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReducingClutter">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentalIntervention"/>
        <rdfs:comment xml:lang="en">The activity of reducing and organizing disordered things in the environment.</rdfs:comment>
        <rdfs:label xml:lang="en">Reducing Clutter</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReducingFrequencyOfEmotionalAndMoodDisturbance -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReducingFrequencyOfEmotionalAndMoodDisturbance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareGoalForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:comment xml:lang="en">The care goal of reducing frequency of manifestations of emotional and mood disturbances in a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Reducing Frequency of Emotional and Mood Disturbance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReducingHarmToOtherPeople -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReducingHarmToOtherPeople">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareGoalForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:comment xml:lang="en">Care goal of reducing physical damage to other people who are around a person with emotional and mood disturbances.</rdfs:comment>
        <rdfs:label xml:lang="en">Reducing Harm to Other People</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReducingHarmToSelf -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReducingHarmToSelf">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareGoalForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:comment xml:lang="en">The care goal of reducing physical damage to oneself.</rdfs:comment>
        <rdfs:label xml:lang="en">Reducing Harm to Self</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReducingLightGlare -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReducingLightGlare">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentalIntervention"/>
        <rdfs:comment xml:lang="en">Reducing relatively bright light that is unpleasant or discomfort</rdfs:comment>
        <rdfs:label xml:lang="en">Reducing Light Glare</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReducingNoiseOfNonemergencyOverheadPaging -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReducingNoiseOfNonemergencyOverheadPaging">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NoiseControl"/>
        <ncit2:synonym xml:lang="en">Reducing Noise of Non-emergency Buzzer</ncit2:synonym>
        <rdfs:comment xml:lang="en">The intervention of reducing the sound volume of the non-emergency overhead paging.</rdfs:comment>
        <rdfs:label xml:lang="en">Reducing Noise of Non-emergency Overhead Paging</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReducingSeverityOfEmotionalAndMoodDisturbance -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReducingSeverityOfEmotionalAndMoodDisturbance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareGoalForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:comment xml:lang="en">The care goal of reducing severity of manifestations of emotional and mood disturbances in a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Reducing Severity of Emotional and Mood Disturbance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReductionOfDaytimeSleep -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReductionOfDaytimeSleep">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Reducing Daytime Sleep</ncit2:synonym>
        <rdfs:comment xml:lang="en">The intervention of reducing a person&apos;s daytime sleep.</rdfs:comment>
        <rdfs:label xml:lang="en">Reduction of Daytime Sleep</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReferralToASpecialist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReferralToASpecialist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReferralToRequiredServiceProvider"/>
        <ncit2:synonym xml:lang="en">Referral to a Specialist Service, Referral to Specialist</ncit2:synonym>
        <umls3:cui xml:lang="en">C0849620</umls3:cui>
        <rdfs:comment xml:lang="en">The act of referring a person to a specialist for consultation, review, or further action.</rdfs:comment>
        <rdfs:label xml:lang="en">Referral to a Specialist</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReferralToPolice -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReferralToPolice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReferralToRequiredServiceProvider"/>
        <ncit2:synonym xml:lang="en">Report to Police</ncit2:synonym>
        <umls3:cui xml:lang="en">C1656433</umls3:cui>
        <rdfs:comment xml:lang="en">The act of referring to police.</rdfs:comment>
        <rdfs:label xml:lang="en">Referral to Police</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReferralToPsychiatrist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReferralToPsychiatrist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReferralToASpecialist"/>
        <ncit2:synonym xml:lang="en">Psychiatrist Referral</ncit2:synonym>
        <umls3:cui xml:lang="en">C0586090</umls3:cui>
        <rdfs:comment xml:lang="en">The act of referring a person to a psychiatrist for consultation, review, or further action.</rdfs:comment>
        <rdfs:label xml:lang="en">Referral to Psychiatrist</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReferralToPsychogeriatration -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReferralToPsychogeriatration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReferralToASpecialist"/>
        <rdfs:comment xml:lang="en">The act of referring a person to a psychogeriatration for consultation, review, or further action.</rdfs:comment>
        <rdfs:label xml:lang="en">Referral to Psychogeriatration</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReferralToPsychologist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReferralToPsychologist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReferralToASpecialist"/>
        <umls3:cui xml:lang="en">C0420369</umls3:cui>
        <rdfs:comment xml:lang="en">The act of referring a person to a psychologist for consulation, review, or further action.</rdfs:comment>
        <rdfs:label xml:lang="en">Referral to Psychologist</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReferralToRequiredServiceProvider -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReferralToRequiredServiceProvider">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <umls3:cui xml:lang="en">C4713277</umls3:cui>
        <rdfs:comment xml:lang="en">The activity of referrring a person to required service provider.</rdfs:comment>
        <rdfs:label xml:lang="en">Referral to Required Service Provider</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Reflexology -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Reflexology">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MassageTherapy"/>
        <umls3:cui xml:lang="en">C0034945</umls3:cui>
        <rdfs:label xml:lang="en">Reflexology</rdfs:label>
        <skos:definition xml:lang="en">The application of pressure to specific zones on the ears, hands, and feet in order to reduce stress and promote healing in corresponding glands,organs, parts, and systems of the body that are believed to be connected through energy channels. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RefugeeFromWarRelatedArea -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RefugeeFromWarRelatedArea">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RefugeeImmigration"/>
        <rdfs:comment xml:lang="en">Immigrant as a refugee from a war related area.</rdfs:comment>
        <rdfs:label xml:lang="en">Refugee from War Related Area</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RefugeeImmigration -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RefugeeImmigration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ImmigrationType"/>
        <rdfs:comment xml:lang="en">Type of immigration that a person is forced to flee for their lives (as a refugee) and choose to move to another country.</rdfs:comment>
        <rdfs:label xml:lang="en">Refugee Immigration</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RefusingFood -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RefusingFood">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isManifestationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AnxietyInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isManifestationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApathyInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isManifestationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DepressionInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:synonym xml:lang="en">Refuse to Eat, Food Refusal</ncit2:synonym>
        <umls3:cui xml:lang="en">C0424424</umls3:cui>
        <rdfs:comment xml:lang="en">Refusing to eat food</rdfs:comment>
        <rdfs:label xml:lang="en">Refusing Food</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RegisteredNurse -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RegisteredNurse">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Nurse"/>
        <ncit2:abbreviation xml:lang="en">RN</ncit2:abbreviation>
        <umls3:cui xml:lang="en">C0687673</umls3:cui>
        <rdfs:label xml:lang="en">Registered Nurse</rdfs:label>
        <skos:definition xml:lang="en">A nurse who has graduated from an accredited registered nursing program, has passed the state exam for licensure, and been registered and licensed to practice by a state authority. R.N.s receive educational preparation through hospital-based diploma programs, community/junior college associate&apos;s degree programs, baccalaureate programs, or combinations thereof. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RegularToileting -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RegularToileting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithToileting"/>
        <umls3:cui xml:lang="en">C0509128</umls3:cui>
        <rdfs:comment xml:lang="en">Assisting a person with toileting at regular intervals</rdfs:comment>
        <rdfs:label xml:lang="en">Regular Toileting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Relationship -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Relationship">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient"/>
        <umls3:cui xml:lang="en">C0439849</umls3:cui>
        <rdfs:label xml:lang="en">Relationship</rdfs:label>
        <skos:definition xml:lang="en">A state of connectedness between people, objects, or events; to be associated or connected with something. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RelationshipWithFamilyMember -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RelationshipWithFamilyMember">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Relationship"/>
        <rdfs:comment xml:lang="en">State of connectedness between a person with his/her family member(s).</rdfs:comment>
        <rdfs:label xml:lang="en">Relationship with Family Member</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RelationshipWithFriend -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RelationshipWithFriend">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Relationship"/>
        <rdfs:comment xml:lang="en">State of connectednedd between a person and his/her friend(s).</rdfs:comment>
        <rdfs:label xml:lang="en">Relationship with Friend</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RelationshipWithPet -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RelationshipWithPet">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Relationship"/>
        <rdfs:comment xml:lang="en">State of connectedness between a person and his/her pet(s).</rdfs:comment>
        <rdfs:label xml:lang="en">Relationship with Pet</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RelaxationTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RelaxationTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MindBodyTherapy"/>
        <ncit2:synonym xml:lang="en">Therapeutic Relaxation, Relaxation Training, Relaxation Programme</ncit2:synonym>
        <umls3:cui xml:lang="en">C0282333</umls3:cui>
        <rdfs:label xml:lang="en">Relaxation Therapy</rdfs:label>
        <skos:definition xml:lang="en">Treatment to improve one&apos;s health condition by using techniques that can reduce physiological stress, psychological stress, or both. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Religion -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Religion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DemographicInformation"/>
        <umls3:cui xml:lang="en">C0035039</umls3:cui>
        <rdfs:label xml:lang="en">Religion</rdfs:label>
        <skos:definition xml:lang="en">A personal or institutionalized system grounded in belief and reverene for a supernatural power or powers regarded as creator and governor of the universe. From dictionary.com</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReligiousBelief -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReligiousBelief">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Belief"/>
        <umls3:cui xml:lang="en">C0035045</umls3:cui>
        <rdfs:comment xml:lang="en">Attitudes towards mythological, supernatural, or spiritual aspects of a religion.</rdfs:comment>
        <rdfs:label xml:lang="en">Religious Belief</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReligiousPracticeRoutine -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReligiousPracticeRoutine">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient"/>
        <ncit2:synonym xml:lang="en">Routine of Religious Practice</ncit2:synonym>
        <rdfs:comment xml:lang="en">Routine of religious practice.</rdfs:comment>
        <rdfs:label xml:lang="en">Religious Practice Routine</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RelocatingPersonToAppropriateArea -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RelocatingPersonToAppropriateArea">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <rdfs:comment xml:lang="en">The intervention of relocating a person with dementia to an area which is appropirate and comfortable.</rdfs:comment>
        <rdfs:label xml:lang="en">Relocating Person to Appropirate Area</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RemainingAbility -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RemainingAbility">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient"/>
        <rdfs:comment xml:lang="en">Abilities that are still existing in a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Remaining Ability</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Reminding -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Reminding">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <umls3:cui xml:lang="en">C0557033</umls3:cui>
        <rdfs:comment xml:lang="en">Causing someone to remember something or someone</rdfs:comment>
        <rdfs:label xml:lang="en">Reminding</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReminiscenceTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReminiscenceTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">RT</ncit2:abbreviation>
        <umls3:cui xml:lang="en">C0150321</umls3:cui>
        <rdfs:label xml:lang="en">Reminiscence Therapy</rdfs:label>
        <skos:definition xml:lang="en">Using the recall of past events, feelings, and thoughts to facilitate pleasure, quality of life, or adaptation to present circumstances, e.g., household memories. From Nursing Interventions Classification</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RemovingDangerousObject -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RemovingDangerousObject">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentalIntervention"/>
        <ncit2:synonym xml:lang="en">Remove From Environment Sharp or Blunt Ojects that could be Used to Injure Patient or Others</ncit2:synonym>
        <umls3:cui xml:lang="en">C0548146</umls3:cui>
        <rdfs:comment xml:lang="en">The environmental intervention of removing objects (sharp or blunt) that could be used to harm or injure patient or others.</rdfs:comment>
        <rdfs:label xml:lang="en">Removing Dangerous Object</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Reorientation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Reorientation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Reorienting Person</ncit2:synonym>
        <umls3:cui xml:lang="en">C0204745</umls3:cui>
        <rdfs:comment xml:lang="en">The activity of changing the focus or direction of a person in order to help him/her to find the reality.</rdfs:comment>
        <rdfs:label xml:lang="en">Reorientation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReorientationToEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReorientationToEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Reorientation"/>
        <ncit2:synonym xml:lang="en">Event Reorientation</ncit2:synonym>
        <rdfs:comment xml:lang="en">The activity of helping a person figure out what event is going on.</rdfs:comment>
        <rdfs:label xml:lang="en">Reorientation to Event</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReorientationToPerson -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReorientationToPerson">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Reorientation"/>
        <ncit2:synonym xml:lang="en">Person Reorientation</ncit2:synonym>
        <rdfs:comment xml:lang="en">The activity of helping a person to figure out who a person is.</rdfs:comment>
        <rdfs:label xml:lang="en">Reorientation to Person</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReorientationToPlace -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReorientationToPlace">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Reorientation"/>
        <ncit2:synonym xml:lang="en">Place Reorientation</ncit2:synonym>
        <rdfs:comment xml:lang="en">The activity of helping a person figure out where he/she is.</rdfs:comment>
        <rdfs:label xml:lang="en">Reorientation to Place</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReorientationToTime -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReorientationToTime">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Reorientation"/>
        <ncit2:synonym xml:lang="en">Time Reorientation</ncit2:synonym>
        <rdfs:comment xml:lang="en">The activity of helping a person figure out what the time is.</rdfs:comment>
        <rdfs:label xml:lang="en">Reorientation to Time</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RepetitivePhysicalMannerism -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RepetitivePhysicalMannerism">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyNonaggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The behaviour of behaving certain physical actions repetitively.</rdfs:comment>
        <rdfs:label xml:lang="en">Repetitive Physical Mannerism</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RepetitiveQuestioning -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RepetitiveQuestioning">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyNonaggressiveBehaviour"/>
        <umls3:cui xml:lang="en">C3662016</umls3:cui>
        <rdfs:comment xml:lang="en">The behaviour of questioning repetitively.</rdfs:comment>
        <rdfs:label xml:lang="en">Repetitive Questioning</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RephrashingUnclearVerbalCommunication -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RephrashingUnclearVerbalCommunication">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionSuggested"/>
        <ncit2:synonym xml:lang="en">Paraphrasing Unclear Verbal Communication</ncit2:synonym>
        <rdfs:comment xml:lang="en">People should express the statements (e.g., a question) in an alternative way for the purpose of clarification.</rdfs:comment>
        <rdfs:label xml:lang="en">Rephrashing Unclear Verbal Communication</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Repositioning -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Repositioning">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <umls3:cui xml:lang="en">C0556030</umls3:cui>
        <rdfs:label xml:lang="en">Repositioning</rdfs:label>
        <skos:definition xml:lang="en">The act of placing in a new position. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RespectToOtherPerson -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RespectToOtherPerson">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonalityTrait"/>
        <ncit2:synonym xml:lang="en">Respect for Other Person, Respect for Others, Respect to Others</ncit2:synonym>
        <rdfs:comment xml:lang="en">Personality characterised by treating others with care.</rdfs:comment>
        <rdfs:label xml:lang="en">Respect to Other Person</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Restlessness -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Restlessness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyNonaggressiveBehaviour"/>
        <ncit2:synonym xml:lang="en">Restlessness Behavior, Restlessness Behaviour, Feeling of Restlessnss, Be Restless</ncit2:synonym>
        <umls3:cui xml:lang="en">C3887611</umls3:cui>
        <rdfs:label xml:lang="en">Restlessness</rdfs:label>
        <skos:definition xml:lang="en">A feeling of unrest or the need to move, and/or an inability to feel calm, relaxed, or be still. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfComplementaryMedication -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfComplementaryMedication">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfMedication"/>
        <rdfs:comment xml:lang="en">The activity of reviewing the non-prescription medications (normally available in health food shops, supermarkets and pharmacies) that a person is taking.</rdfs:comment>
        <rdfs:label xml:lang="en">Review of Complementary Medication</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfFamilyHistoryOfNeurologicalDisorder -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfFamilyHistoryOfNeurologicalDisorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfMedicalRecord"/>
        <rdfs:comment xml:lang="en">The activity of reviewing the history of neurological disorder in a person&apos;s family.</rdfs:comment>
        <rdfs:label xml:lang="en">Review of Family History of Neurological Disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfFamilyHistoryOfPsychiatricDisorder -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfFamilyHistoryOfPsychiatricDisorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfMedicalRecord"/>
        <rdfs:comment xml:lang="en">The activity of reviewing the history of psychiatric disorder in a person&apos;s family.</rdfs:comment>
        <rdfs:label xml:lang="en">Review of Family History of Psychiatric Disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfMedicalRecord -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfMedicalRecord">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthAssessment"/>
        <ncit2:synonym xml:lang="en">Medical Records Review</ncit2:synonym>
        <umls3:cui xml:lang="en">C0730229</umls3:cui>
        <rdfs:comment xml:lang="en">Review of the medical records of a person</rdfs:comment>
        <rdfs:label xml:lang="en">Review of Medical Record</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfMedication -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfMedication">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfMedicalRecord"/>
        <ncit2:synonym xml:lang="en">Review of Medication, Medication Review</ncit2:synonym>
        <umls3:cui xml:lang="en">C0560023</umls3:cui>
        <rdfs:label xml:lang="en">Review of Medication</rdfs:label>
        <skos:definition xml:lang="en">The review of medication that a person is taking.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfNursingRecord -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfNursingRecord">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthAssessment"/>
        <rdfs:comment xml:lang="en">Review information recorded by nurses concerning the nursing progress.</rdfs:comment>
        <rdfs:label xml:lang="en">Review of Nursing Record</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfNutraceutical -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfNutraceutical">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfMedication"/>
        <rdfs:comment xml:lang="en">The activity of reviewing the nutraceuticals that a person is taking. A nutraceutical is any food or food ingredient considered to provide medical or health benefits, including the prevention and treatment of disease. Food-based (nutrition) substances that have pharmaceutical effects on human health. From the U.S. National Cancer Institute Thesaurus</rdfs:comment>
        <rdfs:label xml:lang="en">Review of Nutraceutical</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfOverTheCounterMedication -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfOverTheCounterMedication">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfMedication"/>
        <rdfs:comment xml:lang="en">The activity of reviewing of the over-the-counter medications that a person is taking.</rdfs:comment>
        <rdfs:label xml:lang="en">Review of over the Counter Medication</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfPastMedicalHistory -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfPastMedicalHistory">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfMedicalRecord"/>
        <ncit2:synonym xml:lang="en">Review of Medical History</ncit2:synonym>
        <umls3:cui xml:lang="en">C0677073</umls3:cui>
        <rdfs:comment xml:lang="en">The activity of reviewing the past medical history of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Review of Past Medical History</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfPathologyTest -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfPathologyTest">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfMedicalRecord"/>
        <rdfs:comment xml:lang="en">The activity of reviewing the pathology tests that examine samples of body&apos;s tissues, including blood, urine, faeces (poo), samples obtained by biopsy.</rdfs:comment>
        <rdfs:label xml:lang="en">Review of Pathology Test</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfPrescribedMedication -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfPrescribedMedication">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfMedication"/>
        <rdfs:comment xml:lang="en">The activity of reviewing the prescribed medications that a person is taking.</rdfs:comment>
        <rdfs:label xml:lang="en">Review of Prescribed Medication</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfPriorGeriatricEvaluationResult -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfPriorGeriatricEvaluationResult">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfMedicalRecord"/>
        <ncit2:synonym xml:lang="en">Review of Prior Geriatric Assessment Result</ncit2:synonym>
        <rdfs:comment xml:lang="en">The activity of reviewing the prior geriatric evaluation results of a person. Geriatric evaluation refers to &quot;the complete examination of an elderly individual, which includes a full valuation of the physical and cognitive conditions, as well as a check of the patient&apos;s emotional state.&quot; From The U.S. National Cancer Institute Thesaurus</rdfs:comment>
        <rdfs:label xml:lang="en">Review of Prior Geriatric Evaluation Result</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfPriorNeuroimagingStudyResult -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfPriorNeuroimagingStudyResult">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfMedicalRecord"/>
        <rdfs:comment xml:lang="en">The activity of reviewing the prior neuroimaging study results of a person. Neuroimaging refers to &quot;the use of various techniques to directly or indirectly image the anatomy and function of the central nervous system&quot;. From the U.S. National Cancer Institute Thesaurus</rdfs:comment>
        <rdfs:label xml:lang="en">Review of Prior Neuroimaging Study Result</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfPriorNeurologicalEvaluationResult -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfPriorNeurologicalEvaluationResult">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfMedicalRecord"/>
        <rdfs:comment xml:lang="en">The activity of reviewing the prior neurological evaluation results of a person. A neurological assessment is the assessment of sensory neuron and motor responses, especially reflexes, to determine whether the nervous system is impaired.</rdfs:comment>
        <rdfs:label xml:lang="en">Review of Prior Neurological Assessment Result</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfPriorNeuropsychologicalTestResult -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfPriorNeuropsychologicalTestResult">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfMedicalRecord"/>
        <rdfs:comment xml:lang="en">The activity of reviewing the prior neuropsychological test results of a person. Neuropsychological tests are specifically designed tasks that are used to measure a psychological function known to be linked to a particular brain structure or pathway.</rdfs:comment>
        <rdfs:label xml:lang="en">Review of Prior Neuropsychological Test Result</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfPriorPsychiatricEvaluationResult -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfPriorPsychiatricEvaluationResult">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReviewOfMedicalRecord"/>
        <rdfs:comment xml:lang="en">The activity of reviewing the prior psychiatric evaluation results of a person. A psychiatric evaluation is the process of gathering information about a person within a psychiatric service. It generally involves multiple components, which can include answering questions verbally, receiving a physical test, and completing a questionnaire. It may be used to diagnose problems with memory, thought processes, and behaviors.</rdfs:comment>
        <rdfs:label xml:lang="en">Review of Prior Psychiatric Evaluation Result</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RevisedMemoryAndBehaviorProblemsChecklist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RevisedMemoryAndBehaviorProblemsChecklist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">RMBPC</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Revised Memory and Behavioral Problems Checklist, Revised Memory and Behavior Checklist</ncit2:synonym>
        <rdfs:label xml:lang="en">Revised Memory and Behavior Problems Checklist</rdfs:label>
        <skos:definition xml:lang="en">A 24-item caregiver-report measure for the clinical and empirical assessment of both the presence of behavior problems in dementia patients, and the extent of caregiver “subjective burden” or “distress” associated with those problems. From American Psychological Association (apa.org)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RiskAssessment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RiskAssessment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthAssessment"/>
        <umls3:cui xml:lang="en">C0086930</umls3:cui>
        <rdfs:comment xml:lang="en">The activity of characterizing the nature and likelihood of a harmful effect to individuals.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk Assessment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RiskTakingBehaviour -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RiskTakingBehaviour">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfEuphoriaInDementia"/>
        <ncit2:synonym xml:lang="en">Risky Behaviour</ncit2:synonym>
        <umls3:cui xml:lang="en">C0683303</umls3:cui>
        <rdfs:comment xml:lang="en">Risk-taking behaviours are those that potentially expose people to physical harm.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk-Taking Behaviour</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Roaring -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Roaring">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyNonaggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The behaviour of making a very loud, deep, prolonged sound.</rdfs:comment>
        <rdfs:label xml:lang="en">Roaring</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RoboticAnimalAssistedTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RoboticAnimalAssistedTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AnimalAssistedTherapy"/>
        <rdfs:comment xml:lang="en">A psychotherapy treatment based upon building a bond with a robot animal through interaction and play. For example, the therapeutic pet-type robot, PARO, was developed by Japanese engineers as an alternative to animal-assisted therapy. Modeled on the feature of a baby harp seal and weighing approximately 2.5 kg, RARO has 5 in-built sensors that enable the robot to respond autonomously to the user and his or her environment. PARO is diurnally active, and can move its flippers and tail, open and close its eyes, and make sounds similar to a baby harp seal.</rdfs:comment>
        <rdfs:label xml:lang="en">Robotic Animal-Assisted Therapy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Rocking -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Rocking">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyNonaggressiveBehaviour"/>
        <ncit2:synonym xml:lang="en">Body Rocking, Repetitive Rocking Movements</ncit2:synonym>
        <umls3:cui xml:lang="en">C0005899</umls3:cui>
        <rdfs:comment xml:lang="en">The behaviour of repetitively moving body gently to and from side to side.</rdfs:comment>
        <rdfs:label xml:lang="en">Rocking</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RoleIdentity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RoleIdentity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient"/>
        <rdfs:comment xml:lang="en">The role (or character) people play when holding specific positions in groups.</rdfs:comment>
        <rdfs:label xml:lang="en">Role Identity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RoutineOfAttendingReligiousService -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RoutineOfAttendingReligiousService">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReligiousPracticeRoutine"/>
        <rdfs:comment xml:lang="en">Routine of attending the religious services.</rdfs:comment>
        <rdfs:label xml:lang="en">Routine of Attending Religious Service</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RoutineOfPraying -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RoutineOfPraying">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReligiousPracticeRoutine"/>
        <rdfs:comment xml:lang="en">Routine of praying.</rdfs:comment>
        <rdfs:label xml:lang="en">Routine of Praying</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Rummaging -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Rummaging">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyNonaggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The behaviour of disorganised foraging.</rdfs:comment>
        <rdfs:label xml:lang="en">Rummaging</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SaintLouisUniversityMentalStatusExamination -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SaintLouisUniversityMentalStatusExamination">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">SLUMS</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Saint Louis University Mental Status Exam, St Louis University Mental Status Exam, St Louis University Mental Status Examination</ncit2:synonym>
        <rdfs:label xml:lang="en">Saint Louis University Mental Status Examination</rdfs:label>
        <skos:definition xml:lang="en">The Saint Louis University Mental Status exam is an assessment tool for detecting mild cognitive impairment and dementia and was developed in partnership with the Geriatrics Research, Education and Clinical Center at the St. Louis Veterans Administration Medical Center.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SandozClinicalAssessmentGeriatricScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SandozClinicalAssessmentGeriatricScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">SCAG</ncit2:abbreviation>
        <rdfs:label xml:lang="en">Sandoz Clinical Assessment - Geriatric Scale</rdfs:label>
        <skos:definition xml:lang="en">The Sandoz Clinical Assessment-Geriatric (SCAG) scale was developed specifically for the evaluation of pharmacotherapy in senile dementia and related conditions. From Venn RD. The Sandoz Clinical Assessment-Geriatric (SCAG) scale. A general-purpose psychogeriatric rating scale. Gerontology. 1983;29(3):185-98. doi: 10.1159/000213113. PMID: 6852546.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ScaleForTheAssessmentOfNegativeSymptomsInAlzheimersDisease -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ScaleForTheAssessmentOfNegativeSymptomsInAlzheimersDisease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">SANS-AD</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Assessment of Negative Symptoms in Alzheimer&apos;s Disease</ncit2:synonym>
        <rdfs:label xml:lang="en">Scale for the Assessment of Negative Symptoms in Alzheimer&apos;s Disease</rdfs:label>
        <skos:definition xml:lang="en">The Scale for the Assessment of Negative Symptoms in Alzheimer’s Disease (SANS-AD) directly observes the person’s mood state in three subscales of affective flattening or blunting, avolition apathy, and social–emotional withdrawal. From Reichman, W. E., Coyne, A. C., Amirneni, S., Molino, B., &amp; Egan, S. (1996). Negative symptoms in Alzheimer&apos;s disease. The American Journal of Psychiatry, 153(3), 424–426. https://doi.org/10.1176/ajp.153.3.424</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ScheduledReassuranceTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ScheduledReassuranceTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">SRT</ncit2:abbreviation>
        <rdfs:label xml:lang="en">Scheduled Reassurance Therapy</rdfs:label>
        <skos:definition xml:lang="en">Scheduled reassurance therapy involves brief 1 minute interactions every 30 minutes consisting of positive social interactions where no nursing/ care tasks are performed. From Wallace et al. 2012 ReBOC: Reducing Behaviours of Concern</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SchedulingChallengingActivityWhenPersonIsAtHisBest -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SchedulingChallengingActivityWhenPersonIsAtHisBest">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EngagingPersonInActivity"/>
        <rdfs:comment xml:lang="en">Arranging challenging activities (e.g., bathing) when the person with dementia is likely to be at his or her best</rdfs:comment>
        <rdfs:label xml:lang="en">Scheduling Challenging Activity When Person with Dementia is at His Best</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Schizophrenia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Schizophrenia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MentalDisorder"/>
        <ncit2:synonym xml:lang="en">Schizophrenic Disorder</ncit2:synonym>
        <umls3:cui xml:lang="en">C0036341</umls3:cui>
        <rdfs:label xml:lang="en">Schizophrenia</rdfs:label>
        <skos:definition xml:lang="en">A severe emotional disorder of psychotic depth characteristically marked by a retreat from reality with delution formation, hallucinations, emotional disharmony, and regressive behavior. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Scratching -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Scratching">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyAggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The behaviour of marking the surface of something with a sharp or pointed object; and hurting someone&apos;s body with one&apos;s fingernails.</rdfs:comment>
        <rdfs:label xml:lang="en">Scratching</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Screaming -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Screaming">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyNonaggressiveBehaviour"/>
        <umls3:cui xml:lang="en">C0521008</umls3:cui>
        <rdfs:comment xml:lang="en">The behaviour of making a loud, piercing sound.</rdfs:comment>
        <rdfs:label xml:lang="en">Screaming</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ScreeningForDrivingSafety -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ScreeningForDrivingSafety">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthAssessment"/>
        <rdfs:comment xml:lang="en">The activity of checking if it&apos;s safe for a person to drive a car or a motorised scooter.</rdfs:comment>
        <rdfs:label xml:lang="en">Screening for Driving Safety</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ScreeningForFoodPreparationSafety -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ScreeningForFoodPreparationSafety">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthAssessment"/>
        <rdfs:comment xml:lang="en">The activity of checking if a person can prepare food without any risks.</rdfs:comment>
        <rdfs:label xml:lang="en">Screening for Food Preparation Safety</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Searching -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Searching">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyNonaggressiveBehaviour"/>
        <ncit2:synonym xml:lang="en">Searching Behaviour</ncit2:synonym>
        <umls3:cui xml:lang="en">C4050474</umls3:cui>
        <rdfs:comment xml:lang="en">The behaviour of thoroughly scrutinizing, especially in a disconcerning way.</rdfs:comment>
        <rdfs:label xml:lang="en">Searching</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SecondGenerationImmigrant -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SecondGenerationImmigrant">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ImmigrantGenerationStatus"/>
        <umls3:cui xml:lang="en">C2047974</umls3:cui>
        <rdfs:comment xml:lang="en">Individuals who have at least one foreign-born parent.</rdfs:comment>
        <rdfs:label xml:lang="en">Second Generation Immigrant</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SelfHarmBehaviour -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SelfHarmBehaviour">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyAggressiveBehaviour"/>
        <ncit2:synonym xml:lang="en">Self Injurious Behaviour, Self Harm, Self Injury, Self Destructive Behaviour, Hurting Self</ncit2:synonym>
        <umls3:cui xml:lang="en">C0085271</umls3:cui>
        <rdfs:label xml:lang="en">Self Harm Behaviour</rdfs:label>
        <skos:definition xml:lang="en">Behavior in which persons hurt or harm themselves without the motive of suicide or of sexual deviation. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SelfIsolation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SelfIsolation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isManifestationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AnxietyInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isManifestationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApathyInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isManifestationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DepressionInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:synonym xml:lang="en">Self-Isolation, Self Social Isolation</ncit2:synonym>
        <rdfs:comment xml:lang="en">Person with emotional and mood disturbances (depression, anxiety, and apathy in dementia) may isolate oneself from others.</rdfs:comment>
        <rdfs:label xml:lang="en">Self Isolation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SelfMaintenanceTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SelfMaintenanceTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:label xml:lang="en">Self-Maintenance Therapy</rdfs:label>
        <skos:definition xml:lang="en">Self-Maintenance Therapy promotes the recovery of self-esteem through activities for which the patient still has the requisite competence. The activity must be chosen individually in the light of the patient’s life history. From Kratz 2017 The diagnosis and treatment of behavioral disorders in dementia. Dtsch Arzteble Int 114. &amp; Romero B, Eder G: Selbst-Erhaltungs-Therapie (SET): Konzept einer neuropsychologischen Therapie bei Alzheimer-Kranken. Zeitschrift für Gerontopsychologie und -psychiatrie 1992; 5: 267–82.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SelfNeglect -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SelfNeglect">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isManifestationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApathyInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isManifestationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DepressionInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <umls3:cui xml:lang="en">C0424359</umls3:cui>
        <rdfs:label xml:lang="en">Self Neglect</rdfs:label>
        <skos:definition xml:lang="en">Profound inattention by individuals to their own health and hygiene. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SelfTalk -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SelfTalk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyNonaggressiveBehaviour"/>
        <ncit2:synonym xml:lang="en">Self Talking</ncit2:synonym>
        <umls3:cui xml:lang="en">C0871330</umls3:cui>
        <rdfs:label xml:lang="en">Self Talk</rdfs:label>
        <skos:definition xml:lang="en">Vocalized or unvocalized speech that is directed to oneself or an imaginary recipient. From Psychological Index Terms</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SensoryAbility -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SensoryAbility">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RemainingAbility"/>
        <ncit2:synonym xml:lang="en">Sensory Capacity, Sensory Status</ncit2:synonym>
        <umls3:cui xml:lang="en">C4068684</umls3:cui>
        <rdfs:comment xml:lang="en">Ability of the sense organs (e.g., eye, ear, nose, skin) to receive input accurately from the sense organs.</rdfs:comment>
        <rdfs:label xml:lang="en">Sensory Ability</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SensoryImpairment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SensoryImpairment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:synonym xml:lang="en">Sensory Deficit, Sensory Defect, Sensory Deprivation</ncit2:synonym>
        <umls3:cui xml:lang="en">C3809741</umls3:cui>
        <rdfs:comment xml:lang="en">The impaired physical senses of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Sensory Impairment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SensoryStimulationTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SensoryStimulationTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:synonym xml:lang="en">Sensory Therapy</ncit2:synonym>
        <umls3:cui xml:lang="en">C5141264</umls3:cui>
        <rdfs:comment xml:lang="en">Sensory therapy uses stimulation of the different senses such as touch, smell, hearing and sight to promote wellbeing.</rdfs:comment>
        <rdfs:label xml:lang="en">Sensory Stimulation Therapy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SeparationFromFamilyMember -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SeparationFromFamilyMember">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TraumaticLifeEvent"/>
        <umls3:cui xml:lang="en">C0680114</umls3:cui>
        <rdfs:comment xml:lang="en">Information about separation of a person from his/her family member.</rdfs:comment>
        <rdfs:label xml:lang="en">Separation from Family Member</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SevereDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SevereDementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StageOfDementia"/>
        <ncit2:synonym xml:lang="en">Late Stage of Dementia, Advanced Dementia</ncit2:synonym>
        <umls3:cui xml:lang="en">C3494652</umls3:cui>
        <rdfs:comment xml:lang="en">The late stage of dementia. People with severe dementia may experience further mental and physical capability decline. They may loss the ability to communicate and need for full-time daily assistance with tasks (e.g., eating and dressing).</rdfs:comment>
        <rdfs:label xml:lang="en">Severe Dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SewingActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SewingActivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <umls3:cui xml:lang="en">C2977585</umls3:cui>
        <rdfs:comment xml:lang="en">The activity involving sewing for enjoyment.</rdfs:comment>
        <rdfs:label xml:lang="en">Sewing Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SexualAssault -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SexualAssault">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TraumaticLifeEvent"/>
        <rdfs:comment xml:lang="en">Information about sexual assault experienced by a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Sexual Assault</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SexualBehaviour -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SexualBehaviour">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Sexuality"/>
        <ncit2:synonym xml:lang="en">Sex Behaviour, Sexual Behavior, Sexual Activity</ncit2:synonym>
        <umls3:cui xml:lang="en">C0036864</umls3:cui>
        <rdfs:label xml:lang="en">Sexual Behaviour</rdfs:label>
        <skos:definition xml:lang="en">Totality of normal and abnormal, conscious and unconscious, overt and covert sensations, thoughts, feelings, and actions related to sexual organs and other erotogenic zones, including goals and techniques. From Computer Retrieval of Information on Scientific Projects (CRISP) Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SexualOrientation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SexualOrientation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Sexuality"/>
        <ncit2:synonym xml:lang="en">Sex Orientation, Sexual Preference</ncit2:synonym>
        <umls3:cui xml:lang="en">C0205949</umls3:cui>
        <rdfs:label xml:lang="en">Sexual Orientation</rdfs:label>
        <skos:definition xml:lang="en">Direction of one&apos;s sexual interest toward members of the same, opposite, or both sexes; involves feelings, and sense of identity. From Computer Retrieval of Information on Scientific Projects (CRISP) Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Sexuality -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Sexuality">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient"/>
        <umls3:cui xml:lang="en">C0036915</umls3:cui>
        <rdfs:label xml:lang="en">Sexuality</rdfs:label>
        <skos:definition xml:lang="en">The sexual functions, activities, attitudes, and orientations of an individual. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ShavingPreference -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ShavingPreference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonalHygienePreference"/>
        <umls3:cui xml:lang="en">C0582058</umls3:cui>
        <rdfs:comment xml:lang="en">Preference to shaving, such as preference to dry shave or wet shave.</rdfs:comment>
        <rdfs:label xml:lang="en">Shaving Preference</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ShellfishAllergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ShellfishAllergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FoodAllergy"/>
        <ncit2:synonym xml:lang="en">Shellfish Hypersensitivity, Allergy to Shellfish</ncit2:synonym>
        <umls3:cui xml:lang="en">C0577625</umls3:cui>
        <rdfs:label xml:lang="en">Shellfish Allergy</rdfs:label>
        <skos:definition xml:lang="en">Allergic reaction to shellfish or shellfish products. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Shouting -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Shouting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyNonaggressiveBehaviour"/>
        <ncit2:synonym xml:lang="en">Yelling</ncit2:synonym>
        <umls3:cui xml:lang="en">C0562551</umls3:cui>
        <rdfs:comment xml:lang="en">The behaviour of making a loud cry.</rdfs:comment>
        <rdfs:label xml:lang="en">Shouting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Shoving -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Shoving">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyAggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The behaviour of pushing someone or something roughly.</rdfs:comment>
        <rdfs:label xml:lang="en">Shoving</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SignLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SignLanguage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LanguageInformation"/>
        <umls3:cui xml:lang="en">C0037078</umls3:cui>
        <rdfs:label xml:lang="en">Sign Language</rdfs:label>
        <skos:definition xml:lang="en">A system of hand gestures used for communication by the deaf or by people speaking different languages. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SimplifyingTask -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SimplifyingTask">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EngagingPersonInActivity"/>
        <ncit2:synonym xml:lang="en">Task Simplification</ncit2:synonym>
        <rdfs:comment xml:lang="en">The intervention that lowers the skill level requried of a person performing a task.</rdfs:comment>
        <rdfs:label xml:lang="en">Simplifying Task</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SimulatedPresenceTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SimulatedPresenceTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialInteractionIntervention"/>
        <ncit2:abbreviation xml:lang="en">SPT</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Simulated Family Presence Therapy</ncit2:synonym>
        <rdfs:label xml:lang="en">Simulated Presence Therapy</rdfs:label>
        <skos:definition xml:lang="en">An intervention that uses video or audiotape recordings of family members played to the person with dementia. From Abraha et al. 2020 Simulated presence therapy for dementia (Review)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Sister -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Sister">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
        <umls3:cui xml:lang="en">C0337514</umls3:cui>
        <rdfs:comment xml:lang="en">A female sibling of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Sister</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SisterInLaw -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SisterInLaw">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
        <umls3:cui xml:lang="en">C2350006</umls3:cui>
        <rdfs:label xml:lang="en">Sister-in-law</rdfs:label>
        <skos:definition xml:lang="en">A sister by marriage. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SittingAndTalkingWithPerson -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SittingAndTalkingWithPerson">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <umls3:cui xml:lang="en">C0515842</umls3:cui>
        <rdfs:comment xml:lang="en">The intervention that a nursing staff needs to sit and talk with a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Sitting and Talking with Person</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SkillForCommunicatingWithPersonWithDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SkillForCommunicatingWithPersonWithDementia">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isCommunicationSkillOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessional"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The technique for effectively communicating with person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Skill for Communicating with Person with Dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SkilledImmigration -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SkilledImmigration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ImmigrationType"/>
        <rdfs:comment xml:lang="en">Type of immigration that people are invited to live in other countries to fill critical labor gaps and contribute specialized skills.</rdfs:comment>
        <rdfs:label xml:lang="en">Skilled Immigration</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SkillsMix -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SkillsMix">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FactorAffectingImplementationOfNonpharmacologicalIntervention"/>
        <ncit2:synonym xml:lang="en">Skill Mix</ncit2:synonym>
        <rdfs:comment xml:lang="en">The number, educational preparation of staff or level of staff, and their experience working in a clinical setting.</rdfs:comment>
        <rdfs:label xml:lang="en">Skills Mix</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SkinIrritation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SkinIrritation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SkinProblem"/>
        <umls3:cui xml:lang="en">C0152030</umls3:cui>
        <rdfs:label xml:lang="en">Skin Irritation</rdfs:label>
        <skos:definition xml:lang="en">A mild inflammatory dermal tissue reaction; it can be caused by physical contact with an irritant or can be a local response to a systemic trigger. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SkinProblem -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SkinProblem">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:synonym xml:lang="en">Dermatologic Problem</ncit2:synonym>
        <umls3:cui xml:lang="en">C0281822</umls3:cui>
        <rdfs:comment xml:lang="en">A person&apos;s skin condiitons that affect him/her.</rdfs:comment>
        <rdfs:label xml:lang="en">Skin Problem</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Slamming -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Slamming">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyAggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The behaviour of shutting something (such as a door or window) forcefully and loudly.</rdfs:comment>
        <rdfs:label xml:lang="en">Slamming</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SleepDeprivation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SleepDeprivation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SleepDisturbance"/>
        <ncit2:synonym xml:lang="en">Lack of Adequate Sleep, Sleep Deficit, Not Enough Sleep</ncit2:synonym>
        <umls3:cui xml:lang="en">C0037316</umls3:cui>
        <rdfs:label xml:lang="en">Sleep Deprivation</rdfs:label>
        <skos:definition xml:lang="en">Lack of the normal sleep / wake cycle. From Clinical Care Classification</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SleepDisturbance -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SleepDisturbance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <ncit2:synonym xml:lang="en">Disturbance in Sleep Behaviour, Sleep Dysfunction, Difficulty Sleeping, Trouble Sleeping, Disturbed Sleep, Sleeping Disturbance, Sleep Disorder</ncit2:synonym>
        <umls3:cui xml:lang="en">C0037317</umls3:cui>
        <rdfs:comment xml:lang="en">The abnormality of sleep.</rdfs:comment>
        <rdfs:label xml:lang="en">Sleep Disturbance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SmellAbility -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SmellAbility">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SensoryAbility"/>
        <ncit2:synonym xml:lang="en">Smell Sense, Smell Perception, Olfaction, Sense of Smell</ncit2:synonym>
        <umls3:cui xml:lang="en">C0037361</umls3:cui>
        <rdfs:label xml:lang="en">Smell Ability</rdfs:label>
        <skos:definition xml:lang="en">The ability to detect scents or odors. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SmellingFlower -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SmellingFlower">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">The activity of smelling various flowers.</rdfs:comment>
        <rdfs:label xml:lang="en">Smelling Flower</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SnoezolenMultisensoryStimulationTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SnoezolenMultisensoryStimulationTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MultisensoryStimulation"/>
        <ncit2:abbreviation xml:lang="en">SMST</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Snoezel Therapy, Snoezelen Therapy, Multi-sensory Environment</ncit2:synonym>
        <rdfs:label xml:lang="en">Snoezelen Multisensory Stimulation Therapy</rdfs:label>
        <skos:definition xml:lang="en">Snoezelen multisensory stimulation therapy comprises multiple stimuli and is aimed at stimulating the primary senses of sight, touch, taste and smell. The intervention is provided in specially designed rooms, which provide diverse sensory-stimulating effects/material including music, aroma, bubble tubes, fibre optic sprays and moving shapes projected across walls. From Abraha et al. 2017 Systematic review of systematic reviews of non-pharmacological interventions to treat behavioural disturbances in older patients with dementia. The SENATOR-OnTop series</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialEnvironmentCausativeFactor -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialEnvironmentCausativeFactor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EnvironmentalCausativeFactor"/>
        <rdfs:comment xml:lang="en">The factors of the social setting that may cause emotional and mood disturbances of people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Social Environment Causative Factor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialEnvironmentalIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialEnvironmentalIntervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EnvironmentalModification"/>
        <ncit2:synonym xml:lang="en">Modification of Social Environment</ncit2:synonym>
        <umls3:cui xml:lang="en">C4304386</umls3:cui>
        <rdfs:comment xml:lang="en">The intervention of modifying social environment - social and cultural forms, patterns, and processes that influence the life of an individual.</rdfs:comment>
        <rdfs:label xml:lang="en">Social Environmental Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialHistory -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialHistory">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient"/>
        <umls3:cui xml:lang="en">C3714536</umls3:cui>
        <rdfs:label xml:lang="en">Social History</rdfs:label>
        <skos:definition xml:lang="en">Past events that occurred between individuals and/or their communities. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialInteractionIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialInteractionIntervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:synonym xml:lang="en">Social Contact Intervention</ncit2:synonym>
        <rdfs:comment xml:lang="en">Interventions for managing behavioural and psychological symptoms by enhancing a person&apos;s social interactions with others, such as staff, family, and volunteers</rdfs:comment>
        <rdfs:label xml:lang="en">Social Interaction Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialIsolation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialIsolation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <umls3:cui xml:lang="en">C0037421</umls3:cui>
        <rdfs:comment xml:lang="en">The separation of individuals or groups resulting in the lack of or minimizing of social contact and/or communication. This separation may be accomplished by physical separation, by social barriers and by psychological mechanisms. In the latter, there may be interaction but no real communication. From MeSH</rdfs:comment>
        <rdfs:label xml:lang="en">Social Isolation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialMediaVideoCall -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialMediaVideoCall">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialInteractionIntervention"/>
        <rdfs:comment xml:lang="en">The treatment that involves having converstion with others through social media video software, such as talking with families using Zoom.</rdfs:comment>
        <rdfs:label xml:lang="en">Social Media Video Call</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialOuting -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialOuting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialInteractionIntervention"/>
        <rdfs:comment xml:lang="en">The activity of going out of a long-term care facility to attend a social event, e.g., a party.</rdfs:comment>
        <rdfs:label xml:lang="en">Social Outing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialRole -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialRole">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RoleIdentity"/>
        <umls3:cui xml:lang="en">C0035820</umls3:cui>
        <rdfs:comment xml:lang="en">The role (or character) people play when holding specific social position in a functional group, such as club, sorority, fraternity, or the personnel of such a structure whose purpose is for social interactions.</rdfs:comment>
        <rdfs:label xml:lang="en">Social Role</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialSupport -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialSupport">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FactorAffectingImplementationOfNonpharmacologicalIntervention"/>
        <umls3:cui xml:lang="en">C0037438</umls3:cui>
        <rdfs:comment xml:lang="en">The support to a person in need from other persons (e.g., family members and friends), groups, organizations, or institutions.</rdfs:comment>
        <rdfs:label xml:lang="en">Social Support</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialSupportGroupProgram -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialSupportGroupProgram">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialEnvironmentalIntervention"/>
        <rdfs:comment xml:lang="en">The program that provides a range of services to help the frail aged and people living with dementia and to keep them connected with their culture and community.</rdfs:comment>
        <rdfs:label xml:lang="en">Social Support Group Program</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialWorker -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialWorker">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessional"/>
        <ncit2:abbreviation xml:lang="en">SW</ncit2:abbreviation>
        <umls3:cui xml:lang="en">C0037444</umls3:cui>
        <rdfs:label xml:lang="en">Social Worker</rdfs:label>
        <skos:definition xml:lang="en">Professionals who work with persons affected by social disadvantages such as poverty, mental and physical illness or disability, and social injustice. Their focus is on both the individual and his or her environment, including violation of their civil liberties and human rights. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialisationHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialisationHobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hobby"/>
        <ncit2:synonym xml:lang="en">Socialization Hobby</ncit2:synonym>
        <rdfs:comment xml:lang="en">Hobby of socializing with others.</rdfs:comment>
        <rdfs:label xml:lang="en">Socialisation Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SolvingWordSearchPuzzle -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SolvingWordSearchPuzzle">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">The activity of solving word search puzzles.</rdfs:comment>
        <rdfs:label xml:lang="en">Solving Word Search Puzzle</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SomewhatEffective -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SomewhatEffective">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Effective"/>
        <terms:source xml:lang="en">Wiskow, K. M., Donaldson, J. M., &amp; Matter, A. L. (2017). An evaluation of generalization of compliance across response types. Behavior Analysis: Research and Practice, 17(4), 402-420. http://dx.doi.org/10.1037/bar0000087</terms:source>
        <ncit2:synonym xml:lang="en">Slightly Effective</ncit2:synonym>
        <rdfs:comment xml:lang="en">Slightly successful in producing a desired or intended result</rdfs:comment>
        <rdfs:label xml:lang="en">Somewhat Effective</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Son -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Son">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
        <umls3:cui xml:lang="en">C0037683</umls3:cui>
        <rdfs:comment xml:lang="en">A male child of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Son</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SonInLaw -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SonInLaw">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
        <umls3:cui xml:lang="en">C2350007</umls3:cui>
        <rdfs:label xml:lang="en">Son-in-law</rdfs:label>
        <skos:definition xml:lang="en">The husband of one&apos;s daughter. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SonasIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SonasIntervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MultisensoryStimulation"/>
        <rdfs:label xml:lang="en">Sonas Intervention</rdfs:label>
        <skos:definition xml:lang="en">An Irish intervention that incorpirates cognitive, sensory, and social stimulation on the five senses of touch, smell, taste, hearing, and sight. From Jackson et al. 2003 A multisensory programme: Evaluating effects on agitation. Nursing and Residential Care 5:3</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SortingButton -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SortingButton">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">The organized activity of sorting buttons.</rdfs:comment>
        <rdfs:label xml:lang="en">Sorting Button</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SortingCoin -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SortingCoin">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">The organized activity of sorting coins.</rdfs:comment>
        <rdfs:label xml:lang="en">Sorting Coin</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SoybeanAllergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SoybeanAllergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FoodAllergy"/>
        <ncit2:synonym xml:lang="en">Allergy to Soybean</ncit2:synonym>
        <rdfs:comment xml:lang="en">Allergic reaction to soybean or soybean products.</rdfs:comment>
        <rdfs:label xml:lang="en">Soybean Allergy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Spasm -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Spasm">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <umls3:cui xml:lang="en">C0037763</umls3:cui>
        <rdfs:label xml:lang="en">Spasm</rdfs:label>
        <skos:definition xml:lang="en">An involuntary contraction of a muscle or group of muscles. Spasms may involve skeletal muscle or smooth muscle. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SpeakingClearly -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SpeakingClearly">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionSuggested"/>
        <rdfs:comment xml:lang="en">People should speak clearly when communicating with a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Speaking Clearly</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SpeakingDirectlyToPersonWithDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SpeakingDirectlyToPersonWithDementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionSuggested"/>
        <rdfs:comment xml:lang="en">People should speak directly to a person with dementia when communicating with him/her.</rdfs:comment>
        <rdfs:label xml:lang="en">Speaking Directly to Person with Dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SpeakingInExcessivelyLoudVoice -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SpeakingInExcessivelyLoudVoice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyNonaggressiveBehaviour"/>
        <rdfs:label xml:lang="en">Speaking in Excessively Loud Voice</rdfs:label>
        <skos:definition xml:lang="en">The behaviour of speaking in a voice which is excessively loud.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SpeakingSlowly -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SpeakingSlowly">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionSuggested"/>
        <rdfs:comment xml:lang="en">People should speak slowly when communicating with people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Speaking Slowly</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SpeechTherapist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SpeechTherapist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Therapist"/>
        <ncit2:abbreviation xml:lang="en">ST</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Language Therapist, Speech and Language Therapist, Speech Pathologist, Speech Language Pathologist, Speech Language Therapist</ncit2:synonym>
        <umls3:cui xml:lang="en">C0402015</umls3:cui>
        <rdfs:label xml:lang="en">Speech Therapist</rdfs:label>
        <skos:definition xml:lang="en">A specialist who evaluates and treats people with communication and swallowing problems. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SpiritualBelief -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SpiritualBelief">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Belief"/>
        <umls3:cui xml:lang="en">C0683811</umls3:cui>
        <rdfs:comment xml:lang="en">Acceptance of a superior being and is related to an existential perspective on life, death, and the nature of reality.</rdfs:comment>
        <rdfs:label xml:lang="en">Spiritual Belief</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SpiritualSupport -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SpiritualSupport">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Spiritual Care, Spiritual Comfort</ncit2:synonym>
        <umls3:cui xml:lang="en">C0150355</umls3:cui>
        <rdfs:label xml:lang="en">Spiritual Support</rdfs:label>
        <skos:definition xml:lang="en">Actions performed to console, restore, or promote spiritual health. From Clinical Care Classification</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SpiritualTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SpiritualTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:synonym xml:lang="en">Spirituality</ncit2:synonym>
        <umls3:cui xml:lang="en">C0679674</umls3:cui>
        <rdfs:label xml:lang="en">Spiritual Therapy</rdfs:label>
        <skos:definition xml:lang="en">Mystical, religious, or spiritual practices performed for health benefit. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Spitting -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Spitting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyAggressiveBehaviour"/>
        <ncit2:synonym xml:lang="en">Spitting at Other Person, Spitting on People</ncit2:synonym>
        <umls3:cui xml:lang="en">C0562604</umls3:cui>
        <rdfs:comment xml:lang="en">The behaviour of ejecting saliva forcibly from one&apos;s mouth and spitting at other person.</rdfs:comment>
        <rdfs:label xml:lang="en">Spitting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StabilisingEmotionalAndMoodDisturbance -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StabilisingEmotionalAndMoodDisturbance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareGoalForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:synonym xml:lang="en">Stabilizing Emotional and Mood Disturbance</ncit2:synonym>
        <rdfs:comment xml:lang="en">The care goal of stabilising (not becoming worse) the emotional and mood disturbance of a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Stabilising Emotional and Mood Disturbance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StaffCareRecipientRatio -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StaffCareRecipientRatio">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FactorAffectingImplementationOfNonpharmacologicalIntervention"/>
        <ncit2:synonym xml:lang="en">Staff Resident Ratio</ncit2:synonym>
        <rdfs:comment xml:lang="en">Ratio of staff number to one care recipient in the long term care facility</rdfs:comment>
        <rdfs:label xml:lang="en">Staff Care Recipient Ratio</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StaffStability -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StaffStability">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FactorAffectingImplementationOfNonpharmacologicalIntervention"/>
        <rdfs:comment xml:lang="en">The state of being able to keep the same staff for a long time.</rdfs:comment>
        <rdfs:label xml:lang="en">Staff Stability</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StaffSupervision -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StaffSupervision">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessionalFocusedIntervention"/>
        <umls3:cui xml:lang="en">C0262730</umls3:cui>
        <rdfs:label xml:lang="en">Staff Supervision</rdfs:label>
        <skos:definition xml:lang="en">Facilitating the delivery of high-quality patient care by others. From Nursing Interventions Classification</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StageOfDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StageOfDementia">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isStageOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:synonym xml:lang="en">Severity of Dementia</ncit2:synonym>
        <umls3:cui xml:lang="en">C4716538</umls3:cui>
        <rdfs:comment xml:lang="en">Progression of dementia</rdfs:comment>
        <rdfs:label xml:lang="en">Stage Of Dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Staring -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Staring">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyAggressiveBehaviour"/>
        <umls3:cui xml:lang="en">C0423086</umls3:cui>
        <rdfs:comment xml:lang="en">The behaviour of looking fixedly or vacantly at someone or something with one&apos;s eyes wide open.</rdfs:comment>
        <rdfs:label xml:lang="en">Staring</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StarksteinApathyScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StarksteinApathyScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#assesses"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApathyInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:abbreviation xml:lang="en">SAS</ncit2:abbreviation>
        <rdfs:label xml:lang="en">Starkstein Apathy Scale</rdfs:label>
        <skos:definition xml:lang="en">The Starkstein Apathy Scale (SAS) was published in 1992 and derived from the Apathy Evaluation Scale (AES) designed by Robert Marin in 1990. From Starkstein SE, Mayberg HS, Preziosi TJ, Andrezejewski P, Leiguarda R, Robinson RG. Reliability, validity, and clinical correlates of apathy in Parkinson&apos;s disease. J Neuropsychiatry Clin Neurosci. 1992 Spring;4(2):134-9</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StartTime -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StartTime">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Time"/>
        <umls3:cui xml:lang="en">C1301880</umls3:cui>
        <rdfs:comment xml:lang="en">The time at which something is to start or did start.</rdfs:comment>
        <rdfs:label xml:lang="en">Start Time</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StateTraitAnxietyInventory -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StateTraitAnxietyInventory">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#assesses"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AnxietyInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:abbreviation xml:lang="en">STAI</ncit2:abbreviation>
        <umls3:cui xml:lang="en">C5190293</umls3:cui>
        <rdfs:label xml:lang="en">State-Trait Anxiety Inventory</rdfs:label>
        <skos:definition xml:lang="en">The State-Trait Anxiety Inventory (STAI) is a commonly used measure of trait and state anxiety (Spielberger, Gorsuch, Lushene, Vagg, &amp; Jacobs, 1983). It can be used in clinical settings to diagnose anxiety and to distinguish it from depressive syndromes. From American Psychological Association https://www.apa.org/pi/about/publications/caregivers/practice-settings/assessment/tools/trait-state</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StateTraitAnxietyInventoryForAdults -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StateTraitAnxietyInventoryForAdults">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#assesses"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AnxietyInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:abbreviation xml:lang="en">STAI-AD, STAI-A</ncit2:abbreviation>
        <rdfs:label xml:lang="en">State-Trait Anxiety Inventory for Adults</rdfs:label>
        <skos:definition xml:lang="en">The State-Trait Anxiety Inventory for Adults is the definitive instrument for measuring anxiety in adults. The STAI clearly differentiates between the temporary condition of &quot;state anxiety&quot; and the more general and long-standing quality of &quot;trait anxiety.&quot; The essential qualities evaluated by the STAI-S Anxiety scale are feelings of apprehension, tension, nervousness, and worry. Scores on the STAI-S Anxiety scale increase in response to physical danger and psychological stress, and decrease as a result of relaxation training. On the STAI-T Anxiety scale, consistent with the trait anxiety construct, psychoneurotic and depressed patients generally have high scores. From APA PsycTests Database Record (c) 2019 APA</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StimulantAddiction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StimulantAddiction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Addiction"/>
        <ncit2:synonym xml:lang="en">Stimulant Dependence</ncit2:synonym>
        <umls3:cui xml:lang="en">C2711618</umls3:cui>
        <rdfs:comment xml:lang="en">Addiction to stimulants which are a class of drugs, such as caffeine, amphetamines, and cocaine.</rdfs:comment>
        <rdfs:label xml:lang="en">Stimulant Addiction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Storytelling -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Storytelling">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">The activity of sharing stories.</rdfs:comment>
        <rdfs:label xml:lang="en">Storytelling</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StrengthExercise -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StrengthExercise">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalExerciseTherapy"/>
        <ncit2:synonym xml:lang="en">Muscle Strength Exercise</ncit2:synonym>
        <umls3:cui xml:lang="en">C0419118</umls3:cui>
        <rdfs:label xml:lang="en">Strength Exercise</rdfs:label>
        <skos:definition xml:lang="en">Strength exercise works one&apos;s muscles by using a resistance against which the muscles need to exert a force. This increases muscles&apos; strength, size, power and endurance. From www.nhs.uk (https://www.nhs.uk/live-well/exercise/how-to-improve-strength-flexibility/)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StressOfHealthCareProfessional -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StressOfHealthCareProfessional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnHealthCareProfessional"/>
        <rdfs:comment xml:lang="en">The uneasy mental state of health care professional causing by emotional and mood disturbances of people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Stress of Health Care Professional</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StretchingExercise -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StretchingExercise">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalExerciseTherapy"/>
        <ncit2:synonym xml:lang="en">Stretching, Stretch</ncit2:synonym>
        <umls3:cui xml:lang="en">C0600080</umls3:cui>
        <rdfs:label xml:lang="en">Stretching Exercise</rdfs:label>
        <skos:definition xml:lang="en">A physical exercise in which a specific muscle or tendon is deliberately flexed or stretched in order to improve the muscle&apos;s elasticity. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Stroke -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Stroke">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:synonym xml:lang="en">Cerebrovascular Accident, Cerebral Stroke, Brain Vascular Accident, Cerebrovascular Stroke</ncit2:synonym>
        <umls3:cui xml:lang="en">C0038454</umls3:cui>
        <rdfs:label xml:lang="en">Stroke</rdfs:label>
        <skos:definition xml:lang="en">A group of pathological conditions characterized by sudden, non-convulsive loss of neurological function due to brain ischemia or intracranial hemorrhages. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonWithDementiaFocusedIntervention"/>
        <ncit2:synonym xml:lang="en">Diversional Activity, Organized Activity, Recreational Activity</ncit2:synonym>
        <rdfs:comment xml:lang="en">The organized various activities for care recipients, which range from trivia games to puzzles.</rdfs:comment>
        <rdfs:label xml:lang="en">Structured Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SubduralHematoma -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SubduralHematoma">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:abbreviation xml:lang="en">SDH</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Subdural Intracranial Hematoma, Subdural Intracranial Hemorrhage</ncit2:synonym>
        <umls3:cui xml:lang="en">C0018946</umls3:cui>
        <rdfs:label xml:lang="en">Subdural Hematoma</rdfs:label>
        <skos:definition xml:lang="en">Accumulation of blood in the subdural space between the dura mater and the arachnoidal layer of the meninges. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SuicidalIdeation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SuicidalIdeation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfDepressionInDementia"/>
        <umls3:cui xml:lang="en">C4554104</umls3:cui>
        <rdfs:comment xml:lang="en">Thoughts of taking one&apos;s own life. From the U.S. National Cancer Institute Thesaurus</rdfs:comment>
        <rdfs:label xml:lang="en">Suicidal Ideation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Suicide -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Suicide">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfDepressionInDementia"/>
        <umls3:cui xml:lang="en">C0038661</umls3:cui>
        <rdfs:comment xml:lang="en">The action of killing oneself intentionally.</rdfs:comment>
        <rdfs:label xml:lang="en">Suicide</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SuicideAttempt -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SuicideAttempt">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfDepressionInDementia"/>
        <umls3:cui xml:lang="en">C0038663</umls3:cui>
        <rdfs:label xml:lang="en">Suicide Attempt</rdfs:label>
        <skos:definition xml:lang="en">The unsuccessful atempt to kill onesel. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Sundowning -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Sundowning">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:synonym xml:lang="en">Sundown Syndrome, Sundown, Sun Down</ncit2:synonym>
        <umls3:cui xml:lang="en">C1142436</umls3:cui>
        <rdfs:label xml:lang="en">Sundowning</rdfs:label>
        <skos:definition xml:lang="en">A syndrome of emergence or increment of neuropsychiatric symptoms, such as confusion and behavioral disturbances, in the late afternoon, early evening or at night. From SNOMEDCT_US</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SunlightTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SunlightTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LightTherapy"/>
        <rdfs:comment xml:lang="en">The treatment of exposure to sunlight, e.g., exposure to natural sunlight for 30 minute periods in the morning and evening. From Wallace, T, Chand, R, Buck, E, Riley, P, Murphy, G, Brauer, H, McAuliffe, S, Doolette, J &amp; McCrath, E 2012, ReBOC: reducing behaviours of concern: a hands on guide: a resource to assist those caring for people living with dementia., Alzheimer’s Association (SA) Inc., Adelaide.</rdfs:comment>
        <rdfs:label xml:lang="en">Sunlight Therapy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SupportToFamilyMember -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SupportToFamilyMember">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMemberFocusedIntervention"/>
        <ncit2:synonym xml:lang="en">Provide Privacy and Support for Family Member</ncit2:synonym>
        <umls3:cui xml:lang="en">C0515044</umls3:cui>
        <rdfs:comment xml:lang="en">The intervention of providing resources, information and services to family members of a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Support to Family Member</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SupportToHealthCareProfessional -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SupportToHealthCareProfessional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessionalFocusedIntervention"/>
        <rdfs:comment xml:lang="en">The support to health care professionals caring for people living with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Support to Health Care Professional</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SurvivingHolocaust -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SurvivingHolocaust">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TraumaticLifeEvent"/>
        <rdfs:comment xml:lang="en">Information of a person in surviving holocause which is a massive slaughter, especially the systematic mass extermination of European Jews in Nazi concentration camps prior to and during World War II.</rdfs:comment>
        <rdfs:label xml:lang="en">Surviving Holocaust</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SwallowingProblem -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SwallowingProblem">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:synonym xml:lang="en">Swallowing Impairment, Impaired Swallowing, Problem with Swallowing</ncit2:synonym>
        <umls3:cui xml:lang="en">C0392678</umls3:cui>
        <rdfs:label xml:lang="en">Swallowing Problem</rdfs:label>
        <skos:definition xml:lang="en">Abnormal functioning of the swallowing mechanism associated with deficits in oral, pharyngeal, or esophageal structure or function.  From NANDA-International</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Swimming -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Swimming">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalExerciseTherapy"/>
        <umls3:cui xml:lang="en">C0039003</umls3:cui>
        <rdfs:label xml:lang="en">Swimming</rdfs:label>
        <skos:definition xml:lang="en">An activity in which the body is propelled through water by specific movement of the arms and/or the legs. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TactileImpairment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TactileImpairment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SensoryImpairment"/>
        <ncit2:synonym xml:lang="en">Tactile Sensation Impairment</ncit2:synonym>
        <umls3:cui xml:lang="en">C0241328</umls3:cui>
        <rdfs:comment xml:lang="en">The touch sensation of a person is no longer normal.</rdfs:comment>
        <rdfs:label xml:lang="en">Tactile Impairment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TaiChi -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TaiChi">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MindBodyTherapy"/>
        <ncit2:synonym xml:lang="en">Tai Ji, Tai Chi Quan, Tai Chi Chuan, Tai-Chi</ncit2:synonym>
        <umls3:cui xml:lang="en">C0376403</umls3:cui>
        <rdfs:label xml:lang="en">Tai Chi</rdfs:label>
        <skos:definition xml:lang="en">A form of traditional Chinese mind/body exercise and meditation that uses slow sets of body movements and controlled breathing. Tai chi is done to improve balance, flexibility, muscle strength, and overall health. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TakingOtherPeopleBelonging -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TakingOtherPeopleBelonging">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyNonaggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The behaviour of inappropriately taking other people&apos;s belonging.</rdfs:comment>
        <rdfs:label xml:lang="en">Taking Other People&apos;s Belonging</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TakingVitalSign -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TakingVitalSign">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthAssessment"/>
        <ncit2:synonym xml:lang="en">Observation of Vital Sign, Vital Signs Assessment</ncit2:synonym>
        <umls3:cui xml:lang="en">C0150404</umls3:cui>
        <rdfs:comment xml:lang="en">The actions performed to assess a person&apos;s vital signs, including temperature, pulse, respirations, and blood pressure.</rdfs:comment>
        <rdfs:label xml:lang="en">Taking Vital Sign</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TaskFocusedOrganisationalCulture -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TaskFocusedOrganisationalCulture">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OrganisationalCulture"/>
        <ncit2:synonym xml:lang="en">Task-Focused Workplace Culture, Task-Focused Organizational Culture</ncit2:synonym>
        <rdfs:comment xml:lang="en">The organisational culture that staff focus on completing assigned tasks in a timely manner.</rdfs:comment>
        <rdfs:label xml:lang="en">Task-Focused Organisational Culture</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TasteAbility -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TasteAbility">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SensoryAbility"/>
        <ncit2:synonym xml:lang="en">Taste Sense, Taste Sensation, Gustation, Taste Perception</ncit2:synonym>
        <umls3:cui xml:lang="en">C0039336</umls3:cui>
        <rdfs:comment xml:lang="en">The ability to distinguish sweet, sour, bitter, and salty properties in the mouth.</rdfs:comment>
        <rdfs:label xml:lang="en">Taste Ability</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TastingSweetFood -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TastingSweetFood">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">The activity of tasting sweet food.</rdfs:comment>
        <rdfs:label xml:lang="en">Tasting Sweet Food</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Tearfulness -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Tearfulness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfDepressionInDementia"/>
        <ncit2:synonym xml:lang="en">Crying</ncit2:synonym>
        <umls3:cui xml:lang="en">C1717727</umls3:cui>
        <rdfs:comment xml:lang="en">Sadness expressed by weeping. From Vocabulary.com</rdfs:comment>
        <rdfs:label xml:lang="en">Tearfulness</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Tearing -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Tearing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyAggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The behaviour of pulling something apart or to pieces with force, such as tearing books.</rdfs:comment>
        <rdfs:label xml:lang="en">Tearing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TenderLovingCare -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TenderLovingCare">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:abbreviation xml:lang="en">TLC</ncit2:abbreviation>
        <umls3:cui xml:lang="en">C0419204</umls3:cui>
        <rdfs:comment xml:lang="en">The intervention of giving a person extra compassionate, thoughtful attention.</rdfs:comment>
        <rdfs:label xml:lang="en">Tender Loving Care</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Therapist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Therapist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessional"/>
        <umls3:cui xml:lang="en">C0871525</umls3:cui>
        <rdfs:label xml:lang="en">Therapist</rdfs:label>
        <skos:definition xml:lang="en">Conceptually broad terms referring to persons trained in the treatment of problems including mental disorders and behavior disorders. From the Thesaurus of Psychological Index Terms</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonWithDementiaFocusedIntervention"/>
        <rdfs:label xml:lang="en">Therapy for Emotional and Mood Disturbance in Dementia</rdfs:label>
        <skos:definition xml:lang="en">Conceptually broad term referring to psychological or physical measures designed to ameliorate emotional and mood disturbances in dementia.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Thirst -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Thirst">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnmetPhysiologicalNeed"/>
        <ncit2:synonym xml:lang="en">Desire for Drinks, Desire for Fluids</ncit2:synonym>
        <umls3:cui xml:lang="en">C0039971</umls3:cui>
        <rdfs:label xml:lang="en">Thirst</rdfs:label>
        <skos:definition xml:lang="en">A desire for water.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Threat -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Threat">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyAggressiveBehaviour"/>
        <umls3:cui xml:lang="en">C0749385</umls3:cui>
        <rdfs:comment xml:lang="en">A statement of an intention to injury, damage, or other hostile action on someone in retribution for something done or not done.</rdfs:comment>
        <rdfs:label xml:lang="en">Threat</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ThrowingObject -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ThrowingObject">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyAggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The behaviour of using hands to lift something and propel it with force through the air.</rdfs:comment>
        <rdfs:label xml:lang="en">Throwing Object</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Time -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Time">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isTimeOf"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManagementActivityOfEmotionalAndMoodDisturbanceInDementia"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfEmotionalAndMoodDisturbanceInDementia"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <umls3:cui xml:lang="en">C0040223</umls3:cui>
        <rdfs:label xml:lang="en">Time</rdfs:label>
        <skos:definition xml:lang="en">The dimension of the physical universe which, at a given place, orders the sequence of events. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ToiletryPreference -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ToiletryPreference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Preference"/>
        <rdfs:comment xml:lang="en">Preference to items used in washing and taking care of one&apos;s body, such as soap, shampoo, and toothpaste.</rdfs:comment>
        <rdfs:label>Toiletry Preference</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TorresStraitIslander -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TorresStraitIslander">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DemographicInformation"/>
        <rdfs:label xml:lang="en">Torres Strait Islander</rdfs:label>
        <skos:definition xml:lang="en">Information about a person that if he/she is Torres Strait Islander.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TouchAbility -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TouchAbility">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SensoryAbility"/>
        <ncit2:synonym xml:lang="en">Tactile Sense, Touch Sensation, Sense of Touch, Touch Sense</ncit2:synonym>
        <umls3:cui xml:lang="en">C0702221</umls3:cui>
        <rdfs:label xml:lang="en">Touch Ability</rdfs:label>
        <skos:definition xml:lang="en">The ability to perceive an object or other stimulus that comes into contact with the surface of the skin (e.g., by pressure, stroking). From APA Dictionary of Psychology</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TouchTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TouchTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SensoryStimulationTherapy"/>
        <ncit2:synonym xml:lang="en">Therapeutic Touch</ncit2:synonym>
        <umls3:cui xml:lang="en">C5141260</umls3:cui>
        <rdfs:label xml:lang="en">Touch Therapy</rdfs:label>
        <skos:definition xml:lang="en">Therapeutic touch refers to an intentionally directed process where the practitioner uses the hands as a focus to facilitate the healing process. From Woods &amp; Dimond, 2002 The effect of therapeutic touch on agitated behavior and cortisol in person with Alzheimer&apos;s disease. Biological Research for Nursing 4:2</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TouchingGently -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TouchingGently">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionSuggested"/>
        <rdfs:comment xml:lang="en">Touching a person with dementia in a manner that is soft and mild.</rdfs:comment>
        <rdfs:label xml:lang="en">Touching Gently</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TowelPreference -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TowelPreference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Preference"/>
        <rdfs:comment xml:lang="en">Preference to towel to use, e.g., colour or fabric of towel.</rdfs:comment>
        <rdfs:label xml:lang="en">Towel Preference</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ToyAnimalAssistedTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ToyAnimalAssistedTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AnimalAssistedTherapy"/>
        <rdfs:comment xml:lang="en">A psychotherapy treatment based upon building a bond with a toy animal through interaction and play. It is usually a stuffed animal toy, such as a Teddy Bear.</rdfs:comment>
        <rdfs:label xml:lang="en">Toy Animal-Assisted Therapy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TransferOfCare -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TransferOfCare">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManagementActivityOfEmotionalAndMoodDisturbanceInDementia"/>
        <umls3:cui xml:lang="en">C1531390</umls3:cui>
        <rdfs:comment xml:lang="en">The activity that a long term care facility turns over responsibility for the care of a person to another care provider.</rdfs:comment>
        <rdfs:label xml:lang="en">Transfer of Care</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TransferOfCareToAnotherLongTermCareFacility -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TransferOfCareToAnotherLongTermCareFacility">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TransferOfCare"/>
        <rdfs:comment xml:lang="en">The activity of transferring of care to another long term care factility.</rdfs:comment>
        <rdfs:label xml:lang="en">Transfer of Care to Another Long Term Care Facility</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TransferOfCareToHome -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TransferOfCareToHome">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TransferOfCare"/>
        <rdfs:comment xml:lang="en">The activity of transferring of a care recipient to home.</rdfs:comment>
        <rdfs:label xml:lang="en">Transfer of Care to Home</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TransferOfCareToHospital -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TransferOfCareToHospital">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TransferOfCare"/>
        <umls3:cui xml:lang="en">C1997687</umls3:cui>
        <rdfs:comment xml:lang="en">The activity of transferring of care to a hospital.</rdfs:comment>
        <rdfs:label xml:lang="en">Transfer of Care to Hospital</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Transgender -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Transgender">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LGBTQ"/>
        <ncit2:synonym xml:lang="en">Transgendered Person</ncit2:synonym>
        <umls3:cui xml:lang="en">C3266856</umls3:cui>
        <rdfs:label xml:lang="en">Transgender</rdfs:label>
        <skos:definition xml:lang="en">Persons having a sense of persistent identification with, and expression of, gender-coded behaviors not typically associated with one&apos;s anatomical sex at birth, with or without a desire to undergo sex reassignment procedures. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TraumaticLifeEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TraumaticLifeEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PreviousLifeEvent"/>
        <ncit2:synonym xml:lang="en">Trauma</ncit2:synonym>
        <rdfs:comment xml:lang="en">Life events of a person that is deeply disturbing ro distressing.</rdfs:comment>
        <rdfs:label xml:lang="en">Traumatic Life Event</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TreatmentPlanDevelopment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TreatmentPlanDevelopment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManagementActivityOfEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:synonym xml:lang="en">Developing a Care Plan, Development of Care Plan</ncit2:synonym>
        <umls3:cui xml:lang="en">C1302613</umls3:cui>
        <rdfs:comment xml:lang="en">It refers to the activity of developing a person-centred plan of care including the creation and updating of the care plan.</rdfs:comment>
        <rdfs:label xml:lang="en">Treatment Plan Development</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TreeNutAllergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TreeNutAllergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FoodAllergy"/>
        <ncit2:synonym xml:lang="en">Allergy to Tree Nut</ncit2:synonym>
        <umls3:cui xml:lang="en">C4304131</umls3:cui>
        <rdfs:comment xml:lang="en">Allergic reaction to tree nut (e.g., walnut and hazelnut) or tree nut products.</rdfs:comment>
        <rdfs:label xml:lang="en">Tree Nut Allergy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Tremor -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Tremor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:synonym xml:lang="en">Tremble, Shaking, Shakes, Trambling Movement</ncit2:synonym>
        <umls3:cui xml:lang="en">C0040822</umls3:cui>
        <rdfs:label xml:lang="en">Tremor</rdfs:label>
        <skos:definition xml:lang="en">Unintentional trembling or shaking of one or more body parts. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TurningOffTelevision -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TurningOffTelevision">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Turning off TV</ncit2:synonym>
        <rdfs:comment xml:lang="en">Turning off the television when it&apos;s too noisy or when there are upsetting programs or images</rdfs:comment>
        <rdfs:label xml:lang="en">Turning off Television</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Uncle -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Uncle">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
        <umls3:cui xml:lang="en">C0337577</umls3:cui>
        <rdfs:label xml:lang="en">Uncle</rdfs:label>
        <skos:definition xml:lang="en">The brother of one&apos;s father or mother; the husband of one&apos;s aunt. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UncomfortableRoomTemperature -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UncomfortableRoomTemperature">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OverstimulationOfTouchSense"/>
        <rdfs:comment xml:lang="en">The temperature of the room is not comfortable for a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Uncomfortable Room Temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnderstimulationFromEnvironment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnderstimulationFromEnvironment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentCausativeFactor"/>
        <rdfs:comment xml:lang="en">The environment provides a person with insufficient stimulation.</rdfs:comment>
        <rdfs:label xml:lang="en">Understimulation from Environment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnderstimulationOfHearingSense -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnderstimulationOfHearingSense">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnderstimulationFromEnvironment"/>
        <rdfs:comment xml:lang="en">The hearing sense of a person is insufficiently stimulated.</rdfs:comment>
        <rdfs:label xml:lang="en">Understimulation of Hearing Sense</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnderstimulationOfSmellSense -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnderstimulationOfSmellSense">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnderstimulationFromEnvironment"/>
        <rdfs:comment xml:lang="en">The smell sense of a person is insufficiently stimulated.</rdfs:comment>
        <rdfs:label xml:lang="en">Understimulation of Smell Sense</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnderstimulationOfTasteSense -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnderstimulationOfTasteSense">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnderstimulationFromEnvironment"/>
        <rdfs:comment xml:lang="en">The taste sense of a person is insufficiently stimulated.</rdfs:comment>
        <rdfs:label xml:lang="en">Understimulation of Taste Sense</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnderstimulationOfTouchSense -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnderstimulationOfTouchSense">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnderstimulationFromEnvironment"/>
        <rdfs:comment xml:lang="en">The touch sense of a person is insufficiently stimulated.</rdfs:comment>
        <rdfs:label xml:lang="en">Understimulation of Touch Sense</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnderstimulationOfVisionSense -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnderstimulationOfVisionSense">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnderstimulationFromEnvironment"/>
        <rdfs:comment xml:lang="en">The vision sense of a person is insufficiently stimulated.</rdfs:comment>
        <rdfs:label xml:lang="en">Understimulation of Vision Sense</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnfamiliarHealthCareProfessional -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnfamiliarHealthCareProfessional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialEnvironmentCausativeFactor"/>
        <rdfs:comment xml:lang="en">Health care professionals may not be known or recognized by people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Unfamiliar Health Care Professional</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnfamiliarSituation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnfamiliarSituation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialEnvironmentCausativeFactor"/>
        <rdfs:comment xml:lang="en">The unfamiliar situations that people with dementia may be not having knowledge or experience of.</rdfs:comment>
        <rdfs:label xml:lang="en">Unfamiliar Situation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnmetNeedToDefecate -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnmetNeedToDefecate">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnmetNeedToEliminate"/>
        <ncit2:synonym xml:lang="en">Unmet Need of Bowel Movement, Unmet Need of Bowel Motion, Unmet Need of Bowel Excretion</ncit2:synonym>
        <rdfs:comment xml:lang="en">Unmet need to discharge faeces from the body.</rdfs:comment>
        <rdfs:label xml:lang="en">Unmet Need to Defecate</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnmetNeedToEliminate -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnmetNeedToEliminate">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnmetPhysiologicalNeed"/>
        <rdfs:comment xml:lang="en">Unmet need to expel waste matter from the body</rdfs:comment>
        <rdfs:label xml:lang="en">Unmet Need to Eliminate</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnmetNeedToUrinate -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnmetNeedToUrinate">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnmetNeedToEliminate"/>
        <ncit2:synonym xml:lang="en">Unmet Need of Urinary Excretion, Unmet Need to Pass Urine, Unmet Need to Pass Water</ncit2:synonym>
        <rdfs:comment xml:lang="en">Unmet Need to discharge urine from the body.</rdfs:comment>
        <rdfs:label xml:lang="en">Unmet Need to Urinate</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnmetPhysiologicalNeed -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnmetPhysiologicalNeed">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <rdfs:comment xml:lang="en">The physiological need that is not met.</rdfs:comment>
        <rdfs:label xml:lang="en">Unmet Physiological Need</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Urinalysis -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Urinalysis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthAssessment"/>
        <ncit2:synonym xml:lang="en">Urinalysis Procedure, Urine Examination, Analysis of Urine, Urine Analysis, Urine Test, Procedures Test Urine, Test Urine</ncit2:synonym>
        <umls3:cui xml:lang="en">C0042014</umls3:cui>
        <rdfs:label xml:lang="en">Urinalysis</rdfs:label>
        <skos:definition xml:lang="en">Examination of urine by chemical, physical, or microscopic means. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UrinaryIncontinence -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UrinaryIncontinence">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Incontinence"/>
        <ncit2:synonym xml:lang="en">Absence of Bladder Continence, Lack of Bladder Control, Leaking of Urine, Loss of Bladder Control, Unable to Control Bladder, Unable to Hold Urine</ncit2:synonym>
        <umls3:cui xml:lang="en">C0042024</umls3:cui>
        <rdfs:label xml:lang="en">Urinary Incontinence</rdfs:label>
        <skos:definition xml:lang="en">Involuntary passage of urine outside the body. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UrinaryRetention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UrinaryRetention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:synonym xml:lang="en">Unable to Void Urine, Unable to Pass Urine,  Unable to Empty Bladder, Retention of Urine, Bladder Retention of Urine, Bladder Inability to Empty, Bladder Distention</ncit2:synonym>
        <umls3:cui xml:lang="en">C0080274</umls3:cui>
        <rdfs:label xml:lang="en">Urinary Retention</rdfs:label>
        <skos:definition xml:lang="en">Inability to empty the urinary bladder with voiding (urination). From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UseOfDifferentLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UseOfDifferentLanguage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehaviourOfHealthCareProfessional"/>
        <rdfs:comment xml:lang="en">The health care professional&apos;s behaviour of using the language that is different with the language used by people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Use of Different Language</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingAbusiveLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingAbusiveLanguage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyAggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The behaviour of using extremely offensive and insulting language.</rdfs:comment>
        <rdfs:label xml:lang="en">Using Abusive Language</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingAccusatoryLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingAccusatoryLanguage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyAggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The behaviour of using the language which indicating or suggesting that one believes a person has done something wrong.</rdfs:comment>
        <rdfs:label xml:lang="en">Using Accusatory Language</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingCalmTone -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingCalmTone">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionSuggested"/>
        <rdfs:comment xml:lang="en">People should use calm tone when communicating with people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Using Calm Tone</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingCueCard -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingCueCard">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Communication Card</ncit2:synonym>
        <rdfs:comment xml:lang="en">The intervention of using cue cards, as visual tools, to assist family members, health care professionals and/or volunteers to communicate more easily with the person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Using Cue Card</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingHostileLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingHostileLanguage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyAggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The behaviour of using unfriendly language.</rdfs:comment>
        <rdfs:label xml:lang="en">Using Hostile Language</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingMinimalEncourager -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingMinimalEncourager">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionSuggested"/>
        <rdfs:comment xml:lang="en">Using small signals that let the speaker know you are listening and understanding - words like “uh-huh”, “yes”, “no”, “mmm”, and little actions like nodding that show you are engaged in listening.</rdfs:comment>
        <rdfs:label xml:lang="en">Using Minimal Encourager</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingNonverbalCommunication -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingNonverbalCommunication">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionSuggested"/>
        <rdfs:comment xml:lang="en">People should use nonverbal communicaiton (e.g., body language and facial expression) to complement verbal communication when communicating with a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Using Nonverbal Communication</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingObsceneLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingObsceneLanguage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyAggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The behaviour of using offensive and disgusting language.</rdfs:comment>
        <rdfs:label xml:lang="en">Using Obscene Language</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingPleasantTone -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingPleasantTone">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionSuggested"/>
        <rdfs:comment xml:lang="en">People should use pleasant tone when communicating with people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Using Pleasant Tone</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingPortableBedsideCommode -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingPortableBedsideCommode">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentalIntervention"/>
        <rdfs:comment xml:lang="en">Using a portable, stand-alone, non-flushing commode that can be conveniently placed next to a bed within a room. It is a safe and easy toileting alternative.</rdfs:comment>
        <rdfs:label xml:lang="en">Using a Portable Bedside Commode</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingPositiveWord -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingPositiveWord">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionSuggested"/>
        <rdfs:comment xml:lang="en">People should use positive word(s) when communicating with a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Using Positive Word</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingProfaneLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingProfaneLanguage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyAggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The behaviour of using disrespect language.</rdfs:comment>
        <rdfs:label xml:lang="en">Using Profane Language</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingSimpleLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingSimpleLanguage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionSuggested"/>
        <rdfs:comment xml:lang="en">People should use short, simple words when communicating with a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Using Simple Language</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingSocialRobot -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingSocialRobot">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialInteractionIntervention"/>
        <rdfs:comment xml:lang="en">The intervention of using a social robot to manage the behavioural and psychological symptoms of dementia in people with dementia, such as Evas that is a social and conversational robot. From Cruz-Sandoval and Favela, 2019, A conversational robot to conduct therapeutic interventions for dementia, IEEE Pervasive Comput. 18:2</rdfs:comment>
        <rdfs:label xml:lang="en">Using Social Robot</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingUnobtrusiveSafetyDesignForPhysicalEnviornment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingUnobtrusiveSafetyDesignForPhysicalEnviornment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentalIntervention"/>
        <rdfs:comment xml:lang="en">The intervention that using unobtrusive safety design for physical environment of people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Using Unobtrusive Safety Design for Physical Environment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingVerbalReminder -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingVerbalReminder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Reminding"/>
        <ncit2:synonym xml:lang="en">Using Voice Reminder, Using a Oral Reminder</ncit2:synonym>
        <rdfs:comment xml:lang="en">Using a voice reminder to help a person to remember something</rdfs:comment>
        <rdfs:label xml:lang="en">Using Verbal Reminder</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingWorryBeads -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingWorryBeads">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SensoryStimulationTherapy"/>
        <rdfs:comment xml:lang="en">The intervention of manipulating and swinging a string of beads in a pattern.</rdfs:comment>
        <rdfs:label xml:lang="en">Using Worry Beads</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingWrittenNoteAsReminder -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UsingWrittenNoteAsReminder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Reminding"/>
        <rdfs:comment xml:lang="en">Using written notes as reminders to help a person to remember something</rdfs:comment>
        <rdfs:label xml:lang="en">Using Written Note as Reminder</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ValidationTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ValidationTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <umls3:cui xml:lang="en">C0556529</umls3:cui>
        <rdfs:label xml:lang="en">Validation Therapy</rdfs:label>
        <skos:definition xml:lang="en">Use of a method of therapeutic communication with elderly persons with dementia that focuses on emotional rather than factual content. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerbalCommunicationAbility -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerbalCommunicationAbility">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RemainingAbility"/>
        <ncit2:synonym xml:lang="en">Ability to Use Verbal Communication</ncit2:synonym>
        <rdfs:comment xml:lang="en">Ability of using spoken language to send an intential message to another person.</rdfs:comment>
        <rdfs:label xml:lang="en">Verbal Communication Ability</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyAggressiveBehaviour -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyAggressiveBehaviour">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DisruptiveVocalisation"/>
        <ncit2:synonym xml:lang="en">Verbally Aggressive Behavior</ncit2:synonym>
        <rdfs:comment xml:lang="en">The verbal and vocal agitated behaviours.</rdfs:comment>
        <rdfs:label xml:lang="en">Verbally Aggressive Behaviour</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyNonaggressiveBehaviour -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyNonaggressiveBehaviour">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DisruptiveVocalisation"/>
        <ncit2:synonym xml:lang="en">Verbally Nonaggressive Behavior</ncit2:synonym>
        <rdfs:comment xml:lang="en">The verbal and vocal behaviours that are not aggressive.</rdfs:comment>
        <rdfs:label xml:lang="en">Verbally Nonaggressive Behaviour</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VirtualRealityTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VirtualRealityTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SensoryStimulationTherapy"/>
        <ncit2:abbreviation xml:lang="en">VR-therapy</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Virtual Reality Exposure Therapy, Virtual Reality Immersion Therapy</ncit2:synonym>
        <umls3:cui xml:lang="en">C3494470</umls3:cui>
        <rdfs:label xml:lang="en">Virtual Reality Therapy</rdfs:label>
        <skos:definition xml:lang="en">Treatment technique in a virtual environment which allows the participant to experience a sense of presence in an immersive, computer-generated, three-dimensional, interactive environment that minimizes avoidance behavior and facilitates emotional involvement. From Curr Psychiatry Rep 2010, 12:298, MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VisionAbility -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VisionAbility">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SensoryAbility"/>
        <ncit2:synonym xml:lang="en">Visual Function, Sight, Seeing Function, Sense of Sight, Sensory Visual Perception</ncit2:synonym>
        <umls3:cui xml:lang="en">C0042789</umls3:cui>
        <rdfs:label xml:lang="en">Vision Ability</rdfs:label>
        <skos:definition xml:lang="en">The ability of perception of objects by the eye. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VisitorPreference -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VisitorPreference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Preference"/>
        <rdfs:comment xml:lang="en">Preference to visitors.</rdfs:comment>
        <rdfs:label xml:lang="en">Visitor Preference</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VisualAnalogMoodScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VisualAnalogMoodScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">VAMS</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Visual Analog Mood Scales</ncit2:synonym>
        <rdfs:label xml:lang="en">Visual Analog Mood Scale</rdfs:label>
        <skos:definition xml:lang="en">The Visual Analog Mood Scale (VAMS) is a reliable and valid measure of eight specific mood states: Afraid, Confused, Sad, Angry, Energetic, Tired, Happy, and Tense. This simple, brief test places minimal cognitive or linguistic demands on the respondent and is appropriate for neurologically impaired individuals or those who are unable to complete more verbally or cognitively demanding instruments. From https://www.parinc.com/Products/Pkey/471</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VisualImpairment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VisualImpairment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SensoryImpairment"/>
        <ncit2:synonym xml:lang="en">Vision Impairment, Poor Vision, Low Vision, Dim Vision, Dimming Vision, Loss of Vision, Loss of Eyesight, Decreased Vision, Diminished Vision, Reduced Vision, Subnormal Vision, Eyesight Issue, Vision Loss, Impaired Vision</ncit2:synonym>
        <umls3:cui xml:lang="en">C0042798</umls3:cui>
        <rdfs:label xml:lang="en">Visual Impairment</rdfs:label>
        <skos:definition xml:lang="en">Reduced ability to perceive visual stimuli. From the U.S. Nationcal Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Volunteer -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Volunteer">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#assists"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Person"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:synonym xml:lang="en">Voluntary Worker</ncit2:synonym>
        <umls3:cui xml:lang="en">C0042960</umls3:cui>
        <rdfs:label xml:lang="en">Volunteer</rdfs:label>
        <skos:definition xml:lang="en">Persons who donate their services. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VolunteerProgram -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VolunteerProgram">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialEnvironmentalIntervention"/>
        <rdfs:comment xml:lang="en">The program that volunteers visit people living in the long term care facilities to keep them entertained and supported.</rdfs:comment>
        <rdfs:label xml:lang="en">Volunteer Program</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Walking -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Walking">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalExerciseTherapy"/>
        <umls3:cui xml:lang="en">C0080331</umls3:cui>
        <rdfs:label xml:lang="en">Walking</rdfs:label>
        <skos:definition xml:lang="en">An activity in which the body advances at a slow to moderate pace by moving the feet in a coordinated fashion. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Wandering -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Wandering">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyNonaggressiveBehaviour"/>
        <ncit2:synonym xml:lang="en">Wandering Behaviour, Wandering in Dementia</ncit2:synonym>
        <umls3:cui xml:lang="en">C0871597</umls3:cui>
        <rdfs:label xml:lang="en">Wandering</rdfs:label>
        <skos:definition xml:lang="en">Moving oneself through space while confused or otherwise cognitively impaired. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#WarExperience -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#WarExperience">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TraumaticLifeEvent"/>
        <rdfs:comment xml:lang="en">War experience of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">War Experience</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#WatchingFootballGameHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#WatchingFootballGameHobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#WatchingSportShowHobby"/>
        <rdfs:comment xml:lang="en">Hobby of watching football game.</rdfs:comment>
        <rdfs:label xml:lang="en">Watching Football Game Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#WatchingMovie -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#WatchingMovie">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">The activity of watching movies.</rdfs:comment>
        <rdfs:label xml:lang="en">Watching Moive</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#WatchingSportShowHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#WatchingSportShowHobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hobby"/>
        <rdfs:comment xml:lang="en">Hobby of watching sports show, such as watching tennis game, and football game.</rdfs:comment>
        <rdfs:label xml:lang="en">Watching Sport Show Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#WatchingTelevision -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#WatchingTelevision">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <ncit2:synonym xml:lang="en">Watching TV</ncit2:synonym>
        <rdfs:comment xml:lang="en">The activity of watching television.</rdfs:comment>
        <rdfs:label xml:lang="en">Watching Television</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#WatchingTennisGameHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#WatchingTennisGameHobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#WatchingSportShowHobby"/>
        <rdfs:comment xml:lang="en">Hobby of watching tennis game.</rdfs:comment>
        <rdfs:label xml:lang="en">Watching Tennis Game Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#WeightGain -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#WeightGain">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BodyWeightChange"/>
        <ncit2:synonym xml:lang="en">Weight Increased, Weight Increasing</ncit2:synonym>
        <umls3:cui xml:lang="en">C0043094</umls3:cui>
        <rdfs:label xml:lang="en">Weight Gain</rdfs:label>
        <skos:definition xml:lang="en">Increase in body weight over existing weight. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#WeightLoss -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#WeightLoss">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BodyWeightChange"/>
        <ncit2:synonym xml:lang="en">Body Weight Loss, Weight Decreased, Lose Weight, Losing Weight, Decreased Weight</ncit2:synonym>
        <umls3:cui xml:lang="en">C1262477</umls3:cui>
        <rdfs:label xml:lang="en">Weight Loss</rdfs:label>
        <skos:definition xml:lang="en">Decrease in existing body weight. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#WheatAllergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#WheatAllergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FoodAllergy"/>
        <ncit2:synonym xml:lang="en">Allergy to Wheat, Wheat Hypersensitivity</ncit2:synonym>
        <umls3:cui xml:lang="en">C0949570</umls3:cui>
        <rdfs:label xml:lang="en">Wheat Allergy</rdfs:label>
        <skos:definition xml:lang="en">Allergic reaction to wheat that is triggered by the immune system. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Wife -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Wife">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
        <umls3:cui xml:lang="en">C0242665</umls3:cui>
        <rdfs:comment xml:lang="en">The female partner in marriage.</rdfs:comment>
        <rdfs:label xml:lang="en">Wife</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Withdrawal -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Withdrawal">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isManifestationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AnxietyInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isManifestationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApathyInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isManifestationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DepressionInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <umls3:cui xml:lang="en">C2825032</umls3:cui>
        <rdfs:label xml:lang="en">Withdrawal</rdfs:label>
        <skos:definition xml:lang="en">A social or emotional detachment, pathological retreat from objective reality, interpersonal contact and social involvement. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Woman -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Woman">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PerceivedGender"/>
        <rdfs:comment xml:lang="en">A person, who regardless of their sex assigned at birth, identifies as a woman.</rdfs:comment>
        <rdfs:label xml:lang="en">Woman</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#WoodworkingActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#WoodworkingActivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <ncit2:synonym xml:lang="en">Carpentry</ncit2:synonym>
        <rdfs:comment xml:lang="en">The activity of making items from wood.</rdfs:comment>
        <rdfs:label xml:lang="en">Woodworking Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#WorkforcePlanning -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#WorkforcePlanning">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessionalFocusedIntervention"/>
        <ncit2:abbreviation xml:lang="en">WFP</ncit2:abbreviation>
        <rdfs:comment xml:lang="en">Workforce Planning is the process of analyzing, forecasting, and planning workforce supply and demand, assessing gaps, and determining target talent management interventions to ensure that an organization has the right people - with the right skills in the right places at the right time - to fulfill its mandate and strategic objectives. From the U.S. National Institutes of Health</rdfs:comment>
        <rdfs:label xml:lang="en">Workforce Planning</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#WorryScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#WorryScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:label xml:lang="en">Worry Scale</rdfs:label>
        <skos:definition xml:lang="en">The Worry Scale is developed to assess anxiety-related uncontrollable negative thinking in financial, health, and social areas. From Wisocki, P. A., Handen, B., &amp; Morse, C. K. (1986). The Worry Scale as a measure of anxiety among homebound and community active elderly. the Behavior Therapist, 9(5), 91–95.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Yoga -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Yoga">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MindBodyTherapy"/>
        <ncit2:synonym xml:lang="en">Yoga Therapy</ncit2:synonym>
        <umls3:cui xml:lang="en">C1883583</umls3:cui>
        <rdfs:label xml:lang="en">Yoga</rdfs:label>
        <skos:definition xml:lang="en">An ancient system of practices used to balance the mind and body through exercise, meditation (focusing thoughts), and control of breathing and emotions. Yoga is being studied as a way to relieve stress and treat sleep problems in cancer patients. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


