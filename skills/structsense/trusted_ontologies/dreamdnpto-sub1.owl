        <ncit2:synonym xml:lang="en">History of Taking Illicit Drug</ncit2:synonym>
        <rdfs:comment xml:lang="en">Information about a person&apos;s history of taking illicit drugs (drugs that are manufeatured, obtained, or sold illegally).</rdfs:comment>
        <rdfs:label xml:lang="en">History of Taking Illicit Medication</rdfs:label>
    </owl:Class>
    


