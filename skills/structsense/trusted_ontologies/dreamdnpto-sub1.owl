        <ncit2:synonym xml:lang="en">History of Taking Non-prescribed Drug</ncit2:synonym>
        <rdfs:comment xml:lang="en">Information about a person&apos;s history of taking nonprescribed drug.</rdfs:comment>
        <rdfs:label xml:lang="en">History of Taking Non-prescribed Medication</rdfs:label>
    </owl:Class>
    


