        <umls3:cui xml:lang="en">C2047973</umls3:cui>
        <rdfs:comment xml:lang="en">Individuals who were born in a foreign country.</rdfs:comment>
        <rdfs:label xml:lang="en">First Generation Immigrant</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FishAllergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FishAllergy">
