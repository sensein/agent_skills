        <ncit2:synonym xml:lang="en">Allergy to Fish</ncit2:synonym>
        <umls3:cui xml:lang="en">C0856904</umls3:cui>
        <rdfs:comment xml:lang="en">Allergic reaction to fish that is triggered by the immune system.</rdfs:comment>
        <rdfs:label xml:lang="en">Fish Allergy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FishingHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FishingHobby">
