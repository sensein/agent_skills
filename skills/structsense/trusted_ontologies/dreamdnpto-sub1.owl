        <umls3:cui xml:lang="en">C0424235</umls3:cui>
        <rdfs:comment xml:lang="en">The behaviour of making small movements excessively, especially of the hands and feet.</rdfs:comment>
        <rdfs:label xml:lang="en">Fidgeting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Fighting -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Fighting">
