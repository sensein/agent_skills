        <rdfs:comment xml:lang="en">The activity that participants can pick the winning team(s) in each week of a sporting season to earn some rewards (e.g., snack, voucher but no actual money) if successful.</rdfs:comment>
        <rdfs:label xml:lang="en">Footy Tipping Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Fracture -->

