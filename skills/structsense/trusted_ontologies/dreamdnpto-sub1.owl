        <skos:definition xml:lang="en">Breaks in bones. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FrequencyOfManifestationOfEmotionalAndMoodDisturbance -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FrequencyOfManifestationOfEmotionalAndMoodDisturbance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FeatureOfManifestationOfEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isFrequencyOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfEmotionalAndMoodDisturbanceInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The rate at which the emotional and mood disturbance performs over a particular period of time.</rdfs:comment>
        <rdfs:label xml:lang="en">Frequency of Manifestation Of Emotional and Mood Disturbance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Friend -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Friend">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#conducts"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FriendVisit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isFriendOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareRecipient"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <umls3:cui xml:lang="en">C0079382</umls3:cui>
        <rdfs:comment xml:lang="en">The friends of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Friend</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FriendVisit -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FriendVisit">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialInteractionIntervention"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isConductedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Friend"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The treatment that involves having friends of the person with dementia to visit him/her in the long-term care facility.</rdfs:comment>
        <rdfs:label xml:lang="en">Friend Visit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FrontotemporalDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FrontotemporalDementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dementia"/>
        <ncit2:abbreviation xml:lang="en">FTD</ncit2:abbreviation>
        <umls3:cui xml:lang="en">C0338451</umls3:cui>
        <rdfs:label xml:lang="en">Frontotemporal Dementia</rdfs:label>
        <skos:definition xml:lang="en">Frontotemporal dementia (FTD) is a group of primary neurodegenerative disorders primarily affecting the frontal and temporal lobes. Onset is typically insidious with a gradual and worsening course. Several syndromic variants (some with an identified genetic basis or familiarity) are described that include presentations with predominantly marked personality and behavioural changes (such as executive dysfunction, apathy, deterioration of social cognition, repetitive behaviours, and dietary changes) or with predominantly language deficits (that include semantic, agrammatic/nonfluent, and logopenic forms), or with a combination of these deficits. Memory function, psychomotor speed, as well as visuoperceptual and visuospatial abilities often remain relatively intact, particularly during the early stages of the disorder. From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Frustration -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Frustration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EmotionalDistress"/>
        <ncit2:synonym xml:lang="en">Feeling Frustrated</ncit2:synonym>
        <umls3:cui xml:lang="en">C0016770</umls3:cui>
        <rdfs:label xml:lang="en">Frustration</rdfs:label>
        <skos:definition xml:lang="en">The motivational and/or affective state resulting from being blocked, thwarted, disappointed or defeated. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GaitAbnormality -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GaitAbnormality">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <ncit2:synonym xml:lang="en">Abnormal Gait, Gait Problem, Gait Difficulty, Gait Disturbance, Impaired Gait, Abnormal Walk, Gait Disorder</ncit2:synonym>
        <umls3:cui xml:lang="en">C0575081</umls3:cui>
        <rdfs:label xml:lang="en">Gait Abnormality</rdfs:label>
        <skos:definition xml:lang="en">A disorder characterized by walking difficulties. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GamblingAddiction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GamblingAddiction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Addiction"/>
        <ncit2:synonym xml:lang="en">Pathological Gambling, Compulsive Gambling</ncit2:synonym>
        <umls3:cui xml:lang="en">C0030662</umls3:cui>
        <rdfs:label xml:lang="en">Gambling Addiction</rdfs:label>
        <skos:definition xml:lang="en">A disorder characterized by a preoccupation with gambling and the excitement that gambling with increasing risk provides. Pathological gamblers are unable to cut back on their gambling, despite the fact that it may lead them to lie, steal, or lose a significant relationship, job, or educational opportunity. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Garden -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Garden">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LocationOfManifestationOfEmotionalAndMoodDisturbance"/>
        <rdfs:label xml:lang="en">Garden</rdfs:label>
        <skos:definition xml:lang="en">A garden is a planned space, usually outdoors, set aside for the cultivation, display, and enjoyment of plants and other forms of nature. (Wikipedia)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Gardening -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Gardening">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <umls3:cui xml:lang="en">C0868963</umls3:cui>
        <rdfs:label xml:lang="en">Gardening</rdfs:label>
        <skos:definition xml:lang="en">Cultivation of plants (fruit, vegetable, medical herbs) on small plots of ground or in containers. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GardeningHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GardeningHobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hobby"/>
        <rdfs:comment xml:lang="en">Hobby of gardening.</rdfs:comment>
        <rdfs:label xml:lang="en">Gardening Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GastroesophagealRefluxDisease -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GastroesophagealRefluxDisease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:abbreviation xml:lang="en">GERD, GORD</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Gastroesophageal Reflux, Esophageal Reflux, Gastro-Esophageal Reflux, Gastric Acid Reflux Disease, Gastric Acid Reflux</ncit2:synonym>
        <umls3:cui xml:lang="en">C0017168</umls3:cui>
        <rdfs:label xml:lang="en">Gastroesophageal Reflux Disease</rdfs:label>
        <skos:definition xml:lang="en">Retrograde flow of gastric juice (GASTRIC ACID) and/or duodenal contents (BILE ACIDS; PANCREATIC JUICE) into the distal ESOPHAGUS, commonly due to incompetence of the LOWER ESOPHAGEAL SPHINCTER. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Gay -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Gay">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LGBTQ"/>
        <ncit2:synonym xml:lang="en">Homosexual Male</ncit2:synonym>
        <umls3:cui xml:lang="en">C0242657</umls3:cui>
        <rdfs:comment xml:lang="en">A homosexual person, used especially of a man.</rdfs:comment>
        <rdfs:label xml:lang="en">Gay</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GenderIdentity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GenderIdentity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DemographicInformation"/>
        <umls3:cui xml:lang="en">C0017249</umls3:cui>
        <rdfs:comment xml:lang="en">Identify of a person&apos;s gender assigned biologically at birth, or perceived by oneself.</rdfs:comment>
        <rdfs:label xml:lang="en">Gender Identity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GeneralPractitioner -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GeneralPractitioner">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalPractitioner"/>
        <ncit2:abbreviation xml:lang="en">GP</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">General Physician, General Practice Physician, Local Medical Officer (LMO)</ncit2:synonym>
        <umls3:cui xml:lang="en">C0017319</umls3:cui>
        <rdfs:label xml:lang="en">General Practitioner</rdfs:label>
        <skos:definition xml:lang="en">Physicians whose practice is not restricted to a specific field of medicine. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GeneticPredisposition -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GeneticPredisposition">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <ncit2:synonym xml:lang="en">Genetic Susceptibility, Genetic Predisposition to Disease, Inherited Predisposition, Inherited Susceptibility</ncit2:synonym>
        <umls3:cui xml:lang="en">C0314657</umls3:cui>
        <rdfs:comment xml:lang="en">The genetic characteristics that increase the probability of having a disease or disorder. From Computer Retrieval of Information on Scientific Projects (CRISP) Thesaurus</rdfs:comment>
        <rdfs:label xml:lang="en">Genetic Predisposition</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GeriatricAnxietyInventory -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GeriatricAnxietyInventory">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#assesses"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AnxietyInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:abbreviation xml:lang="en">GAI</ncit2:abbreviation>
        <rdfs:label xml:lang="en">Geriatric Anxiety Inventory</rdfs:label>
        <skos:definition xml:lang="en">The Geriatric Anxiety Inventory (GAI) consists of 20 “Agree/Disagree” items designed to assess typical common anxiety symptoms. From Pachana, N., Byrne, G., Siddle, H., Koloski, N., Harley, E., &amp; Arnold, E. (2007). Development and validation of the Geriatric Anxiety Inventory. International Psychogeriatrics, 19, 103-114. doi: 10.1017/S1041610206003504.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GeriatricDepressionScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GeriatricDepressionScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#assesses"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DepressionInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:abbreviation xml:lang="en">GDS</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Questionnaires Geriatric Depression Scale</ncit2:synonym>
        <umls3:cui xml:lang="en">C0451184</umls3:cui>
        <rdfs:label xml:lang="en">Geriatric Depression Scale</rdfs:label>
        <skos:definition xml:lang="en">A standardized rating scale developed by Yesavage et al in 1983, which is a self-report assessment used to identify depression in older adults. The questionnaire contains 30 items. All questions are answered &apos;yes&apos; or &apos;no&apos;. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GeriatricDepressionScaleShortForm -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GeriatricDepressionScaleShortForm">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#assesses"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DepressionInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <umls3:cui xml:lang="en">C2919619</umls3:cui>
        <rdfs:label xml:lang="en">Geriatric Depression Scale Short Form</rdfs:label>
        <skos:definition xml:lang="en">A standardized rating scale developed by Sheikh et al in 1986, which is a shorter version derived from the original GDS and used to identify depression in older adults. The questionnaire contains 15 items. All questions are answered &apos;yes&apos; or &apos;no&apos;. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Gerontologist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Gerontologist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalPractitioner"/>
        <ncit2:synonym xml:lang="en">Geriatrician, Geriatrics Specialist, Geriatric Physician, Geriatric Medicine Doctor, Griatric Medicine Specialist</ncit2:synonym>
        <umls3:cui xml:lang="en">C0586872</umls3:cui>
        <rdfs:label xml:lang="en">Gerontologist</rdfs:label>
        <skos:definition xml:lang="en">Physicians specializing in physiological and pathological aspects of aging and the aged, including the clinical problems of senescene and senility. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GetIntoReading -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GetIntoReading">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReadingActivity"/>
        <ncit2:abbreviation xml:lang="en">GiR</ncit2:abbreviation>
        <rdfs:label xml:lang="en">Get into Reading</rdfs:label>
        <skos:definition xml:lang="en">A specific literature-based intervention: all reading material is read aloud and open-ended discussion is encouraged by the project worker. Group members participate voluntarily in any way they wish.  They interact in relation both to what is happening in the text itself and to what may be happening within themselves as individuals, responding to the shared presence of the text within the group. From Billington et al. 2013 A literature-based intervention for older people living with dementia</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GivenName -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GivenName">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonName"/>
        <ncit2:synonym xml:lang="en">Forename, First Name</ncit2:synonym>
        <umls3:cui xml:lang="en">C1443235</umls3:cui>
        <rdfs:label xml:lang="en">Given Name</rdfs:label>
        <skos:definition xml:lang="en">Personal name used with a family name to form a full name. From SNOMEDCT</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GivingEncouragement -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GivingEncouragement">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Encouraging, Offering Encouragement</ncit2:synonym>
        <umls3:cui xml:lang="en">C0582387</umls3:cui>
        <rdfs:comment xml:lang="en">The intervention of giving people encouragement.</rdfs:comment>
        <rdfs:label xml:lang="en">Giving Encouragement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GivingSingleStepInstruction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GivingSingleStepInstruction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionSuggested"/>
        <rdfs:comment xml:lang="en">People should provide instruction one step at a time when communicating with people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Giving Single Step Instruction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GivingVisualCue -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GivingVisualCue">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionSuggested"/>
        <rdfs:comment xml:lang="en">People should give visual cues when communicating with a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Giving Visual Cue</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Glare -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Glare">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#OverstimulationOfVisionSense"/>
        <ncit2:synonym xml:lang="en">Glare - Optical Phenomena</ncit2:synonym>
        <umls3:cui xml:lang="en">C0278215</umls3:cui>
        <rdfs:label xml:lang="en">Glare</rdfs:label>
        <skos:definition xml:lang="en">Relatively bright light, or the dazzling sensation of relatively bright light, which produces unpleasantness or discomfort, or which interferes with optimal vision, ocular. From Cline et al., Dictionary of Visual Science, 4th ed</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GoalAchieved -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GoalAchieved">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManagementOutcomeOfEmotionalAndMoodDisturbanceInDementia"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GoalNotAchieved"/>
        <umls3:cui xml:lang="en">C1272277</umls3:cui>
        <rdfs:comment xml:lang="en">The outcome that the goal has been achieved.</rdfs:comment>
        <rdfs:label xml:lang="en">Goal Achieved</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GoalNotAchieved -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GoalNotAchieved">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManagementOutcomeOfEmotionalAndMoodDisturbanceInDementia"/>
        <umls3:cui xml:lang="en">C1272276</umls3:cui>
        <rdfs:comment xml:lang="en">The outcome that the goal has not been achieved.</rdfs:comment>
        <rdfs:label xml:lang="en">Goal Not Achieved</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GodotSyndrome -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GodotSyndrome">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfAnxietyInDementia"/>
        <rdfs:label xml:lang="en">Godot Syndrome</rdfs:label>
        <skos:definition xml:lang="en">Godot syndrome, named after Samuel Beckett&apos;s famous play “Waiting for Godot,” has been described as the anxiety symptoms regarding upcoming events by repeatedly asking questions in the patients with cognitive and memory impairment, mostly dementia. From Huang, Yu-Ping MD1; Hsu, Yi-Chien MD1,2; Chen, Tien-Yu MD1,2; Huang, San-Yuan MD, PhD1; Tzeng, Nian-Sheng MD1,3 Venlafaxine Treatment in the Treatment of Godot Syndrome in a Patient With Geriatric Depression and Cognitive Impairment, American Journal of Therapeutics: May/June 2020 - Volume 27 - Issue 3 - p e315-e316 doi: 10.1097/MJT.0000000000000980</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GolfPuttingGame -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GolfPuttingGame">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">Golf putting game, designed in the shape of a triangle with an incline, so if the participant misses one of the five holes, the golf ball rolls back to them. Suitable for people who are less mobile, this game comes with one bright golf putting club and 4 golf balls. It can be folded away for easy storage.</rdfs:comment>
        <rdfs:label xml:lang="en">Golf Putting Game</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GorrfriesBraneSteenScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GorrfriesBraneSteenScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">GBS Scale, GBS-S</ncit2:abbreviation>
        <rdfs:label xml:lang="en">Gottfries-Bråne-Steen Scale</rdfs:label>
        <skos:definition xml:lang="en">The Gottfries-Bråne-Steen (GBS) Scale is a comprehensive global assessment tool for evaluating dementia symptoms and is based on a semi-structured interview and observation of the patient.The scale consists of subscales measuring intellectual (12 items), emotional (3 items) and activities of daily living, primarily items of self-care (6 items); as well as 6 items of behavioral and psychological symptoms of dementia. From Bråne G, Gottfries CG, Winblad B. The Gottfries-Bråne-Steen scale: validity, reliability and application in anti-dementia drug trials. Dement Geriatr Cogn Disord. 2001 Jan-Feb;12(1):1-14. doi: 10.1159/000051230. PMID: 11125236.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Grabbing -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Grabbing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyAggressiveBehaviour"/>
        <umls3:cui xml:lang="en">C4715140</umls3:cui>
        <rdfs:comment xml:lang="en">The behaviour of grasping suddenly and roughly.</rdfs:comment>
        <rdfs:label xml:lang="en">Grabbing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Granddaughter -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Granddaughter">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
        <ncit2:synonym xml:lang="en">Grand Daughter</ncit2:synonym>
        <umls3:cui xml:lang="en">C0337561</umls3:cui>
        <rdfs:comment xml:lang="en">A female grandchild of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Granddaughter</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Grandfather -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Grandfather">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
        <ncit2:synonym xml:lang="en">Grandpa</ncit2:synonym>
        <umls3:cui xml:lang="en">C0337475</umls3:cui>
        <rdfs:comment xml:lang="en">The father of a person&apos;s father or mother.</rdfs:comment>
        <rdfs:label xml:lang="en">Grandfather</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Grandmother -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Grandmother">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
        <ncit2:synonym xml:lang="en">Grandma, Grand Mother</ncit2:synonym>
        <umls3:cui xml:lang="en">C0337474</umls3:cui>
        <rdfs:comment xml:lang="en">The mother of a person&apos;s father or mother.</rdfs:comment>
        <rdfs:label xml:lang="en">Grandmother</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Grandson -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Grandson">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
        <ncit2:synonym xml:lang="en">Grand Son</ncit2:synonym>
        <umls3:cui xml:lang="en">C0337573</umls3:cui>
        <rdfs:comment xml:lang="en">A male grandchild of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Grandson</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GreatGranddaughter -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GreatGranddaughter">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
        <umls3:cui xml:lang="en">C1274024</umls3:cui>
        <rdfs:label xml:lang="en">Great Granddaughter</rdfs:label>
        <skos:definition xml:lang="en">A daughter of one&apos;s grandchild. From Oxford Languagues</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GreatGrandfather -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GreatGrandfather">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
        <umls3:cui xml:lang="en">C0337482</umls3:cui>
        <rdfs:label xml:lang="en">Great Grandfather</rdfs:label>
        <skos:definition xml:lang="en">The father of one&apos;s grandmother or grandfather. From Oxford Languages</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GreatGrandmother -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GreatGrandmother">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
        <umls3:cui xml:lang="en">C0337481</umls3:cui>
        <rdfs:label xml:lang="en">Great Grandmother</rdfs:label>
        <skos:definition xml:lang="en">The mother of one&apos;s grandmother or grandfather. From Oxford Languages</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GreatGrandson -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GreatGrandson">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
        <umls3:cui xml:lang="en">C1274023</umls3:cui>
        <rdfs:label xml:lang="en">Great Grandson</rdfs:label>
        <skos:definition xml:lang="en">A son of one&apos;s grandchild. From Oxford Languages</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Grief -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Grief">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <ncit2:synonym xml:lang="en">Grief Reaction, Normal Grief Reaction to Life Event, Normal Bereavement Reaction, Greiving</ncit2:synonym>
        <umls3:cui xml:lang="en">C0018235</umls3:cui>
        <rdfs:label xml:lang="en">Grief</rdfs:label>
        <skos:definition xml:lang="en">Normal, appropriate sorrowful response to an immediate cause. it is self-limiting and gradually subsides within a reasonable time. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Groaning -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Groaning">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyNonaggressiveBehaviour"/>
        <ncit2:synonym xml:lang="en">Moaning</ncit2:synonym>
        <umls3:cui xml:lang="en">C4552524</umls3:cui>
        <rdfs:comment xml:lang="en">The behaviour of making a deep inarticulate sound.</rdfs:comment>
        <rdfs:label xml:lang="en">Groaning</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GroupDeliveryOfNonpharmacologicalIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GroupDeliveryOfNonpharmacologicalIntervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DeliveryModeOfNonpharmacologicalIntervention"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IndividualDeliveryOfNonpharmacologicalIntervention"/>
        <rdfs:comment xml:lang="en">Nonpharmacological interventions are being administered in a group format.</rdfs:comment>
        <rdfs:label xml:lang="en">Group Delivery of Nonpharmacological Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Grunting -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Grunting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyNonaggressiveBehaviour"/>
        <umls3:cui xml:lang="en">C0234892</umls3:cui>
        <rdfs:comment xml:lang="en">The behaviour of making a low, short guttural sound.</rdfs:comment>
        <rdfs:label xml:lang="en">Grunting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GustatoryImpairment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GustatoryImpairment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SensoryImpairment"/>
        <ncit2:synonym xml:lang="en">Hypogeusia, Decreased Sense of Taste, Decreased Taste, Taste Diminished, Gustatory Sense Diminished</ncit2:synonym>
        <umls3:cui xml:lang="en">C0151934</umls3:cui>
        <rdfs:label xml:lang="en">Gustatory Impairment</rdfs:label>
        <skos:definition xml:lang="en">Decreased ability to taste. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HaematologicalDisease -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HaematologicalDisease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:synonym xml:lang="en">Hematological Disease, Blood Disease, Disorder of Hematopoietic System, Hemopoietic Disorder</ncit2:synonym>
        <umls3:cui xml:lang="en">C0018939</umls3:cui>
        <rdfs:label xml:lang="en">Haematological Disease</rdfs:label>
        <skos:definition xml:lang="en">Disorders of the blood and blood forming tissues. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Haemorrhage -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Haemorrhage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Injury"/>
        <ncit2:synonym xml:lang="en">Hemorrhage, Bleeding, Extravasation of Blood</ncit2:synonym>
        <umls3:cui xml:lang="en">C0019080</umls3:cui>
        <rdfs:label xml:lang="en">Haemorrhage</rdfs:label>
        <skos:definition xml:lang="en">Bleeding or escape of blood from a vessel. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HairAppointment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HairAppointment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">The activity of going to a hairdressing facility for a haircut or hairdressing.</rdfs:comment>
        <rdfs:label xml:lang="en">Hair Appointment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HairCarePreference -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HairCarePreference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonalHygienePreference"/>
        <umls3:cui xml:lang="en">C0582056</umls3:cui>
        <rdfs:comment xml:lang="en">Preference to hair care, such as preference for using oil on hair.</rdfs:comment>
        <rdfs:label xml:lang="en">Hair Care Preference</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hallucination -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hallucination">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Psychosis"/>
        <umls3:cui xml:lang="en">C0018524</umls3:cui>
        <rdfs:label xml:lang="en">Hallucination</rdfs:label>
        <skos:definition xml:lang="en">Sensory perceptions of any modality occuring in the absence of the appropriate (external) stimulus. The person may or may not have insight into the unreal nature of the perception. From ICD-11</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HallucinogenAddiction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HallucinogenAddiction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Addiction"/>
        <ncit2:synonym xml:lang="en">Hallucinogen Dependence</ncit2:synonym>
        <umls3:cui xml:lang="en">C0018528</umls3:cui>
        <rdfs:label xml:lang="en">Hallucinogen Addiction</rdfs:label>
        <skos:definition xml:lang="en">A drug dependence for a hallucinogenic substance. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hallway -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hallway">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LocationOfManifestationOfEmotionalAndMoodDisturbance"/>
        <ncit2:synonym xml:lang="en">Foyer</ncit2:synonym>
        <umls3:cui xml:lang="en">C0562499</umls3:cui>
        <rdfs:comment xml:lang="en">The room or space just inside the front entrance of a house or a building.</rdfs:comment>
        <rdfs:label xml:lang="en">Hallway</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HamiltonAnxietyRatingScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HamiltonAnxietyRatingScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#assesses"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AnxietyInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:abbreviation xml:lang="en">HAM-A</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Hamilton Anxiety Scale</ncit2:synonym>
        <umls3:cui xml:lang="en">C5189134</umls3:cui>
        <rdfs:label xml:lang="en">Hamilton Anxiety Rating Scale</rdfs:label>
        <skos:definition xml:lang="en">The Hamilton Anxiety Rating Scale is a rating scale developed to measure the severity of anxiety symptoms. It consists of 14 itmes, each defined by a series of symptoms, and measures both psychic anxiety (mental agitation and psychological distress) and somatic anxiety (physical complaints related to anxiety). From Hamilton M. 1959 The assessment of anxiety states by rating. Br J Med Psychol, 32.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HamiltonRatingScaleForDepression -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HamiltonRatingScaleForDepression">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#assesses"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DepressionInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:abbreviation xml:lang="en">HRSD, Ham-D, HAM-D</ncit2:abbreviation>
        <umls3:cui xml:lang="en">C0451203</umls3:cui>
        <rdfs:label xml:lang="en">Hamilton Rating Scale for Depression</rdfs:label>
        <skos:definition xml:lang="en">The Hamilton Rating Scale for Depression is a clinician-administered depression assessment scale. The original verison contains 17 items. A later 21-item version included 4 items intended to subtype the depression. From Hamilton M. 1960 A rating scale for depression. J Neurol Neurosurg Psychiatry 23</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HandPreference -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HandPreference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Preference"/>
        <umls3:cui xml:lang="en">C0422881</umls3:cui>
        <rdfs:label xml:lang="en">Hand Preference</rdfs:label>
        <skos:definition xml:lang="en">Hand Preference is the tendency to be more skilled and comfortable using one hand instead of the other for tasks such as writing and throwing a ball. From MEDLINEPLUS</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HandWringing -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HandWringing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyNonaggressiveBehaviour"/>
        <ncit2:synonym xml:lang="en">Hand Rubbing</ncit2:synonym>
        <umls3:cui xml:lang="en">C0239846</umls3:cui>
        <rdfs:comment xml:lang="en">The behaviour of constant twisting of the hands of a person as an expression of distress or concern.</rdfs:comment>
        <rdfs:label xml:lang="en">Hand Wringing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Handicraft -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Handicraft">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:label xml:lang="en">Handicraft</rdfs:label>
        <skos:definition xml:lang="en">Activity involving the making of decorative domestic or other objects by hand. From Oxford Languagues</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HandoverTime -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HandoverTime">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Time"/>
        <rdfs:comment xml:lang="en">Routine time for the effective transfer of professional responsibility and accountability for some or all aspects of care for a care recipient, or care recipients, to another person or professional group on a temporary or permanent basis.</rdfs:comment>
        <rdfs:label xml:lang="en">Handover Time</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HappyHourActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HappyHourActivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">The activity that participants can enjoy drinks and appetizers at a certain period of time (e.g., 4pm-5pm).</rdfs:comment>
        <rdfs:label xml:lang="en">Happy Hour Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HappyLifeEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HappyLifeEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PreviousLifeEvent"/>
        <ncit2:synonym xml:lang="en">Positive Life Event</ncit2:synonym>
        <rdfs:comment xml:lang="en">Life events of a person that are positive and enjoyable, such as a wedding.</rdfs:comment>
        <rdfs:label xml:lang="en">Happy Life Event</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HarmToFamilyMember -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HarmToFamilyMember">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnFamilyMember"/>
        <rdfs:comment xml:lang="en">The physical damage to the body of one&apos;s family member(s).</rdfs:comment>
        <rdfs:label xml:lang="en">Harm to Family Member</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HarmToFriend -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HarmToFriend">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnFriend"/>
        <rdfs:comment xml:lang="en">The physical damage (causing by one&apos;s emotional and mood disturbances) to the body of one&apos;s friend(s).</rdfs:comment>
        <rdfs:label xml:lang="en">Harm to Friend</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HarmToHealthCareProfessional -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HarmToHealthCareProfessional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnHealthCareProfessional"/>
        <rdfs:comment xml:lang="en">The physical damage to the body of health care professionals, which are caused by emotional and mood disturbances of people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Harm to Health Care Professional</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HarmToOtherCareRecipient -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HarmToOtherCareRecipient">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnOtherCareRecipient"/>
        <ncit2:synonym xml:lang="en">Harm to Other Resident</ncit2:synonym>
        <rdfs:comment xml:lang="en">The physical damage, that is caused by emotional and mood disturbances of a person with dementia, to the body of other person living in the long-term care facility.</rdfs:comment>
        <rdfs:label xml:lang="en">Harm to Other Care Recipient</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HavingGarden -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HavingGarden">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingHomeLikeEnvironment"/>
        <rdfs:comment xml:lang="en">The long-term care facility should have a garden for people with dementia to use or enjoy.</rdfs:comment>
        <rdfs:label xml:lang="en">Having Garden</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HavingGardenShed -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HavingGardenShed">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingHomeLikeEnvironment"/>
        <rdfs:comment xml:lang="en">The intervention of having a garden shed in the environment for people with dementia to use.</rdfs:comment>
        <rdfs:label xml:lang="en">Having Garden Shed</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HavingKitchen -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HavingKitchen">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingHomeLikeEnvironment"/>
        <rdfs:comment xml:lang="en">The long-term care facility should have a kitchen for people with dementia to use or enjoy.</rdfs:comment>
        <rdfs:label xml:lang="en">Having Kitchen</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HavingPatience -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HavingPatience">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionSuggested"/>
        <rdfs:comment xml:lang="en">People should have patience when communicating with people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Having Patience</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HavingPersonalFurnishing -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HavingPersonalFurnishing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingHomeLikeEnvironment"/>
        <rdfs:comment xml:lang="en">There should be personal furnishings (e.g., funiture, rugs and art objects) in the environment where people with dementia live.</rdfs:comment>
        <rdfs:label xml:lang="en">Having Personal Furnishing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HavingPersonalMemoryBox -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HavingPersonalMemoryBox">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingHomeLikeEnvironment"/>
        <rdfs:comment xml:lang="en">There should be a personal memory box for each person with dementia that contains objects representing special time, event or person. Memory boxes can prompt conversation and provide mental and emotional stimulation.</rdfs:comment>
        <rdfs:label xml:lang="en">Having Personal Memory Box</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HavingPersonalisedDoor -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HavingPersonalisedDoor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingHomeLikeEnvironment"/>
        <rdfs:comment xml:lang="en">Having a personalised door, especially bedroom doors</rdfs:comment>
        <rdfs:label xml:lang="en">Having Personalised Door</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HavingRegularRoutine -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HavingRegularRoutine">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialEnvironmentalIntervention"/>
        <ncit2:synonym xml:lang="en">Consistency of Daily Routine, Structured Daily Routine</ncit2:synonym>
        <rdfs:comment xml:lang="en">The intervention of having a regular routine for a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Having Regular Routine</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HavingWashingLine -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HavingWashingLine">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ProvidingHomeLikeEnvironment"/>
        <ncit2:synonym xml:lang="en">Having Clothesline</ncit2:synonym>
        <rdfs:comment xml:lang="en">The intervention of having washing line (clothesline) in the environment of long-term care facility.</rdfs:comment>
        <rdfs:label xml:lang="en">Having Washing Line</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthAssessment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthAssessment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManagementActivityOfEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:comment xml:lang="en">A health assessment looks at a person&apos;s health, physical, psychological and social function.</rdfs:comment>
        <rdfs:label xml:lang="en">Health Assessment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessional -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#caresFor"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareRecipient"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#conducts"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManagementActivityOfEmotionalAndMoodDisturbanceInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#hasCareGoal"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareGoalForEmotionalAndMoodDisturbanceInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#hasCommunicationSkill"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SkillForCommunicatingWithPersonWithDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#usesTool"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:synonym xml:lang="en">Health Professional, Healthcare Professional</ncit2:synonym>
        <umls3:cui xml:lang="en">C1704312</umls3:cui>
        <rdfs:comment xml:lang="en">All service providers working within the context of the health system, such as doctors, nurses, physiotherapists and medical social workers.</rdfs:comment>
        <rdfs:label xml:lang="en">Health Care Professional</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessionalFocusedIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessionalFocusedIntervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NonpharmacologicalIntervention"/>
        <rdfs:comment xml:lang="en">The interventions targeting health care professionals delivering care to people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Health Care Professional Focused Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessionalRecognitionProgram -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessionalRecognitionProgram">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessionalFocusedIntervention"/>
        <ncit2:synonym xml:lang="en">Staff Recognition Program, Employee Recognition Program, Employee Rewarding and Recognition Program</ncit2:synonym>
        <rdfs:comment xml:lang="en">Health care professional recognition programs are organizational initiatives to reward its staff for achievement, new behaviors, anniversaries and milestones.</rdfs:comment>
        <rdfs:label xml:lang="en">Health Care Professional Recognition Program</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HearingAbility -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HearingAbility">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SensoryAbility"/>
        <ncit2:synonym xml:lang="en">Perception of Sound, Audition</ncit2:synonym>
        <umls3:cui xml:lang="en">C0018767</umls3:cui>
        <rdfs:label xml:lang="en">Hearing Ability</rdfs:label>
        <skos:definition xml:lang="en">The ability of sensing and transducing acoustic stimulation to the central nervious system. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HelpingPeopleFindWordsForSelfExpression -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HelpingPeopleFindWordsForSelfExpression">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionSuggested"/>
        <rdfs:comment xml:lang="en">People should help people with dementia find words for self-expression when communicating with them.</rdfs:comment>
        <rdfs:label xml:lang="en">Helping People with Dementia Find Words for Self Expression</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Heterosexuality -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Heterosexuality">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SexualOrientation"/>
        <ncit2:synonym xml:lang="en">Normal Sexual State, Heterosexaul, Straight, Heterosexual State</ncit2:synonym>
        <umls3:cui xml:lang="en">C0019421</umls3:cui>
        <rdfs:label xml:lang="en">Heterosexuality</rdfs:label>
        <skos:definition xml:lang="en">The sexual attraction or relationship between members of the opposite sex. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HidingObject -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HidingObject">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyNonaggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The behaviour of inappropriately hiding things, such as dirty clothes and used incontinence aids.</rdfs:comment>
        <rdfs:label xml:lang="en">Hiding Object</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HighlyEffective -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HighlyEffective">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Effective"/>
        <terms:source xml:lang="en">Wiskow, K. M., Donaldson, J. M., &amp; Matter, A. L. (2017). An evaluation of generalization of compliance across response types. Behavior Analysis: Research and Practice, 17(4), 402-420. http://dx.doi.org/10.1037/bar0000087</terms:source>
        <ncit2:synonym xml:lang="en">Very Effective</ncit2:synonym>
        <rdfs:comment xml:lang="en">Very successful in producing a desired or intended result</rdfs:comment>
        <rdfs:label xml:lang="en">Highly Effective</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HistoryOfArthritis -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HistoryOfArthritis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HistoryOfChronicHealthCondition"/>
        <ncit2:synonym xml:lang="en">Personal History of Arthritis</ncit2:synonym>
        <umls3:cui xml:lang="en">C0260477</umls3:cui>
        <rdfs:comment xml:lang="en">Personal history of arthritis.</rdfs:comment>
        <rdfs:label xml:lang="en">History of Arthritis</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HistoryOfAsthma -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HistoryOfAsthma">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HistoryOfChronicHealthCondition"/>
        <ncit2:synonym xml:lang="en">Personal History of Asthma</ncit2:synonym>
        <rdfs:comment xml:lang="en">Personal history of asthma, which is a chronic respiratory disease manifested as difficulty breathing due to the narrowing of bronchial passageways. From the U.S. National Cancer Institute Thesaurus</rdfs:comment>
        <rdfs:label xml:lang="en">History of Asthma</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HistoryOfCancer -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HistoryOfCancer">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HistoryOfChronicHealthCondition"/>
        <ncit2:synonym xml:lang="en">Individual Cancer History, Personal History of Cancer</ncit2:synonym>
        <umls3:cui xml:lang="en">C1512706</umls3:cui>
        <rdfs:label xml:lang="en">History of Cancer</rdfs:label>
        <skos:definition xml:lang="en">A person&apos;s medical background regarding the occurrence of cance and cancer-related problems. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HistoryOfChoking -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HistoryOfChoking">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalHistory"/>
        <umls3:cui xml:lang="en">C2051649</umls3:cui>
        <rdfs:comment xml:lang="en">History that the person was observed to choke.</rdfs:comment>
        <rdfs:label xml:lang="en">History of Choking</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HistoryOfChronicHealthCondition -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HistoryOfChronicHealthCondition">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalHistory"/>
        <ncit2:synonym xml:lang="en">History of Chronic Illness, Personal History of Chronic Health Condition</ncit2:synonym>
        <rdfs:comment xml:lang="en">Information about health conditions that persist over a significant span of time.</rdfs:comment>
        <rdfs:label xml:lang="en">History of Chronic Health Condition</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HistoryOfChronicObstructivePulmonaryDisease -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HistoryOfChronicObstructivePulmonaryDisease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HistoryOfChronicHealthCondition"/>
        <ncit2:abbreviation xml:lang="en">History of COPD</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">History of Chronic Obstructive Airway Disease, Personal History of Chronic Obstructive Pulmonary Disease</ncit2:synonym>
        <rdfs:comment xml:lang="en">Personal history of chronic obstructive pulmonary disease, which is a group of lung diseases that make it hard to breathe and get worse over time. From MEDLINEPLUS</rdfs:comment>
        <rdfs:label xml:lang="en">History of Chronic Obstructive Pulmonary Disease</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HistoryOfConstipation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HistoryOfConstipation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalHistory"/>
        <rdfs:comment xml:lang="en">History informatio about constipation of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">History of Constipation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HistoryOfDiabetes -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HistoryOfDiabetes">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HistoryOfChronicHealthCondition"/>
        <ncit2:synonym xml:lang="en">Personal History of Diabetes, History of Diabetes Mellitus</ncit2:synonym>
        <rdfs:comment xml:lang="en">Personal history of diabetes, which is a heterogeneous group of disorders characterized by hyperglycemia and glucose intolerance. (MeSH)</rdfs:comment>
        <rdfs:label xml:lang="en">History of Diabetes</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HistoryOfFall -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HistoryOfFall">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalHistory"/>
        <umls3:cui xml:lang="en">C1561668</umls3:cui>
        <rdfs:comment xml:lang="en">History of a person&apos;s fall.</rdfs:comment>
        <rdfs:label xml:lang="en">History of Fall</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HistoryOfHeadInjury -->

