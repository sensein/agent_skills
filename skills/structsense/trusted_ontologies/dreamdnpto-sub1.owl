        <ncit2:synonym xml:lang="en">Hitting Other Person, Striking, Lashing</ncit2:synonym>
        <umls3:cui xml:lang="en">C0562583</umls3:cui>
        <rdfs:comment xml:lang="en">The behaviour of hitting other person.</rdfs:comment>
        <rdfs:label xml:lang="en">Hitting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hoarding -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hoarding">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyNonaggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The behaviour of accumulating objects and hiding or storing away, such as accumulating toilet paper.</rdfs:comment>
        <rdfs:label xml:lang="en">Hoarding</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient"/>
        <umls3:cui xml:lang="en">C0019826</umls3:cui>
        <rdfs:label xml:lang="en">Hobby</rdfs:label>
        <skos:definition xml:lang="en">Leisure activities engaged in for pleasure. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Homeopathy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Homeopathy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:synonym xml:lang="en">Homeopathic Therapy, Homeopathic Remedy</ncit2:synonym>
        <umls3:cui xml:lang="en">C0684199</umls3:cui>
        <rdfs:label xml:lang="en">Homeopathy</rdfs:label>
        <skos:definition xml:lang="en">A system of therapeutics founded by Samuel Hahnemann (1755-1843), based on the Law of Similars where &quot;like cures like&quot;. Diseases are treated by highly diluted substances that cause, in healthy persons, symptoms like those of the disease to be treated. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Homesickness -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Homesickness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <ncit2:synonym xml:lang="en">Homesick</ncit2:synonym>
        <umls3:cui xml:lang="en">C0850008</umls3:cui>
        <rdfs:label xml:lang="en">Homesickness</rdfs:label>
        <skos:definition xml:lang="en">Homesickness is the distress caused by being away from home. From Wikipedia</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HorticulturalTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HorticulturalTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:synonym xml:lang="en">Garden Therapy, Gardening Therapy, Therapeutic Horticulture</ncit2:synonym>
        <umls3:cui xml:lang="en">C0454057</umls3:cui>
        <rdfs:label xml:lang="en">Horticultural Therapy</rdfs:label>
        <skos:definition xml:lang="en">A therapeutic approach in which the engagement of a person in gardening and plant-based activities are utilized in proving an individual&apos;s social, emotional, educational, psychological, and physical well-being. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HospitalAnxietyAndDepressionScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HospitalAnxietyAndDepressionScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">A standardized survey developed and copyrighted by A. S. Zigmond and R. P. Snaith in 1983, 1992, 1994 and published in the Acta Psychiatrica Scandinavica journal (A.S. Zigmond and R.P. Snaith. The Hospital Anxiety and Depression Scale. Acta psychiart. scand. 1983, 67:361-370) which is used to detect depression and anxiety in individuals in a hospital or medical outpatient clinic. This instrument is a self-administered questionnaire consisting of 14 items that assess how the individual has felt over the past week. Each item as 4 response options that are associated with a score of 0 to 3. From the U.S. National Cancer Institute Thesaurus</ncit2:abbreviation>
        <ncit2:abbreviation xml:lang="en">HADS</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Hospital Anxiety and Depression Scale Questionnaire</ncit2:synonym>
        <umls3:cui xml:lang="en">C3539657</umls3:cui>
        <rdfs:label xml:lang="en">Hospital Anxiety and Depression Scale</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Howling -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Howling">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyNonaggressiveBehaviour"/>
        <umls3:cui xml:lang="en">C0234879</umls3:cui>
        <rdfs:comment xml:lang="en">The behaviour of making a long, doleful cry or wailing sound.</rdfs:comment>
        <rdfs:label xml:lang="en">Howling</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HumorTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HumorTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:synonym xml:lang="en">Humor Facilitation</ncit2:synonym>
        <umls3:cui xml:lang="en">C0597811</umls3:cui>
        <rdfs:label xml:lang="en">Humor Therapy</rdfs:label>
        <skos:definition xml:lang="en">Facilitating the people to perceive, appreciate, and express what is funny, amusing, or ludicrous in order to establish relationships, relieve tension, release anger, facilitate learning, or cope with painful feelings. From the U.S. Nursing Interventions Classification Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hunger -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hunger">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnmetPhysiologicalNeed"/>
        <ncit2:synonym xml:lang="en">Hungry, Food Hunger</ncit2:synonym>
        <umls3:cui xml:lang="en">C0020175</umls3:cui>
        <rdfs:comment xml:lang="en">The desire for food</rdfs:comment>
        <rdfs:label xml:lang="en">Hunger</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Husband -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Husband">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
        <umls3:cui xml:lang="en">C0242664</umls3:cui>
        <rdfs:comment xml:lang="en">The male partner in marriage.</rdfs:comment>
        <rdfs:label xml:lang="en">Husband</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hypercholesterolemia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hypercholesterolemia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <umls3:cui xml:lang="en">C0020443</umls3:cui>
        <rdfs:label xml:lang="en">Hypercholesterolemia</rdfs:label>
        <skos:definition xml:lang="en">A condition with abnormally high levels of cholesterol in the blood. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hypocholesterolemia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hypocholesterolemia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <umls3:cui xml:lang="en">C0151718</umls3:cui>
        <rdfs:label xml:lang="en">Hypocholesterolemia</rdfs:label>
        <skos:definition xml:lang="en">Abnormally diminished amount of cholesterol in the blood. From The Computer Retrieval of Information on Scientific Projects (CRISP) Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IdentifyingAntecedentOfBehaviour -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IdentifyingAntecedentOfBehaviour">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehaviouralObservation"/>
        <ncit2:synonym xml:lang="en">Identifying Precipitant of Behaviour, Identifying Leading Event</ncit2:synonym>
        <rdfs:comment xml:lang="en">Identifying the antecedent event or events that lead to the behaviour of concern</rdfs:comment>
        <rdfs:label xml:lang="en">Identifying Antecedant of Behaviour</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IdentifyingCareGoal -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IdentifyingCareGoal">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TreatmentPlanDevelopment"/>
        <ncit2:synonym xml:lang="en">Setting Health Care Goal, Identifying Goals of Care, Identifying Healthcare Goal</ncit2:synonym>
        <umls3:cui xml:lang="en">C1821661</umls3:cui>
        <rdfs:label xml:lang="en">Identifying Care Goal</rdfs:label>
        <skos:definition xml:lang="en">Identifying and agreeing to goals of care is to develop a shared understanding between care recipients, family, carers, other support people and the clinicians in the multidisciplinary team. From the Australian Commission on Safety and Quality in Health Care</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IdentifyingConsequenceOfBehaviour -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IdentifyingConsequenceOfBehaviour">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehaviouralObservation"/>
        <rdfs:comment xml:lang="en">Identifying the impact of the behaviour on the person, staff, other people and the environment.</rdfs:comment>
        <rdfs:label xml:lang="en">Identifying Consequence of Behaviour</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IdentifyingPeopleAffected -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IdentifyingPeopleAffected">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IdentifyingPeopleInvolved"/>
        <rdfs:comment xml:lang="en">The activity of identifying people who have been affected by an event.</rdfs:comment>
        <rdfs:label xml:lang="en">Identifying People Affected</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IdentifyingPeopleInvolved -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IdentifyingPeopleInvolved">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehaviouralObservation"/>
        <rdfs:comment xml:lang="en">Identifying people involved in the manifestation of emotional and mood disturbances in people with dementia</rdfs:comment>
        <rdfs:label xml:lang="en">Identifying People Involved</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IdentifyingTimeOfBehaviour -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IdentifyingTimeOfBehaviour">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehaviouralObservation"/>
        <rdfs:comment xml:lang="en">Identifying the time of manifestation of behaviour</rdfs:comment>
        <rdfs:label xml:lang="en">Identifying Time of Behaviour</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IdentifyingWitness -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IdentifyingWitness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IdentifyingPeopleInvolved"/>
        <rdfs:comment xml:lang="en">The activity of identifying witnesses who have actually seen an event.</rdfs:comment>
        <rdfs:label xml:lang="en">Identifying Witness</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IdentityingLocationOfBehaviour -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IdentityingLocationOfBehaviour">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehaviouralObservation"/>
        <rdfs:comment xml:lang="en">Identifying the location that the behaviour is manifested</rdfs:comment>
        <rdfs:label xml:lang="en">Identifying Location of Behaviour</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IllnessInFamilyMember -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IllnessInFamilyMember">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TraumaticLifeEvent"/>
        <rdfs:comment xml:lang="en">Information about the illness of a person&apos;s family member.</rdfs:comment>
        <rdfs:label xml:lang="en">Illness in Family Member</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ImmigrantGenerationStatus -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ImmigrantGenerationStatus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ImmigrationInformation"/>
        <rdfs:comment xml:lang="en">Status of immigrant generation - which generation.</rdfs:comment>
        <rdfs:label xml:lang="en">Immigrant Generation Status</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ImmigrationInformation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ImmigrationInformation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient"/>
        <rdfs:comment xml:lang="en">Information of a person&apos;s immigration.</rdfs:comment>
        <rdfs:label xml:lang="en">Immigration Information</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ImmigrationType -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ImmigrationType">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ImmigrationInformation"/>
        <rdfs:comment xml:lang="en">Type of immigration.</rdfs:comment>
        <rdfs:label xml:lang="en">Immigration Type</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ImpairedSocialFunctioning -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ImpairedSocialFunctioning">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnSelf"/>
        <ncit2:synonym xml:lang="en">Impairment in Social Functioning</ncit2:synonym>
        <umls3:cui xml:lang="en">C0679477</umls3:cui>
        <rdfs:comment xml:lang="en">The limitations of an individual with his/her environment and the ability to fulfill his/her role within such environment due to the illness.</rdfs:comment>
        <rdfs:label xml:lang="en">Impaired Social Functioning</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ImprovingQualityOfLifeOfOtherPeople -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ImprovingQualityOfLifeOfOtherPeople">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareGoalForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:comment xml:lang="en">The general care goal of improving the quality of life of other people who are around a person with emotional and mood disturbances.</rdfs:comment>
        <rdfs:label xml:lang="en">Improving  Quality of Life of Other People</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ImprovingQualityOfLifeOfPersonWithEmotionalAndMoodDisturbance -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ImprovingQualityOfLifeOfPersonWithEmotionalAndMoodDisturbance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareGoalForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:comment xml:lang="en">The general goal of improving quality of life of a person with emotional and mood disturbances.</rdfs:comment>
        <rdfs:label xml:lang="en">Improving  Quality of Life of Person with Emotional and Mood Disturbance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InappropriateDressing -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InappropriateDressing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyNonaggressiveBehaviour"/>
        <ncit2:synonym xml:lang="en">Inappropriately Dressed</ncit2:synonym>
        <umls3:cui xml:lang="en">C0424472</umls3:cui>
        <rdfs:comment xml:lang="en">The behaviour of wearing clothes that are not suitable or proper in the circumstances.</rdfs:comment>
        <rdfs:label xml:lang="en">Inappropriate Dressing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InappropriateGesture -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InappropriateGesture">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyNonaggressiveBehaviour"/>
        <rdfs:label xml:lang="en">Inappropriate Gesture</rdfs:label>
        <skos:definition xml:lang="en">The behaviour of making an obsene gesture - a movement or position of the body, especially a hand, the face or the arm - that is considered offensive or vulgar.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InappropriateSexualBehaviour -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InappropriateSexualBehaviour">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyAggressiveBehaviour"/>
        <ncit2:synonym xml:lang="en">Sexually Inappropriate Behaviour</ncit2:synonym>
        <umls3:cui xml:lang="en">C0474420</umls3:cui>
        <rdfs:comment xml:lang="en">The behaviour that is a sexual act which is inappropriate within the context in which it is performed. From Hooren and Waterink 2015 &quot;Uncontrolled Sexual Behaviour in Dementia&quot; DOI:10.5772/59979</rdfs:comment>
        <rdfs:label xml:lang="en">Inappropriate Sexual Behaviour</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InappropriateUndressing -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InappropriateUndressing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyNonaggressiveBehaviour"/>
        <ncit2:synonym xml:lang="en">Inappropriate Disrobing</ncit2:synonym>
        <rdfs:comment xml:lang="en">The behaviour of taking off clothes in the inappropriate circumstances.</rdfs:comment>
        <rdfs:label xml:lang="en">Inappropriate Undressing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InappropriatelyHandlingObject -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InappropriatelyHandlingObject">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyNonaggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The behaviour of handling objects inappropriately, such as dumping water jug, and twisting phone card.</rdfs:comment>
        <rdfs:label xml:lang="en">Inappropriately Handling Object</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Incontinence -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Incontinence">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <umls3:cui xml:lang="en">C0021167</umls3:cui>
        <rdfs:label xml:lang="en">Incontinence</rdfs:label>
        <skos:definition xml:lang="en">Involuntary passage of stool or unrine from the body. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IncreaseInAppetite -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IncreaseInAppetite">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ChangeInAppetite"/>
        <umls3:cui xml:lang="en">C3840648</umls3:cui>
        <rdfs:comment xml:lang="en">The increasing of one&apos;s desire to eat food.</rdfs:comment>
        <rdfs:label xml:lang="en">Increase in Appetite</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IncreasedDependenceOnOtherPeople -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IncreasedDependenceOnOtherPeople">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnSelf"/>
        <rdfs:comment xml:lang="en">Increased reliance on other people for assistance</rdfs:comment>
        <rdfs:label xml:lang="en">Increased Dependence On Other People</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IncreasedEmergencyDepartmentAdmission -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IncreasedEmergencyDepartmentAdmission">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IncreasedHospitalisation"/>
        <ncit2:synonym xml:lang="en">Increased Emergency Room Admission</ncit2:synonym>
        <rdfs:comment xml:lang="en">The increased admission to the emergency department of a hospital.</rdfs:comment>
        <rdfs:label xml:lang="en">Increased Emergency Department Admission</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IncreasedHealthCareCost -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IncreasedHealthCareCost">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnSociety"/>
        <ncit2:synonym xml:lang="en">Increased Health Cost</ncit2:synonym>
        <rdfs:comment xml:lang="en">Increased the actual costs of providing services related to the delivery of health care, including the costs of procedures, therapies, and medications.</rdfs:comment>
        <rdfs:label xml:lang="en">Increased Health Care Cost</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IncreasedHealthCareUtilisation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IncreasedHealthCareUtilisation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnSociety"/>
        <ncit2:synonym xml:lang="en">Increased Health Care Utilization</ncit2:synonym>
        <rdfs:comment xml:lang="en">Increased the use of health care services by persons for preventing and curing health problems.</rdfs:comment>
        <rdfs:label xml:lang="en">Increased Health Care Utilisation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IncreasedHospitalAdmission -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IncreasedHospitalAdmission">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IncreasedHospitalisation"/>
        <ncit2:synonym xml:lang="en">Increased Admission to Hospital</ncit2:synonym>
        <rdfs:comment xml:lang="en">The increased admission to a hospital.</rdfs:comment>
        <rdfs:label xml:lang="en">Increased Hospital Admission</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IncreasedHospitalisation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IncreasedHospitalisation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnSociety"/>
        <ncit2:synonym xml:lang="en">Increased Hospitalization</ncit2:synonym>
        <rdfs:comment xml:lang="en">The times of being treated in a hospital are increased.</rdfs:comment>
        <rdfs:label xml:lang="en">Increased Hospitalisation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IncreasedRiskOfAccidentalInjury -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IncreasedRiskOfAccidentalInjury">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnSelf"/>
        <rdfs:comment xml:lang="en">Emotional and mood disturbances of people with dementia may increase the risk of accidental injury, such as fall.</rdfs:comment>
        <rdfs:label xml:lang="en">Increased Risk of Accidental Injury</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IncreasedRiskOfElderAbuse -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IncreasedRiskOfElderAbuse">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnSelf"/>
        <rdfs:comment xml:lang="en">The emotional and mood disturbances of people with dementia may increase the risk of elder abuse.</rdfs:comment>
        <rdfs:label xml:lang="en">Increased Risk of Elder Abuse</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Indecisiveness -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Indecisiveness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isManifestationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AnxietyInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isManifestationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DepressionInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <umls3:cui xml:lang="en">C0679168</umls3:cui>
        <rdfs:comment xml:lang="en">Being unable to decide, conclude, or resolve something.</rdfs:comment>
        <rdfs:label xml:lang="en">Indecisiveness</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IndifferentEmotion -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IndifferentEmotion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfApathyInDementia"/>
        <ncit2:synonym xml:lang="en">Emotional Indifference</ncit2:synonym>
        <rdfs:comment xml:lang="en">Not showing or feeling interest</rdfs:comment>
        <rdfs:label xml:lang="en">Indifferenct Emotion</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Indigestion -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Indigestion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <ncit2:synonym xml:lang="en">Dyspepsia</ncit2:synonym>
        <umls3:cui xml:lang="en">C0013395</umls3:cui>
        <rdfs:label xml:lang="en">Indigestion</rdfs:label>
        <skos:definition xml:lang="en">Impaired digestion, especially after eating. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IndividualDeliveryOfNonpharmacologicalIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IndividualDeliveryOfNonpharmacologicalIntervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DeliveryModeOfNonpharmacologicalIntervention"/>
        <rdfs:comment xml:lang="en">Nonpharmacological interventions are being administered in an individual format.</rdfs:comment>
        <rdfs:label xml:lang="en">Individual Delivery of Nonpharmacological Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Infection -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Infection">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <umls3:cui xml:lang="en">C3714514</umls3:cui>
        <rdfs:label xml:lang="en">Infection</rdfs:label>
        <skos:definition xml:lang="en">Invastion of the host organism by microorganisms or their toxins or by parasites that can cause pathological conditions or disease. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformationAboutActivityOfDailyLiving -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformationAboutActivityOfDailyLiving">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient"/>
        <ncit2:synonym xml:lang="en">Information about Activities of Daily Life, Information about Daily Routine</ncit2:synonym>
        <rdfs:comment xml:lang="en">Information about the basic activities of daily life, such as dressing, or eating.</rdfs:comment>
        <rdfs:label xml:lang="en">Information about Activity of Daily Living</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformationAboutContinenceCare -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformationAboutContinenceCare">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformationAboutActivityOfDailyLiving"/>
        <rdfs:comment xml:lang="en">Information about how a person care his/her continence, e.g., toileting or using continence aids.</rdfs:comment>
        <rdfs:label xml:lang="en">Information about Continence Care</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformationAboutEating -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformationAboutEating">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformationAboutActivityOfDailyLiving"/>
        <rdfs:comment xml:lang="en">Information about the way a person eats, such as, eating routine and eating environment (e.g., breakfast in bed, eating meal in front of television, eating meal outside).</rdfs:comment>
        <rdfs:label xml:lang="en">Information about Eating</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformationAboutMobility -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformationAboutMobility">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformationAboutActivityOfDailyLiving"/>
        <ncit2:synonym xml:lang="en">Information about Ambulating, Information about Transferring</ncit2:synonym>
        <rdfs:comment xml:lang="en">Information about how a person to move from one position to another, e.g., walk independently.</rdfs:comment>
        <rdfs:label xml:lang="en">Information about Mobility</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformationAboutPersonalGrooming -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformationAboutPersonalGrooming">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformationAboutActivityOfDailyLiving"/>
        <rdfs:comment xml:lang="en">Information of a person&apos;s clothes and appearance, such as, dressing habit.</rdfs:comment>
        <rdfs:label xml:lang="en">Information about Personal Grooming</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformationAboutPersonalHygiene -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformationAboutPersonalHygiene">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformationAboutActivityOfDailyLiving"/>
        <rdfs:comment xml:lang="en">Information about how a person bathe and groom oneself and maintain dental, hygiene, nail, and hair care.</rdfs:comment>
        <rdfs:label xml:lang="en">Information about Personal Hygiene</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformationAboutSleep -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformationAboutSleep">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformationAboutActivityOfDailyLiving"/>
        <rdfs:comment xml:lang="en">Information about sleep of a person, such as, sleeping pattern (e.g., sleeping late and waking up early), and sleep environment.</rdfs:comment>
        <rdfs:label xml:lang="en">Information about Sleep</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformingLegalRepresentative -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformingLegalRepresentative">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <rdfs:comment xml:lang="en">The act of informing the legal representative of a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Informing Legal Representative</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformingMedicalPractitioner -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformingMedicalPractitioner">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Reporting to Doctor, Notifying Doctor, Informing Doctor, Informing GP</ncit2:synonym>
        <umls3:cui xml:lang="en">C0582446</umls3:cui>
        <rdfs:label xml:lang="en">Informing Medical Practitioner</rdfs:label>
        <skos:definition xml:lang="en">Actions performed to communicate with a physician/provider. From Clinical Care Classification</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformingNurse -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformingNurse">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Contacting Nurse, Reporting to Nurse</ncit2:synonym>
        <umls3:cui xml:lang="en">C0204646</umls3:cui>
        <rdfs:label xml:lang="en">Informing Nurse</rdfs:label>
        <skos:definition xml:lang="en">Actions performed to communicate with another nurse. From Clinical Care Classification</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformingPersonWithDementiaBeforeGoingIntoPersonalSpace -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformingPersonWithDementiaBeforeGoingIntoPersonalSpace">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionSuggested"/>
        <rdfs:comment xml:lang="en">People should always inform a person with dementia before going into his/her personal space to implement care.</rdfs:comment>
        <rdfs:label xml:lang="en">Informing Person with Dementia Before Going into Personal Space</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformingRelative -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InformingRelative">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Talking to Relative, Speaking to Relative</ncit2:synonym>
        <umls3:cui xml:lang="en">C0582447</umls3:cui>
        <rdfs:comment xml:lang="en">The act of informing the relative of a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Informing Relative</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Injury -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Injury">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <ncit2:synonym xml:lang="en">Traumatic Injury</ncit2:synonym>
        <umls3:cui xml:lang="en">C3263723</umls3:cui>
        <rdfs:label xml:lang="en">Injury</rdfs:label>
        <skos:definition xml:lang="en">Damage inflicted on the body as the direct or indirect result of an external force, with or without disruption of structural continuity. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InsectAllergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InsectAllergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Allergy"/>
        <ncit2:synonym xml:lang="en">Allergy to Insect</ncit2:synonym>
        <umls3:cui xml:lang="en">C4759911</umls3:cui>
        <rdfs:label xml:lang="en">Insect Allergy</rdfs:label>
        <skos:definition xml:lang="en">Bees, wasps, hornets, yellow jackets and fire ants are the most common stinging insects that cause an allergic reaction. Non-stinging insects can also cause allergic reactions. The most common are cockroaches and the insect-like dust mite. Allergies to these two insects may be the most common cause of year-round allergy and asthma. From Asthma and Allergy Foundation of America https://www.aafa.org/types-of-allergies/</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Insecurity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Insecurity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <umls3:cui xml:lang="en">C0233497</umls3:cui>
        <rdfs:label xml:lang="en">Insecurity</rdfs:label>
        <skos:definition xml:lang="en">Uncertainty or anxiety that things are not fixed or safe. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Insensitivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Insensitivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfApathyInDementia"/>
        <umls3:cui xml:lang="en">C0237677</umls3:cui>
        <rdfs:label xml:lang="en">Insensitivity</rdfs:label>
        <skos:definition xml:lang="en">Lack of concern for others&apos; feelings. From Oxford Languages</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Insomnia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Insomnia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SleepDisturbance"/>
        <ncit2:synonym xml:lang="en">Sleeplessness, Insomnia Disorder, Diffculty Staying or Falling Asleep</ncit2:synonym>
        <umls3:cui xml:lang="en">C0917801</umls3:cui>
        <rdfs:label xml:lang="en">Insomnia</rdfs:label>
        <skos:definition xml:lang="en">A sleep disorder characterized by difficulty in falling asleep and/or remaining sleep. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InstitutionalRestriction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InstitutionalRestriction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialEnvironmentCausativeFactor"/>
        <ncit2:synonym xml:lang="en">Institutional Constraint</ncit2:synonym>
        <rdfs:comment xml:lang="en">Legal or other restrictions placed by the institution for care recipients and workers to follow.</rdfs:comment>
        <rdfs:label xml:lang="en">Institutional Restriction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InsufficientLighting -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InsufficientLighting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnderstimulationOfVisionSense"/>
        <ncit2:synonym xml:lang="en">Poor Lighting</ncit2:synonym>
        <umls3:cui xml:lang="en">C4061117</umls3:cui>
        <rdfs:comment xml:lang="en">The inadequate lighting.</rdfs:comment>
        <rdfs:label xml:lang="en">Insufficient Lighting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InteractionWithOtherCareRecipient -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InteractionWithOtherCareRecipient">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialInteractionIntervention"/>
        <ncit2:synonym xml:lang="en">Interaction with Other Resident</ncit2:synonym>
        <rdfs:comment xml:lang="en">Social interaction with other care recipients living in the same long-term care facility, e.g., talking about current affairs with other care recipients.</rdfs:comment>
        <rdfs:label xml:lang="en">Interaction with Other Care Recipient</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InterferingWithOtherPeopleBelonging -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InterferingWithOtherPeopleBelonging">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyNonaggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The behaviour of interfering with other people&apos;s belongings.</rdfs:comment>
        <rdfs:label xml:lang="en">Interfering with Other People Belonging</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntergenerationalCare -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntergenerationalCare">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:label xml:lang="en">Intergenerational Care</rdfs:label>
        <skos:definition xml:lang="en">Intergenerational care is one form of intervention which may offer benefits to the care home environment and its residents by engaging people with dementia in new relationships and activities with younger people. From Chandler and Gillin, 2020, Dementia in care homes: Using an intergenerational programme to support engagement, community inclusion and positive care environments. Alzheimer&apos;s and Dementia. https://doi.org/10.1002/alz.039874</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InternetBasedIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InternetBasedIntervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Internet Intervention, Online Intervention, Web-based Intervention</ncit2:synonym>
        <umls3:cui xml:lang="en">C3898714</umls3:cui>
        <rdfs:label xml:lang="en">Internet-Based Intervention</rdfs:label>
        <skos:definition xml:lang="en">Any program that uses the internet to alter, modify, or eliminate a behavior. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InternetGamingAddiction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InternetGamingAddiction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Addiction"/>
        <ncit2:synonym xml:lang="en">Video Game Addiction, Internet Gaming Disorder</ncit2:synonym>
        <umls3:cui xml:lang="en">C4760905</umls3:cui>
        <rdfs:label xml:lang="en">Internet Gaming Addiction</rdfs:label>
        <skos:definition xml:lang="en">The problematic, compulsive use of video games that results in significant impairment to an individual&apos;s ability to function in various life domains over a prolonged period of time. From Wikipedia</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InterpersonalCausativeFactor -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InterpersonalCausativeFactor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CausativeFactorOfEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:synonym xml:lang="en">Interpersonal Stressor</ncit2:synonym>
        <rdfs:comment xml:lang="en">Interpersonal factors that may cause emotional and mood disturbances in people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Interpersonal Causative Factor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InterpersonalPsychotherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InterpersonalPsychotherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Psychotherapy"/>
        <umls3:cui xml:lang="en">C0871787</umls3:cui>
        <rdfs:label xml:lang="en">Interpersonal Psychotherapy</rdfs:label>
        <skos:definition xml:lang="en">Interpersonal modification of psychodynamic psychotherapy. Therapy is present-focused and seeks to resolve problems in interpersonal relations. Aspects of attachment theory are used to analyze how past relationships affect current relationships. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Interpreter -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Interpreter">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isInterpreterOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareRecipient"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <umls3:cui xml:lang="en">C0150646</umls3:cui>
        <rdfs:label xml:lang="en">Interpreter</rdfs:label>
        <skos:definition xml:lang="en">Someone who mediates between speakers of different languages. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Intervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Intervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManagementActivityOfEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#hasOutcome"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManagementOutcomeOfEmotionalAndMoodDisturbanceInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#treats"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EmotionalAndMoodDisturbanceInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:synonym xml:lang="en">Interventional Procedure, Intervention Strategy</ncit2:synonym>
        <umls3:cui xml:lang="en">C0184661</umls3:cui>
        <rdfs:comment xml:lang="en">The actual treatments and actions that are performed to treat, or improve emotional and mood disturbances of a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CausativeFactorOfEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:comment xml:lang="en">The intrapersonal factors that may cause emotional and mood disturbances in people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Intrapersonal Causative Factor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntroducingSelfForPeopleWhoAreUnableToRememberName -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntroducingSelfForPeopleWhoAreUnableToRememberName">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionSuggested"/>
        <rdfs:comment xml:lang="en">People should introduce oneself for people with dementia who are unable to remember their names.</rdfs:comment>
        <rdfs:label xml:lang="en">Introducing Self for People Who are Unable to Remember Name</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Introversion -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Introversion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonalityTrait"/>
        <umls3:cui xml:lang="en">C0021924</umls3:cui>
        <rdfs:label xml:lang="en">Introversion</rdfs:label>
        <skos:definition xml:lang="en">People with introversion personality trait feel more comfortable focusing on their inner thoughts and ideas, rather than what&apos;s happening externally. From https://www.webmd.com/balance/introvert-personality-overview</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InvolvingCareRecipientInCarePlanning -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InvolvingCareRecipientInCarePlanning">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TreatmentPlanDevelopment"/>
        <ncit2:synonym xml:lang="en">Involving Resident in Planning Care</ncit2:synonym>
        <rdfs:comment xml:lang="en">The activity of involving the care recipient in care planning.</rdfs:comment>
        <rdfs:label xml:lang="en">Involving Care Recipient in Care Planning</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InvolvingLegalRepresentativeInCarePlanning -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InvolvingLegalRepresentativeInCarePlanning">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TreatmentPlanDevelopment"/>
        <rdfs:comment xml:lang="en">The activity of involving the representative of a care recipient in care planning.</rdfs:comment>
        <rdfs:label xml:lang="en">Involving Legal Representative in Care Planning</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Irritability -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Irritability">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EmotionalDistress"/>
        <ncit2:synonym xml:lang="en">Irritable Mood, Fussiness, Feeling Irritable</ncit2:synonym>
        <umls3:cui xml:lang="en">C0022107</umls3:cui>
        <rdfs:label xml:lang="en">Irritability</rdfs:label>
        <skos:definition xml:lang="en">Abnormal or excessive excitability with easily triggered anger, annoyance, or impatience. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ItchOfSkin -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ItchOfSkin">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SkinProblem"/>
        <ncit2:synonym xml:lang="en">Itch of Skin, Itching, Itchy, Pruritus of Skin, Pruritic Disorder, Pruritic Dermatitis, Scratching Skin, Pruritus</ncit2:synonym>
        <umls3:cui xml:lang="en">C0033774</umls3:cui>
        <rdfs:label xml:lang="en">Itch of Skin</rdfs:label>
        <skos:definition xml:lang="en">An irritating feeling that produces the desire to scratch. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#JapaneseGardenIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#JapaneseGardenIntervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HorticulturalTherapy"/>
        <rdfs:label xml:lang="en">Japanese Garden Intervention</rdfs:label>
        <skos:definition xml:lang="en">Japanese garden intervention is a nonpharmacological intervention that people with dementia stay in a Japanese garden twice a week for 15 minutes. From Goto et al. 2014 Differential responses of individuals with late-stage dementia to two novel environments: a multimedia room and an interior garden. Journal of Alzheimers Disease, 42:3</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#JokingExcessively -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#JokingExcessively">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfEuphoriaInDementia"/>
        <rdfs:comment xml:lang="en">Telling inappropriate jokes excessively</rdfs:comment>
        <rdfs:label xml:lang="en">Joking Excessively</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Kicking -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Kicking">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyAggressiveBehaviour"/>
        <umls3:cui xml:lang="en">C2371406</umls3:cui>
        <rdfs:comment xml:lang="en">The behaviour of hitting or striking someone or something with the foot.</rdfs:comment>
        <rdfs:label xml:lang="en">Kicking</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Kitchen -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Kitchen">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LocationOfManifestationOfEmotionalAndMoodDisturbance"/>
        <umls3:cui xml:lang="en">C0557653</umls3:cui>
        <rdfs:label xml:lang="en">Kitchen</rdfs:label>
        <skos:definition xml:lang="en">A room or part of a room used for cooking and food preparation. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#KnittingAcitivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#KnittingAcitivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <umls3:cui xml:lang="en">C0868977</umls3:cui>
        <rdfs:comment xml:lang="en">The activity that yarn is manipulated to create a textile or fabric.</rdfs:comment>
        <rdfs:label xml:lang="en">Knitting Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#KnittingHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#KnittingHobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hobby"/>
        <rdfs:comment xml:lang="en">Hobby of knitting.</rdfs:comment>
        <rdfs:label xml:lang="en">Knitting Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#KurzSkalaStimmungAktivierung -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#KurzSkalaStimmungAktivierung">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">KUSTA</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">KurzSkala Stimmung/Aktivierung Rating Scale</ncit2:synonym>
        <rdfs:label xml:lang="en">KurzSkala Stimmung/Aktivierung</rdfs:label>
        <skos:definition xml:lang="en">KUSTA (Kurz-Skala Stimmung/Aktivierung) is a daily self-rating scale for depressive patients. From Wendt G, Binz U, Müller AA. KUSTA (Kurz-Skala Stimmung/Aktivierung): a daily self-rating scale for depressive patients. Pharmacopsychiatry. 1985 Jan;18(1):118-22. doi: 10.1055/s-2007-1017337. PMID: 3991800.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LGBTQ -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LGBTQ">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SexualOrientation"/>
        <rdfs:comment xml:lang="en">LGBTQ is an initialism that stands for lesbian, gay, bisexual, transgender, and queer.</rdfs:comment>
        <rdfs:label xml:lang="en">LGBTQ</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LackOfCommunication -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LackOfCommunication">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <umls3:cui xml:lang="en">C1845268</umls3:cui>
        <rdfs:comment xml:lang="en">The lack of communication of a person with others.</rdfs:comment>
        <rdfs:label xml:lang="en">Lack of Communication</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LackOfConcern -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LackOfConcern">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfApathyInDementia"/>
        <ncit2:synonym xml:lang="en">Diminished Concern</ncit2:synonym>
        <rdfs:comment xml:lang="en">A person is lack of caring in different aspects of life events.</rdfs:comment>
        <rdfs:label xml:lang="en">Lack of Concern</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LackOfFeelingEmotion -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LackOfFeelingEmotion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfApathyInDementia"/>
        <ncit2:synonym xml:lang="en">Reduced emotional reactivity, Less Emotional, Emotional Blunting</ncit2:synonym>
        <umls3:cui xml:lang="en">C3160924</umls3:cui>
        <rdfs:comment xml:lang="en">The lack of emotional reactivity.</rdfs:comment>
        <rdfs:label xml:lang="en">Lack of Feeling Emotion</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LackOfKnowledgeOfDementiaCare -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LackOfKnowledgeOfDementiaCare">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InterpersonalCausativeFactor"/>
        <rdfs:comment xml:lang="en">Health care professional may be lacking in knowledge about dementia care.</rdfs:comment>
        <rdfs:label xml:lang="en">Lack of Knowledge of Dementia Care</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LackOfPleasurableActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LackOfPleasurableActivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialEnvironmentCausativeFactor"/>
        <rdfs:comment xml:lang="en">The lack of activities that are pleasurable and enjoyable for people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Lack of Pleasurable Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LackOfPredictableDailyRoutine -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LackOfPredictableDailyRoutine">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialEnvironmentCausativeFactor"/>
        <rdfs:comment xml:lang="en">The lack of daily routine that can be predicted by people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Lack of Predictable Daily Routine</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LackOfPrivacy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LackOfPrivacy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialEnvironmentCausativeFactor"/>
        <ncit2:synonym xml:lang="en">Actual Lack of Privacy</ncit2:synonym>
        <umls3:cui xml:lang="en">C2712041</umls3:cui>
        <rdfs:comment xml:lang="en">The state of being not free from intrusion or disturbance in one&apos;s daily life.</rdfs:comment>
        <rdfs:label xml:lang="en">Lack of Privacy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LackOfSpatialAwareness -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LackOfSpatialAwareness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveImpairment"/>
        <rdfs:comment xml:lang="en">A person may have a deficit in spatial awareness, such as difficulties pinpointing the location of something they see, hear, or feel.</rdfs:comment>
        <rdfs:label xml:lang="en">Lack of Spatial Awareness</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LackOfSpontaneity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LackOfSpontaneity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfApathyInDementia"/>
        <umls3:cui xml:lang="en">C1822592</umls3:cui>
        <rdfs:comment xml:lang="en">The decreased spontaneous action. For instance, an apathetic person will eat or drink if food is supplied but may make little effort to prepare food spontaneously.</rdfs:comment>
        <rdfs:label xml:lang="en">Lack of Spontaneity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LackOfVisualCueInEnvironment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LackOfVisualCueInEnvironment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#UnderstimulationOfVisionSense"/>
        <rdfs:comment xml:lang="en">The lack of visual signs/signals in the environment for serving people.</rdfs:comment>
        <rdfs:label xml:lang="en">Lack of Visual Cue in Environment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LanguageInformation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LanguageInformation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DemographicInformation"/>
        <rdfs:comment xml:lang="en">Information about languages used by a person and if he/she needs an interpreter to communicate with others.</rdfs:comment>
        <rdfs:label xml:lang="en">Language Information</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LatexAllergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LatexAllergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Allergy"/>
        <ncit2:synonym xml:lang="en">Natural Rubber Latex Allergy,  Rubber Latex Allergy, Allergy to Rubber</ncit2:synonym>
        <umls3:cui xml:lang="en">C0577628</umls3:cui>
        <rdfs:label xml:lang="en">Latex Allergy</rdfs:label>
        <skos:definition xml:lang="en">A latex allergy is an allergic reaction to natural rubber latex. Natural rubber latex gloves, balloons, condoms and other natural rubber products contain latex. An allergy to latex can be a serious health risk. From Asthma and Allergy Foundation of America https://www.aafa.org/types-of-allergies/</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LaughingExcessively -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LaughingExcessively">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfEuphoriaInDementia"/>
        <ncit2:synonym xml:lang="en">Excessive Laughing</ncit2:synonym>
        <umls3:cui xml:lang="en">C2215618</umls3:cui>
        <rdfs:comment xml:lang="en">Expressively show happy emotions</rdfs:comment>
        <rdfs:label xml:lang="en">Laughing Excessively</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LaundryRoom -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LaundryRoom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LocationOfManifestationOfEmotionalAndMoodDisturbance"/>
        <rdfs:comment xml:lang="en">A room where clothes, sheets, and towels are washed and dried.</rdfs:comment>
        <rdfs:label xml:lang="en">Laundry Room</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LegalRepresentative -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LegalRepresentative">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isLegalRepresentativeOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareRecipient"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Legal Representative</rdfs:label>
        <skos:definition xml:lang="en">An individual who is designated to act on behalf of persons who are considered incapable of acting in their own behalf. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LegoActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LegoActivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <ncit2:synonym xml:lang="en">Lego Therapy</ncit2:synonym>
        <rdfs:comment xml:lang="en">The activities of using lego building blocks.</rdfs:comment>
        <rdfs:label xml:lang="en">Lego Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Lesbian -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Lesbian">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LGBTQ"/>
        <ncit2:synonym xml:lang="en">Homosexual Female</ncit2:synonym>
        <umls3:cui xml:lang="en">C1533642</umls3:cui>
        <rdfs:label xml:lang="en">Lesbian</rdfs:label>
        <skos:definition xml:lang="en">A woman whose physical, emotional, or romantic attraction is to other women. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LessAttentionToSurroundingEnvironment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LessAttentionToSurroundingEnvironment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfApathyInDementia"/>
        <rdfs:comment xml:lang="en">Pay less attention to one&apos;s surrounding environment</rdfs:comment>
        <rdfs:label xml:lang="en">Less Attention to Surrounding Environment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LessLikelyToEngageInConversation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LessLikelyToEngageInConversation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfMotivation"/>
        <rdfs:comment xml:lang="en">Less Likely to engage in a conversation with someone</rdfs:comment>
        <rdfs:label xml:lang="en">Less Likely to Engage in Conversation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LessLikelyToInitiateConversation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LessLikelyToInitiateConversation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ReducedInitiation"/>
        <rdfs:comment xml:lang="en">Less Likely to start having a onversation with someone</rdfs:comment>
        <rdfs:label xml:lang="en">Less Likely to Initiate Conversation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LiaisingWithLegalRepresentative -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LiaisingWithLegalRepresentative">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <rdfs:comment xml:lang="en">The act of cooperating with the legal representative of a person with dementia on a matter of mutual concern.</rdfs:comment>
        <rdfs:label xml:lang="en">Liaising with Legal Representative</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LiaisingWithMedicalPractitioner -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LiaisingWithMedicalPractitioner">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Liaising with Physician</ncit2:synonym>
        <umls3:cui xml:lang="en">C4041416</umls3:cui>
        <rdfs:comment xml:lang="en">The act of cooperating with the medical practitioner of a person with dementia on a matter of mutual concern.</rdfs:comment>
        <rdfs:label xml:lang="en">Liaising with Medical Practitioner</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LiaisingWithPharmacist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LiaisingWithPharmacist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <umls3:cui xml:lang="en">C4041532</umls3:cui>
        <rdfs:comment xml:lang="en">The act of cooperating with the pharmacist of a person with dementia on a matter of mutual concern.</rdfs:comment>
        <rdfs:label xml:lang="en">Liaising with Pharmacist</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LiasingWithRelative -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LiasingWithRelative">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <umls3:cui xml:lang="en">C1279781</umls3:cui>
        <rdfs:comment xml:lang="en">The act of cooperating with relatives of a person with dementia on a matter of mutual concern.</rdfs:comment>
        <rdfs:label xml:lang="en">Liaising with Relative</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LifeStyle -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LifeStyle">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient"/>
        <ncit2:synonym xml:lang="en">Lifestyle, Life Pattern</ncit2:synonym>
        <umls3:cui xml:lang="en">C0023676</umls3:cui>
        <rdfs:label xml:lang="en">Life Style</rdfs:label>
        <skos:definition xml:lang="en">Typical way of life or manner of living characteristic of an individual or group. From APA, Thesaurus of Psychological Index Terms, 8th ed</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LightTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LightTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SensoryStimulationTherapy"/>
        <ncit2:abbreviation xml:lang="en">BLT</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Phototherapy, Photoradiation Therapy, Illumination Therapy</ncit2:synonym>
        <umls3:cui xml:lang="en">C0031765</umls3:cui>
        <rdfs:label xml:lang="en">Light Therapy</rdfs:label>
        <skos:definition xml:lang="en">Treatment of disease by exposure to light, especially by various concentrated light rays or specific wavelengths. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LilleApathyRatingScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LilleApathyRatingScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#assesses"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApathyInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:abbreviation xml:lang="en">LARS</ncit2:abbreviation>
        <rdfs:label xml:lang="en">Lille Apathy Rating Scale</rdfs:label>
        <skos:definition xml:lang="en">The Lille Apathy Rating Scale (LARS) is based on a structured interview. It includes 33 items, divided into nine domains. Responses are scored on a dichotomous scale. The participants used to validate the scale consisted of 159 patients with probable Parkinson&apos;s disease and 58 healthy control subjects. From Sockeel, P et al. “The Lille apathy rating scale (LARS), a new instrument for detecting and quantifying apathy: validation in Parkinson&apos;s disease.” Journal of neurology, neurosurgery, and psychiatry vol. 77,5 (2006): 579-84. doi:10.1136/jnnp.2005.075929</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ListeningToAudiobook -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ListeningToAudiobook">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <ncit2:synonym xml:lang="en">Talking Book Activity</ncit2:synonym>
        <rdfs:comment xml:lang="en">The activity of listening to an audiobook or a talking book.</rdfs:comment>
        <rdfs:label xml:lang="en">Listening to Audiobook</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ListeningToClassicalMusic -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ListeningToClassicalMusic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PassiveMusicTherapy"/>
        <rdfs:comment xml:lang="en">The intervention of listening to the classical music, such as music composed by Beethoven, Bach and Mozart.</rdfs:comment>
        <rdfs:label xml:lang="en">Listening to Classical Music</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ListeningToFamiliarMusic -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ListeningToFamiliarMusic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PassiveMusicTherapy"/>
        <rdfs:comment xml:lang="en">The intervention of listening to the music that is familiar to a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Listening to Familiar Music</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ListeningToPreferredMusic -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ListeningToPreferredMusic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PassiveMusicTherapy"/>
        <rdfs:comment xml:lang="en">The intervention of listening to the personal perferred music, e.g., folk songs from childhood.</rdfs:comment>
        <rdfs:label xml:lang="en">Listening to Preferred Music</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ListeningToRadio -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ListeningToRadio">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">The activity of listening to the radio.</rdfs:comment>
        <rdfs:label xml:lang="en">Listening to Radio</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ListeningToRadioHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ListeningToRadioHobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hobby"/>
        <rdfs:comment xml:lang="en">Hobby of listening to the radio.</rdfs:comment>
        <rdfs:label xml:lang="en">Listening to Radio Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ListeningToRelaxingMusic -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ListeningToRelaxingMusic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PassiveMusicTherapy"/>
        <rdfs:comment xml:lang="en">The intervention of listening to relaxing music.</rdfs:comment>
        <rdfs:label xml:lang="en">Listening to Relaxing Music</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LocationOfManifestationOfEmotionalAndMoodDisturbance -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LocationOfManifestationOfEmotionalAndMoodDisturbance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FeatureOfManifestationOfEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isLocationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfEmotionalAndMoodDisturbanceInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The location (place) of manifestation of emotional and mood disturbances.</rdfs:comment>
        <rdfs:label xml:lang="en">Location of Manifestation of Emotional and Mood Disturbance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LockingUpMedicationWhenNotInUse -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LockingUpMedicationWhenNotInUse">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithMedicationManagement"/>
        <rdfs:comment xml:lang="en">Medications that are not in use should be locked up to provent the medication misuse.</rdfs:comment>
        <rdfs:label xml:lang="en">Locking Up Medication When not in Use</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Loneliness -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Loneliness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <ncit2:synonym xml:lang="en">Feeling Lonely</ncit2:synonym>
        <umls3:cui xml:lang="en">C0023974</umls3:cui>
        <rdfs:comment xml:lang="en">Feeling sad and unhappy as a result of lack of companionship or being separated from others.</rdfs:comment>
        <rdfs:label xml:lang="en">Loneliness</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LongPeriodOfInactivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LongPeriodOfInactivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <rdfs:comment xml:lang="en">A person may do not move his/her body for long periods of time.</rdfs:comment>
        <rdfs:label xml:lang="en">Long Period of Inactivity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfDignity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfDignity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <ncit2:synonym xml:lang="en">Dignity Loss</ncit2:synonym>
        <rdfs:comment xml:lang="en">Losing the capability for self-determination, sensing hopelessness and worthlessness in a shroud of illness, and being situated in surroundings that enhanced their sense of disconnection. From Jinnan Xiao, Marques S. N. Ng, Tingting Yan, Ka Ming Chow, Carmen W. H. Chan. (2021) How patients with cancer experience dignity: An integrative review. Psycho-Oncology 30:8, pages 1220-1231.</rdfs:comment>
        <rdfs:label xml:lang="en">Loss of Dignity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfEnergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfEnergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfDepressionInDementia"/>
        <ncit2:synonym xml:lang="en">Fatigue, Tiredness, Weariness, Lacking in Energy, Tired Out</ncit2:synonym>
        <umls3:cui xml:lang="en">C0015672</umls3:cui>
        <rdfs:label xml:lang="en">Loss of Energy</rdfs:label>
        <skos:definition xml:lang="en">The state of weariness following a period of exertion, mental or physical, characterized by a decreased capacity for work and reduced efficiency to respond to stimuli. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfIndependence -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfIndependence">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <ncit2:synonym xml:lang="en">Independence Loss</ncit2:synonym>
        <umls3:cui xml:lang="en">C0946204</umls3:cui>
        <rdfs:comment xml:lang="en">The loss of independence of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Loss of Independence</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfInterest -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfInterest">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfDepressionInDementia"/>
        <ncit2:synonym xml:lang="en">Diminished Interest, Lack of Interest, Decreased Interest, Disinterest, Be disinterested in</ncit2:synonym>
        <umls3:cui xml:lang="en">C0424091</umls3:cui>
        <rdfs:comment xml:lang="en">The loss of the feeling of wanting to know or learn about something or someone.</rdfs:comment>
        <rdfs:label xml:lang="en">Loss of Interest</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfInterestInEatingFood -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfInterestInEatingFood">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfInterest"/>
        <rdfs:comment xml:lang="en">The loss of interest in eating food.</rdfs:comment>
        <rdfs:label xml:lang="en">Loss of Interest in Eating Food</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfInterestInFamily -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfInterestInFamily">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfInterest"/>
        <rdfs:comment xml:lang="en">The loss of feeling of want to know and pay attention to one&apos;s own family.</rdfs:comment>
        <rdfs:label xml:lang="en">Loss of Interest in Family</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfInterestInFriend -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfInterestInFriend">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfInterest"/>
        <rdfs:comment xml:lang="en">The loss of feeling of want to know and pay attention to one&apos;s own friends.</rdfs:comment>
        <rdfs:label xml:lang="en">Loss of Interest in Friend</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfInterestInPreviouslyEnjoyableActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfInterestInPreviouslyEnjoyableActivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfInterest"/>
        <umls3:cui xml:lang="en">C1562291</umls3:cui>
        <rdfs:comment xml:lang="en">The loss of interest in previously enjoyable activities.</rdfs:comment>
        <rdfs:label xml:lang="en">Loss of Interest in Previously Enjoyable Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfLibido -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfLibido">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfDepressionInDementia"/>
        <ncit2:synonym xml:lang="en">Loss of Sex Drive, Diminishing Sexual Interest, Loss of Sexual Desire</ncit2:synonym>
        <umls3:cui xml:lang="en">C2981158</umls3:cui>
        <rdfs:comment xml:lang="en">Loss of sex drive</rdfs:comment>
        <rdfs:label xml:lang="en">Loss of Libido</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfMotivation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfMotivation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfApathyInDementia"/>
        <ncit2:synonym xml:lang="en">Lack of Motivation, Diminished Motivation, Reduction of Goal Directed Behaviour</ncit2:synonym>
        <umls3:cui xml:lang="en">C0456814</umls3:cui>
        <rdfs:label xml:lang="en">Loss of Motivation</rdfs:label>
        <skos:definition xml:lang="en">A reduction in goal-directed behavior, that is, motivation, the determinant of behavior and adaptation that allows individuals to get started, be energized to perform a sustained and directed action. From HPO: probinson, PMID: 16030444</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfPleasure -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfPleasure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfDepressionInDementia"/>
        <umls3:cui xml:lang="en">C2185938</umls3:cui>
        <rdfs:comment xml:lang="en">The loss of the happy feeling.</rdfs:comment>
        <rdfs:label xml:lang="en">Loss of Pleasure</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfPleasureFromUsuallyPleasuableActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfPleasureFromUsuallyPleasuableActivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfPleasure"/>
        <umls3:cui xml:lang="en">C4295455</umls3:cui>
        <rdfs:comment xml:lang="en">The loss of positive affect or pleasure in response to usually pleasurable activities.</rdfs:comment>
        <rdfs:label xml:lang="en">Loss of Pleasure from Usually Pleasuable Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfSelfEsteem -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LossOfSelfEsteem">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfDepressionInDementia"/>
        <ncit2:synonym xml:lang="en">Lack of Self-Esteem, Low Self-Esteem</ncit2:synonym>
        <umls3:cui xml:lang="en">C0424219</umls3:cui>
        <rdfs:comment xml:lang="en">Loss of self-esteem is when an individual lacks confidence about who he/she is and what he/she can do.</rdfs:comment>
        <rdfs:label xml:lang="en">Loss of Self-Esteem</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LoungeRoom -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LoungeRoom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LocationOfManifestationOfEmotionalAndMoodDisturbance"/>
        <ncit2:synonym xml:lang="en">Lounge, Lounge Environment, Lounge Area</ncit2:synonym>
        <umls3:cui xml:lang="en">C0557644</umls3:cui>
        <rdfs:comment xml:lang="en">A room or area in the long-term care facility for general everyday use</rdfs:comment>
        <rdfs:label xml:lang="en">Lounge Room</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LunchTime -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LunchTime">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Time"/>
        <ncit2:synonym xml:lang="en">Midday Meal Time</ncit2:synonym>
        <umls3:cui xml:lang="en">C0585039</umls3:cui>
        <rdfs:comment xml:lang="en">The time of people having midday meal.</rdfs:comment>
        <rdfs:label xml:lang="en">Lunch Time</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MakingBed -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MakingBed">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Making Patient Bed</ncit2:synonym>
        <umls3:cui xml:lang="en">C0204676</umls3:cui>
        <rdfs:comment xml:lang="en">The intervention of making one&apos;s bed by pulling up and tidying the covers on a bed.</rdfs:comment>
        <rdfs:label xml:lang="en">Making Bed</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MakingBizarreNoise -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MakingBizarreNoise">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyNonaggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The behaviour of making very strange or unusual noise.</rdfs:comment>
        <rdfs:label xml:lang="en">Making Bizarre Noise</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MakingBuzzerEasyToReach -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MakingBuzzerEasyToReach">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentalIntervention"/>
        <ncit2:synonym xml:lang="en">Making Pager Easy to Reach</ncit2:synonym>
        <rdfs:comment xml:lang="en">The intervention of making the buzzer easy to reach.</rdfs:comment>
        <rdfs:label xml:lang="en">Making Buzzer Easy to Reach</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MakingExitLessObvious -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MakingExitLessObvious">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentalIntervention"/>
        <rdfs:comment xml:lang="en">Make exists less obvious to reduce the risk that a person with dementia may wander away from the facility</rdfs:comment>
        <rdfs:label xml:lang="en">Making Exit Less Obvious</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Male -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Male">
