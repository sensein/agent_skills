        <rdfs:comment xml:lang="en">Female gender of a person assigned biologically at birth.</rdfs:comment>
        <rdfs:label xml:lang="en">Female</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FestivalPreference -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FestivalPreference">
