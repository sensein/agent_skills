        <ncit2:synonym xml:lang="en">History of Taking Prescription Drug</ncit2:synonym>
        <rdfs:comment xml:lang="en">A person&apos;s history information about what prescription drugs taken.</rdfs:comment>
        <rdfs:label xml:lang="en">History of Taking Prescription Medication</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hitting -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hitting">
