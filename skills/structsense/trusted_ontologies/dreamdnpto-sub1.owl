     xmlns:umls="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DRMDNPTO#umls:"
     xmlns:ncit1="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREMDNPTO#ncit:"
     xmlns:ncit2="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ncit:"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:umls2="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREMDNPTO#umls:"
     xmlns:umls3="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#umls:">
    <owl:Ontology rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO">
        <terms:creator xml:lang="en">Zhenyu Zhang</terms:creator>
        <terms:date xml:lang="en">01/06/2022</terms:date>
        <terms:license xml:lang="en">This ontology is licensed under CC BY-NC-SA International 4.0 https://creativecommons.org/license/by-nc-sa/4.0/</terms:license>
        <terms:title xml:lang="en">Dementia-Related Emotional And Mood Disturbance Non-Pharmacological Treatment Ontology (DREAMDNPTO)</terms:title>
        <rdfs:comment xml:lang="en">This ontology represents the domain knowledge specific to non-pharmacological treatment of emotional and mood disturbances (including depression, apathy, anxiety, and euphoria in dementia) in people with dementia living in the long-term care setting.</rdfs:comment>
        <owl:versionInfo xml:lang="en">v1.0</owl:versionInfo>
        <skos:note xml:lang="en">This version contains all concepts and their relationships extracted from selected articles; contains classes adopted from psychotic symptom ontoloyg; has passed the reasoner and OOPS! evaluation; contains concepts from 1000 health records of people with dementia; and additional 100 health records for assessing the concept(term) saturation; contains concepts from domain experts. It has passed the domain expert evaluation.</skos:note>
    </owl:Ontology>
    


