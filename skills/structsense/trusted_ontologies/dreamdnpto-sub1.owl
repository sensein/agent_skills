        <rdfs:label xml:lang="en">Ability to Identify Time</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AbilityToMakeDecision -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AbilityToMakeDecision">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveAbility"/>
        <ncit2:synonym xml:lang="en">Ability to Make Decisions, Decision-Making Ability</ncit2:synonym>
        <umls3:cui xml:lang="en">C1531797</umls3:cui>
        <rdfs:comment xml:lang="en">Mental capacity of making decisions for oneself.</rdfs:comment>
        <rdfs:label xml:lang="en">Ability to Make Decision</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AbilityToMobilise -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AbilityToMobilise">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalAbility"/>
        <ncit2:synonym xml:lang="en">Mobility Ability, Ability to Mobilize</ncit2:synonym>
        <umls3:cui xml:lang="en">C0578131</umls3:cui>
        <rdfs:comment xml:lang="en">Ability to move freely and easily.</rdfs:comment>
        <rdfs:label xml:lang="en">Ability to Mobilise</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AbilityToPerformActivityOfDailyLiving -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AbilityToPerformActivityOfDailyLiving">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RemainingAbility"/>
        <ncit2:synonym xml:lang="en">Ability to Perform Activities of Daily Life, Ability to Perform Activity of Daily Life</ncit2:synonym>
        <umls3:cui xml:lang="en">C0562507</umls3:cui>
        <rdfs:label xml:lang="en">Ability to Perform Activity of Daily Living</rdfs:label>
        <skos:definition xml:lang="en">Ability to perform the most basic physical tasks and personal care activities independently with or without assistive device. From Nursing Outcomes Classification</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AbilityToReason -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AbilityToReason">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveAbility"/>
        <umls3:cui xml:lang="en">C0582550</umls3:cui>
        <rdfs:comment xml:lang="en">The ability to think, understand, and form judgements logically</rdfs:comment>
        <rdfs:label xml:lang="en">Ability to Reason</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AbilityToTrustSomeone -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AbilityToTrustSomeone">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonalityTrait"/>
        <rdfs:comment xml:lang="en">The ability to placing confidence in someone.</rdfs:comment>
        <rdfs:label xml:lang="en">Ability to Trust Someone</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AboriginalPerson -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AboriginalPerson">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DemographicInformation"/>
        <ncit2:synonym xml:lang="en">Aboriginal</ncit2:synonym>
        <umls3:cui xml:lang="en">C0935542</umls3:cui>
        <rdfs:comment xml:lang="en">Information about a person that if he/she is aboriginal.</rdfs:comment>
        <rdfs:label xml:lang="en">Aboriginal Person</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Absconding -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Absconding">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyNonaggressiveBehaviour"/>
        <ncit2:synonym xml:lang="en">Running Away, Wandering Off the Facility</ncit2:synonym>
        <umls3:cui xml:lang="en">C0424352</umls3:cui>
        <rdfs:comment xml:lang="en">The behaviour of a care recipient leaving secretly from the long-term care facility which he/she lives.</rdfs:comment>
        <rdfs:label xml:lang="en">Absconding</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AbsenceOfEmotionalAndMoodDisturbanceRelevantSymptom -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AbsenceOfEmotionalAndMoodDisturbanceRelevantSymptom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareGoalForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:synonym xml:lang="en">Free of Emotional and Mood Disturbance Relevant Symptom</ncit2:synonym>
        <rdfs:comment xml:lang="en">Clinically relevant symptoms of emotional and mood disturbances have been absented for a sustained period and treatment can be discontinued.</rdfs:comment>
        <rdfs:label xml:lang="en">Absence of Emotional and Mood Disturbance Relevant Symptom</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AcceptanceOfSupport -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AcceptanceOfSupport">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonalityTrait"/>
        <rdfs:comment xml:lang="en">Acceptance of support provided to a person</rdfs:comment>
        <rdfs:label xml:lang="en">Acceptance of Support</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ActiveListening -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ActiveListening">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionSuggested"/>
        <umls3:cui xml:lang="en">C0150122</umls3:cui>
        <rdfs:label xml:lang="en">Active Listening</rdfs:label>
        <skos:definition xml:lang="en">Attending closely to and attaching significance to a patient&apos;s verbal and nonverbal messages. From Nursing Interventions Classification</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ActiveMusicTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ActiveMusicTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MusicTherapy"/>
        <ncit2:synonym xml:lang="en">Expressive Music Therapy</ncit2:synonym>
        <rdfs:label xml:lang="en">Active Music Therapy</rdfs:label>
        <skos:definition xml:lang="en">Active music therapy requires the person to being an active contributor and participate in playing musical instruments or singing with the music.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ActivitiesOfDailyLivingImpairment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ActivitiesOfDailyLivingImpairment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:synonym xml:lang="en">Impaired Activities of Daily Living, Impaired Activities of Daily Life</ncit2:synonym>
        <umls3:cui xml:lang="en">C0740765</umls3:cui>
        <rdfs:comment xml:lang="en">The impaired activities of daily living of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Activities of Daily Living Impairment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Acupressure -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Acupressure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MassageTherapy"/>
        <umls3:cui xml:lang="en">C0282614</umls3:cui>
        <rdfs:label xml:lang="en">Acupressure</rdfs:label>
        <skos:definition xml:lang="en">A type of massage in which finger pressure on specific body sites is used to promote healing, relieve fatigue, etc. Although the anatomical locations are the same as the acupuncture points used in acupuncture therapy, no needle or other acupuncture technique is employed in acupressure. From Random House Unabridged Dictionary, 2d ed</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AcuteMyocardialInfarction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AcuteMyocardialInfarction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:abbreviation xml:lang="en">AMI</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Acute MI</ncit2:synonym>
        <umls3:cui xml:lang="en">C0155626</umls3:cui>
        <rdfs:label xml:lang="en">Acute Myocardial Infarction</rdfs:label>
        <skos:definition xml:lang="en">Necrosis of the myocardium, as a result of interruption of the blood supply to the area. It is characterized by a severe and rapid onset of symptoms that may include chest pain, often radiating to the left arm and left side of the neck, dyspnea, sweating, and palpitations. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Addiction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Addiction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalHistory"/>
        <ncit2:synonym xml:lang="en">Addictive Disorder</ncit2:synonym>
        <rdfs:label xml:lang="en">Addiction</rdfs:label>
        <skos:definition xml:lang="en">Addiction is a complex condition, a brain disease that is manifested by compulsive substance use despite harmful consequence. People with addiction (severe substane use disorder) have an intense focus on using a certain substance(s), such as alcohol or drugs, to the point that it takes over their life. From American Psychiatric Association</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AdministrationOfMedication -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AdministrationOfMedication">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Giving Medication, Administering Medication, Drug Administration</ncit2:synonym>
        <umls3:cui xml:lang="en">C3469597</umls3:cui>
        <rdfs:label xml:lang="en">Administration of Medication</rdfs:label>
        <skos:definition xml:lang="en">The administration of a drug to a patient. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AdmissionToLongTermCareFacility -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AdmissionToLongTermCareFacility">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EnvironmentalCausativeFactor"/>
        <ncit2:synonym xml:lang="en">Admit to Nursing Home</ncit2:synonym>
        <umls3:cui xml:lang="en">C1658399</umls3:cui>
        <rdfs:comment xml:lang="en">Moving to a long term care facility</rdfs:comment>
        <rdfs:label xml:lang="en">Admission to Long Term Care Facility</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AerobicExercise -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AerobicExercise">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalExerciseTherapy"/>
        <ncit2:synonym xml:lang="en">Aerobic Activity, Aerobics</ncit2:synonym>
        <umls3:cui xml:lang="en">C0001701</umls3:cui>
        <rdfs:label xml:lang="en">Aerobic Exercise</rdfs:label>
        <skos:definition xml:lang="en">Sustained exercise that places an increased oxygen demand on the cardiovascular system and promotes an increased efficiency of the body&apos;s use of oxygen. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AffectingTimingOfCareDeliveryToOtherCareRecipient -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AffectingTimingOfCareDeliveryToOtherCareRecipient">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnOtherCareRecipient"/>
        <ncit2:synonym xml:lang="en">Affecting Timing of Care Delivery to Other Resident</ncit2:synonym>
        <rdfs:comment xml:lang="en">Emotional and mood disturbances of person with dementia might affect the timing of care delivery to other people living in the long-term care facility.</rdfs:comment>
        <rdfs:label xml:lang="en">Affecting Timing of Care Delivery to Other Care Recipient</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AfterBreakfast -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AfterBreakfast">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Time"/>
        <umls3:cui xml:lang="en">C1550743</umls3:cui>
        <rdfs:comment xml:lang="en">The time after breakfast.</rdfs:comment>
        <rdfs:label xml:lang="en">After Breakfast</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AfterDinner -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AfterDinner">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Time"/>
        <ncit2:synonym xml:lang="en">After Supper</ncit2:synonym>
        <umls3:cui xml:lang="en">C1879671</umls3:cui>
        <rdfs:label xml:lang="en">After Dinner</rdfs:label>
        <skos:definition xml:lang="en">After supper or evening meal. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AfterHandoverTime -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AfterHandoverTime">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Time"/>
        <rdfs:comment xml:lang="en">The time after handover.</rdfs:comment>
        <rdfs:label xml:lang="en">After Handover Time</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AfterLunch -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AfterLunch">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Time"/>
        <umls3:cui xml:lang="en">C1879668</umls3:cui>
        <rdfs:label xml:lang="en">After Lunch</rdfs:label>
        <skos:definition xml:lang="en">After lunch. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Afternoon -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Afternoon">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Time"/>
        <umls3:cui xml:lang="en">C0439550</umls3:cui>
        <rdfs:label xml:lang="en">Afternoon</rdfs:label>
        <skos:definition xml:lang="en">The time period between noon and sunset. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Age -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Age">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DemographicInformation"/>
        <umls3:cui xml:lang="en">C0001779</umls3:cui>
        <rdfs:comment xml:lang="en">Age of a person - the time elapsed since birth.</rdfs:comment>
        <rdfs:label xml:lang="en">Age</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Agitation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Agitation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnSelf"/>
        <ncit2:synonym xml:lang="en">Agitation or Aggression in Dementia, Agitated Behavior, Feeling Agitated, Being Agitated</ncit2:synonym>
        <umls3:cui xml:lang="en">C0085631</umls3:cui>
        <rdfs:label xml:lang="en">Agitation</rdfs:label>
        <skos:definition xml:lang="en">Agitated behaviour is defined as any inappropriate physical or verbal, aggressive or non-aggressive, act that is not an obvious expression of need or disorientation. From Cohen-Mansfield, Libin and Marx 2007</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AlcoholAddiction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AlcoholAddiction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Addiction"/>
        <ncit2:synonym xml:lang="en">Alcohol Problem Drinking, Alcohol Dependence</ncit2:synonym>
        <umls3:cui xml:lang="en">C0001973</umls3:cui>
        <rdfs:label xml:lang="en">Alcohol Addiction</rdfs:label>
        <skos:definition xml:lang="en">An addictive behavior defined as drinking excessive amounts of alcohol over a long period of time, having difficulty reducing the amount of alcohol consumed, strongly desiring alcohol and experiencing withdrawal symptoms when not drinking alcohol. From Human Phenotype Ontology</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Allergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Allergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalHistory"/>
        <ncit2:synonym xml:lang="en">Hypersensitivity, Hypersensitivity Reaction</ncit2:synonym>
        <umls3:cui xml:lang="en">C0020517</umls3:cui>
        <rdfs:label xml:lang="en">Allergy</rdfs:label>
        <skos:definition xml:lang="en">An allergy is an immune response or reaction to substances that are usually not harmful. From Human Phenotype Ontology</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AllowingEnoughTimeForResponding -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AllowingEnoughTimeForResponding">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionSuggested"/>
        <ncit2:synonym xml:lang="en">Giving Person Adequate Time to Respond</ncit2:synonym>
        <rdfs:comment xml:lang="en">People should allow enough time for the person to respond during communication.</rdfs:comment>
        <rdfs:label xml:lang="en">Allowing Enough Time for Responding</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AlzheimerDiseaseDementiaMixedTypeWithCerebrovascularDisease -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AlzheimerDiseaseDementiaMixedTypeWithCerebrovascularDisease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToAlzheimerDisease"/>
        <ncit2:synonym xml:lang="en">Mixed Vascular Alzheimer Dementia</ncit2:synonym>
        <umls3:cui xml:lang="en">C3532942</umls3:cui>
        <rdfs:label xml:lang="en">Alzheimer Disease Dementia Mixed Type with Cerebrovascular Disease</rdfs:label>
        <skos:definition xml:lang="en">Dementia due to Alzheimer disease and concomitant cerebrovascular disease. From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AlzheimersDiseaseRelatedDisordersMoodScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AlzheimersDiseaseRelatedDisordersMoodScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">AD-RD Mood Scale</ncit2:abbreviation>
        <rdfs:label xml:lang="en">Alzheimer&apos;s Disease and Related Dementia Mood Scale</rdfs:label>
        <skos:definition xml:lang="en">The AD-RD Mood Scale is a measure of both positive and negative moods in individuals aged 55 years or older with mild to severe AD-RD. It contains 34 items in two positive subscales (spirited and contented) and three negative subscales (hostile, apathetic, and sad). From Tappen RM, Williams CL. Development and testing of the Alzheimer&apos;s Disease and Related Dementias Mood Scale. Nurs Res. 2008 Nov-Dec;57(6):426-35. doi: 10.1097/NNR.0b013e31818c3dcc. PMID: 19018217; PMCID: PMC2667280.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Amnesia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Amnesia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MemoryImpairment"/>
        <ncit2:synonym xml:lang="en">Amnesia Memory Loss</ncit2:synonym>
        <umls3:cui xml:lang="en">C0002622</umls3:cui>
        <rdfs:label xml:lang="en">Amnesia</rdfs:label>
        <skos:definition xml:lang="en">Systematic and extensive loss or impairment of memory caused by organic or psychological factors. This may be temporary or permanent, and may involve old or recent memories. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Anaemia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Anaemia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HaematologicalDisease"/>
        <ncit2:synonym xml:lang="en">Anemia</ncit2:synonym>
        <umls3:cui xml:lang="en">C0002871</umls3:cui>
        <rdfs:label xml:lang="en">Anaemia</rdfs:label>
        <skos:definition xml:lang="en">A reduction in the number of circulating erythrocytes or in the quantity of hemoglobin. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Anaesthesia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Anaesthesia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <ncit2:synonym xml:lang="en">Anesthesia, Absence of Sense, Sensory Loss</ncit2:synonym>
        <umls3:cui xml:lang="en">C0278134</umls3:cui>
        <rdfs:comment xml:lang="en">Anesthesia or anaesthesia (from Greek &quot;without sensation&quot;) is a state of controlled, temporary loss of sensation or awareness that is induced for medical purposes.</rdfs:comment>
        <rdfs:label xml:lang="en">Anaesthesia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Anger -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Anger">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EmotionalDistress"/>
        <ncit2:synonym xml:lang="en">Feeling Angry, Angry Mood</ncit2:synonym>
        <umls3:cui xml:lang="en">C0002957</umls3:cui>
        <rdfs:label xml:lang="en">Anger</rdfs:label>
        <skos:definition xml:lang="en">A strong emotional feeling of displeasure aroused by being interfered with, injured or threatened. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AnimalAssistedTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AnimalAssistedTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <umls3:cui xml:lang="en">C0150133</umls3:cui>
        <rdfs:label xml:lang="en">Animal Assisted Therapy</rdfs:label>
        <skos:definition xml:lang="en">A type of therapy based on the human-animal companion bond used in an effort to assist in restoring feelings of hope, self worth, responsibility, and communication. From Psychological Index Terms</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AnxietyDisorder -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AnxietyDisorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MentalDisorder"/>
        <umls3:cui xml:lang="en">C0003469</umls3:cui>
        <rdfs:label xml:lang="en">Anxiety Disorder</rdfs:label>
        <skos:definition xml:lang="en">Persistent and disabling anxiety. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AnxietyInDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AnxietyInDementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isAnxietyInDementiaOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonWithDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Anxiety in Dementia</rdfs:label>
        <skos:definition xml:lang="en">Emotions of people with dementia that characterized by feelings of apprehension, uneasiness or dread associated to an anticipated, actual or imagined stressor.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AnxietyOfHealthCareProfessional -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AnxietyOfHealthCareProfessional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnHealthCareProfessional"/>
        <rdfs:comment xml:lang="en">Emotional and mood disturbances of people with dementia contribute to health care professional&apos;s anxiety.</rdfs:comment>
        <rdfs:label xml:lang="en">Anxiety of Health Care Professional</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApathyEvaluationScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApathyEvaluationScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#assesses"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApathyInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:abbreviation xml:lang="en">AES</ncit2:abbreviation>
        <rdfs:label xml:lang="en">Apathy Evaluation Scale</rdfs:label>
        <skos:definition xml:lang="en">Apathy evaluation scale is an 18-item scale that addresses characteristics of goal directed behaviour that reflects apathy including behavioural, cognitive, and emotional indicators.From https://www.sralab.org/rehabilitation-measures/apathy-evaluation-scale-includes-three-forms-self-informant-and-clinician</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApathyEvaluationScaleClinicianVersion -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApathyEvaluationScaleClinicianVersion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:label xml:lang="en">Apathy Evaluation Scale Clinician Version</rdfs:label>
        <skos:definition xml:lang="en">The clinician version of Apathy Evaluation Scale that items are scored on 4-point likert scale with descriptors (not at all characteristic, slightly characteristic, somewhat characteristic, very characteristic)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApathyEvaluationScaleInformantVersion -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApathyEvaluationScaleInformantVersion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">AES-I</ncit2:abbreviation>
        <rdfs:label xml:lang="en">Apathy Evaluation Scale Informant Version</rdfs:label>
        <skos:definition xml:lang="en">The informant version of Apathy Evaluation Scale that items are scored on 4-point likert scale with descriptors (not at all charactersitic, slightly characteristic, somewhat characteristic, very characteristic)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApathyEvaluationScaleSelfVersion -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApathyEvaluationScaleSelfVersion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:label xml:lang="en">Apathy Evaluation Scale Self Version</rdfs:label>
        <skos:definition xml:lang="en">The &quot;self&quot; version of Apathy Evaluation Scale that items are scored on 4-point scale with decriptiors (not at all true, slightly true, somewhat true, very true&quot;.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApathyInDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApathyInDementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isApathyInDementiaOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonWithDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:synonym xml:lang="en">Listless Mood in Dementia, Emotional Indifference in Dementia</ncit2:synonym>
        <rdfs:label xml:lang="en">Apathy in Dementia</rdfs:label>
        <skos:definition xml:lang="en">A reducation or lack of feeling, emotion, interest, or concern in people with dementia</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApathyInDementiaNursingHomeScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApathyInDementiaNursingHomeScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#assesses"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApathyInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:abbreviation xml:lang="en">APADEM-NH</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Apathy Scale for Institutionalized Patients with Dementia‐Nursing Home version</ncit2:synonym>
        <rdfs:label xml:lang="en">Apathy in Dementia Nursing Home Scale</rdfs:label>
        <skos:definition xml:lang="en">The APADEM-NH (APAthy in DEMentia, Nursing Home) scale was specifically designed to measure apathy in institutionalized patients with neurode- generative dementia by considering the special characteristics of the most severe stages of the illness and the distinctiveness of the institutional environ- ment such as group-living or professional caregiving. From Krista Lanctôt, Luis Agüera-ortiz, 2013 A Novel Rating Scale for the Measurement of Apathy in Institutionalized Persons with Dementia: The APADEM-NH, The American Journal of Geriatric Psychiatry</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApathyInventory -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApathyInventory">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#assesses"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApathyInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:abbreviation xml:lang="en">AI</ncit2:abbreviation>
        <rdfs:label xml:lang="en">Apathy Inventory</rdfs:label>
        <skos:definition xml:lang="en">Apathy Inventory (AI) assesses emotional blunting, lack of initiative, and lack of interest and also the person’s awareness of these symptoms. From Robert PH, Clairet S, Benoit M, Koutaich J, Bertogliati C, Tible O, Caci H, Borg M, Brocker P, Bedoucha P. The apathy inventory: assessment of apathy and awareness in Alzheimer&apos;s disease, Parkinson&apos;s disease and mild cognitive impairment. Int J Geriatr Psychiatry. 2002 Dec;17(12):1099-105</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Aphasia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Aphasia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveImpairment"/>
        <umls3:cui xml:lang="en">C0003537</umls3:cui>
        <rdfs:label xml:lang="en">Aphasia</rdfs:label>
        <skos:definition xml:lang="en">A cognitive disorder marked by an impaired ability to comprehend or express language in its written or spoken form. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApplyingCommunicationSkill -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApplyingCommunicationSkill">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManagementActivityOfEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:comment xml:lang="en">The activity of applying the technique for communicating with people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Applying Communication Skill</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApplyingDressingToWound -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApplyingDressingToWound">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Apply Dressing to Site</ncit2:synonym>
        <umls3:cui xml:lang="en">C1736039</umls3:cui>
        <rdfs:comment xml:lang="en">The intervention of applying a dressing to cover and protect a wound.</rdfs:comment>
        <rdfs:label xml:lang="en">Applying Dressing to Wound</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApplyingHotPack -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApplyingHotPack">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Application of Hot Packs to Mulitple Areas, Applying Heat Pack</ncit2:synonym>
        <umls3:cui xml:lang="en">C5415988</umls3:cui>
        <rdfs:comment xml:lang="en">The intervention of applying a hot pack or hot packes to a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Applying Hot Pack</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApplyingWarmBlanket -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApplyingWarmBlanket">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Applying Warming Blanket</ncit2:synonym>
        <umls3:cui xml:lang="en">C0509768</umls3:cui>
        <rdfs:comment xml:lang="en">The intervention of applying a warm blanket to a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Applying Warm Blanket</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AquaticExercise -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AquaticExercise">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalExerciseTherapy"/>
        <umls3:cui xml:lang="en">C5544388</umls3:cui>
        <rdfs:label xml:lang="en">Aquatic Exercise</rdfs:label>
        <skos:definition xml:lang="en">Aquatic exercise is exercise that is performed in the water, typically in a pool. It is a low-impact activity that takes the pressure off a person&apos;s bones, joints and muscles. From Mayo Clinic</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Arguing -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Arguing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyAggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The expression of diverging or opposite views, typically in a heated or angry way.</rdfs:comment>
        <rdfs:label xml:lang="en">Arguing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ArmchairTravelActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ArmchairTravelActivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">The activity of finding out what a place or location is by watching videos, viewing posters, reading books, and so on.</rdfs:comment>
        <rdfs:label xml:lang="en">Armchair Travel Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Aromatherapist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Aromatherapist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Therapist"/>
        <umls3:cui xml:lang="en">C2985484</umls3:cui>
        <rdfs:label xml:lang="en">Aromatherapist</rdfs:label>
        <skos:definition xml:lang="en">A person who practices a type of complementary medicien called aromatherapy. This therapy uses plant oils that give off strong, pleasant smells to promote relaxation and a sense of well-being. The plant oils are usually inhaled or put on the skin using wet clothes, baths, or massage. From the U.S. National Cancer Insitute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Aromatherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Aromatherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SensoryStimulationTherapy"/>
        <ncit2:synonym xml:lang="en">Aroma Therapy</ncit2:synonym>
        <umls3:cui xml:lang="en">C0376547</umls3:cui>
        <rdfs:label xml:lang="en">Aromatherapy</rdfs:label>
        <skos:definition xml:lang="en">The use of fragrances and essences from plants to affect or alter a person&apos;s mood or behavior and to facilitate physical, mental, and emotional well-being. The chemicals comprising essential oils in plants has a host of therapeutic properties and has been used historically in Africa, Asia, and India. Its greatest application is in the field of alternative medicine. From Random House Unabridged Dictionary, 2d ed; from Dr. Atiba Vheir, Dove Center, Washington, D.C.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ArtTherapist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ArtTherapist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Therapist"/>
        <umls3:cui xml:lang="en">C0586935</umls3:cui>
        <rdfs:label xml:lang="en">Art Therapist</rdfs:label>
        <skos:definition xml:lang="en">An individual who uses art to achieve the therapeutic goals of symptom relief, emotional integration, and recovery from or adjustment to illness or disability. From National Uniform Claim Committee - Health Care Provider Taxonomy</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ArtTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ArtTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:synonym xml:lang="en">Arts-Based Therapy, Arts-Based Approach, Art-Based Intervention</ncit2:synonym>
        <umls3:cui xml:lang="en">C0003827</umls3:cui>
        <rdfs:label xml:lang="en">Art Therapy</rdfs:label>
        <skos:definition xml:lang="en">The use of art as an adjunctive therapy in the treatment of neurological, mental, or behavioral disorders. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Arthritis -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Arthritis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:synonym xml:lang="en">Inflammatory Arthritis, Joint Inflammation</ncit2:synonym>
        <umls3:cui xml:lang="en">C0003864</umls3:cui>
        <rdfs:label xml:lang="en">Arthritis</rdfs:label>
        <skos:definition xml:lang="en">Acute or chronic inflammation of joints. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Aspiration -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Aspiration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <ncit2:synonym xml:lang="en">Actual Aspiration, Aspiration into Respiratory Tract</ncit2:synonym>
        <umls3:cui xml:lang="en">C2712334</umls3:cui>
        <rdfs:label xml:lang="en">Aspiration</rdfs:label>
        <skos:definition xml:lang="en">Aspiration occurs when food, drink, or foreign objects are breathed into the lungs (going down the wrong tube). It might happen during choking, but aspiration can also be silent, meaning that there is no outward sign.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#assesses"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EmotionalAndMoodDisturbanceInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isUsedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessional"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Tool or scale which is used to assess the emotional and mood disturbances of person with dementia</rdfs:comment>
        <rdfs:label xml:lang="en">Assessment Tool for Emotional and Mood Disturbance in Dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingInApplyingMakeup -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingInApplyingMakeup">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithPersonalGrooming"/>
        <ncit2:synonym xml:lang="en">Application of Make Up to Skin</ncit2:synonym>
        <umls3:cui xml:lang="en">C2732586</umls3:cui>
        <rdfs:comment xml:lang="en">The intervention of applying cosmetics to skin of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Assisting in Applying Makeup</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingInChoosingAppropriateClothing -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingInChoosingAppropriateClothing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithPersonalGrooming"/>
        <umls3:cui xml:lang="en">C2371469</umls3:cui>
        <rdfs:label xml:lang="en">Assisting in Choosing Appropriate Clothing</rdfs:label>
        <skos:definition xml:lang="en">Following implicit or explicit dress codes and conventions of one&apos;s society or culture and dressing in keeping with climatic conditions. From International Classification of Functioning, Disability and Health (ICF)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingInCuttingUpFood -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingInCuttingUpFood">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithEating"/>
        <rdfs:comment xml:lang="en">The activity of nursing staff cutting up food for person to easily eat.</rdfs:comment>
        <rdfs:label xml:lang="en">Assisting in Cutting up Food</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingInFeedingPerson -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingInFeedingPerson">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithEating"/>
        <ncit2:synonym xml:lang="en">Feeding, Feed with Assistance</ncit2:synonym>
        <umls3:cui xml:lang="en">C0150334</umls3:cui>
        <rdfs:label xml:lang="en">Assisting in Feeding Person</rdfs:label>
        <skos:definition xml:lang="en">Assisting a person in feeding himself or herself.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingInPuttingOnClothes -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingInPuttingOnClothes">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithPersonalGrooming"/>
        <ncit2:synonym xml:lang="en">Dressing</ncit2:synonym>
        <umls3:cui xml:lang="en">C1998794</umls3:cui>
        <rdfs:label xml:lang="en">Assisting in Putting on Clothes</rdfs:label>
        <skos:definition xml:lang="en">Carrying out the coordinated tasks of putting clothes on various parts of the body, such as putting clothes on over the head, over the arms and shoulders, and on the lower and upper halves of the body; putting on gloves and headgear. From International Classification of Functioning, Disability and Health</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingInTakingOffClothes -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingInTakingOffClothes">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithPersonalGrooming"/>
        <ncit2:synonym xml:lang="en">Undressing</ncit2:synonym>
        <umls3:cui xml:lang="en">C1998905</umls3:cui>
        <rdfs:label xml:lang="en">Assisting in Taking off Clothes</rdfs:label>
        <skos:definition xml:lang="en">Carrying out the coordinated tasks of taking clothes off various parts of the body, such as pulling clothes off and over the head, off the arms and shoulders, and off the lower and upper halves of the body; taking off gloves and headgear. From International Classification of Functioning, Disability and Health</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithActivityOfDailyLiving -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithActivityOfDailyLiving">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Helping with Activity of Daily Living</ncit2:synonym>
        <umls3:cui xml:lang="en">C0509063</umls3:cui>
        <rdfs:comment xml:lang="en">Assisting people with dementia to perform activities of daily living.</rdfs:comment>
        <rdfs:label xml:lang="en">Assisting with Activity of Daily Living</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithContinenceCare -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithContinenceCare">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithActivityOfDailyLiving"/>
        <rdfs:comment xml:lang="en">Assisting a person with his/her continence care</rdfs:comment>
        <rdfs:label xml:lang="en">Assisting with Continence Care</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithEating -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithEating">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithActivityOfDailyLiving"/>
        <umls3:cui xml:lang="en">C1279813</umls3:cui>
        <rdfs:comment xml:lang="en">Assisting people with eating and drinking</rdfs:comment>
        <rdfs:label xml:lang="en">Assisting with Eating</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithHairCare -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithHairCare">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithPersonalHygiene"/>
        <ncit2:synonym xml:lang="en">Assistance with Hair Care</ncit2:synonym>
        <umls3:cui xml:lang="en">C1822179</umls3:cui>
        <rdfs:comment xml:lang="en">Assisting people with their hair care.</rdfs:comment>
        <rdfs:label xml:lang="en">Assisting with Hair Care</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithMedicationManagement -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithMedicationManagement">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <rdfs:comment xml:lang="en">Assisting people to manage his/her medication</rdfs:comment>
        <rdfs:label xml:lang="en">Assisting with Medication Management</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithMobility -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithMobility">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithActivityOfDailyLiving"/>
        <umls3:cui xml:lang="en">C3650993</umls3:cui>
        <rdfs:comment xml:lang="en">The intervention of assisting a person to mobilise.</rdfs:comment>
        <rdfs:label xml:lang="en">Assisting with Mobility</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithNailCare -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithNailCare">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithPersonalHygiene"/>
        <umls3:cui xml:lang="en">C1279776</umls3:cui>
        <rdfs:comment xml:lang="en">Assisting people with their nail care.</rdfs:comment>
        <rdfs:label xml:lang="en">Assisting with Nail Care</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithOralCare -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithOralCare">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithPersonalHygiene"/>
        <umls3:cui xml:lang="en">C5141266</umls3:cui>
        <rdfs:comment xml:lang="en">Assisting people with their mouth and teeth care.</rdfs:comment>
        <rdfs:label xml:lang="en">Assisting with Oral Care</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithPersonalGrooming -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithPersonalGrooming">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithActivityOfDailyLiving"/>
        <umls3:cui xml:lang="en">C0150333</umls3:cui>
        <rdfs:label xml:lang="en">Assisting with Personal Grooming</rdfs:label>
        <skos:definition xml:lang="en">Assisting patient with clothes and appearance. From Nursing Interventions Classification</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithPersonalHygiene -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithPersonalHygiene">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithActivityOfDailyLiving"/>
        <umls3:cui xml:lang="en">C1279778</umls3:cui>
        <rdfs:comment xml:lang="en">Assisting people with hygiene care</rdfs:comment>
        <rdfs:label xml:lang="en">Assisting with Personal Hygiene</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithSleep -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithSleep">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithActivityOfDailyLiving"/>
        <rdfs:comment>Assisting a person with his/her sleep</rdfs:comment>
        <rdfs:label xml:lang="en">Assisting with Sleep</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithToileting -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithToileting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithContinenceCare"/>
        <umls3:cui xml:lang="en">C0150335</umls3:cui>
        <rdfs:label xml:lang="en">Assisting with Toileting</rdfs:label>
        <skos:definition xml:lang="en">Assisting another person with elimination. From Nursing Interventions Classification</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssociatedGroup -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssociatedGroup">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient"/>
        <rdfs:comment xml:lang="en">Information about the groups an individual is connected with</rdfs:comment>
        <rdfs:label xml:lang="en">Associated Group</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssociatedProfessionalOrganization -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssociatedProfessionalOrganization">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssociatedGroup"/>
        <rdfs:comment xml:lang="en">Information about the professional organizations that an individual is connected with</rdfs:comment>
        <rdfs:label xml:lang="en">Associated Professional Organization</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssociatedSocialClub -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssociatedSocialClub">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssociatedGroup"/>
        <rdfs:comment xml:lang="en">Information about the social clubs that an individual is connected with. A social club is a club that is formed around a common interest or activity, such as chess club and fishing club.</rdfs:comment>
        <rdfs:label xml:lang="en">Associated Social Club</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AtRiskForFall -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AtRiskForFall">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AtRiskState"/>
        <ncit2:synonym xml:lang="en">Fall Risk, At Risk for Falling</ncit2:synonym>
        <umls3:cui xml:lang="en">C1268740</umls3:cui>
        <rdfs:label xml:lang="en">At Risk for Fall</rdfs:label>
        <skos:definition xml:lang="en">Potential for increased chance of falling that may cause physical harm, damage or lose. From Periperative Nursing Data Set</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AtRiskForPressureUlcer -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AtRiskForPressureUlcer">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AtRiskState"/>
        <ncit2:synonym xml:lang="en">Pressure Sore Risk, At Risk of Pressure Sore, At Risk of Pressure Injury, At Risk of Pressure Ulcer</ncit2:synonym>
        <umls3:cui xml:lang="en">C0563204</umls3:cui>
        <rdfs:label xml:lang="en">At Risk for Pressure Ulcer</rdfs:label>
        <skos:definition xml:lang="en">Potential for increased chance of injury to skin and underlying tissue resulting from prolonged pressure on the skin. From Mayo Clinic</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AtRiskForSuicide -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AtRiskForSuicide">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AtRiskState"/>
        <umls3:cui xml:lang="en">C0563664</umls3:cui>
        <rdfs:label xml:lang="en">At Risk for Suicide</rdfs:label>
        <skos:definition xml:lang="en">Susceptible to self-inflicted, life-threatening injury. From the North American Nursing Diagnosis Association International (NANDA-I)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AtRiskState -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AtRiskState">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient"/>
        <ncit2:synonym xml:lang="en">At Risk - Finding, Finding of at Risk, Finding Related to Risk Factor</ncit2:synonym>
        <umls3:cui xml:lang="en">C0559571</umls3:cui>
        <rdfs:comment xml:lang="en">The particular condition that someone has the potential for increased chance of getting injuries (including life-threatening injuries) or diseases.</rdfs:comment>
        <rdfs:label xml:lang="en">At Risk State</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AttendingConcert -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AttendingConcert">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">Activity of attending a concert.</rdfs:comment>
        <rdfs:label xml:lang="en">Attending Concert</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AttendingVirtualEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AttendingVirtualEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <ncit2:synonym xml:lang="en">Attending Online Event</ncit2:synonym>
        <rdfs:comment xml:lang="en">The activity of attending an online event that involves people interacting in a virtual environment on the web.</rdfs:comment>
        <rdfs:label xml:lang="en">Attending Virtual Event</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AttendingVirtualMuseumTour -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AttendingVirtualMuseumTour">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AttendingVirtualEvent"/>
        <rdfs:comment xml:lang="en">The activity of attending an online museum tour that allows visitors to take self-guided tours of select exhibits and areas within the museum from their desktop or mobile device.</rdfs:comment>
        <rdfs:label xml:lang="en">Attending Virtual Museum Tour</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AttendingVirtualZooTour -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AttendingVirtualZooTour">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AttendingVirtualEvent"/>
        <rdfs:comment xml:lang="en">The activity of attending an online zoom tour that allows visitors to take self-guided tours of selected exhibits about animals and their habitats within the zoo from their desktop or mobile device.</rdfs:comment>
        <rdfs:label xml:lang="en">Attending Virtual Zoo Tour</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AttitudeOfHealthCareProfessional -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AttitudeOfHealthCareProfessional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InterpersonalCausativeFactor"/>
        <rdfs:comment xml:lang="en">The attitude of health care professional to care of people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Attitude of Health Care Professional</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Audiologist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Audiologist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessional"/>
        <umls3:cui xml:lang="en">C0175838</umls3:cui>
        <rdfs:label xml:lang="en">Audiologist</rdfs:label>
        <skos:definition xml:lang="en">Professionals skilled at diagnostic testing of hearing, hearing impairment, and correction of hearing impairment by non-medical or non-surgical means. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AuditoryImpairment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AuditoryImpairment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SensoryImpairment"/>
        <ncit2:synonym xml:lang="en">Hearing Impairment, Hearing Loss, Impaired Hearing, Poor Hearing, Decreased Hearing, Hearing Reduced, Hearing Deficit</ncit2:synonym>
        <umls3:cui xml:lang="en">C1384666</umls3:cui>
        <rdfs:label xml:lang="en">Auditory Impairment</rdfs:label>
        <skos:definition xml:lang="en">A general term for the complete or partial loss of the ability to hear from one or both ears. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Aunt -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Aunt">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
        <umls3:cui xml:lang="en">C0337576</umls3:cui>
        <rdfs:label xml:lang="en">Aunt</rdfs:label>
        <skos:definition xml:lang="en">The sister of one&apos;s father or mother; the wife of one&apos;s uncle. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AutonomicHyperactivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AutonomicHyperactivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfAnxietyInDementia"/>
        <rdfs:label xml:lang="en">Autonomic Hyperactivity</rdfs:label>
        <skos:definition xml:lang="en">Autonomic hyperactivity is a life-threatening manifestation of many disorders affecting the central or peripheral nervous systems. From Oxford Medicine Online https://oxfordmedicine.com/view/10.1093/med/9780199920198.001.0001/med-9780199920198-chapter-13</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvailabilityOfNonpharmacologicalInterventionImplementationResource -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvailabilityOfNonpharmacologicalInterventionImplementationResource">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FactorAffectingImplementationOfNonpharmacologicalIntervention"/>
        <rdfs:comment xml:lang="en">The availabity of resource for applying nonpharmacological intervention.</rdfs:comment>
        <rdfs:label xml:lang="en">Availability of Nonpharmacological Intervention Implementation Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvailabilityOfNonpharmacologicalInterventionTrainingResource -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvailabilityOfNonpharmacologicalInterventionTrainingResource">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FactorAffectingImplementationOfNonpharmacologicalIntervention"/>
        <rdfs:comment xml:lang="en">The availableness of resource for training health care professional about nonpharmacological intervention.</rdfs:comment>
        <rdfs:label xml:lang="en">Availability of Nonpharmacological Intervention Training Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidArguingWithPersonWithDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidArguingWithPersonWithDementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionAvoided"/>
        <rdfs:comment xml:lang="en">People should avoid arguring with a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Avoid Arguing with Person with Dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidAskingComplexQuestion -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidAskingComplexQuestion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionAvoided"/>
        <rdfs:comment xml:lang="en">People should avoid asking complex questions when communicating with people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Avoid Asking Complex Question</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidAskingPersonWithDementiaToTryHarder -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidAskingPersonWithDementiaToTryHarder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionAvoided"/>
        <rdfs:comment xml:lang="en">People should avoid asking person with dementia to &quot;try harder&quot;.</rdfs:comment>
        <rdfs:label xml:lang="en">Avoid Asking Person with Dementia to Try Harder</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidCorrectingPersonWithDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidCorrectingPersonWithDementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionAvoided"/>
        <rdfs:comment xml:lang="en">People should avoid correcting a person with dementia during communicating with him/her.</rdfs:comment>
        <rdfs:label xml:lang="en">Avoid Correcting Person with Dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidCriticisingPersonWithDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidCriticisingPersonWithDementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionAvoided"/>
        <rdfs:comment xml:lang="en">People should avoid criticising a person with dementia when communicating with him/her.</rdfs:comment>
        <rdfs:label xml:lang="en">Avoid Criticising Person with Dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidInterruptingWhenPersonWithDementiaIsTalking -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidInterruptingWhenPersonWithDementiaIsTalking">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionAvoided"/>
        <rdfs:comment xml:lang="en">People should avoid interrupting a person with dementia when he/she is talking.</rdfs:comment>
        <rdfs:label xml:lang="en">Avoid Interrupting When Person with Dementia is Talking</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidMultipleStepRequest -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidMultipleStepRequest">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionAvoided"/>
        <ncit2:synonym xml:lang="en">Avoid Complex Multi-Step Command</ncit2:synonym>
        <rdfs:comment xml:lang="en">People should avoid using a multiple-step request when communicating with people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Avoid Multiple-Step Request</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidNegativeWord -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidNegativeWord">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionAvoided"/>
        <rdfs:comment xml:lang="en">People should avoid using negative word(s) when communicating with people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Avoid Negative Word</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidOfferingTooManyChoices -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidOfferingTooManyChoices">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionAvoided"/>
        <rdfs:comment xml:lang="en">People should avoid offering too many choices when communicating with people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Avoid Offering Too Many Choices</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidOpenEndedQuestion -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidOpenEndedQuestion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionAvoided"/>
        <rdfs:comment xml:lang="en">People should avoid asking open-ended questions when communicating with people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Avoid Open-Ended Question</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidOverexplaining -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidOverexplaining">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionAvoided"/>
        <rdfs:comment xml:lang="en">People should avoid overexplaining when communicating with people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Avoid Overexplaining</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidScreaming -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidScreaming">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionAvoided"/>
        <rdfs:comment xml:lang="en">People should not scream when communicating with people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Avoid Screaming</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidTellingPersonWithDementiaThatHeIsWrong -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidTellingPersonWithDementiaThatHeIsWrong">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionAvoided"/>
        <rdfs:comment xml:lang="en">People should avoid telling the person with dementia that he or she is wrong.</rdfs:comment>
        <rdfs:label xml:lang="en">Avoid Telling Person with Dementia that He is Wrong</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidUsingHarshTone -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidUsingHarshTone">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionAvoided"/>
        <rdfs:comment xml:lang="en">People should avoid using harsh tone when communicating with people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Avoid Using Harsh Tone</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidUsingSlang -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidUsingSlang">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionAvoided"/>
        <rdfs:comment xml:lang="en">Avoid using words and phrases that are regarded as very informal, and are typically restricted to a particular context or group of people.</rdfs:comment>
        <rdfs:label xml:lang="en">Avoid Using Slang</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Avoidance -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Avoidance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfAnxietyInDementia"/>
        <umls3:cui xml:lang="en">C0870186</umls3:cui>
        <rdfs:label xml:lang="en">Avoidance</rdfs:label>
        <skos:definition xml:lang="en">A conscious or unconscious refusal to encounter situations, activities, or objects; the act or practice of keeping away from or withdrawing from something. From the U.S. Nationational Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidantPersonalityTrait -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AvoidantPersonalityTrait">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonalityTrait"/>
        <rdfs:comment xml:lang="en">Personality characterised by social discomfort and avoidance of interpersonal contact.</rdfs:comment>
        <rdfs:label xml:lang="en">Avoidant Personality Trait</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BPSDAssessmentTraining -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BPSDAssessmentTraining">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonCentredCareEudcationToHealthCareProfessional"/>
        <rdfs:comment xml:lang="en">The training of BPSD (behavioural and psychological symptoms of dementia) Assessment that is provided to health care professionals.</rdfs:comment>
        <rdfs:label xml:lang="en">BPSD Assessment Training</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isBackgroundOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareRecipient"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isMatchedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonWithDementiaFocusedIntervention"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isProvidedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Person"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Information about the background of a care recipient</rdfs:comment>
        <rdfs:label xml:lang="en">Background of Care Recipient</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BalanceExercise -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BalanceExercise">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalExerciseTherapy"/>
        <ncit2:synonym xml:lang="en">Balance Therapy</ncit2:synonym>
        <umls3:cui xml:lang="en">C0150219</umls3:cui>
        <rdfs:label xml:lang="en">Balance Exercise</rdfs:label>
        <skos:definition xml:lang="en">Use of specific activities, postures, and movements to maintain, enhance, or restore balance. From Nursing Interventions Classification (NIC)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BalloonGame -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BalloonGame">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">The activity of playing with balloons.</rdfs:comment>
        <rdfs:label xml:lang="en">Balloon Game</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BarbecueActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BarbecueActivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <ncit2:synonym xml:lang="en">BBQ Activity</ncit2:synonym>
        <rdfs:comment xml:lang="en">The activity involving cooking and enjoying food that cooked using fire and smoke.</rdfs:comment>
        <rdfs:label xml:lang="en">Barbecue Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BathPreference -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BathPreference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonalHygienePreference"/>
        <umls3:cui xml:lang="en">C0582062</umls3:cui>
        <rdfs:comment xml:lang="en">Preference to personal hygiene, such as shaving preference, and hair care preference.</rdfs:comment>
        <rdfs:label xml:lang="en">Bath Preference</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Bathroom -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Bathroom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LocationOfManifestationOfEmotionalAndMoodDisturbance"/>
        <umls3:cui xml:lang="en">C0556989</umls3:cui>
        <rdfs:label xml:lang="en">Bathroom</rdfs:label>
        <skos:definition xml:lang="en">A room containing a bath or shower and typically also a washbasin and a toilet. From Oxfor Languages</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BeckDepressionInventory -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BeckDepressionInventory">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#assesses"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DepressionInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:abbreviation xml:lang="en">BDI</ncit2:abbreviation>
        <umls3:cui xml:lang="en">C0451022</umls3:cui>
        <rdfs:label xml:lang="en">Beck Depression Inventory</rdfs:label>
        <skos:definition xml:lang="en">A twenty-one question survey completed by a patient, with each answer scored on a scale of 0 to 3, designed to measure presence of depression. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BeddingPreference -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BeddingPreference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Preference"/>
        <rdfs:comment xml:lang="en">Preference to the bedclothes, such as blankets and sheets used on a bed.</rdfs:comment>
        <rdfs:label xml:lang="en">Bedding Preference</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Bedtime -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Bedtime">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Time"/>
        <umls3:cui xml:lang="en">C0521112</umls3:cui>
        <rdfs:comment xml:lang="en">The usual time of going to bed.</rdfs:comment>
        <rdfs:label xml:lang="en">Bedtime</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BeforeBedtime -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BeforeBedtime">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Time"/>
        <umls3:cui xml:lang="en">C1879793</umls3:cui>
        <rdfs:comment xml:lang="en">The time prior to going to bed.</rdfs:comment>
        <rdfs:label xml:lang="en">Before Bedtime</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BeforeBreakfast -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BeforeBreakfast">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Time"/>
        <umls3:cui xml:lang="en">C1549040</umls3:cui>
        <rdfs:comment xml:lang="en">The time prior to eating breakfast.</rdfs:comment>
        <rdfs:label xml:lang="en">Before Breakfast</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BeforeDinner -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BeforeDinner">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Time"/>
        <ncit2:synonym xml:lang="en">Before Evening Meal</ncit2:synonym>
        <umls3:cui xml:lang="en">C1550742</umls3:cui>
        <rdfs:comment xml:lang="en">The time prior to eating dinner.</rdfs:comment>
        <rdfs:label xml:lang="en">Before Dinner</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BeforeHandoverTime -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BeforeHandoverTime">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Time"/>
        <rdfs:comment xml:lang="en">The time prior to handover.</rdfs:comment>
        <rdfs:label xml:lang="en">Before Handover Time</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BeforeLunch -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BeforeLunch">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Time"/>
        <umls3:cui xml:lang="en">C1550741</umls3:cui>
        <rdfs:comment xml:lang="en">The time prior to eating lunch.</rdfs:comment>
        <rdfs:label xml:lang="en">Before Lunch</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehavioralInaction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehavioralInaction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isManifestationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApathyInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isManifestationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DepressionInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The lack of the overall feedback or reply made by a person in any circumstances.</rdfs:comment>
        <rdfs:label xml:lang="en">Behavioral Inaction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehavioralPathologyInAlzheimersDiseaseRatingScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehavioralPathologyInAlzheimersDiseaseRatingScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">BEHAVE-AD</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Behavioural Pathology in Alzheimer&apos;s Disease Item, Behavioral Pathology in Alzheimer&apos;s Disease</ncit2:synonym>
        <rdfs:label xml:lang="en">Behavioral Pathology in Alzheimer&apos;s Disease Rating Scale</rdfs:label>
        <skos:definition xml:lang="en">The Behavioral Pathology in Alzheimer&apos;s Disease Rating Scale (BEHAVE-AD) is a well-established instrument, designed to assess potentially remediable behavioral symptoms in Alzheimer&apos;s disease (AD) patients as well as to evaluate treatment outcome. It consists of 25 symptoms grouped into seven categories. From Monteiro IM, Boksay I, Auer SR, Torossian C, Ferris SH, Reisberg B. Addition of a frequency-weighted score to the Behavioral Pathology in Alzheimer&apos;s Disease Rating Scale: the BEHAVE-AD-FW: methodology and reliability. Eur Psychiatry. 2001 Jan;16 Suppl 1:5s-24s. doi: 10.1016/s0924-9338(00)00524-1. PMID: 11520474.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehaviourOfHealthCareProfessional -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehaviourOfHealthCareProfessional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InterpersonalCausativeFactor"/>
        <rdfs:comment xml:lang="en">The acts or conducts of health care professional.</rdfs:comment>
        <rdfs:label xml:lang="en">Behaviour of Health Care Professional</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehaviourOfOtherCareRecipient -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehaviourOfOtherCareRecipient">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InterpersonalCausativeFactor"/>
        <ncit2:synonym xml:lang="en">Behaviour of Other Resident</ncit2:synonym>
        <rdfs:comment xml:lang="en">Behaviour of other care recipients living in the same long-term care facility</rdfs:comment>
        <rdfs:label xml:lang="en">Behaviour of Other Care Recipient</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehaviourOfVisitor -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehaviourOfVisitor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#InterpersonalCausativeFactor"/>
        <rdfs:comment xml:lang="en">The behavior of visitors in the long-term care facilities.</rdfs:comment>
        <rdfs:label xml:lang="en">Behaviour of Visitor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehaviourRatingScaleForDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehaviourRatingScaleForDementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">BRSD</ncit2:abbreviation>
        <rdfs:label xml:lang="en">Behaviour Rating Scale for Dementia</rdfs:label>
        <skos:definition xml:lang="en">The Behavior Rating Scale for Dementia (BRSD) is a standardized instrument for rating behavioral abnormalities in demented or cognitively impaired subjects. Descriptive items are scaled according to frequency of psychopathological behavior. From Duke Aging Center https://sites.duke.edu/centerforaging/cerad/assessments/behavior-rating-scale-dementia-brsd/</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehaviourTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehaviourTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Psychotherapy"/>
        <ncit2:synonym xml:lang="en">Behavioural Psychotherapy, Behaviour Modification, Behavioural Intervention, Conditioning Therapy, Behaviour Conditioning Therapy, Behaviour Modification Technique, Behavioural Management Intervention</ncit2:synonym>
        <umls3:cui xml:lang="en">C0004933</umls3:cui>
        <rdfs:label xml:lang="en">Behaviour Therapy</rdfs:label>
        <skos:definition xml:lang="en">The use of operant conditioning, including rewards and punishments, in helping a person create an atmosphere where he or she does not contribute to painful stimuli. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehaviouralAssessment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehaviouralAssessment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthAssessment"/>
        <ncit2:synonym xml:lang="en">Behavior Assessment, Assessing Behavior, Behavioral Analysis, Behavior Care Assessment</ncit2:synonym>
        <umls3:cui xml:lang="en">C1160858</umls3:cui>
        <rdfs:label xml:lang="en">Behavioural Assessment</rdfs:label>
        <skos:definition xml:lang="en">Assessing a person&apos;s unacceptable and/or inappropriate behavior(s) to identify the behavior(s) and determine why he or she is demonstrating a behavior(s).  From Alternative Billing Concepts</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehaviouralObservation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehaviouralObservation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManagementActivityOfEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:comment xml:lang="en">Acquisition of information about behaviors of a care recipient</rdfs:comment>
        <rdfs:label xml:lang="en">Behavioural Observation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BeingImpatientWithPersonWithDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BeingImpatientWithPersonWithDementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehaviourOfHealthCareProfessional"/>
        <rdfs:comment xml:lang="en">Health care professional is impatient with person with dementia, e.g. rushing person with dementia in carrying out tasks.</rdfs:comment>
        <rdfs:label xml:lang="en">Being Impatient with Person with Dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BeingOverlyFamiliarWithOtherPeople -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BeingOverlyFamiliarWithOtherPeople">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfEuphoriaInDementia"/>
        <rdfs:comment xml:lang="en">Being excessively familiar with other people</rdfs:comment>
        <rdfs:label xml:lang="en">Being Overly Familiar with Other People</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BeingUnusuallyEmotional -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BeingUnusuallyEmotional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isManifestationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AnxietyInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isManifestationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DepressionInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isManifestationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EuphoriaInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Being exceptionally affected by emotion</rdfs:comment>
        <rdfs:label xml:lang="en">Being Unusually Emotional</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Belief -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Belief">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient"/>
        <umls3:cui xml:lang="en">C0004951</umls3:cui>
        <rdfs:label xml:lang="en">Belief</rdfs:label>
        <skos:definition xml:lang="en">A state or habit of mind in which trust or confidence is placed in some person or thing; conviction of the truth of some statement or the reality of some phenomenon. From the Computer Retrieval of Information on Scientific Projects (CRISP) Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Bereavement -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Bereavement">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <ncit2:synonym xml:lang="en">Bereavement Reaction</ncit2:synonym>
        <umls3:cui xml:lang="en">C0005119</umls3:cui>
        <rdfs:label xml:lang="en">Bereavement</rdfs:label>
        <skos:definition xml:lang="en">Refers to the whole process of grieving and mourning and is associated with a deep sense of loss and sadness. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BibleReading -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BibleReading">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PastoralCare"/>
        <rdfs:comment xml:lang="en">The activity of reading the Bible, which bring peace and comfort to the reader.</rdfs:comment>
        <rdfs:label xml:lang="en">Bible Reading</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BiographicallyOrientatedMobilisation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BiographicallyOrientatedMobilisation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:synonym xml:lang="en">Biographically Orientated Mobilization</ncit2:synonym>
        <rdfs:label xml:lang="en">Biographically Orientated Mobilisation</rdfs:label>
        <skos:definition xml:lang="en">A weekly 10-15 min activation that focused on the motor, cognitive, and emotional aspects of apathy by exploring the biography of people with dementia and orienting mobilization and interventions at previously pursued hobbies and interests. From Treusch Y, Page J, Niemann-Mirmehdi M, Gutzmann H, Heinz A, Rapp M. Apathy and its non-pharmacological treatment in dementia. Geropsych 2011;24:155–64.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BiologicalGender -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BiologicalGender">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GenderIdentity"/>
        <rdfs:comment xml:lang="en">Gender of a person assigned biologically at birth.</rdfs:comment>
        <rdfs:label xml:lang="en">Biological Gender</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BipolarDisorder -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BipolarDisorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MentalDisorder"/>
        <ncit2:synonym xml:lang="en">Bipolar Affective Disorder</ncit2:synonym>
        <umls3:cui xml:lang="en">C0005586</umls3:cui>
        <rdfs:label xml:lang="en">Bipolar Disorder</rdfs:label>
        <skos:definition xml:lang="en">A major disorder marked by  severe mood swings (manic or major depressive episodes) and a tendency to remission and recurrence. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BirdKeepingHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BirdKeepingHobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PetKeepingHobby"/>
        <rdfs:comment xml:lang="en">Hobby of keeping birds as pets.</rdfs:comment>
        <rdfs:label xml:lang="en">Bird Keeping Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Bisexual -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Bisexual">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LGBTQ"/>
        <ncit2:synonym xml:lang="en">Bisexual State</ncit2:synonym>
        <umls3:cui xml:lang="en">C2129310</umls3:cui>
        <rdfs:label xml:lang="en">Bisexual</rdfs:label>
        <skos:definition xml:lang="en">Possessing both homosexual and heterosexual preferences; or true hermaphroditism, having gonads of both sexes. From Computer Retrieval of Information on Scientific Projects (CRISP) Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Biting -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Biting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyAggressiveBehaviour"/>
        <ncit2:synonym xml:lang="en">Aggressive Biting</ncit2:synonym>
        <umls3:cui xml:lang="en">C0233534</umls3:cui>
        <rdfs:comment xml:lang="en">The behaviour of biting something or somebody aggressively.</rdfs:comment>
        <rdfs:label xml:lang="en">Biting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BodyHeight -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BodyHeight">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BodySize"/>
        <ncit2:synonym xml:lang="en">Height</ncit2:synonym>
        <umls3:cui xml:lang="en">C0005890</umls3:cui>
        <rdfs:label xml:lang="en">Body Height</rdfs:label>
        <skos:definition xml:lang="en">The distance from the sole to the crown of the head with body standing on a flat surface and fully extended. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BodySize -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BodySize">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient"/>
        <umls3:cui xml:lang="en">C0005901</umls3:cui>
        <rdfs:label xml:lang="en">Body Size</rdfs:label>
        <skos:definition xml:lang="en">The physical measurements of a body. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BodyWeight -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BodyWeight">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BodySize"/>
        <ncit2:synonym xml:lang="en">Weight</ncit2:synonym>
        <umls3:cui xml:lang="en">C0005910</umls3:cui>
        <rdfs:label xml:lang="en">Body Weight</rdfs:label>
        <skos:definition xml:lang="en">The mass or quantity of heaviness of an individual. It is expressed by units of pounds or kilograms. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BodyWeightChange -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BodyWeightChange">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnSelf"/>
        <ncit2:synonym xml:lang="en">Weight Change</ncit2:synonym>
        <umls3:cui xml:lang="en">C0005911</umls3:cui>
        <rdfs:label xml:lang="en">Body Weight Change</rdfs:label>
        <skos:definition xml:lang="en">A clinical manifestation consisting of alterations in an individual&apos;s weight from his or her norm. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BondLaderVisualAnalogueScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BondLaderVisualAnalogueScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">BL-VAS</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Bond-Lader Mood Rating Scale, Bond-Lader VAS, Bond-Lader Mood Scale, Bond-Lader VAS Mood Rating Scale</ncit2:synonym>
        <rdfs:label xml:lang="en">Bond-Lader Visual Analogue Scale</rdfs:label>
        <skos:definition xml:lang="en">Bond-Lader Visual Analogue Scale was developed in 1974 by Bond and Lader to rate subjective feelings. From Bond A, Lader M. The use of analogue scales in rating subjective feelings. British Journal of Medical Psychology. 1974;47:211-218</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Boredom -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Boredom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <umls3:cui xml:lang="en">C0006019</umls3:cui>
        <rdfs:label xml:lang="en">Boredom</rdfs:label>
        <skos:definition xml:lang="en">A psychological state resulting from any acticity that lacks motivation, or from enforced continuance in an uninteresting situation. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BreakfastTime -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BreakfastTime">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Time"/>
        <ncit2:synonym xml:lang="en">Morning Meal Time, Breakfast</ncit2:synonym>
        <umls3:cui xml:lang="en">C2698559</umls3:cui>
        <rdfs:comment xml:lang="en">The time of people having breakfast.</rdfs:comment>
        <rdfs:label xml:lang="en">Breakfast Time</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BreakingDownLongSentenceIntoShortPhrase -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BreakingDownLongSentenceIntoShortPhrase">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionSuggested"/>
        <rdfs:comment xml:lang="en">People should break down long sentences (e.g., questions, statements and requests) into short phrases when communicating with people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Breaking Down Long Sentence into Short Phrase</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BreathingExercise -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BreathingExercise">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MindBodyTherapy"/>
        <ncit2:synonym xml:lang="en">Respiratory Muscle Training, Breath Exercise</ncit2:synonym>
        <umls3:cui xml:lang="en">C0006155</umls3:cui>
        <rdfs:label xml:lang="en">Breathing Exercise</rdfs:label>
        <skos:definition xml:lang="en">Therapeutic exercises aimed to deepen inspiration or expiration or even to alter the rate and rhythm of respiration. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BriefPsychiatricRatingScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BriefPsychiatricRatingScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">BPRS</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Overall and Gorham Brief Psychiatric Rating Scale, Overall-Gorham Brief Psychiatric Rating Scale</ncit2:synonym>
        <umls3:cui xml:lang="en">C0029941</umls3:cui>
        <rdfs:label xml:lang="en">Brief Psychiatric Rating Scale</rdfs:label>
        <skos:definition xml:lang="en">The Brief Psychiatric Rating Scale (BPRS) is a rating scale which a clinician or researcher may use to measure psychiatric symptoms such as depression, anxiety, hallucinations and unusual behaviour. The scale is one of the oldest, most widely used scales to measure psychotic symptoms and was first published in 1962. (Overall JE, Gorham DR (1962). The brief psychiatric rating scale. Psychological Reports 1962 vol. 10, pp799-812). From Wikipedia.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BrightWhiteLightTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BrightWhiteLightTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LightTherapy"/>
        <ncit2:synonym xml:lang="en">Bright Light Therapy</ncit2:synonym>
        <umls3:cui xml:lang="en">C5400760</umls3:cui>
        <rdfs:label xml:lang="en">Bright White Light Therapy</rdfs:label>
        <skos:definition xml:lang="en">Phototherapy that utilizes bright white full-spectrum light, typically delivered through a light box, to mimic natural outdoor light for the treatment of the depressive symptoms in both seasonal affective disorder and non-sensonal depression, as well as for the treatment of sleep and other mood disorders. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Brother -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Brother">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
        <umls3:cui xml:lang="en">C0337527</umls3:cui>
        <rdfs:comment xml:lang="en">A male sibling of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Brother</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BrotherInLaw -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BrotherInLaw">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
        <umls3:cui xml:lang="en">C1553711</umls3:cui>
        <rdfs:label xml:lang="en">Brother-in-law</rdfs:label>
        <skos:definition xml:lang="en">A brother by marriage. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BuddySystemIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BuddySystemIntervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:comment xml:lang="en">The intervention of creating a buddy system between care recipients in the residential care facility or between care recipients and staff to strengthen support networks.</rdfs:comment>
        <rdfs:label xml:lang="en">Buddy System Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BurnoutOfHealthCareProfessional -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BurnoutOfHealthCareProfessional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnHealthCareProfessional"/>
        <umls3:cui xml:lang="en">C0006433</umls3:cui>
        <rdfs:label xml:lang="en">Burnout of Health Care Professional</rdfs:label>
        <skos:definition xml:lang="en">An excessive stress reaction to one&apos;s occupational or professional environment. It may be characterized by feelings of emotional and physical exhaustion, coupled with a sense of frustration and failure. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BusTrip -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BusTrip">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">The activity of attending bus trip.</rdfs:comment>
        <rdfs:label xml:lang="en">Bus Trip</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BusinessImmigration -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BusinessImmigration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ImmigrationType"/>
        <rdfs:comment xml:lang="en">Type of immigration that people choose to live in other countries for operating a new or existing business.</rdfs:comment>
        <rdfs:label xml:lang="en">Business Immigration</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CannabisAddiction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CannabisAddiction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Addiction"/>
        <ncit2:synonym xml:lang="en">Cannabis Dependence, Marijuana Addiction, Marijuana Dependence</ncit2:synonym>
        <umls3:cui xml:lang="en">C0006870</umls3:cui>
        <rdfs:label xml:lang="en">Cannabis Addiction</rdfs:label>
        <skos:definition xml:lang="en">Physical and psychological dependence on the drug cannabis. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CardGame -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CardGame">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">The activity of playing cards.</rdfs:comment>
        <rdfs:label xml:lang="en">Card Game</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Cardiologist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Cardiologist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessional"/>
        <umls3:cui xml:lang="en">C0175906</umls3:cui>
        <rdfs:label xml:lang="en">Cardiologist</rdfs:label>
        <skos:definition xml:lang="en">Qualified medical professionals who specialize in preventing and treating disorders of the heart and cardiovascular system. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareCoordinator -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareCoordinator">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessional"/>
        <umls3:cui xml:lang="en">C4708569</umls3:cui>
        <rdfs:label xml:lang="en">Care Coordinator</rdfs:label>
        <skos:definition xml:lang="en">A person who coordinates multi-disciplinary patient care services, assuring that patients receive the care intended by their care plan. From SNOMEDCT</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareGoalForEmotionalAndMoodDisturbanceInDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareGoalForEmotionalAndMoodDisturbanceInDementia">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isCareGoalOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessional"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The goal setted for managing emotional and mood disturbances of a particular person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Care Goal for Emotional and Mood Disturbance in Dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareHoursPerCareRecipientDay -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareHoursPerCareRecipientDay">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FactorAffectingImplementationOfNonpharmacologicalIntervention"/>
        <ncit2:synonym xml:lang="en">Care Hours per Resident Day, Hours of Care per Resident Day</ncit2:synonym>
        <rdfs:comment xml:lang="en">Hours of care provided by all nursing staff per care recipient day</rdfs:comment>
        <rdfs:label xml:lang="en">Care Hours per Care Recipient Day</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareRecipient -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareRecipient">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#hasBackground"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#hasFamilyMember"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#hasFriend"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Friend"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#hasInterpreter"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Interpreter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#hasLegalRepresentative"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LegalRepresentative"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isCaredBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessional"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:synonym xml:lang="en">Resident</ncit2:synonym>
        <rdfs:comment xml:lang="en">The people living in the long term care facility.</rdfs:comment>
        <rdfs:label xml:lang="en">Care Recipient</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareRecipientRoom -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareRecipientRoom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LocationOfManifestationOfEmotionalAndMoodDisturbance"/>
        <ncit2:synonym xml:lang="en">Resident Room</ncit2:synonym>
        <rdfs:comment xml:lang="en">The room that a long-term care facility provides for accommodation of a person living there.</rdfs:comment>
        <rdfs:label xml:lang="en">Care Recipient Room</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareStaff -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareStaff">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessional"/>
        <ncit2:synonym xml:lang="en">Direct Care Worker, Direct Care Staff, Personal Care Worker, Personal Care Assistant (PCA), Assistant in Nursing (AIN)</ncit2:synonym>
        <umls3:cui xml:lang="en">C4034487</umls3:cui>
        <rdfs:comment xml:lang="en">The care staff that provide hands-on, generally long term care for people.</rdfs:comment>
        <rdfs:label xml:lang="en">Care Staff</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CasinoActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CasinoActivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">A type of the simulated gambling activities. The participants can play slot machines, standard video poker, roulette, blackjack, or craps, but no actual money would be exchanged during the activity.</rdfs:comment>
        <rdfs:label xml:lang="en">Casino Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CatKeepingHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CatKeepingHobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PetKeepingHobby"/>
        <rdfs:comment xml:lang="en">Hobby of keeping cats as pets.</rdfs:comment>
        <rdfs:label xml:lang="en">Cat Keeping Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CausativeFactorInvestigation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CausativeFactorInvestigation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthAssessment"/>
        <rdfs:comment xml:lang="en">Investigating possible causes of the behaviour</rdfs:comment>
        <rdfs:label xml:lang="en">Causative Factor Investigation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CausativeFactorOfEmotionalAndMoodDisturbanceInDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CausativeFactorOfEmotionalAndMoodDisturbanceInDementia">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#causes"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EmotionalAndMoodDisturbanceInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:synonym xml:lang="en">Emotional and Mood Disturbance in Dementia Causative Agent</ncit2:synonym>
        <rdfs:comment xml:lang="en">The factors that could cause the emotional and mood disturbances in people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Causative Factor of Emotional and Mood Disturbance in Dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CeaselessTalking -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CeaselessTalking">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyNonaggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The constant and unending talking.</rdfs:comment>
        <rdfs:label xml:lang="en">Ceaseless Talking</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CelebratingSmallSuccess -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CelebratingSmallSuccess">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionSuggested"/>
        <rdfs:comment xml:lang="en">People should celebrate small success of a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Celebrating Small Success</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CelebrationActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CelebrationActivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">The activity of celebrating something, e.g., birthday celebration and festival celebration.</rdfs:comment>
        <rdfs:label xml:lang="en">Celebration Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CenterForEpidemiologicalStudiesDepressionScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CenterForEpidemiologicalStudiesDepressionScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#assesses"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DepressionInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:abbreviation xml:lang="en">CES-D</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Center for Epidemiologic Studies Depression Scale Questionnaire</ncit2:synonym>
        <umls3:cui xml:lang="en">C2699160</umls3:cui>
        <rdfs:label xml:lang="en">Center for Epidemiological Studies Depression Scale</rdfs:label>
        <skos:definition xml:lang="en">A self-test that measures depressive feelings and behaviors within the general population. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ChangeInAppetite -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ChangeInAppetite">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnSelf"/>
        <rdfs:comment xml:lang="en">Becoming different in one&apos;s desire to eat food.</rdfs:comment>
        <rdfs:label xml:lang="en">Change in Appetite</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ChangeInRoutine -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ChangeInRoutine">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialEnvironmentCausativeFactor"/>
        <ncit2:synonym xml:lang="en">Disruption of Familiar Routine</ncit2:synonym>
        <rdfs:comment xml:lang="en">The changes in the routine of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Change in Routine</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ChangeInSleepPattern -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ChangeInSleepPattern">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnSelf"/>
        <ncit2:synonym xml:lang="en">Change in Sleep, Change in Sleeping Patterns</ncit2:synonym>
        <umls3:cui xml:lang="en">C3203743</umls3:cui>
        <rdfs:comment xml:lang="en">Becoming different in one&apos;s sleep patterns.</rdfs:comment>
        <rdfs:label xml:lang="en">Change in Sleep Pattern</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ChangingContinenceAid -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ChangingContinenceAid">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithContinenceCare"/>
        <rdfs:comment xml:lang="en">The intervention of replacing a continence aid.</rdfs:comment>
        <rdfs:label xml:lang="en">Changing Continence Aid</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Chapel -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Chapel">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LocationOfManifestationOfEmotionalAndMoodDisturbance"/>
        <umls3:cui xml:lang="en">C0558275</umls3:cui>
        <rdfs:comment xml:lang="en">A private place of worship serving a residence or institution.</rdfs:comment>
        <rdfs:label xml:lang="en">Chapel</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CheckingHearingAid -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CheckingHearingAid">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Hearing Aid Check</ncit2:synonym>
        <umls3:cui xml:lang="en">C0455223</umls3:cui>
        <rdfs:comment xml:lang="en">The acts to ensure that hearing aids are clean and operational.</rdfs:comment>
        <rdfs:label xml:lang="en">Checking Hearing Aid</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CheckingPerson -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CheckingPerson">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Sighting</ncit2:synonym>
        <rdfs:comment xml:lang="en">The activity of checking the safety and comfort of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Checking Person</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CheckingVisionAid -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CheckingVisionAid">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <rdfs:comment xml:lang="en">The checks to ensure visual aids (devices that are used for assisting sight, e.g., glasses) are clean and operational.</rdfs:comment>
        <rdfs:label xml:lang="en">Checking Vision Aid</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ChildhoodAbuse -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ChildhoodAbuse">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TraumaticLifeEvent"/>
        <ncit2:synonym xml:lang="en">History of Childhood Abuse</ncit2:synonym>
        <umls3:cui xml:lang="en">C4062014</umls3:cui>
        <rdfs:comment xml:lang="en">Information about childhood abuse experienced by a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Childhood Abuse</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Choking -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Choking">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <ncit2:synonym xml:lang="en">Food Stuck in Throat</ncit2:synonym>
        <umls3:cui xml:lang="en">C0008301</umls3:cui>
        <rdfs:comment xml:lang="en">Choking occurs when the airway is blocked by food, drink, or foreign objects.</rdfs:comment>
        <rdfs:label xml:lang="en">Choking</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ChurchServiceActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ChurchServiceActivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PastoralCare"/>
        <ncit2:synonym xml:lang="en">Church Services</ncit2:synonym>
        <rdfs:comment xml:lang="en">The activity that make people living in the long-term care facility feel like they have &quot;been to church&quot;. It normally includes a song service, prayer and a short sermon.</rdfs:comment>
        <rdfs:label xml:lang="en">Church Service Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CleaningHearingAid -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CleaningHearingAid">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <rdfs:comment xml:lang="en">The activity of cleaning the hearing aids.</rdfs:comment>
        <rdfs:label xml:lang="en">Cleaning Hearing Aid</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CleaningVisionAid -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CleaningVisionAid">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Cleaning Eyeglasses</ncit2:synonym>
        <rdfs:comment xml:lang="en">The activity of cleaning vision aids.</rdfs:comment>
        <rdfs:label xml:lang="en">Cleaning Vision Aid</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Clinician -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Clinician">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessional"/>
        <umls3:cui xml:lang="en">C0871685</umls3:cui>
        <rdfs:label xml:lang="en">Clinician</rdfs:label>
        <skos:definition xml:lang="en">A health professional who takes care of patients. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ClothingPreference -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ClothingPreference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Preference"/>
        <rdfs:comment xml:lang="en">reference to clothes worn on the body</rdfs:comment>
        <rdfs:label xml:lang="en">Clothing Preference</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ClutteredEnvironment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ClutteredEnvironment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentCausativeFactor"/>
        <ncit2:synonym xml:lang="en">Clutter</ncit2:synonym>
        <umls3:cui xml:lang="en">C4061120</umls3:cui>
        <rdfs:comment xml:lang="en">The environment that filled with an untidy collection of things.</rdfs:comment>
        <rdfs:label xml:lang="en">Cluttered Environment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CoffeeClubActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CoffeeClubActivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">The participants can regularly attend the Coffee Club (a club for coffee lovers) to socialize over enjoying coffee and cakes/biscuits.</rdfs:comment>
        <rdfs:label xml:lang="en">Coffee Club Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveAbility -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveAbility">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RemainingAbility"/>
        <ncit2:synonym xml:lang="en">Ability to Perform Cognitive Activity</ncit2:synonym>
        <umls3:cui xml:lang="en">C0392334</umls3:cui>
        <rdfs:comment xml:lang="en">General mental capability of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Cognitive Ability</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveAssessment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveAssessment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthAssessment"/>
        <ncit2:synonym xml:lang="en">Cognitive Examination, Cognitive Screening, Assessment Cognition</ncit2:synonym>
        <umls3:cui xml:lang="en">C0870300</umls3:cui>
        <rdfs:label xml:lang="en">Cognitive Assessment</rdfs:label>
        <skos:definition xml:lang="en">The examination of the cognitive capacities or deficits of an individual through the application of tests that probe that individual&apos;s ability to perform various mental activities such as perception, learning, and reasoning. From The U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveBehaviouralTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveBehaviouralTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Psychotherapy"/>
        <ncit2:abbreviation xml:lang="en">CBT</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Cognitive Behaviour Modification, Behavioural Cognitive Therapy</ncit2:synonym>
        <rdfs:comment xml:lang="en">An integrated approach to psychotherapy that combines the techniques of cognitive and behaviour therapy.</rdfs:comment>
        <rdfs:label xml:lang="en">Cognitive Behavioural Therapy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveImpairment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveImpairment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:synonym xml:lang="en">Cognitive Deficit, Cognitive Decline, Cognitive Dysfunction, Impaired Cognition, Cognitive Function Abnormal, Cognitive Disturbance, Neurocognitive Dysfunction</ncit2:synonym>
        <umls3:cui xml:lang="en">C0338656</umls3:cui>
        <rdfs:label xml:lang="en">Cognitive Impairment</rdfs:label>
        <skos:definition xml:lang="en">Diminished or impaired mental and/or intellectual function. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveRehabilitation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveRehabilitation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveTherapy"/>
        <umls3:cui xml:lang="en">C0870303</umls3:cui>
        <rdfs:label xml:lang="en">Cognitive Rehabilitation</rdfs:label>
        <skos:definition xml:lang="en">Procedures used to restore or enhance the cognitive functioning level of individuals with mental disability, injury, or disease (e.g., brain damaged stroke patients). From Thesaurus of Psychological Index Terms</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveStimulationTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveStimulationTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveTherapy"/>
        <ncit2:abbreviation xml:lang="en">CST</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Cognitive Stimulation</ncit2:synonym>
        <rdfs:label xml:lang="en">Cognitive Stimulation Therapy</rdfs:label>
        <skos:definition xml:lang="en">Promotion of awareness and comprehension of surroundings by utilization of planned stimuli. From Nursing Interventions Classification</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveStyle -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveStyle">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonalityTrait"/>
        <umls3:cui xml:lang="en">C0563147</umls3:cui>
        <rdfs:label xml:lang="en">Cognitive Style</rdfs:label>
        <skos:definition xml:lang="en">Preferred or habitual style of learning or thinking. From Psychological Index Terms</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Psychotherapy"/>
        <ncit2:synonym xml:lang="en">Cognitive Intervention</ncit2:synonym>
        <umls3:cui xml:lang="en">C0009244</umls3:cui>
        <rdfs:label xml:lang="en">Cognitive Therapy</rdfs:label>
        <skos:definition xml:lang="en">A type of psychotherapy that helps patients change their behavior by changing the way they think and feel about certain things. It is used to treat mental, emotional, personality, and behavioral disorders. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveTraining -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveTraining">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveTherapy"/>
        <ncit2:synonym xml:lang="en">Brain Training</ncit2:synonym>
        <umls3:cui xml:lang="en">C1868940</umls3:cui>
        <rdfs:label xml:lang="en">Cognitive Training</rdfs:label>
        <skos:definition xml:lang="en">A program of regular activities purported to maintain or improve one&apos;s cognitive abilities. From Wikipedia</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ColouringPicture -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ColouringPicture">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">The activity of colouring a picture.</rdfs:comment>
        <rdfs:label xml:lang="en">Colouring Picture</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunalArea -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunalArea">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LocationOfManifestationOfEmotionalAndMoodDisturbance"/>
        <ncit2:synonym xml:lang="en">Communal Areas in Accommodation</ncit2:synonym>
        <umls3:cui xml:lang="en">C0557234</umls3:cui>
        <rdfs:comment xml:lang="en">The shared entrances, halls, stairways, passages, balconies, yards, lifts, fire escapes, roads and paths leading to or from the care recipient&apos;s room, grassed, cultivated, drying and play areas, forecourts and other shared areas in a long-term care facility</rdfs:comment>
        <rdfs:label xml:lang="en">Communal Area</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionAvoided -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionAvoided">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SkillForCommunicatingWithPersonWithDementia"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionSuggested"/>
        <rdfs:comment xml:lang="en">The communicating actions that should be avoided.</rdfs:comment>
        <rdfs:label xml:lang="en">Communicating Action Avoided</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionSuggested -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionSuggested">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SkillForCommunicatingWithPersonWithDementia"/>
        <rdfs:comment xml:lang="en">The communicating actions that are suggested to do during a communication with people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Communicating Action Suggested</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingAtEyeLevel -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingAtEyeLevel">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionSuggested"/>
        <rdfs:comment xml:lang="en">People should communiate with people with dementia at eye level.</rdfs:comment>
        <rdfs:label xml:lang="en">Communicating at Eye Level</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicationProblem -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicationProblem">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <umls3:cui xml:lang="en">C0481701</umls3:cui>
        <rdfs:comment xml:lang="en">The communication problems that people with dementia may have.</rdfs:comment>
        <rdfs:label xml:lang="en">Communication Problem</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicationSkillTraining -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicationSkillTraining">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonCentredCareEudcationToHealthCareProfessional"/>
        <rdfs:comment xml:lang="en">The training that provided to health care professionals about how to communicate with people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Communication Skill Training</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Complaining -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Complaining">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyAggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The expression of dissatisfaction or annoyance about something.</rdfs:comment>
        <rdfs:label xml:lang="en">Complaining</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CompulsiveSexualBehaviour -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CompulsiveSexualBehaviour">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfEuphoriaInDementia"/>
        <umls3:cui xml:lang="en">C2242574</umls3:cui>
        <rdfs:label xml:lang="en">Compulsive Sexual Behaviour</rdfs:label>
        <skos:definition xml:lang="en">An excessive preoccupation with sexual fantasies, urges or behaviors that is difficult to control. From Mayo Clinic</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ComputerisedCognitiveBehaviourTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ComputerisedCognitiveBehaviourTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveBehaviouralTherapy"/>
        <ncit2:abbreviation xml:lang="en">CCBT</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Computerized Cognitive Behavioural Therapy</ncit2:synonym>
        <rdfs:label xml:lang="en">Computerised Cognitive Behavioural Therapy</rdfs:label>
        <skos:definition xml:lang="en">Computerised Cognitive Behavioural Therapy is a type of self-help therapy delivered via the internet, which is grounded in cognitive behavioural therapy. From Dedert E, McDuffie JR, Swinkels C, et al. Computerized Cognitive Behavioral Therapy for Adults with Depressive or Anxiety Disorders [Internet]. Washington (DC): Department of Veterans Affairs (US); 2013 Oct. Available from: https://www.ncbi.nlm.nih.gov/books/NBK269001/</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Concern -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Concern">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <umls3:cui xml:lang="en">C2699424</umls3:cui>
        <rdfs:comment xml:lang="en">A worry that tends to persist over time.</rdfs:comment>
        <rdfs:label xml:lang="en">Concern</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutBurdeningOtherPeople -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutBurdeningOtherPeople">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Concern"/>
        <umls3:cui xml:lang="en">C1821305</umls3:cui>
        <rdfs:comment xml:lang="en">The concern about burdening others.</rdfs:comment>
        <rdfs:label xml:lang="en">Concern about Burdening Other People</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutFalling -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutFalling">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Concern"/>
        <ncit2:synonym xml:lang="en">Fear of Falling, Fear of Fall</ncit2:synonym>
        <umls3:cui xml:lang="en">C0877040</umls3:cui>
        <rdfs:comment xml:lang="en">A person&apos;s anxiety towards usual or normal walking or mobilising, with the perception that a fall will occur. It is common after a fall although it can occur in the absence of a fall. From Physiopedia</rdfs:comment>
        <rdfs:label xml:lang="en">Concern about Falling</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutFamilyMember -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutFamilyMember">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Concern"/>
        <umls3:cui xml:lang="en">C4062081</umls3:cui>
        <rdfs:comment xml:lang="en">A person&apos;s concern about his/her family member(s).</rdfs:comment>
        <rdfs:label xml:lang="en">Concern about Family Member</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutFinance -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutFinance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Concern"/>
        <ncit2:synonym xml:lang="en">Concern about Money</ncit2:synonym>
        <rdfs:comment xml:lang="en">A person with dementia may worry about his/her finance, e.g. cost that is associated with health care.</rdfs:comment>
        <rdfs:label xml:lang="en">Concern about Finance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutHealth -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutHealth">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Concern"/>
        <rdfs:comment xml:lang="en">The concern of one&apos;s own health or body function.</rdfs:comment>
        <rdfs:label xml:lang="en">Concern about Health</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutIndwellingBladderCatheter -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutIndwellingBladderCatheter">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutMedicalDevice"/>
        <ncit2:abbreviation xml:lang="en">IDC</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Concern about Using Indwelling Urinary Catheter</ncit2:synonym>
        <rdfs:comment xml:lang="en">The concern of using indwelling urinary catheter - a hollow tube that is inserted and left in the bladder to promote the drainage of urine.</rdfs:comment>
        <rdfs:label xml:lang="en">Concern about Indwelling Bladder Catheter</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutInsertedSuprapbicCatheter -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutInsertedSuprapbicCatheter">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutMedicalDevice"/>
        <rdfs:comment xml:lang="en">The concern about a suprapubic catheter (also called for SPC) that has been inserted into a person&apos;s bladder to drain urine when this person can&apos;t urinate on his/her own.</rdfs:comment>
        <rdfs:label xml:lang="en">Concern about Inserted Suprapbic Catheter</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutLiftingAssistiveDevice -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutLiftingAssistiveDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutMedicalDevice"/>
        <rdfs:comment xml:lang="en">The concern about using lifting assistive device.</rdfs:comment>
        <rdfs:label xml:lang="en">Concern about Lifting Assistive Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutLossOfFreedom -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutLossOfFreedom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Concern"/>
        <rdfs:comment xml:lang="en">A person&apos;s concern about loss of his/her freedom.</rdfs:comment>
        <rdfs:label xml:lang="en">Concern about Loss of Freedom</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutMedicalDevice -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutMedicalDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Concern"/>
        <rdfs:comment xml:lang="en">A person&apos;s worry about medical device.</rdfs:comment>
        <rdfs:label xml:lang="en">Concern about Medical Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutMedication -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutMedication">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Concern"/>
        <rdfs:comment xml:lang="en">The worry about medication.</rdfs:comment>
        <rdfs:label xml:lang="en">Concern about Medication</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutMedicationShortage -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutMedicationShortage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutMedication"/>
        <rdfs:comment xml:lang="en">The concern about the medication supply is insufficient.</rdfs:comment>
        <rdfs:label xml:lang="en">Concern about Medication Shortage</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutMedicationSideEffect -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutMedicationSideEffect">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutMedication"/>
        <rdfs:comment xml:lang="en">The worry about adverse effects of medication.</rdfs:comment>
        <rdfs:label xml:lang="en">Concern about Medication Side Effect</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutPersonalProperty -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutPersonalProperty">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Concern"/>
        <rdfs:comment xml:lang="en">The concern about personal property include house, vehicles, furniture, boats, and collectibles.</rdfs:comment>
        <rdfs:label xml:lang="en">Concern about Personal Property</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutTakingMedicationIncorrectly -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutTakingMedicationIncorrectly">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutMedication"/>
        <rdfs:comment xml:lang="en">The concern about taking medication, with the perception that he/she will take the medication incorrectly.</rdfs:comment>
        <rdfs:label xml:lang="en">Concern about Taking Medication Incorrectly</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutUpcomingEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutUpcomingEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Concern"/>
        <rdfs:comment xml:lang="en">The concern about events that will happen in the near future, such as the medical assessment appointment next week.</rdfs:comment>
        <rdfs:label xml:lang="en">Concern about Upcoming Event</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutWheeledWalker -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutWheeledWalker">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernAboutMedicalDevice"/>
        <rdfs:comment xml:lang="en">The concern of using a walker with wheels.</rdfs:comment>
        <rdfs:label xml:lang="en">Concern about Wheeled Walker</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernOfFamilyMember -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernOfFamilyMember">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnFamilyMember"/>
        <ncit2:synonym xml:lang="en">Stress of Family Member, Worry of Family Member</ncit2:synonym>
        <rdfs:comment xml:lang="en">Emotional and mood disturbances of a person cause an uneasy state of mind of their famly members.</rdfs:comment>
        <rdfs:label xml:lang="en">Concern of Family Member</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernOfFriend -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernOfFriend">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnFriend"/>
        <ncit2:synonym xml:lang="en">Worry of Friend, Stress of Friend</ncit2:synonym>
        <rdfs:comment xml:lang="en">The emotional and mood disturbances in a person with dementia may cause an uneasy mental state of his/her friends about him/her.</rdfs:comment>
        <rdfs:label xml:lang="en">Concern of Friend</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernOfOtherCareRecipient -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConcernOfOtherCareRecipient">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnOtherCareRecipient"/>
        <ncit2:synonym xml:lang="en">Concern of Other Resident, Worry of Other Resident, Stress of Other Resident</ncit2:synonym>
        <rdfs:comment xml:lang="en">Emotional and mood disturbances of a care recipient may cause an uneasy state of mind of other care recipients living in the same long term care facility.</rdfs:comment>
        <rdfs:label xml:lang="en">Concern of Other Care Recipient</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Confusion -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Confusion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <ncit2:synonym xml:lang="en">Feeling Confused, Confusional State, Confused, Daze, Dazed, Dazing, Easily Confused</ncit2:synonym>
        <umls3:cui xml:lang="en">C0009676</umls3:cui>
        <rdfs:label xml:lang="en">Confusion</rdfs:label>
        <skos:definition xml:lang="en">A mental state characterized by bewilderment, emotional disturbance, lack of clear thinking, and perceptual disorientation. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConsistencyOfStaff -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConsistencyOfStaff">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialEnvironmentalIntervention"/>
        <umls3:cui xml:lang="en">C1822381</umls3:cui>
        <rdfs:comment xml:lang="en">The intervention of having consistent and regular staff for providing care to a person with dementia in the long-term care facility.</rdfs:comment>
        <rdfs:label xml:lang="en">Consistency of Staff Providing Care</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConstantManipulationOfObject -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConstantManipulationOfObject">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyNonaggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The behaviour of manipulating something constantly.</rdfs:comment>
        <rdfs:label xml:lang="en">Constant Manipulation of Object</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConstantRepetitionOfWord -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConstantRepetitionOfWord">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyNonaggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The behaviour of continuously repeating words or sentences.</rdfs:comment>
        <rdfs:label xml:lang="en">Constant Repetition of Word</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConstantUnwarrantedRequestsForAttention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConstantUnwarrantedRequestsForAttention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyNonaggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The constant and not justified requests for attention.</rdfs:comment>
        <rdfs:label xml:lang="en">Constant Unwarranted Requests for Attention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConstantUnwarrantedRequestsForHelp -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConstantUnwarrantedRequestsForHelp">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyNonaggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The constant and not justified requests for help.</rdfs:comment>
        <rdfs:label xml:lang="en">Constant Unwarranted Requests for Help</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConstantUnwarrantedRequestsForReassurance -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ConstantUnwarrantedRequestsForReassurance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyNonaggressiveBehaviour"/>
        <rdfs:comment xml:lang="en">The constant and not justified requests for reassurance.</rdfs:comment>
        <rdfs:label xml:lang="en">Constant Unwarranted Requests for Reassurance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Constipation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Constipation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:synonym xml:lang="en">Defficulty Defecating, Difficulty Passing Motion, Difficulty Opening Bowel, Difficulty Passing Stool, Costiveness</ncit2:synonym>
        <umls3:cui xml:lang="en">C0009806</umls3:cui>
        <rdfs:label xml:lang="en">Constipation</rdfs:label>
        <skos:definition xml:lang="en">A disorder characterized by irregular and infrequent or difficult evacuation of the bowels. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ContactInformation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ContactInformation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient"/>
        <umls3:cui xml:lang="en">C1880174</umls3:cui>
        <rdfs:comment xml:lang="en">Information that can be used to contact a person, such as address, telephone number and email address.</rdfs:comment>
        <rdfs:label xml:lang="en">Contact Information</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Cooking -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Cooking">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <umls3:cui xml:lang="en">C0335326</umls3:cui>
        <rdfs:label xml:lang="en">Cooking</rdfs:label>
        <skos:definition xml:lang="en">The art or practice of preparing food. It includes the preparation of special foods for diets in various diseases. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CookingHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CookingHobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hobby"/>
        <rdfs:comment xml:lang="en">Hobby of preparing food.</rdfs:comment>
        <rdfs:label xml:lang="en">Cooking Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Coordination -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Coordination">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalAbility"/>
        <ncit2:synonym xml:lang="en">Physiologic Coordination</ncit2:synonym>
        <umls3:cui xml:lang="en">C0242414</umls3:cui>
        <rdfs:label xml:lang="en">Coordination</rdfs:label>
        <skos:definition xml:lang="en">Ability to execute smooth, accurate, controlled motor responses (optimal interaction of muscle function).</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CornellScaleForDepressionInDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CornellScaleForDepressionInDementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#assesses"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DepressionInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:abbreviation xml:lang="en">CSDD</ncit2:abbreviation>
        <umls3:cui xml:lang="en">C4744456</umls3:cui>
        <rdfs:label xml:lang="en">Cornell Scale for Depression in Dementia</rdfs:label>
        <skos:definition xml:lang="en">A 19-item clinician-administered instrument, developed by Alexopoulos et al. in 1986, that utilizes a three-point rating scale to assess signs and symptoms of major depression in patients with dementia, based on interviews with both the patient and a caregiver. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Corridor -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Corridor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LocationOfManifestationOfEmotionalAndMoodDisturbance"/>
        <umls3:cui xml:lang="en">C0557670</umls3:cui>
        <rdfs:comment xml:lang="en">The long passage in a building from which doors lead into rooms.</rdfs:comment>
        <rdfs:label xml:lang="en">Corridor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Counselling -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Counselling">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialInteractionIntervention"/>
        <ncit2:synonym xml:lang="en">Counseling, Counseling Intervention</ncit2:synonym>
        <umls3:cui xml:lang="en">C0010210</umls3:cui>
        <rdfs:label xml:lang="en">Counselling</rdfs:label>
        <skos:definition xml:lang="en">The giving of advice and assistance to individuals when educational or personal problems. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CountryOfBirth -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CountryOfBirth">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DemographicInformation"/>
        <ncit2:synonym xml:lang="en">Country of Origin</ncit2:synonym>
        <umls3:cui xml:lang="en">C1300001</umls3:cui>
        <rdfs:comment xml:lang="en">Country which a person was born in.</rdfs:comment>
        <rdfs:label xml:lang="en">Country of Birth</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Cousin -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Cousin">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
        <umls3:cui xml:lang="en">C0337580</umls3:cui>
        <rdfs:label xml:lang="en">Cousin</rdfs:label>
        <skos:definition xml:lang="en">A child of one&apos;s aunt or uncle or their descendents. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CraftHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CraftHobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Hobby"/>
        <rdfs:comment xml:lang="en">Hobby of making things by hand.</rdfs:comment>
        <rdfs:label xml:lang="en">Craft Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CreativePursuitActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CreativePursuitActivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">The activity characterized by originality of thought or inventiveness, e.g., creative writing.</rdfs:comment>
        <rdfs:label xml:lang="en">Creative Pursuit Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CrowdedEnvironment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CrowdedEnvironment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialEnvironmentCausativeFactor"/>
        <rdfs:comment xml:lang="en">Crowded surroundings with too many people</rdfs:comment>
        <rdfs:label xml:lang="en">Crowded Environment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CrushingOralMedicationForPeopleWithSwallowingDifficulty -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CrushingOralMedicationForPeopleWithSwallowingDifficulty">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssistingWithMedicationManagement"/>
        <rdfs:comment xml:lang="en">The activity of crushing oral medication for people with swallowing difficulty to easily take the medication.</rdfs:comment>
        <rdfs:label xml:lang="en">Crushing Oral Medication for People with Swallowing Difficulty</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CulturalBackground -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CulturalBackground">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DemographicInformation"/>
        <ncit2:synonym xml:lang="en">Culture Background, Culture</ncit2:synonym>
        <umls3:cui xml:lang="en">C0010447</umls3:cui>
        <rdfs:label xml:lang="en">Culture Background</rdfs:label>
        <skos:definition xml:lang="en">The process by which the dominant symbols, acts, or meanings of a society reinforce the perspective of a dominant group while making invisible, stereotyped, or marked as &quot;other&quot; the variations in symbols, acts, and meanings from culture to culture.in the perspectives of subordinate or targeted groups. This includes the presumed universality of the dominant group&apos;s experience, culture, and religion. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CulturalSupportWorker -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CulturalSupportWorker">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Person"/>
        <rdfs:comment xml:lang="en">Cultural Support Workers support non-Indigenous foster carers and staff to better understand the needs of Aboriginal and/or Torres Strait Islander people in care and to respond in a holistic way that considers family, spiritual, community and individual needs.</rdfs:comment>
        <rdfs:label xml:lang="en">Cultural Support Worker</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Cursing -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Cursing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyAggressiveBehaviour"/>
        <ncit2:synonym xml:lang="en">Swearing, Using Foul Language</ncit2:synonym>
        <umls3:cui xml:lang="en">C0233730</umls3:cui>
        <rdfs:comment xml:lang="en">The behaviour of using offensive language.</rdfs:comment>
        <rdfs:label xml:lang="en">Cursing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DanceTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DanceTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <umls3:cui xml:lang="en">C0010962</umls3:cui>
        <rdfs:label xml:lang="en">Dance Therapy</rdfs:label>
        <skos:definition xml:lang="en">The use of dancing for therapeutic purposes. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DateOfBirth -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DateOfBirth">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DemographicInformation"/>
        <ncit2:abbreviation xml:lang="en">DOB</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Birth Date</ncit2:synonym>
        <umls3:cui xml:lang="en">C0421451</umls3:cui>
        <rdfs:label xml:lang="en">Date of Birth</rdfs:label>
        <skos:definition xml:lang="en">The calendar date on which a person was born. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Daughter -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Daughter">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
        <umls3:cui xml:lang="en">C0011011</umls3:cui>
        <rdfs:comment xml:lang="en">A female child of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Daughter</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DaughterInLaw -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DaughterInLaw">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
        <umls3:cui xml:lang="en">C1553705</umls3:cui>
        <rdfs:label xml:lang="en">Daughter-in-law</rdfs:label>
        <skos:definition xml:lang="en">The wife of one&apos;s son. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Daytime -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Daytime">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Time"/>
        <umls3:cui xml:lang="en">C0332169</umls3:cui>
        <rdfs:label xml:lang="en">Daytime</rdfs:label>
        <skos:definition xml:lang="en">Diurnal</skos:definition>
        <skos:definition xml:lang="en">The time between sunrise and sunset while it is light. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DaytimeSleepiness -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DaytimeSleepiness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SleepDisturbance"/>
        <ncit2:synonym xml:lang="en">Daytime Somnolence, Excessive Sleepiness during Day</ncit2:synonym>
        <umls3:cui xml:lang="en">C2219848</umls3:cui>
        <rdfs:comment xml:lang="en">Inappropriate sleepiness during the day.</rdfs:comment>
        <rdfs:label xml:lang="en">Daytime Sleepiness</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DeFactoPartner -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DeFactoPartner">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
        <ncit2:synonym xml:lang="en">Partner, Partner in Relationship, Significant Other</ncit2:synonym>
        <umls3:cui xml:lang="en">C0682323</umls3:cui>
        <rdfs:label xml:lang="en">De Factor Partner</rdfs:label>
        <skos:definition xml:lang="en">A person who is important to one&apos;s well being; especially a spouse or one in a similar relationship. From HL7V3.0</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DeathOfCloseFriend -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DeathOfCloseFriend">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TraumaticLifeEvent"/>
        <umls3:cui xml:lang="en">C0680093</umls3:cui>
        <rdfs:comment xml:lang="en">Death of a close friend of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Death of Close Friend</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DeathOfFamilyMember -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DeathOfFamilyMember">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TraumaticLifeEvent"/>
        <ncit2:synonym xml:lang="en">Death of Relative, Family Member Deceased, Family Member Dead, Relative Dead, Relative Deceased, Death of Family Member</ncit2:synonym>
        <umls3:cui xml:lang="en">C0425043</umls3:cui>
        <rdfs:label xml:lang="en">Death of Family Member</rdfs:label>
        <skos:definition xml:lang="en">The historical fact that a legal or consanguineous family member has died. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DecliningCare -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DecliningCare">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyNonaggressiveBehaviour"/>
        <ncit2:synonym xml:lang="en">Refusal of Care, Resisting Care</ncit2:synonym>
        <rdfs:comment xml:lang="en">Declining to be helped with personal care</rdfs:comment>
        <rdfs:label xml:lang="en">Declining Care</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DecliningToTakeMedication -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DecliningToTakeMedication">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DecliningCare"/>
        <ncit2:synonym xml:lang="en">Medication Refused, Refusal to Take Medication</ncit2:synonym>
        <umls3:cui xml:lang="en">C1319048</umls3:cui>
        <rdfs:comment xml:lang="en">Behaviour of declining to take prescribed medication</rdfs:comment>
        <rdfs:label xml:lang="en">Declining to Take Medication</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DecreaseInAppetite -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DecreaseInAppetite">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ChangeInAppetite"/>
        <ncit2:synonym xml:lang="en">Poor Appetite, Low Appetite, Reduced Appetite, Inappetence</ncit2:synonym>
        <umls3:cui xml:lang="en">C0232462</umls3:cui>
        <rdfs:comment xml:lang="en">The decreasing of one&apos;s desire to eat food.</rdfs:comment>
        <rdfs:label xml:lang="en">Decrease in Appetite</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DecreasedActivityOfDailyLiving -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DecreasedActivityOfDailyLiving">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnSelf"/>
        <rdfs:comment xml:lang="en">Decreased performance of the basic activities of self care, such as dressing and eating.</rdfs:comment>
        <rdfs:label xml:lang="en">Decreased Activity of Daily Living</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DecreasedNeedForSleep -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DecreasedNeedForSleep">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfEuphoriaInDementia"/>
        <umls3:cui xml:lang="en">C1862911</umls3:cui>
        <rdfs:comment xml:lang="en">Decreased need for sleep, in which someone can get by with little or no sleep and not feel tired as a result the next day.</rdfs:comment>
        <rdfs:label xml:lang="en">Decreased Need for Sleep</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DeepBreathingExercise -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DeepBreathingExercise">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BreathingExercise"/>
        <ncit2:synonym xml:lang="en">Diaphragmatic Breathing Exercise, Belly Breathing Exercise, Abdominal Breathing Exercise</ncit2:synonym>
        <umls3:cui xml:lang="en">C0454496</umls3:cui>
        <rdfs:comment xml:lang="en">The breathing exercise that helps lessen stress and anxiety. By breathing slower and more deeply from the stomach, a person signal the nervous system to calm down.</rdfs:comment>
        <rdfs:label xml:lang="en">Deep Breathing Exercise</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DegenerativePolyarthritis -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DegenerativePolyarthritis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:synonym xml:lang="en">Osteoarthritis, Osteoarthrosis, Degenerative Arthritides, Degenerative Arthritis, Degenerative Joint Disease</ncit2:synonym>
        <umls3:cui xml:lang="en">C0029408</umls3:cui>
        <rdfs:label xml:lang="en">Degenerative Polyarthritis</rdfs:label>
        <skos:definition xml:lang="en">A progressive, degenerative joint disease, the most common form of arthritis, especially in older persons. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dehydration -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dehydration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:synonym xml:lang="en">Pure Water Depletion Syndrome, Exsiccosis, Loss of Body Water, Deficient Fluid Volume, Body Water Dehydration</ncit2:synonym>
        <umls3:cui xml:lang="en">C0011175</umls3:cui>
        <rdfs:label xml:lang="en">Dehydration</rdfs:label>
        <skos:definition xml:lang="en">The condition that results from excessive loss of water from a living organism. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Delirium -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Delirium">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <umls3:cui xml:lang="en">C0011206</umls3:cui>
        <rdfs:label xml:lang="en">Delirium</rdfs:label>
        <skos:definition xml:lang="en">A usually reversible condition characterized by the acute and sudden development of confusion, illusions, movement changes, inattentiveness, agitation, and hallucinations. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DeliriumAssessment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DeliriumAssessment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthAssessment"/>
        <ncit2:synonym xml:lang="en">Delirium Screening, Assessment of Delirium, Delirium Screen</ncit2:synonym>
        <umls3:cui xml:lang="en">C4518226</umls3:cui>
        <rdfs:comment xml:lang="en">Delirium assessment aims to confirm the diagnosis, identify and treat the causes, and manage and relieve the symptoms, and collect information that is useful in developing treatment plans.</rdfs:comment>
        <rdfs:label xml:lang="en">Delirium Assessment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DeliveryModeOfNonpharmacologicalIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DeliveryModeOfNonpharmacologicalIntervention">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isDeliveryModeOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NonpharmacologicalIntervention"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The way of delivering the nonpharmacological intervention.</rdfs:comment>
        <rdfs:label xml:lang="en">Delivery Mode of Nonpharmacological Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Delusion -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Delusion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Psychosis"/>
        <ncit2:synonym xml:lang="en">Delusional Disorder, Delusional Idea, Delusional Symptom, Delusional Thought, Fixed Beliefs Contradicted by Reality, Delusional Belief, Psychotic Delusion</ncit2:synonym>
        <umls3:cui xml:lang="en">C0011253</umls3:cui>
        <rdfs:label xml:lang="en">Delusion</rdfs:label>
        <skos:definition xml:lang="en">A belief that is demonstrably untrue or not shared by others, usually based on incorrect inference about external reality. The belief is firmly held with conviction and is not, or is only briefly, susceptibel to modification by experience or evidence that contradicts it. The belief is not ordinarily accepted by other members or the person&apos;s culture or subculture (i.e., it is not an article of religious faith). From ICD-11</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DemandingBehaviour -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DemandingBehaviour">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfAnxietyInDementia"/>
        <ncit2:synonym xml:lang="en">Demanding Behavior</ncit2:synonym>
        <umls3:cui xml:lang="en">C0562447</umls3:cui>
        <rdfs:comment xml:lang="en">Anxious care recipient may require considerable attention from health care professionals.</rdfs:comment>
        <rdfs:label xml:lang="en">Demanding Behaviour</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dementia">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#hasStage"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StageOfDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isDementiaOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonWithDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <umls3:cui xml:lang="en">C0497327</umls3:cui>
        <rdfs:label xml:lang="en">Dementia</rdfs:label>
        <skos:definition xml:lang="en">Dementia is an acquired brain syndrome characterized by a decline from a previous level of cognitive function with impairment in two or more cognitive domains (such as memory, executive functions, attention, language, social cognition and judgement, psychomotor speed, visuoperceptual or visuospatial abilities). The cognitive impairment is not entirely attributable to normal aging and significantly interferes with independence in the person&apos;s performance of activities of daily living. Based on available evidence, the cognitive impairment is attributed or assumed to be attributable to a neurological or medical condition that affects the brain, trauma, nutritional deficiency, chronic use of specific substances or medications, or exposure to heavy metals or other toxins. From ICD-11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaApathyInterviewAndRating -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaApathyInterviewAndRating">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#assesses"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApathyInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:abbreviation xml:lang="en">DAIR</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Dementia Apathy Interview and Rating Scale</ncit2:synonym>
        <rdfs:label xml:lang="en">Dementia Apathy Interview and Rating</rdfs:label>
        <skos:definition xml:lang="en">Dementia Apathy Interview and Rating (DAIR) is a 16-item informant-based assessment of apathy in persons with dementia. From Strauss ME, Sperry SD. An informant-based assessment of apathy in Alzheimer disease. Neuropsychiatry Neuropsychol Behav Neurol. 2002 Sep;15(3):176-83. PMID: 12218710.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToAlzheimerDisease -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToAlzheimerDisease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dementia"/>
        <ncit2:synonym xml:lang="en">Alzheimer Disease Dementia</ncit2:synonym>
        <umls3:cui xml:lang="en">C0002395</umls3:cui>
        <rdfs:label xml:lang="en">Dementia due to Alzheimer Disease</rdfs:label>
        <skos:definition xml:lang="en">Dementia due to Alzheimer disease is the most common form of dementia. Onset is insidious with memory impairment typically reported as the initial presenting complaint. The characteristic course is a slow but steady decline from a previous level of cognitive functioning with impairment in additional cognitive domains (such as executive functions, attention, language, social cognition and judgment, psychomotor speed, visuoperceptual or visuospatial abilities) emerging with disease progressing. From ICD-11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToAlzheimerDiseaseWithEarlyOnset -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToAlzheimerDiseaseWithEarlyOnset">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToAlzheimerDisease"/>
        <rdfs:label xml:lang="en">Dementia due to Alzheimer Disease with Early Onset</rdfs:label>
        <skos:definition xml:lang="en">Dementia due to Alzheimer disease in which symptoms emerge before the age of 65 years. It is relatively rare, representing less than 5% of all cases, and may be genetically determined (autosomal dominant Alzheimer disease). Clinical presentation may be similar to cases with later onset, but a significant proportion of cases manifest atypical symptoms, with relatively less severe memory deficits. From ICD11 version 09/2020.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToAlzheimerDiseaseWithLateOnset -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToAlzheimerDiseaseWithLateOnset">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToAlzheimerDisease"/>
        <rdfs:label xml:lang="en">Dementia due to Alzheimer Disease with Late Onset</rdfs:label>
        <skos:definition xml:lang="en">Dementia due to Alzheimer disease that develops at the age of 65 years or above. This is the most common pattern, representing more than 95% of all cases. From ICD11 Version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToCerebrovascularDisease -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToCerebrovascularDisease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dementia"/>
        <ncit2:abbreviation xml:lang="en">VaD</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Cerebrovascular Disease Dementia, Vascular Dementia</ncit2:synonym>
        <umls3:cui xml:lang="en">C0011269</umls3:cui>
        <rdfs:label xml:lang="en">Dementia due to Cerebrovascular Disease</rdfs:label>
        <skos:definition xml:lang="en">Vascular dementia is due to significant brain parenchyma injury resulting from cerebrovascular disease (ischemic or haemorrhagic). The onset of the cognitive deficits is temporally related to one or more vascular events. Cognitive decline is typically most prominent in speed of information processing, complex attention, and frontal-executive functioning. There is evidence of the presence of cerebrovascular disease considered to be sufficient to account for the neurocognitive deficits from history, physical examination and neuroimaging. From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToDownSyndrome -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToDownSyndrome">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dementia"/>
        <umls3:cui xml:lang="en">C4518638</umls3:cui>
        <rdfs:label xml:lang="en">Dementia due to Down Syndrome</rdfs:label>
        <skos:definition xml:lang="en">Dementia due to Down syndrome is a neurodegenerative disorder related to the impact of abnormal increased production and accumulation of amyloid precursor protein (APP) leading to formation of beta-amyloid plaques and tau tangles. APP gene expression is increased due to its location on chromosome 21, which is abnormally triplicated in Down syndrome. Cognitive deficits and neuropathological features are similar to those observed in Alzheimer disease. Onset is typically after the fourth decade of life with a gradual decline in functioning. From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToExposureToHeavyMetal -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToExposureToHeavyMetal">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dementia"/>
        <rdfs:label xml:lang="en">Dementia due to Exposure to Heavy Metal</rdfs:label>
        <skos:definition xml:lang="en">Dementia due to exposure to heavy metals caused by toxic exposure to specific heavy metals such as aluminium from dialysis water, lead, mercury or manganese. The characteristic cognitive impairments in Dementia due to exposure to heavy metals depend on the specific heavy metal that the individual has been exposed to but can affect all cognitive domains. Onset of symptoms is related to exposure and progression can be rapid especially with acute exposure. In many cases, symptoms are reversible when exposure is identified and ceases. Investigations such as brain imaging or neurophysiological testing may be abnormal. Lead poisoning is associated with abnormalities on brain imaging including widespread calcification and increased signal on MRI T2-weighted images of periventricular white matter, basal ganglia hypothalamus and pons. Dementia due to aluminium toxicity may demonstrate characteristic paroxysmal high-voltage delta EEG changes. Examination may make evident other features such as peripheral neuropathy in the case of lead, arsenic, or mercury. From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToHumanimmunodeficiencyVirus -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToHumanimmunodeficiencyVirus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dementia"/>
        <rdfs:label xml:lang="en">Dementia due to Human Immunodeficiency Virus</rdfs:label>
        <skos:definition xml:lang="en">Dementia due to human immunodeficiency virus develops during the course of confirmed HIV disease, in the absence of a concurrent illness or condition other than HIV infection that could explain the clinical features. Although a variety of patterns of cognitive deficit are possible depending on where the HIV pathogenic processes have occurred, typically deficits follow a subcortical pattern with impairments in executive function, processing speed, attention, and learning new information. The course of Dementia due to human immunodeficiency virus varies including resolution of symptoms, gradual decline in functioning, improvement, or fluctuation in symptoms. Rapid decline in cognitive functioning is rare with the advent of antiretroviral medications. From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToHuntingtonDisease -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToHuntingtonDisease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dementia"/>
        <ncit2:synonym xml:lang="en">Dementia due to Huntington Chorea</ncit2:synonym>
        <umls3:cui xml:lang="en">C0236961</umls3:cui>
        <rdfs:label xml:lang="en">Dementia due to Huntington Disease</rdfs:label>
        <skos:definition xml:lang="en">Dementia due to Huntington disease occurs as part of a widespread degeneration of the brain due to a trinucleotide repeat expansion in the HTT gene, which is transmitted through autosomal dominance. Onset of symptoms is insidious typically in the third and fourth decade of life with gradual and slow progression. Initial symptoms typically include impairments in executive functions with relative sparing of memory, prior to the onset of motor deficits (bradykinesia and chorea) characteristic of Huntington disease. From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToInjuryToTheHead -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToInjuryToTheHead">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dementia"/>
        <umls3:cui xml:lang="en">C4546139</umls3:cui>
        <rdfs:label xml:lang="en">Dementia due to Injury to the Head</rdfs:label>
        <skos:definition xml:lang="en">Dementia due to injury to the head is caused by damage inflicted on the tissues of the brain as the direct or indirect result of an external force. Trauma to the brain is known to have resulted in loss of consciousness, amnesia, disorientation and confusion, or neurological signs. The symptoms characteristic of Dementia due to injury to the head must arise immediately following the trauma or after the individual gains consciousness and must persist beyond the acute post-injury period. Cognitive deficits vary depending on the specific brain areas affected and the severity of the injury but can include impairments in attention, memory, executive functioning, personality, processing speed, social cognition, and language abilities. From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToLewyBodyDisease -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToLewyBodyDisease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dementia"/>
        <ncit2:synonym xml:lang="en">Dementia with Lewy Body, Lewy Body Dementia, Lewy Body Disease Dementia</ncit2:synonym>
        <umls3:cui xml:lang="en">C0752347</umls3:cui>
        <rdfs:label xml:lang="en">Dementia due to Lewy Body Disease</rdfs:label>
        <skos:definition xml:lang="en">Dementia due to Lewy body disease is the second most common form of dementia in the elderly after Alzheimer disease. The precise etiology is unknown but involves abnormal alpha-synuclein protein folding and aggregation with Lewy body formation primarily in the cortex and brainstem. Onset is insidious with attentional and executive functioning deficits typically reported as the initial presenting complaint. These cognitive deficits are often accompanied by visual hallucination and symptoms of REM sleep behaviour disorder. Hallucinations in other sensory modalities, depressive symptoms, and delusions may also be present. The symptom presentation usually varies significantly over the course of days necessitating longitudinal assessment and differentiation from Delirium. Sontaneous onset of Parkinsonism within approximately 1 year of the onset of cognitive symptoms is characteristic of the disease. From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToMultipleSclerosis -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToMultipleSclerosis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dementia"/>
        <rdfs:label xml:lang="en">Dementia due to Multiple Sclerosis</rdfs:label>
        <skos:definition xml:lang="en">Dementia due to multiple sclerosis is a neurodegenerative disease due to the cerebral effects of multiple sclerosis, a demyelinating disease. Onset of symptoms is insidious and not related to the progression or functional impairment attributable to the primary disease (i.e., multiple sclerosis). Cognitive impairments vary according to the location of demyelination but typically include deficits in processing speed, memory, attention, and aspects of executive functioning. From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToNormalPressureHydrocephalus -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToNormalPressureHydrocephalus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dementia"/>
        <rdfs:label xml:lang="en">Dementia due to Normal Pressure Hydrocephalus</rdfs:label>
        <skos:definition xml:lang="en">Dementia due to normal pressure hydrocephalus results from excess accumulation of cerebrospinal fluid in the brain as a result of idiopathic, non-obstructive causes but can also be secondary to haemorrhage, infection or inflammation. Progression is gradual but intervention (e.g., shunt) can result in significant improvement of symptoms. Typically, cognitive impairments include reduced processing speed, deficits in executive functioning and attention, as well as personality changes. These symptoms are also typically accompanied by gait abnormalities and urinary incontinence. Brain imaging to reveal ventricular volume and brain displacement is often necessary to confirm the diagnosis. From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToParkinsonDisease -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToParkinsonDisease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dementia"/>
        <ncit2:abbreviation xml:lang="en">PDD</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Parkinson Disease Dementia</ncit2:synonym>
        <umls3:cui xml:lang="en">C0236960</umls3:cui>
        <rdfs:label xml:lang="en">Dementia due to Parkinson Disease</rdfs:label>
        <skos:definition xml:lang="en">Dementia due to Parkinson disease develops among individuals with idiopathic Parkinson disease and is characterized by impairment in attention, memory, executive and visuo-spatial functions as well as behavioural and psychiatric symptoms such as changes in affect, apathy and hallucinations. Onset is insidious and the course is one of gradual worsening of symptoms. The primary pathological correlat is Lewy Body-type degeneration predominantly in the basal ganglia rather than in the cortex as is typical of Dementia due to Lewy body disease. From ICD-11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToPellagra -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToPellagra">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dementia"/>
        <umls3:cui xml:lang="en">C5230201</umls3:cui>
        <rdfs:label xml:lang="en">Dementia due to Pellagra</rdfs:label>
        <skos:definition xml:lang="en">Dementia due to pellagra is caused by persistent lack of vitamin B3 (niacin) or tryptophan either in the diet or due to poor absorption in the gastrointestinal tract due to disease (e.g., Crohn disease) or due to the effects of some medications (e.g., isoniazid). Core signs of pellagra include dermatological changes (sensitivity to sunlight, lesions, alopecia, and oedema) and diarrhoea. With prolonged nutritional deficiency cognitive symptoms that include aggressivity, motor disturbances (ataxia and restlessness), confusion, and weakness are observed. Treatment with nutritional supplementation (e.g., niacin) typically results in reversal of symptoms. From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToPrionDisease -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToPrionDisease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dementia"/>
        <umls3:cui xml:lang="en">C4546138</umls3:cui>
        <rdfs:label xml:lang="en">Dementia due to Prion Disease</rdfs:label>
        <skos:definition xml:lang="en">Dementia due to prion disease is a primary neurodegenerative disease caused by a group of spongiform encephalopathies resulting from abnormal prion protein accumulation in the brain. These can be sporadic, genetic (caused by mutations in the prion-protein gene), or transmissible (acquired from an infected individual). Onset is insidious and there is a rapid progression of symptoms and impairment characterised by cognitive deficits, ataxia, and motor symptoms (myoclonus, chorea, or dystonia). Diagnosis is typically made on the basis of brain imaging studies, presence of characteristic proteins in spinal fluid, EEG, or genetic testing. From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToPsychoactiveSubstancesIncludingMedication -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToPsychoactiveSubstancesIncludingMedication">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dementia"/>
        <ncit2:synonym xml:lang="en">Dementia due to Psychoactive Substances including Medications</ncit2:synonym>
        <rdfs:label xml:lang="en">Dementia due to Psychoactive Substances including Medication</rdfs:label>
        <skos:definition xml:lang="en">Dementia due to psychoactive substances including medications includes forms of dementia that are judged to be a direct consequence of substance use and that persist beyond the usual duration of action or withdrawal syndrome associated with the substance. The amount and duration of substance use must be sufficient to produce the cognitive impairment. The cognitive impairment is not better accounted for by a disorder that is not induced by substances such as a dementia due to another medical condition. From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToUseOfAlcohol -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToUseOfAlcohol">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToPsychoactiveSubstancesIncludingMedication"/>
        <rdfs:label xml:lang="en">Dementia due to Use of Alcohol</rdfs:label>
        <skos:definition xml:lang="en">Dementia due to use of alcohol is characterised by the development of persistent cognitive impairments (e.g., memory problems, language impairment, and an inability to perform complex motor tasks) that meet the definitional requirements of Dementia that are judged to be a direct consequence of alcohol use and that persist beyond the usual duration of alcohol intoxication or acute withdrawal. The intensity and duration of alcohol use must have been sufficient to produce the cognitive impairment. The cognitive impairment is not better accounted for by a disorder or disease that is not induced by alcohol such as a dementia due to another disorder or disease classified elsewhere. From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToUseOfAnxiolytic -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToUseOfAnxiolytic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToPsychoactiveSubstancesIncludingMedication"/>
        <rdfs:label xml:lang="en">Dementia due to Use of Anxiolytic</rdfs:label>
        <skos:definition xml:lang="en">Dementia due to use of anxiolytics is characterised by the development of persistent cognitive impairments (e.g., memory problems, language impairment, and an inability to perform complex motor tasks) that meet the definitional requirements of Dementia that are judged to be a direct consequence of anxiolytic use and that persist beyond the usual duration of action or withdrawal syndrome associated with the substance. The amount and duration of anxiolytic use must be sufficient to produce the cognitive impairment. The cognitive impairment is not better accounted for by a disorder that is not induced by anxiolytics such as a dementia due to another medical condition. From ICD-11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToUseOfHypnotic -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToUseOfHypnotic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToPsychoactiveSubstancesIncludingMedication"/>
        <rdfs:label xml:lang="en">Dementia due to Use of Hypnotic</rdfs:label>
        <skos:definition xml:lang="en">Dementia due to use of hypnotics is characterised by the development of persistent cognitive impairments (e.g., memory problems, language impairment, and an inability to perform complex motor tasks) that meet the definitional requirements of Dementia that are judged to be a direct consequence of hypnotic use and that persist beyond the usual duration of action or withdrawal syndrome associated with the substance. The amount and duration of hypnotic use must be sufficient to produce the cognitive impairment. The cognitive impairment is not better accounted for by a disorder that is not induced by hypnotics such as a dementia due to another medical condition. From ICD-11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToUseOfSedative -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToUseOfSedative">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToPsychoactiveSubstancesIncludingMedication"/>
        <rdfs:label xml:lang="en">Dementia due to Use of Sedative</rdfs:label>
        <skos:definition xml:lang="en">Dementia due to use of sedatives is characterised by the development of persistent cognitive impairments (e.g., memory problems, language impairment, and an inability to perform complex motor tasks) that meet the definitional requirements of Dementia that are judged to be a direct consequence of sedative use and that persist beyond the usual duration of action or withdrawal syndrome associated with the substance. The amount and duration of sedative use must be sufficient to produce the cognitive impairment. The cognitive impairment is not better accounted for by a disorder that is not induced by sedativessuch as a dementia due to another medical condition. From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToUseOfVolatileInhalants -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToUseOfVolatileInhalants">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaDueToPsychoactiveSubstancesIncludingMedication"/>
        <rdfs:label xml:lang="en">Dementia due to Use of Volatile Inhalants</rdfs:label>
        <skos:definition xml:lang="en">&quot;Dementia due to use of volatile inhalants is characterised by the development of persistent cognitive impairments (e.g., memory problems, language impairment, and an inability to perform complex motor tasks) that meet the definitional requirements of Dementia that are judged to be a direct consequence of inhalant use or exposure and that persist beyond the usual duration of action or withdrawal syndrome associated with the substance. The amount and duration of inhalant use or exposure must be sufficient to be capable of producing the cognitive impairment. The cognitive impairment is not better accounted for by a disorder that is not induced by volatile inhalants such as a dementia due to another medical condition.&quot; From ICD11 version 09/2020</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaMoodAssessmentScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaMoodAssessmentScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">DMAS</ncit2:abbreviation>
        <rdfs:label xml:lang="en">Dementia Mood Assessment Scale</rdfs:label>
        <skos:definition xml:lang="en">The Dementia Mood Assessment Scale is a 24-item scale that rates observable mood and functional abilities. The first 17 items measure mood, whereas the remaining items measure severity of dementia. All but two items, sense of enjoyment and self-esteem, address negative moods. From Tappen, Ruth M, and Christine L Williams. “Development and testing of the Alzheimer&apos;s Disease and Related Dementias Mood Scale.” Nursing research vol. 57,6 (2008): 426-35. doi:10.1097/NNR.0b013e31818c3dcc</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaMoodPictureTest -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DementiaMoodPictureTest">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:abbreviation xml:lang="en">DMPT</ncit2:abbreviation>
        <rdfs:label xml:lang="en">Dementia Mood Picture Test</rdfs:label>
        <skos:definition xml:lang="en">The Dementia Mood Picture Test (DMPT) is designed to assess the affective state of people with dementia. Six different moods are depicted in six simple line drawing of a face: good mood, bad mood, happy, sad, angry and worried. From Ruth M Tappen and Charlotte Barry 1995 Assessment of affect in advanced Alzheimer&apos;s diseases: the dementia mood picture test. Journal of Gerontological Nursing, 21:3</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DemographicInformation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DemographicInformation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient"/>
        <ncit2:synonym xml:lang="en">Patient Demographic Information</ncit2:synonym>
        <umls3:cui xml:lang="en">C4318886</umls3:cui>
        <rdfs:comment xml:lang="en">Demographic information of a person</rdfs:comment>
        <rdfs:label xml:lang="en">Demographic Information</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DentalDisease -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DentalDisease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:synonym xml:lang="en">Dental Disorder, Disorder of teeth And Supporting Structures, Odontologic Disorder, Tooth Disorder</ncit2:synonym>
        <umls3:cui xml:lang="en">C1704330</umls3:cui>
        <rdfs:label xml:lang="en">Dental Disease</rdfs:label>
        <skos:definition xml:lang="en">A non-neoplastic or neoplastic (benign or malignant) disorder affecting the teeth. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dentist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dentist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalPractitioner"/>
        <ncit2:synonym xml:lang="en">Dental Practitioner, Dental Surgeon</ncit2:synonym>
        <umls3:cui xml:lang="en">C0011441</umls3:cui>
        <rdfs:label xml:lang="en">Dentist</rdfs:label>
        <skos:definition xml:lang="en">Individuals licensed to practice dentistry. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DepressionInDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DepressionInDementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isDepressionInDementiaOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonWithDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:synonym xml:lang="en">Depressive Mood in Dementia, Depressed Mood in Dementia, Low Mood in Dementia</ncit2:synonym>
        <rdfs:label xml:lang="en">Depression in Dementia</rdfs:label>
        <skos:definition xml:lang="en">Negative affective state characterised by low mood, sadness, emptiness, hopelessness, or dejection in people with dementia</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DepressionOfHealthCareProfessional -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DepressionOfHealthCareProfessional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnHealthCareProfessional"/>
        <rdfs:comment xml:lang="en">Emotional and mood disturbances of people with dementia contribute to depression of health care professionals.</rdfs:comment>
        <rdfs:label xml:lang="en">Depression of Health Care Professional</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DepressiveDisorder -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DepressiveDisorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MentalDisorder"/>
        <ncit2:synonym xml:lang="en">Depressive Illness</ncit2:synonym>
        <umls3:cui xml:lang="en">C0011581</umls3:cui>
        <rdfs:label xml:lang="en">Depressive Disorder</rdfs:label>
        <skos:definition xml:lang="en">Dysthymia is a chronic mood disorder characterised by persistent depressed mood present for at least two years, for most of the day and for more days than not. During the first two years of the disorder, there has never been a two week period during which the number and duration of symptoms were sufficient to meet the diagnostic requirements for a major depressive episode. From SNOMEDCT_US</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DescribingBaselineBehaviour -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DescribingBaselineBehaviour">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehaviouralObservation"/>
        <rdfs:comment xml:lang="en">The activity of describing a person&apos;s behaviours manifested at a normal condition or a beginning condition, that is used for comparison with changed behaviours.</rdfs:comment>
        <rdfs:label xml:lang="en">Describing Baseline Behaviour</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DescribingChangedBehaviour -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DescribingChangedBehaviour">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehaviouralObservation"/>
        <rdfs:comment xml:lang="en">The activity of describing what an individual does or how he/she acts in contrast with baseline behaviour (behaviour manifested at a normal condition).</rdfs:comment>
        <rdfs:label xml:lang="en">Describing Changed Behaviour</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DestroyingProperty -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DestroyingProperty">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicallyAggressiveBehaviour"/>
        <ncit2:synonym xml:lang="en">Destruction, Destroying</ncit2:synonym>
        <umls3:cui xml:lang="en">C1948029</umls3:cui>
        <rdfs:comment xml:lang="en">The behaviour of destroying properties.</rdfs:comment>
        <rdfs:label xml:lang="en">Destroying Property</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DiabetesMellitus -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DiabetesMellitus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:abbreviation xml:lang="en">DM</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Diabetes</ncit2:synonym>
        <umls3:cui xml:lang="en">C0011849</umls3:cui>
        <rdfs:label xml:lang="en">Diabetes Mellitus</rdfs:label>
        <skos:definition xml:lang="en">A heterogeneous group of disorders characterized by hyperglycemia and glucose intolerance. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Diarrhoea -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Diarrhoea">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:synonym xml:lang="en">Diarrhea</ncit2:synonym>
        <ncit2:synonym xml:lang="en">Watery Stool, Bowel Loose Movement</ncit2:synonym>
        <umls3:cui xml:lang="en">C0011991</umls3:cui>
        <rdfs:label xml:lang="en">Diarrhoea</rdfs:label>
        <skos:definition xml:lang="en">A disorder characterized by frequent and watery bowel movements. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dietitian -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dietitian">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessional"/>
        <ncit2:synonym xml:lang="en">Dietician</ncit2:synonym>
        <umls3:cui xml:lang="en">C3536818</umls3:cui>
        <rdfs:label xml:lang="en">Dietitian</rdfs:label>
        <skos:definition xml:lang="en">Persons specially trained and licensed in nutrition sciences and dietetics. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DifferentialDiagnosis -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DifferentialDiagnosis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthAssessment"/>
        <ncit2:synonym xml:lang="en">Differential Diagnoses</ncit2:synonym>
        <umls3:cui xml:lang="en">C0011906</umls3:cui>
        <rdfs:label xml:lang="en">Differential Diagnosis</rdfs:label>
        <skos:definition xml:lang="en">Determination of which one of two or more diseases or conditions a patient is suffering from by systematically comparing and contrasting results of diagnostic measures. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DimensionalApathyScale -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DimensionalApathyScale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#assesses"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ApathyInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:abbreviation xml:lang="en">DAS</ncit2:abbreviation>
        <rdfs:label xml:lang="en">Dimensional Apathy Scale</rdfs:label>
        <skos:definition xml:lang="en">The Dimensional Apathy Scale (DAS) assesses three apathy subtypes-executive, emotional, and initiation-and is sensitive and valid in amyotrophic lateral sclerosis (ALS), Alzheimer&apos;s disease (AD), and Parkinson&apos;s disease. From Radakovic R, McGrory S, Chandran S, Swingler R, Pal S, Stephenson L, Colville S, Newton J, Starr JM, Abrahams S. The brief Dimensional Apathy Scale: A short clinical assessment of apathy. Clin Neuropsychol. 2020 Feb;34(2):423-435. doi: 10.1080/13854046.2019.1621382. Epub 2019 Jun 3. PMID: 31154933.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DiminishedAbilityOfConcentration -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DiminishedAbilityOfConcentration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isManifestationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AnxietyInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isManifestationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DepressionInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The reduced ability to focus the mind on one thing.</rdfs:comment>
        <rdfs:label xml:lang="en">Diminished Ability of Concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DiminishedAbilityOfThinking -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DiminishedAbilityOfThinking">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfDepressionInDementia"/>
        <rdfs:comment xml:lang="en">The reduced ability of processing information, make connections, make decisions, and create new ideas.</rdfs:comment>
        <rdfs:label xml:lang="en">Diminished Ability of Thinking</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DiningRoom -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DiningRoom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#LocationOfManifestationOfEmotionalAndMoodDisturbance"/>
        <rdfs:comment xml:lang="en">A room or area in the long-term facility in which meals are eaten.</rdfs:comment>
        <rdfs:label xml:lang="en">Dining Room</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DinnerTime -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DinnerTime">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Time"/>
        <ncit2:synonym xml:lang="en">Dinnertime, Evening Meal, Supper Time</ncit2:synonym>
        <umls3:cui xml:lang="en">C0585040</umls3:cui>
        <rdfs:comment xml:lang="en">The time of people having evening meal.</rdfs:comment>
        <rdfs:label xml:lang="en">Dinner Time</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Discomfort -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Discomfort">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:synonym xml:lang="en">Body Discomfort</ncit2:synonym>
        <umls3:cui xml:lang="en">C2364135</umls3:cui>
        <rdfs:label xml:lang="en">Discomfort</rdfs:label>
        <skos:definition xml:lang="en">A feeling of mental or physical uneasiness, pain, or distress. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DiscomfortFromIllFittingDenture -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DiscomfortFromIllFittingDenture">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Discomfort"/>
        <rdfs:comment xml:lang="en">The discomfort from the denture that is of the wrong size or shape for the person wearing it.</rdfs:comment>
        <rdfs:label xml:lang="en">Discomfort from Ill-Fitting Denture</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DiscomfortFromIllFittingShoe -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DiscomfortFromIllFittingShoe">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Discomfort"/>
        <rdfs:comment xml:lang="en">The discomfort from the shoe that is of the wrong size or shape for the person wearing it.</rdfs:comment>
        <rdfs:label xml:lang="en">Discomfort from Ill-Fitting Shoe</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DisorganizedSpeech -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DisorganizedSpeech">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyNonaggressiveBehaviour"/>
        <umls3:cui xml:lang="en">C1866987</umls3:cui>
        <rdfs:comment xml:lang="en">The behaviour of speaking which arises from abnormal thought processes. A person having disorganized speech might talking with nonexistent entities, or quickly jumping from one unrelated topic to another. From https://www.goodtherapy.org/blog/psychopedia/disorganized-speech</rdfs:comment>
        <rdfs:label xml:lang="en">Disorganized Speech</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Disorientation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Disorientation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveImpairment"/>
        <umls3:cui xml:lang="en">C0233407</umls3:cui>
        <rdfs:comment xml:lang="en">The altered mental state. A disoriented person may not known their location and identity, or the time and date.</rdfs:comment>
        <rdfs:label xml:lang="en">Disorientation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DisruptingNormalRoutineOfHealthCareProfessional -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DisruptingNormalRoutineOfHealthCareProfessional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnHealthCareProfessional"/>
        <ncit2:synonym xml:lang="en">Disrupting Usual Routine of Health Care Professional</ncit2:synonym>
        <rdfs:comment xml:lang="en">Staff spending time on behaviour interventions may disrupt their usual routine.</rdfs:comment>
        <rdfs:label xml:lang="en">Disrupting Normal Routine of Health Care Professional</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DisruptiveVocalisation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DisruptiveVocalisation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Agitation"/>
        <ncit2:abbreviation xml:lang="en">DV</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Disruptive Vocalization, Vocally Disruptive Behavior, Vocally Disruptive Behaviour</ncit2:synonym>
        <umls3:cui xml:lang="en">C3697171</umls3:cui>
        <rdfs:label xml:lang="en">Disruptive Vocalisation</rdfs:label>
        <skos:definition xml:lang="en">Making vocal utterances that are distressing sounding and socially inappropriate due to their intensity, frequency, duration and/or setting, as a manifestation of some form of brain disease, usually dementia. From SNOMEDCT</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Distraction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Distraction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Distraction Therapy</ncit2:synonym>
        <umls3:cui xml:lang="en">C1369038</umls3:cui>
        <rdfs:label xml:lang="en">Distraction</rdfs:label>
        <skos:definition xml:lang="en">Purposeful diverting of attention or temporarily suppressing negative emotions and thoughts away from undesirable sensations. From the U.S. National Cancer Insitute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DisturbingOtherCareRecipient -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DisturbingOtherCareRecipient">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnOtherCareRecipient"/>
        <ncit2:synonym xml:lang="en">Disturbing Other Resident, Distress to Other Resident, Upset Other Resident</ncit2:synonym>
        <rdfs:comment xml:lang="en">The effect that emotional and mood disturbances of person with dementia might disturb other person living in the same long-term care facility.</rdfs:comment>
        <rdfs:label xml:lang="en">Disturbing Other Care Recipient</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DiversionalTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DiversionalTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <umls3:cui xml:lang="en">C0204581</umls3:cui>
        <rdfs:label xml:lang="en">Diverstional Therapy</rdfs:label>
        <skos:definition xml:lang="en">Diversional Therapy is a client centred practice [that] recognises that leisure and recreational experiences are the right of all individuals. From Diversional Recreation Therapy Australia. https://diversionaltherapy.org.au</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DogKeepingHobby -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DogKeepingHobby">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PetKeepingHobby"/>
        <rdfs:comment xml:lang="en">Hobby of keeping dogs as pets.</rdfs:comment>
        <rdfs:label xml:lang="en">Dog Keeping Hobby</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DollTherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DollTherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:comment xml:lang="en">Doll therapy involves offering dolls to adults who are living with dementia and other medical conditions with the goal of improving their comfort, engagement, and quality of life. From Verywell Health 2020 https://www.verywellhealth.com/therapeutic-doll-therapy-in-dementia-4155803</rdfs:comment>
        <rdfs:label xml:lang="en">Doll Therapy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DomesticViolence -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DomesticViolence">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TraumaticLifeEvent"/>
        <umls3:cui xml:lang="en">C1445903</umls3:cui>
        <rdfs:comment xml:lang="en">Information about the domestic violence experienced by a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Domestic Violence</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DowncastGaze -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DowncastGaze">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfDepressionInDementia"/>
        <rdfs:label xml:lang="en">Downcast Gaze</rdfs:label>
        <skos:definition xml:lang="en">The action of looking towards the ground, usually because of feeling sad or embarrassed.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DrinkPreference -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DrinkPreference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Preference"/>
        <rdfs:comment xml:lang="en">Drink/liquid a person prefer, e.g., tea or coffee.</rdfs:comment>
        <rdfs:label xml:lang="en">Drink Preference</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DrugAllergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DrugAllergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Allergy"/>
        <ncit2:synonym xml:lang="en">Drug Hypersensitivity, Medication Allergy, Medicine Allergy, Allergic Reaction to Drug</ncit2:synonym>
        <umls3:cui xml:lang="en">C0013182</umls3:cui>
        <rdfs:comment xml:lang="en">An allergy to a pharmaceutical product. From HL7V3.0</rdfs:comment>
        <rdfs:label xml:lang="en">Drug Allergy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DurationOfManifestationOfEmotionalAndMoodDisturbance -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DurationOfManifestationOfEmotionalAndMoodDisturbance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FeatureOfManifestationOfEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isDurationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfEmotionalAndMoodDisturbanceInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The time during which the manifestation of emotional and mood disturbances contintues.</rdfs:comment>
        <rdfs:label xml:lang="en">Duration of Manifestation of Emotional and Mood Disturbance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dysarthria -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dysarthria">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:synonym xml:lang="en">Dysarthosis, Dysarthrias, Dysarthric Speech, Difficulty Articulating Speech</ncit2:synonym>
        <umls3:cui xml:lang="en">C0013362</umls3:cui>
        <rdfs:label xml:lang="en">Dysarthria</rdfs:label>
        <skos:definition xml:lang="en">A disorder characterized by slow and slurred speech resulting from an inability to coordinate the muscles used in speech. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dysphasia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dysphasia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveImpairment"/>
        <umls3:cui xml:lang="en">C0973461</umls3:cui>
        <rdfs:label xml:lang="en">Dysphasia</rdfs:label>
        <skos:definition xml:lang="en">Impairment of verbal communication skills. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dysphoria -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dysphoria">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfDepressionInDementia"/>
        <ncit2:synonym xml:lang="en">Dysphoric Mood</ncit2:synonym>
        <umls3:cui xml:lang="en">C0233477</umls3:cui>
        <rdfs:label xml:lang="en">Dysphoria</rdfs:label>
        <skos:definition xml:lang="en">A profound state of unease or dissatisfaction. From Wikipedia</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dyspnea -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Dyspnea">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:synonym xml:lang="en">Breathlessness,  Shortness of Breath, Breath Shortness, Difficulty Breathing, Respiration Difficult, Short of Breath, Difficult to Breathe, Trouble Breathing</ncit2:synonym>
        <umls3:cui xml:lang="en">C0013404</umls3:cui>
        <rdfs:label xml:lang="en">Dyspnea</rdfs:label>
        <skos:definition xml:lang="en">Difficult or labored breathing. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Echolalia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Echolalia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#VerballyNonaggressiveBehaviour"/>
        <ncit2:synonym xml:lang="en">Echo Speech, Echophrasia, Echologia</ncit2:synonym>
        <umls3:cui xml:lang="en">C0013528</umls3:cui>
        <rdfs:label xml:lang="en">Echolalia</rdfs:label>
        <skos:definition xml:lang="en">Involuntary (&quot;parrot-like&quot;), meaningless repetition of a recently heard word, phrase, or song. From Adams et al, Principles of Neurology, th6 ed, p485)</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Eczema -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Eczema">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SkinProblem"/>
        <ncit2:synonym xml:lang="en">Dermatitis Eczematoid, Atopic Dermatitis, Eczematous Rash, Eczematous Dermatitis</ncit2:synonym>
        <umls3:cui xml:lang="en">C0013595</umls3:cui>
        <rdfs:label xml:lang="en">Eczema</rdfs:label>
        <skos:definition xml:lang="en">A form of dermatitis characterized by red, itchy, scaly, or crusty patches that can be chronic or intermittent. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EducationalStatus -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EducationalStatus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DemographicInformation"/>
        <ncit2:synonym xml:lang="en">Level of Education, Educational Achievement, Level of Educational Attainment, Educational Qualification, Education Level Completed, Level of Education Attained</ncit2:synonym>
        <umls3:cui xml:lang="en">C0013658</umls3:cui>
        <rdfs:label xml:lang="en">Educational Status</rdfs:label>
        <skos:definition xml:lang="en">Educational attainment or level of education of an individual. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceInDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceInDementia">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isEffectOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EmotionalAndMoodDisturbanceInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The consequence causing by emotional and mood disturbances in dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Effect of Emotional and Mood Disturbance in Dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnFamilyMember -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnFamilyMember">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:comment xml:lang="en">The consequence causing by a person&apos;s emotional and mood disturbances to his/her family members.</rdfs:comment>
        <rdfs:label xml:lang="en">Effect of Emotional and Mood Disturbance on Family Member</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnFriend -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnFriend">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:comment xml:lang="en">The consequence causing by a person&apos;s emotional and mood disturbances to his/her friends.</rdfs:comment>
        <rdfs:label xml:lang="en">Effect of Emotional and Mood Disturbance on Friend</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnHealthCareProfessional -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnHealthCareProfessional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:comment xml:lang="en">The consequence causing by a person&apos;s emotional and mood disturbances to the health care professionals who provide care to him/her.</rdfs:comment>
        <rdfs:label xml:lang="en">Effect of Emotional and Mood Disturbance on Health Care Professional</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnOtherCareRecipient -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnOtherCareRecipient">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:synonym xml:lang="en">Effect of Emotional and Mood Disturbance on Other Resident</ncit2:synonym>
        <rdfs:comment xml:lang="en">Consequence causing by the emotional and mood disturbances of a care recipient to other care recipients living in the same long-term care facility</rdfs:comment>
        <rdfs:label xml:lang="en">Effect of Emotional and Mood Disturbance on Other Care Recipient</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnSelf -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnSelf">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:comment xml:lang="en">The consequence causing by emotional and mood disturbances to oneself.</rdfs:comment>
        <rdfs:label xml:lang="en">Effect of Emotional and Mood Disturbance on Self</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnSociety -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnSociety">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:comment xml:lang="en">The consequence causing by emotional and mood disturbances to the society.</rdfs:comment>
        <rdfs:label xml:lang="en">Effect of Emotional and Mood Disturbance on Society</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Effective -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Effective">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectivenessLevelOfNonpharmacologicalIntervention"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NotEffective"/>
        <rdfs:comment xml:lang="en">Successful in producing a desired or intended result</rdfs:comment>
        <rdfs:label xml:lang="en">Effective</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectivenessLevelOfNonpharmacologicalIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectivenessLevelOfNonpharmacologicalIntervention">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isEffectivenessLevelOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NonpharmacologicalIntervention"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Effectiveness level of a nonpharmacological intervention.</rdfs:comment>
        <rdfs:label xml:lang="en">Effectiveness Level of Nonpharmacological Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EggAllergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EggAllergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FoodAllergy"/>
        <ncit2:synonym xml:lang="en">Allergy to Egg, Egg Hypersensitivity</ncit2:synonym>
        <umls3:cui xml:lang="en">C0559469</umls3:cui>
        <rdfs:label xml:lang="en">Egg Allergy</rdfs:label>
        <skos:definition xml:lang="en">Allergic reaction to eggs that is triggered by the immune system. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ElderAbuse -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ElderAbuse">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TraumaticLifeEvent"/>
        <ncit2:synonym xml:lang="en">Aged Abuse, Elderly Abuse</ncit2:synonym>
        <umls3:cui xml:lang="en">C4760646</umls3:cui>
        <rdfs:comment xml:lang="en">Information about the elder abuse (emotional, nutritional, financial, or physical maltreatment, exploitation, or abandonment of the older person generally) experienced by an older person.</rdfs:comment>
        <rdfs:label xml:lang="en">Elder Abuse</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ElectrolyteDisturbance -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ElectrolyteDisturbance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:synonym xml:lang="en">Electrolyte Imbalance, Electrolyte Disorder</ncit2:synonym>
        <umls3:cui xml:lang="en">C0342579</umls3:cui>
        <rdfs:label xml:lang="en">Electrolyte Disturbance</rdfs:label>
        <skos:definition xml:lang="en">Higher or lower than normal values for the serum electrolytes: usually affecting Na, K, CI, Ca, CO2, BUN. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Embarrassment -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Embarrassment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <umls3:cui xml:lang="en">C0679112</umls3:cui>
        <rdfs:label xml:lang="en">Embarrassment</rdfs:label>
        <skos:definition xml:lang="en">A feeling of self-consciousness, shame, or awkwardness. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EmotionalAndMoodDisturbanceEducationToFamilyMember -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EmotionalAndMoodDisturbanceEducationToFamilyMember">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMemberFocusedIntervention"/>
        <rdfs:comment xml:lang="en">The education about emotional and mood disturbances in dementia and related management strategies that are provided to family members of people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Emotional and Mood Disturbance Education to Family Member</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EmotionalAndMoodDisturbanceInDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EmotionalAndMoodDisturbanceInDementia">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#hasEffect"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#hasManifestation"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfEmotionalAndMoodDisturbanceInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isAssessedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#AssessmentToolForEmotionalAndMoodDisturbanceInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isCausedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CausativeFactorOfEmotionalAndMoodDisturbanceInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isEmotionalAndMoodDisturbanceOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonWithDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isTreatedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Intervention"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The disturbance in emotions and mood of people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Emotional and Mood Disturbance in Dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EmotionalDependency -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EmotionalDependency">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonalityTrait"/>
        <ncit2:synonym xml:lang="en">Dependency, Psychological Dependence</ncit2:synonym>
        <umls3:cui xml:lang="en">C0011546</umls3:cui>
        <rdfs:label xml:lang="en">Emotional Dependency</rdfs:label>
        <skos:definition xml:lang="en">The tendency of an individual to rely on others for advice, guidance, or support. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EmotionalDistress -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EmotionalDistress">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Agitation"/>
        <umls3:cui xml:lang="en">C0700361</umls3:cui>
        <rdfs:comment xml:lang="en">The highly unpleasant emotional reaction.</rdfs:comment>
        <rdfs:label xml:lang="en">Emotional Distress</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EmotionalReactivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EmotionalReactivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonalityTrait"/>
        <rdfs:comment xml:lang="en">Emotional response to an event</rdfs:comment>
        <rdfs:label xml:lang="en">Emotional Reactivity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EmotionalSupport -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EmotionalSupport">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <ncit2:synonym xml:lang="en">Psychological Support</ncit2:synonym>
        <umls3:cui xml:lang="en">C0600015</umls3:cui>
        <rdfs:label xml:lang="en">Emotional Support</rdfs:label>
        <skos:definition xml:lang="en">Actions performed to sustain a positive affective state. From Clinical Care Classification</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EncouragingCommunication -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EncouragingCommunication">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GivingEncouragement"/>
        <umls3:cui xml:lang="en">C2922288</umls3:cui>
        <rdfs:comment xml:lang="en">Nurses encourage people with dementia to communicate with other people.</rdfs:comment>
        <rdfs:label xml:lang="en">Encouraging Communication</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EncouragingPhysicalActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EncouragingPhysicalActivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GivingEncouragement"/>
        <umls3:cui xml:lang="en">C2922556</umls3:cui>
        <rdfs:comment xml:lang="en">The intervention that nursing staff encourage people with dementia to do physical activity.</rdfs:comment>
        <rdfs:label xml:lang="en">Encouraging Physical Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EncouragingToDrinkWater -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EncouragingToDrinkWater">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GivingEncouragement"/>
        <ncit2:synonym xml:lang="en">Encouraging to Drink, Prompting to Drink, Encouraging Hydration, Promoting Hydration</ncit2:synonym>
        <rdfs:comment xml:lang="en">The interventon that nursing staff encourage people with dementia to drink water.</rdfs:comment>
        <rdfs:label xml:lang="en">Encouraging to Drink Water</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EncouragingToEatFood -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EncouragingToEatFood">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#GivingEncouragement"/>
        <ncit2:synonym xml:lang="en">Encouraging to Eat, Prompting to Eat, Encouraging Nutritional Intake, Promoting Nutrition</ncit2:synonym>
        <rdfs:comment xml:lang="en">The intervention that nursing staff encourage people with dementia to eat food.</rdfs:comment>
        <rdfs:label xml:lang="en">Encouraging to Eat Food</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EndTime -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EndTime">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Time"/>
        <umls3:cui xml:lang="en">C1522314</umls3:cui>
        <rdfs:comment xml:lang="en">The time when something/event has ceased.</rdfs:comment>
        <rdfs:label xml:lang="en">End Time</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EndocrineImbalance -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EndocrineImbalance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:synonym xml:lang="en">Endocrine Disorder, Endocrine System Disease</ncit2:synonym>
        <umls3:cui xml:lang="en">C0014130</umls3:cui>
        <rdfs:comment xml:lang="en">The condition when there is too much or too little of a hormone in the bloodstream. Hormones are chemicals that are produced by glands in the endocrine system.</rdfs:comment>
        <rdfs:label xml:lang="en">Endocrine Imbalance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EngagingPersonInActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EngagingPersonInActivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <rdfs:comment xml:lang="en">Attracting a person to participate or become involved in an activity.</rdfs:comment>
        <rdfs:label xml:lang="en">Engaging Person in Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EnhancingVisualAccess -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EnhancingVisualAccess">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PhysicalEnvironmentalIntervention"/>
        <rdfs:comment xml:lang="en">Ensure that the people with dementia can see what they need to see from wherever they spend most of their time, such as putting a clock or a sign of where is the bathroom in a prominent place.</rdfs:comment>
        <rdfs:label xml:lang="en">Enhancing Visual Access</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EnrolledNurse -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EnrolledNurse">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Nurse"/>
        <ncit2:abbreviation xml:lang="en">EN</ncit2:abbreviation>
        <rdfs:label xml:lang="en">Enrolled Nurse</rdfs:label>
        <skos:definition xml:lang="en">An enrolled nurse is a person who has successfully completed an education program of study accredited by the Australian Nursing and Midwifery Accreditation Council and approved by the Nursing and Midwifery Board of Australia. The enrolled nurse provides nursing care, working under the direction, delegation and supervision of the registed nurse. From Australian Nursing and Midwifery Federation</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EnvironmentalCausativeFactor -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EnvironmentalCausativeFactor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CausativeFactorOfEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:synonym xml:lang="en">Environmental Stressor</ncit2:synonym>
        <rdfs:comment xml:lang="en">The environmental factors that may cause emotional and mood disturbances in people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Environmental Causative Factor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EnvironmentalModification -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EnvironmentalModification">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonWithDementiaFocusedIntervention"/>
        <ncit2:synonym xml:lang="en">Environment Modification, Environmental Rearrangement, Institutional Environmental Intervention, Environment Intervention</ncit2:synonym>
        <umls3:cui xml:lang="en">C0204546</umls3:cui>
        <rdfs:comment xml:lang="en">The intervention of modifying environment of people living with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Environmental Modification</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Epilepsy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Epilepsy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:abbreviation xml:lang="en">EP</ncit2:abbreviation>
        <ncit2:synonym xml:lang="en">Seizure Disorder, Epileptic Disorder</ncit2:synonym>
        <umls3:cui xml:lang="en">C0014544</umls3:cui>
        <rdfs:label xml:lang="en">Epilepsy</rdfs:label>
        <skos:definition xml:lang="en">A disorder characterized by recurrent episodes of paroxysmal brain dysfunction due to a sudden, disorderly, and excessive neuronal discharge. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Ergotherapy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Ergotherapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TherapyForEmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:comment xml:lang="en">Ergotherapy involves of practicing of retrained capabilities that are relevant to everyday life and of emotionally positive activities (e.g., cooking, gardening), with reference to the patient’s life history.</rdfs:comment>
        <rdfs:label xml:lang="en">Ergotherapy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EthnicBackground -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EthnicBackground">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#DemographicInformation"/>
        <ncit2:synonym xml:lang="en">Ethnic Group, Ethnicity</ncit2:synonym>
        <umls3:cui xml:lang="en">C0015031</umls3:cui>
        <rdfs:label xml:lang="en">Ethnic Background</rdfs:label>
        <skos:definition xml:lang="en">A group of people with a common cultural heritage that sets them apart from others in a variety of social relationships. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EuphoriaInDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EuphoriaInDementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EmotionalAndMoodDisturbanceInDementia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isEuphoriaInDementiaOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonWithDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:synonym xml:lang="en">Euphoric Mood in Dementia</ncit2:synonym>
        <rdfs:label xml:lang="en">Euphoria in Dementia</rdfs:label>
        <skos:definition xml:lang="en">An exaggerated felling of physical and emotional well-being and vitality in people with dementia</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Evaluation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Evaluation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManagementActivityOfEmotionalAndMoodDisturbanceInDementia"/>
        <ncit2:synonym xml:lang="en">Effectiveness Assessment, Efficacy Assessment</ncit2:synonym>
        <umls3:cui xml:lang="en">C0220825</umls3:cui>
        <rdfs:comment xml:lang="en">The activity of evaluating the effectiveness of the intervention, after the administration of the intervention.</rdfs:comment>
        <rdfs:label xml:lang="en">Evaluation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Evening -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Evening">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Time"/>
        <ncit2:synonym xml:lang="en">During the Evening</ncit2:synonym>
        <umls3:cui xml:lang="en">C0587117</umls3:cui>
        <rdfs:label xml:lang="en">Evening</rdfs:label>
        <skos:definition xml:lang="en">The time period between late afternoon and bedtime. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ExcessiveWorry -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ExcessiveWorry">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfAnxietyInDementia"/>
        <ncit2:synonym xml:lang="en">Excessive Worrying</ncit2:synonym>
        <umls3:cui xml:lang="en">C1389783</umls3:cui>
        <rdfs:label xml:lang="en">Excessive Worry</rdfs:label>
        <skos:definition xml:lang="en">Feelings of worry that interfere with a person&apos;s daily life and seem to be persistent or are excessive for the situation, or cause distress. From healthdirect.gov.au</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ExecutiveDysfunction -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ExecutiveDysfunction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CognitiveImpairment"/>
        <ncit2:synonym xml:lang="en">Executive Function Disorder, Executive Functioning Deficit, Impairment of Executive Functions</ncit2:synonym>
        <umls3:cui xml:lang="en">C2748208</umls3:cui>
        <rdfs:label xml:lang="en">Executive Dysfunction</rdfs:label>
        <skos:definition xml:lang="en">Cognitive, emotional, and behavioral difficulties that often occur in conjunction with frontal lobe disorders, including traumatic injury and dementia. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ExercisePhysiologist -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ExercisePhysiologist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#HealthCareProfessional"/>
        <ncit2:synonym xml:lang="en">Clinical Exercise Physiologist</ncit2:synonym>
        <rdfs:comment xml:lang="en">A clinical exercise physiologist is a health care professional who is specialise in clinical exercise intervention for people with a broad range of health issues. Those people may be at risk of developing, or have existing, medical conditions and injuries.</rdfs:comment>
        <rdfs:label xml:lang="en">Exercise Physiologist</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Exhusband -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Exhusband">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
        <rdfs:label xml:lang="en">Ex-husband</rdfs:label>
        <skos:definition xml:lang="en">A man to whom someone was formerly married, from whom they are now divorced. From Oxford Languages</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ExplanationOfNursingCare -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ExplanationOfNursingCare">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NursingPracticeIntervention"/>
        <umls3:cui xml:lang="en">C4715424</umls3:cui>
        <rdfs:comment xml:lang="en">The activity of giving a reason for a nursing care action.</rdfs:comment>
        <rdfs:label xml:lang="en">Explanation of Nursing Care</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ExposureToCombat -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ExposureToCombat">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#TraumaticLifeEvent"/>
        <ncit2:synonym xml:lang="en">Combat Exposure</ncit2:synonym>
        <umls3:cui xml:lang="en">C0557345</umls3:cui>
        <rdfs:comment xml:lang="en">Information about the combat exposure of a person (a military service member) .</rdfs:comment>
        <rdfs:label xml:lang="en">Exposure to Combat</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ExpressingAngerOfHealthCareProfessional -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ExpressingAngerOfHealthCareProfessional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehaviourOfHealthCareProfessional"/>
        <rdfs:comment xml:lang="en">The health care professional&apos;s behaviour of expressing his/her anger -a strong emotional feeling of displeasure.</rdfs:comment>
        <rdfs:label xml:lang="en">Expressing Anger of Health Care Professional</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ExpressingAnxietyOfHealthCareProfessional -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ExpressingAnxietyOfHealthCareProfessional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehaviourOfHealthCareProfessional"/>
        <rdfs:comment xml:lang="en">The health care professional&apos;s behaviour of expressing his/her anxiety.</rdfs:comment>
        <rdfs:label xml:lang="en">Expressing Anxiety of Health Care Professional</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ExpressingDepressionOfHealthCareProfessional -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ExpressingDepressionOfHealthCareProfessional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BehaviourOfHealthCareProfessional"/>
        <rdfs:comment xml:lang="en">The health care professional&apos;s behaviour of expressing his/her depressed mood.</rdfs:comment>
        <rdfs:label xml:lang="en">Expressing Depression of Health Care Professional</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ExpressingGratitude -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ExpressingGratitude">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionSuggested"/>
        <rdfs:comment xml:lang="en">People should express gratitude when communicating with people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Expressing Gratitude</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Extraversion -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Extraversion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonalityTrait"/>
        <umls3:cui xml:lang="en">C0015382</umls3:cui>
        <rdfs:label xml:lang="en">Extraversion</rdfs:label>
        <skos:definition xml:lang="en">Personality trait which reflects the extent to which an individual likes people and prefers large gatherings; is assertive, active and talkative; enjoys excitement and stimulation; and tends to have a cheerful disposition. From Psychological Index Terms</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ExtremelyEffective -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ExtremelyEffective">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Effective"/>
        <terms:source xml:lang="en">Wiskow, K. M., Donaldson, J. M., &amp; Matter, A. L. (2017). An evaluation of generalization of compliance across response types. Behavior Analysis: Research and Practice, 17(4), 402-420. http://dx.doi.org/10.1037/bar0000087</terms:source>
        <rdfs:comment xml:lang="en">Extremely successful in producing a desired or intended result</rdfs:comment>
        <rdfs:label xml:lang="en">Extremely Effective</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Exwife -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Exwife">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
        <rdfs:label xml:lang="en">Ex-wife</rdfs:label>
        <skos:definition xml:lang="en">A woman to whom someone was formerly married, from whom they are now divorced. From Oxford Languages</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FactorAffectingImplementationOfNonpharmacologicalIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FactorAffectingImplementationOfNonpharmacologicalIntervention">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#affectsImplementationOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NonpharmacologicalIntervention"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The factors that could affect the implementation of nonpharmacological interventions to emotional and mood disturbances in dementia in the long term care facility.</rdfs:comment>
        <rdfs:label xml:lang="en">Factor Affecting Implementation of Nonpharmacological Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FailureOfRehabilitation -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FailureOfRehabilitation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#EffectOfEmotionalAndMoodDisturbanceOnSelf"/>
        <rdfs:comment xml:lang="en">The failure of interventions designed to optimize functioning and reduce disability in people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Failure of Rehabilitation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Fall -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Fall">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <ncit2:synonym xml:lang="en">Falling, Fall Down</ncit2:synonym>
        <umls3:cui xml:lang="en">C0085639</umls3:cui>
        <rdfs:label xml:lang="en">Fall</rdfs:label>
        <skos:definition xml:lang="en">A sudden movement downward, usually resulting in injury. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyHistoryOfMentalDisorder -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyHistoryOfMentalDisorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#BackgroundOfCareRecipient"/>
        <umls3:cui xml:lang="en">C0455379</umls3:cui>
        <rdfs:comment xml:lang="en">A person&apos;s family history about mental disorders.</rdfs:comment>
        <rdfs:label xml:lang="en">Family History of Mental Disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyImmigration -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyImmigration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ImmigrationType"/>
        <rdfs:comment xml:lang="en">Type of immigration that people choose to live in another country to join their families.</rdfs:comment>
        <rdfs:label xml:lang="en">Family Immigration</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#conducts"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMemberVisit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isFamilyMemberOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CareRecipient"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:synonym xml:lang="en">Person in the Family</ncit2:synonym>
        <umls3:cui xml:lang="en">C0086282</umls3:cui>
        <rdfs:comment xml:lang="en">The family members of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Family Member</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMemberFocusedIntervention -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMemberFocusedIntervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#NonpharmacologicalIntervention"/>
        <rdfs:comment xml:lang="en">The interventions targeting family members of people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Family Member Focused Intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMemberVisit -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMemberVisit">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#SocialInteractionIntervention"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isConductedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ncit2:synonym xml:lang="en">Family Visit</ncit2:synonym>
        <rdfs:comment xml:lang="en">The treatment that involves having family members of the person with dementia to visit him/her in the long-term care facility.</rdfs:comment>
        <rdfs:label xml:lang="en">Family Member Visit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyName -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyName">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#PersonName"/>
        <ncit2:synonym xml:lang="en">Surname, Last Name</ncit2:synonym>
        <umls3:cui xml:lang="en">C1301584</umls3:cui>
        <rdfs:label xml:lang="en">Family Name</rdfs:label>
        <skos:definition xml:lang="en">Family name of person. From SNOMEDCT</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyRole -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyRole">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#RoleIdentity"/>
        <ncit2:synonym xml:lang="en">Family Role (History)</ncit2:synonym>
        <umls3:cui xml:lang="en">C0680074</umls3:cui>
        <rdfs:comment xml:lang="en">The role (or character) people play in family.</rdfs:comment>
        <rdfs:label xml:lang="en">Family Role</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Father -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Father">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FamilyMember"/>
        <ncit2:synonym xml:lang="en">Dad</ncit2:synonym>
        <umls3:cui xml:lang="en">C0015671</umls3:cui>
        <rdfs:comment xml:lang="en">A male parent of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Father</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Fatigue -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Fatigue">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#IntrapersonalCausativeFactor"/>
        <ncit2:synonym xml:lang="en">Lassitude, Decreased Energy, Energy Loss, Lack of Energy, Tired, Tired All the Time, Tiredness, Tired Out, Weariness</ncit2:synonym>
        <umls3:cui xml:lang="en">C0015672</umls3:cui>
        <rdfs:label xml:lang="en">Fatigue</rdfs:label>
        <skos:definition xml:lang="en">The state of weariness following a period of exertion, mental or physical, characterized by a decreased capacity for work and reduced efficiency to respond to stimuli. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Fear -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Fear">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfAnxietyInDementia"/>
        <ncit2:synonym xml:lang="en">Fright, Afraid, Fearfulness, Frightening, Scared</ncit2:synonym>
        <umls3:cui xml:lang="en">C0015726</umls3:cui>
        <rdfs:label xml:lang="en">Fear</rdfs:label>
        <skos:definition xml:lang="en">Emotional response or feeling characterized by being afraid, apprehensive or worried from an actual, anticipated or perceived danger or threat. From Perioperative Nursing Data Set</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FearOfBathing -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FearOfBathing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Fear"/>
        <ncit2:synonym xml:lang="en">Ablutophobia</ncit2:synonym>
        <rdfs:label xml:lang="en">Fear of Bathing</rdfs:label>
        <skos:definition xml:lang="en">The overwhelming fear of bathing, cleaning, or washing. From Healthline https://www.healthline.com/health/ablutophobia</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FearOfBeingAbandoned -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FearOfBeingAbandoned">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Fear"/>
        <ncit2:synonym xml:lang="en">Fear of Abandonment</ncit2:synonym>
        <umls3:cui xml:lang="en">C3875022</umls3:cui>
        <rdfs:comment xml:lang="en">The fear of a person that people close to him/her will leave.</rdfs:comment>
        <rdfs:label xml:lang="en">Fear of Being Abandoned</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FearOfBeingAlone -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FearOfBeingAlone">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Fear"/>
        <ncit2:synonym xml:lang="en">Autophobia, Monophobia</ncit2:synonym>
        <umls3:cui xml:lang="en">C1821975</umls3:cui>
        <rdfs:label xml:lang="en">Fear of Being Alone</rdfs:label>
        <skos:definition xml:lang="en">The fear of being alone or lonely. Being alone, even in a usually comforting place like home, can result in severe anxiety for people with this condition. People with autophobia feel they need another person or other people around in order to feel safe. From Healthline https://www.healthline.com/health/autophobia</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FearOfCrowd -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FearOfCrowd">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Fear"/>
        <ncit2:synonym xml:lang="en">Fear of Crowded Places, Ochlophobia, Crowd Fear</ncit2:synonym>
        <umls3:cui xml:lang="en">C0701849</umls3:cui>
        <rdfs:comment xml:lang="en">Fear of a group of people gathered together</rdfs:comment>
        <rdfs:label xml:lang="en">Fear of Crowd</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FearOfDark -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FearOfDark">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Fear"/>
        <ncit2:synonym xml:lang="en">Fear of the Dark</ncit2:synonym>
        <umls3:cui xml:lang="en">C2939430</umls3:cui>
        <rdfs:comment xml:lang="en">The fear of darkness.</rdfs:comment>
        <rdfs:label xml:lang="en">Fear of Dark</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FearOfFalling -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FearOfFalling">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Fear"/>
        <ncit2:synonym xml:lang="en">Fall Fear</ncit2:synonym>
        <umls3:cui xml:lang="en">C0877040</umls3:cui>
        <rdfs:comment xml:lang="en">The fear of falling (lose one&apos;s balance and collapse).</rdfs:comment>
        <rdfs:label xml:lang="en">Fear of Falling</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FearOfTransferring -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FearOfTransferring">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Fear"/>
        <rdfs:comment xml:lang="en">The fear of a person about being transferred from one place to another.</rdfs:comment>
        <rdfs:label xml:lang="en">Fear of Transferring</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FeatureOfManifestationOfEmotionalAndMoodDisturbanceInDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FeatureOfManifestationOfEmotionalAndMoodDisturbanceInDementia">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#isFeatureOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfEmotionalAndMoodDisturbanceInDementia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The distinctive attributes of manifestation of emotional and mood disturbances in dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Feature of Manifestation of Emotional and Mood Disturbance in Dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FecalIncontinence -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FecalIncontinence">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Incontinence"/>
        <ncit2:synonym xml:lang="en">Bowel Incontinence, Anal Incontinence, Feces Incontinence, Unable to Restrain Bowel Movement, Incontinent of Stool</ncit2:synonym>
        <umls3:cui xml:lang="en">C0015732</umls3:cui>
        <rdfs:label xml:lang="en">Fecal Incontinence</rdfs:label>
        <skos:definition xml:lang="en">Involuntary passage of stool from the rectum. From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FeelingDiscouraged -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FeelingDiscouraged">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfDepressionInDementia"/>
        <rdfs:comment xml:lang="en">Feeling of having lost confidence or enthusiasm</rdfs:comment>
        <rdfs:label xml:lang="en">Feeling Discouraged</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FeelingEmpty -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FeelingEmpty">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfDepressionInDementia"/>
        <ncit2:synonym xml:lang="en">Feeling of Emptiness</ncit2:synonym>
        <rdfs:comment xml:lang="en">The feeling of a lack of meaning or purpose.</rdfs:comment>
        <rdfs:label xml:lang="en">Feeling Empty</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FeelingHopeless -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FeelingHopeless">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfDepressionInDementia"/>
        <ncit2:synonym xml:lang="en">Hoplessness, Feeling of Hopelessness, Loss of Hope for the Future</ncit2:synonym>
        <umls3:cui xml:lang="en">C0150041</umls3:cui>
        <rdfs:label xml:lang="en">Feeling Hopeless</rdfs:label>
        <skos:definition xml:lang="en">The despair you feel when you have abandoned hope of comfort or success.From the U.S. National Cancer Institute Thesaurus</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FeelingOfExcessiveGuilt -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FeelingOfExcessiveGuilt">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfDepressionInDementia"/>
        <rdfs:comment xml:lang="en">Feeling excessively regretful for a perceived offence, real or imaginary.</rdfs:comment>
        <rdfs:label xml:lang="en">Feeling of Excessive Guilt</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FeelingSad -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FeelingSad">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfDepressionInDementia"/>
        <ncit2:synonym xml:lang="en">Feeling Unhappy</ncit2:synonym>
        <rdfs:comment xml:lang="en">Feeling of sorrow or unhappy</rdfs:comment>
        <rdfs:label xml:lang="en">Feeling Sad</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FeelingWorthless -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FeelingWorthless">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#ManifestationOfDepressionInDementia"/>
        <ncit2:synonym>Feeling Useless</ncit2:synonym>
        <umls3:cui xml:lang="en">C4715182</umls3:cui>
        <rdfs:comment xml:lang="en">Feeling useless, or believing that oneself has nothing valuable to offer the world</rdfs:comment>
        <rdfs:label xml:lang="en">Feeling Worthless</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Female -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Female">
