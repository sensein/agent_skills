        <rdfs:comment xml:lang="en">Festival that a person prefers to celebrate and enjoy.</rdfs:comment>
        <rdfs:label xml:lang="en">Festival Preference</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Fever -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Fever">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#MedicalIllness"/>
        <ncit2:synonym xml:lang="en">Pyrexia, Body Temperature Above Reference Range, Hyperthermai, Increased Body Temperature, Has a Temperature, High Body Temperature, Temperature Elevated, Feverish</ncit2:synonym>
        <umls3:cui xml:lang="en">C0015967</umls3:cui>
        <rdfs:label xml:lang="en">Fever</rdfs:label>
        <skos:definition xml:lang="en">An abnormal elevation of body temperature, usually as a result of a pathologic process. From MeSH</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Fidgeting -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Fidgeting">
