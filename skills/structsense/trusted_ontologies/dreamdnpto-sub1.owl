                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The relationship - Time &apos;is time of&apos;  Management Activity of Emotional and Mood disturbance/Manifestation of Emotional and Mood Disturbance in Dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">is time of</rdfs:label>
    </owl:ObjectProperty>
    


