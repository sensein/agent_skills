        <rdfs:label xml:lang="en">Floor Game</rdfs:label>
        <rdfs:label xml:lang="en">The game that can be played on floors, e.g., floor chess game.</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FoldingClothes -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FoldingClothes">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">The organized activity of folding clothes.</rdfs:comment>
        <rdfs:label xml:lang="en">Folding Clothes</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FoldingTowel -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FoldingTowel">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#StructuredActivity"/>
        <rdfs:comment xml:lang="en">The organized activity of folding towels.</rdfs:comment>
        <rdfs:label xml:lang="en">Folding Towel</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FoodAllergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FoodAllergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Allergy"/>
        <ncit2:synonym xml:lang="en">Allergy to Food</ncit2:synonym>
        <umls3:cui xml:lang="en">C0016470</umls3:cui>
        <rdfs:comment xml:lang="en">Food allergy is an abnormal response to a food triggered by human body&apos;s immune system. From MEDLINEPLUS</rdfs:comment>
        <rdfs:label xml:lang="en">Food Allergy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FoodPreference -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FoodPreference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Preference"/>
        <umls3:cui xml:lang="en">C0016483</umls3:cui>
        <rdfs:comment xml:lang="en">Preference to one food over another.</rdfs:comment>
        <rdfs:label xml:lang="en">Food Preference</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FootPreference -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FootPreference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#Preference"/>
        <rdfs:comment xml:lang="en">Foot preference is the tendency to be more skilled and comfortable using one foot instead of the other for tasks.</rdfs:comment>
        <rdfs:label xml:lang="en">Foot Preference</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FootyTippingActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FootyTippingActivity">
