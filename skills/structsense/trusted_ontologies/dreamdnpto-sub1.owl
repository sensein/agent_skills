        <umls3:cui xml:lang="en">C0424324</umls3:cui>
        <rdfs:comment xml:lang="en">The behaviour of fighting.</rdfs:comment>
        <rdfs:label xml:lang="en">Fighting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FindingAQuietAndComfortableSpotToCommunicateWithPersonWithDementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FindingAQuietAndComfortableSpotToCommunicateWithPersonWithDementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#CommunicatingActionSuggested"/>
        <rdfs:comment xml:lang="en">The action of finding a quiet and comfortable spot to communicate with a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Finding a Quiet and Comfortable Spot to Communicate with Person with Dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FirstGenerationImmigrant -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhenyuzhang/ontologies/2021/DREAMDNPTO#FirstGenerationImmigrant">
