   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-W33H358F-7">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-03</dcterms:modified>
      <skos:definition xml:lang="fr">Processus métamnésique avec lequel des individus décident du temps qu’il souhaitent consacrer à l'apprentissage d'éléments.</skos:definition>
      <skos:definition xml:lang="en">The metamemory process by which individuals decide how much time to devote to learning tasks.</skos:definition>
      <skos:prefLabel xml:lang="fr">allocation d’un temps d’étude</skos:prefLabel>
      <skos:prefLabel xml:lang="en">allocation of study time</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Son, L. K., &amp; Kornell, N. (2008). Research on the allocation of study time: Key studies from 1890 to the present (and beyond). In J. Dunlovsky &amp; R. A. Bjork (Eds.), Handbook of metamemory and memory (pp. 333–351). New York: Psychology Press.</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-GJ6V9SL7-Z"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-WM9BNKJ9-8"/>
