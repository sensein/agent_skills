      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-HBT2LQ4S-N">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-12</dcterms:modified>
      <skos:definition xml:lang="en">A learning process without reinforcement, which is only overtly expressed when the reinforcement is introduced.</skos:definition>
      <skos:definition xml:lang="fr">Processus d’apprentissage se réalisant sans renforcement, de manière « invisible », et ne se manifestant explicitement qu’avec l’introduction d’un renforcement.</skos:definition>
      <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/NBO_0000214"/>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Latent_learning"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q6495497"/>
      <skos:hiddenLabel xml:lang="fr">apprentissages latents</skos:hiddenLabel>
      <skos:prefLabel xml:lang="fr">apprentissage latent</skos:prefLabel>
