   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-QFP9K667-6">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-03</dcterms:modified>
      <skos:definition xml:lang="en">An R package for "visualizing, smoothing and comparing receiver operating characteristic (ROC curves). (Partial) area under the curve (AUC) can be compared with statistical tests based on U-statistics or bootstrap. Confidence intervals can be computed for (p)AUC or ROC curves." (source : https://cran.r-project.org/web/packages/pROC/index.html).</skos:definition>
      <skos:definition xml:lang="fr">Un paquet R pour visualiser, lisser et comparer les courbes ROC (source : https://cran.r-project.org/web/packages/pROC/index.html).</skos:definition>
      <skos:prefLabel xml:lang="en">pROC</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">pROC</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Robin, X., Turck, N., Hainard, A., Tiberti, N., Lisacek, F., Sanchez, J.-C., &amp; Müller, M. (2011). pROC: An open-source package for R and S+ to analyze and compare ROC curves. BMC Bioinformatics, 12(1), 77. https://doi.org/10.1186/1471-2105-12-77</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-W7JRB81F-0"/>
