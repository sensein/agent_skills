      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-C8VF7FF8-5"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-J32WMJD2-7"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-JDX6KHSX-T"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-L65NNTH4-2"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-L6ZG9VWM-T"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-M65527M2-W"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-MT60XTLD-Z"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-MZZPPXM0-S"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-R5C8JXLW-X"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-R9QK36F7-F"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-WDVDV8GC-1"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-X3NQ6ZRJ-H"/>
