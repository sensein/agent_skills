   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-RR3NPLQW-P">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-03-19</dcterms:modified>
      <skos:definition xml:lang="fr">Conscience du temps subjectif.</skos:definition>
      <skos:definition xml:lang="en">Conscious awareness of subjective time.</skos:definition>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q5113942"/>
      <skos:prefLabel xml:lang="en">chronesthesia</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">chronesthésie</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Tulving, E. (2002). Chronesthesia: Conscious awareness of subjective time. In D. T. Stuss &amp; R. C. Knight (Eds.), Principles of Frontal Lobe Function (p. 311-325). Oxford University Press.</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-QZXRZM22-5"/>
