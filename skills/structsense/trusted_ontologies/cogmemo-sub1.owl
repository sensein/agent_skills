      <inist:isModelOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-T4F643ZN-K"/>
      <inist:isModelOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-TKZB8HG9-6"/>
      <inist:isModelOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-VC9TWVJ8-D"/>
