   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-NG7QTM2N-0">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-03-15</dcterms:modified>
      <skos:altLabel xml:lang="en">LTP</skos:altLabel>
      <skos:altLabel xml:lang="en">long-term synaptic potentiation</skos:altLabel>
      <skos:altLabel xml:lang="fr">potentialisation synaptique à long terme</skos:altLabel>
      <skos:definition xml:lang="en">Process resulting in long-lasting increase in synapse efficiency (a few hours to several weeks) after a series of high-frequency electrical stimulation.</skos:definition>
      <skos:definition xml:lang="fr">Processus entraînant une augmentation durable (quelques heures à plusieurs semaines) de l'efficacité des synapses après une série de stimulations électriques à haute fréquence.</skos:definition>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/JVR-W2XGSG36-S"/>
