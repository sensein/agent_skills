   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-MR6CTN84-B">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-03-10</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-04</dcterms:modified>
      <inist:domain xml:lang="en">Probability / Statistics</inist:domain>
      <inist:domain xml:lang="fr">Probabilités / Statistiques</inist:domain>
      <skos:altLabel xml:lang="en">B prime prime</skos:altLabel>
      <skos:altLabel xml:lang="en">B" index</skos:altLabel>
      <skos:altLabel xml:lang="fr">indice B"</skos:altLabel>
      <skos:definition xml:lang="fr">Dans la théorie de la détection du signal, mesure nonparamétrique du biais de réponse.</skos:definition>
      <skos:definition xml:lang="en">In signal detection theory, nonparametric measure of response bias.</skos:definition>
