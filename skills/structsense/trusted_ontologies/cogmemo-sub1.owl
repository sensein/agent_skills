   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-JB1Z9TF3-H">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-05-18</dcterms:modified>
      <skos:altLabel xml:lang="en">ordered recall task</skos:altLabel>
      <skos:altLabel xml:lang="fr">rappel sériel</skos:altLabel>
      <skos:altLabel xml:lang="en">serial recall</skos:altLabel>
      <skos:altLabel xml:lang="en">serial recall test</skos:altLabel>
      <skos:altLabel xml:lang="fr">test de rappel sériel</skos:altLabel>
      <skos:altLabel xml:lang="fr">tâche de rappel ordonné</skos:altLabel>
      <skos:definition xml:lang="fr">Dans un test de rappel sériel, le sujet doit rappeler les informations dans l'ordre de présentation de celles-ci pendant la phase d'étude.</skos:definition>
      <skos:definition xml:lang="en">In a serial recall test, the subject is asked to recall the items in their order of presentation during the study phase.</skos:definition>
      <skos:hiddenLabel xml:lang="fr">rappel ordonné</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">serial recall tasks</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">serial recall tests</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">tests de rappel sériel</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">tâches de rappel sériel</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">serial recall task</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">tâche de rappel sériel</skos:prefLabel>
