   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-MTSL0LX7-3">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-07-02</dcterms:modified>
      <skos:definition xml:lang="fr">Disposition cognitive d’un individu à maintenir ou à optimiser la performance cognitive en dépit d’atteintes cérébrales ou du vieillissement.</skos:definition>
      <skos:definition xml:lang="en">The cognitive disposition of an individual to maintain or optimize cognitive performance despite brain damage or aging.</skos:definition>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/2CX-KLFK59PR-J"/>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/JVR-HZL7ZRZ5-P"/>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/N9J-MB7BXV8V-0"/>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Cognitive_reserve"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q579471"/>
      <skos:hiddenLabel xml:lang="fr">réserves cognitives</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">cognitive reserve</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">réserve cognitive</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
