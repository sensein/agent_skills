   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-TMHZZ0G7-F">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-07-03</dcterms:modified>
      <skos:altLabel xml:lang="fr">corporéïté</skos:altLabel>
      <skos:altLabel xml:lang="en">embodiment</skos:altLabel>
      <skos:altLabel xml:lang="fr">encorporation</skos:altLabel>
      <skos:altLabel xml:lang="fr">incarnation</skos:altLabel>
      <skos:definition xml:lang="en">Approach in cognitive science according to which cognition is grounded in sensory-motor systems, actions, the body and its interactions with the environment.</skos:definition>
      <skos:definition xml:lang="fr">Approche en sciences cognitives selon laquelle la cognition est enracinée dans les systèmes sensori-moteurs, les actions, le corps et les interactions de celui-ci avec l’environnement.</skos:definition>
