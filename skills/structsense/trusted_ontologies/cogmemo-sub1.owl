      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-04</dcterms:modified>
      <skos:altLabel xml:lang="en">metamemorial judgment</skos:altLabel>
      <skos:definition xml:lang="en">Subjective assessment of one's current memory state.</skos:definition>
      <skos:definition xml:lang="fr">Évaluation subjective de l’état actuel de sa mémoire.</skos:definition>
      <skos:hiddenLabel xml:lang="fr">jugements métamnésiques</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">metamemorial judgments</skos:hiddenLabel>
