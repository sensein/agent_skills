   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-XJ333KQF-6">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-05-15</dcterms:modified>
      <skos:altLabel xml:lang="en">frontal N400</skos:altLabel>
      <skos:definition xml:lang="en">Negative wave in the frontal lobe appearing between 300 and 500 ms after a stimulus has been recognized by the subject. This component of event-related potientials is an indicator of the stimulus familiarity.</skos:definition>
      <skos:definition xml:lang="fr">Onde négative dans le lobe frontal apparaissant entre 300 et 500 ms après qu'un stimulus a été reconnu par le sujet. Cette composante des potentiels évoqués cognitifs serait un indicateur de la familiarité du stimulus.</skos:definition>
      <skos:prefLabel xml:lang="en">FN400 wave</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">onde FN400</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Friedman, D., &amp; Johnson Jr., R. (2000). Event-related potential (ERP) studies of memory encoding and retrieval : A selective review. Microscopy Research and Technique, 51(1), 6‑28. https://doi.org/10.1002/1097-0029(20001001)51:1&lt;6::AID-JEMT2&gt;3.0.CO;2-R</dct:bibliographicCitation>
      <dct:bibliographicCitation>Gonthier, C., &amp; Hot, P. (2013). Apports de l’électroencéphalographie à la compréhension de la mémoire. Revue de Neuropsychologie, 5(4), 243–254. https://doi.org/10.1684/nrp.2013.0280</dct:bibliographicCitation>
