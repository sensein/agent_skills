   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-C2J3RXTZ-H">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-12</dcterms:modified>
      <skos:definition xml:lang="en">A learning process characterized by the increase or disappearance of a response to a repeated stimulus.</skos:definition>
      <skos:definition xml:lang="fr">Processus d'apprentissage entraînant l’augmentation ou la disparition d’une réponse face à un stimulus répété.</skos:definition>
      <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/NBO_0000177"/>
      <skos:hiddenLabel xml:lang="fr">apprentissages non associatifs</skos:hiddenLabel>
      <skos:prefLabel xml:lang="fr">apprentissage non associatif</skos:prefLabel>
      <skos:prefLabel xml:lang="en">non-associative learning</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Doré, F.-Y., &amp; Mercier, P. (1992). Les fondements de l’apprentissage et de la cognition. Presses Universitaires de Lille.</dct:bibliographicCitation>
      <dct:bibliographicCitation>Sweatt, J. D. (2010). Mechanisms of memory (2nd ed.). Academic Press.</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-T08V3LTM-3"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-NDS4MGVJ-P"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-QSMG7KHS-K"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-RD88ZH84-6"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Animal"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-D4SW9Z1B-V">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-12</dcterms:modified>
      <skos:definition xml:lang="en">A learning process for the rapid acquisition of new information in the neocortex, without the involvement of the hippocampus.</skos:definition>
      <skos:definition xml:lang="fr">Processus d'apprentissage permettant l'acquisition rapide dans le néocortex de nouvelles informations, indépendamment de l'implication de l'hippocampe.</skos:definition>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Fast_mapping"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q5437039"/>
      <skos:hiddenLabel xml:lang="en">fast mapping</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">fast mapping process</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">processus d'alignement rapide</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Cooper, E., Greve, A., &amp; Henson, R. N. (2019). Little evidence for Fast Mapping (FM) in adults: A review and discussion. Cognitive Neuroscience, 10(4), 196–209. https://doi.org/10.1080/17588928.2018.1542376</dct:bibliographicCitation>
      <dct:bibliographicCitation>Coutanche, M. N., &amp; Thompson-Schill, S. L. (2014). Fast mapping rapidly integrates information into existing memory networks. Journal of Experimental Psychology: General, 143(6), 2296–2303. https://doi.org/10.1037/xge0000020</dct:bibliographicCitation>
      <dct:bibliographicCitation>Gurunandan, K., Cooper, E., Tibon, R., Henson, R. N., &amp; Greve, A. (2023). No evidence of fast mapping in healthy adults using an implicit memory measure: Failures to replicate the lexical competition results of Coutanche and Thompson-Schill (2014). Memory, 31(10), 1320-1339. https://doi.org/10.1080/09658211.2023.2262188</dct:bibliographicCitation>
      <dct:bibliographicCitation>Sharon, T., Moscovitch, M., &amp; Gilboa, A. (2011). Rapid neocortical acquisition of long-term arbitrary associations independent of the hippocampus. Proceedings of the National Academy of Sciences, 108(3), 1146‑1151. https://doi.org/10.1073/pnas.1005238108</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-T08V3LTM-3"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-B0MKL2QD-7"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-L02857LC-7"/>
