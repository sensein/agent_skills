   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-TSKS85B6-L">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-03-15</dcterms:modified>
      <skos:definition xml:lang="fr">Processus par lequel le fait de récupérer des informations en mémoire empêche la récupération d'autres informations.</skos:definition>
      <skos:definition xml:lang="en">The process by which retrieving information from memory prevents the retrieval of other information.</skos:definition>
      <skos:prefLabel xml:lang="fr">processus auto-limitant</skos:prefLabel>
      <skos:prefLabel xml:lang="en">self-limiting process</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Bjork, R. A., Bjork, E. L., &amp; Caughey, B. J. (2007). Retrieval as a self-limiting process : Part II. In J. S. Nairne (Ed.), The Foundations of Remembering: Essays in Honor of Henry L. Roediger, III (p. 19-37). Psychology Press.</dct:bibliographicCitation>
