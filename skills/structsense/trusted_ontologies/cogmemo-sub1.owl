   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-SK3SSKXH-C">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-03</dcterms:modified>
      <skos:altLabel xml:lang="fr">faux souvenir basé sur une inférence</skos:altLabel>
      <skos:altLabel xml:lang="en">inferential false memory</skos:altLabel>
      <skos:definition xml:lang="en">A spontaneous false memory observed when a person reports information or an event that was not actually experienced but is derived from existing knowledge, attitudes, or reasoning.</skos:definition>
      <skos:definition xml:lang="fr">Faux souvenir spontané observé lorsqu’une personne rapporte une information ou un événement qu’elle n’a pas réellement vécu, mais qui est dérivé de connaissances antérieures, d’attitudes ou d’un raisonnement.</skos:definition>
      <skos:hiddenLabel xml:lang="fr">faux souvenirs inférenciels</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">inferential false memories</skos:hiddenLabel>
      <skos:prefLabel xml:lang="fr">faux souvenir inférentiel</skos:prefLabel>
      <skos:prefLabel xml:lang="en">inference-based false memory</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Carpenter, A. C., &amp; Schacter, D. L. (2017). Flexible retrieval : When true inferences produce false memories. Journal of Experimental Psychology: Learning, Memory, and Cognition, 43(3), 335‑349. https://doi.org/10.1037/xlm0000340</dct:bibliographicCitation>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-C5ZPF04J-R"/>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-H03T8DFX-C"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-BNPSX7VV-1"/>
