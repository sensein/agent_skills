   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-HQM4N2ZZ-M">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2018-11-28</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-07-25</dcterms:modified>
      <skos:altLabel xml:lang="fr">questionnaire auto-administré</skos:altLabel>
      <skos:altLabel xml:lang="fr">questionnaire d'auto-administration</skos:altLabel>
