   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-NX9M5LBR-V">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-01-19</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-12</dcterms:modified>
      <skos:altLabel xml:lang="en">contextual binding account</skos:altLabel>
      <skos:altLabel xml:lang="en">contextual binding model</skos:altLabel>
      <skos:altLabel xml:lang="fr">théorie de la liaison contextuelle</skos:altLabel>
      <skos:definition xml:lang="en">A theory which states that the hippocampus is essential to episodic memory by binding item and context information.</skos:definition>
      <skos:definition xml:lang="fr">Théorie qui postule que l'hippocampe est essentiel à la mémoire épisodique en liant les informations relatives à l'item et au contexte.</skos:definition>
      <skos:prefLabel xml:lang="en">contextual binding theory</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">théorie du liage contextuel</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Yonelinas, A. P., Ranganath, C., Ekstrom, A. D., &amp; Wiltgen, B. J. (2019). A contextual binding theory of episodic memory : Systems consolidation reconsidered. Nature Reviews Neuroscience, 20(6), 364‑375. https://doi.org/10.1038/s41583-019-0150-4</dct:bibliographicCitation>
      <inist:isTheoryOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-DP4NMT2L-9"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-JT2DDSSZ-4"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-CKQTZ5SM-J"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-LDWRVL6T-5"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-ND80SHXD-0"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-XGD3J4ZG-F"/>
