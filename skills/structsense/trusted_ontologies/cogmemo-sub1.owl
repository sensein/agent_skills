   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-LFS6BB48-D">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-01-26</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
