   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-D5SLKKRQ-0">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-03</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-15</dcterms:modified>
      <skos:definition xml:lang="en">A disposition to instigate or initiate (needs, motives) and direct (goals, values) behavior (adapted from Murayama &amp; Jach, 2025, p. 1-2).</skos:definition>
      <skos:definition xml:lang="fr">Disposition à susciter ou à initier (besoins, motifs) un comportement et à l'orienter (buts, valeurs) (adapté de Murayama &amp; Jach, 2025, p.1-2).</skos:definition>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/2CX-FNV1Z5T5-9"/>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/JVR-KQ76HGZS-0"/>
      <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/NBO_0000233"/>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/N9J-R9S8MLSQ-2"/>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Motivation"/>
      <skos:exactMatch rdf:resource="https://fr.wikipedia.org/wiki/Motivation"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q644302"/>
      <skos:hiddenLabel xml:lang="fr">motivant</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">motivants</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">motivational</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">motivations</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">motivations</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">motivation</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">motivation</skos:prefLabel>
      <skos:scopeNote xml:lang="fr">La définition de la motivation a subi des évolutions historiques et dépend du contexte d’utilisation du terme.</skos:scopeNote>
      <skos:scopeNote xml:lang="en">The definition of motivation has undergone historical changes and depends on the context in which the term is used.</skos:scopeNote>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Anselme, P. (2022). Motivation incitatrice: Un aperçu historique des enjeux théoriques. L’Année psychologique, 122(2), 339–366. https://doi.org/10.3917/anpsy1.222.0339</dct:bibliographicCitation>
      <dct:bibliographicCitation>Berridge, K. C. (2018). Evolving concepts of emotion and motivation. Frontiers in Psychology, 9, 1647. https://doi.org/10.3389/fpsyg.2018.01647</dct:bibliographicCitation>
      <dct:bibliographicCitation>Miendlarzewska, E. A., Bavelier, D., &amp; Schwartz, S. (2016). Influence of reward motivation on human declarative memory. Neuroscience &amp; Biobehavioral Reviews, 61, 156–176. https://doi.org/10.1016/j.neubiorev.2015.11.015</dct:bibliographicCitation>
      <dct:bibliographicCitation>Murayama, K. (2023). Are cognition, motivation, and emotion the same or different? Let’s abandon that thinking. In M. Bong, J. Reeve, &amp; S. Kim (Eds.), Motivation Science: Controversies and Insights (pp. 243–245). Oxford University Press. https://doi.org/10.1093/oso/9780197662359.003.0041</dct:bibliographicCitation>
      <dct:bibliographicCitation>Murayama, K., &amp; Jach, H. (2025). A critique of motivation constructs to explain higher-order behavior: We should unpack the black box. Behavioral and Brain Sciences, 48, e24. https://doi.org/10.1017/S0140525X24000025</dct:bibliographicCitation>
      <dct:bibliographicCitation>Poh, J.-H., &amp; Adcock, R. A. (2026). Motivation as neural context for adaptive learning and memory formation. Annual Review of Psychology, 77(1), 49–80. https://doi.org/10.1146/annurev-psych-032525-031744</dct:bibliographicCitation>
