   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-L868RB6Z-R">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-03-31</dcterms:modified>
      <skos:altLabel xml:lang="en">category verification task</skos:altLabel>
      <skos:definition xml:lang="en">Method for studying semantic memory. Subjects are asked to judge whether sentences presented to them are true or false.</skos:definition>
      <skos:definition xml:lang="fr">Méthode d'étude de la mémoire sémantique. Les sujets doivent juger si les phrases qui leur sont présentées sont vraies ou fausses.</skos:definition>
      <skos:prefLabel xml:lang="en">sentence verification task</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">tâche de vérification de phrases</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Clark, H. H., &amp; Chase, W. G. (1972). On the process of comparing sentences against pictures. Cognitive Psychology, 3(3), 472–517. https://doi.org/10.1016/0010-0285(72)90019-9</dct:bibliographicCitation>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-FTP0PM55-0"/>
