   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-H340VDRV-4">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-15</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-16</dcterms:modified>
      <skos:altLabel xml:lang="en">reminiscence intervention</skos:altLabel>
      <skos:altLabel xml:lang="en">reminiscence work</skos:altLabel>
      <skos:altLabel xml:lang="en">reminiscence-based intervention</skos:altLabel>
      <skos:altLabel xml:lang="fr">thérapie de réminiscence</skos:altLabel>
      <skos:definition xml:lang="en">Therapy, which can take many forms, based on the evocation of past personal memories, often using prompts (e.g. photographs), to improve the quality of life, cognition, mood, sense of personal identity, communication or behavior of people, such as those suffering from depression or dementia.</skos:definition>
      <skos:definition xml:lang="fr">Thérapie, pouvant prendre différentes formes, basée sur l’évocation de souvenirs personnels anciens, souvent à l’aide d’incitations (par exemple, des photographies) afin d’améliorer la qualité de vie, la cognition, l’humeur, le sens de l’identité personnelle, la communication ou encore le comportement des personnes, comme celles souffrant de dépression ou de démence.</skos:definition>
      <skos:hiddenLabel xml:lang="en">reminiscence interventions</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">reminiscence therapies</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">reminiscence works</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">reminiscence-based interventions</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">thérapies de réminiscence</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">thérapies par réminiscence</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">reminiscence therapy</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">thérapie par réminiscence</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Butler, R. N. (1963). The life review: An interpretation of reminiscence in the aged. Psychiatry, 26(1), 65–76. https://doi.org/10.1080/00332747.1963.11023339</dct:bibliographicCitation>
      <dct:bibliographicCitation>Woods, B., O’Philbin, L., Farrell, E. M., Spector, A. E., &amp; Orrell, M. (2018). Reminiscence therapy for dementia. Cochrane Database of Systematic Reviews, 2018(3). https://doi.org/10.1002/14651858.cd001120.pub3</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-GPW1T35T-9"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-GQSVPLVR-3"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-HFLQLV31-8"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-JF82S3P1-7"/>
