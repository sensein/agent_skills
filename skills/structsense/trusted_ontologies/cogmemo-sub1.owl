   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-TG9QH460-9">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-10</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-12</dcterms:modified>
      <skos:definition xml:lang="en">A class of computational models of recognition memory according to which “responses are based on a combination of a number of discrete mental states, typically detection and uncertainty states […]. In addition, as soon as a certain state is entered, only the information about the state remains while all information about how this state was reached is lost.” (Starns et al., 2018, p. 124).</skos:definition>
      <skos:definition xml:lang="fr">Classe de modèles computationnels de la reconnaissance selon lesquels « les réponses sont basées sur une combinaison d'un certain nombre d'états mentaux discrets, typiquement des états de détection et d'incertitude [...]. En outre, dès qu'un certain état est atteint, seule l'information sur l'état subsiste alors que toute information sur la manière dont cet état a été atteint est perdue. » (Starns et al., 2018, p. 124).</skos:definition>
      <skos:hiddenLabel xml:lang="en">discrete-state models</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">modèles à états discrets</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">discrete-state model</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">modèle à états discrets</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Guillaume, F., &amp; Tiberghien, G. (2024). Psychologie de la mémoire : les modèles de la reconnaissance. De Boeck Supérieur.</dct:bibliographicCitation>
      <dct:bibliographicCitation>Riefer, D. M., &amp; Batchelder, W. H. (1988). Multinomial modeling and the measurement of cognitive processes. Psychological Review, 95(3), 318–339. https://doi.org/10.1037/0033-295X.95.3.318</dct:bibliographicCitation>
      <dct:bibliographicCitation>Starns, J. J., Dubé, C., &amp; Frelinger, M. E. (2018). The speed of memory errors shows the influence of misleading information: Testing the diffusion model and discrete-state models. Cognitive Psychology, 102, 21–40. https://doi.org/10.1016/j.cogpsych.2018.01.001</dct:bibliographicCitation>
      <inist:isModelOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-VC9TWVJ8-D"/>
      <inist:isModelOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-ZV27JZL6-3"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-MMPD886D-4"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-C25BH10L-T"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-KCJ85PL3-0"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-KCJ85PL3-0">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-04</dcterms:modified>
      <skos:altLabel xml:lang="fr">paradigme de reconnaissance</skos:altLabel>
      <skos:altLabel xml:lang="en">recognition paradigm</skos:altLabel>
      <skos:altLabel xml:lang="en">recognition test</skos:altLabel>
      <skos:altLabel xml:lang="fr">test de reconnaissance</skos:altLabel>
      <skos:definition xml:lang="fr">Dans une tâche de reconnaissance, le sujet est invité à discriminer, parmi un ensemble d’items, ceux qui ont été étudiés (items anciens) de ceux qui n’ont pas été étudiés (items nouveaux).</skos:definition>
      <skos:definition xml:lang="en">In a recognition task, the subject is asked to discriminate, among a set of items, those that have been studied (old items) from those that have not been studied (new items).</skos:definition>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/2CX-J9CWZ9FS-F"/>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/JVR-MML7W6KG-1"/>
      <skos:exactMatch rdf:resource="https://www.cognitiveatlas.org/concept/id/trm_4a3fd79d0b967/"/>
      <skos:hiddenLabel xml:lang="en">recognition</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">recognition tasks</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">recognition tests</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">reconnaissance</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">reconnaissances</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">tests de reconnaissance</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">tâches de reconnaissance</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">recognition task</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">tâche de reconnaissance</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Besson, G., Ceccaldi, M., &amp; Barbeau, E. J. (2013). L’évaluation des processus de la mémoire de reconnaissance. Revue de Neuropsychologie, 4(4), 242–254. https://doi.org/10.1684/nrp.2012.0238</dct:bibliographicCitation>
      <dct:bibliographicCitation>Smith, D. G., &amp; J, J. (2004). Testing theories of recognition memory by predicting performance across paradigms. Journal of Experimental Psychology: Learning, Memory, and Cognition, 30(3), 615–625. https://doi.org/10.1037/0278-7393.30.3.615</dct:bibliographicCitation>
      <inist:isComponentOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-H7XV2J7T-2"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-B4ZR1FPB-W"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-BT03ZSL3-1"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-BXR6CPT8-9"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-DBTDMRDP-B"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-DP4NMT2L-9"/>
