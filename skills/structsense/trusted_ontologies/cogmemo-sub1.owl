   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-TXG25C5J-T">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-03-08</dcterms:modified>
      <skos:altLabel xml:lang="fr">amnésie topographique</skos:altLabel>
      <skos:altLabel xml:lang="fr">désorientation topographique pure</skos:altLabel>
      <skos:altLabel xml:lang="en">pure topographical disorientation</skos:altLabel>
      <skos:altLabel xml:lang="en">topographical amnesia</skos:altLabel>
      <skos:definition xml:lang="en">Selective disorder of spatial memory in which patients have difficulty orienting themselves in their environment and finding their way which results from lesions in the right parahippocampal gyrus.</skos:definition>
      <skos:definition xml:lang="fr">Trouble sélectif de la mémoire spatiale se manifestant par la difficulté des patients à s'orienter dans leur environnement et à trouver leur chemin, et consécutif à des lésions du gyrus parahippocampique droit.</skos:definition>
      <skos:prefLabel xml:lang="fr">perte de la mémoire topographique</skos:prefLabel>
      <skos:prefLabel xml:lang="en">topographical memory loss</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Habib, M., &amp; Sirigu, A. (1987). Pure topographical disorientation: A definition and anatomical basis. Cortex, 23(1), 73-85. https://doi.org/10.1016/S0010-9452(87)80020-5</dct:bibliographicCitation>
      <dct:bibliographicCitation>Whiteley, A. M., &amp; Warrington, E. K. (1978). Selective impairment of topographical memory: a single case study. Journal of Neurology, Neurosurgery &amp; Psychiatry, 41(6), 575-578. https://doi.org/10.1136/jnnp.41.6.575</dct:bibliographicCitation>
