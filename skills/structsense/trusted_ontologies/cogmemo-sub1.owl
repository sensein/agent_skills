      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Receiver_operating_characteristic"/>
      <skos:exactMatch rdf:resource="https://fr.wikipedia.org/wiki/Courbe_ROC"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q327120"/>
