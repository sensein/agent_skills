   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-C25BH10L-T">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-27</dcterms:modified>
      <skos:definition xml:lang="en">A cognitive quality referring to the level of robustness and durability of memory traces.</skos:definition>
      <skos:definition xml:lang="fr">Qualité cognitive indiquant le niveau de robustesse et de durabilité des traces mnésiques.</skos:definition>
      <skos:prefLabel xml:lang="fr">force du souvenir</skos:prefLabel>
      <skos:prefLabel xml:lang="en">memory strength</skos:prefLabel>
      <skos:scopeNote xml:lang="fr">Dans les approches de la mémoire de reconnaissance par la théorie de la détection du signal, la familiarité des items est souvent synonyme de force des souvenirs.</skos:scopeNote>
      <skos:scopeNote xml:lang="en">In signal detection theory of recognition memory, familiarity of items is often synonymous with strength of memory.</skos:scopeNote>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-SJGGK67S-6"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-KCJ85PL3-0"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-M1QJM17D-7"/>
