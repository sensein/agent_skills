   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-M7RWCXWH-Q">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-07-02</dcterms:modified>
      <skos:altLabel xml:lang="en">MCI</skos:altLabel>
      <skos:altLabel xml:lang="fr">déclin cognitif léger</skos:altLabel>
      <skos:altLabel xml:lang="fr">déficience cognitive légère</skos:altLabel>
      <skos:altLabel xml:lang="fr">déficit neurocognitif léger</skos:altLabel>
      <skos:altLabel xml:lang="fr">trouble cognitif léger</skos:altLabel>
      <skos:altLabel xml:lang="fr">trouble léger de la cognition</skos:altLabel>
      <skos:definition xml:lang="en">A cognitive disorder characterized by memory and cognitive difficulties more severe than those encountered during normal aging, but without reaching dementia and without interfering with daily life, and which is associated with a higher risk of developing dementia.</skos:definition>
      <skos:definition xml:lang="fr">Trouble cognitif caractérisé par des difficultés de mémoire et cognitives plus importantes que celles du vieillissement normal, sans toutefois atteindre le stade de la démence ni interférer avec la vie quotidienne, et qui est associé à un risque accru de développer une démence.</skos:definition>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/JVR-XJ6ZP5P6-G"/>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/N9J-RVBH0J71-L"/>
