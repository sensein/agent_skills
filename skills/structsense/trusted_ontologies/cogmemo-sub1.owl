   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-F3R6HDD2-Z">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-01-11</dcterms:modified>
      <skos:altLabel xml:lang="en">PKMζ</skos:altLabel>
      <skos:altLabel xml:lang="fr">PKMζ</skos:altLabel>
      <skos:altLabel xml:lang="en">protein kinase M zeta</skos:altLabel>
      <skos:altLabel xml:lang="fr">protéine kinase M zêta</skos:altLabel>
      <skos:definition xml:lang="fr">Enzyme, intervenant au niveau des synapses, qui serait impliquée dans le maintien actif des souvenirs consolidés en mémoire.</skos:definition>
      <skos:definition xml:lang="en">Enzyme, intervening at the synapse level, involved in actively maintaining consolidated memories.</skos:definition>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Protein_kinase_C_zeta_type"/>
      <skos:hiddenLabel xml:lang="fr">protéines kinase M zêta</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">protéines kinase Mζ</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">protein kinase Mζ</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">protéine kinase Mζ</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Sacktor, T. C., &amp; Hell, J. W. (2017). The genetics of PKMζ and memory maintenance. Science Signaling, 10(505), eaao2327. https://doi.org/10.1126/scisignal.aao2327</dct:bibliographicCitation>
      <dct:bibliographicCitation>Tsokas, P., Hsieh, C., Flores-Obando, R. E., Bernabo, M., Tcherepanov, A., Hernández, A. I., Thomas, C., Bergold, P. J., Cottrell, J. E., Kremerskothen, J., Shouval, H. Z., Nader, K., Fenton, A. A., &amp; Sacktor, T. C. (2024). KIBRA anchoring the action of PKMζ maintains the persistence of memory. Science Advances, 10(26), eadl0030. https://doi.org/10.1126/sciadv.adl0030</dct:bibliographicCitation>
