   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-T4H4NVVK-8">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-07-06</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-25</dcterms:modified>
      <skos:altLabel xml:lang="fr">gabarit schématique narratif</skos:altLabel>
      <skos:definition xml:lang="fr">Dans la mémoire collective, « structures généralisées utilisées pour générer plusieurs récits spécifiques avec la même trame de base » (Wertsch, 2008, p. 140).</skos:definition>
      <skos:definition xml:lang="en">In collective memory, "generalized structures used to generate multiple specific narratives with the same basic plot" (Wertsch, 2008, p. 140).</skos:definition>
      <skos:hiddenLabel xml:lang="fr">gabarits schématiques narratifs</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">schematic narrative templates</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">structures narratives schématiques</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">schematic narrative template</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">structure narrative schématique</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Wertsch, J. V. (2008). Collective memory and narrative templates. Social Research, 75(1), 133–156. http://dx.doi.org/10.1353/sor.2008.0051</dct:bibliographicCitation>
