   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-FHFQHWQB-C">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2018-10-22</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-28</dcterms:modified>
      <skos:altLabel xml:lang="fr">faux souvenir riche</skos:altLabel>
      <skos:altLabel xml:lang="en">rich false memory</skos:altLabel>
      <skos:definition xml:lang="en">A induced false memory of an entire event.</skos:definition>
      <skos:definition xml:lang="fr">Faux souvenir induit d’un événement complet.</skos:definition>
      <skos:hiddenLabel xml:lang="fr">faux souvenirs implantés</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">faux souvenirs riches</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">implanted false memories</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">rich false memories</skos:hiddenLabel>
      <skos:prefLabel xml:lang="fr">faux souvenir implanté ​</skos:prefLabel>
      <skos:prefLabel xml:lang="en">implanted false memory</skos:prefLabel>
