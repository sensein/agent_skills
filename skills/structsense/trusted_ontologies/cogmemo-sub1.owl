      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-R4B06W09-T"/>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-RZ2FRN8X-S"/>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-V4LVTXVQ-3"/>
