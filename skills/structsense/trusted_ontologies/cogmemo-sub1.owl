   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-BWPK8GHJ-D">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-03-15</dcterms:modified>
      <skos:definition xml:lang="fr">Processus permettant de rendre disponibles des informations stockées en mémoire pour des traitements ultérieurs.</skos:definition>
      <skos:definition xml:lang="en">The process by which information stored in memory is made available for further processing.</skos:definition>
