      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <inist:hasModel rdf:resource="http://data.loterre.fr/ark:/67375/P66-JXND260V-G"/>
      <inist:hasModel rdf:resource="http://data.loterre.fr/ark:/67375/P66-LXQ70LHH-P"/>
