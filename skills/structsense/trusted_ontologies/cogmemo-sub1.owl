      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q3560550"/>
      <skos:prefLabel xml:lang="fr">mémoire spatiale</skos:prefLabel>
      <skos:prefLabel xml:lang="en">spatial memory</skos:prefLabel>
