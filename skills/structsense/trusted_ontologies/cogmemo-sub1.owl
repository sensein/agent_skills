   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-FR1VGSJN-Q">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-07-04</dcterms:modified>
      <skos:altLabel xml:lang="fr">acquisition d'un souvenir</skos:altLabel>
      <skos:altLabel xml:lang="en">acquisition of memory</skos:altLabel>
      <skos:altLabel xml:lang="fr">codage</skos:altLabel>
      <skos:altLabel xml:lang="en">coding</skos:altLabel>
      <skos:altLabel xml:lang="fr">encodage</skos:altLabel>
      <skos:altLabel xml:lang="en">encoding</skos:altLabel>
      <skos:altLabel xml:lang="fr">formation de la trace</skos:altLabel>
      <skos:altLabel xml:lang="en">memory acquisition</skos:altLabel>
      <skos:altLabel xml:lang="en">memory formation</skos:altLabel>
      <skos:altLabel xml:lang="en">trace formation</skos:altLabel>
      <skos:definition xml:lang="fr">Processus mnésique par lequel le format d’une information est transformé dans un autre format compatible avec le stockage en mémoire.</skos:definition>
      <skos:definition xml:lang="en">The memory process by which the format of information is transformed into another format compatible with memory storage.</skos:definition>
