   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-JF82S3P1-7">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-15</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</dcterms:modified>
      <skos:altLabel xml:lang="fr">examen de vie</skos:altLabel>
      <skos:altLabel xml:lang="fr">revue de vie</skos:altLabel>
      <skos:definition xml:lang="en">The remembering of personal events followed by the analysis and reinterpretation of these events.</skos:definition>
      <skos:definition xml:lang="fr">Évocation d’événements personnels complétée par l’analyse et la réinterprétation de ces événements.</skos:definition>
      <skos:prefLabel xml:lang="en">life review</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">rétrospective de vie</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Butler, R. N. (1963). The life review: An interpretation of reminiscence in the aged. Psychiatry, 26(1), 65–76. https://doi.org/10.1080/00332747.1963.11023339</dct:bibliographicCitation>
      <dct:bibliographicCitation>Westerhof, G. J., &amp; Bohlmeijer, E. T. (2014). Celebrating fifty years of research and applications in reminiscence and life review: State of the art and new directions. Journal of Aging Studies, 29, 107–114. https://doi.org/10.1016/j.jaging.2014.02.003</dct:bibliographicCitation>
