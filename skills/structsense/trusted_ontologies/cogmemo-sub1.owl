   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-CJG87PGD-Q">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-07-25</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-10</dcterms:modified>
      <inist:domain xml:lang="fr">Psychologie</inist:domain>
