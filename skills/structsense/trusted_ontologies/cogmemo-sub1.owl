   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-DRPS0TBC-H">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-09-11</dcterms:modified>
      <skos:altLabel xml:lang="fr">fausse croyance induite</skos:altLabel>
      <skos:altLabel xml:lang="en">induced false belief</skos:altLabel>
      <skos:definition xml:lang="en">A metamemory phenomenon characterized by an erroneous belief that one has experienced an event in the past, unaccompanied by a detailed memory.</skos:definition>
      <skos:definition xml:lang="fr">Phénomène métamnésique caractérisé par la fausse croyance d'avoir déjà vécu un événement dans le passé, sans toutefois être accompagnée d'un souvenir détaillé.</skos:definition>
      <skos:hiddenLabel xml:lang="en">false autobiographical beliefs</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">fausses croyances autobiographiques</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">fausses croyances induites</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">induced false beliefs</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">false autobiographical belief</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">fausse croyance autobiographique</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Muschalla, B., &amp; Schönborn, F. (2021). Induction of false beliefs and false memories in laboratory studies – A systematic review. Clinical Psychology &amp; Psychotherapy, 28(5), 1194-1209. https://doi.org/10.1002/cpp.2567</dct:bibliographicCitation>
