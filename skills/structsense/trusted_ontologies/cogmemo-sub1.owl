      <skos:hiddenLabel xml:lang="en">hippocampi</skos:hiddenLabel>
      <skos:prefLabel xml:lang="fr">hippocampe</skos:prefLabel>
      <skos:prefLabel xml:lang="en">hippocampus</skos:prefLabel>
