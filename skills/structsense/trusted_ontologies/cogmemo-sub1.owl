   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-MB7R2W2W-G">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-09</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-09</dcterms:modified>
      <skos:definition xml:lang="en">A mathematical theory for studying how a system changes from one state to another over time.</skos:definition>
      <skos:definition xml:lang="fr">Théorie mathématique qui étudie l’évolution d’un système d’un état à un autre au cours du temps.</skos:definition>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Dynamical_systems_theory"/>
      <skos:exactMatch rdf:resource="https://fr.wikipedia.org/wiki/Théorie_des_systèmes_dynamiques"/>
      <skos:hiddenLabel xml:lang="en">dynamic system</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">dynamic systems</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">système dynamique</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">systèmes dynamiques</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">dynamical systems theory</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">théorie des systèmes dynamiques</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Favela, L. (2020). Dynamical systems theory in cognitive science and neuroscience. Philosophy Compass, 15(8), e12695. https://doi.org/10.1111/phc3.12695</dct:bibliographicCitation>
      <dct:bibliographicCitation>Fujihira, R., &amp; Taga, G. (2026). Dynamical systems model of embodied memory in early human infancy. Psychological Review, 133(1), 41–65. https://doi.org/10.1037/rev0000544</dct:bibliographicCitation>
      <dct:bibliographicCitation>Thelen, E., Schöner, G., Scheier, C., &amp; Smith, L. B. (2001). The dynamics of embodiment: A field theory of infant perseverative reaching. Behavioral and Brain Sciences, 24(1), 1–34. https://doi.org/10.1017/S0140525X01003910</dct:bibliographicCitation>
      <dct:bibliographicCitation>van Gelder, T. (1995). What might cognition be, if not computation? The Journal of Philosophy, 92(7), 345–381. https://doi.org/10.2307/2941061</dct:bibliographicCitation>
      <dct:bibliographicCitation>van Gelder, T. (1997/2003). Dynamique et cognition. In D. Frisette, &amp; P. Poirier (Éds.), Philosophie de l’esprit : problèmes et perspectives (pp. 329-367). Vrin.</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-JT2DDSSZ-4"/>
