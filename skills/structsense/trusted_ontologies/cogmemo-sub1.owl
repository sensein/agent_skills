   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-NDT0LNV4-3">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-11-19</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-04</dcterms:modified>
      <skos:altLabel xml:lang="en">BAPM</skos:altLabel>
      <skos:altLabel xml:lang="fr">BAPM</skos:altLabel>
      <skos:definition xml:lang="fr">Forme abrégée du Comprehensive Assessment of Prospective Memory.</skos:definition>
      <skos:definition xml:lang="en">Short-form of the Comprehensive Assessment of Prospective Memory.</skos:definition>
      <skos:prefLabel xml:lang="en">Brief Assessment of Prospective Memory</skos:prefLabel>
