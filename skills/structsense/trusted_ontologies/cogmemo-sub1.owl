   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-D19S6SFV-B">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-12-04</dcterms:modified>
      <skos:definition xml:lang="en">A concept that correspond to the central tendency of exemplars of a semantic category, retaining their most typical and common properties.</skos:definition>
      <skos:definition xml:lang="fr">Concept qui correspond à la tendance centrale des exemplaires d'une catégorie, ne conservant que leurs attributs les plus typiques et communs.</skos:definition>
      <skos:exactMatch rdf:resource="https://www.cognitiveatlas.org/concept/id/trm_4a3fd79d0ae87"/>
