   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-FVD859VK-N">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-05</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-05</dcterms:modified>
      <skos:altLabel xml:lang="fr">modèle de langage</skos:altLabel>
      <skos:definition xml:lang="en">A statistical model that represents the distribution of word sequence probabilities in a natural language.</skos:definition>
      <skos:definition xml:lang="fr">Modèle statistique qui représente la distribution des probabilités de séquences de mots dans une langue naturelle.</skos:definition>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Language_model"/>
