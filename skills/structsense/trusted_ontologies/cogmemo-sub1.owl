   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-G355R5HB-T">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-01-27</dcterms:modified>
      <skos:altLabel xml:lang="en">classification</skos:altLabel>
      <skos:altLabel xml:lang="fr">classification</skos:altLabel>
      <skos:definition xml:lang="en">An organizational strategy for encoding in or retrieving material from memory, consisting of assigning items to classes based on one or more common properties.</skos:definition>
      <skos:definition xml:lang="fr">Stratégie d’organisation pour l'encodage ou la récupération en mémoire d'un matériel consistant à répartir des items dans des classes en fonction d’une propriété commune ou de plusieurs.</skos:definition>
