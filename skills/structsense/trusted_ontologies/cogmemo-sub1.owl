      <skos:altLabel xml:lang="fr">faux souvenir induit par suggestion</skos:altLabel>
      <skos:altLabel xml:lang="en">suggestion-induced false memory</skos:altLabel>
      <skos:definition xml:lang="en">A false memory produced under social pressure or external suggestions.</skos:definition>
      <skos:definition xml:lang="fr">Faux souvenir qu'une personne produit sous la pression sociale ou sous l'influence de suggestions externes.</skos:definition>
