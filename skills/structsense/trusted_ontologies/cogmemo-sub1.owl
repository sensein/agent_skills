      <skos:exactMatch rdf:resource="https://fr.wikipedia.org/wiki/Potentialisation_à_long_terme"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q1805481"/>
      <skos:prefLabel xml:lang="en">long-term potentiation</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">potentialisation à long terme</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
