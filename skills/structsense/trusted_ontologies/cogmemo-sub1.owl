   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-M3W52ZZJ-C">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-03-24</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-03-24</dcterms:modified>
      <skos:altLabel xml:lang="en">lifelog material</skos:altLabel>
      <skos:definition xml:lang="en">Electronic material, typically worn on the body for hands-free use, that automatically and continuously captures and stores personal activities in daily life.</skos:definition>
      <skos:definition xml:lang="fr">Matériel électronique, généralement porté sur le corps pour une utilisation mains libres, capturant et stockant de manière automatique et continue les activités personnelles au cours de la vie quotidienne.</skos:definition>
      <skos:exactMatch rdf:resource="https://fr.wikipedia.org/wiki/Lifelog"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q763835"/>
      <skos:prefLabel xml:lang="en">lifelogging material</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">matériel d’hyperdiarisation</skos:prefLabel>
