   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-QXJX3ZN8-1">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-06-05</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-06</dcterms:modified>
      <skos:definition xml:lang="fr">Degré avec lequel un mot est capable de susciter une image mentale visuelle.</skos:definition>
      <skos:definition xml:lang="en">Extent to which a word is likely to evoke a visual mental image.</skos:definition>
      <skos:prefLabel xml:lang="fr">imaginabilité des mots</skos:prefLabel>
      <skos:prefLabel xml:lang="en">word imageability</skos:prefLabel>
