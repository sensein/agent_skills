      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-K262PNZJ-3"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-N6QV4DTJ-W"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-WG1XTXWN-2"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-TKQ59X9H-1">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-04-07</dcterms:modified>
      <skos:altLabel xml:lang="fr">influence descendante</skos:altLabel>
      <skos:altLabel xml:lang="fr">traitement dirigé par les concepts</skos:altLabel>
      <skos:definition xml:lang="en">Information processing using pre-existing representations to process new information or events.</skos:definition>
      <skos:definition xml:lang="fr">Type de traitement de l'information consistant à utiliser des représentations existantes pour traiter de nouvelles informations ou événements.</skos:definition>
      <skos:hiddenLabel xml:lang="fr">influences descendantes</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">traitements descendants</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">traitements dirigés par les concepts</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">top-down processing</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">traitement descendant</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Theeuwes, J. (2018). Visual selection: Usually fast and automatic; seldom slow and volitional. Journal of Cognition, 1(1). https://doi.org/10.5334/joc.13</dct:bibliographicCitation>
      <dct:bibliographicCitation>Awh, E., Belopolsky, A. V., &amp; Theeuwes, J. (2012). Top-down versus bottom-up attentional control: A failed theoretical dichotomy. Trends in Cognitive Sciences, 16(8), 437–443. https://doi.org/10.1016/j.tics.2012.06.010</dct:bibliographicCitation>
      <dct:bibliographicCitation>Benoni, H., &amp; Ressler, I. (2020). Dichotomy, trichotomy, or a spectrum : Time to reconsider attentional guidance terminology. Frontiers in Psychology, 11. https://doi.org/10.3389/fpsyg.2020.02243</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-WHJDVJPL-B"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-WVBVBLHW-2"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-CB1B8THR-F"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-DS4GQ28N-J"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-H399QLLG-0"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-L65NNTH4-2"/>
