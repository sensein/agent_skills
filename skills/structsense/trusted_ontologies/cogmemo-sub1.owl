   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-ZFR36KVN-B">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-06-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-18</dcterms:modified>
      <skos:altLabel xml:lang="en">hypothesis</skos:altLabel>
