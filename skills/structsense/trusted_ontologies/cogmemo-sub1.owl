      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/N9J-B42W8XXH-V"/>
      <skos:prefLabel xml:lang="en">inhibition</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">inhibition</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
