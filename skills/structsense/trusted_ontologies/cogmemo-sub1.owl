      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-L2KVVW09-1">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-05</dcterms:modified>
      <skos:altLabel xml:lang="fr">confusion de la source</skos:altLabel>
      <skos:altLabel xml:lang="en">misattribution error</skos:altLabel>
      <skos:altLabel xml:lang="en">misattribution of memory</skos:altLabel>
      <skos:altLabel xml:lang="en">source confusion</skos:altLabel>
      <skos:altLabel xml:lang="en">source misattribution</skos:altLabel>
      <skos:altLabel xml:lang="en">source-monitoring error</skos:altLabel>
      <skos:definition xml:lang="fr">Erreur consistant à attribuer à un souvenir une mauvaise source d'information.</skos:definition>
      <skos:definition xml:lang="en">The error of attributing a wrong source to a memory.</skos:definition>
