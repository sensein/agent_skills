   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-SD7JDTZ4-8">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-05-15</dcterms:modified>
      <skos:definition xml:lang="fr">Processus ou information qui empêchent la mémorisation ou la récupération d'une autre information.</skos:definition>
      <skos:definition xml:lang="en">The process or information that prevents someone storing or retrieving another information.</skos:definition>
      <skos:exactMatch rdf:resource="https://www.cognitiveatlas.org/concept/id/trm_4a3fd79d0a6ad"/>
