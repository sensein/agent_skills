   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-RJ25Q3RF-S">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-12-11</dcterms:modified>
      <skos:altLabel xml:lang="en">observer memory</skos:altLabel>
      <skos:altLabel xml:lang="en">observer perspective</skos:altLabel>
      <skos:altLabel xml:lang="fr">perspective d'une personne tierce</skos:altLabel>
      <skos:altLabel xml:lang="fr">perspective de l'observateur</skos:altLabel>
      <skos:altLabel xml:lang="fr">point de vue de l'observateur</skos:altLabel>
      <skos:altLabel xml:lang="fr">point de vue du spectateur</skos:altLabel>
      <skos:altLabel xml:lang="fr">souvenir de l’observateur</skos:altLabel>
      <skos:altLabel xml:lang="en">third-person perspective</skos:altLabel>
      <skos:definition xml:lang="en">A phenomenological characteristic reported by a person who sees himself or herself in the visual image of an autobiographical memory.</skos:definition>
      <skos:definition xml:lang="fr">Caractéristique phénoménologique rapportée par une personne qui se voit elle-même dans l'image visuelle d'un souvenir autobiographique.</skos:definition>
      <skos:prefLabel xml:lang="en">observer point of view</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">point de vue d'observateur</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Dranseika, V., McCarroll, C. J., &amp; Michaelian, K. (2021). Are observer memories (accurate) memories? Insights from experimental philosophy. Consciousness and Cognition, 96, 103240. https://doi.org/10.1016/j.concog.2021.103240</dct:bibliographicCitation>
      <dct:bibliographicCitation>McCarroll, C. J., &amp; Sutton, J. (in press). Perspective. In L. M. Bietti &amp; M. Pogacar (Eds.), The Palgrave Encyclopedia of Memory Studies. Springer International Publishing. https://doi.org/10.1007/978-3-030-93789-8_47-1</dct:bibliographicCitation>
      <dct:bibliographicCitation>Nigro, G., &amp; Neisser, U. (1983). Point of view in personal memories. Cognitive Psychology, 15(4), 467–482. https://doi.org/10.1016/0010-0285(83)90016-6</dct:bibliographicCitation>
      <dct:bibliographicCitation>St. Jacques, P. L. (2019). A new perspective on visual perspective in memory. Current Directions in Psychological Science, 28(5), 450–455. https://doi.org/10.1177/0963721419850158</dct:bibliographicCitation>
      <dct:bibliographicCitation>St. Jacques, P. L. (2024). Perspective matters: When visual perspective reshapes autobiographical memories. Journal of Applied Research in Memory and Cognition, 13(1), 1–15. https://doi.org/10.1037/mac0000156</dct:bibliographicCitation>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-XFMN6CN4-9"/>
