   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-J4787C73-C">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-24</dcterms:modified>
      <skos:definition xml:lang="en">A memory phenomenon observed when children use a strategy spontaneously or after a training session but fail to improve their memory.</skos:definition>
      <skos:definition xml:lang="fr">Phénomène de la mémoire observé lorsque des enfants utilisent spontanément ou après un entraînement une stratégie mnémonique sans pour autant réussir à améliorer la performance de leur mémoire.</skos:definition>
      <skos:prefLabel xml:lang="fr">déficience d’utilisation</skos:prefLabel>
      <skos:prefLabel xml:lang="en">utilization deficiency</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Schneider, W., Kron, V., Hünnerkopf, M., &amp; Krajewski, K. (2004). The development of young children’s memory strategies: First findings from the Würzburg Longitudinal Memory Study. Journal of Experimental Child Psychology, 88(2), 193–209. https://doi.org/10.1016/j.jecp.2004.02.004</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-RQWF016Q-4"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-TJR8FDCW-L"/>
