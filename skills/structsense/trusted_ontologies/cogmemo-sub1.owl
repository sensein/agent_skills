   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-QWPDF38S-8">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-07-06</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-07-02</dcterms:modified>
      <skos:altLabel xml:lang="fr">aphantasie congénitale</skos:altLabel>
      <skos:altLabel xml:lang="en">blind imagination</skos:altLabel>
      <skos:altLabel xml:lang="en">blind mind</skos:altLabel>
      <skos:altLabel xml:lang="en">congenital aphantasia</skos:altLabel>
      <skos:altLabel xml:lang="en">defective revisualizatiion</skos:altLabel>
      <skos:altLabel xml:lang="en">defective revisualization</skos:altLabel>
      <skos:altLabel xml:lang="en">image generation process deficit</skos:altLabel>
      <skos:altLabel xml:lang="en">imagery weakness</skos:altLabel>
      <skos:altLabel xml:lang="en">loss of visualization</skos:altLabel>
      <skos:altLabel xml:lang="en">visual irreminiscence</skos:altLabel>
      <skos:definition xml:lang="fr">Trouble cognitif dans lequel l’imagerie mentale volontaire est réduite ou absente (traduit et adapté de Zeman et al., 2015, p. 379).</skos:definition>
      <skos:definition xml:lang="en">The cognitive disorder in which voluntary mental imagery is reduced or absent (adapted from Zeman et al., 2015, p. 379)</skos:definition>
