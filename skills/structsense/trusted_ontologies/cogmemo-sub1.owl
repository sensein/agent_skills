   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-S4GDHSXF-C">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-02-10</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-24</dcterms:modified>
      <skos:altLabel xml:lang="fr">cortex pariétal</skos:altLabel>
      <skos:altLabel xml:lang="en">parietal cortex</skos:altLabel>
      <skos:altLabel xml:lang="en">parietal region</skos:altLabel>
      <skos:altLabel xml:lang="en">parietal site</skos:altLabel>
      <skos:altLabel xml:lang="fr">région pariétale</skos:altLabel>
      <skos:definition xml:lang="en">A brain lobe located behind the frontal lobe and above the temporal lobe.</skos:definition>
      <skos:definition xml:lang="fr">Lobe cérébral situé à l’arrière du lobe frontal et au-dessus du lobe temporal.</skos:definition>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/2CX-NM7R1LX2-Q"/>
      <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001872"/>
      <skos:exactMatch rdf:resource="http://purl.org/sig/ont/fma/fma61826"/>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Parietal_lobe"/>
      <skos:exactMatch rdf:resource="https://fr.wikipedia.org/wiki/Lobe_pari%C3%A9tal"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q815334"/>
      <skos:hiddenLabel xml:lang="fr">lobes pariétaux</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">parietal lobes</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">régions pariétales</skos:hiddenLabel>
      <skos:prefLabel xml:lang="fr">lobe pariétal</skos:prefLabel>
      <skos:prefLabel xml:lang="en">parietal lobe</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
