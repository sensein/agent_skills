      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychophysiologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-MZP94WL9-J">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-17</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-04</dcterms:modified>
      <skos:altLabel xml:lang="en">EEG</skos:altLabel>
      <skos:altLabel xml:lang="fr">EEG</skos:altLabel>
      <skos:definition xml:lang="en">"[...] recording of electrical activity generated by brain neuronal functioning." (Campaign &amp; Vercueil, 2013, p. 21).</skos:definition>
      <skos:definition xml:lang="fr">« [...] enregistrement de l’activité électrique générée par le fonctionnement neuronal cérébral. » (Campagne &amp; Vercueil, 2013, p. 21).</skos:definition>
