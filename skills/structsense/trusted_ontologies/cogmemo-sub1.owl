      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q18619"/>
      <skos:hiddenLabel xml:lang="fr">effets d'amorçage</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">priming effects</skos:hiddenLabel>
      <skos:prefLabel xml:lang="fr">effet d'amorçage</skos:prefLabel>
      <skos:prefLabel xml:lang="en">priming effect</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
