   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-ZPVBGPM8-D">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-20</dcterms:modified>
      <skos:altLabel xml:lang="fr">auto-efficacité mnésique</skos:altLabel>
      <skos:altLabel xml:lang="fr">efficacité personnelle mnésique</skos:altLabel>
      <skos:definition xml:lang="fr">Perception subjective de l'efficacité de sa mémoire dans des situations variées.</skos:definition>
      <skos:definition xml:lang="en">Subjective perception of the efficacy of our own memory in various situations.</skos:definition>
      <skos:hiddenLabel xml:lang="en">memory self-efficacies</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">sentiments d'efficacité mnésique</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">memory self-efficacy</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">sentiment d'efficacité mnésique</skos:prefLabel>
