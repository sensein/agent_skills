   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-JK6SBS9M-3">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-28</dcterms:modified>
      <skos:definition xml:lang="en">A computational model of concept organization in semantic memory, where concepts are represented as nodes in a network and semantic relationships between concepts are represented as edges.</skos:definition>
      <skos:definition xml:lang="fr">Modèle computationnel de l’organisation des concepts en mémoire sémantique, dans lequel les concepts sont représentés par des nœuds, reliés entre eux par des relatons sémantiques représentées par des arcs.</skos:definition>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Semantic_network"/>
      <skos:exactMatch rdf:resource="https://fr.wikipedia.org/wiki/Réseau_sémantique"/>
      <skos:exactMatch rdf:resource="https://www.cognitiveatlas.org/concept/id/trm_51838baad343e"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q1045785"/>
      <skos:hiddenLabel xml:lang="fr">réseaux sémantiques</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">semantic networks</skos:hiddenLabel>
      <skos:prefLabel xml:lang="fr">réseau sémantique</skos:prefLabel>
      <skos:prefLabel xml:lang="en">semantic network</skos:prefLabel>
      <skos:scopeNote xml:lang="fr">Certains réseaux sémantiques reposent sur une organisation hiérarchique d'inclusion de classes (Collins &amp; Quillian, 1969). Dans d'autres réseaux sémantiques, les liens représentent la distance sémantique entre concepts (Collins &amp; Loftus, 1975).</skos:scopeNote>
      <skos:scopeNote xml:lang="en">Some semantic networks are based on a hierarchical organization of class inclusion (Collins &amp; Quillian, 1969). In other semantic networks, edges represent the semantic distance between concepts (Collins &amp; Loftus, 1975).</skos:scopeNote>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Collins, A. M., &amp; Quillian, M. R. (1969). Retrieval time from semantic memory. Journal of Verbal Learning and Verbal Behavior, 8(2), 240–247. https://doi.org/10.1016/S0022-5371(69)80069-1</dct:bibliographicCitation>
      <dct:bibliographicCitation>Collins, A. M., &amp; Quillian, M. R. (1969). Temps de récupération en mémoire sémantique. Journal of Verbal Learning and Verbal Behavior, 8(2), 240–247. Traduit dans Nicolas, S., &amp; Piolino, M. P. (2010). Anthologie de psychologie cognitive de la mémoire : fonctionnalisme et structuralisme (pp. 73-84). De Boeck Supérieur.</dct:bibliographicCitation>
      <dct:bibliographicCitation>Collins, A. M., &amp; Loftus, E. F. (1975). A spreading-activation theory of semantic processing. Psychological Review, 82(6), 407–428. https://doi.org/10.1037/0033-295X.82.6.407</dct:bibliographicCitation>
      <dct:bibliographicCitation>Quillian, M. R. (1967). Word concepts : A theory and simulation of some basic semantic capabilities. Behavioral Science, 12(5), 410‑430. https://doi.org/10.1002/bs.3830120511</dct:bibliographicCitation>
