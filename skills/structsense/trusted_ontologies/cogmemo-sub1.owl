   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-SND7VPGK-L">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-03-13</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-03</dcterms:modified>
      <inist:domain xml:lang="fr">Psychologie</inist:domain>
      <inist:domain xml:lang="en">Psychology</inist:domain>
      <inist:semCategory xml:lang="fr">Homme</inist:semCategory>
      <inist:semCategory xml:lang="en">Human</inist:semCategory>
      <skos:definition xml:lang="en">A memory phenomenon observed when words containing rare letters are recognized better than words composed of common letters.</skos:definition>
      <skos:definition xml:lang="fr">Phénomène de la mémoire observé lorsque la reconnaissance de mots comportant des lettres rares est supérieure à celle de mots composés de lettres fréquentes.</skos:definition>
      <skos:prefLabel xml:lang="fr">effet de la fréquence des lettres</skos:prefLabel>
      <skos:prefLabel xml:lang="en">letter-frequency effect</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Malmberg, K. J., Steyvers, M., Stephens, J. D., &amp; Shiffrin, R. M. (2002). Feature frequency effects in recognition memory. Memory &amp; Cognition, 30(4), 607–613. https://doi.org/10.3758/BF03194962</dct:bibliographicCitation>
      <inist:hasModel rdf:resource="http://data.loterre.fr/ark:/67375/P66-R9TV9KX5-3"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-Q8F0T8B5-0"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-DP4NMT2L-9"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-KCJ85PL3-0"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-Z65R7GWM-8"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-SNPS20VK-C">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-12</dcterms:modified>
      <skos:altLabel xml:lang="fr">biais de mémoire</skos:altLabel>
      <skos:definition xml:lang="en">A memory phenomenon characterized by a preference for a processing type of information or for particular memories.</skos:definition>
      <skos:definition xml:lang="fr">Phénomène de la mémoire qui se caractérise par une préférence pour un type de traitement des informations ou des types de souvenirs particuliers.</skos:definition>
      <skos:hiddenLabel xml:lang="fr">biais mnésiques</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">memory biases</skos:hiddenLabel>
      <skos:prefLabel xml:lang="fr">biais mnésique</skos:prefLabel>
      <skos:prefLabel xml:lang="en">memory bias</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Schacter, D. L. (2003). Science de la mémoire. Oublier et se souvenir. Odile Jacob.</dct:bibliographicCitation>
      <dct:bibliographicCitation>Schacter, D. L. (2021). The seven sins of memory : An update. Memory, 30(1), 37-42. https://doi.org/10.1080/09658211.2021.1873391</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-RQWF016Q-4"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-STBPVNZ5-P">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-28</dcterms:modified>
      <skos:definition xml:lang="en">A memory phenomenon observed when the recall of an item is followed by the recall of the item that succeeded it in the study list, rather than the item that preceded it.</skos:definition>
      <skos:definition xml:lang="fr">Phénomène de la mémoire observé lorsque le rappel d'un item est suivi de celui de l'item qui lui succédait dans la liste d'étude, plutôt que de celui qui le précédait.</skos:definition>
      <skos:prefLabel xml:lang="en">asymmetry effect</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">effet d'asymétrie</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Kahana, M. J. (1996). Associative retrieval processes in free recall. Memory &amp; Cognition, 24(1), 103–109. https://doi.org/10.3758/BF03197276</dct:bibliographicCitation>
