   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-PB0PJVKN-B">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-21</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-04</dcterms:modified>
      <skos:altLabel xml:lang="en">P.V. case</skos:altLabel>
      <skos:altLabel xml:lang="fr">cas P.V.</skos:altLabel>
      <skos:definition xml:lang="en">A patient suffering from a pure and specific phonological immediate memory impairment (Basso et al., 1982).</skos:definition>
      <skos:definition xml:lang="fr">Patiente souffrant d’un trouble pur et spécifique de la mémoire immédiate phonologique (Basso et al., 1982).</skos:definition>
      <skos:hiddenLabel xml:lang="en">PV case</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">PV patient</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">cas PV</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">patiente PV</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">patient P.V.</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">patiente P.V.</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Basso, A., Spinnler, H., Vallar, G., &amp; Zanobio, M. E. (1982). Left hemisphere damage and selective impairment of auditory verbal short-term memory. A case study. Neuropsychologia, 20(3), 263–274. https://doi.org/10.1016/0028-3932(82)90101-4</dct:bibliographicCitation>
      <dct:bibliographicCitation>Vallar, G., &amp; Baddeley, A. D. (1984a). Fractionation of working memory: Neuropsychological evidence for a phonological short-term store. Journal of Verbal Learning and Verbal Behavior, 23(2), 151–161. https://doi.org/10.1016/S0022-5371(84)90104-X</dct:bibliographicCitation>
      <dct:bibliographicCitation>Vallar, G., &amp; Baddeley, A. D. (1984b). Phonological short-term store, phonological processing and sentence comprehension: A neuropsychological case study. Cognitive Neuropsychology, 1(2), 121–141. https://doi.org/10.1080/02643298408252018</dct:bibliographicCitation>
