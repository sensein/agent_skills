   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-BBGPGCTN-W">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-20</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-20</dcterms:modified>
      <skos:definition xml:lang="en">A memory phenomenon occurring when an eyewitness tends to choose a suspect—guilty or innocent—presented in successive police lineups, but each time with different fillers.</skos:definition>
      <skos:definition xml:lang="fr">Phénomène de la mémoire se manifestant lorsqu’un témoin oculaire a tendance à choisir un suspect — coupable ou innocent — présentés dans des tapissages successifs, mais à chaque fois avec des figurants différents.</skos:definition>
      <skos:prefLabel xml:lang="fr">effet du suspect répété</skos:prefLabel>
      <skos:prefLabel xml:lang="en">repeated-suspect effect</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Quigley-McBride, A., &amp; Wells, G. L. (2025). Biased lineups and additional repetitions exacerbate the repeated-suspect effect. Journal of Experimental Psychology: Applied. (2026-84038-001). https://doi.org/10.1037/xap0000553</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-RQWF016Q-4"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-D304PDBZ-3"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-D720VZZ8-3"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-QZMCKTT5-1"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-MemoryAndLawGroup"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-R4QG3T7H-7">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-24</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-24</dcterms:modified>
      <skos:altLabel xml:lang="fr">souvenir autobiographique épisodique</skos:altLabel>
      <skos:definition xml:lang="en">Autobiographical memory of a personal event, localizable in time and space, selected by the subject themselves, outside of a laboratory setting or items chosen by an experimenter.</skos:definition>
      <skos:definition xml:lang="fr">Mémoire autobiographique d’un événement personnel, localisable dans le temps et l’espace, sélectionné par le sujet lui-même, en dehors d’une situation vécue en laboratoire et d’éléments à mémoriser choisis par un expérimentateur.</skos:definition>
      <skos:hiddenLabel xml:lang="en">episodic autobiographical memories</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">souvenirs autobiographiques épisodiques</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">episodic autobiographical memory</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">mémoire autobiographique épisodique</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Daviddi, S., Pedale, T., St. Jacques, P. L., Schacter, D. L., &amp; Santangelo, V. (2023). Common and distinct correlates of construction and elaboration of episodic-autobiographical memory: An ALE meta-analysis. Cortex, 163, 123–138. https://doi.org/10.1016/j.cortex.2023.03.005</dct:bibliographicCitation>
      <dct:bibliographicCitation>Daviddi, S., Yaya, G., Sperduti, M., &amp; Santangelo, V. (2024). A systematic review and meta-analysis of the neural correlates of direct vs. Generative retrieval of episodic autobiographical memory. Neuropsychology Review, 35(4), 710–730. https://doi.org/10.1007/s11065-024-09653-3</dct:bibliographicCitation>
      <inist:hasModel rdf:resource="http://data.loterre.fr/ark:/67375/P66-C77ZWH5V-0"/>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-BJF9SGC9-N"/>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-CXXQ0BLH-5"/>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-D6LFMB15-2"/>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-FKSPM177-M"/>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-GV12X82M-C"/>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-GXN88QST-D"/>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-HWQ92S0R-Z"/>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-K2XK742Z-X"/>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-KN71C2N1-W"/>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-L5WLGK5F-D"/>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-LDM0KGH7-9"/>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-LJN4259T-9"/>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-MJRRB9G2-B"/>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-R19Q943T-B"/>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-RG5H7LCR-N"/>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-X44FVTW0-Z"/>
