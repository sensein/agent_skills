      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-MemoryAndLawGroup"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-M931G1N6-G">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-08-27</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-04</dcterms:modified>
      <skos:definition xml:lang="en">An attention phenomenon observed when two successive visual stimuli, separated by a time interval between 200 ms and 500 ms, are presented and observers fail to report the second stimulus.</skos:definition>
      <skos:definition xml:lang="fr">Phénomène de l'attention observé lorsque deux stimuli visuels successifs, séparés par un intervalle de temps compris entre 200 ms et 500 ms, sont présentés et que les observateurs échouent à rapporter le second stimulus.</skos:definition>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/JVR-TP3CTW73-0"/>
      <skos:exactMatch rdf:resource="http://www.scholarpedia.org/article/Attentional_blink"/>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/N9J-Z17SQLKM-7"/>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Attentional_blink"/>
      <skos:exactMatch rdf:resource="https://www.cognitiveatlas.org/concept/id/trm_4fea1aeaa7b17/"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q759843"/>
      <skos:prefLabel xml:lang="en">attentional blink</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">clignement attentionnel</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Grassi, M., Crotti, C., Giofrè, D., Boedker, I., &amp; Toffalini, E. (2021). Two replications of Raymond, Shapiro, and Arnell (1992), The Attentional Blink. Behavior Research Methods, 53(2), 656‑668. https://doi.org/10.3758/s13428-020-01457-6</dct:bibliographicCitation>
      <dct:bibliographicCitation>Raymond, J. E., Shapiro, K. L., &amp; Arnell, K. M. (1992). Temporary suppression of visual processing in an RSVP task : An attentional blink? Journal of Experimental Psychology: Human Perception and Performance, 18(3), 849‑860. https://doi.org/10.1037/0096-1523.18.3.849</dct:bibliographicCitation>
      <dct:bibliographicCitation>Shapiro, K., &amp; Raymond, J. (2025). The attentional blink: Then and now. Journal of Experimental Psychology: Human Perception and Performance, 51(11), 1464–1475. https://doi.org/10.1037/xhp0001350</dct:bibliographicCitation>
      <dct:bibliographicCitation>Weichselgartner, E., &amp; Sperling, G. (1987). Dynamics of automatic and controlled visual attention. Science (New York, N.Y.), 238(4828), 778‑780. https://doi.org/10.1126/science.3672124</dct:bibliographicCitation>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-GNQL7X5H-B"/>
