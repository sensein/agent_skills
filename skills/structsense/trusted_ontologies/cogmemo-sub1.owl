      <skos:altLabel xml:lang="fr">récupération volontaire</skos:altLabel>
      <skos:altLabel xml:lang="en">voluntary retrieval</skos:altLabel>
      <skos:definition xml:lang="en">A memory retrieved in an intentional, deliberate and controlled manner.</skos:definition>
      <skos:definition xml:lang="fr">Souvenir récupéré de manière intentionnelle, délibérée et contrôlée.</skos:definition>
      <skos:hiddenLabel xml:lang="fr">souvenirs volontaires</skos:hiddenLabel>
