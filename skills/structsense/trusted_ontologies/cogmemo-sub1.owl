   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-NK01KNV9-7">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-14</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-04</dcterms:modified>
      <skos:altLabel xml:lang="en">PMCQ</skos:altLabel>
      <skos:altLabel xml:lang="fr">PMCQ</skos:altLabel>
      <skos:definition xml:lang="en">A 35-item self-report questionnaire of prospective memory problems and concerns in daily life.</skos:definition>
      <skos:definition xml:lang="fr">Questionnaire d’autoévaluation de 35 items portant sur les problèmes et préoccupations dans la vie quotidienne concernant la mémoire prospective.</skos:definition>
      <skos:prefLabel xml:lang="en">Prospective Memory Concerns Questionnaire</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Questionnaire des préoccupations sur la mémoire prospective</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Sugden, N., Thomas, M., Kiernan, M., &amp; Wilesmith, M. (2021). Validation of the Prospective Memory Concerns Questionnaire (PMCQ). Frontiers in Human Neuroscience, 15, 421. https://doi.org/10.3389/fnhum.2021.686850</dct:bibliographicCitation>
      <inist:isDiagnosticToolOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-GNBK2L59-K"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-HM6SF432-R"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-W1LP7KG3-6"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-XNPMCKS4-S"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Z6SQPXCN-P"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-ZXQ7WLTT-K"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-HQM4N2ZZ-M"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
