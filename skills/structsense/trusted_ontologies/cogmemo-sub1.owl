   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-B1XQ3JL0-1">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2018-11-05</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-03-18</dcterms:modified>
      <skos:altLabel xml:lang="fr">latence de la réponse</skos:altLabel>
      <skos:altLabel xml:lang="en">response latency</skos:altLabel>
      <skos:altLabel xml:lang="en">response time</skos:altLabel>
      <skos:altLabel xml:lang="fr">temps de réponse</skos:altLabel>
      <skos:definition xml:lang="fr">Temps écoulé entre l'apparition du stimulus et celle de la réponse, avec pour consigne de répondre le plus rapidement possible tout en limitant les erreurs.</skos:definition>
      <skos:definition xml:lang="en">Time elapsed between the onset of the stimulus and the response, with the instruction to respond as quickly as possible while minimizing errors.</skos:definition>
