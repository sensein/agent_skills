   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-BX5D54L4-6">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-03-29</dcterms:modified>
      <skos:altLabel xml:lang="en">aMCI</skos:altLabel>
      <skos:definition xml:lang="fr">Déficit cognitif léger limité à des troubles de la mémoire épisodique.</skos:definition>
      <skos:definition xml:lang="en">Mild cognitive impairment limited to disorders of episodic memory.</skos:definition>
      <skos:prefLabel xml:lang="en">amnestic mild cognitive impairment</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">déficit cognitif léger amnésique</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
