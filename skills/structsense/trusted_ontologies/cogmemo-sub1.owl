   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-VWX3SX1X-5">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-31</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-04</dcterms:modified>
      <skos:definition xml:lang="en">A method for studying how subjects subjectively evaluate their memory experiences, performance and functioning.</skos:definition>
      <skos:definition xml:lang="fr">Méthode d'étude de la manière dont les sujets évaluent subjectivement leurs expériences mnésiques, la performance et le fonctionnement de leur mémoire.</skos:definition>
      <skos:prefLabel xml:lang="fr">méthode subjective d'étude de la mémoire</skos:prefLabel>
      <skos:prefLabel xml:lang="en">subjective study method of memory</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Otani, H., &amp; Schwartz, B. L. (Eds.). (2018). Handbook of research methods in human memory. Routledge. https://doi.org/10.4324/9780429439957</dct:bibliographicCitation>
