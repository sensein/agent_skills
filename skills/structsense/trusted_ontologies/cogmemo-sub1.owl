      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-VBNTF4K7-N">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-03-17</dcterms:modified>
      <skos:definition xml:lang="en">According to Tulving, procedural memory is said to be anoetic as it is expressed directly in behavior and action, i.e. without consciousness.</skos:definition>
      <skos:definition xml:lang="fr">Selon Tulving, la mémoire procédurale est dite anoétique car elle s’exprime directement dans les comportements et l’action, sans conscience.</skos:definition>
      <skos:prefLabel xml:lang="en">anoetic consciousness</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">conscience anoétique</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Tulving, E. (1985). Memory and consciousness. Canadian Psychology/Psychologie Canadienne, 26(1), 1‑12. https://doi.org/10.1037/h0080017</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-QZXRZM22-5"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-DRFF94SX-B"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-NLZ8TQF6-1"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-W2MHDGTB-7">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-07-06</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-12-11</dcterms:modified>
      <skos:altLabel xml:lang="en">vividness</skos:altLabel>
      <skos:definition xml:lang="en">A phenomenological characteristic reported by a person when their memory of a past experience contains many sensory details.</skos:definition>
      <skos:definition xml:lang="fr">Caractéristique phénoménologique rapportée par une personne lorsque son souvenir d'une expérience passée contient de nombreux détails sensoriels</skos:definition>
      <skos:hiddenLabel xml:lang="fr">vivacité des souvenirs</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">memory vividness</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">vivacité du souvenir</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Morton, C., &amp; MacLeod, A. K. (2023). Vividness of imagery and affective response to episodic memories and episodic future thoughts: A systematic review and meta-analysis. Memory, 31(8), 1098–1110. https://doi.org/10.1080/09658211.2023.2224609</dct:bibliographicCitation>
