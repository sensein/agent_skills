      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-MemoryAndLawGroup"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Probabilités__Statistiques"/>
