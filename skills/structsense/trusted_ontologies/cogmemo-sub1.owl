   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-KP127V63-W">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-05-12</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-10-25</dcterms:modified>
      <skos:altLabel xml:lang="en">suppression</skos:altLabel>
      <skos:altLabel xml:lang="fr">suppression</skos:altLabel>
      <skos:definition xml:lang="en">An active process that reduces the level of activation of a memory trace and makes it less accessible.</skos:definition>
      <skos:definition xml:lang="fr">Processus actif qui réduit le niveau d’activation d’une trace mnésique et la rend moins accessible.</skos:definition>
      <skos:exactMatch rdf:resource="http://cognitiveatlas.org/concept/id/trm_4a3fd79d0a613/"/>
