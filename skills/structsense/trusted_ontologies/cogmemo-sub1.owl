      <skos:altLabel xml:lang="en">eyewitness</skos:altLabel>
      <skos:altLabel xml:lang="en">eyewitness evidence</skos:altLabel>
      <skos:altLabel xml:lang="en">eyewitness identification</skos:altLabel>
      <skos:altLabel xml:lang="en">eyewitness memory</skos:altLabel>
      <skos:altLabel xml:lang="en">eyewitness report</skos:altLabel>
      <skos:altLabel xml:lang="fr">témoin oculaire</skos:altLabel>
      <skos:definition xml:lang="en">A form of testimony in which a person states what he or she has seen about facts or events.</skos:definition>
      <skos:definition xml:lang="fr">Forme de témoignage durant lequel une personne déclare ce qu’elle a vu à propos de faits ou d’événements.</skos:definition>
