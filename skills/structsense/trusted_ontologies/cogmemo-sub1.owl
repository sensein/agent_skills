   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-HD257SDH-X">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-02-01</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-04</dcterms:modified>
      <skos:altLabel xml:lang="fr">programme de renforcement fractionné variable</skos:altLabel>
      <skos:altLabel xml:lang="fr">programme à rapport variable</skos:altLabel>
      <skos:altLabel xml:lang="en">variable-ratio schedule</skos:altLabel>
      <skos:definition xml:lang="fr">Programme de renforcement fractionné dans lequel le renforcement est délivré après un nombre variable de réponses fluctuant autour d’une moyenne.</skos:definition>
      <skos:definition xml:lang="en">Ratio schedule of reinforcement n which reinforcement is delivered after a variable number of responses fluctuating around an average.</skos:definition>
      <skos:prefLabel xml:lang="fr">programme de renforcement à rapport variable</skos:prefLabel>
      <skos:prefLabel xml:lang="en">variable ratio schedule of reinforcement</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Ferster, C. B., &amp; Skinner, B. F. (1957). Schedules of reinforcement. Appleton-Century-Crofts.</dct:bibliographicCitation>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-L63H1FX6-6"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-VN4KQNR0-W"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-GLDMMHP5-S"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Animal"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-X9PTDJPX-J">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-02-01</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-04</dcterms:modified>
      <skos:altLabel xml:lang="en">fixed-ratio schedule</skos:altLabel>
      <skos:altLabel xml:lang="fr">programme de renforcement fractionné fixe</skos:altLabel>
      <skos:altLabel xml:lang="fr">programme à rapport fixe</skos:altLabel>
      <skos:definition xml:lang="fr">Programme de renforcement fractionné au cours duquel le renforcement est délivré après un nombre fixe de réponses.</skos:definition>
      <skos:definition xml:lang="en">Ratio schedule of reinforcement in which the reinforcement is delivered after a fixed number of responses.</skos:definition>
      <skos:prefLabel xml:lang="en">fixed ratio schedule of reinforcement</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">programme de renforcement à rapport fixe</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Ferster, C. B., &amp; Skinner, B. F. (1957). Schedules of reinforcement. Appleton-Century-Crofts.</dct:bibliographicCitation>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-L63H1FX6-6"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-VN4KQNR0-W"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-GLDMMHP5-S"/>
