   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-D720VZZ8-3">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-07-28</dcterms:modified>
      <skos:altLabel xml:lang="fr">souvenir autobiographique</skos:altLabel>
      <skos:definition xml:lang="en">Declarative memory concerning the personal past of the individual, encompassing episodic memories of experienced and contextualized events as well as general, decontextualized semantic knowledge about the self.</skos:definition>
      <skos:definition xml:lang="fr">Mémoire déclarative comprenant les souvenirs épisodiques d’événements personnellement vécus et contextualisés dans le temps et l’espace, ainsi que les connaissances sémantiques générales et décontextualisées sur soi.</skos:definition>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/2CX-V7FM5JBS-N"/>
      <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/NBO_0000195"/>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Autobiographical_memory"/>
      <skos:exactMatch rdf:resource="https://www.cognitiveatlas.org/concept/id/trm_4a3fd79d09b10"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q682304"/>
      <skos:hiddenLabel xml:lang="en">autobiographical memories</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">souvenirs autobiographiques</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">autobiographical memory</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">mémoire autobiographique</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Beike, D. R., Merrick, C. R., &amp; Cole, H. E. (2020). Use, adaptivity, and need fulfillment: A methodological critique of tests of the functions of autobiographical memory. Psychological Reports, 123(1), 43–70. https://doi.org/10.1177/0033294119852578</dct:bibliographicCitation>
      <dct:bibliographicCitation>Berntsen, D., &amp; Rubin, D. C. (Eds.). (2012). Understanding Autobiographical Memory: Theories and Approaches. Cambridge University Press.</dct:bibliographicCitation>
      <dct:bibliographicCitation>Boccia, M., Teghil, A., &amp; Guariglia, C. (2019). Looking into recent and remote past: Meta-analytic evidence for cortical re-organization of episodic autobiographical memories. Neuroscience &amp; Biobehavioral Reviews, 107, 84–95. https://doi.org/10.1016/j.neubiorev.2019.09.003</dct:bibliographicCitation>
      <dct:bibliographicCitation>Heux, L., Rathbone, C., Gensburger, S., Clifford, R., &amp; Souchay, C. (2023). Collective memory and autobiographical memory: Perspectives from the humanities and cognitive sciences, 14(3), e1635. WIREs Cognitive Science, e1635. https://doi.org/10.1002/wcs.1635</dct:bibliographicCitation>
      <dct:bibliographicCitation>Kopelman, M. D. (2019). Anomalies of autobiographical memory. Journal of the International Neuropsychological Society, 25(10), 1061–1075. https://doi.org/10.1017/S135561771900081X</dct:bibliographicCitation>
      <dct:bibliographicCitation>Mace, J. (2019). The organization and structure of autobiographical memory. Oxford University Press.</dct:bibliographicCitation>
      <dct:bibliographicCitation>Piolino, P., Desgranges, B., Eustache, F. (2000). La mémoire autobiographique : théorie et pratique. Solal</dct:bibliographicCitation>
      <dct:bibliographicCitation>Shepardson, S., Dahlgren, K., &amp; Hamann, S. (2023). Neural correlates of autobiographical memory retrieval: An SDM neuroimaging meta-analysis. Cortex, 166, 59–79. https://doi.org/10.1016/j.cortex.2023.05.006</dct:bibliographicCitation>
      <dct:bibliographicCitation>Sow, F., Dijkstra, K., &amp; Janssen, S. M. J. (2023). Developments in the functions of autobiographical memory: An advanced review. WIREs Cognitive Science, 14(3), e1625. https://doi.org/10.1002/wcs.1625</dct:bibliographicCitation>
      <dct:bibliographicCitation>Talarico, J. M. (2023). A tetrahedral model of autobiographical memory research design. WIREs Cognitive Science, 14(3), e1615. https://doi.org/10.1002/wcs.1615</dct:bibliographicCitation>
      <dct:bibliographicCitation>Testa, G., Sotgiu, I., Rusconi, M. L., Cauda, F., &amp; Costa, T. (2024). The functional neuroimaging of autobiographical memory for happy events: A coordinate-based meta-analysis. Healthcare, 12(7), Article 7. https://doi.org/10.3390/healthcare12070711</dct:bibliographicCitation>
