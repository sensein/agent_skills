   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-PZFN3RVK-9">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-08-20</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-04</dcterms:modified>
      <skos:definition xml:lang="fr">En mémoire de travail, processus permettant de différencier les items nouveaux des items anciens qui ne sont plus pertinents.</skos:definition>
      <skos:definition xml:lang="en">In working memory, the process by which new items are differentiated from old items that are no longer relevant.</skos:definition>
      <skos:prefLabel xml:lang="fr">marquage temporel</skos:prefLabel>
      <skos:prefLabel xml:lang="en">temporal tagging</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Jonides, J., &amp; Smith, E. E. (1997). The archirecture of working memory. In M. D. Rugg (Ed.), Cognitive neuroscience (p. 243‑276). MIT Press.</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-D7HZ1ZFN-K"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-KK6LXTL8-P"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-XJSCVLBW-B"/>
