   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-ZBVPW5Z1-K">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-03-19</dcterms:modified>
      <skos:definition xml:lang="fr">Processus mnésique permettant d'associer en mémoire des souvenirs différents afin de créer une représentation qui sera traitée comme une seule entité.</skos:definition>
      <skos:definition xml:lang="en">The memory process of associating different memories to create a representation that will be processed as a single entity.</skos:definition>
      <skos:prefLabel xml:lang="fr">unitisation</skos:prefLabel>
      <skos:prefLabel xml:lang="en">unitization</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Graf, P., &amp; Schacter, D. L. (1989). Unitization and grouping mediate dissociations in memory for new associations. Journal of Experimental Psychology: Learning, Memory, and Cognition, 15(5), 930-940. https://doi.org/10.1037/0278-7393.15.5.930</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-D7HZ1ZFN-K"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-JQRWWNLB-8"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-PM36DL1T-K">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-29</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-16</dcterms:modified>
      <skos:altLabel xml:lang="en">VVIQ</skos:altLabel>
      <skos:altLabel xml:lang="fr">VVIQ</skos:altLabel>
      <skos:altLabel xml:lang="en">VVIQ-2</skos:altLabel>
      <skos:altLabel xml:lang="fr">VVIQ-2</skos:altLabel>
      <skos:altLabel xml:lang="en">VVIQ-RV</skos:altLabel>
      <skos:altLabel xml:lang="fr">VVIQ-RV</skos:altLabel>
      <skos:altLabel xml:lang="fr">Vividness of Visual Imagery Questionnaire</skos:altLabel>
      <skos:altLabel xml:lang="en">Vividness of Visual Imagery Questionnaire-Modified</skos:altLabel>
      <skos:altLabel xml:lang="en">Vividness of Visual Imagery Questionnaire-Revised Version</skos:altLabel>
      <skos:definition xml:lang="en">Questionnaire assessing individual differences in the vividness of visual imagery. Participants are asked to mentally visualize various scenes with their eyes open and then closed, and to rate the vividness of the mental image on a five-point scale.</skos:definition>
      <skos:definition xml:lang="fr">Questionnaire évaluant les différences individuelles dans la vivacité de l’imagerie visuelle. Les participants doivent visualiser mentalement, les yeux ouverts puis fermés, différentes scènes et indiquer, sur une échelle en cinq points, le niveau de vivacité de l’image mentale.</skos:definition>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Vividness_of_Visual_Imagery_Questionnaire"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q7937841"/>
      <skos:hiddenLabel xml:lang="en">VVIQ2</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">VVIQ2</skos:hiddenLabel>
      <skos:prefLabel xml:lang="fr">Questionnaire de vivacité de l’imagerie visuelle</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Vividness of Visual Imagery Questionnaire</skos:prefLabel>
      <skos:scopeNote xml:lang="fr">Plusieurs versions modifiées du questionnaire existent et une version en français est disponible (Santarpia et al., 2008).</skos:scopeNote>
      <skos:scopeNote xml:lang="en">Several modified versions of the questionnaire have been published and a French version is available (Santarpia et al., 2008).</skos:scopeNote>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Campos, A., &amp; Pérez-Fabello, M. J. (2009). Psychometric quality of a revised version Vividness of Visual Imagery Questionnaire. Perceptual and Motor Skills, 108(3), 798–802. https://doi.org/10.2466/pms.108.3.798-802</dct:bibliographicCitation>
      <dct:bibliographicCitation>Marks, D. F. (1973). Visual imagery differences in the recall of pictures. British Journal of Psychology, 64(1), 17–24. https://doi.org/10.1111/j.2044-8295.1973.tb01322.x</dct:bibliographicCitation>
      <dct:bibliographicCitation>Marks, D. F. (1995). New directions for mental imagery research. Journal of Mental Imagery, 19(3–4), 153–167.</dct:bibliographicCitation>
      <dct:bibliographicCitation>Santarpia, A., Blanchet, A., Poinsot, R., Lambert, J.-F., Mininni, G., &amp; Thizon-Vidal, S. (2008). Évaluer la vivacité des images mentales dans différentes populations françaises. Pratiques Psychologiques, 14(3), 421–441. https://doi.org/10.1016/j.prps.2007.11.001</dct:bibliographicCitation>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-BMQD5QZM-G"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-FFDHW6FD-F"/>
