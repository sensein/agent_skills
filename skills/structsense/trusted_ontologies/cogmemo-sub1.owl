   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-WN352KCP-3">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-24</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-24</dcterms:modified>
      <skos:definition xml:lang="en">A complex span task where participants are asked to rehearse the first three or four letters of a series aloud while memorizing the following letters for immediate serial recall.</skos:definition>
      <skos:definition xml:lang="fr">Tâche d'empan complexe dans laquelle les participants doivent répéter à voix haute les trois ou quatre premières lettres d’une série tout en mémorisant les lettres suivantes pour un rappel sériel immédiat.</skos:definition>
      <skos:prefLabel xml:lang="en">maxispan procedure</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">procédure d’empan maximal</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Barrouillet, P., Gorin, S., &amp; Camos, V. (2021). Simple spans underestimate verbal working memory capacity. Journal of Experimental Psychology: General, 150(4), 633–665. (2020-74576-001). https://doi.org/10.1037/xge0000957</dct:bibliographicCitation>
      <dct:bibliographicCitation>Gorin, S., Camos, V., &amp; Barrouillet, P. (2025). The maxispan procedure makes the phonological similarity effect disappear while increasing recall performance. Psychonomic Bulletin &amp; Review, 32(2), 887–895. https://doi.org/10.3758/s13423-024-02594-1</dct:bibliographicCitation>
      <inist:hasComponent rdf:resource="http://data.loterre.fr/ark:/67375/P66-JB1Z9TF3-H"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-KK6LXTL8-P"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-KQ1K76V2-C"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-BJCZPBGL-X"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-C14W3JK3-W"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-Q4Z8Z9C8-9">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-25</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-25</dcterms:modified>
      <skos:altLabel xml:lang="en">AUC</skos:altLabel>
      <skos:altLabel xml:lang="fr">AUC</skos:altLabel>
      <skos:altLabel xml:lang="en">AUROC</skos:altLabel>
      <skos:altLabel xml:lang="fr">AUROC</skos:altLabel>
      <skos:altLabel xml:lang="en">pAUC</skos:altLabel>
      <skos:altLabel xml:lang="fr">pAUC</skos:altLabel>
      <skos:definition xml:lang="en">A measure, in signal detection theory, of an observer's ability to discriminate between two states (signal vs. noise), independent of the response criterion, and corresponding to the area under the ROC curve.</skos:definition>
      <skos:definition xml:lang="fr">Mesure, en théorie de la détection du signal, de la capacité d’un observateur à discriminer entre deux états (signal vs bruit), indépendante du critère de réponse, et correspondant à la surface située sous la courbe ROC.</skos:definition>
      <skos:prefLabel xml:lang="fr">aire sous la courbe</skos:prefLabel>
      <skos:prefLabel xml:lang="en">area under the curve</skos:prefLabel>
      <skos:scopeNote xml:lang="fr">La définition est adaptée à la psychologie cognitive et à l'étude de la mémoire de reconnaissance, où les deux états correspondent généralement à la distinction entre des items anciennement appris (cibles) et des items nouveaux (leurres).</skos:scopeNote>
      <skos:scopeNote xml:lang="en">The definition is adapted for cognitive psychology and the study of recognition memory, where the two states typically correspond to the distinction between previously learned items (targets) and new items (lures).</skos:scopeNote>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Riesthuis, P., &amp; Otgaar, H. (2024). On the use of receiver operating characteristic area under the curve in eyewitness memory research. Legal and Criminological Psychology, 30(2), 212–230. https://doi.org/10.1111/lcrp.12300</dct:bibliographicCitation>
      <dct:bibliographicCitation>Riesthuis, P., Otgaar, H., &amp; Bücken, C. (2025). Ready to ROC? A tutorial on simulation-based power analyses for null hypothesis significance, minimum-effect, and equivalence testing for ROC curve analyses. Behavior Research Methods, 57(4), 1–20. https://doi.org/10.3758/s13428-025-02646-x</dct:bibliographicCitation>
      <dct:bibliographicCitation>Wixted, J. T., Mickes, L., Wetmore, S. A., Gronlund, S. D., &amp; Neuschatz, J. S. (2017). ROC analysis in theory and practice. Journal of Applied Research in Memory and Cognition, 6(3), 343–351. (2017-45034-014). https://doi.org/10.1016/j.jarmac.2016.12.002</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-XM9K9XL8-S"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-D304PDBZ-3"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-HQVX9TL0-0"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-NRB6T6SW-5"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-QZMCKTT5-1"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-VC9TWVJ8-D"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-VDVMXXP9-C"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-MemoryAndLawGroup"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Probabilités__Statistiques"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-T03TRWLZ-M">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-25</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-26</dcterms:modified>
      <skos:definition xml:lang="en">An objective method for studying episodic memory based on the recall of an object's nature (What), its location (Where), and the time it was hidden (When).</skos:definition>
      <skos:definition xml:lang="fr">Méthode d’étude objective de la mémoire épisodique fondée sur le souvenir de la nature d'un objet caché (Quoi), de sa localisation (Où) et du moment de sa dissimulation (Quand).</skos:definition>
      <skos:prefLabel xml:lang="en">treasure hunt task</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">tâche de la chasse au trésor</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Cheke, L. G., &amp; Clayton, N. S. (2013). Do different tests of episodic memory produce consistent results in human adults? Learning &amp; Memory, 20(9), 491–498. https://doi.org/10.1101/lm.030502.113</dct:bibliographicCitation>
      <dct:bibliographicCitation>Guo, P., Carey, E., Plaisted-Grant, K., &amp; Cheke, L. G. (2024). Episodic memory during middle childhood: What is developing? Journal of Experimental Child Psychology, 240, 105828. https://doi.org/10.1016/j.jecp.2023.105828</dct:bibliographicCitation>
      <dct:bibliographicCitation>Mechie, I. R., Plaisted-Grant, K., &amp; Cheke, L. G. (2021). How does episodic memory develop in adolescence? Learning &amp; Memory, 28(6), 204–217. https://doi.org/10.1101/lm.053264.120</dct:bibliographicCitation>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-DP4NMT2L-9"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-HLDTHX3H-1"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-RG2FNC5H-B"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-BM4VZW20-5"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-DB5H7CC7-C"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-HFLQLV31-8"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-LX7QZR1V-P"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-M5WGN83X-M"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-RZW0J5RS-T"/>
