   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-QG77SB43-1">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-03</dcterms:modified>
      <skos:altLabel xml:lang="fr">autorépétition mentale</skos:altLabel>
      <skos:altLabel xml:lang="fr">autorépétition subvocale</skos:altLabel>
      <skos:altLabel xml:lang="fr">répétition mentale</skos:altLabel>
      <skos:altLabel xml:lang="fr">révision mentale</skos:altLabel>
      <skos:altLabel xml:lang="en">subvocal rehearsal</skos:altLabel>
      <skos:altLabel xml:lang="en">subvocal repetition</skos:altLabel>
      <skos:definition xml:lang="en">Mental rehearsal mechanism to retain information in short-term memory (or in working memory).</skos:definition>
      <skos:definition xml:lang="fr">Mécanisme de répétition mentale permettant de conserver les informations en mémoire à court terme (ou en mémoire de travail).</skos:definition>
      <skos:exactMatch rdf:resource="https://www.cognitiveatlas.org/concept/id/trm_4a3fd79d0ba54"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q6815754"/>
      <skos:hiddenLabel xml:lang="fr">auto-répétition</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">auto-répétition subvocale</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">auto-répétition subvocales</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">auto-répétitions</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">autorépétitions</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">autorépétitions subvocales</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">répétitions mentales</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">révisions mentales</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">subvocal rehearsals</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">subvocal repetitions</skos:hiddenLabel>
      <skos:prefLabel xml:lang="fr">autorépétition</skos:prefLabel>
      <skos:prefLabel xml:lang="en">rehearsal</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Oberauer, K. (2019). Is rehearsal an effective maintenance strategy for working memory? Trends in Cognitive Sciences, 23(9), 798‑809. https://doi.org/10.1016/j.tics.2019.06.002</dct:bibliographicCitation>
      <dct:bibliographicCitation>Ward, G. (2024). Rehearsal processes. In M. J. Kahana &amp; A. D. Wagner (Eds.), The Oxford Handbook of Human Memory: Foundations and Applications (Vol. 1, pp. 614–649). Oxford University Press. https://doi.org/10.1093/oxfordhb/9780190917982.013.22</dct:bibliographicCitation>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-GXGH17KD-G"/>
