   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-RGFWPLNW-K">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-09-11</dcterms:modified>
      <skos:definition xml:lang="en">Metacognition about memory, covering the knowledge that a person has about memory in general and about his or her memory in particular, and the monitoring and control processes during a memory task.</skos:definition>
      <skos:definition xml:lang="fr">Métacognition portant sur la mémoire, incluant les connaissances que possède une personne sur la mémoire en général et sur sa mémoire en particulier, ainsi que les processus de surveillance (monitoring) et de contrôle de sa mémoire pendant la réalisation d'une tâche mnésique.</skos:definition>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/JVR-ZFS4MKLQ-D"/>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Metamemory"/>
