   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-L68X900F-H">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-06-16</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-04-19</dcterms:modified>
      <skos:altLabel xml:lang="en">WalCT</skos:altLabel>
      <skos:definition xml:lang="fr">Adaptation du test de Corsi pour étudier la mémoire de travail topographique. Le sujet doit reproduire un trajet en suivant dans l’ordre une série de carrés sur le sol.</skos:definition>
      <skos:definition xml:lang="en">Adaptation of the Corsi test for the study of topographic working memory. The subject is asked to reproduce a path by sequentially walking along a series of squares on the ground.</skos:definition>
      <skos:prefLabel xml:lang="fr">Test de marche de Corsi</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Walking Corsi Test</skos:prefLabel>
