      <skos:hiddenLabel xml:lang="fr">patients</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">études de cas</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">patient</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">patient</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Barbeau, E. J., Ronat, L., &amp; Didic, M. (2020). Études de cas et neuropsychologie de la mémoire : Et maintenant, c’est fini ? Revue de neuropsychologie, 12(1), 19‑25. https://doi.org/10.1684/nrp.2020.0536</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-TK6NW0S2-V"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-H2RQDV8D-4"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-LHGVCPDS-P"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-MM5S66WC-1"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-PB0PJVKN-B"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-V31CXM91-G"/>
