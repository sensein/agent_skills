   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-P3PC7CZ3-D">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-27</dcterms:modified>
      <skos:altLabel xml:lang="fr">disposition mnésique</skos:altLabel>
      <skos:altLabel xml:lang="fr">fonction mnémonique</skos:altLabel>
      <skos:altLabel xml:lang="fr">fonction mnésique</skos:altLabel>
      <skos:altLabel xml:lang="en">memory disposition</skos:altLabel>
      <skos:altLabel xml:lang="en">memory function</skos:altLabel>
      <skos:altLabel xml:lang="en">memory system</skos:altLabel>
      <skos:altLabel xml:lang="en">mnemonic function</skos:altLabel>
      <skos:altLabel xml:lang="en">mnesic function</skos:altLabel>
      <skos:altLabel xml:lang="fr">système mnésique</skos:altLabel>
      <skos:definition xml:lang="fr">Disposition cognitive à encoder, stocker et récupérer des informations.</skos:definition>
      <skos:definition xml:lang="en">The cognitive disposition to encode, store and retrieve information.</skos:definition>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/2CX-GX3HLBCR-L"/>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/73G-JRL42QWL-7"/>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/JVR-NBDMXCCQ-C"/>
      <skos:exactMatch rdf:resource="http://scholarpedia.org/article/Memory"/>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/N9J-B3PNBGV0-T"/>
      <skos:exactMatch rdf:resource="https://doi.org/10.21428/e2759450.7b57c281"/>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Memory"/>
      <skos:exactMatch rdf:resource="https://fr.wikipedia.org/wiki/Mémoire_(psychologie)"/>
      <skos:exactMatch rdf:resource="https://www.cognitiveatlas.org/concept/id/trm_4a3fd79d0a891"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q492"/>
      <skos:hiddenLabel xml:lang="fr">dispositions mnésiques</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">fonctions mnémoniques</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">fonctions mnésiques</skos:hiddenLabel>
