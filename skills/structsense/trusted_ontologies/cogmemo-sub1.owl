      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-HQM4N2ZZ-M"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-J3F3BBGH-C"/>
