      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-KQ1K76V2-C"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-NNPWFMG5-8"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-QR0GDSGN-J"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-R492C0GF-R"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-T150JWQ4-N"/>
