   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-CV4LXNZN-N">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-01-26</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-04</dcterms:modified>
      <skos:altLabel xml:lang="en">variable interval reinforcement schedule</skos:altLabel>
      <skos:altLabel xml:lang="en">variable interval schedule</skos:altLabel>
      <skos:definition xml:lang="en">An interval schedule of reinforcement in which a behavior is reinforced based on the average time since it was last reinforced.</skos:definition>
      <skos:definition xml:lang="fr">Programme de renforcement à intervalle temporel au cours duquel un comportement est renforcé en fonction du temps moyen écoulé depuis le dernier renforcement.</skos:definition>
      <skos:prefLabel xml:lang="fr">programme de renforcement à intervalle variable</skos:prefLabel>
      <skos:prefLabel xml:lang="en">variable interval schedule of reinforcement</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Ferster, C. B., &amp; Skinner, B. F. (1957). Schedules of reinforcement. Appleton-Century-Crofts.</dct:bibliographicCitation>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-L63H1FX6-6"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-VN4KQNR0-W"/>
