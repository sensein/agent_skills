   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-TFR5FRBS-5">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-11-09</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-11-13</dcterms:modified>
      <skos:definition xml:lang="en">A confabulation consisting of personal habits, which are considered by the patient as specific personal episodes (La Corte et aL, 2010).</skos:definition>
      <skos:definition xml:lang="fr">Confabulations consistant en des habitudes personnelles, qui sont considérées par le patient comme des épisodes personnels spécifiques (La Corte et al., 2010).</skos:definition>
      <skos:hiddenLabel xml:lang="fr">confabulations d'habitudes</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">habits confabulations</skos:hiddenLabel>
      <skos:prefLabel xml:lang="fr">confabulation d’habitude</skos:prefLabel>
      <skos:prefLabel xml:lang="en">habit confabulation</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>La Corte, V., Serra, M., Attali, E., Boissé, M.-F., &amp; Barba, G. D. (2010). Confabulation in Alzheimer’s disease and amnesia: A qualitative account and a new taxonomy. Journal of the International Neuropsychological Society, 16(6), 967–974. https://doi.org/10.1017/S1355617710001001</dct:bibliographicCitation>
      <inist:isDisorderOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-D720VZZ8-3"/>
      <inist:isDisorderOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-DP4NMT2L-9"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-MRRHP6B3-9"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
