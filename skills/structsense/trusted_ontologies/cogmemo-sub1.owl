   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-BJN438BQ-7">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-06-25</dcterms:modified>
      <skos:altLabel xml:lang="en">judgement of relative order</skos:altLabel>
      <skos:altLabel xml:lang="fr">jugement de l'ordre relatif</skos:altLabel>
      <skos:altLabel xml:lang="fr">jugement relatif de récence</skos:altLabel>
      <skos:definition xml:lang="fr">Processus consistant à estimer lequel des deux événements est survenu le plus récemment.</skos:definition>
      <skos:definition xml:lang="en">The process of estimating which of the two events occurred most recently.</skos:definition>
      <skos:hiddenLabel xml:lang="en">judgements of relative order</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">jugements de l'ordre relatif</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">jugements de récence relatifs</skos:hiddenLabel>
