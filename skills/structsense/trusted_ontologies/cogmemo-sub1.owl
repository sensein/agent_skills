   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-DHZ3MS65-D">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-01-13</dcterms:modified>
      <skos:altLabel xml:lang="fr">apprentissage explicite</skos:altLabel>
      <skos:altLabel xml:lang="en">explicit learning</skos:altLabel>
      <skos:definition xml:lang="en">Learning situation in which the subject is notified that his memory will be assessed.</skos:definition>
      <skos:definition xml:lang="fr">Situation d’apprentissage durant laquelle le sujet est prévenu que sa mémoire sera testée.</skos:definition>
