   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-X1M4BRNP-Z">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-03-16</dcterms:modified>
      <skos:altLabel xml:lang="fr">consolidation de la mémoire</skos:altLabel>
      <skos:altLabel xml:lang="fr">consolidation mnésique</skos:altLabel>
      <skos:altLabel xml:lang="en">memory consolidation</skos:altLabel>
      <skos:definition xml:lang="fr">Processus permettant, avec le temps, le renforcement, la stabilisation, le transfert et la réorganisation des traces mnésiques.</skos:definition>
      <skos:definition xml:lang="en">Time-dependent processes for strengthening, stabilizing, transferring and reorganizing memory traces.</skos:definition>
