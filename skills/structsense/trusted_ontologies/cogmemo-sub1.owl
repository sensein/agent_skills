      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-W52CFWZ4-9"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-Z24RK3Z6-C"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-MM5S66WC-1"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-SRTRMRB7-V"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-SSKGPVQQ-N"/>
