   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-S1WG2Q31-4">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-06-07</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-31</dcterms:modified>
      <skos:altLabel xml:lang="en">SPW-R</skos:altLabel>
      <skos:altLabel xml:lang="en">SWR</skos:altLabel>
      <skos:altLabel xml:lang="en">sharp wave and ripple</skos:altLabel>
      <skos:altLabel xml:lang="fr">sharp wave ripple</skos:altLabel>
      <skos:definition xml:lang="en">A spontaneous oscillatory pattern in the hippocampus consisting of a sharp wave (1–30 Hz) and associated ripple oscillation (120–220 Hz) during periods of slow-wave sleep and behavioral immobility.</skos:definition>
      <skos:definition xml:lang="fr">Motif oscillatoire spontané dans l’hippocampe, composé d’une onde pointue (1–30 Hz) et d’une oscillation rapide associée (120–220 Hz), survenant pendant les périodes de sommeil à ondes lentes et d’immobilité comportementale.</skos:definition>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Sharp_waves_and_ripples"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q17157103"/>
      <skos:hiddenLabel xml:lang="en">SWRs</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">Sharp waves and ripples</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">sharp wave ripples</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">sharp wave-ripple</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">sharp wave-ripples</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">sharp-wave ripple</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">sharp-wave ripples</skos:hiddenLabel>
      <skos:prefLabel xml:lang="fr">onde pointue-oscillation rapide</skos:prefLabel>
