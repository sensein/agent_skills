   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-D6KFVJR4-6">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-08-29</dcterms:modified>
      <skos:definition xml:lang="en">A measure in a serial recall task representing the probability of transposition errors as a function of item displacement from its correct position.</skos:definition>
      <skos:definition xml:lang="fr">Mesure dans une tâche de rappel sériel représentant la probabilité des erreurs de transposition en fonction du déplacement de l'item par rapport à sa position correcte.</skos:definition>
      <skos:prefLabel xml:lang="fr">gradient de transposition</skos:prefLabel>
      <skos:prefLabel xml:lang="en">transposition gradient</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Hurlstone, M. J., Hitch, G. J., &amp; Baddeley, A. D. (2014). Memory for serial order across domains: An overview of the literature and directions for future research. Psychological Bulletin, 140(2), 339–373. https://doi.org/10.1037/a0034221</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-XM9K9XL8-S"/>
