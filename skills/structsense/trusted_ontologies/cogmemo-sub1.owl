   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-G5ZPKSZ8-1">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-12</dcterms:modified>
      <skos:altLabel xml:lang="fr">biais lié au genre d'appartenance</skos:altLabel>
      <skos:altLabel xml:lang="en">own-gender bias</skos:altLabel>
      <skos:definition xml:lang="en">An own-group bias observed when individuals recognize faces of people of their own sex better than those of the opposite sex.</skos:definition>
      <skos:definition xml:lang="fr">Biais de l'intragroupe observé lorsque les individus reconnaissent mieux les visages des personnes du même sexe que le leur, comparativement à ceux appartenant au sexe opposé.</skos:definition>
      <skos:prefLabel xml:lang="fr">biais lié au sexe d’appartenance</skos:prefLabel>
      <skos:prefLabel xml:lang="en">own-sex bias</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Herlitz, A., &amp; Lovén, J. (2013). Sex differences and the own-gender bias in face recognition: A meta-analytic review. Visual Cognition, 21(9-10), 1306–1336. https://doi.org/10.1080/13506285.2013.823140</dct:bibliographicCitation>
      <dct:bibliographicCitation>Russell, E. M., Longstaff, M. G., &amp; Winskel, H. (2024). Sex differences in eyewitness memory: A scoping review. Psychonomic Bulletin &amp; Review, 31(3), 985–999. https://doi.org/10.3758/s13423-023-02407-x</dct:bibliographicCitation>
