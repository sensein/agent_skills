   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-J0MJ14L2-8">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-11-02</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-20</dcterms:modified>
      <skos:definition xml:lang="en">A part of the brain consisting of a collection of nerve fibers.</skos:definition>
      <skos:definition xml:lang="fr">Partie du cerveau correspondant à un regroupement de fibres nerveuses.</skos:definition>
      <skos:exactMatch rdf:resource="http://purl.org/sig/ont/fma/fma83844"/>
