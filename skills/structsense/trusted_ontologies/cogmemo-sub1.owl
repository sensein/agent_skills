      <skos:definition xml:lang="fr">Sous-système de la mémoire de travail auditive assurant la répétition et le maintien des informations de hauteur tonale.</skos:definition>
      <skos:definition xml:lang="en">Subsystem of the auditory working memory dedicated to the repetition and maintenance of pitch information.</skos:definition>
      <skos:prefLabel xml:lang="fr">boucle tonale</skos:prefLabel>
      <skos:prefLabel xml:lang="en">tonal loop</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
