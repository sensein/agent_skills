   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-X04J1443-5">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-03-06</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-04-04</dcterms:modified>
      <inist:semCategory xml:lang="fr">Homme</inist:semCategory>
      <inist:semCategory xml:lang="en">Human</inist:semCategory>
      <skos:altLabel xml:lang="en">early adolescence</skos:altLabel>
      <skos:altLabel xml:lang="en">early adolescent</skos:altLabel>
      <skos:altLabel xml:lang="fr">préadolescence</skos:altLabel>
      <skos:definition xml:lang="en">Aged 10 to 13 years.</skos:definition>
      <skos:definition xml:lang="fr">Âgé de 10 à 13 ans.</skos:definition>
