   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-NQVM5SSV-F">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-09-29</dcterms:modified>
      <skos:definition xml:lang="en">Amnesia characterized by a deficit in the memory of the source of information (where, when, how).</skos:definition>
      <skos:definition xml:lang="fr">Amnésie qui se caractérise par un déficit dans la mémoire de la source des informations (où, quand, comment.)</skos:definition>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Source_amnesia"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q3614488"/>
      <skos:prefLabel xml:lang="fr">amnésie de la source</skos:prefLabel>
      <skos:prefLabel xml:lang="en">source amnesia</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Schacter, D. L., Harbluk, J. L., &amp; McLachlan, D. R. (1984). Retrieval without recollection : An experimental analysis of source amnesia. Journal of Verbal Learning &amp; Verbal Behavior, 23(5), 593‑611. https://doi.org/10.1016/S0022-5371(84)90373-6</dct:bibliographicCitation>
