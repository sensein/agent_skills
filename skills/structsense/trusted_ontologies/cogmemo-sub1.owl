      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-05-02</dcterms:modified>
      <skos:altLabel xml:lang="fr">mesure de rappel</skos:altLabel>
      <skos:altLabel xml:lang="fr">méthode de rappel</skos:altLabel>
      <skos:altLabel xml:lang="fr">paradigme de rappel</skos:altLabel>
      <skos:altLabel xml:lang="en">recall measure</skos:altLabel>
