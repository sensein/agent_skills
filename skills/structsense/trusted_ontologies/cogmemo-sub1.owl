   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-W6B74BSG-7">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-17</dcterms:modified>
      <skos:altLabel xml:lang="fr">amorçage</skos:altLabel>
      <skos:altLabel xml:lang="en">priming</skos:altLabel>
      <skos:definition xml:lang="en">A memory phenomenon showing the influence of processing a stimulus on the performance in a subsequent task.</skos:definition>
      <skos:definition xml:lang="fr">Phénomène de la mémoire montrant l’influence du traitement d’un stimulus sur la performance d'une tâche subséquente.</skos:definition>
      <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/NBO_0000200"/>
