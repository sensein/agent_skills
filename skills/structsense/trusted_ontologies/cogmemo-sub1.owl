   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-PZ86X4B4-3">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-01-12</dcterms:modified>
      <skos:altLabel xml:lang="en">error of commission</skos:altLabel>
      <skos:definition xml:lang="fr">Dans un test de mémoire, erreur consistant à évoquer ou à reconnaître des éléments absents de la phase d'étude.</skos:definition>
      <skos:definition xml:lang="en">In a memory test, an error consisting of recalling or recognizing an item that was absent during the study phase.</skos:definition>
      <skos:hiddenLabel xml:lang="en">commission errors</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">erreurs de commission</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">errors of commission</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">commission error</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">erreur de commission</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Schacter, D. L. (2021). The seven sins of memory : How the mind forgets and remembers (2nd ed.). Houghton Miﬄin.</dct:bibliographicCitation>
      <dct:bibliographicCitation>Schacter, D. L. (2021). The seven sins of memory : An update. Memory, 30(1), 37-42. https://doi.org/10.1080/09658211.2021.1873391</dct:bibliographicCitation>
