   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-QZRTL2B1-9">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-05-15</dcterms:modified>
      <skos:altLabel xml:lang="en">STM</skos:altLabel>
      <skos:altLabel xml:lang="en">active memory</skos:altLabel>
      <skos:altLabel xml:lang="fr">boite d’écho</skos:altLabel>
      <skos:altLabel xml:lang="fr">compartiment à court terme</skos:altLabel>
      <skos:altLabel xml:lang="en">echo box</skos:altLabel>
      <skos:altLabel xml:lang="en">immediate memory</skos:altLabel>
      <skos:altLabel xml:lang="fr">magasin à court terme</skos:altLabel>
      <skos:altLabel xml:lang="fr">mémoire active</skos:altLabel>
      <skos:altLabel xml:lang="fr">mémoire immédiate</skos:altLabel>
      <skos:altLabel xml:lang="fr">mémoire primaire</skos:altLabel>
      <skos:altLabel xml:lang="en">primary memory</skos:altLabel>
      <skos:altLabel xml:lang="fr">rétention à court terme</skos:altLabel>
      <skos:altLabel xml:lang="en">short-term retention</skos:altLabel>
      <skos:altLabel xml:lang="en">short-term storage</skos:altLabel>
      <skos:altLabel xml:lang="en">short-term store</skos:altLabel>
      <skos:altLabel xml:lang="fr">stockage à court terme</skos:altLabel>
      <skos:definition xml:lang="en">A limited-capacity storage system in which information is held for a short duration (a few seconds) and is subject to rapid degradation.</skos:definition>
      <skos:definition xml:lang="fr">Système de stockage à capacité limitée, dans lequel les informations sont maintenues sur une courte durée (quelques secondes) et se détériorent rapidement.</skos:definition>
