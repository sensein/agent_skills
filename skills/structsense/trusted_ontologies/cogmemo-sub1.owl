   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-SDXPTLK6-J">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-11</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-11</dcterms:modified>
      <skos:altLabel xml:lang="en">CTML</skos:altLabel>
      <skos:definition xml:lang="en">A theory that aims to understand how people can learn better by combining words and pictures as compared to relying on words alone.</skos:definition>
      <skos:definition xml:lang="fr">Théorie qui a pour objectif de comprendre comment les personnes peuvent mieux apprendre en combinant des mots et des images qu'avec des mots seuls.</skos:definition>
      <skos:prefLabel xml:lang="en">Cognitive Theory of Multimedia Learning</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Théorie cognitive de l'apprentissage multimédia</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Mayer, R. E. (2020). Multimedia learning (3rd ed.). Cambridge University Press.</dct:bibliographicCitation>
      <dct:bibliographicCitation>Mayer, R. E. (2021). Cognitive Theory of Multimedia Learning. In L. Fiorella &amp; R. E. Mayer (Eds.), The Cambridge handbook of multimedia learning (3rd ed., pp. 57–72). Cambridge University Press. https://doi.org/10.1017/9781108894333.008</dct:bibliographicCitation>
      <dct:bibliographicCitation>Mayer, R. E. (2024). The past, present, and future of the Cognitive Theory of Multimedia Learning. Educational Psychology Review, 36(1), 8. https://doi.org/10.1007/s10648-023-09842-1</dct:bibliographicCitation>
