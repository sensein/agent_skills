      <skos:hiddenLabel xml:lang="en">momentary confabulations</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">provoked confabulations</skos:hiddenLabel>
      <skos:prefLabel xml:lang="fr">confabulation provoquée</skos:prefLabel>
      <skos:prefLabel xml:lang="en">provoked confabulation</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Kopelman, M. D. (1987). Two types of confabulation. Journal of Neurology, Neurosurgery &amp; Psychiatry, 50(11), 1482–1487. https://doi.org/10.1136/jnnp.50.11.1482</dct:bibliographicCitation>
