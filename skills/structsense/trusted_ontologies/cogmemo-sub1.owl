      <inist:isModelOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-KK6LXTL8-P"/>
      <inist:isModelOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-KQ1K76V2-C"/>
      <inist:isModelOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-T150JWQ4-N"/>
