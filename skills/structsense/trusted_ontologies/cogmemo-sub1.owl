   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-N8DW5K8D-9">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-05-10</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-05-21</dcterms:modified>
      <skos:definition xml:lang="fr">Processus par lequel des connaissances ou des habiletés acquises sont utilisées dans de nouvelles situations.</skos:definition>
      <skos:definition xml:lang="en">The process by which acquired knowledge or skills are applied in new situations.</skos:definition>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/JVR-J9C2NMZM-G"/>
      <skos:prefLabel xml:lang="en">transfer</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">transfert</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
