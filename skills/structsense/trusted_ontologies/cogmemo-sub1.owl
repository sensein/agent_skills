   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-T4Q5ZL53-C">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-04</dcterms:modified>
      <skos:definition xml:lang="fr">Les cellules de temps sont des neurones de l'hippocampe qui déchargent à des moments spécifiques. Découvertes chez le rat et le singe.</skos:definition>
      <skos:definition xml:lang="en">Time cells are neurons in the hippocampus that fire at specific moments. Discovered in rats and monkeys.</skos:definition>
      <skos:hiddenLabel xml:lang="fr">cellules de temps</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">time cells</skos:hiddenLabel>
      <skos:prefLabel xml:lang="fr">cellule de temps</skos:prefLabel>
      <skos:prefLabel xml:lang="en">time cell</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Kraus, B. J., Robinson II, R. J., White, J. A., Eichenbaum, H., &amp; Hasselmo, M. E. (2013). Hippocampal « time cells »: time versus path integration. Neuron, 78(6), 1090-1101. https://doi.org/10.1016/j.neuron.2013.04.015</dct:bibliographicCitation>
      <dct:bibliographicCitation>MacDonald, C. J., Lepage, K. Q., Eden, U. T., &amp; Eichenbaum, H. (2011). Hippocampal "time cells" bridge the gap in memory for discontiguous events. Neuron, 71(4), 737-749. https://doi.org/10.1016/j.neuron.2011.07.012</dct:bibliographicCitation>
      <dct:bibliographicCitation>Pastalkova, E., Itskov, V., Amarasingham, A., &amp; Buzsaki, G. (2008). Internally generated cell assembly sequences in the rat hippocampus. Science, 321(5894), 1322-1327. https://doi.org/10.1126/science.1159775</dct:bibliographicCitation>
