   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-VZFJ96TS-5">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-01-25</dcterms:modified>
