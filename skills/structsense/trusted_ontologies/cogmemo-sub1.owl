   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-L50FKCZQ-B">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-17</dcterms:modified>
      <skos:definition xml:lang="en">A memory phenomenon observed when memory for a material that has been presented several times is better than memory for a material presented only once.</skos:definition>
      <skos:definition xml:lang="fr">Phénomène de la mémoire observé lorsque la mémoire d'un matériel qui a été présenté à plusieurs reprises est meilleure que celle d'un matériel qui n'a été présenté qu'une seule fois.</skos:definition>
      <skos:prefLabel xml:lang="fr">effet de répétition</skos:prefLabel>
      <skos:prefLabel xml:lang="en">repetition effect</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Crowder, R. G. (1976). Principles of learning and memory. Psychology Press.</dct:bibliographicCitation>
      <dct:bibliographicCitation>Greene, R. L. (1992). Human memory: Paradigms and paradoxes. Psychology Press.</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-RQWF016Q-4"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-GVCFTJQL-B"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-R0P65XB5-R"/>
