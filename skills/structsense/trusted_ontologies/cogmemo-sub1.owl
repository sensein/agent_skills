      <skos:altLabel xml:lang="fr">déficit de la mémoire</skos:altLabel>
      <skos:altLabel xml:lang="fr">déficit mnésique</skos:altLabel>
      <skos:altLabel xml:lang="fr">détérioration de la mémoire</skos:altLabel>
      <skos:altLabel xml:lang="en">memory deficit</skos:altLabel>
      <skos:altLabel xml:lang="en">memory deterioration</skos:altLabel>
      <skos:altLabel xml:lang="en">memory failure</skos:altLabel>
      <skos:altLabel xml:lang="en">memory impairment</skos:altLabel>
      <skos:altLabel xml:lang="fr">perturbation de la mémoire</skos:altLabel>
      <skos:altLabel xml:lang="fr">perturbation mnésique</skos:altLabel>
      <skos:altLabel xml:lang="fr">trouble mnésique</skos:altLabel>
      <skos:definition xml:lang="en">A cognitive disorder that results in an impairment of a memory function or process.</skos:definition>
      <skos:definition xml:lang="fr">Trouble cognitif qui se manifeste par une altération d'une fonction ou d'un processus mnésique.</skos:definition>
