   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-DP4NMT2L-9">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-24</dcterms:modified>
      <skos:altLabel xml:lang="en">WWW memory</skos:altLabel>
      <skos:altLabel xml:lang="en">contextualized memory</skos:altLabel>
      <skos:altLabel xml:lang="en">episodic-like memory</skos:altLabel>
      <skos:altLabel xml:lang="en">event memory</skos:altLabel>
      <skos:altLabel xml:lang="en">experiential memory</skos:altLabel>
      <skos:altLabel xml:lang="fr">mémoire contextualisée</skos:altLabel>
      <skos:altLabel xml:lang="fr">mémoire de type épisodique</skos:altLabel>
      <skos:altLabel xml:lang="fr">mémoire des événements</skos:altLabel>
      <skos:altLabel xml:lang="fr">mémoire pseudo-épisodique</skos:altLabel>
      <skos:altLabel xml:lang="fr">mémoire recollective</skos:altLabel>
      <skos:altLabel xml:lang="en">recollective memory</skos:altLabel>
      <skos:altLabel xml:lang="fr">souvenir épisodique</skos:altLabel>
      <skos:definition xml:lang="en">Declarative memory of personal experiences located in time and space, which enables the mental reliving of past events and the imagination of the future through autonoetic consciousness.</skos:definition>
      <skos:definition xml:lang="fr">Mémoire déclarative des expériences personnelles situées dans le temps et l’espace, qui permet de revivre mentalement des événements passés et de se projeter dans l’avenir grâce à la conscience autonoétique.</skos:definition>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/JVR-S91N0TTB-N"/>
      <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/NBO_0000187"/>
      <skos:exactMatch rdf:resource="http://scholarpedia.org/article/Episodic_memory"/>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/N9J-GBCTR6QH-Q"/>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Episodic_memory"/>
      <skos:exactMatch rdf:resource="https://fr.wikipedia.org/wiki/Mémoire_épisodique"/>
      <skos:exactMatch rdf:resource="https://www.cognitiveatlas.org/concept/id/trm_4a3fd79d0a1f4"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q18646"/>
      <skos:hiddenLabel xml:lang="en">episodic memories</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">souvenirs épisodiques</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">episodic memory</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">mémoire épisodique</skos:prefLabel>
      <skos:scopeNote xml:lang="fr">L'expression « mémoire de type épisodique » est essentiellement utilisée dans les études chez l'animal non humain.</skos:scopeNote>
      <skos:scopeNote xml:lang="en">The phrase "episodic-like memory" is mainly used in non-human animal studies.</skos:scopeNote>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
