   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-FW8V8TV0-W">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-28</dcterms:modified>
      <skos:definition xml:lang="en">Memory suggestibility appears when the subject integrates erroneous information from external sources in its memory (Schacter, 2001).</skos:definition>
      <skos:definition xml:lang="fr">On parle de suggestibilité de la mémoire lorsque le sujet intègre dans ses souvenirs des éléments erronés provenant de sources externes (Schacter, 2003).</skos:definition>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/2CX-873XK39C-W"/>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Suggestibility"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q2918559"/>
