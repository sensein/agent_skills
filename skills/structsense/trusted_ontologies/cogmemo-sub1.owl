   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-ZTRSJ6KF-F">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-08-08</dcterms:modified>
      <skos:definition xml:lang="en">"a collection of top-down control processes used when going on automatic or relying on instinct or intuition would be ill-advised, insufficient, or impossible" (Diamond, 2013, p. 136).</skos:definition>
      <skos:definition xml:lang="fr">« ensemble de processus cognitifs dont le rôle principal est de faciliter l’adaptation du sujet aux situations nouvelles et/ou complexes, en particulier lorsque les habiletés cognitives sur-apprises ne sont plus suffisantes. En ce sens, les fonctions exécutives ne sont liées à aucun domaine cognitif en particulier mais apparaissent plutôt avoir un rôle métacognitif, de supervision ou de contrôle sur l’ensemble des autres domaines cognitifs (perception, langage, mémoire,...). » (Collette et Angel, 2015, p. 288).</skos:definition>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/2CX-M3VSMNFQ-C"/>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/JVR-JR2JC6N6-P"/>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Executive_functions"/>
      <skos:exactMatch rdf:resource="https://fr.wikipedia.org/wiki/Fonctions_exécutives"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q783092"/>
