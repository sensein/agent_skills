      <skos:hiddenLabel xml:lang="fr">théorie structurale</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">théories des systèmes multiples</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">théories multi-systèmes de la mémoire</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">théories multisystèmes de la mémoire</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">théories structurales</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">théories structurales de la mémoire</skos:hiddenLabel>
