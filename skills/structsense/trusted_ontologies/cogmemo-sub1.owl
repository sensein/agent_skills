      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-D7R4DG0W-P">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-28</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-05</dcterms:modified>
      <inist:domain xml:lang="fr">Psychologie</inist:domain>
      <inist:domain xml:lang="en">Psychology</inist:domain>
      <inist:semCategory xml:lang="fr">Homme</inist:semCategory>
      <inist:semCategory xml:lang="en">Human</inist:semCategory>
      <skos:definition xml:lang="en">Admission by an innocent person of having committed a crime.</skos:definition>
      <skos:definition xml:lang="fr">Admission par une personne innocente d’avoir commis un délit ou un crime.</skos:definition>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/N9J-WW4NNXPD-S"/>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/False_confession"/>
      <skos:exactMatch rdf:resource="https://fr.wikipedia.org/wiki/Faux_aveux"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q1911413"/>
      <skos:hiddenLabel xml:lang="en">false confessions</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">faux aveux</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">false confession</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">faux aveu</skos:prefLabel>
