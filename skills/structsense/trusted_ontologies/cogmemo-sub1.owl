   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-XBK7Q5XL-7">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-12-11</dcterms:modified>
      <skos:altLabel xml:lang="fr">expérience recollective</skos:altLabel>
      <skos:altLabel xml:lang="en">recollective experience</skos:altLabel>
      <skos:altLabel xml:lang="fr">remémoration</skos:altLabel>
      <skos:altLabel xml:lang="fr">reviviscence</skos:altLabel>
      <skos:altLabel xml:lang="fr">récollection</skos:altLabel>
      <skos:definition xml:lang="en">A phenomenological characteristic of memory experiences in a recognition test, in which an item is judged as “old” (previously studied) because specific elements of the encoding context are retrieved.</skos:definition>
      <skos:definition xml:lang="fr">Caractéristique phénoménologique de la mémoire vécue lors d’un test de reconnaissance, dans lequel un item est jugé comme « ancien » (étudié) grâce à la récupération d’éléments spécifiques du contexte d’encodage.</skos:definition>
      <skos:hiddenLabel xml:lang="fr">expériences recollectives</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">recollections</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">recollective experiences</skos:hiddenLabel>
