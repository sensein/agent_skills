      <skos:altLabel xml:lang="fr">plagiat involontaire</skos:altLabel>
      <skos:altLabel xml:lang="en">unconscious plagiarism</skos:altLabel>
      <skos:definition xml:lang="en">A source misattribution error occurring when a person generates content (a word, idea, song, solution to a problem, etc.) and perceives it as original in the current context, whereas it was in fact previously produced either by themselves or by someone else.</skos:definition>
      <skos:definition xml:lang="fr">Erreur d’attribution de la source se manifestant lorsqu'une personne produit un contenu (mot, idée, chanson, solution à un problème, etc.) en le percevant comme original dans le contexte présent, alors qu’il a en réalité été généré antérieurement par elle-même ou par autrui.</skos:definition>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Cryptomnesia"/>
      <skos:exactMatch rdf:resource="https://fr.wikipedia.org/wiki/Cryptomnésie"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q1790393"/>
      <skos:hiddenLabel xml:lang="en">cryptomnesic</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">cryptomnesic experiences</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">cryptomnésique</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">cryptomnésiques</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">expériences cryptomnésiques</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">plagiats inconscients</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">cryptomnesia</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">cryptomnésie</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Brown, A. S., &amp; Murphy, D. R. (1989). Cryptomnesia: Delineating inadvertent plagiarism. Journal of Experimental Psychology: Learning, Memory, and Cognition, 15(3), 432–442. https://doi.org/10.1037/0278-7393.15.3.432</dct:bibliographicCitation>
      <dct:bibliographicCitation>Brédart, S., Lampinen, J., &amp; Defeldre, A.-C. (2003). Phenomenal characteristics of cryptomnesia. Memory, 11(1), 1–11. https://doi.org/10.1080/741938174</dct:bibliographicCitation>
      <dct:bibliographicCitation>Gingerich, A. C., &amp; Sullivan, M. C. (2013). Claiming hidden memories as one’s own: A review of inadvertent plagiarism. Journal of Cognitive Psychology, 25(8), 903-916. https://doi.org/10.1080/20445911.2013.841674</dct:bibliographicCitation>
      <dct:bibliographicCitation>McCarroll, C. J., &amp; Sant’Anna, A. (2023). Cryptomnesia: A three-factor account. Synthese, 201(1), 1-24. https://doi.org/10.1007/s11229-022-04002-4</dct:bibliographicCitation>
      <inist:hasTheory rdf:resource="http://data.loterre.fr/ark:/67375/P66-KKKB7LLJ-Z"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-L2KVVW09-1"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-BNPSX7VV-1"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-RZ9DQJMH-H"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-TFTTHB8V-T"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-MemoryAndLawGroup"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-CVFJZQV0-T">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-24</dcterms:modified>
      <skos:definition xml:lang="en">Memory for the origin of information (where, who, when, how).</skos:definition>
      <skos:definition xml:lang="fr">Mémoire de l'origine des informations (où, qui, quand, comment).</skos:definition>
      <skos:exactMatch rdf:resource="https://www.cognitiveatlas.org/concept/id/trm_4a3fd79d0b18f"/>
      <skos:prefLabel xml:lang="fr">mémoire de la source</skos:prefLabel>
      <skos:prefLabel xml:lang="en">source memory</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Crystal, J. D. (2016). Animal models of source memory. Journal of the Experimental Analysis of Behavior, 105(1), 56–67. https://doi.org/10.1002/jeab.173</dct:bibliographicCitation>
      <dct:bibliographicCitation>Johnson, M. K., Hashtroudi, S., &amp; Lindsay, D. S. (1993). Source monitoring. Psychological Bulletin, 114(1), 3–28. https://doi.org/10.1037/0033-2909.114.1.3</dct:bibliographicCitation>
      <inist:hasModel rdf:resource="http://data.loterre.fr/ark:/67375/P66-R9TV9KX5-3"/>
      <inist:hasTheory rdf:resource="http://data.loterre.fr/ark:/67375/P66-KKKB7LLJ-Z"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-DP4NMT2L-9"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-D304PDBZ-3"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-L2KVVW09-1"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-LDWRVL6T-5"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-M3W9XWPJ-Z"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-M65527M2-W"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-NQVM5SSV-F"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-R5X6GLR8-4"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-SHFZB6K6-D"/>
