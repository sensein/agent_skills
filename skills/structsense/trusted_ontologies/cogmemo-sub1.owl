   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-JQRWWNLB-8">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-05-23</dcterms:modified>
      <skos:altLabel xml:lang="en">association-memory</skos:altLabel>
      <skos:altLabel xml:lang="fr">souvenir associatif</skos:altLabel>
      <skos:definition xml:lang="en">A memory dosposition to encode, store and retrieve associations between items or between an item and its context.</skos:definition>
      <skos:definition xml:lang="fr">Disposition mnésique à encoder, stocker et récupérer des associations entre items ou entre un item et son contexte.</skos:definition>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Associative_memory_(psychology)"/>
