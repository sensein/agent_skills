   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-FBXSVC7N-L">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-18</dcterms:created>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-04</dcterms:modified>
      <skos:hiddenLabel xml:lang="fr">méthodes neurophysiologiques</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">neurophysiological methods</skos:hiddenLabel>
      <skos:prefLabel xml:lang="fr">méthode neurophysiologique</skos:prefLabel>
      <skos:prefLabel xml:lang="en">neurophysiological method</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-B5NB9G8J-F"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-BXB4B3CC-H"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-CT8NQP8K-R"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-DVR59LF6-T"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-H4KQ48CQ-3"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-J50RFJJP-M"/>
