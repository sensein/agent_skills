      <skos:prefLabel xml:lang="en">event-related potentials</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">potentiels évoqués cognitifs</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
