   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-JWPH1Z9N-T">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-08-22</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-12-09</dcterms:modified>
      <inist:domain xml:lang="fr">Psychologie</inist:domain>
      <inist:domain xml:lang="en">Psychology</inist:domain>
      <inist:semCategory xml:lang="fr">Homme</inist:semCategory>
      <inist:semCategory xml:lang="en">Human</inist:semCategory>
      <skos:altLabel xml:lang="en">time in-WM hypothesis</skos:altLabel>
      <skos:definition xml:lang="en">A testable hypothesis according to which the overall time items spend in working memory predicts their recall in episodic memory.</skos:definition>
      <skos:definition xml:lang="fr">Hypothèse testable selon laquelle le temps total que passent les items en mémoire de travail prédit leur rappel en mémoire épisodique.</skos:definition>
      <skos:prefLabel xml:lang="fr">hypothèse du temps en mémoire de travail</skos:prefLabel>
      <skos:prefLabel xml:lang="en">time in-working-memory hypothesis</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Hartshorne, J. K., &amp; Makovski, T. (2019). The effect of working memory maintenance on long-term memory. Memory &amp; Cognition, 47(4), 749–763. https://doi.org/10.3758/s13421-019-00908-6</dct:bibliographicCitation>
      <dct:bibliographicCitation>Jarjat, G., Hoareau, V., Plancher, G., Hot, P., Lemaire, B., &amp; Portrat, S. (2018). What makes working memory traces stable over time?: Working memory conditions for long-term recall. Annals of the New York Academy of Sciences, 1424(1), 149–160. https://doi.org/10.1111/nyas.13668</dct:bibliographicCitation>
      <dct:bibliographicCitation>Loaiza, V. M., &amp; Lavilla, E. T. (2021). Elaborative strategies contribute to the long-term benefits of time in working memory. Journal of Memory and Language, 117, 104205. https://doi.org/10.1016/j.jml.2020.104205</dct:bibliographicCitation>
      <dct:bibliographicCitation>Souza, A. S., &amp; Oberauer, K. (2017). Time to process information in working memory improves episodic memory. Journal of Memory and Language, 96, 155‑167. https://doi.org/10.1016/j.jml.2017.07.002</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-ZFR36KVN-B"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-DP4NMT2L-9"/>
