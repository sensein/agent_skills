   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-FJ1L5NPX-6">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-01</dcterms:modified>
      <skos:definition xml:lang="en">"retrieval of an existing memory trace can destabilize it, which in turn opens a time-dependent window during which the memory becomes malleable. The memory can then be altered, strengthened, or weakened" (Parks et al., 2022, p. 2008).</skos:definition>
      <skos:definition xml:lang="fr">« La récupération d'une trace mnésique existante peut la déstabiliser, ce qui ouvre une fenêtre temporelle au cours de laquelle le souvenir devient malléable. Le souvenir peut alors être altéré, renforcé ou affaibli » (Parks et al., 2022, p. 2008).</skos:definition>
      <skos:exactMatch rdf:resource="https://www.cognitiveatlas.org/concept/id/trm_4a3fd79d0b972"/>
      <skos:prefLabel xml:lang="en">reconsolidation</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">reconsolidation</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
