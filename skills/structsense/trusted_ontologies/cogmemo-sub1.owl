   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-DSPSN23H-Q">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-05-15</dcterms:modified>
      <skos:altLabel xml:lang="fr">courbe de rétention</skos:altLabel>
      <skos:altLabel xml:lang="fr">fonction de rétention</skos:altLabel>
      <skos:altLabel xml:lang="en">retention curve</skos:altLabel>
      <skos:altLabel xml:lang="en">retention function</skos:altLabel>
      <skos:definition xml:lang="fr">Courbe montrant l’évolution de l’oubli avec le temps.</skos:definition>
      <skos:definition xml:lang="en">Curve representing the evolution of forgetting over time.</skos:definition>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Forgetting_curve"/>
