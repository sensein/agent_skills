   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-H1CDJKRB-C">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-20</dcterms:created>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-03-24</dcterms:modified>
      <skos:definition xml:lang="en">A lifelogging material that captures and records video or photos, usually worn on the body for hands-free use.</skos:definition>
      <skos:definition xml:lang="fr">Matériel d'hyperdiarisation qui capte et enregistre des images et des vidéos, généralement porté sur le corps pour une utilisation mains libres.</skos:definition>
