   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-TGSSGJGJ-F">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-03-22</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-24</dcterms:modified>
      <skos:altLabel xml:lang="en">DPC</skos:altLabel>
      <skos:altLabel xml:lang="fr">cortex parietal postérieur dorsal</skos:altLabel>
      <skos:altLabel xml:lang="en">dorsal posterior parietal cortex</skos:altLabel>
      <skos:definition xml:lang="en">Region of the posterior parietal cortex comprising the superior parietal lobule, intraparietal sulcus and precuneus.</skos:definition>
      <skos:definition xml:lang="fr">Région du cortex parietal postérieur comprenant le lobule pariétal supérieur, le sillon intrapariétal et le précunéus.</skos:definition>
      <skos:prefLabel xml:lang="fr">cortex pariétal dorsal</skos:prefLabel>
      <skos:prefLabel xml:lang="en">dorsal parietal cortex</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Bruner, E. (2018). Human paleoneurology and the evolution of the parietal cortex. Brain, Behavior and Evolution, 91(3), 136–147. https://doi.org/10.1159/000488889</dct:bibliographicCitation>
      <dct:bibliographicCitation>Cabeza, R., Ciaramelli, E., Olson, I. R., &amp; Moscovitch, M. (2008). The parietal cortex and episodic memory: An attentional account. Nature Reviews Neuroscience, 9(8), 613–625. https://doi.org/10.1038/nrn2459</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-TTFRG06N-X"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-DP4NMT2L-9"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-LWGNZJQ8-R"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-N6QV4DTJ-W"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-TKQ59X9H-1"/>
