      <skos:prefLabel xml:lang="en">semantic distance</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Kenett, Y. N., Levi, E., Anaki, D., &amp; Faust, M. (2017). The semantic distance task: Quantifying semantic distance with semantic network path length. Journal of Experimental Psychology: Learning, Memory, and Cognition, 43(9), 1470–1489. https://doi.org/10.1037/xlm0000391</dct:bibliographicCitation>
      <dct:bibliographicCitation>Rips, L. J., Shoben, E. J., &amp; Smith, E. E. (1973). Semantic distance and the verification of semantic relations. Journal of Verbal Learning and Verbal Behavior, 12(1), 1–20. https://doi.org/10.1016/S0022-5371(73)80056-8</dct:bibliographicCitation>
