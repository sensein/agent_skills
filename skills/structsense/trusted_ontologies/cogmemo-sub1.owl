   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-WM9BNKJ9-8">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-03-29</dcterms:modified>
      <skos:altLabel xml:lang="fr">expérience métamnésique</skos:altLabel>
      <skos:altLabel xml:lang="en">metamemory experience</skos:altLabel>
      <skos:definition xml:lang="en">Ability for monitoring, regulating and controlling memory functioning.</skos:definition>
      <skos:definition xml:lang="fr">Aptitude à surveiller, réguler et contrôler le fonctionnement de la mémoire.</skos:definition>
