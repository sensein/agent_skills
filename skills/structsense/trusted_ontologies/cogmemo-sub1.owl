   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-PQDC3FHL-7">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-08-27</dcterms:modified>
      <inist:reviewedBy>Valentina La Corte</inist:reviewedBy>
      <skos:altLabel xml:lang="en">pseudoreminiscence</skos:altLabel>
      <skos:altLabel xml:lang="fr">pseudoréminiscence</skos:altLabel>
      <skos:definition xml:lang="en">A memory disorder characterized by "the production of statements and actions that are unintentionally incongruous to the patient's history, background, present and future situation" (Dalla Barba et al., 2017, p. 44), and used by the patient to compensate memory difficulties or deficiencies, as in the Korsakoff's syndrome.</skos:definition>
      <skos:definition xml:lang="fr">Trouble de la mémoire qui se manifeste par la « production de propos et d'actions qui sont involontairement incongrus par rapport à l'histoire, au contexte, à la situation présente et future du patient » (Dalla Barba et al., 2017, p. 44), et utilisée par le patient pour compenser des difficultés, comme dans le cas du syndrome de Korsakoff.</skos:definition>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/2CX-M68LQFW3-8"/>
