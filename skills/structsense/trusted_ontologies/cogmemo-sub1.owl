      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-KGXKNW5J-Q">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-29</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-14</dcterms:modified>
      <skos:definition xml:lang="fr">Disposition cognitive à former des images mentales visuelles extrêmement claires et vivaces, quasi réalistes.</skos:definition>
      <skos:definition xml:lang="en">The cognitive disposition to form highly vivid, nearly realistic visual mental images.</skos:definition>
