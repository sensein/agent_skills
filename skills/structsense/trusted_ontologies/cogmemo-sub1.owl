   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-JS7BDWDB-1">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-03-13</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-03-13</dcterms:modified>
      <inist:domain xml:lang="fr">Psychologie</inist:domain>
      <inist:domain xml:lang="en">Psychology</inist:domain>
      <inist:semCategory xml:lang="fr">Homme</inist:semCategory>
      <inist:semCategory xml:lang="en">Human</inist:semCategory>
      <skos:definition xml:lang="en">A form of testimony in which a person states what she or he has heard during an event.</skos:definition>
      <skos:definition xml:lang="fr">Forme de témoignage durant lequel une personne déclare ce qu’elle a entendu pendant un événement.</skos:definition>
      <skos:prefLabel xml:lang="en">earwitness testimony</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">témoignage auditif</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
