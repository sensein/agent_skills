      <skos:hiddenLabel xml:lang="fr">engrammes</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">engrams</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">memory traces</skos:hiddenLabel>
