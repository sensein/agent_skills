   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-WG17XBG4-V">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-06-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-04</dcterms:modified>
      <skos:altLabel xml:lang="fr">Épreuve Mem-Pro-Clinic</skos:altLabel>
      <skos:definition xml:lang="en">A clinical test to assess difficulties in event- and time-based prospective memory.</skos:definition>
      <skos:definition xml:lang="fr">Épreuve clinique permettant d’évaluer les difficultés de mémoire prospective événementielle et temporelle.</skos:definition>
      <skos:prefLabel xml:lang="en">Mem-Pro-Clinic test</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">test Mem-Pro-Clinic</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Lecouvey, G., Morand, A., Poissonnier, A., Pèlerin, A., Silva, L. F. da, Sayette, V. de la, Eustache, F., &amp; Desgranges, B. (2021). Une nouvelle épreuve de mémoire prospective : Mem-Pro clinic. Revue de neuropsychologie, Volume 13(1), 43‑58. https://doi.org/10.1684/nrp.2021.0618</dct:bibliographicCitation>
      <inist:isDiagnosticToolOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-GNBK2L59-K"/>
