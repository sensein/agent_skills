      <skos:hiddenLabel xml:lang="fr">souvenirs associatifs</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">associative memory</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">mémoire associative</skos:prefLabel>
