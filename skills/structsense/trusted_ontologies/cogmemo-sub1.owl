   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-HJ05DKHC-2">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-12-11</dcterms:modified>
      <skos:altLabel xml:lang="en">memory structuration</skos:altLabel>
      <skos:altLabel xml:lang="en">memory structure</skos:altLabel>
      <skos:altLabel xml:lang="fr">structuration de la mémoire</skos:altLabel>
      <skos:altLabel xml:lang="fr">structure de la mémoire</skos:altLabel>
      <skos:definition xml:lang="en">A cognitive quality indicating how information is related and hierarchical in memory.</skos:definition>
      <skos:definition xml:lang="fr">Qualité cognitive indiquant la manière dont sont reliées et hiérarchisées les informations en mémoire.</skos:definition>
      <skos:prefLabel xml:lang="en">memory organization</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">organisation de la mémoire</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>de Sousa, A. F., Chowdhury, A., &amp; Silva, A. J. (2021). Dimensions and mechanisms of memory organization. Neuron, 109(17), 2649–2662. https://doi.org/10.1016/j.neuron.2021.06.014</dct:bibliographicCitation>
