   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-X1VXS02G-J">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-12-09</dcterms:modified>
      <skos:altLabel xml:lang="en">Easterbrook's hypothesis</skos:altLabel>
      <skos:altLabel xml:lang="en">attentional narrowing hypothesis</skos:altLabel>
      <skos:altLabel xml:lang="en">cue-utilization hypothesis</skos:altLabel>
      <skos:altLabel xml:lang="fr">hypothèse d'Easterbrook</skos:altLabel>
      <skos:altLabel xml:lang="fr">hypothèse du rétrécissement attentionnel</skos:altLabel>
      <skos:altLabel xml:lang="en">tunnel memory hypothesis</skos:altLabel>
      <skos:definition xml:lang="en">A testable hypothesis that stress or high levels of emotional arousal cause a reduction in the amount of information a person can process simultaneously. As a result, attention is focused on the most salient, central cues at the expense of peripheral cues.</skos:definition>
      <skos:definition xml:lang="fr">Hypothèse testable selon laquelle le stress ou un niveau élevé d’éveil émotionnel provoquerait une réduction des informations qu’une personne peut traiter simultanément. Par conséquent, l'attention se focaliserait sur les indices les plus saillants et centraux au détriment des indices périphériques.</skos:definition>
      <skos:hiddenLabel xml:lang="en">Easterbrook's cue-utilisation hypothesis</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">attentional narrowing</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">cue-utilisation hypothesis</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">rétrécissement attentionnel</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">Easterbrook's cue-utilization hypothesis</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">hypothèse de l'utilisation des indices d'Easterbrook</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Davis, D., Hogan, A. A., &amp; Hart, D. J. (2024). Myths of trauma memory: On the oversimplification of effects of attention narrowing under stress. Frontiers in Psychology, 15. https://doi.org/10.3389/fpsyg.2024.1294730</dct:bibliographicCitation>
      <dct:bibliographicCitation>Easterbrook, J. A. (1959). The effect of emotion on cue utilization and the organization of behavior. Psychological Review, 66(3), 183–201. https://doi.org/10.1037/h0047707</dct:bibliographicCitation>
      <dct:bibliographicCitation>Levine, L.J., &amp; Edelstein, R.S. (2009). Emotion and memory narrowing: A review and goal-relevance approach. Cognition &amp; Emotion, 23(5), 833–875. https://doi.org/10.1080/02699930902738863</dct:bibliographicCitation>
