   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-Q591RXQT-B">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-01-13</dcterms:modified>
      <skos:definition xml:lang="en">Positive transfer occurs when a first learning facilitates a second learning.</skos:definition>
      <skos:definition xml:lang="fr">Un transfert positif s’observe quand un premier apprentissage facilite un second apprentissage.</skos:definition>
      <skos:hiddenLabel xml:lang="fr">negative transfers</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">positive transfer</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">transfert positif</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-N8DW5K8D-9"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-KQSLWCN0-6"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Animal"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
