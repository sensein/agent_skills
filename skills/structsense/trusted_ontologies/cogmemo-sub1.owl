   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-ZBGVFDM8-M">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-14</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-09</dcterms:modified>
      <skos:altLabel xml:lang="en">interleaved practice</skos:altLabel>
      <skos:definition xml:lang="en">A learning strategy consisting of alternating tasks or concepts to be acquired.</skos:definition>
      <skos:definition xml:lang="fr">Stratégie d’apprentissage consistant à alterner les tâches ou concepts à acquérir.</skos:definition>
      <skos:hiddenLabel xml:lang="fr">apprentissages intercalés</skos:hiddenLabel>
      <skos:prefLabel xml:lang="fr">apprentissage intercalé</skos:prefLabel>
      <skos:prefLabel xml:lang="en">interleaving learning</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
