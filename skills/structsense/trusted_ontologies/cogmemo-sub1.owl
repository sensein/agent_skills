   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-JCKZ7CC9-5">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-03-30</dcterms:modified>
      <skos:altLabel xml:lang="en">acquisition curve</skos:altLabel>
      <skos:altLabel xml:lang="fr">courbe d'acquisition</skos:altLabel>
      <skos:definition xml:lang="en">Graphical representation of learning evolution as a result of practice.</skos:definition>
      <skos:definition xml:lang="fr">Représentation graphique de l'évolution d'un apprentissage avec la pratique.</skos:definition>
