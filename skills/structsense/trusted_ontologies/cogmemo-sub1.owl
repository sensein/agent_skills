      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-XNM1M2TZ-F">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2018-08-06</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-08-22</dcterms:modified>
      <skos:definition xml:lang="en">Criteria specific to episodic memories that distinguish them from semantic memories.</skos:definition>
      <skos:definition xml:lang="fr">Critères propres aux souvenirs épisodiques et permettant de les distinguer des souvenirs sémantiques.</skos:definition>
      <skos:prefLabel xml:lang="en">episodicity</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">épisodicité</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Perrin, D., &amp; Rousset, S. (2014). The episodicity of memory. Review of Philosophy and Psychology, 5(3), 291–312. https://doi.org/10.1007/s13164-014-0196-1</dct:bibliographicCitation>
      <dct:bibliographicCitation>Sant’Anna, A., Michaelian, K., &amp; Andonovski, N. (2024). Autonoesis and episodicity: Perspectives from philosophy of memory. WIREs Cognitive Science, 15(1), e1665. https://doi.org/10.1002/wcs.1665</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-SJGGK67S-6"/>
