   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-ZMTKXBRP-M">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-03-16</dcterms:modified>
      <skos:altLabel xml:lang="fr">décision lexicale</skos:altLabel>
      <skos:altLabel xml:lang="en">lexical decision</skos:altLabel>
      <skos:definition xml:lang="en">Deciding whether the sequence of letters presented is a word or a nonword. Used especially in indirect tests of memory.</skos:definition>
      <skos:definition xml:lang="fr">Tâche consistant à demander au sujet de décider si la suite de lettres qui lui est proposée est un mot ou un non-mot . Utilisée notamment dans les tests indirects de la mémoire.</skos:definition>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Lexical_decision_task"/>
      <skos:hiddenLabel xml:lang="fr">décisions lexicales</skos:hiddenLabel>
