   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-L9TB8RH1-Q">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-01-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-04</dcterms:modified>
      <skos:altLabel xml:lang="en">CFMT</skos:altLabel>
      <skos:definition xml:lang="en">Neuropsychological test to assess the ability to recognize unfamiliar faces.</skos:definition>
      <skos:definition xml:lang="fr">Test neuropsychologique pour évaluer les capacités de reconnaissance de visages non familiers.</skos:definition>
      <skos:prefLabel xml:lang="en">Cambridge Face Memory Test</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Test de mémoire des visages de Cambridge</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A version of the test for children is available (Croydon et al., 2014).</skos:scopeNote>
      <skos:scopeNote xml:lang="fr">Une version adaptée à l’enfant est disponible (Croydon et al., 2014).</skos:scopeNote>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Croydon, A., Pimperton, H., Ewing, L., Duchaine, B. C., &amp; Pellicano, E. (2014). The Cambridge Face Memory Test for Children (CFMT-C) : A new tool for measuring face recognition skills in childhood. Neuropsychologia, 62, 60‑67. https://doi.org/10.1016/j.neuropsychologia.2014.07.008</dct:bibliographicCitation>
      <dct:bibliographicCitation>Duchaine, B., &amp; Nakayama, K. (2006). The Cambridge Face Memory Test : Results for neurologically intact individuals and an investigation of its validity using inverted face stimuli and prosopagnosic participants. Neuropsychologia, 44(4), 576‑585. https://doi.org/10.1016/j.neuropsychologia.2005.07.001</dct:bibliographicCitation>
      <inist:isDiagnosticToolOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-BQKH3ZGC-0"/>
      <inist:isDiagnosticToolOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-GNBK2L59-K"/>
      <inist:isDiagnosticToolOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-PD4X3GW4-9"/>
      <inist:isDiagnosticToolOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-ZLBSFLSS-4"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-DP4NMT2L-9"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-JGRTPFJQ-S"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-W1ZLMWDL-F"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-N1MNZQ8X-V"/>
