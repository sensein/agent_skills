      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-MemoryAndLawGroup"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-KJ1LK8PP-2">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-04-28</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-10-15</dcterms:modified>
      <skos:definition xml:lang="en">An attention phenomenon characterized by the inability to detect a significant visual change introduced between two successive versions of the same scene.</skos:definition>
      <skos:definition xml:lang="fr">Phénomène de l'attention caractérisé par l'incapacité à détecter un changement visuel significatif introduit entre deux versions successives d'une même scène.</skos:definition>
      <skos:hiddenLabel xml:lang="fr">cécité aux changements</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">change blindness</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">cécité au changement</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Boloix, E. (2007). La représentation des scènes visuelles en mémoire: Les apports de la cécité au changement. L’Année psychologique, 107(3), 459–487. https://doi.org/10.4074/S0003503307003053</dct:bibliographicCitation>
      <dct:bibliographicCitation>Davies, G., &amp; Hine, S. (2007). Change blindness and eyewitness testimony. The Journal of Psychology, 141(4), 423–434. https://doi.org/10.3200/JRLP.141.4.423-434</dct:bibliographicCitation>
      <dct:bibliographicCitation>Davis, D., Loftus, E. F., Vanous, S., &amp; Cucciare, M. (2008). “Unconscious transference” can be an instance of “change blindness.” Applied Cognitive Psychology, 22(5), 605–623. https://doi.org/10.1002/acp.1395</dct:bibliographicCitation>
      <dct:bibliographicCitation>Fitzgerald, R. J., Oriet, C., &amp; Price, H. L. (2016). Change blindness and eyewitness identification: Effects on accuracy and confidence. Legal and Criminological Psychology, 21(1), 189–201. https://doi.org/10.1111/lcrp.12044</dct:bibliographicCitation>
      <dct:bibliographicCitation>Gibbs, R., Davies, G., &amp; Chou, S. (2016). A systematic review on factors affecting the likelihood of change blindness. Crime Psychology Review, 2(1), 1-21. https://doi.org/10.1080/23744006.2016.1228799</dct:bibliographicCitation>
      <dct:bibliographicCitation>Laney, C., &amp; Loftus, E. F. (2010). Change blindness and eyewitness memory. In G. M. Davies &amp; D. B. Wright (Eds.), Current issues in applied memory research (pp. 142–159). Psychology Press.</dct:bibliographicCitation>
      <dct:bibliographicCitation>Nelson, K. J., Laney, C., Fowler, N. B., Knowles, E. D., Davis, D., &amp; Loftus, E. F. (2011). Change blindness can cause mistaken eyewitness identification. Legal and Criminological Psychology, 16(1), 62–74. https://doi.org/10.1348/135532509X482625</dct:bibliographicCitation>
      <dct:bibliographicCitation>Rensink, R. A., O’Regan, J. K., &amp; Clark, J. J. (1997). To see or not to see: The need for attention to perceive changes in scenes. Psychological Science, 8(5), 368–373. https://doi.org/10.1111/j.1467-9280.1997.tb00427.x</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-WX8V5K34-1"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-D304PDBZ-3"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-N6QV4DTJ-W"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-N93W196P-4"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-PC2NM3QC-4"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-TNXSVLGL-5"/>
