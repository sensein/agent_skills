   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-TPL541CX-L">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-01-12</dcterms:modified>
      <skos:definition xml:lang="fr">Temps écoulé entre deux réponses dans un test de rappel libre ou sériel.</skos:definition>
      <skos:definition xml:lang="en">Time between two responses in a free or serial recall test.</skos:definition>
