   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-Z2B9K0GH-D">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-03-15</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-21</dcterms:modified>
      <skos:altLabel xml:lang="en">BECS-GRECO</skos:altLabel>
      <skos:altLabel xml:lang="fr">BECS-GRECO</skos:altLabel>
      <skos:altLabel xml:lang="en">Batterie d’évaluation des connaissances sémantiques du GRECO</skos:altLabel>
      <skos:definition xml:lang="en">A neuropsychological test standardized on a French population and used to assess knowledge of living and nonliving objects presented in two modalities (visual and verbal) (Berck et al., 2011).</skos:definition>
      <skos:definition xml:lang="fr">Test neuropsychologique, étalonné sur une population française, évaluant, à l'aide de six tâches, les connaissances d'objets biologiques et manufacturés présentés selon deux types de modalité, imagée et verbale (Berck et al., 2011).</skos:definition>
      <skos:prefLabel xml:lang="fr">Batterie d’évaluation des connaissances sémantiques du GRECO</skos:prefLabel>
      <skos:prefLabel xml:lang="en">GRECO's semantic knowledge assessment battery</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Merck, C., Charnallet, A., Auriacombe, S., Belliard, S., Hahn-Barma, V., Kremin, H., Lemesle, B., Mahieux, F., Moreaud, O., Palisson, D. P., Roussel, M., Sellal, F., &amp; Siegwart, H. (2011). La batterie d’évaluation des connaissances sémantiques du GRECO (BECS-GRECO): validation et données normatives. Revue de neuropsychologie, Volume 3(4), 235–255. https://doi.org/10.1684/nrp.2011.0194</dct:bibliographicCitation>
      <inist:isDiagnosticToolOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-ND7CQTXD-1"/>
      <inist:isDiagnosticToolOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-T0KQ9RM8-4"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-L02857LC-7"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-W1ZLMWDL-F"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-DB5H7CC7-C"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-HFLQLV31-8"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-MBTNZLRQ-4"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-WKBRHZ4H-B"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-ZNTMJLW0-W"/>
