   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-L5WLGK5F-D">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-11-15</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-07-25</dcterms:modified>
      <skos:altLabel xml:lang="en">aIAT</skos:altLabel>
      <skos:altLabel xml:lang="en">autobiographical IAT</skos:altLabel>
      <skos:definition xml:lang="en">An objective method for the study of memory, adaptated from Greenwald et al.'s (1998) Implicit Association Test, used to detect the veracity of autobiographical memories from implicit measures (reaction times).</skos:definition>
      <skos:definition xml:lang="fr">Méthode d'étude objective de la mémoire, adaptée du Test d’association implicite de Greenwald et al. (1998) qui permet de détecter, à partir de mesures implicites (temps de réaction), la véracité de souvenirs autobiographiques.</skos:definition>
      <skos:prefLabel xml:lang="en">Autobiographical Implicit Association Test</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Test d’association implicite autobiographique</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Agosta, S., &amp; Sartori, G. (2013). The autobiographical IAT : A review. Frontiers in Cognitive Science, 4, 519. https://doi.org/10.3389/fpsyg.2013.00519</dct:bibliographicCitation>
      <dct:bibliographicCitation>Greenwald, A. G., McGhee, D. E., &amp; Schwartz, J. L. K. (1998). Measuring individual differences in implicit cognition : The implicit association test. Journal of Personality and Social Psychology, 74(6), 1464‑1480. https://doi.org/10.1037/0022-3514.74.6.1464</dct:bibliographicCitation>
      <dct:bibliographicCitation>Sartori, G., Agosta, S., Zogmaister, C., Ferrara, S. D., &amp; Castiello, U. (2008). How to accurately detect autobiographical events. Psychological Science, 19(8), 772–780. https://doi.org/10.1111/j.1467-9280.2008.02156.x</dct:bibliographicCitation>
      <dct:bibliographicCitation>Takarangi, M. K. T., Strange, D., Shortland, A. E., &amp; James, H. E. (2013). Source confusion influences the effectiveness of the autobiographical IAT. Psychonomic Bulletin &amp; Review, 20(6), 1232‑1238. https://doi.org/10.3758/s13423-013-0430-3</dct:bibliographicCitation>
      <dct:bibliographicCitation>Takarangi, M. K. T., Strange, D., &amp; Houghton, E. (2015). Event familiarity influences memory detection using the aIAT. Memory, 23(3), 453‑461. https://doi.org/10.1080/09658211.2014.902467</dct:bibliographicCitation>
      <dct:bibliographicCitation>Verschuere, B., Prati, V., &amp; De Houwer, J. (2009). Cheating the lie detector : Faking in the autobiographical Implicit Association Test. Psychological Science, 20(4), 410‑413. https://doi.org/10.1111/j.1467-9280.2009.02308.x</dct:bibliographicCitation>
      <dct:bibliographicCitation>Verschuere, B., &amp; Kleinberg, B. (2017). Assessing autobiographical memory : The web-based autobiographical Implicit Association Test. Memory, 25(4), 520‑530. https://doi.org/10.1080/09658211.2016.1189941</dct:bibliographicCitation>
      <dct:bibliographicCitation>Wessel, I. (2024). Suppression-induced forgetting as a model for repression. Topics in Cognitive Science, 16(4), 731–751. https://doi.org/10.1111/tops.12684</dct:bibliographicCitation>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-R4QG3T7H-7"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-D720VZZ8-3"/>
