      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-JN3XR89C-C"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-KQTFZ42F-T"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-L2L3RC4K-F"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-MRMWPGS8-P"/>
