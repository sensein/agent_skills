      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Neuroanatomie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-C5HD1NRG-2">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-30</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-30</dcterms:modified>
      <skos:altLabel xml:lang="fr">TMS</skos:altLabel>
      <skos:altLabel xml:lang="fr">Test of Memory Strategies</skos:altLabel>
      <skos:definition xml:lang="en">A neuropsychological test assessing the influence of executive functions on verbal memory performance.</skos:definition>
      <skos:definition xml:lang="fr">Test neuropsychologique évaluant l’influence des fonctions exécutives sur la performance de la mémoire verbale.</skos:definition>
      <skos:prefLabel xml:lang="fr">Test des stratégies mnésiques</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Test of Memory Strategies</skos:prefLabel>
      <skos:scopeNote xml:lang="fr">Le Test des stratégies mnésiques permet de discriminer les patients atteints principalement de troubles de la mémoire des patients atteints de troubles de la mémoire liés à un dysfonctionnement exécutif (Yubero et al., 2011).</skos:scopeNote>
      <skos:scopeNote xml:lang="en">The Test of Memory Strategies makes it possible to discriminate between patients with a primary memory deficit and patients with memory impairment related to executive dysfunction (Yubero et al., 2011).</skos:scopeNote>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Giorgini, R., Maestu, F., Sara, F. M., Pastore, M., Abellan, M., Quattrone, A., Caparello, S., Quattrone, A., &amp; Vaccaro, M. G. (2024). Measurement invariance across countries of the Test of Memory Strategies (TMS): A contribution to the cross-national validity study. Acta Psychologica, 246, 104291. https://doi.org/10.1016/j.actpsy.2024.104291</dct:bibliographicCitation>
      <dct:bibliographicCitation>Yubero, R., Gil, P., Paul, N., &amp; Maestú, F. (2011). Influence of memory strategies on memory test performance: A study in healthy and pathological aging. Neuropsychology, Development, and Cognition. Section B, Aging, Neuropsychology and Cognition, 18(5), 497–515. https://doi.org/10.1080/13825585.2011.597840</dct:bibliographicCitation>
      <inist:hasComponent rdf:resource="http://data.loterre.fr/ark:/67375/P66-B0MKL2QD-7"/>
      <inist:isDiagnosticToolOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-BX5D54L4-6"/>
      <inist:isDiagnosticToolOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-T0KQ9RM8-4"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-DP4NMT2L-9"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-M27HBS7N-W"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Z65R7GWM-8"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-ZTRSJ6KF-F"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-W1ZLMWDL-F"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-DB5H7CC7-C"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-HFLQLV31-8"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-ZNTMJLW0-W"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Neuropsychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-N9G5D5VG-4">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-31</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-31</dcterms:modified>
      <skos:definition xml:lang="en">A theory according to which retroactive interference is the result of competition between responses to a cue at the time of recall and the unlearning of initial information</skos:definition>
      <skos:definition xml:lang="fr">Théorie selon laquelle l’interférence rétroactive est le résultat d’une compétition entre les réponses à indice au moment du rappel et d’un désapprentissage des informations initiales.</skos:definition>
      <skos:prefLabel xml:lang="fr">théorie à deux facteurs de l’interférence</skos:prefLabel>
      <skos:prefLabel xml:lang="en">two-factor theory of interference</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Melton, A. W., &amp; Irwin, J. M. (1940). The influence of degree of interpolated learning on retroactive inhibition and the overt transfer of specific responses. The American Journal of Psychology, 53(2), 173-203. https://doi.org/10.2307/1417415</dct:bibliographicCitation>
      <inist:isTheoryOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-JRBPV6BN-2"/>
      <inist:isTheoryOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-L24DSHB5-D"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-JT2DDSSZ-4"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-QFHQC1SB-B"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-T8D54BTV-N"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-DWHL5L1J-1">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-31</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-31</dcterms:modified>
      <skos:definition xml:lang="en">A computational model that explains forgetting as a gradual decrease, over time, in the overlap between the context present during the encoding of information and the context at the time of its retrieval.</skos:definition>
      <skos:definition xml:lang="fr">Modèle computationnel qui explique l'oubli par une diminution progressive, au fil du temps, du chevauchement entre le contexte présent lors de l’encodage de l'information et celui au moment de sa récupération.</skos:definition>
      <skos:prefLabel xml:lang="en">contextual fluctuation model</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">modèle de fluctuation contextuelle</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Mensink, G.-J., &amp; Raaijmakers, J. G. (1988). A model for interference and forgetting. Psychological Review, 95(4), 434-455.</dct:bibliographicCitation>
      <dct:bibliographicCitation>Mensink, G.-J. M., &amp; Raaijmakers, J. G. W. (1989). A model for contextual fluctuation. Journal of Mathematical Psychology, 33(2), 172–186. https://doi.org/10.1016/0022-2496(89)90029-1</dct:bibliographicCitation>
      <inist:isModelOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-JRBPV6BN-2"/>
      <inist:isModelOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-L0QT15F8-G"/>
      <inist:isModelOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-L24DSHB5-D"/>
      <inist:isModelOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-WFPNCW87-H"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-MMPD886D-4"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-M2THQ0F7-T"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-SMCR5MH1-M"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-GVWTXGSJ-K">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-01</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-01</dcterms:modified>
      <skos:definition xml:lang="en">Classical conditioning in which an association between an initially neutral stimulus and an aversive event is acquired, such that the former becomes capable of eliciting, on its own, a conditioned fear response.</skos:definition>
      <skos:definition xml:lang="fr">Conditionnement classique au cours duquel une association entre un stimulus initialement neutre et un événement aversif est acquise de telle sorte que le premier est capable de provoquer, à lui seul, une réponse conditionnée de peur.</skos:definition>
      <skos:hiddenLabel xml:lang="fr">conditionnement de la peur</skos:hiddenLabel>
      <skos:prefLabel xml:lang="fr">conditionnement de peur</skos:prefLabel>
      <skos:prefLabel xml:lang="en">fear conditioning</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Fullana, M. A., Dunsmoor, J. E., Schruers, K. R. J., Savage, H. S., Bach, D. R., &amp; Harrison, B. J. (2020). Human fear conditioning: From neuroscience to the clinic. Behaviour Research and Therapy, 124, 103528. https://doi.org/10.1016/j.brat.2019.103528</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-TSS7WZ3J-1"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-J6P7BVWC-2"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-R9DC7TZN-9"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-W52CFWZ4-9"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Animal"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-KCCP9K71-0">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-01</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-01</dcterms:modified>
      <skos:altLabel xml:lang="fr">modèle par étapes</skos:altLabel>
      <skos:definition xml:lang="fr">Modèle non computationnel selon lequel le fonctionnement de la mémoire prospective repose sur quatre phases qui sont la formation, la rétention, l'initiation et enfin l'exécution de l'intention.</skos:definition>
      <skos:definition xml:lang="en">Non-computational model defining prospective memory functioning as a process comprising the phases of intention formation, retention, initiation, and execution.</skos:definition>
      <skos:prefLabel xml:lang="fr">modèle par phases</skos:prefLabel>
      <skos:prefLabel xml:lang="en">phase model</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A revision of the phase model of prospective memory adds metacognitive and motivational mechanisms, and divides the intention initiation phase into several sub-phases (Kliegel et al., 2011).</skos:scopeNote>
      <skos:scopeNote xml:lang="fr">Une révision du modèle par phases de la mémoire prospective ajoute des mécanismes métacognitifs et motivationnels, et divise la phase d’initiation de l’intention en plusieurs sous-phases (Kliegel et al., 2011).</skos:scopeNote>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Kliegel, M., Martin, M., Mcdaniel, M., &amp; Einstein, G. (2002). Complex prospective memory and executive control of working memory: A process model. Psychologische Beitrage, 44(2), 303–318.</dct:bibliographicCitation>
      <dct:bibliographicCitation>Kliegel, M., Altgassen, M., Hering, A., &amp; Rose, N. S. (2011). A process-model based approach to prospective memory impairment in Parkinson’s disease. Neuropsychologia, 49(8), 2166–2177. https://doi.org/10.1016/j.neuropsychologia.2011.01.024</dct:bibliographicCitation>
      <inist:isModelOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Z6SQPXCN-P"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-QN84V90N-V"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-Q8F0T8B5-0">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-03</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-03</dcterms:modified>
      <skos:definition xml:lang="en">A memory phenomenon observed when the frequency of a stimulus's occurrence significantly influences the accuracy or speed of its recall and recognition.</skos:definition>
      <skos:definition xml:lang="fr">Phénomène de la mémoire observée lorsque la fréquence d’occurrence d’un stimulus influence significativement la précision ou la rapidité de son rappel ou de sa reconnaissance.</skos:definition>
      <skos:hiddenLabel xml:lang="fr">effet de la fréquence</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">effets de fréquence</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">effets de la fréquence</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">frequency effects</skos:hiddenLabel>
      <skos:prefLabel xml:lang="fr">effet de fréquence</skos:prefLabel>
      <skos:prefLabel xml:lang="en">frequency effect</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Popov, V., &amp; Reder, L. (2024). Frequency effects in recognition and recall. In M. J. Kahana &amp; A. D. Wagner (Eds.), The Oxford handbook of memory (pp. 765–796). Oxford University Press. https://doi.org/10.1093/oxfordhb/9780190917982.013.27</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-RQWF016Q-4"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-SND7VPGK-L"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-XDT8FJWP-K"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-XK66NCJ2-8"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-LDPSD5BJ-9"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-Z2ZJD3QQ-Q">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-03</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-03</dcterms:modified>
      <skos:altLabel xml:lang="en">brain oscillation</skos:altLabel>
      <skos:altLabel xml:lang="en">brain rhythm</skos:altLabel>
      <skos:altLabel xml:lang="en">brainwave</skos:altLabel>
      <skos:altLabel xml:lang="en">cortical oscillation</skos:altLabel>
      <skos:altLabel xml:lang="fr">mécanisme cérébral oscillatoire</skos:altLabel>
      <skos:altLabel xml:lang="fr">onde cérébrale</skos:altLabel>
      <skos:altLabel xml:lang="fr">oscillation cérébrale</skos:altLabel>
      <skos:altLabel xml:lang="en">oscillatory brain mechanism</skos:altLabel>
      <skos:altLabel xml:lang="fr">rythme cérébral</skos:altLabel>
      <skos:definition xml:lang="en">A neurophysiological process consisting of rhythmic and periodic fluctuations in electrical activity within large populations of neurons.</skos:definition>
      <skos:definition xml:lang="fr">Processus neurophysiologique consistant en des fluctuations rythmiques et périodiques de l'activité électrique au sein de larges populations de neurones.</skos:definition>
      <skos:hiddenLabel xml:lang="en">brain oscillations</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">brain rhythms</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">brainwaves</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">cortical oscillations</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">mécanismes cérébraux oscillatoires</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">ondes cérébrales</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">oscillations corticales</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">oscillatory brain mechanisms</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">rythme cérébraux</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">neural oscillation</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">oscillation neuronale</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Hanslmayr, S., Staresina, B. P., &amp; Jensen, O. (2024). Oscillatory brain mechanisms for memory formation: Online and offline processes. In M. J. Kahana &amp; A. D. Wagner (Eds.), The Oxford Handbook of Human Memory: Foundations and Applications (pp. 711–739). Oxford University Press. https://doi.org/10.1093/oxfordhb/9780190917982.013.25</dct:bibliographicCitation>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-H4KQ48CQ-3"/>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-MZP94WL9-J"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-RZ2X1NZ0-K"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-F2HG9RZP-D"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-KNLR6W4S-H"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-NJBBZZKL-G"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-S8SNQ76J-4"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Animal"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Neurophysiologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-L3F9RL1V-W">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-07</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-07</dcterms:modified>
      <skos:definition xml:lang="en">A memory phenomenon characterized by opposing patterns of memory impairment across two different patient groups.</skos:definition>
      <skos:definition xml:lang="fr">Phénomène de la mémoire observé lorsque deux groupes de patients présentent des déficits de la mémoire opposés.</skos:definition>
      <skos:hiddenLabel xml:lang="fr">dissociation double</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">dissociations doubles</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">double dissociations</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">doubles dissociations</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">double dissociation</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">double dissociation</skos:prefLabel>
      <skos:scopeNote xml:lang="fr">Le phénomène de double dissociation est utilisé comme argument de l'existence de systèmes de mémoire distincts.</skos:scopeNote>
      <skos:scopeNote xml:lang="en">The phenomenon of double dissociation is used as an argument for the existence of separate memory systems.</skos:scopeNote>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Davies, M. (2010). Double dissociation: Understanding its role in cognitive neuropsychology. Mind &amp; Language, 25(5), 500–540. https://doi.org/10.1111/j.1468-0017.2010.01399.x</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-RQWF016Q-4"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-FW8SW88Q-2"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-MM5S66WC-1"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-NJ67ZW7N-G"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-V31CXM91-G"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Neuropsychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-BMT6G9LV-5">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-07</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-07</dcterms:modified>
      <skos:definition xml:lang="en">A classical conditioning characterized by a change in the likes and dislikes toward a stimulus, resulting from its repeated association with another pleasant or unpleasant stimulus</skos:definition>
      <skos:definition xml:lang="fr">Conditionnement classique qui se caractérise par un changement dans l'appréciation positive ou négative portée à un stimulus suite à l’association répétée de ce stimulus avec un autre stimulus plaisant ou déplaisant.</skos:definition>
      <skos:prefLabel xml:lang="fr">conditionnement évaluatif</skos:prefLabel>
      <skos:prefLabel xml:lang="en">evaluative conditioning</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Bouy, J., Syssau, A., &amp; Blanc, N. (2014). Le conditionnement évaluatif: un effet polymorphe interprété au sein d’une approche intégrative à multiples processus. L’Année psychologique, 114(1), 125–172. https://doi.org/10.3917/anpsy.141.0125</dct:bibliographicCitation>
      <dct:bibliographicCitation>Hofmann, W., De Houwer, J., Perugini, M., Baeyens, F., &amp; Crombez, G. (2010). Evaluative conditioning in humans: A meta-analysis. Psychological Bulletin, 136(3), 390–421. (2010-07936-007). https://doi.org/10.1037/a0018916</dct:bibliographicCitation>
      <dct:bibliographicCitation>Moran, T., Nudler, Y., &amp; Bar-Anan, Y. (2023). Evaluative conditioning: Past, present, and future. Annual Review of Psychology, 74(1), 245–269. https://doi.org/10.1146/annurev-psych-032420-031815</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-TSS7WZ3J-1"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-MF9PFF2L-7"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Animal"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-SW8FNBND-B">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-07</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-07</dcterms:modified>
      <skos:altLabel xml:lang="en">sleep-dependent triage</skos:altLabel>
      <skos:altLabel xml:lang="fr">tri dépendant du sommeil</skos:altLabel>
      <skos:definition xml:lang="en">A memory process involving the selection of memories for consolidation and integration into pre-existing knowledge structures during sleep on the basis of prior waking salience tags.</skos:definition>
      <skos:definition xml:lang="fr">Processus mnésique consistant à sélectionner les souvenirs destinés à être consolidés et intégrés aux structures de connaissances préexistantes durant le sommeil, sur la base de marqueurs de pertinence établis lors de l'éveil.</skos:definition>
      <skos:prefLabel xml:lang="en">sleep-dependent memory triage</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">tri mnésique dépendant du sommeil</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Stickgold, R., &amp; Walker, M. P. (2013). Sleep-dependent memory triage: Evolving generalization through selective processing. Nature Neuroscience, 16(2), 139–145. https://doi.org/10.1038/nn.3303 [literature review ; closed]</dct:bibliographicCitation>
