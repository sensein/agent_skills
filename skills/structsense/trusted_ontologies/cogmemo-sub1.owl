   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-PRJPCTR5-5">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-04-18</dcterms:modified>
      <skos:altLabel xml:lang="fr">maintien en mémoire</skos:altLabel>
      <skos:altLabel xml:lang="fr">memory maintenance</skos:altLabel>
      <skos:altLabel xml:lang="en">trace storage</skos:altLabel>
      <skos:definition xml:lang="en">Process for the retention of information in memory.</skos:definition>
      <skos:definition xml:lang="fr">Processus ou système de conservation des informations en mémoire.</skos:definition>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Storage_(memory)"/>
      <skos:prefLabel xml:lang="fr">stockage</skos:prefLabel>
      <skos:prefLabel xml:lang="en">storage</skos:prefLabel>
