   <skos:ConceptScheme rdf:about="http://data.loterre.fr/ark:/67375/P66">
      <cc:attributionName xml:lang="fr">Institut de l’information scientifique et technique (Inist) - CNRS/UAR76</cc:attributionName>
      <cc:attributionName xml:lang="en">Institute for scientific and technical information (Inist) - CNRS/UAR76</cc:attributionName>
      <cc:attributionURL rdf:resource="http://www.inist.fr"/>
