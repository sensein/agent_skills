   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-MLRZFFJQ-C">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-07</dcterms:created>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-08</dcterms:modified>
      <skos:altLabel xml:lang="en">longitudinal design</skos:altLabel>
      <skos:altLabel xml:lang="fr">plan longitudinal</skos:altLabel>
      <skos:definition xml:lang="en">Observational study method characterized by the repeated collection of data from the same individuals, in order to study the evolution of characteristics over a defined period.</skos:definition>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/JVR-G2WGHZMF-C"/>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Longitudinal_study"/>
      <skos:exactMatch rdf:resource="https://fr.wikipedia.org/wiki/Étude_longitudinale"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q1758614"/>
