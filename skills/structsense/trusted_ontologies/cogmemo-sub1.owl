   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-H399QLLG-0">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-04-01</dcterms:modified>
      <skos:altLabel xml:lang="fr">influence ascendante</skos:altLabel>
      <skos:altLabel xml:lang="fr">traitement dirigé par les données</skos:altLabel>
      <skos:definition xml:lang="en">Information processing beginning by the analysis of the stimulus perceptual features (e.g. spatial frequency, luminance, etc.).</skos:definition>
      <skos:definition xml:lang="fr">Type de traitement de l'information lié à l'analyse du stimulus (par exemple sa fréquence spatiale, sa luminance...)</skos:definition>
      <skos:hiddenLabel xml:lang="fr">influences ascendantes</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">traitements ascendants</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">traitements dirigés par les données</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">bottom-up processing</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">traitement ascendant</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Theeuwes, J. (2018). Visual selection: Usually fast and automatic; seldom slow and volitional. Journal of Cognition, 1(1). https://doi.org/10.5334/joc.13</dct:bibliographicCitation>
      <dct:bibliographicCitation>Awh, E., Belopolsky, A. V., &amp; Theeuwes, J. (2012). Top-down versus bottom-up attentional control: A failed theoretical dichotomy. Trends in Cognitive Sciences, 16(8), 437–443. https://doi.org/10.1016/j.tics.2012.06.010</dct:bibliographicCitation>
      <dct:bibliographicCitation>Benoni, H., &amp; Ressler, I. (2020). Dichotomy, trichotomy, or a spectrum : Time to reconsider attentional guidance terminology. Frontiers in Psychology, 11. https://doi.org/10.3389/fpsyg.2020.02243</dct:bibliographicCitation>
