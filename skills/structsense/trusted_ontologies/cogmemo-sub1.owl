      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Neuropsychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-V18PXZ57-1">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-21</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-21</dcterms:modified>
      <skos:altLabel xml:lang="en">backward dating</skos:altLabel>
      <skos:definition xml:lang="en">A memory phenomenon characterized by dating an event as more distant in time than its actual occurrence.</skos:definition>
      <skos:definition xml:lang="fr">Phénomène de la mémoire observé lorsqu'un événement est daté comme étant plus ancien qu’il ne l’était réellement.</skos:definition>
      <skos:prefLabel xml:lang="fr">effet télescopique inversé</skos:prefLabel>
      <skos:prefLabel xml:lang="en">reverse telescoping effect</skos:prefLabel>
      <skos:scopeNote xml:lang="fr">L'effet télescopique inversé est surtout observé lors de la datation d'événements récents.</skos:scopeNote>
      <skos:scopeNote xml:lang="en">The reverse telescoping effect is mainly observed when dating recent events.</skos:scopeNote>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>El Haj, M., Janssen, S. M. J., &amp; Antoine, P. (2017). Memory and time: Backward and forward telescoping in Alzheimer’s disease. Brain and Cognition, 117, 65–72. https://doi.org/10.1016/j.bandc.2017.06.005</dct:bibliographicCitation>
      <dct:bibliographicCitation>Friedman, W. J. (1993). Memory for the time of past events. Psychological Bulletin, 113(1), 44–66. https://doi.org/10.1037/0033-2909.113.1.44</dct:bibliographicCitation>
      <dct:bibliographicCitation>Janssen, S. M. J., Chessa, A. G., &amp; Murre, J. M. J. (2006). Memory for time: How people date events. Memory &amp; Cognition, 34(1), 138–147. https://doi.org/10.3758/BF03193393</dct:bibliographicCitation>
      <dct:bibliographicCitation>Rubin, D. C., &amp; Baddeley, A. D. (1989). Telescoping is not time compression: A model. Memory &amp; Cognition, 17(6), 653–661. https://doi.org/10.3758/BF03202626</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-RQWF016Q-4"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-D720VZZ8-3"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-DP4NMT2L-9"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-HLDTHX3H-1"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-RLTGGHM0-3"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-DWV7SHBP-N">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-12-01</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-12-03</dcterms:modified>
      <skos:definition xml:lang="en">A priming effect observed when the deliberate recall of personal memories from a specific life period, or related to a general content, subsequently facilitates the emergence of a greater number of autobiographical memories, whether voluntary or involuntary, associated with the same period or content.</skos:definition>
      <skos:definition xml:lang="fr">Effet d’amorçage observé lorsque le rappel délibéré de souvenirs personnels vécus à une période donnée, ou liés à un contenu général, favorise ensuite l’émergence d’un plus grand nombre de souvenirs autobiographiques, qu’ils soient volontaires ou involontaires, associés à la même période ou au même contenu.</skos:definition>
      <skos:prefLabel xml:lang="fr">effet d’amorçage par réminiscence</skos:prefLabel>
      <skos:prefLabel xml:lang="en">reminiscence priming effect</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Mace, J. H. (2005). Priming involuntary autobiographical memories. Memory, 13(8), 874–884. https://doi.org/1 0.1080/09658210444000485</dct:bibliographicCitation>
      <dct:bibliographicCitation>Mace, J. H., &amp; Clevinger, A. M. (2013). Priming voluntary autobiographical memories: Implications for the organisation of autobiographical memory and voluntary recall processes. Memory, 21(4), 524–536. https://doi.org/10.1080/09658211.2012.744422</dct:bibliographicCitation>
      <dct:bibliographicCitation>Mace, J. H. (2024). Priming in the autobiographical memory system: Implications and future directions. Memory, 32(6), 694–708. https://doi.org/10.1080/09658211.2023.2277134</dct:bibliographicCitation>
      <dct:bibliographicCitation>Mace, J. H., &amp; Aaron, H. E. (2026). Comparing semantic-to-autobiographical memory priming to reminiscence priming on an involuntary memory task. Consciousness and Cognition, 139, 104000. https://doi.org/10.1016/j.concog.2026.104000</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-W6B74BSG-7"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-Q67Z1C3S-5"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-D720VZZ8-3"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-N2C1MM61-N"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-V48BC5F8-8"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-Q67Z1C3S-5">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-12-01</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-06</dcterms:modified>
      <skos:definition xml:lang="en">A priming effect whereby recalling or thinking about a personal preoccupation subsequently promotes the emergence of a greater number of autobiographical memories, whether voluntary or involuntary, associated with that preoccupation.</skos:definition>
      <skos:definition xml:lang="fr">Effet d’amorçage observé lorsque le fait de se souvenir d'une préoccupation personnelle ou d'y penser favorise ensuite l’émergence d’un plus grand nombre de souvenirs autobiographiques, qu’ils soient volontaires ou involontaires, associés à cette préoccupation.</skos:definition>
      <skos:prefLabel xml:lang="fr">effet d’amorçage par préoccupation</skos:prefLabel>
      <skos:prefLabel xml:lang="en">preoccupation priming effect</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Mace, J. H. (2024). Priming in the autobiographical memory system: Implications and future directions. Memory, 32(6), 694–708. https://doi.org/10.1080/09658211.2023.2277134</dct:bibliographicCitation>
      <dct:bibliographicCitation>Mace, J. H., &amp; Chow, E. (2026). Preoccupation priming: How repetitive thinking can influence our involuntary memories. Consciousness and Cognition, 137, 103966. https://doi.org/10.1016/j.concog.2025.103966</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-W6B74BSG-7"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-DWV7SHBP-N"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-D720VZZ8-3"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-N2C1MM61-N"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-V48BC5F8-8"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-FSHB2M05-B">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-09</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dct:creator>Pierre-Yves Jacob</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-09</dcterms:modified>
      <skos:altLabel xml:lang="fr">neurone de vitesse</skos:altLabel>
      <skos:altLabel xml:lang="en">speed neuron</skos:altLabel>
      <skos:definition xml:lang="en">A neuron whose firing rate varies according to an animal’s running speed, regardless of its direction and position in the environment.</skos:definition>
      <skos:definition xml:lang="fr">Neurone dont la fréquence de décharge varie en fonction de la vitesse de déplacement d’un animal, indépendamment de sa direction et de sa position dans l’environnement.</skos:definition>
      <skos:hiddenLabel xml:lang="fr">cellules de vitesse</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">neurones de vitesse</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">speed cells</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">speed neurons</skos:hiddenLabel>
      <skos:prefLabel xml:lang="fr">cellule de vitesse</skos:prefLabel>
      <skos:prefLabel xml:lang="en">speed cell</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>King, C., Recce, M., &amp; O’Keefe, J. (1998). The rhythmicity of cells of the medial septum/diagonal band of Broca in the awake freely moving rat: Relationships with behaviour and hippocampal theta. European Journal of Neuroscience, 10(2), 464–477. https://doi.org/10.1046/j.1460-9568.1998.00026.x</dct:bibliographicCitation>
      <dct:bibliographicCitation>Kropff, E., Carmichael, J. E., Moser, M.-B., &amp; Moser, E. I. (2015). Speed cells in the medial entorhinal cortex. Nature, 523(7561), 419–424. https://doi.org/10.1038/nature14622 </dct:bibliographicCitation>
      <dct:bibliographicCitation>Zhou, T. L., Tamura, R., Kuriwaki, J., &amp; Ono, T. (1999). Comparison of medial and lateral septal neuron activity during performance of spatial tasks in rats. Hippocampus, 9(3), 220–234. https://doi.org/10.1002/(SICI)1098-1063(1999)9:3%253C220::AID-HIPO3%253E3.0.CO;2-E</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-B5GMR3B8-H"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-J22JRX9F-0"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-X19H3ZBK-2"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Animal"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Neurophysiologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-J22JRX9F-0">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-09</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-24</dcterms:modified>
      <skos:definition xml:lang="en">Part of the basal forebrain containing cholinergic, glutamatergic, and GABAergic neurons.</skos:definition>
      <skos:definition xml:lang="fr">Partie du prosencéphale basal contenant des neurones cholinergiques, glutamatergiques, and GABAergiques.</skos:definition>
      <skos:prefLabel xml:lang="en">medial septum</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">septum médian</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
