      <skos:exactMatch rdf:resource="https://fr.wikipedia.org/wiki/Mémoire_eidétique"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q386001"/>
      <skos:prefLabel xml:lang="en">eidetic memory</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">mémoire éidétique</skos:prefLabel>
      <skos:scopeNote xml:lang="fr">Le terme fut introduit en 1922 par Erich Jaensch.</skos:scopeNote>
      <skos:scopeNote xml:lang="en">The term was introduced in 1922 by Erich Jaensch.</skos:scopeNote>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
