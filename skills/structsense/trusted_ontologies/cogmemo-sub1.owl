   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-BXB4B3CC-H">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-05-31</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
