   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-B5NB9G8J-F">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-18</dcterms:created>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-25</dcterms:modified>
      <skos:definition xml:lang="en">A planned process that implements a plan specification to study a disposition, a phenomenon, or a process.</skos:definition>
      <skos:definition xml:lang="fr">Processus planifié qui implémente la spécification d’un plan pour l’étude d’une disposition, d’un phénomène ou d’un processus.</skos:definition>
      <skos:hiddenLabel xml:lang="fr">méthodes d'étude</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">study methods</skos:hiddenLabel>
      <skos:prefLabel xml:lang="fr">méthode d'étude</skos:prefLabel>
      <skos:prefLabel xml:lang="en">study method</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-NBZLNBW5-L"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-L8T0X7WG-Q"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-BZBRK6X8-1"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-FBXSVC7N-L"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Multidisciplinaire"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-GFBTWTD0-Z">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-02-24</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-25</dcterms:modified>
      <skos:altLabel xml:lang="en">cognitive intervention</skos:altLabel>
      <skos:altLabel xml:lang="fr">intervention cognitive</skos:altLabel>
      <skos:definition xml:lang="en">A planned process that "refers to interventions using cognitive tasks or intellectually demanding activities, the goal of which is to enhance general cognitive ability" (Gobet &amp; Sala, 2023, p. 126).</skos:definition>
      <skos:definition xml:lang="fr">Processus planifié qui « désigne les interventions utilisant des tâches cognitives ou des activités intellectuellement exigeantes, dont le but est d'améliorer les capacités cognitives générales » (Gobet &amp; Sala, 2023, p. 126).</skos:definition>
      <skos:hiddenLabel xml:lang="fr">entrainement cognitif</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">cognitive training</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">entraînement cognitif</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Gobet, F., &amp; Sala, G. (2023). Cognitive training: A field in search of a phenomenon. Perspectives on Psychological Science, 18(1), 125–141. https://doi.org/10.1177/17456916221091830</dct:bibliographicCitation>
