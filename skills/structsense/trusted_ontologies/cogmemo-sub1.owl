   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-JJV6GSWP-1">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-01-25</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-06-17</dcterms:modified>
      <skos:altLabel xml:lang="fr">situation stressante</skos:altLabel>
      <skos:altLabel xml:lang="en">stressful event</skos:altLabel>
      <skos:altLabel xml:lang="fr">événement stressant</skos:altLabel>
      <skos:definition xml:lang="en">An emotional state associated with cognitive, physiological, and behavioral changes in response to unpredictable or uncontrollable situations.</skos:definition>
      <skos:definition xml:lang="fr">État émotionnel associé à des changements cognitifs, physiologiques et comportementaux face à des situations non prévisibles ou non contrôlables.</skos:definition>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/2CX-0VCKNX5Q-6"/>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/JVR-RVSW9SDN-X"/>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/N9J-BQZVVBNP-R"/>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Stress_(biology)"/>
      <skos:exactMatch rdf:resource="https://fr.wikipedia.org/wiki/Stress"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q123414"/>
      <skos:hiddenLabel xml:lang="fr">situations stressantes</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">stressful</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">stressful events</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">événements stressants</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">stress</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">stress</skos:prefLabel>
      <skos:scopeNote xml:lang="fr">Le concept de stress est ambigu et a connu de nombreuses évolutions. Il ne bénéficie pas d’une définition universellement reconnue.</skos:scopeNote>
      <skos:scopeNote xml:lang="en">The concept of stress is ambiguous and has undergone numerous transformations. It has no universally accepted definition.</skos:scopeNote>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
