      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-MemoryAndEducationGroup"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-N06L3PVN-R">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-19</dcterms:modified>
      <skos:altLabel xml:lang="en">SRRE</skos:altLabel>
      <skos:definition xml:lang="en">A self-reference effect obseved when remembering information that has been processed in relation to oneself is associated with a subjective experience of recollection.</skos:definition>
      <skos:definition xml:lang="fr">Phénomène de la mémoire observé lorsque le souvenir d'une information qui a été traitée par rapport à soi est associé à une expérience subjective de recollection.</skos:definition>
      <skos:prefLabel xml:lang="fr">effet de référence à soi recollective</skos:prefLabel>
      <skos:prefLabel xml:lang="en">self-reference recollection effect</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Conway, M. A., &amp; Dewhurst, S. A. (1995). The self and recollective experience. Applied Cognitive Psychology, 9(1), 1-19. https://doi.org/10.1002/acp.2350090102</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-MHT5S4XH-4"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-DP4NMT2L-9"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-XBK7Q5XL-7"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-WJJR1CX9-X">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-29</dcterms:modified>
      <skos:altLabel xml:lang="en">ownership self-reference effect</skos:altLabel>
      <skos:altLabel xml:lang="en">ownership-induced self-bias</skos:altLabel>
      <skos:definition xml:lang="en">A self-reference effect observed when memory for objects owned by the subject is better than memory for objects owned by another person.</skos:definition>
      <skos:definition xml:lang="fr">Effet d'autoréférence observé quand la mémoire d'objets que le sujet possède est meilleure que la mémoire d'objets possédés par une autre personne.</skos:definition>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q28135489"/>
      <skos:prefLabel xml:lang="fr">effet de propriété</skos:prefLabel>
      <skos:prefLabel xml:lang="en">ownership effect</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Clarkson, T. R., Cunningham, S. J., Haslam, C., &amp; Kritikos, A. (2022). Is self always prioritised? Attenuating the ownership self-reference effect in memory. Consciousness and Cognition, 106, 103420. https://doi.org/10.1016/j.concog.2022.103420</dct:bibliographicCitation>
      <dct:bibliographicCitation>Clarkson, T., Paff, H. A., Cunningham, S., Ross, J., Haslam, C., &amp; Kritikos, A. (2024). Mine for life: Charting ownership effects in memory from adolescence to old age. Quarterly Journal of Experimental Psychology, 17470218241254119. https://doi.org/10.1177/17470218241254119</dct:bibliographicCitation>
      <dct:bibliographicCitation>Cunningham, S. J., Scott, L., Hutchison, J., Ross, J., &amp; Martin, D. (2018). Applying self-processing biases in education: Improving learning through ownership. Journal of Applied Research in Memory and Cognition, 7(3), 342–351. https://doi.org/10.1016/j.jarmac.2018.04.004</dct:bibliographicCitation>
      <dct:bibliographicCitation>Cunningham, S. J., Brady-Van den Bos, M., &amp; Turk, D. J. (2011). Exploring the effects of ownership and choice on self-memory biases. Memory, 19(5), 449–461. https://doi.org/10.1080/09658211.2011.584388</dct:bibliographicCitation>
      <dct:bibliographicCitation>Cunningham, S. J., Turk, D. J., Macdonald, L. M., &amp; Neil Macrae, C. (2008). Yours or mine? Ownership and memory. Consciousness and Cognition, 17(1), 312-318. https://doi.org/10.1016/j.concog.2007.04.003</dct:bibliographicCitation>
      <dct:bibliographicCitation>Li, Q., Gao, J., Cao, C., &amp; Li, T. (2023). The impact of group ownership on memory. The Journal of General Psychology, 150(3), 267–277. https://doi.org/10.1080/00221309.2022.2047002</dct:bibliographicCitation>
      <dct:bibliographicCitation>Sparks, S., Cunningham, S. J., &amp; Kritikos, A. (2016). Culture modulates implicit ownership-induced self-bias in memory. Cognition, 153, 89–98. https://doi.org/10.1016/j.cognition.2016.05.003</dct:bibliographicCitation>
      <dct:bibliographicCitation>van den Bos, M., Cunningham, S. J., Conway, M. A., &amp; Turk, D. J. (2010). Mine to remember: The impact of ownership on recollective experience. Quarterly Journal of Experimental Psychology, 63(6), 1065–1071. https://doi.org/10.1080/17470211003770938</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-MHT5S4XH-4"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-WRBXK1F6-T">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-03-15</dcterms:modified>
      <skos:definition xml:lang="fr">Ensemble des connaissances phonologiques, orthographiques, sémantiques, syntaxiques et morphologiques sur les mots que possède un sujet et stocké en mémoire sémantique.</skos:definition>
      <skos:definition xml:lang="en">Phonological, orthographic, semantic, syntactic and morphological knowledge of words stored in semantic memory.</skos:definition>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Mental_lexicon"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q655170"/>
      <skos:prefLabel xml:lang="fr">lexique mental</skos:prefLabel>
      <skos:prefLabel xml:lang="en">mental lexicon</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Dóczi, B. (2020). An overview of conceptual models and theories of lexical representation in the mental lexicon. In S. Webb (Ed.), The Routledge handbook of vocabulary studies (pp. 46–65). Routledge.</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-L02857LC-7"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-MLWJ2PR9-Z"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-XMTSLPKB-Q"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-XNLQCLLB-9">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-02-21</dcterms:modified>
      <skos:altLabel xml:lang="en">immediate serial recognition task</skos:altLabel>
      <skos:altLabel xml:lang="en">matching span task</skos:altLabel>
      <skos:altLabel xml:lang="fr">paradigme de reconnaissance sérielle</skos:altLabel>
      <skos:altLabel xml:lang="en">serial recognition paradigm</skos:altLabel>
      <skos:altLabel xml:lang="fr">tâche de reconnaissance sérielle immédiate</skos:altLabel>
      <skos:definition xml:lang="en">Recognition task in which the subject has to recognize the order of items.</skos:definition>
      <skos:definition xml:lang="fr">Tâche de reconnaissance au cours de laquelle le sujet doit reconnaître l’ordre des items qui ont été étudiés.</skos:definition>
      <skos:hiddenLabel xml:lang="fr">reconnaissance sérielle</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">reconnaissances sérielles</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">serial recognition</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">serial recognition task</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">tâche de reconnaissance sérielle</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Chubala, C. M., Neath, I., &amp; Surprenant, A. M. (2019). A comparison of immediate serial recall and immediate serial recognition. Canadian Journal of Experimental Psychology/Revue Canadienne de Psychologie Expérimentale, 73(1), 5–27. https://doi.org/10.1037/cep0000158</dct:bibliographicCitation>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-QZRTL2B1-9"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-VC9TWVJ8-D"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-KCJ85PL3-0"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-MLWJ2PR9-Z"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-XMTSLPKB-Q"/>
