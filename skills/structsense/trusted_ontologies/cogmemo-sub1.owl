   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-LX8TQ4ML-9">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-04-01</dcterms:modified>
      <skos:altLabel xml:lang="fr">diffusion de l'activation</skos:altLabel>
      <skos:definition xml:lang="fr">Dans un réseau sémantique, processus par lequel est diffusée l'activation d'un concept aux concepts associés.</skos:definition>
      <skos:definition xml:lang="en">In a semantic network, a process that spread the activation of a concept to related concepts.</skos:definition>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Spreading_activation"/>
      <skos:exactMatch rdf:resource="https://www.cognitiveatlas.org/concept/id/trm_4a3fd79d0b26d"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q423068"/>
      <skos:prefLabel xml:lang="fr">propagation de l'activation</skos:prefLabel>
      <skos:prefLabel xml:lang="en">spreading activation</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Collins, A. M., &amp; Loftus, E. F. (1975). A spreading-activation theory of semantic processing. Psychological Review, 82(6), 407–428. https://doi.org/10.1037/0033-295X.82.6.407</dct:bibliographicCitation>
      <dct:bibliographicCitation>Denhière, G., &amp; Kekenbosch, C. (1988). L’activation et la diffusion de l’activation. L’Année Psychologique, 88(2), 237-256. https://doi.org/10.3406/psy.1988.29268</dct:bibliographicCitation>
