   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-QQZK44MQ-4">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-07-28</dcterms:modified>
      <skos:altLabel xml:lang="en">FIA effect</skos:altLabel>
      <skos:altLabel xml:lang="fr">amnésie illusoire</skos:altLabel>
      <skos:altLabel xml:lang="fr">biais d'oubli d'une récupération antérieure</skos:altLabel>
      <skos:altLabel xml:lang="en">forget-it-all-along bias</skos:altLabel>
      <skos:altLabel xml:lang="en">forget-it-all-along effect</skos:altLabel>
      <skos:altLabel xml:lang="en">forgot-it-all-along bias</skos:altLabel>
      <skos:definition xml:lang="fr">Oubli incident de s’être souvenu antérieurement d’une information.</skos:definition>
      <skos:definition xml:lang="en">The incidental forgetting that an event has been previously remembered.</skos:definition>
      <skos:hiddenLabel xml:lang="fr">amnésies illusoires</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">illusory amnesias</skos:hiddenLabel>
      <skos:prefLabel xml:lang="fr">effet d'oubli d'une récupération antérieure</skos:prefLabel>
      <skos:prefLabel xml:lang="en">forgot-it-all-along effect</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Anthony, K., &amp; Janssen, S. M. J. (2024). A brief overview of research into the forgot-it-all-along effect. Topics in Cognitive Science, 16(4), 675–690. https://doi.org/10.1111/tops.12670</dct:bibliographicCitation>
      <dct:bibliographicCitation>Arnold, M. M., &amp; Lindsay, D. S. (2002). Remembering remembering. Journal of Experimental Psychology: Learning, Memory, and Cognition, 28(3), 521-529. https://doi.org/10.1037//0278-7393.28.3.521</dct:bibliographicCitation>
      <dct:bibliographicCitation>Janssen, S. M. J., Anthony, K., Chang, C. Y. M., Choong, E.-L., Neoh, J. Y., &amp; Lim, A. (2022). Replicating remembering “remembering”. Memory, 30(6), 686‑694. https://doi.org/10.1080/09658211.2020.1868525</dct:bibliographicCitation>
      <dct:bibliographicCitation>Schooler, J. W., Bendikson, M., &amp; Ambadadar, Z. (1997). Taking the middle line: Can we accommodate both fabricated and recovered memories of sexual abuse? In M. Conway (Ed.), Recovered memories and false memories (p. 251-292). Oxford University Press.</dct:bibliographicCitation>
