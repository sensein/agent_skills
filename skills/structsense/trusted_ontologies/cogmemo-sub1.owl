   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-GX38VZ6K-R">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-07-30</dcterms:modified>
      <skos:altLabel xml:lang="en">FBM</skos:altLabel>
      <skos:altLabel xml:lang="fr">souvenir éclair</skos:altLabel>
      <skos:definition xml:lang="en">An autobiographical memory that is durable, vivid, and confidently held, of the reception context for learning about surprising, important, public events that were not directly experienced (adapted from Talarico, 2023).</skos:definition>
      <skos:definition xml:lang="fr">Souvenir autobiographique durable, vivace, et exprimé avec confiance, des circonstances dans lesquelles une personne a pris connaissance d'un évènement public surprenant et important, sans l’avoir vécu directement (traduit et adapté de Talarico, 2023).</skos:definition>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/N9J-MG51HL02-T"/>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Flashbulb_memory"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q288223"/>
      <skos:hiddenLabel xml:lang="en">FBMs</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">flashbulb memories</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">souvenirs flashes</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">souvenirs éclair</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">flashbulb memory</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">souvenir flash</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Brown, R., &amp; Kulik, J. (1977). Flashbulb memories. Cognition, 5(1), 73–99. https://doi.org/10.1016/0010-0277(77)90018-X</dct:bibliographicCitation>
      <dct:bibliographicCitation>Curci, A., Lanciano, T., Curtotti, D., &amp; Sartori, G. (2020). Lessons for the courtroom from the study of Flashbulb memory: An integrative review. Memory, 28(3), 441–449. https://doi.org/10.1080/09658211.2020.1727522</dct:bibliographicCitation>
      <dct:bibliographicCitation>Frinco, R., Muzzulini, B., Tinti, C., Luminet, O., &amp; Schmidt, S. (2024). A review of longitudinal studies on flashbulb memories. Where we started, are, and are going? Applied Cognitive Psychology, 38(4), e4233. https://doi.org/10.1002/acp.4233</dct:bibliographicCitation>
      <dct:bibliographicCitation>Kopp, S. J., Sockol, L. E., &amp; Multhaup, K. S. (2020). Age-related differences in flashbulb memories: A meta-analysis. Psychology and Aging, 35(4), 459–472. https://doi.org/10.1037/pag0000467</dct:bibliographicCitation>
      <dct:bibliographicCitation>Lecouvey, G., Desgranges, B., Peschanski, D., &amp; Eustache, F. (2020). Le souvenir flash : Un souvenir spécial au croisement de la mémoire individuelle et de la mémoire collective. Revue de neuropsychologie, 12(1), 35–45. https://doi.org/10.1684/nrp.2020.0534</dct:bibliographicCitation>
      <dct:bibliographicCitation>Luminet, O., &amp; Curci, A. (Eds.). (2009). Flashbulb Memories: New Issues and New Perspectives. Psychology Press.</dct:bibliographicCitation>
      <dct:bibliographicCitation>Luminet, O., &amp; Cordonnier, A. (2025). Flashbulb memories. Current Opinion in Psychology, 65, 102079. https://doi.org/10.1016/j.copsyc.2025.102079</dct:bibliographicCitation>
      <dct:bibliographicCitation>Talarico, J. M. (2023). Flashbulb memory. In L. M. Bietti &amp; M. Pogacar (Eds.), The Palgrave Encyclopedia of Memory Studies. Springer. https://doi.org/10.1007/978-3-030-93789-8_27-1</dct:bibliographicCitation>
      <dct:bibliographicCitation>Thomas-Antérion, C., Borg, C., Vioux, H., &amp; Laurent, B. (2010). En quoi la recherche de souvenirs flash peut-elle nous renseigner sur la mémoire épisodique et la mémoire sémantique ? Revue de neuropsychologie, 2(1), 55–60. https://doi.org/10.1684/nrp.2010.0055</dct:bibliographicCitation>
