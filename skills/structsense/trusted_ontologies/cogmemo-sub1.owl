   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-RBGX2487-F">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-07</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-07</dcterms:modified>
      <skos:altLabel xml:lang="fr">analyse transversale</skos:altLabel>
      <skos:altLabel xml:lang="en">cross-sectional analysis</skos:altLabel>
      <skos:altLabel xml:lang="en">cross-sectional design</skos:altLabel>
      <skos:altLabel xml:lang="fr">plan transversal</skos:altLabel>
      <skos:definition xml:lang="en">An observational study method consisting of collecting data from a population or a sample at a specific point in time, without follow-up.</skos:definition>
      <skos:definition xml:lang="fr">Méthode d’étude observationnelle consistant à recueillir des données sur une population ou un échantillon à un instant donné, sans suivi dans la durée.</skos:definition>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/JVR-B7TW2Q12-D"/>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Cross-sectional_study"/>
      <skos:exactMatch rdf:resource="https://fr.wikipedia.org/wiki/Étude_transversale"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q954027"/>
      <skos:example xml:lang="fr">Comparaison des performances mnésiques de personnes issues de deux groupes d'âges différents (par exemple, des jeunes adultes et des personnes âgées) à un instant donné.</skos:example>
      <skos:example xml:lang="en">Comparison of memory performance of participants from two different age groups (e.g., young adults and the elderly) at a given time.</skos:example>
      <skos:hiddenLabel xml:lang="fr">analyses transversales</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">cross-sectional analyses</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">cross-sectional designs</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">cross-sectional studies</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">plans transversaux</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">études transversales</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">cross-sectional study</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">étude transversale</skos:prefLabel>
