      <skos:hiddenLabel xml:lang="en">eyewitnesses</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">témoignages oculaires</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">témoins oculaires</skos:hiddenLabel>
