      <skos:altLabel xml:lang="en">workload</skos:altLabel>
      <skos:definition xml:lang="en">A cognitive effort required in working memory to perform a task.</skos:definition>
      <skos:definition xml:lang="fr">Effort cognitif déployé en mémoire de travail pour réaliser une tâche.</skos:definition>
