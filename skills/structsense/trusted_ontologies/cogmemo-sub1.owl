   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-RZ9DQJMH-H">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-03-21</dcterms:modified>
      <skos:altLabel xml:lang="fr">contrôle de la source</skos:altLabel>
      <skos:altLabel xml:lang="fr">maîtrise de la source</skos:altLabel>
      <skos:altLabel xml:lang="fr">monitorage de la source</skos:altLabel>
      <skos:definition xml:lang="en">"Source monitoring is the mental activity of making attributions about the origin of subjective experiences." (Mitchell, 2017, p. 129).</skos:definition>
      <skos:definition xml:lang="fr">« La surveillance de la source est l'activité mentale consistant à attribuer une origine aux expériences subjectives. » (Mitchell, 2017, p. 129).</skos:definition>
      <skos:exactMatch rdf:resource="https://www.cognitiveatlas.org/concept/id/trm_4a3fd79d0b19b"/>
