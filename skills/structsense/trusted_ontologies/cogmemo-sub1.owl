   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-JP687HXG-1">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-07</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-09-11</dcterms:modified>
      <skos:definition xml:lang="en">A false memory shared within a social group.</skos:definition>
      <skos:definition xml:lang="fr">Faux souvenir partagé au sein d’un groupe social.</skos:definition>
      <skos:hiddenLabel xml:lang="en">collective false memories</skos:hiddenLabel>
