   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-N6QV4DTJ-W">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-20</dcterms:modified>
      <skos:definition xml:lang="fr">Disposition cognitive à se focaliser sur une sélection de stimuli de l'environnement ou de représentations cognitives afin d'en améliorer le traitement.</skos:definition>
      <skos:definition xml:lang="en">The cognitive disposition to focus on a selection of environmental stimuli or cognitive representations to improve their processing.</skos:definition>
