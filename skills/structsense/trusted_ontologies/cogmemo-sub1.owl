      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-05</dcterms:modified>
      <skos:definition xml:lang="en">Generic term used for the encoding, storage and retrieval of visual information.</skos:definition>
      <skos:definition xml:lang="fr">Terme générique utilisé pour désigner le codage, le stockage et la récupération des informations visuelles.</skos:definition>
