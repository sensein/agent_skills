   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-X93ZHFV9-8">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-31</dcterms:modified>
      <skos:altLabel xml:lang="fr">attention partagée</skos:altLabel>
      <skos:altLabel xml:lang="fr">division de l'attention</skos:altLabel>
      <skos:definition xml:lang="fr">Capacité à répartir l’attention sur plusieurs stimuli ou entre des tâches réalisées simultanément.</skos:definition>
      <skos:definition xml:lang="en">The process of allocating attention to more than one stimulus or between tasks performed simultaneously.</skos:definition>
      <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/NBO_0000460"/>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/N9J-PST9ZSMJ-B"/>
      <skos:exactMatch rdf:resource="https://www.cognitiveatlas.org/concept/id/trm_4a3fd79d0a116"/>
      <skos:prefLabel xml:lang="fr">attention divisée</skos:prefLabel>
      <skos:prefLabel xml:lang="en">divided attention</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Maquestiaux, F. (2024). Psychologie de l’attention (3ᵉ éd.). De Boeck.</dct:bibliographicCitation>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-RHBPF3SS-B"/>
