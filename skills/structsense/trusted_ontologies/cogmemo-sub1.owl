   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-MJPMLMJ7-Q">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-05-10</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-01-27</dcterms:modified>
      <skos:altLabel xml:lang="en">Gc</skos:altLabel>
      <skos:definition xml:lang="fr">Aptitude à utiliser les connaissances et les habiletés acquises.</skos:definition>
      <skos:definition xml:lang="en">The ability to use acquired knowledge and skills.</skos:definition>
      <skos:prefLabel xml:lang="en">crystallized intelligence</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">intelligence cristallisée</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
