   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-TKH9LJCV-C">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-10</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-24</dcterms:modified>
      <skos:altLabel xml:lang="en">anterior brain</skos:altLabel>
      <skos:altLabel xml:lang="fr">cerveau antérieur</skos:altLabel>
      <skos:altLabel xml:lang="en">prosencephalon</skos:altLabel>
      <skos:definition xml:lang="en">Part of the brain corresponding to its most anterior region, consisting of the telencephalon and the diencephalon.</skos:definition>
      <skos:definition xml:lang="fr">Partie de l'encéphale correspondant à sa région la plus antérieure, constituée du télencéphale et du diencéphale.</skos:definition>
      <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001890"/>
      <skos:exactMatch rdf:resource="http://purl.org/sig/ont/fma/fma61992"/>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Forebrain"/>
      <skos:exactMatch rdf:resource="https://fr.wikipedia.org/wiki/Prosencéphale"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q507027"/>
      <skos:prefLabel xml:lang="en">forebrain</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">prosencéphale</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-QXWD8ZSB-9"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-VTHJRBZH-R"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-V7R9FB36-9"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Animal"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Neuroanatomie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-FCR6JN5C-1">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-10</dcterms:created>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-24</dcterms:modified>
      <skos:altLabel xml:lang="en">basal forebrain area</skos:altLabel>
      <skos:altLabel xml:lang="en">pars basalis telencephali</skos:altLabel>
      <skos:definition xml:lang="en">"A region of the brain consisting of ventral and rostral subcortical regions of the telencephalon, including among others, the basal ganglia, septal nuclei, amygdala, ventral pallidum, substantia innominata, and basal nucleus of Meynert." (source: http://purl.obolibrary.org/obo/UBERON_0002743).</skos:definition>
      <skos:definition xml:lang="fr">« Une région du cerveau composée de régions sous-corticales ventrales et rostrales du téléencéphale, y compris, entre autres, les ganglions de la base, les noyaux septaux, l'amygdale, le pallidum ventral, la substance innominata et le noyau basal de Meynert. » (source : http://purl.obolibrary.org/obo/UBERON_0002743).</skos:definition>
      <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002743"/>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Basal_forebrain"/>
      <skos:exactMatch rdf:resource="https://fr.wikipedia.org/wiki/Prosencéphale_basal"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q3407681"/>
      <skos:prefLabel xml:lang="en">basal forebrain</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">prosencéphale basal</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-V7R9FB36-9"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-J22JRX9F-0"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Animal"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Neuroanatomie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-P053HZ9V-X">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-13</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dct:creator>Perrine Ruby</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-13</dcterms:modified>
      <skos:altLabel xml:lang="en">DEWR</skos:altLabel>
      <skos:altLabel xml:lang="en">contentless dream</skos:altLabel>
      <skos:altLabel xml:lang="en">dreaming experience without recall of content</skos:altLabel>
      <skos:altLabel xml:lang="fr">rêve sans contenu</skos:altLabel>
      <skos:altLabel xml:lang="en">white dreaming</skos:altLabel>
      <skos:definition xml:lang="fr">Sentiment éprouvé au réveil d'avoir rêvé sans être capable de rappeler le contenu du rêve.</skos:definition>
      <skos:definition xml:lang="en">The feeling experienced upon awaking of having dreamed without being able to recall the dream’s content.</skos:definition>
      <skos:hiddenLabel xml:lang="en">contentless dreams</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">rêves sans contenu</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">white dreams</skos:hiddenLabel>
      <skos:prefLabel xml:lang="fr">rêve blanc</skos:prefLabel>
      <skos:prefLabel xml:lang="en">white dream</skos:prefLabel>
      <skos:scopeNote xml:lang="fr">La classification du rêve blanc n'est pas arrêtée. Certains auteurs le considèrent comme un phénomène d'oubli tandis que d’autres y voient un phénomène métacognitif, voire un bug, un dysfonctionnement, un faux souvenir.</skos:scopeNote>
      <skos:scopeNote xml:lang="en">The classification of white dreams is not settled. Some authors consider it a phenomenon of forgetting, while others see it as a metacognitive phenomenon, or something close to an encoding error, a déjà-vu-like phenomenon or a false memory.</skos:scopeNote>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Alcaraz Sánchez, A. (in press). Did I have a dream last night? White dreaming as metacognitive feelings. Mind &amp;Language. https://doi.org/10.1111/mila.70027</dct:bibliographicCitation>
      <dct:bibliographicCitation>Cohen, D. B. (1972). Failure to recall dream content: Contentless vs dreamless reports. Perceptual and Motor Skills, 34(3), 1000–1002. https://doi.org/10.2466/pms.1972.34.3.1000</dct:bibliographicCitation>
      <dct:bibliographicCitation>Cohen, D. B., &amp; Wolfe, G. (1973). Dream recall and repression: Evidence for an alternative hypothesis. Journal of Consulting and Clinical Psychology, 41(3), 349–355. (1974-09092-001). https://doi.org/10.1037/h0035333</dct:bibliographicCitation>
      <dct:bibliographicCitation>Elce, V., Bergamo, D., Bontempi, G., Pedreschi, B., Bellesi, M., Handjaras, G., &amp; Bernardi, G. (2025). The individual determinants of morning dream recall. Communications Psychology, 3(1), 25. https://doi.org/10.1038/s44271-025-00191-z</dct:bibliographicCitation>
      <dct:bibliographicCitation>Fazekas, P., &amp; Nemeth, G. (2018). Dream experiences and the neural correlates of perceptual consciousness and cognitive access. Philosophical Transactions of the Royal Society B: Biological Sciences, 373(1755), 20170356. https://doi.org/10.1098/rstb.2017.0356</dct:bibliographicCitation>
      <dct:bibliographicCitation>Fazekas, P., Nemeth, G., &amp; Overgaard, M. (2019). White dreams are made of colours: What studying contentless dreams can teach about the neural basis of dreaming and conscious experiences. Sleep Medicine Reviews, 43, 84–91. https://doi.org/10.1016/j.smrv.2018.10.005</dct:bibliographicCitation>
      <dct:bibliographicCitation>Goodenough, D. R., Witkin, H. A., Lewis, H. B., Koulack, D., &amp; Cohen, H. (1974). Repression, interference, and field dependence as factors in dream forgetting. Journal of Abnormal Psychology, 83(1), 32–44. https://doi.org/10.1037/h0036110</dct:bibliographicCitation>
      <dct:bibliographicCitation>Ruby, P. M. (2020). The neural correlates of dreaming have not been identified yet. Commentary on “the neural correlates of dreaming. Nat neurosci. 2017.” Frontiers in Neuroscience, 14, 585470. https://doi.org/10.3389/fnins.2020.585470</dct:bibliographicCitation>
      <dct:bibliographicCitation>Schredl, M., &amp; Basak, M. (2020). A diary study of dream recall: Successful dream recall and contentless dreams. International Journal of Dream Research, 123–126. https://doi.org/10.11588/ijodr.2020.1.70982</dct:bibliographicCitation>
      <dct:bibliographicCitation>Schredl, M. (2025). Measuring dream recall frequency with questionnaire scales and diaries: Reliability and validity. Dreaming, 35(4), 365–372. (2026-77674-001). https://doi.org/10.1037/drm0000323</dct:bibliographicCitation>
      <dct:bibliographicCitation>Siclari, F., Baird, B., Perogamvros, L., Bernardi, G., LaRocque, J. J., Riedner, B., Boly, M., Postle, B. R., &amp; Tononi, G. (2017). The neural correlates of dreaming. Nature Neuroscience, 20(6), 872–878. https://doi.org/10.1038/nn.4545</dct:bibliographicCitation>
      <dct:bibliographicCitation>Windt, J. M., &amp; Thompson, E. (2016). Just in time-dreamless sleep experience as pure subjective temporality. In T. Metzinger &amp; J. M. Windt (Eds.), The MIT Press. https://doi.org/10.7551/mitpress/10603.003.0113</dct:bibliographicCitation>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-HQM4N2ZZ-M"/>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-LJN4259T-9"/>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-Z4TLQPTN-5"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-LW5DVQP2-N"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-WN2MNB4D-F"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-D720VZZ8-3"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-L78BS44X-D"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-R1X014PQ-C"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-PZ74780P-7">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-18</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-24</dcterms:modified>
      <skos:definition xml:lang="en">A free recall procedure in which participants study several lists of words, freely recall the words after each list, and then perform a final free recall of all the words studied.</skos:definition>
      <skos:definition xml:lang="fr">Procédure de rappel libre dans laquelle les participants mémorisent plusieurs listes de mots, rappellent librement les mots après chaque liste, puis effectuent un rappel libre global de l’ensemble des mots étudiés.</skos:definition>
      <skos:prefLabel xml:lang="en">final free recall procedure</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">procédure du rappel libre final</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Craik, F. I. M. (1970). The fate of primary memory items in free recall. Journal of Verbal Learning and Verbal Behavior, 9(2), 143–148. https://doi.org/10.1016/S0022-5371(70)80042-1</dct:bibliographicCitation>
      <dct:bibliographicCitation>Lohnas, L. J., Polyn, S. M., &amp; Kahana, M. J. (2026). Specialized recall procedures. Psychonomic Bulletin &amp; Review. https://doi.org/10.3758/s13423-025-02744-z</dct:bibliographicCitation>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-BXR6CPT8-9"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-DP4NMT2L-9"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-RM1L7MV6-5"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Z65R7GWM-8"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-Z4TLQPTN-5"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-FH3W50RM-L">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-24</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-24</dcterms:modified>
      <skos:definition xml:lang="en">A free recall procedure in which participants memorize a list of words belonging to several semantic categories and are then asked to freely recall only the words from one specific category.</skos:definition>
      <skos:definition xml:lang="fr">Procédure de rappel libre dans laquelle les participants mémorisent une liste de mots appartenant à différentes catégories sémantiques, puis doivent rappeler librement uniquement les mots issus d’une catégorie spécifique.</skos:definition>
      <skos:prefLabel xml:lang="fr">procédure de rappel par catégorie</skos:prefLabel>
      <skos:prefLabel xml:lang="en">recall-by-category procedure</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Lohnas, L. J., Polyn, S. M., &amp; Kahana, M. J. (2026). Specialized recall procedures. Psychonomic Bulletin &amp; Review. https://doi.org/10.3758/s13423-025-02744-z</dct:bibliographicCitation>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-BXR6CPT8-9"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-DP4NMT2L-9"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Z65R7GWM-8"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-Z4TLQPTN-5"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-GTBWWKMM-4">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-25</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-25</dcterms:modified>
      <skos:altLabel xml:lang="en">instance-based theory</skos:altLabel>
      <skos:definition xml:lang="en">A theory according to which memory is considered as a single system that stores specific events (instances) in episodic memory, and where general and semantic knowledge emerge during retrieval rather than being stored in a separate semantic memory system.</skos:definition>
      <skos:definition xml:lang="fr">Théorie selon laquelle la mémoire constitue un système unique enregistrant des événements spécifiques (instances) dans la mémoire épisodique et où les connaissances générales et sémantiques émergent au moment de la récupération plutôt que d’un système sémantique distinct.</skos:definition>
      <skos:prefLabel xml:lang="en">instance theory</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">théorie des instances</skos:prefLabel>
      <skos:scopeNote xml:lang="fr">Certains modèles computationnels de la mémoire sont des implémentations de la théorie des instances. Ils sont donc décrits comme des concepts associés plutôt que comme des sous-concepts de cette théorie.</skos:scopeNote>
      <skos:scopeNote xml:lang="en">Some computational models of memory are implementations of instance theory. They are therefore described as associated concepts rather than as sub-concepts of this theory.</skos:scopeNote>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Jamieson, R. K., Avery, J. E., Johns, B. T., &amp; Jones, M. N. (2018). An instance theory of semantic memory. Computational Brain &amp; Behavior, 1(2), 119–136. https://doi.org/10.1007/s42113-018-0008-2</dct:bibliographicCitation>
      <dct:bibliographicCitation>Jamieson, R. K., Johns, B. T., Vokey, J. R., &amp; Jones, M. N. (2022). Instance theory as a domain-general framework for cognitive psychology. Nature Reviews Psychology, 1(3), 174-183. https://doi.org/10.1038/s44159-022-00025-3</dct:bibliographicCitation>
      <inist:isTheoryOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-DP4NMT2L-9"/>
      <inist:isTheoryOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-L02857LC-7"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-JT2DDSSZ-4"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-QX5NLTJ8-M"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-J5MM9009-6"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-R9TV9KX5-3"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-QX5NLTJ8-M">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-27</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-27</dcterms:modified>
      <skos:altLabel xml:lang="en">ITAM</skos:altLabel>
      <skos:altLabel xml:lang="fr">ITAM</skos:altLabel>
      <skos:altLabel xml:lang="fr">instance theory of attention and memory</skos:altLabel>
      <skos:definition xml:lang="en">A mathematically formalized instance-based theory that considers attention, categorization, and memory as different perspectives on a single cognitive act, modeled as a race among competing alternatives in which an object is simultaneously selected and categorized through analogy between stimuli and instances stored in memory (Logan, 2002).</skos:definition>
      <skos:definition xml:lang="fr">Théorie des instances, formalisée mathématiquement, qui considère l'attention, la catégorisation et la mémoire comme les différentes perspectives d'un seul et même acte cognitif, modélisé comme une course entre des alternatives concurrentes où un objet est sélectionné et catégorisé simultanément grâce à l'analogie entre les stimuli et les instances stockées en mémoire (Logan, 2002).</skos:definition>
      <skos:prefLabel xml:lang="en">instance theory of attention and memory</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">théorie des instances de l’attention et de la mémoire</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <inist:isTheoryOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-G355R5HB-T"/>
      <inist:isTheoryOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-N6QV4DTJ-W"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-GTBWWKMM-4"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-DP4NMT2L-9"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-L02857LC-7"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-S1NQ5GRF-8">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-05</dcterms:created>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-05</dcterms:modified>
      <skos:prefLabel xml:lang="fr">entité anatomique fonctionnelle</skos:prefLabel>
      <skos:prefLabel xml:lang="en">functional anatomical entity</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-C4BRZDKH-W"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-Q1S4W2QW-Z"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-KL3VT2TP-J"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-R09N1TNK-P">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-09</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-09</dcterms:modified>
      <skos:definition xml:lang="en">Auditory working memory specialized in the temporary storage and manipulation of tonal information such as pitch, timbre, and speech prosody (after Ding et al., 2018).</skos:definition>
      <skos:definition xml:lang="fr">Mémoire de travail auditive spécialisée dans le maintien temporaire et la manipulation des informations tonales telles que la hauteur tonale, le timbre et la prosodie (d’après Ding et al., 2018).</skos:definition>
      <skos:prefLabel xml:lang="fr">mémoire de travail tonale</skos:prefLabel>
      <skos:prefLabel xml:lang="en">tonal working memory</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Deutsch, D. (1970). Tones and numbers: Specificity of interference in immediate memory. Science, 168(3939), 1604–1605. https://doi.org/10.1126/science.168.3939.1604</dct:bibliographicCitation>
      <dct:bibliographicCitation>Ding, Y., Gray, K., Forrence, A., Wang, X., &amp; Huang, J. (2018). A behavioral study on tonal working memory in musicians and non-musicians. PLoS ONE, 13(8), e0201765–e0201765. https://doi.org/10.1371/journal.pone.0201765</dct:bibliographicCitation>
