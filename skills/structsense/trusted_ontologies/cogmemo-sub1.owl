   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-LFWNCPHH-C">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-01-13</dcterms:modified>
      <skos:definition xml:lang="en">Erroneous recall of items that were not studied.</skos:definition>
      <skos:definition xml:lang="fr">Rappel erroné d'éléments qui n'ont pas été étudiés.</skos:definition>
      <skos:hiddenLabel xml:lang="en">false recalls</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">faux rappels</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">false recall</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">faux rappel</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-BJ11GKSN-9"/>
