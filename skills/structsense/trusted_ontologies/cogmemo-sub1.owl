      <skos:hiddenLabel xml:lang="en">cognitive capabilities</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">cognitive dispositions</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">dispositions cognitives</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">cognition</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">cognition</skos:prefLabel>
      <skos:scopeNote xml:lang="fr">Le concept de cognition soulève des difficultés de définition (Allen, 2017 ; Fracchin, 2023).</skos:scopeNote>
      <skos:scopeNote xml:lang="en">The concept of cognition raises definitional difficulties (Allen, 2017; Fracchin, 2023).</skos:scopeNote>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Allen, C. (2017). On (not) defining cognition. Synthese, 194(11), 4233‑4249. https://doi.org/10.1007/s11229-017-1454-4</dct:bibliographicCitation>
      <dct:bibliographicCitation>Bayne, T., Brainard, D., Byrne, R. W., Chittka, L., Clayton, N., Heyes, C., Mather, J., Ölveczky, B., Shadlen, M., Suddendorf, T., &amp; Webb, B. (2019). What is cognition? Current Biology, 29(13), R608–R615. https://doi.org/10.1016/j.cub.2019.05.044</dct:bibliographicCitation>
      <dct:bibliographicCitation>Collins, T., Andler, D., &amp; Tallon-Baudry, C. (Éds.). (2018). La cognition: du neurone à la société. Gallimard.</dct:bibliographicCitation>
      <dct:bibliographicCitation>Facchin, M. (2023). Why can’t we say what cognition is (at least for the time being). Philosophy and the Mind Sciences, 4. https://doi.org/10.33735/phimisci.2023.9664</dct:bibliographicCitation>
      <dct:bibliographicCitation>Reber, A.S. (1995). Dictionary of psychology (Second edition). Penguin Books.</dct:bibliographicCitation>
