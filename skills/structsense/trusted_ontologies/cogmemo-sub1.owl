   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-TP6J5445-V">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-24</dcterms:modified>
      <skos:altLabel xml:lang="fr">connaissances scolaires</skos:altLabel>
      <skos:altLabel xml:lang="en">school knowledge</skos:altLabel>
      <skos:definition xml:lang="en">Long-term memory of the specific vocabulary of school topics.</skos:definition>
      <skos:definition xml:lang="fr">Mémoire à long terme du vocabulaire spécifique des disciplines scolaires.</skos:definition>
      <skos:prefLabel xml:lang="en">encyclopedic memory</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">mémoire encyclopédique</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Lieury, A. (1991). Mémoire et réussite scolaire. Dunod.</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-L02857LC-7"/>
