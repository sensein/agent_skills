      <skos:prefLabel xml:lang="en">semantically anomalous confabulation</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>La Corte, V., Serra, M., Attali, E., Boissé, M.-F., &amp; Barba, G. D. (2010). Confabulation in Alzheimer’s disease and amnesia: A qualitative account and a new taxonomy. Journal of the International Neuropsychological Society, 16(6), 967–974. https://doi.org/10.1017/S1355617710001001</dct:bibliographicCitation>
