   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-TBV9NL3Q-S">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2018-04-11</dcterms:modified>
      <skos:definition xml:lang="en">Gene that plays an important role in the performance of episodic memory. In particular, bearers of the KIBRA T allele score higher in episodic memory tasks.</skos:definition>
      <skos:definition xml:lang="fr">Gène qui jouerait un rôle important dans la performance de la mémoire épisodique. En particulier, les porteurs de l'allèle KIBRA T obtiennent de meilleurs scores dans des tâches de mémoire épisodique.</skos:definition>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q29725959"/>
      <skos:prefLabel xml:lang="en">KIBRA gene</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">gène KIBRA</skos:prefLabel>
