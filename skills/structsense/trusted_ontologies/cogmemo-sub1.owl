      <skos:definition xml:lang="en">A study method consisting of collecting data without variable manipulation.</skos:definition>
      <skos:definition xml:lang="fr">Méthode d’étude consistant à recueillir des données sans manipulation de variables.</skos:definition>
      <skos:hiddenLabel xml:lang="fr">méthode observationnelle</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">méthodes d'étude observationnelles</skos:hiddenLabel>
