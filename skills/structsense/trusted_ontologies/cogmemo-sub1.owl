      <inist:isModelOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-JQRWWNLB-8"/>
      <inist:isModelOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-L0QT15F8-G"/>
      <inist:isModelOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-LP0GXJZ7-C"/>
