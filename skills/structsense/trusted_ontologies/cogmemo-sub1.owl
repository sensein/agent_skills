   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-J6P7BVWC-2">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-06-13</dcterms:modified>
      <skos:definition xml:lang="en">"Emotions describe a complex set of interactions between subjective and objective variables that are mediated by neural and hormonal systems, which can (a) give rise to aﬀective experiences of emotional valence (pleasure-displeasure) and emotional arousal (high-low activation/calming-arousing); (b) generate cognitive processes such as emotionally relevant perceptual aﬀect, appraisals, labeling processes; (c) activate widespread psychological and physiological changes to the arousing conditions; and (d) motivate behavior that is often but not always expressive, goal-directed and adaptive." (Kleinginna &amp; Kleinginna, 1981, p. 355).</skos:definition>
      <skos:definition xml:lang="fr">« état affectif multidimensionnel qui s’accompagne de manifestations physiologiques, cognitives, expressives et subjectives. » (Christophe, 2019).</skos:definition>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/2CX-SP50SMH3-4"/>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/73G-XRG1F71B-G"/>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/JVR-DX4GWRKR-Q"/>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/N9J-RTGLNHX2-M"/>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Emotion"/>
      <skos:exactMatch rdf:resource="https://fr.wikipedia.org/wiki/Emotion"/>
      <skos:exactMatch rdf:resource="https://www.cognitiveatlas.org/concept/id/trm_4a3fd79d0a17f"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q9415"/>
      <skos:hiddenLabel xml:lang="fr">affectif</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">affectifs</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">affective</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">affective</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">affectives</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">emotional</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">emotions</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">émotionnel</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">émotionnelle</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">émotionnelles</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">émotionnels</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">émotions</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">emotion</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">émotion</skos:prefLabel>
      <skos:scopeNote xml:lang="fr">Il n'existe pas de définition consensuelle de ce qu'est une émotion.</skos:scopeNote>
      <skos:scopeNote xml:lang="en">There is no consensus on a definition of what an emotion is.</skos:scopeNote>
