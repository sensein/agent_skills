      <inist:isTheoryOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-S3BKSKPR-P"/>
      <inist:isTheoryOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-SHFZB6K6-D"/>
      <inist:isTheoryOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-W96GW5QP-6"/>
