      <skos:prefLabel xml:lang="en">brain fasciculus</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">faisceau cérébral</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-QXWD8ZSB-9"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-XLCKNZK8-Q"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-KL3VT2TP-J"/>
