   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-BZ880LLQ-S">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-08-29</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-26</dcterms:modified>
      <skos:altLabel xml:lang="en">CHiPS framework</skos:altLabel>
      <skos:altLabel xml:lang="fr">cadre théorique CHiPS</skos:altLabel>
      <skos:definition xml:lang="fr">Cadre théorique suggérant que la séparation de patterns est un processus s'effectuant en plusieurs étapes, impliquant des interactions entre le cortex (régions de contrôle cognitif modulant les régions sensorielles) et l'hippocampe.</skos:definition>
      <skos:definition xml:lang="en">Theoretical framework suggesting that pattern separation is a multi-stage process involving interactions between the cortex (cognitive control regions that modulate sensory regions) and the hippocampus.</skos:definition>
      <skos:prefLabel xml:lang="fr">cadre théorique de la séparation de patterns cortico-hippocampique</skos:prefLabel>
      <skos:prefLabel xml:lang="en">cortico-hippocampal pattern separation framework</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Amer, T., &amp; Davachi, L. (2023). Extra-hippocampal contributions to pattern separation. eLife, 12, e82250. https://doi.org/10.7554/eLife.82250</dct:bibliographicCitation>
      <inist:isTheoryOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-JJJRFDFC-S"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-JT2DDSSZ-4"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-Z24RK3Z6-C"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Animal"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Neurophysiologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-KW8C360K-V">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-09-10</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-04</dcterms:modified>
      <skos:altLabel xml:lang="fr">effet du mot sur le bout du stylo</skos:altLabel>
      <skos:altLabel xml:lang="fr">expérience de l'orthographe sur le bout du stylo</skos:altLabel>
      <skos:altLabel xml:lang="en">tip-of-the-pen effect</skos:altLabel>
      <skos:altLabel xml:lang="en">tip-of-the-pen experience</skos:altLabel>
      <skos:altLabel xml:lang="en">tip-of-the-pen state</skos:altLabel>
      <skos:definition xml:lang="en">A metamemory phenomenon involving the difficulty to retrieve the orthographic information of a character in a logographic writing system, accompanied by the feeling that the information is known and on the verge of being recalled.</skos:definition>
      <skos:definition xml:lang="fr">Phénomène de la métamémoire impliquant une difficulté à retrouver l’information orthographique d'un caractère dans un système d’écriture logographique, accompagnée du sentiment que cette information est connue et sur le point d’être rappelée.</skos:definition>
      <skos:prefLabel xml:lang="fr">phénomène de l'orthographe sur le bout du stylo</skos:prefLabel>
      <skos:prefLabel xml:lang="en">tip-of-the-pen phenomenon</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Huang, S., Lin, W., Xu, M., Wang, R., &amp; Cai, Z. G. (2021). On the tip of the pen: Effects of character-level lexical variables and handwriter-level individual differences on orthographic retrieval difficulties in Chinese handwriting. Quarterly Journal of Experimental Psychology, 74(9), 1497–1511. https://doi.org/10.1177/17470218211004385</dct:bibliographicCitation>
      <dct:bibliographicCitation>Lin, W., Yang, T., Zheng, G., Yang, Y., Su, Y., &amp; Wang, R. (2025). Tip-of-the-pen states in Mandarin handwriting: The effect of brief non-target language exposure. Memory &amp; Cognition, 53(6), 1803–1819. https://doi.org/10.3758/s13421-025-01684-2</dct:bibliographicCitation>
      <dct:bibliographicCitation>Yamada, J., &amp; Takashima, H. (2001). The semantic effect on retrieval of radicals in logographic characters. Reading and Writing, 14(1), 179–194. https://doi.org/10.1023/A:1008139309925</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-WN2MNB4D-F"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-P0QRPRNT-D"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-BKJ6GZ77-H"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-RGD806LB-1"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-P0QRPRNT-D">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-09-15</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-04</dcterms:modified>
      <skos:altLabel xml:lang="en">TOF</skos:altLabel>
      <skos:definition xml:lang="en">A metamemory phenomenon observed in deaf signers, involving the difficulty to retrieve a sign, accompanied by the feeling that the sign is known and on the verge of being recalled.</skos:definition>
      <skos:definition xml:lang="fr">Phénomène de la métamémoire observé chez les personnes sourdes utilisant la langue des signes, qui se caractérise par la difficulté à se souvenir d'un signe, accompagnée du sentiment que ce signe est connu et sur le point d'être rappelé.</skos:definition>
      <skos:prefLabel xml:lang="fr">phénomène du signe sur le bout des doigts</skos:prefLabel>
      <skos:prefLabel xml:lang="en">tip-of-the-fingers phenomenon</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Thompson, R., Emmorey, K., &amp; Gollan, T. H. (2005). “Tip of the fingers” experiences by deaf signers: Insights into the organization of a sign-based lexicon. Psychological Science, 16(11), 856–860.</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-WN2MNB4D-F"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-BKJ6GZ77-H"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-KW8C360K-V"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-RGD806LB-1"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-BKJ6GZ77-H">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-09-15</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-04</dcterms:modified>
      <skos:definition xml:lang="en">A metamemory phenomenon characterized by the difficulty to retrieve the name of an odor, accompanied by the feeling that the odor is known and on the verge of being recalled.</skos:definition>
      <skos:definition xml:lang="fr">Phénomène de la métamémoire caractérisé par la difficulté à retrouver le nom d'une odeur, accompagné du sentiment que cette odeur est familière et sur le point d'être rappelée.</skos:definition>
      <skos:prefLabel xml:lang="fr">phénomène de l'odeur sur le bout du nez</skos:prefLabel>
      <skos:prefLabel xml:lang="en">tip-of-the-nose phenomenon</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Lawless, H., &amp; Engen, T. (1977). Associations to odors: Interference, mnemonics, and verbal labeling. Journal of Experimental Psychology: Human Learning and Memory, 3(1), 52–59. https://doi.org/10.1037/0278-7393.3.1.52</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-WN2MNB4D-F"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-P0QRPRNT-D"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-KW8C360K-V"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-RGD806LB-1"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-R1FHTHNC-W">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-09-17</dcterms:created>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-27</dcterms:modified>
      <skos:definition xml:lang="en">A theory of concepts according to which the conceptual system is based on metaphors that allow an abstract domain to be understood with the help of a concrete domain grounded in bodily and sensorimotor experiences.</skos:definition>
      <skos:definition xml:lang="fr">Théorie des concepts selon laquelle le système conceptuel repose sur des métaphores permettant de comprendre un domaine abstrait à l'aide d'un domaine concret enraciné dans les expériences corporelles et sensorimotrices.</skos:definition>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Conceptual_metaphor"/>
      <skos:prefLabel xml:lang="en">conceptual metaphor theory</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">théorie de la métaphore conceptuelle</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Kövecses, Z. (2022). Some recent issues in conceptual metaphor theory. In M. Prandi &amp; M. Rossi (Eds.), Researching Metaphors (pp. 29–41). Routledge.</dct:bibliographicCitation>
      <dct:bibliographicCitation>Lakoff, G., &amp; Johnson, M. (1980/1985). Les métaphores dans la vie quotidienne (M. de Fornel &amp; J.-J. Lecercle, Trad.). Éditions de Minuit.</dct:bibliographicCitation>
      <dct:bibliographicCitation>Lakoff, G., &amp; Johnson, M. (1980). Metaphors we live by . University of Chicago Press. </dct:bibliographicCitation>
      <inist:isTheoryOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-K06RMGWG-7"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-JT2DDSSZ-4"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-L02857LC-7"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-TMHZZ0G7-F"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-V3V0Z7B2-R"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Linguistique__Sciences_du_langage"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-K06RMGWG-7">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-09-18</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-27</dcterms:modified>
      <skos:definition xml:lang="en">A spontaneous false memory occurring when, after studying a list of metaphorical expressions instantiating a conceptual metaphor (e.g., TIME IS MONEY), participants mistakenly remember an expression that was not presented but relies on the same metaphor.</skos:definition>
      <skos:definition xml:lang="fr">Faux souvenir spontané apparaissant lorsque, après avoir étudié une liste d’expressions métaphoriques instanciant une métaphore conceptuelle (par ex. LE TEMPS, C’EST DE L’ARGENT), les participants se souviennent à tort d’une expression non présentée, mais fondée sur la même métaphore.</skos:definition>
      <skos:prefLabel xml:lang="en">conceptual metaphor false memory effect</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">effet de faux souvenir fondé sur une métaphore conceptuelle</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Katz, A. N., &amp; Reid, J. N. (2020). Tests of conceptual metaphor theory with episodic memory tests. Cognitive Semantics, 6(1), 56‑82. https://doi.org/10.1163/23526416-00601003</dct:bibliographicCitation>
      <dct:bibliographicCitation>Reid, J.N., &amp; Katz, A. N. (2018). Something false about conceptual metaphors. Metaphor &amp; Symbol, 33(1), 36‑47. https://doi.org/10.1080/10926488.2018.1407994</dct:bibliographicCitation>
      <dct:bibliographicCitation>Reid, J. N., &amp; Katz, A. (2022). Conceptual metaphors influence memory automatically : Evidence from a divided attention false memory task. Memory &amp; Cognition, 50(6), 1336‑1349. https://doi.org/10.3758/s13421-022-01322-1</dct:bibliographicCitation>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-DP4NMT2L-9"/>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-L02857LC-7"/>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-TKSCSMHR-8"/>
      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-V3V0Z7B2-R"/>
      <inist:hasTheory rdf:resource="http://data.loterre.fr/ark:/67375/P66-R1FHTHNC-W"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-BNPSX7VV-1"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-W96GW5QP-6"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-GXCZ963J-Z">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-06</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-06</dcterms:modified>
      <skos:altLabel xml:lang="en">SCT</skos:altLabel>
      <skos:definition xml:lang="en">A theory according to which the hippocampus generates atemporal and spatially coherent scenes that underpin episodic memory, imagination, prospection, and spatial navigation.</skos:definition>
      <skos:definition xml:lang="fr">Théorie selon laquelle l’hippocampe génère des scènes atemporelles et cohérentes sur le plan spatial, servant de support à la mémoire épisodique, à l’imagination, à la pensée future et à la navigation spatiale.</skos:definition>
      <skos:prefLabel xml:lang="en">scene construction theory</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">théorie de la construction de scènes</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Barry, D. N., &amp; Maguire, E. A. (2019). Remote memory and the hippocampus: A constructive critique. Trends in Cognitive Sciences, 23(2), 128–142. https://doi.org/10.1016/j.tics.2018.11.005</dct:bibliographicCitation>
      <dct:bibliographicCitation>Hassabis, D., &amp; Maguire, E. A. (2007). Deconstructing episodic memory with construction. Trends in Cognitive Sciences, 11(7), 299–306. https://doi.org/10.1016/j.tics.2007.05.001</dct:bibliographicCitation>
      <dct:bibliographicCitation>Hassabis, D., &amp; Maguire, E. A. (2009). The construction system of the brain. Philosophical Transactions of the Royal Society of London. Series B, Biological Sciences, 364, 1263–1271. https://doi.org/10.1098/rstb.2008.0296</dct:bibliographicCitation>
      <dct:bibliographicCitation>Maguire, E. A., &amp; Mullally, S. L. (2013). The hippocampus: A manifesto for change. Journal of Experimental Psychology: General, 142(4), 1180–1189. https://doi.org/10.1037/a0033650</dct:bibliographicCitation>
      <dct:bibliographicCitation>Mullally, S. L., &amp; Maguire, E. A. (2014). Memory, imagination, and predicting the future: A common brain mechanism? The Neuroscientist, 20(3), 220–234. https://doi.org/10.1177/1073858413495091</dct:bibliographicCitation>
      <inist:isTheoryOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-DP4NMT2L-9"/>
      <inist:isTheoryOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-FFDHW6FD-F"/>
      <inist:isTheoryOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-N9PQGMCT-N"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-JT2DDSSZ-4"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-L6ZG9VWM-T"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-XGD3J4ZG-F"/>
