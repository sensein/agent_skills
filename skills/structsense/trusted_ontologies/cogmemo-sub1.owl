   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-KJP306Z8-7">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-09-13</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-03-23</dcterms:modified>
      <inist:domain xml:lang="fr">Neuropsychologie</inist:domain>
      <inist:domain xml:lang="en">Neuropsychology</inist:domain>
      <inist:domain xml:lang="fr">Psychologie</inist:domain>
      <inist:domain xml:lang="en">Psychology</inist:domain>
      <inist:semCategory xml:lang="fr">Homme</inist:semCategory>
      <inist:semCategory xml:lang="en">Human</inist:semCategory>
      <skos:altLabel xml:lang="fr">Test des portes</skos:altLabel>
      <skos:definition xml:lang="en">A Neuropsychological test to evaluate visual memory (visual pattern recall, door recognition) and verbal memory (recall and recognition of people's names) in adults.</skos:definition>
      <skos:definition xml:lang="fr">Test neuropsychologique permettant d'évaluer la mémoire visuelle (rappel de formes visuelles, reconnaissance de portes) et verbale (rappel et reconnaissance de noms de personnes) chez l’adulte.</skos:definition>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Doors_and_People"/>
      <skos:prefLabel xml:lang="en">Doors and People Test</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Test des portes et des personnes</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Baddeley, A.D.,Emslie, H., &amp; Nimmo-Smith, I. (1994). The Doors and People Test: A Test of visual and Verbal Recall and Recognition. Thames Valley Test Company.</dct:bibliographicCitation>
