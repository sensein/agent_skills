   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-R9DC7TZN-9">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-05-23</dcterms:modified>
      <skos:definition xml:lang="fr">Disposition cognitive à modifier son comportement, ses connaissance et ses habiletés en fonction de l’expérience.</skos:definition>
      <skos:definition xml:lang="en">The cognitive disposition to modify behavior, knowledge or skills as a function of experience.</skos:definition>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/2CX-LVHGQ3W6-J"/>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/73G-R8Z2M3NQ-R"/>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/JVR-CN5RKT5M-B"/>
      <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/NBO_0000022"/>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Learning"/>
      <skos:exactMatch rdf:resource="https://fr.wikipedia.org/wiki/Apprentissage"/>
