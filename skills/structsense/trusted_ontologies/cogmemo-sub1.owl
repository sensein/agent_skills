      <skos:hiddenLabel xml:lang="en">longitudinal studies</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">plans longitudinaux</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">études longitudinales</skos:hiddenLabel>
