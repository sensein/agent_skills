      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-P7FZPNZP-6"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-R9C47FSL-5"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-Z24RK3Z6-C"/>
