      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-MemoryAndEducationGroup"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-KQSLWCN0-6">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-01-13</dcterms:modified>
      <skos:definition xml:lang="en">Negative transfer occurs when a first learning impairs a second learning.</skos:definition>
      <skos:definition xml:lang="fr">Un transfert négatif s’observe quand un premier apprentissage entrave un second apprentissage.</skos:definition>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q6987274"/>
      <skos:hiddenLabel xml:lang="fr">transferts négatifs</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">negative transfer</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">transfert négatif</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-N8DW5K8D-9"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-Q591RXQT-B"/>
