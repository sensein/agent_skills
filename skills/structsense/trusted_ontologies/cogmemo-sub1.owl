      <skos:hiddenLabel xml:lang="en">amnestic disorders</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">amnésies</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">troubles amnésiques</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">amnesia</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">amnésie</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
