      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q133500"/>
      <skos:hiddenLabel xml:lang="fr">apprentissages</skos:hiddenLabel>
      <skos:prefLabel xml:lang="fr">apprentissage</skos:prefLabel>
      <skos:prefLabel xml:lang="en">learning</skos:prefLabel>
      <skos:scopeNote xml:lang="fr">Le concept d'apprentissage soulève des difficultés pour en donner une définition consensuelle (Roediger &amp; Uner, 2024).</skos:scopeNote>
      <skos:scopeNote xml:lang="en">The concept of learning is difficult to define (Roediger &amp; Uner, 2024).</skos:scopeNote>
