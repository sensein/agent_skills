   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-BVX2N7J5-X">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-12</dcterms:modified>
      <skos:definition xml:lang="en">A learning process of rules and events that the subject has not explicitly identified.</skos:definition>
      <skos:definition xml:lang="fr">Apprentissage de règles, d’évènements non identifiés explicitement par le sujet.</skos:definition>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Implicit_learning"/>
      <skos:exactMatch rdf:resource="https://www.cognitiveatlas.org/concept/id/trm_565bce2791089"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q938545"/>
      <skos:hiddenLabel xml:lang="fr">apprentissages implicites</skos:hiddenLabel>
      <skos:prefLabel xml:lang="fr">apprentissage implicite</skos:prefLabel>
      <skos:prefLabel xml:lang="en">implicit learning</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Christiansen, M. H. (2019). Implicit statistical learning: A tale of two literatures. Topics in Cognitive Science, 11(3), 468–481. https://doi.org/10.1111/tops.12332</dct:bibliographicCitation>
      <dct:bibliographicCitation>Meulemans, T. (1998). L'apprentissage implicite : une approche cognitive, neuropsychologique et développementale. Marseille.</dct:bibliographicCitation>
      <dct:bibliographicCitation>Perruchet, P., Nicolas, S. (1998). L'apprentissage implicite : un débat théorique. Psychologie Française, 43(1), 13-25.</dct:bibliographicCitation>
      <dct:bibliographicCitation>Reber, A.S. (1993). Implicit learning and tacit knowledge: An essay on the cognitive unconscious. Oxford University Press.</dct:bibliographicCitation>
      <dct:bibliographicCitation>Reber, A. S., &amp; Allen, R. (Eds.). (2022). The cognitive unconscious: The first half century. Oxford University Press Inc.</dct:bibliographicCitation>
