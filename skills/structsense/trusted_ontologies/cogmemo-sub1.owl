      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-QZ66RWMB-D">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-12</dcterms:modified>
      <skos:altLabel xml:lang="fr">jugement absolu de récence</skos:altLabel>
      <skos:definition xml:lang="en">A process of estimating the time elapsed since an event occurred in the past.</skos:definition>
      <skos:definition xml:lang="fr">Processus qui consiste à estimer combien de temps s’est écoulé depuis la survenue d’un événement dans le passé.</skos:definition>
      <skos:hiddenLabel xml:lang="en">absolute judgement of recency</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">absolute judgements of recency</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">absolute judgments of recency</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">jugements absolus de récence</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">jugements de récence absolus</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">absolute judgment of recency</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">jugement de récence absolu</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-D7HZ1ZFN-K"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-BJN438BQ-7"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-DP4NMT2L-9"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Homme"/>
