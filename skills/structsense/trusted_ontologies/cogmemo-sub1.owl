   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-QXWD8ZSB-9">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-24</dcterms:modified>
      <skos:altLabel xml:lang="en">encephalon</skos:altLabel>
      <skos:definition xml:lang="en">Part of the central nervous system located in the head and composed of the cerebrum, the cerebellum and the brain stem.</skos:definition>
      <skos:definition xml:lang="fr">Partie du système nerveux central situé dans la boîte crânienne et composé du cerveau, du cervelet et du tronc cérébral.</skos:definition>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/2CX-JR3VTRWH-R"/>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/JVR-WT7M9M2F-1"/>
      <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000955"/>
      <skos:exactMatch rdf:resource="http://scholarpedia.org/article/Brain"/>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/N9J-P1SS4NL9-M"/>
