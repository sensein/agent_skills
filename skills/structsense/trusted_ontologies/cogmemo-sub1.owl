      <skos:altLabel xml:lang="fr">mémoire propositionnelle</skos:altLabel>
      <skos:altLabel xml:lang="en">propositional memory</skos:altLabel>
      <skos:altLabel xml:lang="fr">représentation sémantique</skos:altLabel>
      <skos:altLabel xml:lang="en">semantic cognition</skos:altLabel>
      <skos:altLabel xml:lang="en">semantic knowledge</skos:altLabel>
      <skos:altLabel xml:lang="en">semantic representation</skos:altLabel>
      <skos:altLabel xml:lang="fr">système conceptuel</skos:altLabel>
      <skos:definition xml:lang="en">Declarative memory storing general knowledge about the world (words, concepts, facts, etc.), independent of the spatio-temporal context of their acquisition, and associated with a noetic mode of consciousness.</skos:definition>
      <skos:definition xml:lang="fr">Mémoire déclarative portant sur des connaissances générales sur le monde (mots, concepts, faits, etc.), indépendantes du contexte spatio-temporel de leur acquisition, et associée à un mode de conscience noétique.</skos:definition>
