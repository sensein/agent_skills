   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-D5PHL00G-K">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-03-29</dcterms:modified>
      <skos:altLabel xml:lang="fr">mémoire absolue</skos:altLabel>
      <skos:altLabel xml:lang="fr">mémoire photographique</skos:altLabel>
      <skos:altLabel xml:lang="en">photographic memory</skos:altLabel>
      <skos:altLabel xml:lang="fr">rappel total</skos:altLabel>
      <skos:altLabel xml:lang="fr">souvenir total</skos:altLabel>
      <skos:altLabel xml:lang="en">total memory</skos:altLabel>
      <skos:altLabel xml:lang="en">total recall</skos:altLabel>
      <skos:definition xml:lang="fr">Sensation de posséder un souvenir vivace, d’une parfaite netteté et complet d'un évènement, habituellement de nature visuelle.</skos:definition>
      <skos:definition xml:lang="en">The feeling of having a vivid, clear and complete memory of an event, usually of a visual nature.</skos:definition>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/JVR-VGL413RZ-0"/>
