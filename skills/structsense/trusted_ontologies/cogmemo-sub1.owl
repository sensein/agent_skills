   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-PFGD1180-S">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-05</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-05</dcterms:modified>
      <skos:altLabel xml:lang="en">LLM</skos:altLabel>
      <skos:altLabel xml:lang="fr">grand modèle de language</skos:altLabel>
      <skos:altLabel xml:lang="fr">grand modèle linguistique</skos:altLabel>
