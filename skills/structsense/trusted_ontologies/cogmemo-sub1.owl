   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-TFS69V6F-G">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-03-07</dcterms:modified>
      <skos:altLabel xml:lang="fr">parenté sémantique</skos:altLabel>
      <skos:altLabel xml:lang="en">semantic relatedness</skos:altLabel>
      <skos:altLabel xml:lang="en">semantic similarity</skos:altLabel>
      <skos:altLabel xml:lang="fr">similarité sémantique</skos:altLabel>
      <skos:definition xml:lang="en">Measure of relatedness between concepts in semantic memory.</skos:definition>
      <skos:definition xml:lang="fr">Mesure de la parenté entre concepts en mémoire sémantique.</skos:definition>
