   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-NLTPHDCZ-C">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-12</dcterms:modified>
      <skos:altLabel xml:lang="fr">acquisition en une fois</skos:altLabel>
      <skos:altLabel xml:lang="en">one-shot acquisition</skos:altLabel>
      <skos:definition xml:lang="en">A learning process of new information after that information has only been presented once.</skos:definition>
      <skos:definition xml:lang="fr">Processus d'apprentissage d'une nouvelle information après une seule présentation de cette information.</skos:definition>
      <skos:prefLabel xml:lang="fr">apprentissage en une fois</skos:prefLabel>
      <skos:prefLabel xml:lang="en">one-shot learning</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Landau, B., Smith, L. B., &amp; Jones, S. S. (1988). The importance of shape in early lexical learning. Cognitive Development, 3(3), 299‑321. https://doi.org/10.1016/0885-2014(88)90014-7</dct:bibliographicCitation>
      <dct:bibliographicCitation>Weaver, J. (2015). How one-shot learning unfolds in the brain. PLOS Biology, 13(4), e1002138. https://doi.org/10.1371/journal.pbio.1002138</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-T08V3LTM-3"/>
