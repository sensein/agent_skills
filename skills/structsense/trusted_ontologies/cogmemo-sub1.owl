   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-JD19VJZW-4">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-05-15</dcterms:modified>
      <skos:altLabel xml:lang="en">recitation</skos:altLabel>
      <skos:altLabel xml:lang="fr">récitation</skos:altLabel>
      <skos:definition xml:lang="en">Strategy of trying to remember learned information before the final memory test.</skos:definition>
      <skos:definition xml:lang="fr">Stratégie consistant à tenter de se souvenir des informations mémorisées avant le test final de la mémoire.</skos:definition>
      <skos:prefLabel xml:lang="fr">pratique de la récupération</skos:prefLabel>
      <skos:prefLabel xml:lang="en">retrieval practice</skos:prefLabel>
