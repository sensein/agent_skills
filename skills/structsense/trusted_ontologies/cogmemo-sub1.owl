      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-P3M6R75K-J"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-PQTL8CCL-Z"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-Q7DKTCC5-X"/>
