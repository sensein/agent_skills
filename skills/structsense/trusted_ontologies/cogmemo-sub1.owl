      <inist:hasStudyMethod rdf:resource="http://data.loterre.fr/ark:/67375/P66-MLRZFFJQ-C"/>
      <inist:hasTheory rdf:resource="http://data.loterre.fr/ark:/67375/P66-M93QNCCP-5"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-C5T6XKTC-T"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-M27HBS7N-W"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-RBGX2487-F"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-DB5H7CC7-C"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-HFLQLV31-8"/>
