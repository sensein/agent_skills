   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-SLB5MT9S-B">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-04</dcterms:modified>
      <inist:reviewedBy>Patrice Terrier</inist:reviewedBy>
      <skos:altLabel xml:lang="fr">effet de réitération</skos:altLabel>
      <skos:altLabel xml:lang="fr">effet de validité</skos:altLabel>
      <skos:altLabel xml:lang="fr">effet de vérité</skos:altLabel>
      <skos:altLabel xml:lang="en">illusory truth</skos:altLabel>
      <skos:altLabel xml:lang="en">reiteration effect</skos:altLabel>
      <skos:altLabel xml:lang="en">repetition truth effect</skos:altLabel>
      <skos:altLabel xml:lang="en">truth effect</skos:altLabel>
      <skos:altLabel xml:lang="en">truth-by-repetition-effect</skos:altLabel>
      <skos:altLabel xml:lang="en">validity effect</skos:altLabel>
      <skos:altLabel xml:lang="fr">vérité illusoire</skos:altLabel>
      <skos:definition xml:lang="en">A memory phenomenon observed whend repeated presentation of a statement increases the likelihood that it will subsequently be judged as true.</skos:definition>
      <skos:definition xml:lang="fr">Phénomène de la mémoire observé lorsque la présentation répétée d’un énoncé augmente la probabilité qu’il soit ensuite jugé comme vrai.</skos:definition>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Illusory_truth_effect"/>
      <skos:exactMatch rdf:resource="https://fr.wikipedia.org/wiki/Effet_de_vérité_illusoire"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q2540477"/>
      <skos:prefLabel xml:lang="fr">effet de vérité illusoire</skos:prefLabel>
      <skos:prefLabel xml:lang="en">illusory truth effect</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
