   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-V4LVTXVQ-3">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-30</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-30</dcterms:modified>
      <skos:altLabel xml:lang="en">TNTA</skos:altLabel>
      <skos:definition xml:lang="fr">Adaptation du paradigme penser/ne pas penser pour étudier la suppression volontaire de souvenirs dans des contextes liés à la consommation d’alcool.</skos:definition>
      <skos:definition xml:lang="en">Adaptation of the Think/No-Think paradigm to study voluntary suppression of memories in contexts related to alcohol consumption.</skos:definition>
      <skos:prefLabel xml:lang="en">think/no-think alcohol task</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">tâche penser/ne pas penser à l’alcool</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>López‐Caneda, E., Crego, A., Campos, A. D., González‐Villar, A., &amp; Sampaio, A. (2019). The think/no‐think alcohol task: A new paradigm for assessing memory suppression in alcohol‐related contexts. Alcoholism: Clinical and Experimental Research, 43(1), 36–47. https://doi.org/10.1111/acer.13916</dct:bibliographicCitation>
