   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-MFXNRQL6-0">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-11-09</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-11-13</dcterms:modified>
      <skos:definition xml:lang="en">A confabulation with an extremely bizarre and semantically anomalous content (La Corte et al., 2010).</skos:definition>
      <skos:definition xml:lang="fr">Confabulation dont le contenu est extrêmement bizarre et sémantiquement anormal (La Corte et al., 2010).</skos:definition>
