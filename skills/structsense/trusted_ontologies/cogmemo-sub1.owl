   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-B2VBR640-C">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-12-08</dcterms:modified>
      <skos:definition xml:lang="en">A computational model of memory in which each encoded item will leave a unique trace in memory.</skos:definition>
      <skos:definition xml:lang="fr">Modèle computationnel de la mémoire dans lesquels chaque élément encodé va laisser une trace unique en mémoire.</skos:definition>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Multiple_trace_theory"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q6934969"/>
      <skos:hiddenLabel xml:lang="fr">modèles à traces multiples</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">multiple trace models</skos:hiddenLabel>
      <skos:prefLabel xml:lang="fr">modèle à traces multiples</skos:prefLabel>
      <skos:prefLabel xml:lang="en">multiple trace model</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Hintzman, D. L. (1986). « Schema abstraction » in a multiple-trace memory model. Psychological Review, 93(4), 411‑428. https://doi.org/10.1037/0033-295X.93.4.411</dct:bibliographicCitation>
      <dct:bibliographicCitation>Logan, G. D. (1988). Toward an instance theory of automatization. Psychological Review, 95(4), 492‑527. https://doi.org/10.1037/0033-295X.95.4.492</dct:bibliographicCitation>
      <dct:bibliographicCitation>Whittlesea, B. W. (1987). Preservation of specific experiences in the representation of general knowledge. Journal of Experimental Psychology: Learning, Memory, and Cognition, 13(1), 3‑17. https://doi.org/10.1037/0278-7393.13.1.3</dct:bibliographicCitation>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-MMPD886D-4"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-J5MM9009-6"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-PKTVX4JZ-Q"/>
