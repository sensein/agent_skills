      <skos:hiddenLabel xml:lang="fr">capacités cognitives</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">cognitions</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">cognitions</skos:hiddenLabel>
