      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Neuropsychologie"/>
      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-KCJFSJMN-L">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-11-19</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-10-27</dcterms:modified>
      <skos:definition xml:lang="en">A video game designed for studying prospective memory development in children.</skos:definition>
      <skos:definition xml:lang="fr">Jeu vidéo développé pour étudier le développement de la mémoire prospective chez l’enfant.</skos:definition>
      <skos:prefLabel xml:lang="en">CyberCruiser</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">CyberCruiser</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Kerns, K. A. (2000). The CyberCruiser: An investigation of development of prospective memory in children. Journal of the International Neuropsychological Society, 6(1), 62–70. https://doi.org/10.1017/S1355617700611074</dct:bibliographicCitation>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-HM6SF432-R"/>
      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Z6SQPXCN-P"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-BM4VZW20-5"/>
