      <skos:hiddenLabel xml:lang="en">memory editing strategies</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">memory editing strategy</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">memory-editing mechanisms</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">memory-editing processes</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">memory-editing strategies</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">memory-editing strategy</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">memory-editing process</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">processus de révision mnésique</skos:prefLabel>
