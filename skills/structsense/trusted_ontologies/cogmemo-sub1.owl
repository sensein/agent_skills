      <skos:exactMatch rdf:resource="https://fr.wikipedia.org/wiki/Trouble_cognitif_léger"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q1472703"/>
      <skos:prefLabel xml:lang="fr">déficit cognitif léger</skos:prefLabel>
      <skos:prefLabel xml:lang="en">mild cognitive impairment</skos:prefLabel>
