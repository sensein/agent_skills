   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-PBL8WPZJ-Z">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-11-09</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-08-27</dcterms:modified>
      <skos:definition xml:lang="en">A confabulation charaterized by a plausible memory, semantic or episodic, without any recognizable link with personal or public events (La Corte et al., 2010).</skos:definition>
      <skos:definition xml:lang="fr">Confabulation qui se caractérise par un souvenir plausible, sémantique ou épisodique, sans lien reconnaissable avec des événements personnels ou publics (La Corte et al., 2010).</skos:definition>
      <skos:hiddenLabel xml:lang="fr">fabrications mnésiques</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">memory fabrications</skos:hiddenLabel>
      <skos:prefLabel xml:lang="fr">fabrication mnésique</skos:prefLabel>
      <skos:prefLabel xml:lang="en">memory fabrication</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
