   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-P7FZPNZP-6">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-08-29</dcterms:modified>
      <skos:altLabel xml:lang="en">anterograde memory loss</skos:altLabel>
      <skos:altLabel xml:lang="fr">perte de mémoire antérograde</skos:altLabel>
      <skos:definition xml:lang="en">Amnesia characterized by the patient's difficulty in forming new long-term memories since the onset of the disease.</skos:definition>
      <skos:definition xml:lang="fr">Amnésie se manifestant par la difficulté pour le patient à former de nouveaux souvenirs à long terme depuis le début de la maladie.</skos:definition>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/2CX-K6BTZFC7-C"/>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/JVR-MWGKHV5T-M"/>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/N9J-RWH591D8-C"/>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Anterograde_amnesia"/>
      <skos:exactMatch rdf:resource="https://fr.wikipedia.org/wiki/Amnésie_antérograde"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q572111"/>
      <skos:hiddenLabel xml:lang="fr">amnésies antérogrades</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">anterograde amnesias</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="en">pertes de mémoire antérograde</skos:hiddenLabel>
      <skos:prefLabel xml:lang="fr">amnésie antérograde</skos:prefLabel>
      <skos:prefLabel xml:lang="en">anterograde amnesia</skos:prefLabel>
