   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-NGW4PJPZ-5">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-03-19</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-01-13</dcterms:modified>
      <skos:definition xml:lang="fr">Amélioration durable de la perception d’un stimulus par la pratique et l’expérience.</skos:definition>
      <skos:definition xml:lang="en">Long-lasting improvement in the perception of a stimulus with practice and experience.</skos:definition>
