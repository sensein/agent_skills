      <skos:hiddenLabel xml:lang="fr">modèles de langues</skos:hiddenLabel>
      <skos:prefLabel xml:lang="en">language model</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">modèle de langue</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <dct:bibliographicCitation>Bengio, Y. (2008). Neural net language models. Scholarpedia, 3(1), 3881.https//doi.org/10.4249/scholarpedia.3881</dct:bibliographicCitation>
