   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-R97597VB-C">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-03-25</dcterms:modified>
      <skos:altLabel xml:lang="en">auditory persistence</skos:altLabel>
      <skos:altLabel xml:lang="en">auditory sensory memory</skos:altLabel>
      <skos:altLabel xml:lang="fr">magasin acoustique précatégoriel</skos:altLabel>
      <skos:altLabel xml:lang="fr">mémoire sensorielle auditive</skos:altLabel>
