      <inist:isStudyMethodOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-ZTRSJ6KF-F"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-BM4VZW20-5"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-BJ3M9Z3J-H"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-W2HP08XP-2"/>
