   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-S87VDF5Z-0">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-03-06</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-04-04</dcterms:modified>
