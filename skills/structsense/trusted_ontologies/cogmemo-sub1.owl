      <uneskos:memberOf rdf:resource="http://data.loterre.fr/ark:/67375/P66-Psychologie"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-TRDPZH1R-K">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-30</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-30</dcterms:modified>
      <skos:altLabel xml:lang="en">parahippocampal region</skos:altLabel>
      <skos:altLabel xml:lang="fr">région parahippocampique</skos:altLabel>
      <skos:definition xml:lang="en">Part of the medial temporal lobe surrounding the hippocampus.</skos:definition>
      <skos:definition xml:lang="fr">Partie du lobe temporal médian entourant l'hippocampe.</skos:definition>
      <skos:exactMatch rdf:resource="http://data.loterre.fr/ark:/67375/JVR-N7DZ9QTS-B"/>
      <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002973"/>
      <skos:exactMatch rdf:resource="http://purl.org/sig/ont/fma/fma61918"/>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Parahippocampal_gyrus"/>
      <skos:exactMatch rdf:resource="https://fr.wikipedia.org/wiki/Gyrus_parahippocampique"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q1545429"/>
      <skos:prefLabel xml:lang="fr">gyrus parahippocampique</skos:prefLabel>
      <skos:prefLabel xml:lang="en">parahippocampal gyrus</skos:prefLabel>
      <skos:inScheme rdf:resource="http://data.loterre.fr/ark:/67375/P66"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-D445NRM4-5"/>
      <skos:broader rdf:resource="http://data.loterre.fr/ark:/67375/P66-SW8Q6C6S-B"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-M32JMLQM-4"/>
      <skos:narrower rdf:resource="http://data.loterre.fr/ark:/67375/P66-MRNF4MMC-Q"/>
