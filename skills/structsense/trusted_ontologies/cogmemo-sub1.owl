   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-KQ1K76V2-C">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-01-27</dcterms:modified>
      <skos:altLabel xml:lang="en">complex WM span task</skos:altLabel>
      <skos:altLabel xml:lang="en">complex span</skos:altLabel>
      <skos:altLabel xml:lang="en">complex working memory span task</skos:altLabel>
      <skos:altLabel xml:lang="fr">empan complexe</skos:altLabel>
      <skos:altLabel xml:lang="en">processing-and-storage task</skos:altLabel>
      <skos:altLabel xml:lang="fr">tâche d'empan complexe de mémoire de travail</skos:altLabel>
      <skos:definition xml:lang="en">A working memory span task combining the temporary maintenance of information with a processing task.</skos:definition>
      <skos:definition xml:lang="fr">Tâche d'empan en mémoire de travail, combinant la rétention temporaire avec la manipulation d'informations.</skos:definition>
