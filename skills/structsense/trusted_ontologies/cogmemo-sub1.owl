      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-BBT8K8S7-G"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-DP4NMT2L-9"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-MZJXHVN9-N"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-MZZPPXM0-S"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-RR3NPLQW-P"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-V31CXM91-G"/>
      <skos:related rdf:resource="http://data.loterre.fr/ark:/67375/P66-VBNTF4K7-N"/>
