   </skos:Concept>
   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-N2C1MM61-N">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-12-04</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-12-10</dcterms:modified>
      <inist:reviewedBy>Krystian Barzykowski</inist:reviewedBy>
      <skos:altLabel xml:lang="en">IAM</skos:altLabel>
      <skos:altLabel xml:lang="en">involuntary autobiographical memory</skos:altLabel>
      <skos:altLabel xml:lang="en">involuntary aware memory</skos:altLabel>
      <skos:altLabel xml:lang="en">involuntary conscious memory</skos:altLabel>
      <skos:altLabel xml:lang="en">involuntary explicit memory</skos:altLabel>
      <skos:altLabel xml:lang="fr">souvenir autobiographique involontaire</skos:altLabel>
      <skos:altLabel xml:lang="fr">souvenir conscient involontaire</skos:altLabel>
      <skos:altLabel xml:lang="fr">souvenir non intentionnel</skos:altLabel>
      <skos:altLabel xml:lang="fr">souvenir spontané</skos:altLabel>
      <skos:altLabel xml:lang="en">spontaneous memory</skos:altLabel>
      <skos:altLabel xml:lang="en">unintentional memory</skos:altLabel>
      <skos:definition xml:lang="fr">Récupération d'un souvenir du passé personnel qui vient à l'esprit spontanément, sans aucune intention préalable de le récupérer.</skos:definition>
      <skos:definition xml:lang="en">The retrieval of a personal past memory that arises spontaneously, without any prior conscious intention to retrieve it.</skos:definition>
      <skos:exactMatch rdf:resource="https://en.wikipedia.org/wiki/Involuntary_memory"/>
      <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q28635"/>
