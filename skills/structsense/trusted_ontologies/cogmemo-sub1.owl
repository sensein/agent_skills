   <skos:Concept rdf:about="http://data.loterre.fr/ark:/67375/P66-MSJWRPRN-5">
      <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2018-07-30</dcterms:created>
      <dct:creator>Frank Arnould</dct:creator>
      <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-01-25</dcterms:modified>
      <skos:altLabel xml:lang="fr">invite</skos:altLabel>
      <skos:altLabel xml:lang="fr">offrande</skos:altLabel>
      <skos:definition xml:lang="en">A disposition referring to all opportunities for action on an object as a function of an animal's sensory-motor abilities.</skos:definition>
      <skos:definition xml:lang="fr">Disposition désignant toutes les opportunités d’action sur un objet en fonction des capacités sensori-motrices d'un animal.</skos:definition>
