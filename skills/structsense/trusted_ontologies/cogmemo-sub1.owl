      <inist:semCategory xml:lang="en">Human</inist:semCategory>
      <skos:altLabel xml:lang="fr">individu par aptitude</skos:altLabel>
      <skos:altLabel xml:lang="en">individual by aptitude</skos:altLabel>
      <skos:hiddenLabel xml:lang="en">individuals by aptitude</skos:hiddenLabel>
      <skos:hiddenLabel xml:lang="fr">individus par aptitude</skos:hiddenLabel>
