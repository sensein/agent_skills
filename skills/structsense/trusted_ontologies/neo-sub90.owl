    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_elevation_soft_palate -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_elevation_soft_palate">
