    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#gait_foot_drop -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#gait_foot_drop">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_difficulty"/>
        <Example_1>Slapping of the foot when walking.</Example_1>
        <Example_2>Foot drop when walking.</Example_2>
        <Example_3>Gait with foot drop.</Example_3>
        <untitled-ontology-57:CUI>C0427149</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">27253007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An abnormal gait pattern that arises from weakness of the pretibial and peroneal muscles due to a lower motor neuron lesion. Affected patients have footdrop and are unable to dorsiflex and evert the foot. The leg is lifted high on walking so that the toes clear the ground, and there may be a slapping noise when the foot strikes the ground again.</rdfs:isDefinedBy>
    </owl:Class>
    


