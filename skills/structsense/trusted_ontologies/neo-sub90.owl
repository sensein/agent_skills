        <Example_1>sudden onset.</Example_1>
        <Example_2>immediate onset.</Example_2>
        <untitled-ontology-57:CUI>C1276802</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Onset</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>The manifestation of the injury, disease, or condition is characterized as having an immediate or early onset</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#sunken_cheeks -->

