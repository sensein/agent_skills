    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#decreased_school_achievement -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#decreased_school_achievement">
