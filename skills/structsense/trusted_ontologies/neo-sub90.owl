    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#supranuclear_gaze_palsy -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#supranuclear_gaze_palsy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/limited_eye_movements"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0000605</HPO>
        <untitled-ontology-57:CUI>C1720037</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A supranuclear gaze palsy is an inability to look in a particular direction as a result of cerebral impairment. There is a loss of the voluntary aspect of eye movements, but, as the brainstem is still intact, all the reflex conjugate eye movements are normal.</rdfs:isDefinedBy>
    </owl:Class>
    


