        <untitled-ontology-57:CUI>C0595983</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Saccades are rapid eye movements designed to shift the fovea to objects of visual interest. Abnormalities of saccades offer important clues in the diagnosis of a number of movement disorders.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/deficient_smooth_pursuit -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/deficient_smooth_pursuit">
