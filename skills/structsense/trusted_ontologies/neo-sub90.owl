        <rdfs:isDefinedBy>Weakness in abduction of the left eye.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sixth_nerve_palsy_right_eye -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sixth_nerve_palsy_right_eye">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sixth_nerve_palsy"/>
        <untitled-ontology-57:CUI>C2881289</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Weakness of abduction of right eye.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/skeletal_muscle_atrophy -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/skeletal_muscle_atrophy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/muscle_atrophy"/>
        <synonym_1>muscle wasting</synonym_1>
        <synonym_2>amyotrophy</synonym_2>
        <untitled-ontology-57:CUI>C0541794</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A process, occurring in skeletal muscle, that is characterized by a decrease in protein content, fiber diameter, force production and fatigue resistance in response to different conditions such as starvation, aging and disuse.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/skew_deviation -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/skew_deviation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysconjugate_gaze"/>
        <untitled-ontology-57:CUI>C0271381</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">40631009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Skew deviation refers to a vertical misalignment of the eyes that commonly occurs from acute brainstem lesions which disrupt prenuclear vestibular pathways to the third and fourth nerve nuclei. Occasionally, skew deviation may also result from peripheral vestibular or cerebellar lesions.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/skin_finding -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/skin_finding">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#sign"/>
        <untitled-ontology-57:CUI>C0455205</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Top</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">106076001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A finding of the skin such as rash, blister, vesicle, pigmented lesion, etc.</rdfs:isDefinedBy>
        <rdfs:seeAlso>skin_observation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sleep_paralysis -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sleep_paralysis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#sleep_disturbance"/>
        <Example_1>sleep paralysis.</Example_1>
        <Example_2>Inability to move before falling asleep.</Example_2>
        <untitled-ontology-57:CUI>C0456511</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">277180005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An inability to move the body at sleep onset or upon awakening from sleep lasting seconds to a few minutes.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sleep_related_hallucinations -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sleep_related_hallucinations">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#sleep_disturbance"/>
        <Example_1>sleep related hallucinations.</Example_1>
        <Example_2>hypnagoguic hallucinations</Example_2>
        <untitled-ontology-57:CUI>C2919925</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">445112001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Hypnagogic hallucinations are sleep-related hallucinations that occur while falling asleep.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sleep_symptoms -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sleep_symptoms">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/symptom"/>
        <untitled-ontology-57:CUI>C2232698</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Symptoms related to sleep such as insomnia, hypersomnia, narcolepsy, and nightmares.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sleep_talking -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sleep_talking">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#sleep_disturbance"/>
        <Example_1>Talks in sleep.</Example_1>
        <Example_2>Sleep talking.</Example_2>
        <synonym_1>Somniloquism</synonym_1>
        <untitled-ontology-57:CUI>C0542313</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">36321004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Sleep talking, formally known as somniloquy, is a sleep disorder defined as talking during sleep without being aware of it. Sleep talking can involve complicated dialogues or monologues, complete gibberish or mumbling.</rdfs:isDefinedBy>
        <rdfs:seeAlso>Somniloquism</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/slow_saccades -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/slow_saccades">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_saccades"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0000514</HPO>
        <untitled-ontology-57:CUI>C1321329</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Reduced saccade velocity, frequently called “slow saccades” are typically seen in a classic disorder of the midbrain called progressive supranuclear palsy. It is also traditionally diagnostic of spinocerebellar ataxia type 2. In addition to its common causes, the slowness of vertical saccades is not rare in cerebellar disorders.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/slow_speech -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/slow_speech">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/speech_impairment"/>
        <Example_1>slowed speech</Example_1>
        <Example_3>slow speech</Example_3>
        <synonym_1>bradylalia</synonym_1>
        <untitled-ontology-57:CUI>C1859270</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Slowing of speech, sometimes called bradylalia, may be due to Parkinson&apos;s disease or other bradykinetic disorder.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/slurred_speech -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/slurred_speech">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/speech_impairment"/>
        <synonym_1>dysarthria</synonym_1>
        <untitled-ontology-57:CUI>C0234518</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">289195008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Abnormal coordination of muscles involved in speech.  Usually considered synonymous with dysarthria.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/small_head_circumference -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/small_head_circumference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/head_finding"/>
        <Example_1>Small head.</Example_1>
        <Example_2>Small head circumference.</Example_2>
        <untitled-ontology-57:CUI>C0424688</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Head</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">271611007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Reduction in head circumference.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/small_optic_disc -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/small_optic_disc">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/optic_disc_finding"/>
        <untitled-ontology-57:CUI>C1828214</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">423389004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>small optic disc</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/small_pupil -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/small_pupil">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/miosis"/>
        <synonym_1>constricted pupils</synonym_1>
        <untitled-ontology-57:CUI>C0728710</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">301939004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Abnormal (non-physiological) constriction of the pupil</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/snoring -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/snoring">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#sleep_disturbance"/>
        <untitled-ontology-57:CUI>C0037384</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">72863001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Snoring is the hoarse or harsh sound that occurs when air flows past relaxed tissues in your throat, causing the tissues to vibrate as you breathe. Nearly everyone snores now and then, but for some people it can be a chronic problem. Sometimes it may also indicate a serious health condition.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/snout_reflex_present -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/snout_reflex_present">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#frontal_release_signs"/>
        <Example_1>Puckering of the lips when the philtrum of the mouth is touched.</Example_1>
        <untitled-ontology-57:CUI>C0576502</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">299753007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The snout reflex is puckering and protrusion of the lips upon pressing firmly on the philtrum of the upper lip or tapping on the on the lips.  It is a primitive release reflex generally indicative of frontal lobe injury.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/somnulence -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/somnulence">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/altered_consciousness"/>
        <synonym_1>escessive sleepiness</synonym_1>
        <synonym_2>excessive drowsiness</synonym_2>
        <untitled-ontology-57:CUI>C2830004</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">271782001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Excessive sleepiness and drowsiness</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/spastic_diplegia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/spastic_diplegia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/diplegia"/>
        <untitled-ontology-57:CUI>C0023882</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">281411007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Spasticity (neuromuscular hypertonia) primarily in the muscles of the legs, hips, and pelvis.</rdfs:isDefinedBy>
        <rdfs:seeAlso>Littles_disease</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/spasticity -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/spasticity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypertonia"/>
        <Example_1>Excessive muscle contraction and reflex hyperexcitability caused by lesions involving the upper motor neurons of the corticospinal tract.</Example_1>
        <Example_2>Increased involuntary muscle tone caused by central nervous system disorders that affect the regions interfering with voluntary movement.</Example_2>
        <Example_3>A disorder characterized by increased involuntary muscle tone that affects the regions interfering with voluntary movement.</Example_3>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0001257</HPO>
        <synonym_1>spastic</synonym_1>
        <synonym_2>muscle spasticity</synonym_2>
        <untitled-ontology-57:CUI>C0026838</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">221360009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A motor disorder characterized by a velocity-dependent increase in tonic stretch reflexes with increased muscle tone, exaggerated (hyperexcitable) tendon reflexes.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/spatial_disorientation -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/spatial_disorientation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/other_higher_cortical_functions"/>
        <untitled-ontology-57:CUI>C0422893</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">112077003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Loss of one&apos;s sense of direction, position, or relationship with one&apos;s surroundings.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/speech_impairment -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/speech_impairment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/symptom"/>
        <untitled-ontology-57:CUI>C0233715</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">162294008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An impairment in speech, usually a difficulty in articulation or expression.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/speech_limited -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/speech_limited">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_speech"/>
        <Example_1>limited speech.</Example_1>
        <Example_2>Reduced speech.</Example_2>
        <untitled-ontology-57:CUI>C0581878</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">162252005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Reduced or limited speech output.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/spider_angioma -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/spider_angioma">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/skin_finding"/>
        <Example_1>spider telangiectasis</Example_1>
        <synonym_1>spider naevus</synonym_1>
        <synonym_2>spider angiomata</synonym_2>
        <synonym_3>spider naevi</synonym_3>
        <untitled-ontology-57:CUI>C0085666</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Skin</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">195382003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A spider angioma or spider naevus (plural spider naevi) is a type of telangiectasis[2] (swollen blood vessels) found slightly beneath the skin surface, often containing a central red spot and reddish extensions which radiate outwards like a spider&apos;s web. They are common and may be benign, presenting in around 10–15% of healthy adults and young children.[3] However, having more than three spider angiomas is likely to be abnormal and may be a sign of liver disease. It also suggests the probability of esophageal varices.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/spinal_injury -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/spinal_injury">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/trauma"/>
        <untitled-ontology-57:CUI>C0037937</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">262521009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>damage inflicted on the vertebral column as the direct or indirect result of an external force, with or without disruption of structural continuity.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/staring_episodes_during_seizures -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/staring_episodes_during_seizures">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/seizure"/>
        <untitled-ontology-57:CUI>C1969687</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>The occurrence of staring with a seizure episode.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/static_encephalopathy -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/static_encephalopathy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/encephalopathy"/>
        <untitled-ontology-57:CUI>C3662068</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">47311000119103</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>AS brain disease or impairment that is fixed and unchanging over time.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/stereognosis_impaired -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/stereognosis_impaired">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/agnosia_tactile"/>
        <synonym_1>astereognosis</synonym_1>
        <untitled-ontology-57:CUI>C0437345</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">163754003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Inability to recognize the form of objects by touch without visual input. That is, an impairment in the recognition of objects based only on based on the texture, size, weight and three-dimensional form of the object in the absence of any major somatosensory deficit.</rdfs:isDefinedBy>
        <rdfs:seeAlso>asterognosis</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/stocking_sensory_loss -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/stocking_sensory_loss">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/decreased_tactile_sensation_in_distal_extremities_glove_and_stocking"/>
        <synonym_1>stocking anesthesia</synonym_1>
        <untitled-ontology-57:CUI>C0277852</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Sensory</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">66085007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Sensory loss in the foot as if one is wearing a stocking.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/stooped_posture -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/stooped_posture">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#Parkinsonian_features"/>
        <Example_1>The posture was stooped.</Example_1>
        <Example_2>Bent over.</Example_2>
        <Example_3>Stooped over.</Example_3>
        <untitled-ontology-57:CUI>C4476759</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">87068006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A habitual positioning of the body with the head and upper back bent forward</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/strabismus -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/strabismus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysconjugate_gaze"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0000486</HPO>
        <untitled-ontology-57:CUI>C0038379</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22066006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Strabismus (also known as squint) is a condition in which the eyes are not properly aligned with each other.</rdfs:isDefinedBy>
        <rdfs:seeAlso>squint; heterotropia</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/straight_leg_raising_reduced -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/straight_leg_raising_reduced">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/straight_leg_raising_test_positive"/>
        <untitled-ontology-57:CUI>C0575461</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Sensory</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">298687002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>With patient lying comfortably on his or her back, the examiner gently life the extended leg off the examination table.  The patient reports when they experience low back pain or pain radiating down the leg</rdfs:isDefinedBy>
        <rdfs:seeAlso>positive_straight_leg_raising_test; Laseque_sign</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/straight_leg_raising_test_positive -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/straight_leg_raising_test_positive">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sensory_finding"/>
        <untitled-ontology-57:CUI>C0241261</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Sensory</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>With the patient lying down on his or her back on an examination table or exam floor, the examiner lifts the patient&apos;s leg while the knee is straight.If the patient experiences sciatic pain, and more specifically pain radiating down the leg (radiculopathy), when the straight leg is at an angle of between 30 and 70 degrees, then the test is positive and a herniated disk is a possible cause of the pain. A negative test suggests a likely different cause for back pain. A positive straight leg test reproduces radiating leg pain. If it only causes back pain, then the test is negative.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/stuttering -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/stuttering">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_speech_fluency"/>
        <untitled-ontology-57:CUI>C0038506</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Disorder in which speech is involuntarily interrupted by hesitations, repetitions, and spasms of the muscles involved in breathing or vocalization.</rdfs:isDefinedBy>
        <rdfs:seeAlso>dysfluency</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/subacute_onset -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/subacute_onset">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#onset"/>
        <Example_1>Less than acute onset.</Example_1>
        <Example_2>Onset over days to weeks.</Example_2>
        <Example_3>subacute onset.</Example_3>
        <untitled-ontology-57:CUI>C1298635</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Onset</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19939008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Somewhat rapid onset and change of disease manifestations.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/subungual_fibroma -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/subungual_fibroma">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/skin_finding"/>
        <Example_1>fibromata below finger nails</Example_1>
        <Example_2>fibromata below toe nails</Example_2>
        <untitled-ontology-57:CUI>C0266003</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Skin</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">39295002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The presence of fibromata beneath finger or toenails</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sucking_reflex_present -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sucking_reflex_present">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#frontal_release_signs"/>
        <untitled-ontology-57:CUI>C0576505</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">299756004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The sucking reflex is elicited by lightly touching the lips causing sucking movements of the lips and tongue.  It is normal in infants but abnormal in adults.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/suicidal -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/suicidal">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/depressed"/>
        <untitled-ontology-57:CUI>C0438696</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">267073005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>deeply unhappy or depressed and likely to commit suicide</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/swallowing_reflex_absent -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/swallowing_reflex_absent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cranial_nerve_reflex_finding"/>
        <untitled-ontology-57:CUI>C0576509</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">299760001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The swallowing reflex is one phase of the swallow which is under reflexive or involuntary control. This stage of the swallow begins after food which has been masticated has been gathered together in the mouth and formed into a bolus which is passed from the posterior tongue through the faucial arches</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/symptom -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/symptom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#sign"/>
        <untitled-ontology-57:CUI>C1457887</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Top</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Usually a complaint by the patient that is indicative of a disease process.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/syncope -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/syncope">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/consitutitional_symptoms"/>
        <synonym_1>fainting</synonym_1>
        <synonym_2>faint</synonym_2>
        <synonym_3>black out</synonym_3>
        <untitled-ontology-57:CUI>C0039070</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>temporary loss of consciousness caused by a fall in blood pressure.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tactile_extinction -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tactile_extinction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/extinction"/>
        <untitled-ontology-57:CUI>C0278135</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Failure to respond to tactile stimuli on one side of the body when both sides are touched simultaneously</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tactile_inattention -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tactile_inattention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/extinction_and_neglect"/>
        <untitled-ontology-57:CUI>C2039768</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Related to tactile extinction, in which there is relative inattention to tactile stimulation on one side of the body.</rdfs:isDefinedBy>
        <rdfs:seeAlso>extinction</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tangential_thinking -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tangential_thinking">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/thought_process_finding"/>
        <untitled-ontology-57:CUI>C0558067</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">74396008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Tangential thinking occurs when someone moves from thought to thought but never seems to get to the main point. Instead, the thoughts are somewhat connected but in a superficial or tangential way.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tardive_dyskinesia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tardive_dyskinesia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dyskinesia"/>
        <untitled-ontology-57:CUI>C0686347</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">102449007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>iatrogenic extrapyramidal disorder produced by long-term administration of antipsychotic drugs; characterized by oral/lingual/buccal dyskinesias and choreoathetoid movements of the extremities.</rdfs:isDefinedBy>
        <rdfs:seeAlso>tardive_dystonia</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tearing -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tearing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/visual_symptoms"/>
        <untitled-ontology-57:CUI>C0423153</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">193982009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Excessive flow of tears from the eye.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/temporary_visual_disturbance -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/temporary_visual_disturbance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/transient_neurological_symptoms"/>
        <Example_1>transient blindness</Example_1>
        <Example_2>temporary blindness</Example_2>
        <synonym_1>transient visual symptoms</synonym_1>
        <synonym_2>temporary vision problems</synonym_2>
        <untitled-ontology-57:CUI>C0422964</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">162279009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A temporary and reversible visual disturbance.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tendency_to_fall -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tendency_to_fall">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/falls"/>
        <Example_1>Tends to fall.</Example_1>
        <untitled-ontology-57:CUI>C2830327</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Poor balance such that individual has a tendency to fall to the ground.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tender_temporal_artery -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tender_temporal_artery">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain"/>
        <untitled-ontology-57:CUI>C2055674</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Pain on palpation of the temporal arteries, may suggest a diagnosis of temporal arteritis.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/thenar_eminence_atrophy -->

