    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/thought_process_finding -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/thought_process_finding">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#abnormal_behavior"/>
        <untitled-ontology-57:CUI>C1286920</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">365252004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Thought disorder is a disorganized way of thinking that leads to abnormal ways of expressing language when speaking and writing. It&apos;s one of the primary symptoms of schizophrenia, but it may be present in other mental disorders such as mania and depression</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/threatening_behavior -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/threatening_behavior">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#abnormal_behavior"/>
        <untitled-ontology-57:CUI>C0562573</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">284614009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Behavior that is having a hostile or deliberately frightening quality or manner.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tic -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abnormal_involuntary_movement"/>
        <Example_1>Tics are sudden twitches, movements, or sounds that people do repeatedly.</Example_1>
        <Example_1>habitual motor spasm</Example_1>
        <Example_2>habitual motor twitch</Example_2>
        <untitled-ontology-57:CUI>C0040188</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">568005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Disorders characterized by recurrent TICS that may interfere with speech and other activities. Tics are sudden, rapid, nonrhythmic, stereotyped motor movements or vocalizations which may be exacerbated by stress and are generally attenuated during absorbing activities. Tic disorders are distinguished from conditions which feature other types of abnormal movements that may accompany another another condition.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tic_facial -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tic_facial">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tic"/>
        <Example_1>tic of face</Example_1>
        <Example_2>facial twitch</Example_2>
        <Example_3>facial tic disorder</Example_3>
        <untitled-ontology-57:CUI>C0338467</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">230335009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A habitural motor twitching invoiving facial muscles.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tic_motor -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tic_motor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tic"/>
        <Example_1>tic motor</Example_1>
        <untitled-ontology-57:CUI>C0751900</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A tic affecting muscle movement</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tic_vocal -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tic_vocal">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tic_motor"/>
        <Example_1>Uncontrolled verbal utterances.</Example_1>
        <Example_2>Involuntary vocal utterances.</Example_2>
        <untitled-ontology-57:CUI>C0751901</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Vocal tics are sounds uttered unintentionally.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tinnitus -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tinnitus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ENT_symptoms"/>
        <Example_1>buzzing in ear.</Example_1>
        <Example_2>ringing in ear.</Example_2>
        <untitled-ontology-57:CUI>C0040264</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">60862001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>symptom of hearing disorder characterized by the sensation of buzzing, ringing, clicking, pulsations, roaring or other noises in the ear.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tinnitus_left_ear -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tinnitus_left_ear">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tinnitus"/>
        <untitled-ontology-57:CUI>C2116482</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4841000119106</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Tinnitus localized to the left ear.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tinnitus_pulsatile -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tinnitus_pulsatile">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tinnitus"/>
        <untitled-ontology-57:CUI>C0751559</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Pulsatile tinnitus is generally classified a kind of objective tinnitus, meaning that it is not only audible to the patient but also to the examiner on auscultation of the auditory canal and/or of surrounding structures with use of an auscultation tube or stethoscope. Usually, pulsatile tinnitus is heard as a lower pitched thumping or booming, a rougher blowing sound which is coincidental with respiration, or as a clicking, higher pitched rhythmic sensation. Pulsatile tinnitus may be associated with vascular abnormalities such as arterioevenous shunts or glomus tumors or the jugular vein, arterial bruits related to a high-riding carotid artery (close to the auditory areas) or carotid stenosis, or venous abnormalities such as a dehiscent jugular bulb or to hypertension. Finally, in some patients, mechanical abnormalities such a spatulous eustachian tubes, palatomyoclonus (small spasms of muscles in the soft palate area), or idiopathic stapedial muscle spasm may represent the underlying cause of pulsatile tinnitus.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tinnitus_right_ear -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tinnitus_right_ear">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tinnitus"/>
        <untitled-ontology-57:CUI>C2116484</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Tinnitus localilzed to the right ear.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/titubation -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/titubation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor"/>
        <Example_1>a tremor of the head and sometimes trunk, commonly seen in cerebellar disease.</Example_1>
        <Example_2>Nodding movements of the head</Example_2>
        <Example_3>Tremor of the head.</Example_3>
        <untitled-ontology-57:CUI>C0231690</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">78691002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Nodding movement of the head or body.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tongue_is_weak -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tongue_is_weak">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tongue_weakness"/>
        <synonym_1>tongue weakness</synonym_1>
        <synonym_2>reduced strength of the tongue.</synonym_2>
        <untitled-ontology-57:CUI>C0235075</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A tongue that is weak and difficult to move or protrude from the mouth.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tongue_weakness -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tongue_weakness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_moving_tongue"/>
        <Example_1>weak tongue</Example_1>
        <untitled-ontology-57:CUI>C3277232</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Weakness  of the tongue.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tonic_clonic_seizure -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tonic_clonic_seizure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/seizure"/>
        <untitled-ontology-57:CUI>C0494475</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Tonic-clonic seizure: The classic type of epileptic seizure consisting of two phases to a tonic-clonic seizure -- the tonic phase and the clonic phase. In the tonic phase the body becomes entire rigid, and in the clonic phase there is uncontrolled jerking. Tonic-clonic seizures may or may not be preceded by an aura, and are often followed by headache, confusion, and sleep. They may last mere seconds, or continue for several minutes.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tonic_pupil -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tonic_pupil">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pupil_finding"/>
        <Example_1>tonic pupil</Example_1>
        <Example_3>tonic pupil reaction</Example_3>
        <synonym_1>Adie pupil</synonym_1>
        <synonym_2>Adies tonic pupil</synonym_2>
        <synonym_3>pupilotonia</synonym_3>
        <untitled-ontology-57:CUI>C0040416</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24225004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Either no or sluggish response to light (both direct and consensual responses.  Thought to be caused from denervation in the postganglionic parasympathetic nerve.  Associated with Holmes-Adie syndrome described with Adie&apos;s pupil and absent deep tendon reflexes. Overall, this is a benign process (including Holmes-Adie syndrome)</rdfs:isDefinedBy>
        <rdfs:seeAlso>Adie_pupil</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/torticollis -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/torticollis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#focal_dystonia"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0000473</HPO>
        <synonym_1>wry neck</synonym_1>
        <untitled-ontology-57:CUI>C0040485</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">270476009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Involuntary contractions of the neck musculature resulting in an abnormal posture of or abnormal movements of the head. A symptom, not a disease, of a twisted neck. In most instances, the head is tipped toward one side and the chin rotated toward the other. The involuntary muscle contractions in the neck region of patients with torticollis can be due to congenital defects, trauma, inflammation, tumors, and neurological or other factors</rdfs:isDefinedBy>
        <rdfs:seeAlso>wry_neck</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/total_third_nerve_palsy -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/total_third_nerve_palsy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/3rd_nerve_palsy"/>
        <untitled-ontology-57:CUI>C0028866</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">388980004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Diseases of the oculomotor nerve or nucleus that result in weakness or paralysis of the superior rectus, inferior rectus, medial rectus, inferior oblique, or levator palpebrae muscles, or impaired parasympathetic innervation to the pupil. With a complete oculomotor palsy, the eyelid will be paralyzed, the eye will be in an abducted and inferior position, and the pupil will be markedly dilated. Commonly associated conditions include neoplasms, CRANIOCEREBRAL TRAUMA, ischemia (especially in association with DIABETES MELLITUS), and aneurysmal compression.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/transcortical_motor_aphasia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/transcortical_motor_aphasia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_transcortical"/>
        <untitled-ontology-57:CUI>C0454562</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">229655002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A form of expressive aphasia that resembles Broca aphasia with a retained ability to repeat words and phrases.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/transcortical_sensory_aphasia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/transcortical_sensory_aphasia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_transcortical"/>
        <untitled-ontology-57:CUI>C0454568</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">229658000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A form of fluent aphasia that resembles Wernicke aphasia with retained ability to repeat words and phrases.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/transient_amnesia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/transient_amnesia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/transient_neurological_symptoms"/>
        <Example_1>temporary amnesia</Example_1>
        <Example_2>reversible memory loss</Example_2>
        <Example_3>transient memory impairment</Example_3>
        <untitled-ontology-57:CUI>C0233796</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">307413004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A temporary and reversible loss of memory.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/transient_aphasia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/transient_aphasia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/transient_neurological_symptoms"/>
        <Example_1>transient loss of speech</Example_1>
        <Example_2>transient aphasia</Example_2>
        <Example_3>temporary aphasia</Example_3>
        <untitled-ontology-57:CUI>C4524123</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A transient disturbance of speech that resolves within seconds to hours.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/transient_disturbance_of_consciousness -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/transient_disturbance_of_consciousness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/transient_neurological_symptoms"/>
        <Example_1>temporary loss of consciousness</Example_1>
        <Example_2>reversible loss of consciousness</Example_2>
        <untitled-ontology-57:CUI>C0858596</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A transient loss of consciousness that resolves within seconds to minutes.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/transient_limb_weakness -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/transient_limb_weakness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/transient_neurological_symptoms"/>
        <Example_1>temporary weakness</Example_1>
        <Example_2>transient weakness</Example_2>
        <Example_3>transient hemiparesis</Example_3>
        <untitled-ontology-57:CUI>C2183888</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Transient weakness of an arm or leg that quickly resolves.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/transient_loss_of_consciousness -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/transient_loss_of_consciousness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/transient_disturbance_of_consciousness"/>
        <untitled-ontology-57:CUI>C4087400</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>An alteration in consciousness that resolves within seconds to minutes.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/transient_neurological_symptoms -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/transient_neurological_symptoms">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/symptom"/>
        <Example_1>temporary neurologic symptoms</Example_1>
        <Example_2>transient neurologic disturbances</Example_2>
        <untitled-ontology-57:CUI>C0581882</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">162335008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Transient neurological symptoms that resolve within seconds or minutes such as amnesia, visual loss, aphasia, weakness, numbness, or tingling.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/transient_visual_loss -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/transient_visual_loss">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/amaurosis_fugax"/>
        <untitled-ontology-57:CUI>C1142390</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">88032003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A transient visual disturbance that is typically caused by a circulatory, ocular or neurological underlying condition</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/trauma -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/trauma">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/symptom"/>
        <Example_1>trauma</Example_1>
        <Example_2>traumatic injury</Example_2>
        <Example_3>injury due to trauma</Example_3>
        <untitled-ontology-57:CUI>C3714660</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">417746004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Damage inflicted on the body as the direct or indirect result of an external force, with or without disruption of structural continuity.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abnormal_involuntary_movement"/>
        <untitled-ontology-57:CUI>C0040822</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">26079004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An unintentional, oscillating to-and-fro muscle movement about a joint axis. Tremors are classified by their etiology (familial, parkinsonian, etc.), their location (head, limb, etc.), frequency (slow or fast), or eleciting factor (rest, action, etc.),</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_action -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_action">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0002345</HPO>
        <synonym_1>kinetic tremor</synonym_1>
        <synonym_2>intention tremor</synonym_2>
        <untitled-ontology-57:CUI>C0234376</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30721006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A tremor present when the limbs are active, either when outstretched in a certain position or throughout a voluntary movement.</rdfs:isDefinedBy>
        <rdfs:seeAlso>intention_tremor; cerebellar_tremor</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_essential -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_essential">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_fine"/>
        <untitled-ontology-57:CUI>C0270736</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>ET is a highly variable disorder. Age of onset, progression, tremor distribution, and severity can vary greatly from one individual to another. The characteristic symptom of ET is tremor, which most often occurs as involuntary shaking or trembling of the hands and/or arms. In some cases, tremor of the hands or arms occurs as an isolated finding. Usually, both of the hands or arms are affected, although one side of the body is generally affected more than the other. Tremor can also affect the head (i.e., neck), voice, jaw, or tongue.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_familial -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_familial">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_essential"/>
        <untitled-ontology-57:CUI>C0393615</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A form of essential tremor that occurs in families, probably hereditary in causation. The inherited variety of essential tremor (familial tremor) is an autosomal dominant disorder. A defective gene from just one parent is needed to pass on the condition. If you have a parent with a genetic mutation for essential tremor, you have a 50 percent chance of developing the disorder yourself</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_fine -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_fine">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor"/>
        <untitled-ontology-57:CUI>C0234373</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">42800007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Physiologic tremor is a very-low-amplitude fine tremor (6 Hz-12 Hz) that is barely visible to the naked eye. It is present in every normal person while maintaining a posture or movement. Neurologic examination results of patients with physiologic tremor are usually normal.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_finger -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_finger">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_in_hands"/>
        <untitled-ontology-57:CUI>C0239601</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Tremor that is limited to the fingers.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_in_hands -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_in_hands">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#limb_tremor"/>
        <untitled-ontology-57:CUI>C0239842</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Tremor that is limited to the hands.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_intention -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_intention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_action"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0002080</HPO>
        <untitled-ontology-57:CUI>C4551520</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A tremor that becomes more pronounced with action or intention to make a movement.  Compare to resting tremor or postural tremor.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_mild -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_mild">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor"/>
        <untitled-ontology-57:CUI>C3553819</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Tremor that is mild in severity.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_postural -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_postural">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0002174</HPO>
        <untitled-ontology-57:CUI>C1865820</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Postural tremor occurs when a person maintains a position against gravity, such as holding the arms outstretched.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_resting -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_resting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0002322</HPO>
        <untitled-ontology-57:CUI>C0234379</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">25082004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A resting tremor occurs when muscles are at rest and becomes less noticeable or disappears when the affected muscles are moved. Resting tremors are often slow and coarse</rdfs:isDefinedBy>
        <rdfs:seeAlso>pill rolling tremor</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_senile -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_senile">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor"/>
        <untitled-ontology-57:CUI>C0149840</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">112109002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Accentuated physiological tremor worsening with age. senile tremor one due to the infirmities of old age.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_voice -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_voice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor"/>
        <untitled-ontology-57:CUI>C0234808</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">55938009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Trembling of one or more muscles of phonation, resulting in an unsteady voice.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unable_to_protrude_tongue -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unable_to_protrude_tongue">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tongue_weakness"/>
        <untitled-ontology-57:CUI>C0426983</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Weakness of the tongue that prevents tongue protrusion.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unable_to_read -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unable_to_read">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/alexia"/>
        <Example_1>Impaired reading</Example_1>
        <Example_2>Cannot read.</Example_2>
        <untitled-ontology-57:CUI>C0586741</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">309252004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The inability to read or understand what is read.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unable_to_stand -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unable_to_stand">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_of_equilibrium"/>
        <Example_1>Cannot stand.</Example_1>
        <Example_2>Not able to stand.</Example_2>
        <Example_3>Cannor stand unassisted.</Example_3>
        <untitled-ontology-57:CUI>C0560885</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">161903000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>When patient is unable to stand unassisted.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unable_to_talk -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unable_to_talk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/speech_impairment"/>
        <Example_1>no speech</Example_1>
        <Example_2>unable to speak</Example_2>
        <synonym_2>muite</synonym_2>
        <untitled-ontology-57:CUI>C0278249</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">286375007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An inability to speak.</rdfs:isDefinedBy>
        <rdfs:seeAlso>mute; no_speech</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unconscious -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unconscious">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unresponsive"/>
        <Example_1>unconscious</Example_1>
        <Example_2>unconsciousness</Example_2>
        <untitled-ontology-57:CUI>C0041657</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">418107008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Loss of the ability to maintain awareness of self and environment combined with markedly reduced responsiveness to environmental stimuli.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/uncooperative -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/uncooperative">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#abnormal_behavior"/>
        <Example_1>Lacking cooperation</Example_1>
        <synonym_1>not cooperative</synonym_1>
        <synonym_2>uncooperative</synonym_2>
        <untitled-ontology-57:CUI>C0424350</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">248042003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>not willing to do what someone wants or asks for; not cooperative</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unilateral_neglect -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unilateral_neglect">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hemisensory_neglect"/>
        <untitled-ontology-57:CUI>C0150088</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">32422007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Impairment in sensory and motor response, mental representation, and spatial attention of the body, and the corresponding environment, characterized by inattention to one side and overattention to the opposite side. Left-side neglect is more severe and persistent than right-side neglect.</rdfs:isDefinedBy>
        <rdfs:seeAlso>hemineglect</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unkempt -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unkempt">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/poor_hygiene"/>
        <Example_1>Not neat.</Example_1>
        <synonym_1>unkempt.</synonym_1>
        <synonym_2>disheveled</synonym_2>
        <synonym_3>untidy</synonym_3>
        <untitled-ontology-57:CUI>C0233429</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">46017004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>deficient in order or neatness, untidy, disheveled</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unrefreshed_by_sleep -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unrefreshed_by_sleep">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#sleep_disturbance"/>
        <untitled-ontology-57:CUI>C0424571</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">248260009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Unrefreshing sleep or nonrestorative sleep is a light sleep that, even after a full night, doesn&apos;t leave you rested.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unresponsive -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unresponsive">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_alertness"/>
        <untitled-ontology-57:CUI>C0237284</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">422768004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A state of reduced alertness in which the patient fails to respond to verbal or painful stimuli.</rdfs:isDefinedBy>
        <rdfs:seeAlso>non_responsive; coma</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unresponsive_to_painful_stimuli -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unresponsive_to_painful_stimuli">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unresponsive_to_stimuli"/>
        <untitled-ontology-57:CUI>C1262130</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>decreased level of consciousness with not response to painful stimuli.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unresponsive_to_stimuli -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unresponsive_to_stimuli">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unresponsiveness"/>
        <untitled-ontology-57:CUI>C0857494</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Depressed level of consciousness with not response to stimuli.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unresponsive_to_verbal_stimuli -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unresponsive_to_verbal_stimuli">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unresponsive_to_stimuli"/>
        <untitled-ontology-57:CUI>C1504376</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Depressed consciousness with decreased response to verbal stimuli.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unresponsiveness -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unresponsiveness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unresponsive"/>
        <untitled-ontology-57:CUI>C0241526</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Depressed level of consciousness with unresponsiveness to stimuli.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unsteadiness -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unsteadiness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_of_equilibrium"/>
        <Example_1>Swaying.</Example_1>
        <Example_2>Sways.</Example_2>
        <Example_3>Unsteady.</Example_3>
        <untitled-ontology-57:CUI>C0427117</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">249990003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Unsteady when standing is characterized by swaying or falling of the patient when standing upright.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/upper_facial_weakness -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/upper_facial_weakness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_paresis"/>
        <untitled-ontology-57:CUI>C0575058</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">298281008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Weakness involving primarily the muscle of the upper face.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/upper_limb_dysmetria -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/upper_limb_dysmetria">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysmetria"/>
        <untitled-ontology-57:CUI>C3280708</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Dysmetria: refers to a lack of coordination of movement. Clinically this results in the patient missing the target by over/undershooting.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/upper_limb_hyperreflexia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/upper_limb_hyperreflexia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/brisk_tendon_reflex"/>
        <untitled-ontology-57:CUI>C1843175</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>increased reflexes in the upper extremities.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/upper_limb_nerve_lesion -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/upper_limb_nerve_lesion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sensory_loss_in_nerve_distribution"/>
        <untitled-ontology-57:CUI>C0574717</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Sensory</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A disorder of nerves in the arms.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/upper_limb_spasticity -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/upper_limb_spasticity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/limb_spasticity"/>
        <untitled-ontology-57:CUI>C1273957</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">394680009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Increased tone and spasticity in the arm.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/urinary_frequency -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/urinary_frequency">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/urinary_symptoms"/>
        <Example_1>frequent urination</Example_1>
        <synonym_1>polyuria</synonym_1>
        <untitled-ontology-57:CUI>C0042023</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">162116003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Urination at short intervals; it may result from increased urine formation, decreased bladder capacity, or lower urinary tract irritation.</rdfs:isDefinedBy>
        <rdfs:seeAlso>polyuria</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/urinary_incontinence -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/urinary_incontinence">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#incontinence"/>
        <Example_1>involuntary urination.</Example_1>
        <Example_2>urinary incontinence.</Example_2>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0000020</HPO>
        <untitled-ontology-57:CUI>C0042024</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">165232002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Loss of the ability to control the urinary bladder leading to involuntary urination.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/urinary_retention -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/urinary_retention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/urinary_symptoms"/>
        <Example_1>urinary retention.</Example_1>
        <Example_2>Inability to urinate</Example_2>
        <Example_3>Inability to empty urinary bladder completely.</Example_3>
        <untitled-ontology-57:CUI>C0080274</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">130951007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Inability to completely empty the urinary bladder during the process of urination</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/urinary_symptoms -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/urinary_symptoms">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/symptom"/>
        <untitled-ontology-57:CUI>C0426359</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">249274008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Symptoms related to the kidney or bladder including incontinence, retention, frequency, and burning of urine.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/vagal_hoarseness -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/vagal_hoarseness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hoarseness"/>
        <untitled-ontology-57:CUI>C0270882</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">45655002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Hoarseness refers to a change in the pitch or quality of the voice, with the voice sounding weak, very breathy, scratchy, or husky.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/verbal_paraphasia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/verbal_paraphasia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/paraphasia"/>
        <synonym_1>semantic paraphasia</synonym_1>
        <untitled-ontology-57:CUI>C0234491</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4381006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A word substitution error in which a semantically related word is substituted for the desired word.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/vertical_diplopia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/vertical_diplopia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/diplopia"/>
        <untitled-ontology-57:CUI>C0751079</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Double vision in which images are above and below in a vertical axis.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/vertigo -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/vertigo">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ENT_symptoms"/>
        <Example_1>spinning sensation.</Example_1>
        <Example_2>turning sensation.</Example_2>
        <Example_3>Sensation of a turning movement.</Example_3>
        <untitled-ontology-57:CUI>C0042571</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Vertigo is a symptom, rather than a condition itself. It&apos;s the sensation that you, or the environment around you, is moving or spinning</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/vestibulo-ocular_reflex_abnormal -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/vestibulo-ocular_reflex_abnormal">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cranial_nerve_reflex_finding"/>
        <synonym_1>Absent Dolls head reflex</synonym_1>
        <synonym_2>abnormal dolls head maneuver</synonym_2>
        <untitled-ontology-57:CUI>C0576567</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">299818006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An abnormality of the vestibulo-ocular reflex (VOR). The VOR attempts to keep the image stable on the retina. Ideally passive or active head movements in one direction are compensated for by eye movements of equal magnitude.</rdfs:isDefinedBy>
        <rdfs:seeAlso>Dolls_head_reflex_absent; Dolls_head_reflex_abnormal</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/vibration_sense_absent -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/vibration_sense_absent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_vibratory_sense"/>
        <untitled-ontology-57:CUI>C0558843</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Sensory</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">274816000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Loss of ability to sense vibration such as generated by a tuning fork.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/visual_field_defect -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/visual_field_defect">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_vision"/>
        <untitled-ontology-57:CUI>C3887875</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12184005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An absolute or relative reduction in the extent of the normal field of vision</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/visual_gaze_preference -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/visual_gaze_preference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/limited_eye_movements"/>
        <untitled-ontology-57:CUI>C4476823</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A tendency for the eyes to gaze in one direction, although not a complete gaze palsy</rdfs:isDefinedBy>
        <rdfs:seeAlso>gaze preference</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/visual_inattention -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/visual_inattention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/extinction_and_neglect"/>
        <untitled-ontology-57:CUI>C1856977</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Relative inattention to visual stimuli in one field of vision.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/visual_neglect -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/visual_neglect">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hemisensory_neglect"/>
        <untitled-ontology-57:CUI>C0423000</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">246670009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Neglect of stimuli and failure to respond to stimuli in one field of vision.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/visual_obscuration -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/visual_obscuration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/visual_field_defect"/>
        <untitled-ontology-57:CUI>C1321318</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">404666000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Visual obscurations are transient losses (“graying out”) of vision last- ing a few seconds, occurring in the context of raised intracranial pres- sure (ICP), and especially associated with activities known to elevate ICP (coughing, sneezing, bending down, straining at stool) and relieved by their cessation.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/visual_symptoms -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/visual_symptoms">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/symptom"/>
        <untitled-ontology-57:CUI>C0422943</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Symptoms referable to the eyes and visual system.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/vivid_dreams -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/vivid_dreams">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#sleep_disturbance"/>
        <untitled-ontology-57:CUI>C1563052</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">416593000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>We spend about two hours per night dreaming. Many people don’t remember their dreams or have only a vague recollection of what took place. However, sometimes, you may wake up with clear memories of your dreams. The content of a vivid dream can cause feelings of joy or comfort. You may even find yourself waking up wishing you could return to the dream. Vivid dreams may be fantastical, leaving you wondering how your brain could have conjured such a strange scenario. Vivid dreams can also be upsetting or disturbing, and in some cases may interfere with experiencing quality sleep.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/vocal_cord_palsy -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/vocal_cord_palsy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cranial_nerve_9_10_finding"/>
        <untitled-ontology-57:CUI>C0042928</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">302912005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A loss of the ability to move the vocal folds.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/voice_change -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/voice_change">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/speech_impairment"/>
        <Example_1>Speech that is changed in rate, volume, or articulation</Example_1>
        <untitled-ontology-57:CUI>C0518179</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">274657005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A disorder characterized by a change in the sound and/or speed of the voice.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/vomiting -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/vomiting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/GI_symptoms"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0002013</HPO>
        <synonym_1>vomit</synonym_1>
        <synonym_2>emesis</synonym_2>
        <untitled-ontology-57:CUI>C0042963</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">249497008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>eject matter from the stomach through the mouth.</rdfs:isDefinedBy>
        <rdfs:seeAlso>emesis</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/wasting_of_tongue -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/wasting_of_tongue">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/denervation_atrophy_of_tongue"/>
        <synonym_1>atrophy of tongue muscle.</synonym_1>
        <synonym_2>denervation atrophy of tongue</synonym_2>
        <synonym_3>wasting of the tongue</synonym_3>
        <untitled-ontology-57:CUI>C0426494</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">249382006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Atrophy of the tongue muscle, usually due to denervation.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weak_cough -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weak_cough">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cranial_nerve_9_10_finding"/>
        <synonym_1>ineffective cough</synonym_1>
        <untitled-ontology-57:CUI>C2202983</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">248590003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An ineffective cough is when the child cannot clear the mucus or dust. This can cause problems such as increasing the chance of infection and making it difficult for the child to breathe</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weak_left_hand -->

