        <untitled-ontology-57:CUI>C0021270</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Age</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">133931009</untitled-ontology-57:SNOMED>
