        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dyspnea"/>
        <synonym_1>shortness of breath on exertion</synonym_1>
        <synonym_2>shortness of breath on activity</synonym_2>
        <untitled-ontology-57:CUI>C0231807</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>breathlessness or shortness of breath; difficult or labored respiration that occurs with activity or exertion.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#dyspneic -->

