        <untitled-ontology-57:CUI>C0234164</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">49768006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Pointing past the target on the finger to nose test.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/patellar_clonus -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/patellar_clonus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/clonus"/>
        <Example_1>knee clonus</Example_1>
        <Example_2>patellar clonus.</Example_2>
        <untitled-ontology-57:CUI>C0520823</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">54360005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Clonus is a set of involuntary and rhythmic muscular contractions and relaxations. Clonus at the knee or patella.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/percussion_myotonia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/percussion_myotonia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/myotonia"/>
        <Example_1>Transient swelling of muscle caused by percussion.</Example_1>
        <Example_2>Prolonged contraction of muscle caused by percussion.</Example_2>
        <Example_3>Persisent muscle contraction upon percussion.</Example_3>
        <untitled-ontology-57:CUI>C0751359</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A localized myotonic contraction in a muscle in reaction to percussion (tapping with the examiner&apos;s finger, a rubber percussion hammer, or a similar object).</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/periodic_leg_movements_of_sleep -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/periodic_leg_movements_of_sleep">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#sleep_disturbance"/>
        <untitled-ontology-57:CUI>C2919187</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">445140006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Periodic limb movement disorder (PLMD) is a rare sleep disorder characterized by periodic, repetitive movements of the legs and feet during sleep1. In some cases, the disorder also affects the arms. If you have PLMD or sleep with someone who has PLMD, you may recognize these movements as brief muscle twitches, jerking movements, or an upward flexing of the feet. PLMD can disrupt sleep and co-occur with other sleep disorders, including restless legs syndrome and narcolepsy</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/peroneal_muscle_atrophy -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/peroneal_muscle_atrophy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/lower_limb_amyotrophy"/>
        <untitled-ontology-57:CUI>C1389118</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Atrophy of the peroneal muscle in the lower leg.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/perseveration -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/perseveration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_of_executive_functions"/>
        <untitled-ontology-57:CUI>C0233651</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">44515000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Persistent repetition of a response to different and perhaps inappropriate stimuli which may be due to a refusal or an inability to interrupt one&apos;s behavior or to change from one task to another.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/personality_change -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/personality_change">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/altered_behavior"/>
        <Example_1>Change in personality.</Example_1>
        <Example_2>personality changed.</Example_2>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0000751</HPO>
        <untitled-ontology-57:CUI>C0240735</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">102943000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A disorder characterized by a conspicuous change in a person&apos;s behavior and thinking.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/petechiae -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/petechiae">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/skin_finding"/>
        <Example_1>pin point bleeding in the skin</Example_1>
        <Example_2>petechial hemorrhage</Example_2>
        <Example_3>petechial bleeding</Example_3>
        <untitled-ontology-57:CUI>C0031256</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Skin</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">50091001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Petechiae are pinpoint-sized reddish/purple spots, resembling a rash, that appear just under the skin or a mucous membrane when capillaries have ruptured and some superficial bleeding into the skin has happened. This term refers to an abnormally increased susceptibility to developing petechiae.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/phonophobia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/phonophobia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyperacusis"/>
        <synonym_1>discomfort with loud sounds</synonym_1>
        <untitled-ontology-57:CUI>C0751466</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">313387002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An abnormally heightened sensitivity to loud sounds</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/photophobia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/photophobia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abnormal_vision"/>
        <Example_1>Sensitivity to light.</Example_1>
        <Example_2>Bothered by light.</Example_2>
        <synonym_1>light sensitivity</synonym_1>
        <untitled-ontology-57:CUI>C0085636</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">409668002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Excessive sensitivity to light with the sensation of discomfort or pain in the eyes due to exposure to bright light.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/photopsia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/photopsia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abnormal_vision"/>
        <Example_1>flash of light</Example_1>
        <synonym_1>photopsia</synonym_1>
        <synonym_2>sparkle of light</synonym_2>
        <untitled-ontology-57:CUI>C0085635</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">56170001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>a flash or sparkle of light; Photopsia is the presence of perceived flashes of light in the field of vision.</rdfs:isDefinedBy>
        <rdfs:seeAlso>scintillation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/plantar_response -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/plantar_response">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/reflex_finding"/>
        <untitled-ontology-57:CUI>C0437428</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">163852006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A reflex elicited by stroking the plantar surface of the foot begining at the heel at the lateral edge and moving slowly towards the great toe.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pontine_one_and_one_half_syndrome -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pontine_one_and_one_half_syndrome">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gaze_palsy"/>
        <untitled-ontology-57:CUI>C1282373</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">314783008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>One-and-a-half syndrome is a disorder of horizontal ocular movement characterized by a lateral gaze palsy on looking toward the side of the lesion and INO on looking in the other direction. The location of the lesion is the paramedian pontine reticular formation or VI nerve nucleus.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/poor_balance -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/poor_balance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_of_equilibrium"/>
        <Example_1>impaired balance.</Example_1>
        <Example_2>bad balance.</Example_2>
        <Example_3>Diminished balance.</Example_3>
        <untitled-ontology-57:CUI>C0234964</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">249985001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Poor balance is an inability to stand upright.</rdfs:isDefinedBy>
        <rdfs:seeAlso>bad_balance; impaired_balance; imbalance</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/poor_coordination -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/poor_coordination">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/neuromuscular_symptoms"/>
        <synonym_1>lack of coordination</synonym_1>
        <synonym_2>poor coordination.</synonym_2>
        <untitled-ontology-57:CUI>C0563243</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>lack of coordination, especially the inability to use different parts of the body together smoothly and efficiently.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/poor_eye_contact -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/poor_eye_contact">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abnormal_affect"/>
        <untitled-ontology-57:CUI>C1445953</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">412786000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A person with eye contact anxiety may avoid making eye contact when talking to someone.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/poor_hygiene -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/poor_hygiene">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/altered_behavior"/>
        <Example_1>bad hygeine</Example_1>
        <Example_2>inadequate hygeine</Example_2>
        <Example_3>not attentive to self care.</Example_3>
        <untitled-ontology-57:CUI>C0745076</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Poor hygiene can be a sign of self-neglect, which is the inability or unwillingness to attend to one&apos;s personal needs. Poor hygiene often accompanies certain mental or emotional disorders, including severe depression and psychotic disorders. Dementia is another common cause of poor hygiene.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/poor_palatal_elevation -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/poor_palatal_elevation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_elevation_soft_palate"/>
        <untitled-ontology-57:CUI>C4227456</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Weakness of elevation of the soft palate.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/poor_visual_attention -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/poor_visual_attention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impairment_of_attention"/>
        <Example_1>impaired visual attention.</Example_1>
        <Example_2>Diminished visual attention.</Example_2>
        <untitled-ontology-57:CUI>C3553454</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Impaired visual attention, inattention to visual stimuli.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/port_wine_stain_nevus -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/port_wine_stain_nevus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/skin_finding"/>
        <Example_1>hemangioma in the skin</Example_1>
        <untitled-ontology-57:CUI>C0206733</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Skin</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">83343001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A dull red, firm, dome-shaped hemangioma, sharply demarcated from surrounding skin, usually located on the head and neck, which grows rapidly and generally undergoes regression and involution without scarring. It is caused by proliferation of immature capillary vessels in active stroma, and is usually present at birth or occurs within the first two or three months of life.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/primitive_reflex_finding -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/primitive_reflex_finding">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/reflex_finding"/>
        <synonym_1>frontal release reflexes</synonym_1>
        <synonym_2>frontal reflexes</synonym_2>
        <untitled-ontology-57:CUI>C1287652</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">366121000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Primitive reflexes are generally associated with frontal lobe injury to the brain and include grasping, rooting, sucking reflexes.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/profound_deafness -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/profound_deafness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/deafness"/>
        <untitled-ontology-57:CUI>C1864817</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A severe loss of hearing.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/progressive -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/progressive">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/course"/>
        <Example_1>progressing.</Example_1>
        <Example_2>Advancing.</Example_2>
        <Example_3>Worsening.</Example_3>
        <untitled-ontology-57:CUI>C0205329</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Course</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">252157006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Advancing in extent or severity.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pronator_drift -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pronator_drift">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_proximal_muscle"/>
        <Example_1>Downward drift of the arm when outstretched.</Example_1>
        <untitled-ontology-57:CUI>C1504476</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">428334004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Slight downward drift of the outstretched arms when held outward due to proximal weakness in the shoulder girdle.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/proptosis -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/proptosis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cranial_nerve_finding"/>
        <synonym_1>exopthalmos</synonym_1>
        <untitled-ontology-57:CUI>C0015300</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18265008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An eye that is protruding anterior to the plane of the face to a greater extent than is typical.  Also known as exophthalmos.</rdfs:isDefinedBy>
        <rdfs:seeAlso>exophthalmos</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/prosopagnosia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/prosopagnosia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/agnosia_visual"/>
        <untitled-ontology-57:CUI>C0234512</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18358003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The inability to recognize a familiar face or to learn to recognize new faces. This visual agnosia is most often associated with lesions involving the junctional regions between the temporal and occipital lobes. The majority of cases are associated with bilateral lesions, however unilateral damage to the right occipito-temporal cortex has also been associated with this condition</rdfs:isDefinedBy>
        <rdfs:seeAlso>face_agnosia; face_blindness</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/proximal_amyotrophy -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/proximal_amyotrophy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/muscle_atrophy"/>
        <untitled-ontology-57:CUI>C1850794</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Amyotrophy (muscular atrophy) affecting the proximal musculature</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/proximal_muscle_weakness_limb_girdle_distribution -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/proximal_muscle_weakness_limb_girdle_distribution">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_proximal_muscle"/>
        <Example_1>limb-girdle weakness</Example_1>
        <Example_2>proximal weakness in the shoulder and hip region.</Example_2>
        <Example_3>proximal weakness of the shoulder and hip muscles.</Example_3>
        <untitled-ontology-57:CUI>C2676697</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Proximal muscle weakness in the large muscles of the shoulder and girdle.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/proximal_weakness_of_the_lower_extremities -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/proximal_weakness_of_the_lower_extremities">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_proximal_muscle"/>
        <untitled-ontology-57:CUI>C2674839</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Proximal weakness of the large hip muscles.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pseudobulbar_palsy -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pseudobulbar_palsy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness"/>
        <Example_1>Weakness of the bulbar muscles.</Example_1>
        <Example_2>Weakness of the muscles innervated by the lower cranial nerves.</Example_2>
        <Example_3>Weakness in the muscles involved in swallowing and speaking causing dysarthria and dysphagia.</Example_3>
        <untitled-ontology-57:CUI>C0033790</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7379000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Bilateral impairment of the function of the cranial nerves 9-12, which control musculature involved in eating, swallowing, and speech. Pseudobulbar paralysis is characterized clinically by dysarthria, dysphonia, and dysphagia with bifacial paralysis, and may be accompanied by Pseudobulbar behavioral symptoms such as enforced crying and laughing.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pseudopapilledema -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pseudopapilledema">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/optic_disc_finding"/>
        <synonym_1>crowded optic disk</synonym_1>
        <untitled-ontology-57:CUI>C0155300</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">57138009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Apparent optic disc swelling in the absence of increased intracranial pressure</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pseudoptosis -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pseudoptosis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disorders_of_eyelid"/>
        <untitled-ontology-57:CUI>C0271312</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">58200004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Pseudoptosis is apparent but not true drooping of the eyelid (see ptosis). Pseudoptosis is typically unrelated to neurological or musculoskeletal defects of the eyelid. Pseudoptosis may be the result of abnormal size of the eye such as the absence of eye development (anophthalmos); a shrunken, non-functional eye (e.g., phthisis bulbi); a small eye (microphthalmos); and posterior placement of the eyeball (enophthalmos), which all present as apparent ptosis without defect to the eyelid mechanisms themselves. Abnormal growth or placement of eyelid tissue such as excessive loose skin of the eyelid (dermatochalasis), contralateral retraction of the eyelid, or prolapse of orbital fat (blepharochalasis) might also result in the pseudoptosis.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/psychogenic_vomiting -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/psychogenic_vomiting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/conversion_disorder"/>
        <untitled-ontology-57:CUI>C0233757</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">37224001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Psychogenic nausea and vomiting is defined as vomiting without any obvious organic pathology or vomiting with a psychological etiology.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/psychomotor_retardation -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/psychomotor_retardation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_cognition"/>
        <Example_1>psychomotor slowing</Example_1>
        <Example_2>psychomotor impairment.</Example_2>
        <Example_3>Reduced psychomotor speed.</Example_3>
        <synonym_1>Slow thought processes.</synonym_1>
        <synonym_2>Slowed thinking.</synonym_2>
        <synonym_3>motor retardation</synonym_3>
        <untitled-ontology-57:CUI>C0424230</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">398991009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Abnormally slow thought processes and physical movement.</rdfs:isDefinedBy>
        <rdfs:seeAlso>pyschomotor impairment; motor retardation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ptosis -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ptosis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/eyelid_ptosis"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0000508</HPO>
        <untitled-ontology-57:CUI>C0033377</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">29696001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Drooping of the eyelid.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ptosis_bilateral -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ptosis_bilateral">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/eyelid_ptosis"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0001488</HPO>
        <synonym_1>bilateral ptosis</synonym_1>
        <synonym_2>bilateral blepharaptosis</synonym_2>
        <untitled-ontology-57:CUI>C1865916</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Drooping of both eyelids.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ptosis_left_eyelid -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ptosis_left_eyelid">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/eyelid_ptosis"/>
        <untitled-ontology-57:CUI>C2143081</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">335151000119107</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Drooping of the left eyelid.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ptosis_right_eyelid -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ptosis_right_eyelid">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/eyelid_ptosis"/>
        <synonym_1>right ptosis</synonym_1>
        <untitled-ontology-57:CUI>C2143083</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">340761000119100</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Drooping of right eyelid.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pupil_finding -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pupil_finding">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#visual_disturbance"/>
        <untitled-ontology-57:CUI>C0423296</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">247010007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An abnormality of the pupil.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pyramidal_type_weakness -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pyramidal_type_weakness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hemiparesis"/>
        <untitled-ontology-57:CUI>C0427069</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">249946008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Pyramidal weakness, that is, the weakness that preferentially spares the antigravity muscles, is considered an integral part of the upper motor neuron syndrome. Despite its name, pyramidal weakness has very little to do with the pyramidal tract, and preeminent texts on neurology, neuroanatomy, and clinical examination differ considerably in their descriptions and localization of this enigmatic finding.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/quadrantanopia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/quadrantanopia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/visual_field_defect"/>
        <synonym_1>quadrantanopsia</synonym_1>
        <synonym_2>quadrant hemianopia</synonym_2>
        <untitled-ontology-57:CUI>C0544680</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">82180009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Loss of vision in one quadrant of the visual field.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/quadrantic_scotoma -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/quadrantic_scotoma">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/scotoma"/>
        <untitled-ontology-57:CUI>C1268591</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">129626006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>a scotoma involving a quarter segment of the central visual field.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/quadriparesis -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/quadriparesis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_limb"/>
        <untitled-ontology-57:CUI>C0270790</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">91327001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Weakness of all four limbs.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/quadriplegia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/quadriplegia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/quadriparesis"/>
        <untitled-ontology-57:CUI>C0034372</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11538006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Severe or complete loss of motor function in all four limbs which may result from bain diseases; spinal cord diseases; peripheral nerve diseases; neuromuscular diseases; or rarely muscular diseases. The locked-in syndrome is characterized by quadriplegia in combination with cranial muscle paralysis. Consciousness is spared and the only retained voluntary motor activity may be limited eye movements. This condition is usually caused by a lesion in the upper brainstem which injures the descending cortico-spinal and cortico-bulbar tracts.</rdfs:isDefinedBy>
        <rdfs:seeAlso>tetraplegia</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/radiating_back_pain -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/radiating_back_pain">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain_radiating"/>
        <untitled-ontology-57:CUI>C0850629</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Pain that originates in the back then radiates in a radicular pattern to the thorax or legs.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/radiating_lumbosacral_back_pain -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/radiating_lumbosacral_back_pain">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/radiating_back_pain"/>
        <untitled-ontology-57:CUI>C0850146</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Low back pain that radiates to the buttock or down the leg.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/radiating_thoracic_back_pain -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/radiating_thoracic_back_pain">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/radiating_back_pain"/>
        <untitled-ontology-57:CUI>C0848194</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Pain that begins in the thoracic spine and radiates along a thoracic spinal nerve.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/rash -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/rash">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/skin_finding"/>
        <untitled-ontology-57:CUI>C0015230</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Skin</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">271807003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A rash is a change of the human skin which affects its color, appearance, or texture. A rash may be localized in one part of the body, or affect all the skin. Rashes may cause the skin to change color, itch, become warm, bumpy, chapped, dry, cracked or blistered, swell, and may be painful.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/rash_vesicular -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/rash_vesicular">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/rash"/>
        <Example_1>rash with vesicles</Example_1>
        <Example_2>rash with blisters</Example_2>
        <Example_3>rash with bullae</Example_3>
        <untitled-ontology-57:CUI>C0221203</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Skin</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">53788007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Vesicles are small, fluid-filled sacs that can appear on your skin. The fluid inside these sacs may be clear, white, yellow, or mixed with blood.  Vesicles are also sometimes referred to as blisters or bullae, though there are slight size differences among the three. Vesicles are typically about 5 to 10 millimeters in diameter. If the sacs become larger than that, they’re classified as blisters. If they have a diameter of at least half a centimeter, they’re known as bullae.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/rebound_dysmetria -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/rebound_dysmetria">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ataxia"/>
        <synonym_1>Excessive rebound</synonym_1>
        <synonym_1>Holmes rebound phenomenon</synonym_1>
        <synonym_2>Stewart-Holmes phenomenon</synonym_2>
        <untitled-ontology-57:CUI>C0234163</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">28581003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An excessive movement in the opposite direction of an applied force in an outstretched limb, usually considered a sign of cerebellar disease. The phenomenon was first described by Gordon Morgan Holmes and Thomas Grainger Stewart in a paper published in 1904, though it was not named until a 1917 paper published by Holmes.</rdfs:isDefinedBy>
        <rdfs:seeAlso>excessive_rebound</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/receptive_aphasia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/receptive_aphasia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_Wernicke"/>
        <synonym_1>fluent aphasia</synonym_1>
        <synonym_2>Wernicke aphasia</synonym_2>
        <untitled-ontology-57:CUI>C0454578</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">229664007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>In Wernicke’s aphasia, the ability to grasp the meaning of spoken words and sentences is impaired, while the ease of producing connected speech is not very affected. Therefore Wernicke’s aphasia is also referred to as fluent aphasia or receptive aphasia.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/reduced_vision_in_bright_light -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/reduced_vision_in_bright_light">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_visual_acuity"/>
        <untitled-ontology-57:CUI>C4313370</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Reduce visual acuity in bright light.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/reflex_finding -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/reflex_finding">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#sign"/>
        <untitled-ontology-57:CUI>C0596002</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Top</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">106146005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Examination of the reflexes includes deep tendon reflexes (muscle stretch reflexes), cranial nerve reflexes, primitive reflexes, cutaneous reflexes, and the plantar response.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/respiratory_symptoms -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/respiratory_symptoms">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/symptom"/>
        <untitled-ontology-57:CUI>C0037090</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Symptoms referable to the respiratory system and respiratory tract.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/restless -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/restless">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#abnormal_behavior"/>
        <Example_1>Unable to be still</Example_1>
        <Example_2>In constant motion</Example_2>
        <synonym_1>restlessness</synonym_1>
        <untitled-ontology-57:CUI>C3887611</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">162221009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An inability to rest, relax, or be still.</rdfs:isDefinedBy>
        <rdfs:seeAlso>restlessness</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/restless_legs -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/restless_legs">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#sleep_disturbance"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0012452</HPO>
        <untitled-ontology-57:CUI>C0035258</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">32914008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Restless legs syndrome (RLS) is a condition that causes an uncontrollable urge to move your legs, usually because of an uncomfortable sensation. It typically happens in the evening or nighttime hours when you&apos;re sitting or lying down. Moving eases the unpleasant feeling temporarily</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/retinal_arteriolar_occlusion -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/retinal_arteriolar_occlusion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/retinal_artery_occlusion"/>
        <synonym_1>blocked retinal artery</synonym_1>
        <untitled-ontology-57:CUI>C4024761</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Blockage of retinal arteriole, generally associated with interruption of blood flow and oxygen delivery to affected regions of the retina</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/retinal_artery_occlusion -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/retinal_artery_occlusion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#retinal_finding"/>
        <Example_1>An occlusion of the retinal artery</Example_1>
        <untitled-ontology-57:CUI>C0035302</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">232035005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An occlusion of the retinal artery.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/retinal_hemorrhage -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/retinal_hemorrhage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#retinal_finding"/>
        <Example_1>Bleeding from the vessels of the retina</Example_1>
        <synonym_1>retinal bleeding</synonym_1>
        <synonym_2>retinal hemorrhage</synonym_2>
        <untitled-ontology-57:CUI>C0035317</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">28998008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Hemorrhage occurring within the retina.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/retrocollis -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/retrocollis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/torticollis"/>
        <untitled-ontology-57:CUI>C3887667</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">70070008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A form of torticollis in which the head is drawn back, either due to a permanent contractures of neck extensor muscles, or to a spasmodic contracture.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/retropulsion -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/retropulsion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_of_equilibrium"/>
        <Example_1>Falls backward.</Example_1>
        <Example_2>Unable to stand without falling backward.</Example_2>
        <Example_3>Falls backward when walking.</Example_3>
        <untitled-ontology-57:CUI>C0277845</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35136003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Retropulsion is a form of balance instability in which patients fall backwards.  It commonly observed in patients with balance difficulties due to Parkinson&apos;s disease.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/reverse_ocular_bobbing -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/reverse_ocular_bobbing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_eye_movement"/>
        <untitled-ontology-57:CUI>C0585559</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">307691008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Reverse ocular bobbing is an abnormal spontaneous eye movement in which the eyes move rapidly and conjugately upwards (fast phase), followed by a slow drift (slow phase) back to the primary position (that is, the reverse of ocular bobbing—fast conjugate downwards deviation, with a slow return up to the midline). This eye movement disorder may be seen in patients with viral encephalitis, metabolic encephalopathy, and in those with pontine lesions.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/rhinorrhea -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/rhinorrhea">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ENT_symptoms"/>
        <synonym_1>runny nose</synonym_1>
        <untitled-ontology-57:CUI>C1260880</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">64531003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Rhinorrhea or rhinorrhoea is the free discharge of a thin nasal mucus fluid. The condition, commonly known as a runny nose, occurs relatively frequently.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/right-left_confusion -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/right-left_confusion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Gerstmann_syndrome"/>
        <untitled-ontology-57:CUI>C0422885</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1943009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An inability to distinguish right from left.</rdfs:isDefinedBy>
        <rdfs:seeAlso>left-right_confusion; left-right_disorientation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/right_carotid_bruit -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/right_carotid_bruit">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/carotid_bruit"/>
        <Example_1>Bruit heard over right carotid artery.</Example_1>
        <Example_2>Blowing sound over right carotid artery.</Example_2>
        <Example_3>Bruit ausculated over right carotid artery.</Example_3>
        <untitled-ontology-57:CUI>C0694543</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Neck</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Bruit over right carotid artery.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/right_equivocal_plantar_response -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/right_equivocal_plantar_response">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/equivocal_plantar_response"/>
        <Example_1>Equivocal plantar response on the right.</Example_1>
        <Example_2>Right equivocal plantar response.</Example_2>
        <untitled-ontology-57:CUI>C0576643</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">299895008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A partial or incomplete upturning of the great toe upon stimulation of the plantar aspect of the foot leading to an equivocal (inconclusive) plantar response reflex.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/right_facial_droop -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/right_facial_droop">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_paresis"/>
        <untitled-ontology-57:CUI>C3842071</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Drooping of one side of the face consistent with facial paresis.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/right_foot_drop -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/right_foot_drop">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/foot_drop"/>
        <untitled-ontology-57:CUI>C4280872</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A foot drop of the right foot.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/right_homonymous_hemianopia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/right_homonymous_hemianopia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hemianopia_homonymous"/>
        <untitled-ontology-57:CUI>C0271203</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5591009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Loss of vision in the right hemi-field of both eyes.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/right_proptosis -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/right_proptosis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/proptosis"/>
        <untitled-ontology-57:CUI>C2126061</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Bulging forward of the right eye.  Right exophthalmos.</rdfs:isDefinedBy>
        <rdfs:seeAlso>right_exophthalmos</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/right_sided_headache -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/right_sided_headache">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/headache"/>
        <untitled-ontology-57:CUI>C2219285</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Headache on the right side.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/rigidity -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/rigidity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypertonia"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0002063</HPO>
        <untitled-ontology-57:CUI>C0026837</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16046003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>motor impairment whereby the hypertonic state is charcterized by bidirectional increased resistance to passive movement.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/rooting_reflex_present -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/rooting_reflex_present">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#frontal_release_signs"/>
        <Example_1>Deviation of lips towards a stimulus when lips are touched.</Example_1>
        <untitled-ontology-57:CUI>C0576499</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">299750005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A rooting (searching) reflex is when the lips and mouth deviate toward a tactile stimulus delivered to the cheek or near the mouth.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/saccadic_intrusions -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/saccadic_intrusions">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_saccades"/>
        <untitled-ontology-57:CUI>C1854375</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Saccadic intrusions are irregular episodic occurrences of a series of two or more fast eye movements. They are classified according to whether or not the intrusive saccades are separated by a brief interval in which the eyes are stationary.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sacral_root_injury -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sacral_root_injury">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sensory_loss_in_root_distribution"/>
        <untitled-ontology-57:CUI>C0161445</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Sensory</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>An injury to one of the sacral roots.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/scanning_speech -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/scanning_speech">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysarthria_scanning"/>
        <untitled-ontology-57:CUI>C0278184</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">77420001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Scanning speech is a type of ataxic dysarthria in which spoken words are broken up into separate syllables, often separated by a noticeable pause, and spoken with varying force.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/scotoma -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/scotoma">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/visual_field_defect"/>
        <untitled-ontology-57:CUI>C0036454</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">23388006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Localized defect in the visual field bordered by an area of normal vision.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/scotoma_central -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/scotoma_central">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/scotoma"/>
        <untitled-ontology-57:CUI>C0152191</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">38950008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An area of depressed vision located at the point of fixation and that interferes with central vision.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/scotoma_of_blind_spot_area_right_eye -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/scotoma_of_blind_spot_area_right_eye">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/enlarged_blind_spot"/>
        <untitled-ontology-57:CUI>C2881395</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Enlargement of the blindspt of the right eye.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/scotoma_of_blind_spot_left_eye -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/scotoma_of_blind_spot_left_eye">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/enlarged_blind_spot"/>
        <untitled-ontology-57:CUI>C2881396</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Enlargement of the blindspot of the left eye.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/see_saw_nystagmus -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/see_saw_nystagmus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/nystagmus_pendular"/>
        <untitled-ontology-57:CUI>C0344243</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">95782001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Seesaw nystagmus is a type of pendular nystagmus where a half cycle consists of the elevation and intorsion of one eye, concurrently with the depression and extortion of the fellow eye. In the other half cycle, there is an inversion of the ocular movements.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/seizure -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/seizure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/symptom"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0001250</HPO>
        <untitled-ontology-57:CUI>C0036572</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A seizure is a sudden, uncontrolled electrical disturbance in the brain. It can cause changes in your behavior, movements or feelings, and in levels of consciousness.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/seizure_generalized -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/seizure_generalized">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/seizure"/>
        <untitled-ontology-57:CUI>C0234533</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">246545002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>generalized seizure occurs when the abnormal electrical activity causing a seizure begins in both halves (hemispheres) of the brain at the same time.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/selective_mutism -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/selective_mutism">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/mutism"/>
        <untitled-ontology-57:CUI>C0236818</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">71959007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A voluntary form of mutism, often associated with psychiatric illness.</rdfs:isDefinedBy>
        <rdfs:seeAlso>elective_mutism</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sensation_absent -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sensation_absent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_sensation"/>
        <untitled-ontology-57:CUI>C3842091</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Sensory</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A loss of sensation in any sensory modality such as temperature, vibration, joint position sense, pin prick sensation, or light touch.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sensory_finding -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sensory_finding">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#sign"/>
        <untitled-ontology-57:CUI>C1291731</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Top</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">106147001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Any finding of the sensory nervous system during the neurological examination including diminished proprioception, diminished vibration sensation, diminished light touch sensation or other sensory alterations such as dysesthesias, hyperalgesia, or allodynia.  For the purposes of this ontology, higher cortical sensory findings such as astereognosis, agraphesthesia, and tactile agnosia are classified under mental status findings.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sensory_level -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sensory_level">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypesthesia"/>
        <synonym_1>sensory level</synonym_1>
        <untitled-ontology-57:CUI>C1262068</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Sensory</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A level on the body below which sensation is reduced or absent.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sensory_level_to_pain_and_temperature -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sensory_level_to_pain_and_temperature">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sensory_level"/>
        <untitled-ontology-57:CUI>C2016535</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Sensory</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Sensory level is defined as the lowest spinal cord level that still has normal pinprick and temperature sensation.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sensory_level_to_pain_and_temperature_below_C5 -->

