        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">42134006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A visual anomaly in which images appear distorted. A grid of straight lines appears wavy and parts of the grid may appear blank.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/microcephaly -->

