        <untitled-ontology-57:CUI>C1298685</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Recurrent or persistent pain that has lasted at least 3 months, and that significantly affects daily functioning or well-being</rdfs:isDefinedBy>
    </owl:Class>
    


