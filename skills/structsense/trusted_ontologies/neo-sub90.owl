        <rdfs:isDefinedBy>The definition of inappropriate is someone or something that is not within the bounds of what is considered appropriate or socially acceptable.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/inappropriate_jocularity -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/inappropriate_jocularity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_of_executive_functions"/>
        <untitled-ontology-57:CUI>C0233468</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5240007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Using humor and joking inappropriately, usually in the setting of disinhibition due to frontal lobe injury.  See also witzelsucht.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/inappropriate_laughter_or_crying -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/inappropriate_laughter_or_crying">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/altered_behavior"/>
        <Example_1>inappropriate crying.</Example_1>
        <Example_2>Inappropriate laughing.</Example_2>
        <untitled-ontology-57:CUI>C1862946</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Uncontrolled episodes of crying or laughing, without apparent motivating stimuli.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/inattention -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/inattention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impairment_of_attention"/>
        <untitled-ontology-57:CUI>C0424101</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22058002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>failure to pay attention</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/incoherent_speech -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/incoherent_speech">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/speech_impairment"/>
        <Example_1>nonsensical speech</Example_1>
        <Example_2>incomprehensible speech</Example_2>
        <untitled-ontology-57:CUI>C0700129</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">284596004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Speech which is non-sensical and difficulty to understand.  This term is used and generally and does not have a precise neurological definition to describe rambling non-sensical speech.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/incoordination -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/incoordination">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/coordination_finding"/>
        <Example_1>impaired coordination</Example_1>
        <Example_2>decreased coordination</Example_2>
        <Example_2>lacking in coordination</Example_2>
        <untitled-ontology-57:CUI>C0520966</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">281016006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>lack of coordination, especially the inability to use different parts of the body together smoothly and efficiently.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/increased_head_circumference -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/increased_head_circumference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/head_finding"/>
        <Example_1>enlarged head</Example_1>
        <Example_2>increased head circumference</Example_2>
        <untitled-ontology-57:CUI>C4083076</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Head</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>An abnormally increased head circumference in a growing child. Head circumference is measured with a nonelastic tape and comprises the distance from above the eyebrows and ears and around the back of the head. The measured HC is then plotted on an appropriate growth chart</rdfs:isDefinedBy>
        <rdfs:seeAlso>Increased head circumference; enlarged head; head size large; large head; Large skull</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/increased_tone_lower_limbs -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/increased_tone_lower_limbs">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypertonia"/>
        <Example_1>Hypertonia in legs.</Example_1>
        <Example_2>Increased tone in legs.</Example_2>
        <Example_3>Increased tone in lower extremities.</Example_3>
        <untitled-ontology-57:CUI>C2674843</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Tone is increased in legs.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/injury_of_cervical_spine -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/injury_of_cervical_spine">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/spinal_injury"/>
        <untitled-ontology-57:CUI>C0432666</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">262522002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A traumatic injury to cervical spine involving the vertebral column or spinal cord.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/injury_of_lumbar_spine -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/injury_of_lumbar_spine">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/spinal_injury"/>
        <untitled-ontology-57:CUI>C0432668</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">262524001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An injury to the lumbar spine involving either the vertebral column or lumbosacral nerve plexus.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/injury_of_thoracic_spine -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/injury_of_thoracic_spine">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/spinal_injury"/>
        <untitled-ontology-57:CUI>C0432667</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">262523007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Traumatic injury to the thoracic spine with injury to either the thoracic spinal cord or the vertebral spinal column.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/insomnia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/insomnia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#sleep_disturbance"/>
        <Example_1>difficulty staying asleep</Example_1>
        <Example_2>difficulty staying asleep</Example_2>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0100785</HPO>
        <untitled-ontology-57:CUI>C0917801</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">193462001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A disorder characterized by difficulty in falling asleep and/or remaining asleep.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/internuclear_ophthalmoplegia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/internuclear_ophthalmoplegia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gaze_palsy"/>
        <untitled-ontology-57:CUI>C0152134</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">49823009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An abnormality of conjugate lateral gaze in which the affected eye shows impairment of adduction. The pathognomonic clinical sign of internuclear ophthalmoplegia is an impaired adduction while testing horizontal saccades on the side of the lesion in the ipsilateral medial longitudinal fascicule.</rdfs:isDefinedBy>
        <rdfs:seeAlso>INO</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/intrinsic_hand_weakness -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/intrinsic_hand_weakness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_intrinsic_hand_muscles"/>
        <untitled-ontology-57:CUI>C4476548</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Weakness of the intrinsic muscles of the hand</rdfs:isDefinedBy>
        <rdfs:seeAlso>weak_intrinsic_hand_muscles</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/involuntary_excessive_eye_blinking -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/involuntary_excessive_eye_blinking">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/blinking_excessive"/>
        <untitled-ontology-57:CUI>C0427088</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">249963007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Excessive eye blinking not under voluntary control.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/involuntary_movement -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/involuntary_movement">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/movement_disorder"/>
        <Example_1>Involuntary movement.</Example_1>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0004305</HPO>
        <untitled-ontology-57:CUI>C0427086</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">267078001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Involuntary contractions of muscle leading to involuntary movements of extremities, neck, trunk, or face.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/irritable -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/irritable">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/restless"/>
        <untitled-ontology-57:CUI>C0022107</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">55929007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Abnormal or excessive excitability with easily triggered anger, annoyance, or impatience.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ischemic_optic_neuropathy -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ischemic_optic_neuropathy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#retinal_finding"/>
        <untitled-ontology-57:CUI>C0155305</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14357004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>schemic injury to the OPTIC NERVE which usually affects the OPTIC DISK (optic neuropathy, anterior ischemic) and less frequently the retrobulbar portion of the nerve (optic neuropathy, posterior ischemic). The injury results from occlusion of arterial blood supply which may result from TEMPORAL ARTERITIS; ATHEROSCLEROSIS; COLLAGEN DISEASES; EMBOLISM; DIABETES MELLITUS; and other conditions. The disease primarily occurs in the sixth decade or later and presents with the sudden onset of painless and usually severe monocular visual loss. Anterior ischemic optic neuropathy also features optic disk edema with microhemorrhages. The optic disk appears normal in posterior ischemic optic neuropathy.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/jamais_vu -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/jamais_vu">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysmnesic_seizure"/>
        <untitled-ontology-57:CUI>C0233803</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>An unnatural feeling of strangeness about a person or place that is familiar.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/jaundice -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/jaundice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/icterus"/>
        <synonym_1>icterus</synonym_1>
        <synonym_2>hyperbilirubinemia</synonym_2>
        <untitled-ontology-57:CUI>C2010848</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18165001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A clinical manifestation of HYPERBILIRUBINEMIA, characterized by the yellowish staining of the SKIN; MUCOUS MEMBRANE; and SCLERA. Clinical jaundice usually is a sign of LIVER dysfunction.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/jaw_jerk_brisk -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/jaw_jerk_brisk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/brisk_jaw_jerk"/>
        <Example_1>Jaw jerk increased.</Example_1>
        <Example_2>Pathological jaw jerk.</Example_2>
        <Example_3>Overactive jaw reflex.</Example_3>
        <untitled-ontology-57:CUI>C3552908</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>An increased jaw jerk elicited by a gentle tap on the mandible with a reflex hammer.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/jerky_movements -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/jerky_movements">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abnormal_involuntary_movement"/>
        <untitled-ontology-57:CUI>C0427085</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Jerky body movement is a condition in which a person makes fast movements that they cannot control and that have no purpose. These movements interrupt the person&apos;s normal movement or posture.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/labile_affect -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/labile_affect">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abnormal_affect"/>
        <untitled-ontology-57:CUI>C0233472</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">88729006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Instability of mood, prone to rapid changes in mood and affect.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/lack_of_tears -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/lack_of_tears">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cranial_nerve_7_finding"/>
        <synonym_1>absent lacrimation.</synonym_1>
        <synonym_2>absent tearing</synonym_2>
        <untitled-ontology-57:CUI>C0423154</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">246849001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A failure to produce tears.</rdfs:isDefinedBy>
        <rdfs:seeAlso>lack_of_lacrimation, lack_of_tears, absent_lacrimation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/lateral_deviation_of_tongue_on_protrusion -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/lateral_deviation_of_tongue_on_protrusion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tongue_weakness"/>
        <untitled-ontology-57:CUI>C0426986</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">249876002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Deviation of the tongue to one side when the tongue is protruded, the tongue usually deviates to the side that is weak.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/lead_pipe_rigidity -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/lead_pipe_rigidity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/rigidity"/>
        <untitled-ontology-57:CUI>C0277821</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">75147004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Leadpipe rigidity is sustained resistance to passive movement throughout the whole range of motion, with no fluctuations.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/learning_disability -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/learning_disability">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cognitive_symptoms"/>
        <synonym_1>learning disabled</synonym_1>
        <synonym_2>impaired ability to learn</synonym_2>
        <untitled-ontology-57:CUI>C0751265</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>a condition giving rise to difficulties in acquiring knowledge and skills to the level expected of those of the same age, especially when not associated with a physical handicap.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/left_carotid_bruit -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/left_carotid_bruit">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/carotid_bruit"/>
        <Example_1>Bruit auscultated over left carotid artery.</Example_1>
        <Example_2>Bruit heard over left carotid artery.</Example_2>
        <untitled-ontology-57:CUI>C0694542</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Neck</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Bruit over left carotid artery.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/left_equivocal_plantar_response -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/left_equivocal_plantar_response">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/equivocal_plantar_response"/>
        <untitled-ontology-57:CUI>C0576642</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A partial or incomplete upturning of the great toe upon stimulation of the plantar aspect of the foot leading to an equivocal (inconclusive) plantar response reflex.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/left_facial_droop -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/left_facial_droop">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_left_face"/>
        <untitled-ontology-57:CUI>C3842072</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Weakness of the left face.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/left_foot_drop -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/left_foot_drop">
