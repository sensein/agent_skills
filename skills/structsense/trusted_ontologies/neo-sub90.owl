        <untitled-ontology-57:CUI>C0013378</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A condition characterized by alterations of the sense of taste which may range from mild to severe, including gross distortions of taste quality.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#dyslexia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#dyslexia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/alexia"/>
        <Example_1>Unable to read.</Example_1>
        <Example_1>dyslexic</Example_1>
        <Example_2>Impairment in reading.</Example_2>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0010522</HPO>
        <untitled-ontology-57:CUI>C0476254</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A cognitive disorder characterized by an impaired ability to comprehend written and printed words or phrases despite intact vision.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#dysphagia_CTCAE_3 -->

