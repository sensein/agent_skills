    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#dysfluency -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#dysfluency">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_speech"/>
