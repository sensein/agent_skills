        <rdfs:isDefinedBy>An abnormal increase in the pitch (frequency) of the voice</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/high_steppage_gait -->

