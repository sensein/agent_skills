        <untitled-ontology-57:CUI>C0005745</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11934000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Drooping of the upper lid due to deficient development or paralysis of the levator palpebrae muscle.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_diplegia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_diplegia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_paresis"/>
        <untitled-ontology-57:CUI>C1836003</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A term for bilateral facial weakness.</rdfs:isDefinedBy>
        <rdfs:seeAlso>bilateral_facial_weakness</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_myokimia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_myokimia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/myokimia"/>
        <Example_1>facial myokymia is a fine rippling of muscles on one side of the face</Example_1>
        <untitled-ontology-57:CUI>C0270871</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1070000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Facial myokymia is a fine fibrillary activity of one or more muscles innervated by the facial nerve (the seventh cranial nerve).</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_numbness -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_numbness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cranial_nerve_5_finding"/>
        <untitled-ontology-57:CUI>C0239511</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">309557009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Loss of sensation to temperature, pin prick, or touch on the face.</rdfs:isDefinedBy>
        <rdfs:isDefinedBy>Numbness or lack of sensation on one side of the face.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_palsy_LMN -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_palsy_LMN">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_weakness_LMN"/>
        <untitled-ontology-57:CUI>C0751142</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Facial weakness due to a lesion of the facial nerve or the facial nerve nucleus.  In general, both upper and lower face are equally affected.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_paralysis -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_paralysis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_paresis"/>
        <untitled-ontology-57:CUI>C0015469</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">280816001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Complete loss of ability to move facial muscles innervated by the facial nerve (i.e., the seventh cranial nerve).</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_paresis -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_paresis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cranial_nerve_7_finding"/>
        <untitled-ontology-57:CUI>C0427055</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">95666008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Reduced strength of one or more muscles innervated by the facial nerve (the seventh cranial nerve).</rdfs:isDefinedBy>
        <rdfs:seeAlso>facial_weakness; facial_droop</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_sensation_decreased_V1 -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_sensation_decreased_V1">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/decreased_pain_and_temperature_sensation_of_face"/>
        <untitled-ontology-57:CUI>C2237377</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Decreased sensation in the ophthalmic branch of the trigeminal nerve on the face.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_sensation_decreased_V2 -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_sensation_decreased_V2">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/decreased_pain_and_temperature_sensation_of_face"/>
        <untitled-ontology-57:CUI>C2237381</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Decreased sensation in the maxillary branch of the trigeminal nerve.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_sensation_decreased_V3 -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_sensation_decreased_V3">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/decreased_pain_and_temperature_sensation_of_face"/>
        <untitled-ontology-57:CUI>C2237384</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Decreased sensation in the distribution of the mandibular branch of the trigeminal nerve on the face.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_weakness_LMN -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_weakness_LMN">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_paresis"/>
        <untitled-ontology-57:CUI>C0427057</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">249933003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Facial weakness due to a lesion of the facial nerve or the facial nerve nucleus.  In general, both upper and lower face are equally affected.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_weakness_UMN -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_weakness_UMN">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_paresis"/>
        <untitled-ontology-57:CUI>C0427058</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">249934009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Facial weakness due to lesion above the facial nerve nucleus.  Supranuclear lesions generally cause facial weakness that is worse in the lower face than the upper face due to bilateral supranculear control of the upper face.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/falls -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/falls">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_of_equilibrium"/>
        <Example_1>Prone to falls.</Example_1>
        <Example_2>Has fallen recently.</Example_2>
        <Example_3>Fallen to the ground.</Example_3>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0002527</HPO>
        <synonym_1>Falling.</synonym_1>
        <untitled-ontology-57:CUI>C0085639</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">161898004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A sudden movement downward, usually resulting in injury</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/fasciculation_limb -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/fasciculation_limb">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/fasciculations"/>
        <Example_1>muscle twitching in the limbs</Example_1>
        <Example_2>muscle fasciculations in legs and arms</Example_2>
        <synonym_1>fasciculations of arms</synonym_1>
        <synonym_2>fasciculations of legs</synonym_2>
        <untitled-ontology-57:CUI>C1854657</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Fasciculations affecting the musculature of the arms and legs. A fasciculation, or muscle twitch, is a spontaneous, involuntary muscle contraction and relaxation, involving fine muscle fibers. They are common, with as much as 70% of people experiencing them. They can be benign, or associated with more serious conditions.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/fasciculation_tongue -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/fasciculation_tongue">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/denervation_atrophy_of_tongue"/>
        <Example_1>tongue fasciculations</Example_1>
        <synonym_1>tongue fasciculations</synonym_1>
        <synonym_2>fasciculation of tongue</synonym_2>
        <untitled-ontology-57:CUI>C0239548</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">249878001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Fasciculations in the tongue muscle.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/fasciculations -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/fasciculations">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#motor_disorders"/>
        <Example_1>muscle fasciculations</Example_1>
        <Example_2>muscle twitching</Example_2>
        <untitled-ontology-57:CUI>C0015644</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">82470000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Fasciculations are observed as small, local, involuntary muscle contractions (twitching) visible under the skin. Fasciculations result from increased irritability of an axon (which in turn is often a manifestation of disease of a motor neuron). This leads to sporadic discharges of all the muscle fibers controlled by the axon in isolation from other motor units.</rdfs:isDefinedBy>
        <rdfs:seeAlso>muscle_fasciculation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/fatigue -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/fatigue">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/consitutitional_symptoms"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0012378</HPO>
        <synonym_2>tiredness</synonym_2>
        <synonym_3>weariness</synonym_3>
        <untitled-ontology-57:CUI>C0015672</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">84229001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>state of weariness following a period of exertion, mental or physical, characterized by a decreased capacity for work and reduced efficiency to respond to stimuli.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/fear -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/fear">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/altered_behavior"/>
        <Example_1>the unpleasant emotional state consisting of psychological and psychophysiologic responses to a real external threat or danger, including agitation, alertness, tension, and physiologic mobilization of the alarm reaction.</Example_1>
        <synonym_1>dread</synonym_1>
        <untitled-ontology-57:CUI>C0015726</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1402001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Feeling of dread or distress whose cause can be identified</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/fecal_incontinence -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/fecal_incontinence">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#bowel_problems"/>
        <Example_1>Incontinence of stool.</Example_1>
        <synonym_1>bowel incontinence</synonym_1>
        <synonym_2>fecal incontinence</synonym_2>
        <untitled-ontology-57:CUI>C0015732</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>failure of control of the anal sphincters</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/fever -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/fever">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/consitutitional_symptoms"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0001945</HPO>
        <synonym_1>febrile</synonym_1>
        <synonym_3>feverish</synonym_3>
        <untitled-ontology-57:CUI>C0015967</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">386661006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Abnormal high body temperature</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/fine_rapid_hand_tremor -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/fine_rapid_hand_tremor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor_fine"/>
        <untitled-ontology-57:CUI>C1860864</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Physiologic tremor is a very-low-amplitude fine tremor (6 Hz-12 Hz) that is barely visible to the naked eye. It is present in every normal person while maintaining a posture or movement. Neurologic examination results of patients with physiologic tremor are usually normal.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/finger_agnosia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/finger_agnosia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Gerstmann_syndrome"/>
        <untitled-ontology-57:CUI>C0234509</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3449007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An inability or difficulty differentiating among the fingers of either hand as well as the hands of others</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/finger_and_wrist_extensor_weakness -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/finger_and_wrist_extensor_weakness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_fingers"/>
        <untitled-ontology-57:CUI>C1866142</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>weakness of the fingers and wrist extensors.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/finger_dysmetria -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/finger_dysmetria">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysmetria"/>
        <untitled-ontology-57:CUI>C1847354</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Dysmetria: refers to a lack of coordination of movement. Clinically this results in the patient missing the target by over/undershooting.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/fixed_dilated_pupil -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/fixed_dilated_pupil">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pupil_finding"/>
        <untitled-ontology-57:CUI>C0522340</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">103271006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Pupil that is both dilated and that does not constrict to light.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/flaccid_hemiplegia_dominant_side -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/flaccid_hemiplegia_dominant_side">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hemiplegia"/>
        <synonym_1>Paralysis and flaccidity in the arm and leg on the dominant side, usually the right in right handed individuals.</synonym_1>
        <untitled-ontology-57:CUI>C2875327</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Paralysis and flaccidity in the arm and leg on the dominant side, usually the right in right handed individuals.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/flaccid_motor_tone -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/flaccid_motor_tone">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypotonia"/>
        <Example_1>Flaccid muscle tone.</Example_1>
        <Example_2>Muscle tone was flaccid.</Example_2>
        <Example_3>Absent muscle tone.</Example_3>
        <synonym_1>flaccidity</synonym_1>
        <synonym_2>flaccid tone</synonym_2>
        <synonym_3>Markedly reduced muscle tone.</synonym_3>
        <untitled-ontology-57:CUI>C0026825</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">397488002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Lack of normal muscle tone.</rdfs:isDefinedBy>
        <rdfs:seeAlso>flaccidity; flaccid_tone; flaccid_muscle_tone</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/flaccid_paralysis_of_arm -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/flaccid_paralysis_of_arm">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_arm"/>
        <untitled-ontology-57:CUI>C0241528</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>weakness of the arm associated with decreased muscle tone.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/flaccid_paraplegia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/flaccid_paraplegia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/paraplegia"/>
        <Example_1>paraplegia with hypotonia</Example_1>
        <untitled-ontology-57:CUI>C0452143</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">192966000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A paraplegia with decreased muscle tone (hypotonia)</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/flat_affect -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/flat_affect">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abnormal_affect"/>
        <untitled-ontology-57:CUI>C0233471</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">932006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A severe reduction in emotional expressiveness. People with depression and schizophrenia often show flat affect.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/flight_of_ideas -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/flight_of_ideas">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abnormal_affect"/>
        <untitled-ontology-57:CUI>C0233657</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">28810003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Rapid succession of thoughts pertaining to different subjects that are still connected.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/flinging_movements_of_legs -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/flinging_movements_of_legs">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hemiballismus"/>
        <untitled-ontology-57:CUI>C0427094</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Hemiballismus is usually characterized by involuntary flinging motions of the extremities. The movements are often violent and have wide amplitudes of motion. They are continuous and random and can involve proximal or distal muscles on one side of the body. Some cases even include the facial muscles</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/foot_dorsiflexor_weakness -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/foot_dorsiflexor_weakness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_ankle_dorsiflexion"/>
        <untitled-ontology-57:CUI>C1866141</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>The foot and ankle dorsiflexors include the tibialis anterior, the extensor hallucis longus (EHL), and the extensor digitorum longus (EDL). These muscles help the body clear the foot during swing phase and control plantarflexion of the foot on heel strike.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/foot_drop -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/foot_drop">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_ankle"/>
        <untitled-ontology-57:CUI>C0085684</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6077001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Weakness of the muscles responsible for dorsiflexion of the foot, that is, of the movement of the toes towards the shin. The foot dorsiflexors include the tibialis anterior, the extensor hallucis longus, the extensor digitorum longus, and the peroneus tertius muscles.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/forgetful -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/forgetful">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cognitive_symptoms"/>
        <synonym_1>forgetting things</synonym_1>
        <synonym_2>fogretting names</synonym_2>
        <synonym_3>forgetting dates</synonym_3>
        <untitled-ontology-57:CUI>C0542476</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">55533009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An impairment of memory as manifested by a reduced ability to remember things such as dates and names, and increased forgetfulness.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gag_reflex_absent -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gag_reflex_absent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_gag_reflex"/>
        <synonym_1>Absent pharyngeal reflex.</synonym_1>
        <untitled-ontology-57:CUI>C0234784</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5258001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The corneal reflex, also known as the blink reflex, is an involuntary blinking of the eyelids elicited by stimulation of the cornea (such as by touching or by a foreign body), though could result from any peripheral stimulus.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_antalgic -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_antalgic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_difficulty"/>
        <Example_1>Painful gait.</Example_1>
        <Example_2>Pain  on walking.</Example_2>
        <Example_3>Limping due to pain.</Example_3>
        <untitled-ontology-57:CUI>C0231685</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">67141003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>To avoid pain weight is put on the affected leg for as short a time as possible</rdfs:isDefinedBy>
        <rdfs:isDefinedBy>To avoid pain weight is put on the affected leg for as short a time as possible, resulting in a limp.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_apraxia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_apraxia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_difficulty"/>
        <Example_1>Difficulty walking due to loss of the motor programs of walking.</Example_1>
        <Example_2>Difficulty walking due to apraxia of gait.</Example_2>
        <Example_3>magnetic gait.</Example_3>
        <synonym_1>dyspraxia of gait</synonym_1>
        <synonym_2>gait dyspraxia</synonym_2>
        <synonym_3>Bruns ataxia</synonym_3>
        <untitled-ontology-57:CUI>C1510417</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30767006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Impaired ambulation not attributed to sensory impairment or motor weakness. The impairment is thought to be due to disorganization of high level motor programs for walking.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_ataxic -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_ataxic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_difficulty"/>
        <Example_1>Incoordinated walking.</Example_1>
        <Example_1>Uncoordinated gait.</Example_1>
        <Example_2>Uncoordinate walking.</Example_2>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0002066</HPO>
        <synonym_1>ataxic gait.</synonym_1>
        <synonym_2>gait ataxia.</synonym_2>
        <untitled-ontology-57:CUI>C0751837</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">25136009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A type of ataxia characterized by the impairment of the ability to coordinate the movements required for normal walking. Gait ataxia is characteirzed by a wide-based staggering gait with a tendency to fall.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_choreic -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_choreic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_difficulty"/>
        <Example_1>Walking with dramatic flowing motions.</Example_1>
        <Example_2>Walking with chorieform movements of hands and feet.</Example_2>
        <Example_3>Walking with dance-like flowing movements.</Example_3>
        <untitled-ontology-57:CUI>C0427162</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">250040002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A gait disorder characterised by slow and wide-based, irregular, dancing gait, spontaneous knee flexion and leg raising.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_clumsy -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_clumsy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_ataxic"/>
        <untitled-ontology-57:CUI>C1842201</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Gait that is unsteady, often seen with ataxia.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_difficulty -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_difficulty">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_disorder"/>
        <Example_1>Abnormal gait.</Example_1>
        <Example_2>Gait difficulty.</Example_2>
        <Example_3>Gait distrubance.</Example_3>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0001288</HPO>
        <synonym_1>Abnormal gait.</synonym_1>
        <synonym_2>Gait problems.</synonym_2>
        <untitled-ontology-57:CUI>C0575081</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>The term gait disturbance can refer to any disruption of the ability to walk</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_disorder -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_disorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#motor_disorders"/>
        <Example_1>Disorder of gait.</Example_1>
        <Example_2>Gait disorder.</Example_2>
        <untitled-ontology-57:CUI>C0575079</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">298302000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An impairment in gait or walking.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_dystonic -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_dystonic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_difficulty"/>
        <Example_1>posturing while walking.</Example_1>
        <Example_2>Dystonic posturing whi</Example_2>
        <untitled-ontology-57:CUI>C0427163</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">250042005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Dystonic gait disorders frequently appear bizarre, particularly because activity increases dystonic tonus and posture. The abnormal posture of the foot in dystonic gait typically involves inversion, plantar flexion and tonic extension of the big toe. In many patients complex types of walking, such as walking backwards and running are paradoxically less impaired than walking forward and may seem completely unaffected. Sensory tricks, for instance, if the affected individual rests a hand on his or her neck, may improve or even normalize dystonic gait in some patients.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_festinating -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_festinating">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_parkinsonian"/>
        <synonym_1>festination</synonym_1>
        <synonym_2>festinating</synonym_2>
        <untitled-ontology-57:CUI>C0231694</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">397776000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Parkinsonian gait (or festinating gait, from Latin festinare [to hurry]) is the type of gait exhibited by patients suffering from Parkinson&apos;s disease (PD). It is often described by people with Parkinson&apos;s as feeling like being stuck in place, when initiating a step or turning, and can increase the risk of falling</rdfs:isDefinedBy>
        <rdfs:seeAlso>festination</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_freezing -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_freezing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_parkinsonian"/>
        <Example_1>freezing of gait.</Example_1>
        <Example_2>Intermittent gait freezing</Example_2>
        <untitled-ontology-57:CUI>C0860515</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">443544006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Freezing of gait is defined as a brief, episodic absence or marked reduction of forward progression of the feet despite the intention to walk</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_hemiplegic -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_hemiplegic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_difficulty"/>
        <Example_1>Circumduction of the leg when walking due to hemiparesis.</Example_1>
        <synonym_1>hemiparetic gait.</synonym_1>
        <untitled-ontology-57:CUI>C0231696</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">52751000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Hemiplegic persons have circumduction gait, where the affected limb moves through an arc away from the body.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_myopathic -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_myopathic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_difficulty"/>
        <Example_1>Exaggerated rise and fall of the hip with each step due to weakness.</Example_1>
        <Example_3>gait of myopathy.</Example_3>
        <synonym_1>Rise and fall of hip with walking due to weakness.</synonym_1>
        <untitled-ontology-57:CUI>C0547001</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">250020009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Myopathic gait  exaggerated alternation of lateral trunk movements with an exaggerated elevation of the hip</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_paraplegic -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_paraplegic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_spastic"/>
        <Example_1>Weakness in both legs with stiff gait.</Example_1>
        <Example_2>abnormal gait due to paraparesis.</Example_2>
        <Example_3>abnormal gait due to bilateral leg weakness.</Example_3>
        <untitled-ontology-57:CUI>C0427159</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">250035005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Abnormal gait due to bilateral leg weakness and stiffness.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_parkinsonian -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_parkinsonian">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_difficulty"/>
        <synonym_1>extrapyramidal gait</synonym_1>
        <untitled-ontology-57:CUI>C0427160</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">250036006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Parkinsonian gait is a defining feature of Parkinson’s disease, especially in later stages. It’s often considered to have a more negative impact on quality of life than other Parkinson’s symptoms. People with Parkinsonian gait usually take small, shuffling steps. They might have difficulty picking up their feet.</rdfs:isDefinedBy>
        <rdfs:seeAlso>extra_pyramidal_gait</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_shuffling -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_shuffling">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_parkinsonian"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0002362</HPO>
        <untitled-ontology-57:CUI>C0231688</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">43005009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Shuffling gait – Shuffling gait appears as if the person is dragging their feet as they walk. Steps may also be shorter in stride (length of the step) in a shuffling gait. The shuffling gait is also seen with the reduced arm movement during walking</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_slow -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_slow">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_parkinsonian"/>
        <untitled-ontology-57:CUI>C1851908</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A slow shuffling gait is combined with reduced or absent arm swing and the hands are held in front of the body. Crossing boundaries such as doorways may be difficult and turning is often slow and awkward.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_spastic -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_spastic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_difficulty"/>
        <Example_1>stiff gait.</Example_1>
        <Example_2>spastic walk.</Example_2>
        <untitled-ontology-57:CUI>C0231687</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9447003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Spasticity is manifested by increased stretch reflex which is intensified with movement velocity. This results in excessive and inappropriate muscle activation which can contribute to muscle hypertonia. Spastic gait is characterized by manifestations such as muscle hypertonia, stiff knee, and circumduction of the leg.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_stiff -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_stiff">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_stiff_legged"/>
        <Example_1>stiff gait.</Example_1>
        <Example_2>walked stiffly.</Example_2>
        <Example_3>walked with legs held stiffly.</Example_3>
        <untitled-ontology-57:CUI>C1861462</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Gait with legs held stiffly suggesting spasticity.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_stiff_legged -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_stiff_legged">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_spastic"/>
        <Example_1>stiff legged gait.</Example_1>
        <Example_2>Walked with legs held stiffly.</Example_2>
        <synonym_1>goose stepping gait.</synonym_1>
        <untitled-ontology-57:CUI>C0427140</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">310021000009109</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Gait with legs held stiffly.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_unsteady -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_unsteady">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_ataxic"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0002317</HPO>
        <untitled-ontology-57:CUI>C0231686</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22631008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A shaky or wobbly manner of walking.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_unsteady_waddling -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_unsteady_waddling">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_waddling"/>
        <untitled-ontology-57:CUI>C4227868</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Weakness of the hip girdle and upper thigh muscles, for instance in myopathies, leads to an instability of the pelvis on standing and walking. If the muscles extending the hip joint are affected, the posture in that joint becomes flexed and lumbar lordosis increases. The patients usually have difficulties standing up from a sitting position. Due to weakness in the gluteus medius muscle, the hip on the side of the swinging leg drops with each step (referred to as Trendelenburg sign). The gait appears waddling.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_unsteady_wide_based -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_unsteady_wide_based">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_ataxic"/>
        <untitled-ontology-57:CUI>C4229671</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Often seen with gait ataxia, the gait is unsteady and wide based.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_waddling -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_waddling">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_myopathic"/>
        <Example_1>walked with a waddle.</Example_1>
        <Example_2>waddling gait.</Example_2>
        <Example_3>Dropping of the hip on each side with each step due to weakness.</Example_3>
        <untitled-ontology-57:CUI>C0231712</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">271706000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Weakness of the hip girdle and upper thigh muscles, for instance in myopathies, leads to an instability of the pelvis on standing and walking. If the muscles extending the hip joint are affected, the posture in that joint becomes flexed and lumbar lordosis increases. The patients usually have difficulties standing up from a sitting position. Due to weakness in the gluteus medius muscle, the hip on the side of the swinging leg drops with each step (referred to as Trendelenburg sign). The gait appears waddling.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_wide_based -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_wide_based">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_ataxic"/>
        <Example_1>wide based gait</Example_1>
        <Example_2>broad based gait</Example_2>
        <Example_3>Walked with feet wide apart.</Example_3>
        <synonym_1>Walking with feet widely spaced.</synonym_1>
        <untitled-ontology-57:CUI>C0856863</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED></untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An abnormal gait pattern in which persons stand and walk with their feet spaced widely apart. This is often a component of cerebellar ataxia.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gaze_palsy -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gaze_palsy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/limited_eye_movements"/>
        <untitled-ontology-57:CUI>C1112261</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A weakness of vertical or horizontal gaze.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gaze_palsy_horizontal -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gaze_palsy_horizontal">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gaze_palsy"/>
        <untitled-ontology-57:CUI>C0339651</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">232115006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A weakness of horizontal gaze.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gaze_palsy_vertical -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gaze_palsy_vertical">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gaze_palsy"/>
        <untitled-ontology-57:CUI>C0339652</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">246773002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A vertical gaze palsy may be the inability to look upward or downward.</rdfs:isDefinedBy>
        <rdfs:seeAlso>poor upgaze; upgaze palsy; upgaze weakness</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gegenhalten -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gegenhalten">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/rigidity"/>
        <synonym_1>paratonia</synonym_1>
        <synonym_2>mitgehen</synonym_2>
        <untitled-ontology-57:CUI>C0231519</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24033006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Paratonia is the inability to relax muscles during muscle tone assessment. There are two types of paratonia: oppositional and facilitatory. Oppositional paratonia (&quot;gegenhalten&quot;) occurs when subjects involuntarily resist to passive movements, while facilitatory paratonia (&quot;mitgehen&quot;) occurs when subjects involuntary assist passive movements.Both types of paratonia have been associated with cognitive impairment or mental disorders, particularly in relation to frontal lobe dysfunction. Paratonia is frequently encountered in clinical practice.</rdfs:isDefinedBy>
        <rdfs:seeAlso>paratonia</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/general_unsteadiness -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/general_unsteadiness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/difficulty_walking"/>
        <untitled-ontology-57:CUI>C0427108</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">271713000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Unsteadiness: Loss of one&apos;s equilibrium in regard to the environment, often with a feeling of almost falling, or the result of bumping into things. There are many causes for unsteadiness, including problems in the cerebral or cerebellar portions of the brain, the spinal cord, vestibular system, or inner ear.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/generalized_hypotonia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/generalized_hypotonia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypotonia"/>
        <Example_1>Abnormally low muscle tone.</Example_1>
        <Example_2>Generalized low muscle tone.</Example_2>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0001290</HPO>
        <untitled-ontology-57:CUI>C1858120</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Generalized muscular hypotonia (abnormally low muscle tone)</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/generalized_motor_hypertrophy -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/generalized_motor_hypertrophy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#generalized_muscle_hypertrophy"/>
        <untitled-ontology-57:CUI>C2010782</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Generalized muscle hypertrophy.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/getting_lost -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/getting_lost">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cognitive_symptoms"/>
        <synonym_1>getting lost</synonym_1>
        <synonym_2>unable to find their way</synonym_2>
        <untitled-ontology-57:CUI>C0424015</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">247664009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A form of disorientation where the person loses their way and is unable to get to their destination.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/glossopharyngeal_nerve_finding -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/glossopharyngeal_nerve_finding">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cranial_nerve_9_10_finding"/>
        <untitled-ontology-57:CUI>C0751941</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">80962007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Diseases of the ninth cranial (glossopharyngeal) nerve or its nuclei in the medulla. The nerve may be injured by diseases affecting the lower brain stem, floor of the posterior fossa, jugular foramen, or the nerve&apos;s extracranial course. Clinical manifestations include loss of sensation from the pharynx, decreased salivation, and syncope. Glossopharyngeal neuralgia refers to a condition that features recurrent unilateral sharp pain in the tongue, angle of the jaw, external auditory meatus and throat that may be associated with SYNCOPE. Episodes may be triggered by cough, sneeze, swallowing, or pressure on the tragus of the ear.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/glove_sensory_loss -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/glove_sensory_loss">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/decreased_tactile_sensation_in_distal_extremities_glove_and_stocking"/>
        <synonym_1>glove anesthesia</synonym_1>
        <untitled-ontology-57:CUI>C0277840</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Sensory</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">63755003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Sensory loss to pain and temperature in a glove-like distribution of the hand.</rdfs:isDefinedBy>
        <rdfs:seeAlso>glove_anesthesia</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/graphesthesia_impaired -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/graphesthesia_impaired">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/other_higher_cortical_functions"/>
        <Example_1>Does not recognize letters traced onto hand.</Example_1>
        <Example_2>Does not recognize numbers traced onto hand.</Example_2>
        <synonym_1>agraphesthesia</synonym_1>
        <untitled-ontology-57:CUI>C0576697</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">299945006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Inability to recognize letters or numbers traced on the palm of the hand.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/grasp_reflex -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/grasp_reflex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/grasp_reflex_present"/>
        <Example_1>Grasp reflex present.</Example_1>
        <untitled-ontology-57:CUI>C0234175</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Placing an object in the palm of the hand causes reflexive grasping.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/grasp_reflex_present -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/grasp_reflex_present">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#frontal_release_signs"/>
        <Example_1>Reflexive grasping an object placed in the palm of the hand.</Example_1>
        <synonym_1>palmar grasp reflex</synonym_1>
        <synonym_2>grasp reflex</synonym_2>
        <untitled-ontology-57:CUI>C2367679</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Palmar grasp reflex (sometimes simply grasp reflex) is a primitive reflex found in infants of humans and most primates. When any object is placed in an infant&apos;s palm, the fingers flex reflexively around the object</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gynecomastia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gynecomastia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/endocrine_symptoms"/>
        <Example_1>breast swelling</Example_1>
        <Example_2>enlarged breasts</Example_2>
        <untitled-ontology-57:CUI>C0018418</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Gynecomastia is a condition that makes breast tissue swell in boys and men.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hallucination -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hallucination">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/altered_behavior"/>
        <Example_1>a perception of an external stimulus object in the absence of such an object.</Example_1>
        <Example_2>a sense perception without a source in the external world</Example_2>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0000738</HPO>
        <untitled-ontology-57:CUI>C0018524</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7011001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>subjectively experienced sensations in the absence of an appropriate stimulus, but which are regarded by the individual as real; may be of organic origin, drug induced, or associated with a mental disorder.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hallucination_auditory -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hallucination_auditory">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hallucination"/>
        <Example_1>a hallucination involving the sense of hearing.</Example_1>
        <Example_1>hearing voices that were not real</Example_1>
        <Example_2>perception of hearing voices or sounds that are not there</Example_2>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0008765</HPO>
        <synonym_1>paracusia</synonym_1>
        <synonym_2>paracusis</synonym_2>
        <untitled-ontology-57:CUI>C0233762</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">45150006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Perception of sound in the absence of a corresponding stimulus.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hallucination_olfactory -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hallucination_olfactory">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hallucination"/>
        <Example_1>Perception of a smell in the absence of a corresponding stimulus.</Example_1>
        <Example_2>olfactory hallucination</Example_2>
        <Example_3>hallucination  of smell.</Example_3>
        <synonym_1>phantosmia</synonym_1>
        <untitled-ontology-57:CUI>C0233765</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">39672001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An olfactory hallucination (phantosmia) makes you detect smells that aren&apos;t really present in your environment. The odors detected in phantosmia vary from person to person and may be foul or pleasant. They can occur in one or both nostrils. The phantom smell may seem to always be present or it may come and go</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hallucination_visual -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hallucination_visual">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hallucination"/>
        <Example_1>a hallucination involving the sense of sight</Example_1>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0002367</HPO>
        <synonym_1>visual hallucination</synonym_1>
        <synonym_2>Seeing objects that were not there.</synonym_2>
        <synonym_3>Seeing people that were not there.</synonym_3>
        <untitled-ontology-57:CUI>C0233763</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">64269007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Optical perception of an object, person or event in the absence of a corresponding stimulus.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hand_grip_myotonia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hand_grip_myotonia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/myotonia"/>
        <Example_1>difficulty relaxing handgrip</Example_1>
        <Example_2>difficulty relaxing hand grip</Example_2>
        <Example_3>prolonged hand grip</Example_3>
        <untitled-ontology-57:CUI>C1868623</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Difficulty releasing one&apos;s grip associated with prolonged first handgrip relaxation times.</rdfs:isDefinedBy>
        <rdfs:seeAlso>difficulty releasing handgrip</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/harmful_thoughts -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/harmful_thoughts">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/threatening_behavior"/>
        <untitled-ontology-57:CUI>C0438698</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">162314006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Thoughts about harming onself or others.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/head_finding -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/head_finding">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#sign"/>
        <untitled-ontology-57:CUI>C1320354</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Top</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">406122000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Any finding involving the head such as macrocephaly or microcephaly.</rdfs:isDefinedBy>
        <rdfs:seeAlso>Any finding involving the head such as macrocephaly or microcephaly.</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/headache -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/headache">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain"/>
