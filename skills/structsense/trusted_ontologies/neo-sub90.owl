        <rdfs:isDefinedBy>Incapability to ambulate.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/inappropriate_behavior -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/inappropriate_behavior">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/altered_behavior"/>
        <Example_1>socially inappropriate.</Example_1>
        <Example_2>inappropriate behavior.</Example_2>
