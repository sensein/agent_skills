        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypotonia"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0008936</HPO>
        <untitled-ontology-57:CUI>C1853743</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#impaired_caloric_testing -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#impaired_caloric_testing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/vestibulo-ocular_reflex_abnormal"/>
        <untitled-ontology-57:CUI>C1848642</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>n medicine, the caloric reflex test (sometimes termed &apos;vestibular caloric stimulation&apos;) is a test of the vestibulo-ocular reflex that involves irrigating cold or warm water or air into the external auditory canal.   Caloric testing is abnormal when cold or warm stimuli do not produce expected eye movements or nystagmus.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#impaired_climbing_stairs -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#impaired_climbing_stairs">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/difficulty_walking"/>
        <untitled-ontology-57:CUI>C0239067</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Difficulty in climbing stairs due to weakness or unsteadiness.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#impaired_comprehension -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#impaired_comprehension">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#abnormality_of_higher_mental_function"/>
        <Example_1>Reduced comprehension.</Example_1>
        <Example_2>Limited comprehension.</Example_2>
        <Example_3>Difficulty following written or verbal commands due to lack of comprehension.</Example_3>
        <synonym_1>Unable to follow commands</synonym_1>
        <synonym_2>Did not follow 3-step commands</synonym_2>
        <synonym_3>Did not follow 1-step commands</synonym_3>
        <untitled-ontology-57:CUI>C0239083</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>An impairment in understanding language or speech.  Reduced comprehension.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#impaired_heel_shin_test -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#impaired_heel_shin_test">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ataxia_appendicular"/>
        <untitled-ontology-57:CUI>C0427189</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">250066004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The heel to shin test is a measure of coordination and may be abnormal if there is loss of motor strength, proprioception or a cerebellar lesion. If motor and sensory systems are intact, an abnormal, asymmetric heel to shin test is highly suggestive of an ipsilateral cerebellar lesion.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#impaired_social_interactions -->

