        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A severe headache of sudden onset.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/headache_throbbing -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/headache_throbbing">
