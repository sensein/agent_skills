        <Example_3>Decreased alertness.</Example_3>
        <untitled-ontology-57:CUI>C2712027</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">704426000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A state of decreased responsiveness.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_anal_reflex -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_anal_reflex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cutaneous_reflex_finding"/>
        <Example_1>Stroking skin around the anus did not elicit an anal reflex</Example_1>
        <Example_2>absent anal wink</Example_2>
        <Example_3>absent anal reflex</Example_3>
        <synonym_1>anal wink absent</synonym_1>
        <synonym_2>negative anal reflex</synonym_2>
        <untitled-ontology-57:CUI>C0751471</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">299865000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The anal wink, anal reflex, perineal reflex, or anocutaneous reflex is the reflexive contraction of the external anal sphincter upon stroking of the skin around the anus.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_ankle_reflex -->

