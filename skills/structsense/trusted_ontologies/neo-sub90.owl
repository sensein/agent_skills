    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#impulsive_character -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#impulsive_character">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impulsive"/>
        <untitled-ontology-57:CUI>C0564567</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>An impulsive behavior is when you act quickly with no thought to the consequences. There’s nothing on your mind beyond that exact moment.</rdfs:isDefinedBy>
    </owl:Class>
    


