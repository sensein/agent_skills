        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Galactorrhea: The spontaneous flow of milk from the nipple at any time other than during nursing.</rdfs:isDefinedBy>
    </owl:Class>
    


