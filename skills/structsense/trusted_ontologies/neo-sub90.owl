        <Example_1>Impaired radial reflex.</Example_1>
        <Example_2>Impaired radial reflex.</Example_2>
        <Example_3>Decreased supinator reflex.</Example_3>
        <synonym_1>Decreased supinator jerk.</synonym_1>
        <synonym_2>Diminished supinator reflex.</synonym_2>
        <synonym_3>Diminished supinator jerk.</synonym_3>
        <untitled-ontology-57:CUI>C0576586</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">299837002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Reduced radial or supinator reflex.</rdfs:isDefinedBy>
        <rdfs:seeAlso>decreased_radial_reflex</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_swallowing -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_swallowing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cranial_nerve_9_10_finding"/>
        <untitled-ontology-57:CUI>C4061143</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">288939007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An inability to swallow liquids and solids properly.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_tandem_gait -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_tandem_gait">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_difficulty"/>
        <Example_1>Unable to walk heel to toe.</Example_1>
        <Example_2>Unsteady when walking heel to toe.</Example_2>
        <Example_3>Unable to walk a straight line heel to toe.</Example_3>
        <synonym_1>Abnormal tandem gait.</synonym_1>
        <synonym_2>Unable to walk tandem.</synonym_2>
        <synonym_3>Tandem gait impaired.</synonym_3>
        <untitled-ontology-57:CUI>C3275367</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">401211005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Reduced ability to walk in a straight line while placing the feet heal to toe</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_triceps_reflex -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_triceps_reflex">
