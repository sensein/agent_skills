        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">563001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>involuntary, rapid, rhythmic movement of the eyeball</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/nystagmus_ataxic -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/nystagmus_ataxic">
