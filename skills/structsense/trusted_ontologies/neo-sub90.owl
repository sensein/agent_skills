    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/paroxysmal_dystonia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/paroxysmal_dystonia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonia"/>
        <untitled-ontology-57:CUI>C0393588</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">230310003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Paroxysmal dystonia is a neurological movement disorder characterised by continuous or intermittent muscle contractions which cause abnormal, often painful, repetitive movements in the face or body that are only visible during episodes.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/partial_hearing_loss -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/partial_hearing_loss">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_hearing"/>
        <untitled-ontology-57:CUI>C0018772</untitled-ontology-57:CUI>
