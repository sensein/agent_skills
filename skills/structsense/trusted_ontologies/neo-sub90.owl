        <Example_1>amyotrophy</Example_1>
        <Example_2>muscle wasting</Example_2>
        <Example_3></Example_3>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0003202</HPO>
        <untitled-ontology-57:CUI>C0026846</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">88092000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A process, occurring in the muscle, that is characterized by a decrease in protein content, fiber diameter, force production and fatigue resistance in response to different conditions such as starvation, aging and disuse.</rdfs:isDefinedBy>
        <rdfs:seeAlso>amyotrophy; muscle_wasting</rdfs:seeAlso>
    </owl:Class>
    


