        <untitled-ontology-57:CUI>C2316460</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Pseudobulbar affect (PBA) is a condition that&apos;s characterized by episodes of sudden uncontrollable and inappropriate laughing or crying</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#pseudobulbar_behavioral_symptoms -->

