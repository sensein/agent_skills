        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/urinary_symptoms"/>
        <Example_1>neurogenic bladder</Example_1>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0000011</HPO>
        <untitled-ontology-57:CUI>C0005697</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A type of bladder dysfunction caused by neurologic damage. Neurogenic bladder can be flaccid or spastic. Common manifestatios of neurogenic bladder are overflow incontinence, frequency, urgency, urge incontinence, and retention.</rdfs:isDefinedBy>
    </owl:Class>
    


