        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_eye_movement"/>
        <untitled-ontology-57:CUI>C0234649</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">79161002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Impaired eye movements involved in directed gaze. Saccades are rapid eye movements designed to shift the fovea to objects of visual interest. Abnormalities of saccades offer important clues in the diagnosis of a number of movement disorders.</rdfs:isDefinedBy>
        <rdfs:seeAlso>ocular_dysmetria</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_saddle_sensation -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_saddle_sensation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#sensory_change"/>
        <Example_1>Loss of sensation in the saddle area.</Example_1>
        <Example_2>Impaired sensation in the perineal area.</Example_2>
        <Example_3>Loss of sensation in the perineal area.</Example_3>
        <synonym_1>saddle anesthesia.</synonym_1>
        <untitled-ontology-57:CUI>C3266098</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">449813001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Loss of sensation in the perineal and groin areas.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_short_term_memory -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_short_term_memory">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_memory"/>
        <untitled-ontology-57:CUI>C0701811</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">247592009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Failure to retrieve memories from short term memory, usually measured in minutes to hours.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_smooth_pursuit -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_smooth_pursuit">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_eye_movement"/>
        <untitled-ontology-57:CUI>C0155382</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">194176002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>When the patient is tracking your finger, the eyes should move smoothly (known as ‘smooth pursuit’). In cerebellar lesions, pursuit can be “jerky” or “saccadic”( i.e. made up of lots of small movements).</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_speech -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_speech">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#abnormality_of_higher_mental_function"/>
        <Example_1>speech is abnormal</Example_1>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0002167</HPO>
        <synonym_1>deficient speech</synonym_1>
        <synonym_2>speech impaired</synonym_2>
        <synonym_3>speech abnormality</synonym_3>
        <untitled-ontology-57:CUI>C0566622</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">106132005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Findings of speech (excluding aphasia) include altered volume, altered articulation, altered prosody, and altered fluency.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_speech_fluency -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_speech_fluency">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#dysfluency"/>
        <untitled-ontology-57:CUI>C0454533</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">39423001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An impairment in the ease with which speech is generated.  Non fluent speech is hestitant and halting and lacks an easy flow of words.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_supinator_reflex -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_supinator_reflex">
