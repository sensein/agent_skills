        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">307700006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A discrepancy in the movements of the two eyes, possibly associated with cerebellar disease or gaze paresis.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/nystagmus_horizontal -->

