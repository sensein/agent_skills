        <untitled-ontology-57:CUI>C4280873</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>a foot drop of the left foot.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/left_homonymous_hemianopia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/left_homonymous_hemianopia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hemianopia_homonymous"/>
        <untitled-ontology-57:CUI>C0271204</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">55634009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A loss of the left visual field in both eyes.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/left_proptosis -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/left_proptosis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/proptosis"/>
        <untitled-ontology-57:CUI>C2126062</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Bulging forward of the left eye.</rdfs:isDefinedBy>
        <rdfs:seeAlso>left_exophthalmos</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/left_sided_headache -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/left_sided_headache">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/headache"/>
        <untitled-ontology-57:CUI>C2168110</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Headache on the left side.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/legs_ataxic -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/legs_ataxic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ataxia_appendicular"/>
        <untitled-ontology-57:CUI>C0427188</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Appendicular ataxia in the legs</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/lethargy -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/lethargy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/drowsy"/>
        <Example_1>lethargic</Example_1>
        <Example_2>Difficult to arouse.</Example_2>
        <untitled-ontology-57:CUI>C0023380</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">214264003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The sensation of struggling to remain awake. A condition marked by drowsiness and an unusual lack of energy and mental alertness. It can be caused by many things</rdfs:isDefinedBy>
        <rdfs:seeAlso>drowsy</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/lightheadedness -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/lightheadedness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/consitutitional_symptoms"/>
        <Example_1>Close to passing out.</Example_1>
        <synonym_1>faintness</synonym_1>
        <synonym_3>woozy</synonym_3>
        <untitled-ontology-57:CUI>C0220870</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">386705008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Lightheadedness is a feeling of faintness, dizziness, or being close to passing out.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/limb_rigidity -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/limb_rigidity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/rigidity"/>
        <untitled-ontology-57:CUI>C0858572</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>An increase in tone and resistance to passive movement in any limb.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/limb_spasticity -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/limb_spasticity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/spasticity"/>
        <untitled-ontology-57:CUI>C2678242</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Increased tone and spasticity in a limb.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/limited_eye_movements -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/limited_eye_movements">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#gaze_limitation"/>
        <untitled-ontology-57:CUI>C0522328</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">419326002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A limitation in horizontal or vertical eye movements.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/literal_paraphasia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/literal_paraphasia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/paraphasia"/>
        <synonym_1>phonological paraphasia</synonym_1>
        <synonym_2>phonemic paraphasia</synonym_2>
        <untitled-ontology-57:CUI>C0234490</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">23869008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A sound substitution error in speaking or naming.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/locked_in_syndrome -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/locked_in_syndrome">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/quadriplegia"/>
        <untitled-ontology-57:CUI>C0023944</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">38023001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>a medical condition, usually resulting from a stroke that damages part of the brainstem, in which the body and most of the facial muscles are paralyzed but consciousness remains and the ability to perform certain eye movements is preserved.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_initiative -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_initiative">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abulia"/>
        <untitled-ontology-57:CUI>C2364087</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">276306002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A loss of initiative is often a manifestation of pre-frontal dysfunction and abulia with an inability to initiate actions even on command.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_of_control_of_movement -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_of_control_of_movement">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/neuromuscular_symptoms"/>
        <Example_1>Movements are poorly controlled.</Example_1>
        <Example_2>Limited control of movements.</Example_2>
        <untitled-ontology-57:CUI>C0427084</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">249961009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Poor control of movements.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_of_equilibrium -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_of_equilibrium">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/balance_finding"/>
        <Example_1>Lack of equilibrium.</Example_1>
        <Example_2>disequilibrium</Example_2>
        <Example_3>Poor balance.</Example_3>
        <untitled-ontology-57:CUI>C0278126</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">89419008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A loss of equilibrium is defined by an inability to stand upright.</rdfs:isDefinedBy>
        <rdfs:seeAlso>disequilibrium</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_of_executive_functions -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_of_executive_functions">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/executive_dysfunction"/>
        <untitled-ontology-57:CUI>C4544271</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">736317001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The executive functions of the brain are often associated with the pre-frontal cortex and include such activities as planning, organizing, censoring, initiating, persevering, and insight.  Deficits in executive functions include disinhibition, inappropriate jocularity, socially inappropriate behavior, abulia, disorganization, confabulation, impersistence, and perseveration.</rdfs:isDefinedBy>
        <rdfs:seeAlso>impaired_executive_functions</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_of_facial_expression -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_of_facial_expression">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#expressionless_face"/>
        <untitled-ontology-57:CUI>C1852476</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A loss of ability to use facial muscles to express emotion.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_of_pain_and_temperature_sensation -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_of_pain_and_temperature_sensation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/decreased_pain_and_temperature_sensation"/>
        <untitled-ontology-57:CUI>C2749793</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Sensory</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>An impaired ability to sense pain, heat, and cold. Pain is usually tested with a sterile pin with a light prick of the skin.  Temperature sensation can be tested with test tubes filled with water of varying temperatures of by using objects with differing thermal conductivity.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_of_reflexes_in_lower_limbs -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_of_reflexes_in_lower_limbs">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/areflexia_lower_limbs"/>
        <Example_1>Absent reflexes in lower limb.</Example_1>
        <Example_2>Absent reflexes in lower extremity.</Example_2>
        <Example_3>Absent reflexes in legs.</Example_3>
        <untitled-ontology-57:CUI>C4227344</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Absence of reflexes in the legs.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_of_temperature_sensation -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_of_temperature_sensation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_of_pain_and_temperature_sensation"/>
        <untitled-ontology-57:CUI>C4021222</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Sensory</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>An inability to sense temperature.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/lower_facial_weakness -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/lower_facial_weakness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_paresis"/>
        <untitled-ontology-57:CUI>C0427056</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">249932008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Weakness involving muscle of the lower face.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/lower_limb_amyotrophy -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/lower_limb_amyotrophy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#lower_limb_atrophy"/>
        <Example_1>wasting of leg muscles.</Example_1>
        <Example_2>atrophy of lower limb muscles.</Example_2>
        <Example_3>amyotrophy of leg muscles.</Example_3>
        <synonym_1>atrophy of leg.</synonym_1>
        <synonym_2>amyotrophy of leg.</synonym_2>
        <synonym_3>wasting leg muscles.</synonym_3>
        <untitled-ontology-57:CUI>C4024921</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Muscular atrophy affecting the lower limb</rdfs:isDefinedBy>
        <rdfs:seeAlso>lower_limb_amyotrophy</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/lower_limb_hyperreflexia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/lower_limb_hyperreflexia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/brisk_tendon_reflex"/>
        <Example_1>Hyperreflexia at knee reflex and ankle reflex</Example_1>
        <Example_2>Increased reflexes at knee reflex and ankle reflex</Example_2>
        <synonym_1>Hyperreflexia of knee reflex and ankle reflex.</synonym_1>
        <synonym_2>Hyperreflexia at knee and ankle.</synonym_2>
        <untitled-ontology-57:CUI>C1836696</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Increased reflexes in the lower extremities.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/lower_limb_nerve_lesion -->

