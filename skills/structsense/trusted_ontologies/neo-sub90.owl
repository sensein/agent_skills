        <synonym_2>language delay</synonym_2>
        <untitled-ontology-57:CUI>C0023012</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A language delay is a language disorder in which a child fails to develop language abilities at the usual age-appropriate period in their developmental timetable.</rdfs:isDefinedBy>
    </owl:Class>
    


