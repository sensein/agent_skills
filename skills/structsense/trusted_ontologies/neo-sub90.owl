        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">394679006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Increased tone and spasticity in the leg.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/lumbar_root_injury -->

