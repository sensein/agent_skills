        <rdfs:isDefinedBy>Muscular atrophy affecting proximally located muscles of the legs, i.e., of the thigh.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/muscle_atrophy_shoulder -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/muscle_atrophy_shoulder">
