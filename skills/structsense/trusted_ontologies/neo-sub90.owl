        <untitled-ontology-57:CUI>C1834857</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Sensory</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Loss of proprioception and vibration sensation distally</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/distractible -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/distractible">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_attention"/>
        <Example_1>distractibility</Example_1>
        <Example_2>Easily distracted.</Example_2>
        <untitled-ontology-57:CUI>C0233415</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">28102002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A state of being easily distracted from a task or other focus of attention.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disturbance_of_consciousness -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disturbance_of_consciousness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/altered_consciousness"/>
        <Example_1>impaired level of consciousness</Example_1>
        <Example_2>altered consciousness</Example_2>
        <untitled-ontology-57:CUI>C0234428</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3006004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Any change in the level of consciousness from a norma state of alertness.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dizziness -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dizziness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ENT_symptoms"/>
        <synonym_1>woozy</synonym_1>
        <synonym_2>wobbly</synonym_2>
        <untitled-ontology-57:CUI>C0012833</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Dizziness is a term used to describe a range of sensations, such as feeling faint, woozy, weak or unsteady.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/downbeat_nystagmus -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/downbeat_nystagmus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/nystagmus_vertical"/>
        <untitled-ontology-57:CUI>C0585544</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">307676006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Downbeat nystagmus is a type of fixation nystagmus with the fast phase beating in a downward direction. It generally increases when looking to the side and down and when lying prone.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/drooling -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/drooling">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ENT_symptoms"/>
        <synonym_1>excessive saliva production</synonym_1>
        <synonym_2>saliva flowing outside the mouth.</synonym_2>
        <untitled-ontology-57:CUI>C0013132</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">62718007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Drooling is defined as saliva flowing outside of your mouth unintentionally. It&apos;s often a result of weak or underdeveloped muscles around your mouth, or having too much saliva.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/droopy_eyelids -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/droopy_eyelids">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/eyelid_ptosis"/>
        <untitled-ontology-57:CUI>C0423131</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Bilateral ptosis of the eyelids.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/drop_attacks -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/drop_attacks">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#sleep_disturbance"/>
        <Example_1>Sudden attacks with falling to the ground</Example_1>
        <Example_2>drop attacks</Example_2>
        <untitled-ontology-57:CUI>C0259813</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">61683000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Drop attacks are sudden spontaneous falls while standing or walking, with complete recovery in seconds or minutes. There is usually no recognized loss of consciousness and the event is remembered.  It is a symptom, not a diagnosis, and it can have diverse causes.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/drowsy -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/drowsy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_alertness"/>
        <Example_1>drowsiness</Example_1>
        <Example_2>drowsy.</Example_2>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0002329</HPO>
        <untitled-ontology-57:CUI>C0013144</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">271782001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The sensation of struggling to remain awake. A condition marked by drowsiness and an unusual lack of energy and mental alertness. It can be caused by many things</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/drowsy_on_examination -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/drowsy_on_examination">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/drowsy"/>
        <Example_1>drowsy.</Example_1>
        <untitled-ontology-57:CUI>C0436584</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">162704004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The sensation of struggling to remain awake. A condition marked by drowsiness and an unusual lack of energy and mental alertness. It can be caused by many things</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/drusen_of_optic_disc -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/drusen_of_optic_disc">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/optic_disc_finding"/>
        <Example_1>Optic disk bodies composed primarily of acid mucopolysaccharides that may produce pseudopapilledema (elevation of the optic disk without associated INTRACRANIAL HYPERTENSION) and visual field deficits.</Example_1>
        <synonym_1>optic disk Drusen</synonym_1>
        <synonym_2>Optic nerve Drusen</synonym_2>
        <synonym_3>Hyaline bodies of optic disc</synonym_3>
        <untitled-ontology-57:CUI>C0029128</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">33629003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Optic disc drusen are acellular, calcified deposits within the optic nerve head. Optic disc drusen are congenital and developmental anomalies of the optic nerve head, representing hyaline-containing bodies that, over time, appear as elevated, lumpy irregularities on the anterior portion of the optic nerve.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dry_eye -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dry_eye">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/visual_symptoms"/>
        <untitled-ontology-57:CUI>C0314719</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">302896008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Dry eye with inadequate lubrication or tears</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dry_mouth -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dry_mouth">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ENT_symptoms"/>
        <synonym_1>xerostomia</synonym_1>
        <untitled-ontology-57:CUI>C0043352</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">87715008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Dry mouth, or xerostomia (zeer-o-STOE-me-uh), refers to a condition in which the salivary glands in your mouth don&apos;t make enough saliva to keep your mouth wet.</rdfs:isDefinedBy>
        <rdfs:seeAlso>xerostomia</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysarthria -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysarthria">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_speech"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0001260</HPO>
        <untitled-ontology-57:CUI>C0013362</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8011004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>imperfect speech articulation due to disturbances of muscular control.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysarthria_ataxic -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysarthria_ataxic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysarthria"/>
        <synonym_1>cerebellar dysarthria</synonym_1>
        <untitled-ontology-57:CUI>C0454599</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">229687004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Common clinical features of ataxic dysarthria include abnormalities in speech modulation, rate of speech, explosive or scanning speech, slurred speech, irregular stress patterns, and vocalic and consonantal misarticulation.</rdfs:isDefinedBy>
        <rdfs:seeAlso>cerebellar_dysarthria</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysarthria_flaccid -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysarthria_flaccid">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysarthria"/>
        <untitled-ontology-57:CUI>C0454597</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">229685007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A dysarthria caused by a lower motor neuron lesion or primary muscular problem.</rdfs:isDefinedBy>
        <rdfs:seeAlso>lower_motor_neuron_type_dysarthria; bulbar_type_dysarthria</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysarthria_hypokinetic -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysarthria_hypokinetic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysarthria"/>
        <untitled-ontology-57:CUI>C2017999</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">229688009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A dysarthria caused by hypokinesia as seen in Parkinson disease.</rdfs:isDefinedBy>
        <rdfs:seeAlso>extrapyradimal_type_dysarthria</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysarthria_mixed -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysarthria_mixed">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysarthria"/>
        <untitled-ontology-57:CUI>C0454598</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">229686008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A dysarthria that has both flaccid and spastic components.</rdfs:isDefinedBy>
        <rdfs:seeAlso>combined_flaccid_and_spastic_dysarthria</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysarthria_scanning -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysarthria_scanning">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysarthria_ataxic"/>
        <untitled-ontology-57:CUI>C0240952</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Scanning speech characterized by long pauses between syllables and words with loss of melody in speech production, is another type of dysarthria. The term explosive speech is sometimes used to describe intermittent episodes of loud, rapid speech production.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysarthria_spastic -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysarthria_spastic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysarthria"/>
        <untitled-ontology-57:CUI>C0454596</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">229684006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A type of dysarthria related to bilateral damage of the upper motor neuron tracts of the pyramidal and extra- pyramidal tracts. Speech of affected individuals is slow, effortful, and has a harsh vocal quality.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dyscalculia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dyscalculia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Gerstmann_syndrome"/>
        <untitled-ontology-57:CUI>C0869474</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">55640002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An acquired inability to calculate.</rdfs:isDefinedBy>
        <rdfs:seeAlso>acalculia</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysconjugate_eye_movements -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysconjugate_eye_movements">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysconjugate_gaze"/>
        <untitled-ontology-57:CUI>C1845274</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Dysconjugate gaze is a failure of the eyes to turn together in the same direction</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysconjugate_gaze -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysconjugate_gaze">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_eye_movement"/>
        <untitled-ontology-57:CUI>C0522335</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">103263007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Dysconjugate gaze is a failure of the eyes to turn together in the same direction</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysdiadochokinesis -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysdiadochokinesis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ataxia_appendicular"/>
        <Example_1>unable to do rapid alternating movements</Example_1>
        <Example_2>impaired rapid alternating movements</Example_2>
        <Example_3>Unable to rapidly supinate and pronate the hand</Example_3>
        <untitled-ontology-57:CUI>C0234979</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">23133003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Dysdiadochokinesia is the inability to rapidly perform alternating movements such as having a subject pronating and supinating their hands.</rdfs:isDefinedBy>
        <rdfs:seeAlso>dysdiadochokokinesia: impaired_rapid_alternating_movements</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysesthesias -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysesthesias">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sensory_finding"/>
        <Example_1>unpleasant sensations</Example_1>
        <untitled-ontology-57:CUI>C0392699</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Sensory</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">279079003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Abnormal sensations with no apparent physical cause that are painful or unpleasant.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dyskinesia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dyskinesia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyperkinesia"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0100660</HPO>
        <untitled-ontology-57:CUI>C0013384</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9748009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Dyskinesia is defined as abnormal, uncontrollable, involuntary movements. There are many different types of dyskinesia with symptoms that range from minor tics to full-body movements.</rdfs:isDefinedBy>
        <rdfs:isDefinedBy>a disease characterized by abnormal involuntary movements of muscles</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysmetria -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysmetria">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ataxia_appendicular"/>
        <untitled-ontology-57:CUI>C0234162</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">32566006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A type of ataxia characterized by the inability to carry out movements with the correct range and motion across the plane of more than one joint related to incorrect estimation of the distances required for targeted movements.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysmnesic_seizure -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysmnesic_seizure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/complex_partial_seizure"/>
        <untitled-ontology-57:CUI>C0422859</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A seizure that impairs memory, usually a complex partial seizure.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysmorphic_face -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysmorphic_face">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/head_finding"/>
        <Example_1>abnormal facial features</Example_1>
        <Example_2>dysmorphic face</Example_2>
        <Example_3>abnormal facies</Example_3>
        <untitled-ontology-57:CUI>C0424503</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Head</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">248200007</untitled-ontology-57:SNOMED>
        <rdfs:comment></rdfs:comment>
        <rdfs:isDefinedBy>Abnormal facial shape.</rdfs:isDefinedBy>
        <rdfs:seeAlso>Abnormal facial shape; Abnormal morphology of the face; Distinctive facies; Dysmorphic facial features;Dysmorphic facies; Facial dysmorphism; Unusual facial appearance; Unusual facies</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysphagia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysphagia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_swallowing"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0002015</HPO>
        <untitled-ontology-57:CUI>C0011168</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">40739000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A disorder characterized by difficulty in swallowing.</rdfs:isDefinedBy>
        <rdfs:seeAlso>difficulty_swallowing</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysphasia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysphasia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0002357</HPO>
        <untitled-ontology-57:CUI>C0973461</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20301004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An alternate term for aphasia, sometimes used to describe less severe cases of aphasia.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dyspnea -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dyspnea">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/respiratory_symptoms"/>
        <Example_1>Labored breathing.</Example_1>
        <Example_2>Difficulty breathing.</Example_2>
        <Example_3>Shortness of breath.</Example_3>
        <synonym_1>short of breath.</synonym_1>
        <untitled-ontology-57:CUI>C0013404</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">230145002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Difficulty in breathing. The physical presentation of respiratory distress is generally referred to as labored breathing, while the sensation of respiratory distress is called shortness of breath or dyspnea.</rdfs:isDefinedBy>
        <rdfs:seeAlso>shortness_of_breath</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysprosody -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysprosody">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_speech"/>
        <untitled-ontology-57:CUI>C0854737</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A speech disorder in which the melody and rhythm of speeech fails to correctly convey the intended emotion of the speaker.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyperkinesia"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0001332</HPO>
        <untitled-ontology-57:CUI>C0013421</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15802004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An abnormally increased muscular tone that causes fixed abnormal postures. There is a slow, intermittent twisting motion that leads to exaggerated turning and posture of the extremities and trunk.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonia_1 -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonia_1">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonic_disorder"/>
        <Example_1>early onset torsion dystonia</Example_1>
        <Example_2>Oppenheim dystonia</Example_2>
        <synonym_1>DYT1</synonym_1>
        <synonym_2>early onset primary dystonia</synonym_2>
        <synonym_3>dystonia musculorum deformans</synonym_3>
        <untitled-ontology-57:CUI>C4016919</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>An autosomal dominant inherited disorder caused by mutations in the TOR1A gene. It usually begins in childhood or adolescence and is characterized by involuntary muscle contractions in the arms, legs, trunk, and neck.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonia_facial -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonia_facial">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#focal_dystonia"/>
        <untitled-ontology-57:CUI>C1395979</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Dystonia of the Jaw and Facial Muscles. Oromandibular dystonia, sometimes referred to as cranial dystonia, is characterized by forceful muscle contractions of the face, jaw, and/or tongue.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonia_limb -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonia_limb">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#focal_dystonia"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0002451</HPO>
        <untitled-ontology-57:CUI>C0751093</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A type of dystonia (abnormally increased muscular tone causing fixed abnormal postures) that affects muscles of the limbs.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonia_lower_limb -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonia_lower_limb">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonia_limb"/>
        <Example_1>lower limb dystonia</Example_1>
        <Example_2>leg dystonia</Example_2>
        <Example_3>dystonic posture of leg</Example_3>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0031959</HPO>
        <untitled-ontology-57:CUI>C2677696</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Dystonic posturing or dystonia in the leg.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonia_oromandibular -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonia_oromandibular">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonia_facial"/>
        <untitled-ontology-57:CUI>C2242577</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A kind of focal dystonia characterized by forceful contractions of the face, jaw, or tongue causing difficulty in opening and closing the mouth and often affecting chewing and speech.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonia_truncal -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonia_truncal">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonic_disorder"/>
        <untitled-ontology-57:CUI>C4228843</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Truncal dystonia is characterized by involuntary contractions and postures of the paraspinal, abdominal or chest muscles. Idiopathic truncal dystonia of adult onset has only been previously described in a few case reports and small case series</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonia_upper_limb -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonia_upper_limb">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonia_limb"/>
        <untitled-ontology-57:CUI>C1843267</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Dystonic posturing involving the arms</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonic_disorder -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonic_disorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonia"/>
        <untitled-ontology-57:CUI>C0393593</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15802004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>syndrome dominated by involuntary, sustained or spasmodic, patterned, and repetitive muscle contractions; frequently causing twisting, flexing or extending, and squeezing movements or abnormal postures.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonic_posture -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonic_posture">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonia"/>
        <untitled-ontology-57:CUI>C0426961</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">249847000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Patients with dystonia may experience uncontrollable twisting, repetitive movements or abnormal postures and positions. These can affect any part of the body, including the arms, legs, trunk, face and vocal cords.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ear_pressure -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ear_pressure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ENT_symptoms"/>
        <untitled-ontology-57:CUI>C0522347</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">162403009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A sensation of pressure within the ear.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/echolalia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/echolalia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_speech"/>
        <synonym_1>echo speech</synonym_1>
        <untitled-ontology-57:CUI>C0013528</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">64712007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The tendency to repeat vocalizations made by another person.</rdfs:isDefinedBy>
        <rdfs:seeAlso>echo_speech</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/encephalopathy -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/encephalopathy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_cognition"/>
        <untitled-ontology-57:CUI>C0085584</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">81308009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Encephalopathy is a term that means brain disease, damage, or malfunction. In general, encephalopathy is manifested by an altered mental state.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/end_position_nystagmus -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/end_position_nystagmus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/nystagmus_horizontal"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0000640</HPO>
        <untitled-ontology-57:CUI>C0271390</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">29356006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Nystagmus made apparent by looking to the right or to the left.</rdfs:isDefinedBy>
        <rdfs:seeAlso>gaze_evoked_nystagmus</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/endocrine_symptoms -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/endocrine_symptoms">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/symptom"/>
        <untitled-ontology-57:CUI>C2216346</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Symptoms related to the endocrine system such as fatigue, weight gain, weight loss, etc.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/enlarged_blind_spot -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/enlarged_blind_spot">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/scotoma"/>
        <untitled-ontology-57:CUI>C0152192</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">33970004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Enlargement of the blindspot, may be associated with retinopathy or other findings.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/episodic -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/episodic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/course"/>
        <untitled-ontology-57:CUI>C1455761</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Course</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">278499009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Applied to a sign, symptom, or other manifestation that occurs multiple times at usually irregular intervals. The occurences are separated by an interval in which the sign, symptom, or manifestation is not present.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/epistaxis -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/epistaxis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ENT_symptoms"/>
        <synonym_1>epistaxis</synonym_1>
        <synonym_2>nose bleed</synonym_2>
        <untitled-ontology-57:CUI>C0014591</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">249366005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Bleeding from the nose.</rdfs:isDefinedBy>
        <rdfs:seeAlso>nose bleed</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/equivocal_plantar_response -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/equivocal_plantar_response">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/plantar_response"/>
        <Example_1>Partial Babinski sign.</Example_1>
        <Example_2>Equivocal Babinski sign.</Example_2>
        <untitled-ontology-57:CUI>C0422918</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">246589002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A partial or incomplete upturning of the great toe upon stimulation of the plantar aspect of the foot leading to an equivocal (inconclusive) plantar response reflex.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/excessive_tearing -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/excessive_tearing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tearing"/>
        <Example_1>watery eyes</Example_1>
        <Example_2>epiphora</Example_2>
        <synonym_1>excessive tears</synonym_1>
        <untitled-ontology-57:CUI>C0152227</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">418035005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Causes of epiphora are any that cause either overproduction of tears or decreased drainage of tears, resulting in tearing onto the cheek</rdfs:isDefinedBy>
        <rdfs:seeAlso>excessive tearing; watery eyes; epiphora</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/executive_dysfunction -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/executive_dysfunction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#abnormality_of_higher_mental_function"/>
        <Example_1>Loss of executive functions.</Example_1>
        <Example_2>Impaired executive functions.</Example_2>
        <untitled-ontology-57:CUI>C2748208</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A disorder of high order cognitive functions regarding planning, organization, and execution of actions and activities.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/expressive_aphasia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/expressive_aphasia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_Broca"/>
        <untitled-ontology-57:CUI>C0917814</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">229665008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>This is also called Broca&apos;s or nonfluent aphasia. People with this pattern of aphasia may understand what other people say better than they can speak. People with this pattern of aphasia struggle to get words out, speak in very short sentences and omit words</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/extensor_plantar_response_left -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/extensor_plantar_response_left">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Babinski_sign"/>
        <Example_1>left Babinski sign</Example_1>
        <Example_2>left upgoing toe</Example_2>
        <Example_3>left extensor plantar response.</Example_3>
        <untitled-ontology-57:CUI>C0576640</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">299891004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Upturning of the big toe (and sometimes fanning of the other toes) in response to stimulation of the sole of the foot. If the Babinski sign is present it can indicate damage to the corticospinal tract.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/extensor_plantar_response_right -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/extensor_plantar_response_right">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Babinski_sign"/>
        <Example_1>right extensor plantar response.</Example_1>
        <Example_2>right upgoing toe.</Example_2>
        <Example_3>right Babinski sign.</Example_3>
        <synonym_1>Positive Babinski on the right.</synonym_1>
        <untitled-ontology-57:CUI>C0576641</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">299892006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Upturning of the big toe (and sometimes fanning of the other toes) in response to stimulation of the sole of the foot. If the Babinski sign is present it can indicate damage to the corticospinal tract.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/extensor_plantar_responses_bilateral -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/extensor_plantar_responses_bilateral">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Babinski_sign"/>
        <Example_1>Bilateral upgoing toes.</Example_1>
        <Example_2>Both toes upgoing.</Example_2>
        <synonym_1>Bilateral Babinski sign.</synonym_1>
        <untitled-ontology-57:CUI>C0422917</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">246588005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Upturning of the big toe (and sometimes fanning of the other toes) in response to stimulation of the sole of the foot. If the Babinski sign is present it can indicate damage to the corticospinal tract.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/extensor_posture -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/extensor_posture">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/decerebrate_posture"/>
        <Example_1>Extension of arms and legs.</Example_1>
        <untitled-ontology-57:CUI>C1842657</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Extension of the arms and legs in an abnormal posture.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/extensor_rigidity -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/extensor_rigidity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/extensor_posture"/>
        <untitled-ontology-57:CUI>C0239325</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>An increase in extensor tone that is abnormal.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/extinction -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/extinction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/extinction_and_neglect"/>
        <untitled-ontology-57:CUI>C0015347</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">71778000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Failure to detect stimuli on one side of the body when the other side is simultaneously stimulated.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/extinction_and_neglect -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/extinction_and_neglect">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#abnormality_of_higher_mental_function"/>
        <untitled-ontology-57:CUI>C3481646</untitled-ontology-57:CUI>
