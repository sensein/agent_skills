        <Example_2>Poor school performance</Example_2>
        <untitled-ontology-57:CUI>C1821716</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A decrease in school performance as manifested by a drop in grades or other measures of achievement.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#decreased_speech -->

