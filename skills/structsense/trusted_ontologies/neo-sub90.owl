        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#chronic_pain_syndrome -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#chronic_pain_syndrome">
