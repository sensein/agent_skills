    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/deficient_saccades -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/deficient_saccades">
