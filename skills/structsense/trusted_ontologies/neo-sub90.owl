        <synonym_1>brisk finger jerks</synonym_1>
        <untitled-ontology-57:CUI>C0576595</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">299846008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Overactive finger reflexes</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/brisk_jaw_jerk -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/brisk_jaw_jerk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/brisk_tendon_reflex"/>
        <Example_1>positive jaw jerk</Example_1>
        <Example_2>brisk jaw jerk</Example_2>
        <Example_3>hyperactive jaw jerk</Example_3>
        <synonym_1>brisk jaw reflex</synonym_1>
        <synonym_2>hyperactive jaw reflex</synonym_2>
        <untitled-ontology-57:CUI>C0576553</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">299805003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>To elicit the jaw jerk, the examiner places an index finger over the jaw or chin, holding the mouth partly open, then gently taps the examiner&apos;s finger with the reflex hammer.  The the brisk jaw jerk may indicate a state of generalized hyperreflexia due to a supranuclear lesion such as stroke or ALS.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/brisk_knee_reflex -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/brisk_knee_reflex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/lower_limb_hyperreflexia"/>
        <untitled-ontology-57:CUI>C0576623</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">299874003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An abnormally active knee reflex.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/brisk_knee_reflexes -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/brisk_knee_reflexes">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/brisk_knee_reflex"/>
        <untitled-ontology-57:CUI>C1854027</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Overactive knee reflexes</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/brisk_reflexes -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/brisk_reflexes">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyperreflexia"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0001348</HPO>
        <synonym_1>brisk reflexes</synonym_1>
        <synonym_2>overactive reflexes</synonym_2>
        <untitled-ontology-57:CUI>C2673700</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Tendon reflexes that are noticably more active than usual (conventionally denoted 3+ on clinical examnation). Brisk reflexes may or may not indicate a neurological lesion. They are distinguished from hyperreflexia by the fact that hyerreflexia is characterized by hyperactive repeating (clonic) reflexes, which are considered to be always abnormal.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/brisk_supinator_reflex -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/brisk_supinator_reflex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/upper_limb_hyperreflexia"/>
        <synonym_1>brisk radial reflex</synonym_1>
        <synonym_2>brisk brachioradialis reflex</synonym_2>
        <untitled-ontology-57:CUI>C0576588</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">299839004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An abnormally active radial or supinator reflex.</rdfs:isDefinedBy>
        <rdfs:seeAlso>brisk radial reflex; brisk brachioradialis reflex</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/brisk_tendon_reflex -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/brisk_tendon_reflex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/brisk_reflexes"/>
        <Example_1>brisk reflexes.</Example_1>
        <Example_2>overactive reflexes.</Example_2>
        <Example_3>hyperactive reflexes.</Example_3>
        <untitled-ontology-57:CUI>C0522227</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">102983008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>overactive deep tendon reflexes</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/brisk_triceps_reflex -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/brisk_triceps_reflex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/upper_limb_hyperreflexia"/>
        <Example_1>brisk triceps jerk</Example_1>
        <Example_2>overactive triceps jerk</Example_2>
        <Example_3>increased triceps jerk.</Example_3>
        <synonym_1>increased triceps reflex</synonym_1>
        <synonym_2>hyperactive triceps reflex</synonym_2>
        <synonym_3>overactive triceps reflex</synonym_3>
        <untitled-ontology-57:CUI>C0576576</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">299827007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Overactive triceps reflex.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/bulbocavernosus_reflex_negative -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/bulbocavernosus_reflex_negative">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cutaneous_reflex_finding"/>
        <Example_1>The bulbocavernosus reflex was absent.</Example_1>
        <Example_2>The bulbocavernosus reflex could not be elicited.</Example_2>
        <Example_3>The bulbocavernosus reflex was negative.</Example_3>
        <untitled-ontology-57:CUI>C0576619</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">299870007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The test involves monitoring internal/external anal sphincter contraction in response to squeezing the glans penis or clitoris, or tugging on an indwelling Foley catheter. This reflex can also be tested electrophysiologically, by stimulating the penis or vulva and recording from the anal sphincter. This testing modality is used in intraoperative neurophysiology monitoring to verify the function of sensory and motor sacral roots as well as the conus medullaris.[1]</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/burning_sensation -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/burning_sensation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#sensory_change"/>
        <Example_1>burning pain.</Example_1>
        <Example_2>feeling of burning.</Example_2>
        <untitled-ontology-57:CUI>C0085624</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>An unpleasant sensation of pain as if the area has been burned.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cafe_au_lait_spots -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cafe_au_lait_spots">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/skin_finding"/>
        <Example_1>Hyperpigmented birth marks with chocolate color</Example_1>
        <Example_2>light brown hyperpigmented birth marks</Example_2>
        <untitled-ontology-57:CUI>C0221263</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Skin</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">201281002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Cafe au lait spots, or café au lait macules, are flat, hyperpigmented birthmarks. The name café au lait is French for &quot;coffee with milk&quot; and refers to their light-brown color. Cafe au lait lesions with rough borders (“coast of Maine”) may be seen in McCune-Albright syndrome.  In contrast, Café au lait lesions of neurofibromatosis have smooth borders (“coast of California&quot;).</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/calf_muscle_hypertrophy -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/calf_muscle_hypertrophy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypertrophy_of_lower_leg_muscles"/>
        <Example_1>Increased size of calf muscles</Example_1>
        <Example_2>enlarged calves</Example_2>
        <synonym_1>calf hypertrophy</synonym_1>
        <synonym_2>hypertrophic calves</synonym_2>
        <untitled-ontology-57:CUI>C1843057</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Muscle hypertrophy affecting the calf muscles.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cannot_shrug_shoulder -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cannot_shrug_shoulder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_of_trapezius"/>
        <Example_1>Unable to shrug shoulders</Example_1>
        <Example_2>Weak shoulder shrug</Example_2>
        <Example_3>Unable to elevate shoulders.</Example_3>
        <untitled-ontology-57:CUI>C0427049</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">249928002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Shoulder shrug is generally considered an action of the trapezius muscle, although the levator scapulae contributes to this action.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cardiomyopathy -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cardiomyopathy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cardiovascular_symptoms"/>
        <untitled-ontology-57:CUI>C0878544</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">85898001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Cardiomyopathy is a disease of the heart muscle that makes it harder for your heart to pump blood to the rest of your body. Cardiomyopathy can lead to heart failure.The main types of cardiomyopathy include dilated, hypertrophic and restrictive cardiomyopathy.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cardiovascular_symptoms -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cardiovascular_symptoms">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/symptom"/>
        <Example_2>cardiac symptoms.</Example_2>
        <untitled-ontology-57:CUI>C0476270</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Symptoms related to the heart or vascular system such as palpitations, chest pain, hypertension, or hypotension.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/carotid_bruit -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/carotid_bruit">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#bruits"/>
        <Example_1>bruit heard over carotid artery.</Example_1>
        <Example_2>Blowing sound heard over carotid artery.</Example_2>
        <untitled-ontology-57:CUI>C0007280</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Neck</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">419642000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A carotid bruit is a vascular murmur sound (bruit) heard over the carotid artery area on auscultation during systole.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cataplexy -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cataplexy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#sleep_disturbance"/>
        <Example_1>attacks of weakness with falling to the ground, usually provoked by an emotional event</Example_1>
        <Example_2>attacks of weakness with falling to ground</Example_2>
        <untitled-ontology-57:CUI>C0007384</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">46263000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>transient attack of weakness precipitated by emotional excitement; patient falls as if struck down.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cataract -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cataract">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pupil_finding"/>
        <synonym_1>cloudy lens</synonym_1>
        <synonym_2>lens opacity</synonym_2>
        <untitled-ontology-57:CUI>C0086543</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">128306009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A cataract is an opacity or clouding that develops in the crystalline lens of the eye or in its capsule</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/catatonia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/catatonia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypertonia"/>
        <synonym_1>catatonic</synonym_1>
        <synonym_2>catatonic state</synonym_2>
        <synonym_3>catatonic reaction</synonym_3>
        <untitled-ontology-57:CUI>C0007398</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">247917007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A neuropsychiatric disorder characterized by one or more of the following essential features: immobility, mutism, negativism (active or passive refusal to follow commands), mannerisms, stereotypies, posturing, grimacing, excitement, echolalia, echopraxia, muscular rigidity, and stupor; sometimes punctuated by sudden violent outbursts, panic, or hallucinations.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/central_hypotonia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/central_hypotonia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypotonia"/>
        <Example_1>hypotonia central</Example_1>
        <untitled-ontology-57:CUI>C1842364</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Reduced muscle tone secondary to an abnormality of the central nervous system</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/centrocecal_scotoma -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/centrocecal_scotoma">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/scotoma"/>
        <untitled-ontology-57:CUI>C0271196</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">33014001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A scotoma (area of diminished vision within the visual field) located between the central point of fixation and the blind spot with a roughly horizontal oval shape.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cervical_root_injury -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cervical_root_injury">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sensory_loss_in_root_distribution"/>
