        <rdfs:seeAlso>swollen glands; adenopathy; enlarged lymph nodes, enlarged glands</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/macrocephaly -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/macrocephaly">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/increased_head_circumference"/>
        <Example_1>macrocephalus.</Example_1>
        <Example_2>Large head.</Example_2>
        <Example_3>Enlarged head.</Example_3>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0000256</HPO>
        <untitled-ontology-57:CUI>C0221355</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Head</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19410003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Diffuse enlargement of the entire cerebral hemispheres leading to macrocephaly (with or without overlying cortical dysplasia).</rdfs:isDefinedBy>
        <rdfs:seeAlso>Macrocephalus</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/malaise -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/malaise">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/consitutitional_symptoms"/>
        <synonym_1>unease</synonym_1>
        <synonym_2>fatigue</synonym_2>
        <synonym_3>uneasiness</synonym_3>
        <untitled-ontology-57:CUI>C0231218</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A nonspecific feeling of bodily discomfort, fatigue and/or unease.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/mania -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/mania">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/labile_affect"/>
        <untitled-ontology-57:CUI>C0338831</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">231494001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A disorder characterized by excitement of psychotic proportions manifested by mental and physical hyperactivity, disorganization of behavior and elevation of mood.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/marche_a_petits_pas -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/marche_a_petits_pas">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_parkinsonian"/>
        <untitled-ontology-57:CUI>C0427169</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">250049001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Marche à petits pas [maʁʃ a pəti pa] (“gait with little steps”) is a type of gait disorder characterised by an abnormal short stepped gait with upright stance (in strict sense, as opposed to generally stooping short-stepped gait of Parkinson&apos;s disease), seen in various neurological (or sometimes muscular) disorders. It can be further differentiated from &quot;Parkinsonian gait&quot; by normal arm swing (as opposed to no arm swing in Parkinsonism). This is associated with frontal lobe white matter lesions.[1]</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/mask_like_facies -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/mask_like_facies">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Parkinsonian_face"/>
        <Example_3>Poverty of facial expression.</Example_3>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0000298</HPO>
        <untitled-ontology-57:CUI>C0424448</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">103606006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Hypomimia (masked facies, masking of facies, mask-like facial expression), a medical sign, is a reduced degree of facial expression.</rdfs:isDefinedBy>
        <rdfs:seeAlso>masked_facies: lack_of_facial_expression; poverty_of_facial_expression</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/memory_lapses -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/memory_lapses">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cognitive_symptoms"/>
        <synonym_1>spells of forgetfulness</synonym_1>
        <synonym_2>episodes of impaired memory</synonym_2>
        <untitled-ontology-57:CUI>C0557932</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">225038006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Temporary intermittent failures of memory.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/meningism -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/meningism">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/neck_stiffness"/>
        <Example_1>meningeal irritation</Example_1>
        <Example_2>meningismus</Example_2>
        <synonym_1>Dupre syndrome</synonym_1>
        <synonym_2>pseudomeningitis</synonym_2>
        <synonym_3>meningitis like reaction</synonym_3>
        <untitled-ontology-57:CUI>C0025287</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Neck</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">70784009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Meningism is a set of symptoms similar to those of meningitis but not caused by meningitis. Whereas meningitis is inflammation of the meninges (membranes that cover the central nervous system), meningism is caused by nonmeningitic irritation of the meninges, usually associated with acute febrile illness,especially in children and adolescents</rdfs:isDefinedBy>
        <rdfs:seeAlso>meningism; irritation meningeal; meningeal irritation; meningismus; meningitis-like; Meningitis-like reaction; pseudomeningitis; Pseudomeningitides; Reaction, Meningitis-Like; Syndrome, Dupre; Syndrome, Dupre&apos;s; Dupre&apos;s syndrome</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/mental_and_psychological_observations -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/mental_and_psychological_observations">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#abnormality_of_higher_mental_function"/>
        <untitled-ontology-57:CUI>C1562941</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">416578004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Abnormalities of affect or behavior</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/mental_retardation -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/mental_retardation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_cognition"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0001249</HPO>
        <untitled-ontology-57:CUI>C0025362</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">91138005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Subnormal intellectual functioning which originates during the developmental period; multiple potential etiologies, including genetic defects and perinatal insults; intelligence quotient (IQ) scores are commonly used to determine whether an individual is mentally retarded; IQ scores between 70 and 79 are in the borderline mentally retarded range and scores below 67 are in the retarded range.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/mental_status_finding -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/mental_status_finding">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#sign"/>
        <Example_1>abnormal mental state</Example_1>
        <Example_2>abnormal mental status</Example_2>
        <Example_3>Impaired mental state.</Example_3>
        <untitled-ontology-57:CUI>C0278061</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">36456004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An abnormality in language, memory, visual-spatial functions, attention, executive functions, or other higher cortical functions such as reading, writing, speaking, recognition, insight, judgment, planning, or abstract thinking.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/mesencephalic_light_near_dissociation -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/mesencephalic_light_near_dissociation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cranial_nerve_reflex_finding"/>
        <untitled-ontology-57:CUI>C4546352</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">762663009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Classical teaching has associated all lesions of the rostral midbrain with bilateral light-near dissociation (LND), defined as attenuation of the pupil light reflex (PLR) with relative sparing of the near response.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/metamorphopsia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/metamorphopsia">
