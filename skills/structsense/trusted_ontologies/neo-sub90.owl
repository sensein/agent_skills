        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">278285008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Severe paralysis of the left arm and leg.</rdfs:isDefinedBy>
    </owl:Class>
    


