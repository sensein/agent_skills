    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/Lhermitte_sign_positive -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/Lhermitte_sign_positive">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/neck_finding"/>
        <Example_1>Electric shock like sensation in spine on flexion of the neck.</Example_1>
        <Example_2>Lhemitte sign</Example_2>
        <Example_3>Lhermitte phenomenon</Example_3>
        <synonym_1>Barber chair sign</synonym_1>
        <synonym_2>Lhermitte phenomenon</synonym_2>
        <untitled-ontology-57:CUI>C0576704</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Neck</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">65329004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A sudden, electric shock sensation that is triggered by flexion of the neck, and which travels down the spine, arms, legs, and sometimes trunk.</rdfs:isDefinedBy>
        <rdfs:seeAlso>Lhermitte&apos;s sign; Barber chair sign; Lhermitte&apos;s phenomenon</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#Brudzynski_sign -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#Brudzynski_sign">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/neck_stiffness"/>
        <Example_1>Flexion of hips and knees upon flexion of neck due to neck stiffness.</Example_1>
        <Example_2>Brudzynski test positive.</Example_2>
        <Example_3>Positive Brudzynski sign.</Example_3>
        <synonym_1>Brudzynski sign present.</synonym_1>
        <untitled-ontology-57:CUI>C0234179</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Neck</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Severe neck stiffness causes a patient&apos;s hips and knees to flex when the neck is flexed</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#Chaddock_sign -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#Chaddock_sign">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#abnormal_pyramidal_sign"/>
        <untitled-ontology-57:CUI>C1531651</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#Cushingnoid_facies -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#Cushingnoid_facies">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/endocrine_symptoms"/>
        <untitled-ontology-57:CUI>C0332601</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">67967009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>the full rounded facies characteristic especially of Cushing&apos;s syndrome and typically associated with deposition of fat</rdfs:isDefinedBy>
        <rdfs:seeAlso>moon_facies</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#Gower_sign -->

