    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#chills -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#chills">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/consitutitional_symptoms"/>
        <synonym_1>feeling cold</synonym_1>
        <untitled-ontology-57:CUI>C0085593</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">43724002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Chills refers to feeling cold after being in a cold environment. The word can also refer to an episode of shivering along with paleness and feeling cold. Chills (shivering) may occur at the start of an infection. They are most often associated with a fever. Chills are caused by rapid muscle contraction and relaxation. They are the body&apos;s way of producing heat when it feels cold. Chills often predict the coming of a fever or an increase in the body&apos;s core temperature.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#chronic_constipation -->

