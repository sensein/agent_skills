        <untitled-ontology-57:CUI>C0018681</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">25064002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>pain in the cranial region that may occur as an isolated and benign symptom or as a manifestation of a wide variety of conditions.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/headache_dull -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/headache_dull">
