    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#monocular_exotropia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#monocular_exotropia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abnormal_vision"/>
        <untitled-ontology-57:CUI>C0152206</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Exotropia is a form of strabismus (eye misalignment) in which one or both of the eyes turn outward. It is the opposite of crossed eyes, or esotropia. Exotropia may occur from time to time (intermittent exotropia) or may be constant, and is found in every age group.  Monocular exotropia affects only one eye.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#monocular_exotropia_left -->

