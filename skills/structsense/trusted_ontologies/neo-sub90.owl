    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_of_right_leg">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_leg"/>
        <untitled-ontology-57:CUI>C2218016</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Weakness of the right leg.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_of_sternomastoid -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_of_sternomastoid">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cranial_nerve_11_finding"/>
        <Example_1>Weakness of stenocleidomastoid mucle</Example_1>
        <Example_2>Unable to rotate head to side</Example_2>
        <Example_3>Decreased strength of stenomastoid muscle.</Example_3>
        <untitled-ontology-57:CUI>C0426997</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>The sternocleidomastoid muscle (SCM) acts to turn the head to the opposite side.  Acting together, the two SCMs thrust the head forward and flex the neck</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_of_thumb_abduction -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_of_thumb_abduction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_fingers"/>
        <untitled-ontology-57:CUI>C2070740</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Inability to abduct the thumb due to weakness.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_of_thumb_opposition -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_of_thumb_opposition">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_fingers"/>
        <untitled-ontology-57:CUI>C2070739</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Weakness of opposition of the thumb.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_of_trapezius -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_of_trapezius">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cranial_nerve_11_finding"/>
        <Example_1>Unable to shrug shoulders.</Example_1>
        <Example_2>weak trapezius muscle.</Example_2>
        <Example_3>weak trapezius</Example_3>
        <synonym_1>Decreased strength in trapezius muscle.</synonym_1>
        <untitled-ontology-57:CUI>C2177090</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Strength of the trapezius muscle is usually tested by shrugging of the shoulders, although the levator scapulae contributes to this action. Another test of the trapezius is to have the patient attempt to approximate the occipitut of the head to the acromion of the shoulder.  When the trapezius is weak the arms hang lower on the affected side and the finger tips touch the hips at a lower level on the affected side.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_proximal_muscle -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_proximal_muscle">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness"/>
        <Example_1>weakness proximally.</Example_1>
        <Example_2>weakness of the proximal muscles.</Example_2>
        <untitled-ontology-57:CUI>C0221629</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">249939004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A lack of strength of the proximal muscles</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_right_arm -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_right_arm">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_arm"/>
        <untitled-ontology-57:CUI>C2202996</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15633441000119109</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Weakness of the right arm.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_shoulder -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_shoulder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_arm"/>
        <synonym_1>paresis of the shoulder.</synonym_1>
        <untitled-ontology-57:CUI>C0748691</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Weakness of the shoulder.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_shoulder_girdle -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_shoulder_girdle">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_shoulder"/>
        <untitled-ontology-57:CUI>C0427063</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">249940002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The shoulder, or pectoral, girdle is composed of the clavicles and the scapulae. Shoulder-girdle weakness refers to lack of strength of the muscles attaching to these bones, that is, lack of strength of the muscles around the shoulders.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_toe -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_toe">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_leg"/>
        <untitled-ontology-57:CUI>C0576333</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">299575007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Weakness in plantar flexing or dorsiflexing of the toe.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_triceps -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_triceps">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_arm"/>
        <synonym_1>paresis of the triceps</synonym_1>
        <untitled-ontology-57:CUI>C2230441</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A lack of strength in the triceps muscle, which normally is responsible for extending (straightening) the elbow and mediating certain shoulder movements.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_upper_and_lower_limbs -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_upper_and_lower_limbs">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_generalized"/>
        <Example_1>arm and leg weakness</Example_1>
        <Example_2>Arms and legs were weak.</Example_2>
        <untitled-ontology-57:CUI>C4313875</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Weakness in both the arms and the legs.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_wrist -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_wrist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_forearm"/>
        <untitled-ontology-57:CUI>C2127518</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Weakness of the wrist</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_wrist_extension -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_wrist_extension">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_wrist"/>
        <untitled-ontology-57:CUI>C2230402</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Weakness of wrist extension</rdfs:isDefinedBy>
        <rdfs:seeAlso>wrist_drop</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_wrist_flexion -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_wrist_flexion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_wrist"/>
        <untitled-ontology-57:CUI>C2230398</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Weakness of wrist flexion</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weight_gain -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weight_gain">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/consitutitional_symptoms"/>
        <untitled-ontology-57:CUI>C0043094</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8943002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An increase in body weight.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weight_loss -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weight_loss">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/consitutitional_symptoms"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0001824</HPO>
        <untitled-ontology-57:CUI>C1262477</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">262285001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The reduction of overall body mass; may be due to disease, diet, or drugs; can be permanent or temporary, and may involve any tissue.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/wing_beating_tremor -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/wing_beating_tremor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/tremor"/>
        <synonym_1>flapping tremor</synonym_1>
        <synonym_1>wing beating tremor</synonym_1>
        <untitled-ontology-57:CUI>C2203278</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>a coarse, irregular tremor that is most prominent when the limbs are held outstretched, reminiscent of a bird&apos;s flapping its wings; due to up and down excursion of arm at abducted shoulder.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/winged_scapula -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/winged_scapula">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_muscle_group"/>
        <untitled-ontology-57:CUI>C0240953</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17211005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Abnormal protrusion of the scapula away from the surface of the back</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/withdrawal -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/withdrawal">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/withdrawn"/>
        <untitled-ontology-57:CUI>C2825032</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A social or emotional detachment, pathological retreat from objective reality, interpersonal contact and social involvement, as in some forms of schizophrenia, depression, or schizoid, avoidant, or schizotypal personality disorders.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/withdrawn -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/withdrawn">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/apathy"/>
        <untitled-ontology-57:CUI>C0424092</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">247755007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Not wanting to communicate with other people.  a disorder characterized by withdrawn and fearful behavior.  Lacking interest in things or people.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/witzelsucht -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/witzelsucht">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/inappropriate_jocularity"/>
        <untitled-ontology-57:CUI>C1408582</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Witzelsucht &quot;joking addiction&quot;) is characterized by a tendency to make puns, or tell inappropriate jokes or pointless stories in socially inappropriate situations.  It often occurs in disinhibited patients with frontal lobe damage.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/word_deafness -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/word_deafness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_Wernicke"/>
        <untitled-ontology-57:CUI>C1366485</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3387000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Pure word deafness has also been called auditory agnosia, isolated speech deafness, and subcortical sensory aphasia; the modality affected is hearing. It causes patients to be unable to recognize speech sounds, while being able to hear non-language environmental noises, animal sounds, and music. Other language modalities – speech production, reading, and writing – generally remain intact.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/writers_cramp -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/writers_cramp">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#focal_dystonia"/>
        <synonym_1>telegrapher cramp</synonym_1>
        <untitled-ontology-57:CUI>C0154676</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">52008007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Writer cramp is a focal dystonia of the fingers, hand, and/or forearm. Symptoms usually appear when a person is trying to do a task that requires fine motor movements, such as writing or playing a musical instrument. The symptoms may be isolated to only those tasks or affect the muscles in a more general way and spread to affect many tasks. Common symptoms include, for example, excessive gripping of a pen or utensil, flexing of the wrist, elevation of the elbow, and occasional extension of a finger or fingers causing the utensil to fall from the hand. Writer’s cramp may be primary or secondary.</rdfs:isDefinedBy>
        <rdfs:seeAlso>graphospasm</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/3rd_nerve_palsy -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/3rd_nerve_palsy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/limited_eye_movements"/>
        <untitled-ontology-57:CUI>C0271371</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Weakness referable to the third cranial nerve including drooping of the eyelid, dilation of the pupil, and weakness of the extraocular muscles inculing medial rectus, inferior rectus, and superior rectus.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/3rd_nerve_palsy_incomplete -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/3rd_nerve_palsy_incomplete">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/3rd_nerve_palsy"/>
        <untitled-ontology-57:CUI>C0271370</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">194118007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An incomplete third nerve palsy may involve the extraocular muscles but spare either the pupil or the levator muscle of the eyelid.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Visual_acuity_loss_(none_to_moderate_(20/16_to_20/visual_acuity_loss_none_to_moderate -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Visual_acuity_loss_(none_to_moderate_(20/16_to_20/visual_acuity_loss_none_to_moderate">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_visual_acuity"/>
        <untitled-ontology-57:CUI>C1836949</untitled-ontology-57:CUI>
