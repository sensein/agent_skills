        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">44548000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Hyperactivity means having increased movement, impulsive actions, and a shorter attention span, and being easily distracted.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyperacusis -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyperacusis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ENT_symptoms"/>
        <synonym_1>painful sensitivity to sound</synonym_1>
        <synonym_2>sounds seem abnormally loud</synonym_2>
        <untitled-ontology-57:CUI>C0034880</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">25289003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Abnormally increased perception of sound.</rdfs:isDefinedBy>
        <rdfs:seeAlso>painful_sensitivity_to_sound; sounds_seem_unnaturally_loud</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyperacusis_left_ear -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyperacusis_left_ear">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyperacusis"/>
        <synonym_1>Sounds thkat seem too loud in the left ear.</synonym_1>
        <untitled-ontology-57:CUI>C2881989</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1088941000119107</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Sounds seem unnaturally loud in the left ear.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyperacusis_right_ear -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyperacusis_right_ear">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyperacusis"/>
        <untitled-ontology-57:CUI>C2881988</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Sounds that seem too loud in the right ear.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyperalgesia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyperalgesia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sensory_finding"/>
        <Example_1>Very sensitive to painful stimuli.</Example_1>
        <Example_2>Extreme pain sensitivity.</Example_2>
        <synonym_1>hyperpathia</synonym_1>
        <untitled-ontology-57:CUI>C0020429</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Sensory</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">55406008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>excessive sensitivity to painful stimuli.</rdfs:isDefinedBy>
        <rdfs:seeAlso>hyperpathia</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyperexplexia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyperexplexia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abnormal_involuntary_movement"/>
        <Example_1>Excessive startle reaction when startled by touch or loud noise.</Example_1>
        <synonym_1>Excessive startle reaction.</synonym_1>
        <untitled-ontology-57:CUI>C0234166</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>an excessive startle reaction (eye blinking or body spasms) to sudden unexpected noise, movement, or touch.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyperkinesia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyperkinesia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#abnormality_of_extrapyramidal_motor_function"/>
        <Example_1>Excessive body movements.</Example_1>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0002487</HPO>
        <synonym_1>excessive movemenets or motor activity.</synonym_1>
        <untitled-ontology-57:CUI>C3887506</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">44548000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Excessive movement of muscles of the body as a whole, which may be associated with organic or psychological disorders.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypermetria -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypermetria">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysmetria"/>
        <untitled-ontology-57:CUI>C3668822</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">450881007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Overshooting the target on rapid-alternating-movements.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypermotor_automatisms -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypermotor_automatisms">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/automatisms"/>
        <untitled-ontology-57:CUI>C3551488</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Hyper Motor Seizures [HMS] are characterized by complex high amplitude movements involving proximal segments of the body resulting violent and inappropriate to the context.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyperreflexia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyperreflexia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/reflex_finding"/>
        <Example_1>Reflexes were hyperactive</Example_1>
        <Example_2>All reflexes were increased</Example_2>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0001347</HPO>
        <untitled-ontology-57:CUI>C0151889</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">86854008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Hyperreflexia is the presence of hyperactive stretch reflexes of the muscles.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypertelorism -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypertelorism">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysmorphic_face"/>
        <Example_1>increased distance between orbits</Example_1>
        <Example_2>increased distance between eyes.</Example_2>
        <untitled-ontology-57:CUI>C0020534</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Head</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22006008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A condition in which there is an abnormally increased distance between two organs or bodily parts; most often, this term is referring to an increased distance between the orbits (orbital hypertelorism).</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypertension -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypertension">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cardiovascular_symptoms"/>
        <untitled-ontology-57:CUI>C0020538</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">38341003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Persistently high systemic arterial BLOOD PRESSURE. Based on multiple readings (BLOOD PRESSURE DETERMINATION), hypertension is currently defined as when SYSTOLIC PRESSURE is consistently greater than 140 mm Hg or when DIASTOLIC PRESSURE is consistently 90 mm Hg or more.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypertonia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypertonia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#abnormal_muscle_tone"/>
        <untitled-ontology-57:CUI>C0026826</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">41581000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>abnormal increase in skeletal or smooth muscle tone; skeletal muscle hypertonicity may be associated with pyramidal tract lesions or basal ganglia diseases.</rdfs:isDefinedBy>
        <rdfs:seeAlso>muscle_hypertonia</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypertrophy_of_lower_leg_muscles -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypertrophy_of_lower_leg_muscles">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#generalized_muscle_hypertrophy"/>
        <Example_1>hypertrophy of lower leg muscles.</Example_1>
        <Example_2>Enlargement of lower leg.</Example_2>
        <untitled-ontology-57:CUI>C2047656</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Hypertrophy of the lower leg and calf muscles.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypertrophy_sternocleidomastoid -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypertrophy_sternocleidomastoid">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/muscle_hypertrophy"/>
        <Example_1>Enlargement of sternocleidomastoid muscle in neck.</Example_1>
        <untitled-ontology-57:CUI>C3553931</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Hypertrophy of the sternocleidomastoid muscle.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypertropia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypertropia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/strabismus"/>
        <untitled-ontology-57:CUI>C0020575</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">40608009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A type of strabismus characterized by permanent upward deviation of the visual axis of one eye.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypesthesia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypesthesia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sensory_finding"/>
        <Example_1>diminished sensation</Example_1>
        <Example_2>reduced sensation</Example_2>
        <Example_3>sensory loss</Example_3>
        <untitled-ontology-57:CUI>C0020580</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Sensory</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Diminished sensation in one or more modality including temperature sense, vibration sense, pain sense, light touch sense, or proprioception.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypnogoguic_hallucinations -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypnogoguic_hallucinations">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sleep_related_hallucinations"/>
        <Example_1>hallucinations while falling asleep</Example_1>
        <Example_2>Sleep related hallucinations.</Example_2>
        <untitled-ontology-57:CUI>C0233773</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">445112001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Hypnagogic hallucinations are sleep-related hallucinations that occur while falling asleep.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypokinesia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypokinesia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#abnormality_of_extrapyramidal_motor_function"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0002375</HPO>
        <untitled-ontology-57:CUI>C0086439</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">255385008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Abnormally diminished motor activity. In contrast to paralysis, hypokinesia is not characterized by a lack of motor strength, but rather by a poverty of movement. The typical habitual movements (e.g., folding the arms, crossing the legs) are reduced in frequency.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypomanic -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypomanic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/mania"/>
        <untitled-ontology-57:CUI>C0241934</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">281257007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A less severe form of mania characterized by elevated mood, hyperactivity, and grandiosity. In contrast to mania, these symptoms do not cause significant impairment of the individual&apos;s productivity at work, or social and family relationships.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypomelanotic_macule -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypomelanotic_macule">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/skin_finding"/>
        <synonym_1>ash leaf spots</synonym_1>
        <synonym_2>hypomelanotic macule</synonym_2>
        <untitled-ontology-57:CUI>C4024220</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Skin</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Hypomelanotic macules (ash leaf spots&quot;) are white or lighter patches of skin that may appear anywhere on the body and are caused by a lack of melanin. White ash leaf-shaped macules are considered to be characteristic of tuberous sclerosis.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypometria -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypometria">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysmetria"/>
        <untitled-ontology-57:CUI>C0234165</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">69752006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Undershooting the target on rapid alternating movements.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypometric_saccades -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypometric_saccades">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_saccades"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0000571</HPO>
        <untitled-ontology-57:CUI>C0423082</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Normal subjects usually make small amplitude refixations without a discernible aundershoot or overshoot (&quot;normometric&quot; saccades). As the amplitude of the refixation increases, there is a proportional increase in the amount of undershooting which is usually less than 2 degrees and followed by a small corrective movement, referred to as physiologic undershoots. Unusual eye movements consisting of three or more steps, or two steps of approximately equal magnitude, have been called &quot;fragmented,&quot; &quot;hypometric,&quot; or &quot;stepwise&quot; refixations.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypophonia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypophonia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dysarthria_hypokinetic"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0001621</HPO>
        <untitled-ontology-57:CUI>C0521007</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">34527004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Reduced intensity (volume) of speech.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyporeflexia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyporeflexia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/reflex_finding"/>
        <Example_1>All reflexes were hypoactive.</Example_1>
        <Example_2>Decreased reflexes.</Example_2>
        <Example_3>Diminished deep tendon reflexes.</Example_3>
        <untitled-ontology-57:CUI>C0151888</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22994000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Decreased but not necessarily absent deep tendon reflexes.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyposmia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyposmia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/olfactory_disorder"/>
        <Example_1>impaired smell.</Example_1>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0004409</HPO>
        <untitled-ontology-57:CUI>C2364082</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">83156004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Decreased ability to smell.</rdfs:isDefinedBy>
        <rdfs:seeAlso>reduced_sense_of_smell, impaired_sense_of_smell</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypotonia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypotonia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#abnormal_muscle_tone"/>
        <Example_1>reduced muscle tone.</Example_1>
        <Example_2>Decreased muscle tone.</Example_2>
        <Example_3>Diminished muscle tone.</Example_3>
        <synonym_1>muscle hypotonia</synonym_1>
        <synonym_2>muscle tone decreased.</synonym_2>
        <untitled-ontology-57:CUI>C0026827</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">398152000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Diminution of the skeletal muscle tone marked by a diminished resistance to passive stretching.</rdfs:isDefinedBy>
        <rdfs:seeAlso>muscle_hypotonia</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hysterical_blindness -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hysterical_blindness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/conversion_disorder"/>
        <untitled-ontology-57:CUI>C0221473</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">88902008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Blindness without known physical cause and believed due to a dissociative disorder.</rdfs:isDefinedBy>
        <rdfs:seeAlso>hysterical_blindness</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hysterical_gait -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hysterical_gait">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/conversion_disorder"/>
        <untitled-ontology-57:CUI>C0427177</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">271707009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Bizarre gait seen with hysteria-conversion reaction. While walking the foot is usually dragged or pushed ahead, instead of lifted. Frequently the foot is held dorsiflexed and inverted.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hysterical_mutism -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hysterical_mutism">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/conversion_disorder"/>
        <untitled-ontology-57:CUI>C1400338</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">70066000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Hysterical mutism is a disorder of the vocal function without changing the integrity of the body, resulting in loss of voice.</rdfs:isDefinedBy>
        <rdfs:seeAlso>conversion_mutism</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hysterical_paralysis -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hysterical_paralysis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/conversion_disorder"/>
        <untitled-ontology-57:CUI>C0237766</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">88984006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Hysterical paralysis, a type of adult conversion reaction, although uncommon, is seen occasionally by the spinal surgeon. This disorder involves a nonorganic loss of motor or sensory function that cannot be explained by a physical disorder, but resembles the symptoms of a structural disease of the nervous system.</rdfs:isDefinedBy>
        <rdfs:seeAlso>hysterical_paresis</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/icterus -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/icterus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/GI_symptoms"/>
        <synonym_1>jaundice</synonym_1>
        <synonym_2>icterus</synonym_2>
        <untitled-ontology-57:CUI>C0022346</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18165001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Jaundice, also known as icterus, is a yellowish or greenish pigmentation of the skin and whites of the eyes due to high bilirubin levels.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/immature_behavior -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/immature_behavior">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_of_executive_functions"/>
        <untitled-ontology-57:CUI>C0233513</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Behaviior that is abnormally immature or childish in nature.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_abstract_thinking -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_abstract_thinking">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_of_executive_functions"/>
        <untitled-ontology-57:CUI>C0679467</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">424100000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Ability to think abstractly is often contrasted with concrete thinking.  Abstraction allows individuals to identify underlying themes and concepts in objects such as how is a chair like a table, a penny like a dollar, honesty like integrity.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_alertness -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_alertness">
