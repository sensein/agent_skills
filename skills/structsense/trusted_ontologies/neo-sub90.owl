        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#wrist_joint_pain_right -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#wrist_joint_pain_right">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#wrist_pain_right"/>
        <untitled-ontology-57:CUI>C2219181</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Pain in the right wrist.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#wrist_pain -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#wrist_pain">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain_arm"/>
        <untitled-ontology-57:CUI>C0221785</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to the wrist.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#wrist_pain_right -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#wrist_pain_right">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#pain_of_right_wrist"/>
        <synonym_3>pain in the right wrist</synonym_3>
        <untitled-ontology-57:CUI>C2108894</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Pain in the right wrist</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#writer_cramp_organic -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#writer_cramp_organic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/writers_cramp"/>
        <untitled-ontology-57:CUI>C4316810</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Anton_syndrome -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Anton_syndrome">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/agnosia_visual"/>
        <untitled-ontology-57:CUI>C0751730</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">83373005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Anton syndrome, also known as Anton&apos;s blindness and visual anosognosia, is a rare symptom of brain damage occurring in the occipital lobe. Those who have it are cortically blind, but affirm, often quite adamantly and in the face of clear evidence of their blindness, that they are capable of seeing.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Argyll_Robertson_pupil -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Argyll_Robertson_pupil">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pupil_finding"/>
        <synonym_1>Argylll Robertson phenomenon</synonym_1>
        <untitled-ontology-57:CUI>C0234668</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4129001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Pupils will NOT constrict to light but they WILL constrict with accommodation</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Babinski_sign -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Babinski_sign">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#abnormal_pyramidal_sign"/>
        <Example_1>Babinski reflex</Example_1>
        <Example_1>Positive Babinski</Example_1>
        <Example_2>Extensor plantar response</Example_2>
        <Example_3>Upgoing toe</Example_3>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0003487</HPO>
        <untitled-ontology-57:CUI>C0034935</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">366575004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Upturning of the big toe (and sometimes fanning of the other toes) in response to stimulation of the sole of the foot. If the Babinski sign is present it can indicate damage to the corticospinal tract.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Balint_syndrome -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Balint_syndrome">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/agnosia"/>
        <Example_1></Example_1>
        <untitled-ontology-57:CUI>C4707368</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">765212008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A rare neurologic disease with characteristics of the triad of optic ataxia, ocular apraxia and simultanagnosia due to posterior parietal lobe lesions. Patients report ophthalmologic difficulties in the absence of underlying ophthalmologic anomalies and present severe visual and spatial disabilities in locating and reaching objects, initiating voluntary eye movements and perceiving more than one object at a time.</rdfs:isDefinedBy>
        <rdfs:isDefinedBy>ocular apraxia, simultanagnosia, and optic ataxia</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ENT_symptoms -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ENT_symptoms">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/symptom"/>
        <untitled-ontology-57:CUI>C0422833</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">267098006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Symptoms referable to ears, nose, or throat.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/GI_symptoms -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/GI_symptoms">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/symptom"/>
        <untitled-ontology-57:CUI>C0426576</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Symptoms referable to the gastrointestinal tract including the esophagus, stomach, intestines, gall bladder, colon, and rectum.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Gerstmann_syndrome -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Gerstmann_syndrome">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/other_higher_cortical_functions"/>
        <untitled-ontology-57:CUI>C0017494</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">36785009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A disorder of cognition characterized by the tetrad of finger agnosia, dysgraphia, dyscalculia, and right-left disorientation.</rdfs:isDefinedBy>
        <rdfs:seeAlso>aphasia-angular_gyrus_syndrome</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Hoffman_reflex_positive -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Hoffman_reflex_positive">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Hoffman_sign_present"/>
        <Example_1>Positive Hoffman sign</Example_1>
        <Example_2>Hoffman test positive</Example_2>
        <Example_3>Hoffman sign present</Example_3>
        <untitled-ontology-57:CUI>C0576598</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>The Hoffmann&apos;s reflex test itself involves loosely holding the middle finger and flicking the fingernail downward, allowing the middle finger to flick upward reflexively. A positive response is seen when there is flexion and adduction of the thumb on the same hand. A positive Hoffmann’s reflex and finger jerks suggest hypertonia, but can occur in healthy individuals, and are not useful signs in isolation.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Hoffman_sign_present -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Hoffman_sign_present">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyperreflexia"/>
        <Example_1>Flicking the nail downward elicited a brisk finger jerk.</Example_1>
        <Example_2>Hoffman sign</Example_2>
        <Example_3>Hoffman sign positive.</Example_3>
        <synonym_1>brisk finger jerks with flicking the finger nail downward.</synonym_1>
        <untitled-ontology-57:CUI>C0239962</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">163873006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The Hoffmann&apos;s reflex test itself involves loosely holding the middle finger and flicking the fingernail downward, allowing the middle finger to flick upward reflexively. A positive response is seen when there is flexion and adduction of the thumb on the same hand. A positive Hoffmann’s reflex and finger jerks suggest hypertonia, but can occur in healthy individuals, and are not useful signs in isolation.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Horners_syndrome -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Horners_syndrome">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cranial_nerve_finding"/>
        <synonym_1>sympathetic ophthalmoplegia</synonym_1>
        <synonym_2>sympathetic cervical paralysis</synonym_2>
        <untitled-ontology-57:CUI>C0019937</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">192915005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>syndrome associated with defective sympathetic innervation to one side of the face, including the eye; clinical features include miosis, mild blepharoptosis, and hemifacial anhidrosis (decreased sweating); lesions of the brain stem, cervical spinal cord, first thoracic nerve root, apex of the lung, carotid artery, cavernous sinus, and apex of the orbit may cause this condition.</rdfs:isDefinedBy>
        <rdfs:seeAlso>sympathetic_ophthalmoplegia; sympathetic cervical paralysis; oculosympathetic_palsy</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Horners_syndrome_pupil -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Horners_syndrome_pupil">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Horners_syndrome"/>
        <untitled-ontology-57:CUI>C0338567</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">271730003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A small reactive pupil.  The miosis is caused by interruption of sympathetic  tone.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Impaired_long-term_verbal_memory -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Impaired_long-term_verbal_memory">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_long_term_memory"/>
        <untitled-ontology-57:CUI>C1841624</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>An impairment in long term verbal memory.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Kayser_Fleisher_ring -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Kayser_Fleisher_ring">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pupil_finding"/>
        <Example_1>Gray green pigmented ring in the cornea.</Example_1>
        <untitled-ontology-57:CUI>C0152457</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">77103006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Grey-green or brownish-pigmented ring in the deep epithelial layers at the outer border of the cornea.  Suggest Wilson disease.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Laseque_sign -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Laseque_sign">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/straight_leg_raising_test_positive"/>
        <untitled-ontology-57:CUI>C0575465</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Sensory</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">298692000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An abnormal straight leg raising test that produces pain on flexion at the hip of the extended leg.</rdfs:isDefinedBy>
        <rdfs:seeAlso>Laseque sign</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Meige_syndrome -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Meige_syndrome">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dystonia_oromandibular"/>
        <Example_1>A focal dystonia involving symmetrical benign essential blepharospasm (BEB) and oromandibular dystonia</Example_1>
        <untitled-ontology-57:CUI>C0025183</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">230325003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The combination of facial dystonia with blepharospasm.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Microphthalmos -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Microphthalmos">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cranial_nerve_finding"/>
        <synonym_1>micropthlamia</synonym_1>
        <untitled-ontology-57:CUI>C0026010</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">204108000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Microphthalmia is an eye abnormality that arises before birth. In this condition, one or both eyeballs are abnormally small. In some affected individuals, the eyeball may appear to be completely missing; however, even in these cases some remaining eye tissue is generally present.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Parinaud_syndrome -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Parinaud_syndrome">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gaze_palsy"/>
        <untitled-ontology-57:CUI>C0152222</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">37991008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A rare syndrome affecting conjugate vertical eye movement. It is often caused by a dorsal midbrain neoplasm, commonly a pinealoma, but may also be attributable to demyelinating diseases or stroke. Clinical signs include limitation of upward gaze, light-near dissociation of the pupillary response, eyelid retraction (Collier&apos;s sign) and convergence-retraction nystagmus. Clinical course is dependent on effective treatment of underlying cause.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Parkinsonian_face -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Parkinsonian_face">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#Parkinsonian_features"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#expressionless_face"/>
        <untitled-ontology-57:CUI>C2729167</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">248208000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>When the muscles of the face are stiff or take longer to move, it can be hard to crack a smile, raise your eyebrows or otherwise express your feelings using your face, which is an important part of how we communicate.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Phalen_sign -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Phalen_sign">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sensory_finding"/>
        <untitled-ontology-57:CUI>C0277835</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Sensory</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Phalen&apos;s maneuver is positive when flexing the wrist to 90 degrees for 1 minute elicits symptoms in the median nerve distribution.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/REM_sleep_behavior_disorder -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/REM_sleep_behavior_disorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#sleep_disturbance"/>
        <untitled-ontology-57:CUI>C0751772</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A disorder characterized by episodes of vigorous and often violent motor activity during REM sleep (SLEEP, REM). The affected individual may inflict self injury or harm others, and is difficult to awaken from this condition. Episodes are usually followed by a vivid recollection of a dream that is consistent with the aggressive behavior. This condition primarily affects adult males. (From Adams et al., Principles of Neurology, 6th ed, p393)</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Romberg_sign_positive -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Romberg_sign_positive">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Romberg_test_positive"/>
        <synonym_1>Abnormal Romberg test.</synonym_1>
        <synonym_2>Positive Romberg test.</synonym_2>
        <synonym_3>Positive Romberg sign.</synonym_3>
        <untitled-ontology-57:CUI>C0240914</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>The patient stands with the feet placed together and balance and is asked to close his or her eyes. A loss of balance upon eye closure is a positive Romberg sign and is interpreted as indicating a deficit in proprioception.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Romberg_test_positive -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Romberg_test_positive">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/balance_finding"/>
        <Example_1>Romberg sign present.</Example_1>
        <Example_2>Positive Romberg test.</Example_2>
        <Example_3>Unsteady during Romberg test.</Example_3>
        <synonym_1>Swaying when feet together and eyes closed.</synonym_1>
        <synonym_2>Unable to stand when eyes closed and feet together.</synonym_2>
        <synonym_3>Rombergism</synonym_3>
        <untitled-ontology-57:CUI>C0853374</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">163770001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The Romberg test is positive if the patient begins to sway when standing erect with eyes closed.  In general, patients with cerebellar problems will not be able to stand with feet together even with eyes open.  Swaying that begins when the patient closes their eyes suggests a problem with proprioception in the lower extremities.</rdfs:isDefinedBy>
        <rdfs:seeAlso>Romberg sign present</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Tinel_sign -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Tinel_sign">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sensory_finding"/>
        <Example_1>Tapping over the median nerve produces pain in the median nerve distribution,</Example_1>
        <Example_2>Tapping over the carpal tunnel produces pain in the median nerve distribution.</Example_2>
        <Example_3>Tapping over the carpal tunnel produces pain in the first, second, and third fingers.</Example_3>
        <synonym_1>Tinel sign</synonym_1>
        <synonym_2>Tinel sign present</synonym_2>
        <synonym_3>Tinel sign positive</synonym_3>
        <untitled-ontology-57:CUI>C0277843</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Sensory</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Tinel&apos;s sign is positive when tapping over the carpal tunnel elicits symptoms in the distribution of the median nerve.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Weber_test_lateralizes_left -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Weber_test_lateralizes_left">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hearing_loss_right_ear"/>
        <untitled-ontology-57:CUI>C0521004</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">27472009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>In cases of sensori-neural hearing loss, the sound lateralizes to the good ear.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Weber_test_lateralizes_to_right -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Weber_test_lateralizes_to_right">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hearing_loss_left_ear"/>
        <untitled-ontology-57:CUI>C0521003</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">31732001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>n cases of sensori-neural hearing loss, the sound lateralizes to the good ear.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abdominal_reflex_reduced -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abdominal_reflex_reduced">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cutaneous_reflex_finding"/>
        <Example_1>Abdominal reflexes were absent.</Example_1>
        <Example_2>Superficial reflexes on the abdomen could not be elicited.</Example_2>
        <Example_3>Abdominal reflexes were negative.</Example_3>
        <untitled-ontology-57:CUI>C0576601</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">299852009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An abdominal reflex is a superficial neurological reflex stimulated by stroking of the abdomen around the umbilicus. It can be helpful in determining the level of a central nervous system (CNS) lesion. Being a superficial reflex, it is polysynaptic (involving multiple connections between nerves)</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abducens_nerve_palsy -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abducens_nerve_palsy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sixth_nerve_palsy"/>
        <untitled-ontology-57:CUI>C0271355</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A disorder characterized by involvement of the abducens nerve (sixth cranial nerve) with limitation of abduction of the eye laterally.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abducens_nerve_weakness -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abducens_nerve_weakness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abducens_nerve_palsy"/>
        <synonym_1>sixth nerve weakness</synonym_1>
        <synonym_2>sixth nerve palsy</synonym_2>
        <synonym_3>abducens nerve palsy</synonym_3>
        <untitled-ontology-57:CUI>C4551519</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Impairment in the function of the sixth cranial nerve which causes weakness of the lateral rectus muscle which turns the eye outward.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abnormal_affect -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abnormal_affect">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#abnormal_behavior"/>
        <untitled-ontology-57:CUI>C1291710</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">386782008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An abnormailty of mood or affect.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abnormal_involuntary_movement -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abnormal_involuntary_movement">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/involuntary_movement"/>
        <untitled-ontology-57:CUI>C0392702</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">260912008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Any involuntary abnormal movement such as tremor, chorea, hemiballismus, athetosis, or myoclonus.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abnormal_vestibulo_ocular_reflex -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abnormal_vestibulo_ocular_reflex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/vestibulo-ocular_reflex_abnormal"/>
        <untitled-ontology-57:CUI>C4021571</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>An abnormality of the vestibulo-ocular reflex (VOR). The VOR attempts to keep the image stable on the retina. Ideally passive or active head movements in one direction are compensated for by eye movements of equal magnitude.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abnormal_vision -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abnormal_vision">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/visual_symptoms"/>
        <Example_1>impaired vision</Example_1>
        <Example_2>impaired eyesight</Example_2>
        <Example_3>decreased vision</Example_3>
        <untitled-ontology-57:CUI>C3665386</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7973008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Disturbance of eyesight</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absence_facial_sweating -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absence_facial_sweating">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hemifacial_anhidrosis"/>
        <synonym_1>facfial anhidrosis.</synonym_1>
        <untitled-ontology-57:CUI>C0239528</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Absence of facial sweating.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absence_seizure -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absence_seizure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/seizure"/>
        <untitled-ontology-57:CUI>C0014553</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">79631006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A typical absence seizure is a generalized seizure with abrupt onset and offset of altered awareness which can vary in severity (see specific syndromes). Memory for events during the seizures is usually impaired although there may be some retained awareness particularly for adolescents. Clonic movements of eyelids. A seizure disorder usually occurring in childhood characterized by rhythmic electrical brain discharges of generalized onset. Clinical features include a sudden cessation of ongoing activity usually without loss of postural tone. Rhythmic blinking of the eyelids or lip smacking frequently accompanies the SEIZURES. The usual duration is 5-10 seconds</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_abdominal_reflex -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_abdominal_reflex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abdominal_reflex_reduced"/>
        <untitled-ontology-57:CUI>C0558753</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">274606006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Lack of contraction of abdominal muscles in the quadrant of the abdomen that is stimulated by scraping the skin tangential to or toward the umbilicus.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_anal_reflex -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_anal_reflex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cutaneous_reflex_finding"/>
        <Example_1>anocutaneous reflex absent</Example_1>
        <Example_2>anal reflex absent.</Example_2>
        <Example_3>No response to noxious stimulation around the anus.</Example_3>
        <synonym_1>perineal reflex absent</synonym_1>
        <synonym_2>anal wink absent</synonym_2>
        <untitled-ontology-57:CUI>C0576612</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">299863007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A noxious or tactile stimulus will cause a wink contraction of the anal sphincter muscles and also flexion.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_anal_tone -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_anal_tone">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_muscle_group"/>
        <synonym_1>poor anal tone</synonym_1>
        <synonym_2>poor rectal tone</synonym_2>
        <untitled-ontology-57:CUI>C0426766</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">249647002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Absence of normal anal tone.</rdfs:isDefinedBy>
        <rdfs:seeAlso>poor_anal_tone</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_ankle_reflex -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_ankle_reflex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_of_reflexes_in_lower_limbs"/>
        <Example_1>absent achilles reflex.</Example_1>
        <Example_2>absent ankle reflex.</Example_2>
        <Example_3>Absent foot reflex.</Example_3>
        <synonym_1>absent foot jerk.</synonym_1>
        <synonym_2>absent achilles jerk.</synonym_2>
        <synonym_3>Absent foot jerk.</synonym_3>
        <untitled-ontology-57:CUI>C0558845</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">274818004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Absence of the deep tendon reflex at the ankle which is usually elicited by striking the Achilles tendon with a reflex hammer.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_biceps_reflex -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_biceps_reflex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/areflexia_upper_limbs"/>
        <Example_1>absent biceps reflex.</Example_1>
        <Example_2>absent biceps jerk.</Example_2>
        <Example_3>No biceps reflex.</Example_3>
        <synonym_1>Unable to elicit biceps reflex.</synonym_1>
        <untitled-ontology-57:CUI>C0558847</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">274820001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Absence of the biceps reflex which is generally elicited by striking the biceps tendon in the antecubital fossae with a reflex hammer.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_body_position_sense -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_body_position_sense">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_body_position_sense"/>
        <untitled-ontology-57:CUI>C0426959</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Sensory</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Inability to sense body position using proprioception.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_consensual_reflex -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_consensual_reflex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cranial_nerve_reflex_finding"/>
        <untitled-ontology-57:CUI>C0437606</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">164042004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The reflex is consensual: Normally light that is directed in one eye produces pupil constriction in both eyes. The consensual response is the change in pupil size in the eye opposite to the eye to which the light is directed (e.g., if the light is shone in the right eye, the left pupil also constricts consensually). Failure of a pupil to constrict when light is shown in the opposite eye is a absent consensual reflex.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_corneal_reflex -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_corneal_reflex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/decreased_corneal_reflex"/>
        <untitled-ontology-57:CUI>C0278211</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">78710008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The corneal reflex is elicited by touching the cornea with a wisp of cotton or tissue.  The afferent loop is ove V1 of the trigeminal nerve and the efferent loop is over the facial nerve.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_deep_tendon_reflexes -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_deep_tendon_reflexes">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_reflexes"/>
        <Example_1>absent reflexes.</Example_1>
        <Example_2>absent deep tendon reflexes.</Example_2>
        <Example_3>No reflexes.</Example_3>
        <untitled-ontology-57:CUI>C0241772</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Inability to elicit deep tendon reflexes.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_direct_light_reflex -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_direct_light_reflex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cranial_nerve_reflex_finding"/>
        <untitled-ontology-57:CUI>C0578618</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">301944006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An abnormality of the reflex that controls the diameter of the pupil, in response to the intensity of light that falls on the retina of the eye. If pupil fails to constrict to light shown to the same eye, the direct reflex is absent.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_knee_reflex -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_knee_reflex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_of_reflexes_in_lower_limbs"/>
        <Example_2>Absent knee reflex.</Example_2>
        <Example_3>No knee reflex.</Example_3>
        <synonym_1>Absent patellar jerk.</synonym_1>
        <synonym_2>Absent patellar jerk.</synonym_2>
        <synonym_3>No knee jerk.</synonym_3>
        <untitled-ontology-57:CUI>C0558844</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">274817009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Absence of the knee jerk reflex, which can normally be elicited by tapping the patellar tendon with a reflex hammer just below the patella.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_left_corneal_reflex -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_left_corneal_reflex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_corneal_reflex"/>
        <untitled-ontology-57:CUI>C0558840</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Absence of left corneal reflex.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_pupil_near_reaction -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_pupil_near_reaction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pupil_finding"/>
        <untitled-ontology-57:CUI>C0578621</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">301947004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Failure of pupil to constrictd with near vision.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_reflexes -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_reflexes">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/areflexia"/>
        <Example_1>Reflexes were absent.</Example_1>
        <synonym_1>absent reflexes.</synonym_1>
        <synonym_2>No reflexes.</synonym_2>
        <untitled-ontology-57:CUI>C0234146</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">37280007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A finding indicating the complete absence of neurological reflexes</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_right_corneal_reflex -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_right_corneal_reflex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_corneal_reflex"/>
        <untitled-ontology-57:CUI>C0558841</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Absence of right corneal reflex.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_sensation -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_sensation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypesthesia"/>
        <untitled-ontology-57:CUI>C0278134</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Sensory</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A loss of sensation in any sensory modality such as temperature, vibration, joint position sense, pin prick sensation, or light touch.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_supinator_reflex -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_supinator_reflex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/areflexia_upper_limbs"/>
        <synonym_1>absent radial reflex.</synonym_1>
        <synonym_2>absent supinator reflex.</synonym_2>
        <synonym_3>absent brachioradialis reflex.</synonym_3>
        <untitled-ontology-57:CUI>C0558752</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">274605005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Absence of the supinator reflex, also known as the radial reflex or the brachioradialis reflex, which is elicited by gently striking the radius bone with a reflex hammer and observing contraction of the brachioradialis muscle.</rdfs:isDefinedBy>
        <rdfs:seeAlso>absent_radial_reflex; absent_brachioradialis_reflex</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_tendon_reflex -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_tendon_reflex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_deep_tendon_reflexes"/>
        <Example_1>No deep tendon reflex.</Example_1>
        <Example_2>absent deep tendon reflex.</Example_2>
        <untitled-ontology-57:CUI>C0278124</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">349006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Unable to elicit deep tendon reflex.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_triceps_reflex -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_triceps_reflex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/areflexia_upper_limbs"/>
        <Example_1>No triceps jerk.</Example_1>
        <Example_2>absent triceps jerk.</Example_2>
        <Example_3>Unable to elicit triceps jerk.</Example_3>
        <synonym_1>absent triceps reflex.</synonym_1>
        <synonym_2>Unable to elicit triceps reflex.</synonym_2>
        <synonym_3>No triceps reflex.</synonym_3>
        <untitled-ontology-57:CUI>C0558846</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Absence of the triceps reflex which is usually elicited by striking the triceps tendon with a reflex hammer.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abulia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abulia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/loss_of_executive_functions"/>
        <untitled-ontology-57:CUI>C0919974</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">737585009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Poverty of behavior and speech output, lack of initiative, loss of emotional responses, psychomotor slowing, and prolonged speech latency.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/achromatopsia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/achromatopsia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_color_vision"/>
        <untitled-ontology-57:CUI>C0152200</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">56852002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Complete color blindness, a complete inability to distinguish colors. Affected persons cannot perceive colors, but only shades of gray.</rdfs:isDefinedBy>
        <rdfs:seeAlso>achromatopsia</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/acne -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/acne">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/skin_finding"/>
        <Example_1>Features of the condition include blackheads or whiteheads, pimples, oily skin</Example_1>
        <synonym_1>acne vulgaris</synonym_1>
        <synonym_2>acne</synonym_2>
        <untitled-ontology-57:CUI>C0702166</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Skin</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11381005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Acne, also known as acne vulgaris, is a long-term skin condition that occurs when dead skin cells and oil from the skin clog hair follicles. Typical features of the condition include blackheads or whiteheads, pimples, oily skin, and possible scarring.It primarily affects skin with a relatively high number of oil glands, including the face, upper part of the chest, and back. The resulting appearance can lead to anxiety, reduced self-esteem, and, in extreme cases, depression or thoughts of suicide</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/acquired_color_vision_deficiency -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/acquired_color_vision_deficiency">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_color_vision"/>
        <untitled-ontology-57:CUI>C0155018</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Non-heritable difficulty in distinguishing colors.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/acute_onset -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/acute_onset">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#onset"/>
        <Example_1>sudden onset</Example_1>
        <Example_2>rapid onset</Example_2>
        <Example_3>acute onset</Example_3>
        <untitled-ontology-57:CUI>C0205178</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Onset</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">272118002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Sudden appearance of disease manifestations over a short period of time.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/adenoma_sebaceum -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/adenoma_sebaceum">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/skin_finding"/>
        <synonym_1>angiofibromas</synonym_1>
        <untitled-ontology-57:CUI>C1368816</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Skin</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Adenoma sebaceum is a misnamed cutaneous disorder consisting of angiofibromas that begin in childhood (generally present between 2–5 years of age) and appear clinically as red papules on the face especially on the nasolabial folds, cheek and chin; mostly thought to be acne not responding to treatment. Adenoma sebaceum may at times be associated with tuberous sclerosis. Gradually the papules become more prominent with time and persist throughout life. Cosmetic removal by argon or pulse dye laser or scalpel is indicated</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/afferent_pupil_defect -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/afferent_pupil_defect">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cranial_nerve_reflex_finding"/>
        <untitled-ontology-57:CUI>C0549122</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">232122003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The pupil responds consensually but not directly to light--so-called positive swinging flashlight test suggesting an afferent defect in the diseased eye.</rdfs:isDefinedBy>
        <rdfs:seeAlso>Marcus_Gunn_pupil; positive_swinging_flashlight_test</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/afferent_pupillary_defect -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/afferent_pupillary_defect">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/afferent_pupil_defect"/>
        <synonym_1>Marcus Gunn pupil</synonym_1>
        <untitled-ontology-57:CUI>C0339662</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">232121005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An aberrant pupillary response characterized by (i) Constriction of pupils of both eyes when the light stimulus is applied to the normal eye, and (ii) Dilatation of pupils of both eyes when the light stimulus is rapidly transferred from the normal eye (after brief light exposure to the normal eye) to the affected eye.  Both pupils dilate when the light is switched to the affected eye.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ageusia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ageusia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cranial_nerve_7_finding"/>
        <untitled-ontology-57:CUI>C2364111</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">36955009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Complete or severe loss of the subjective sense of taste, Inability to taste.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aggressive_behavior -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aggressive_behavior">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/threatening_behavior"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0000718</HPO>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0006919</HPO>
        <untitled-ontology-57:CUI>C0001807</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">61372001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Aggressive behavior can denote verbal aggression, physical aggression against objects, physical aggression against people, and may also include aggression towards oneself.</rdfs:isDefinedBy>
        <rdfs:seeAlso>aggression; aggressive</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aggressive_outbursts -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aggressive_outbursts">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aggressive_behavior"/>
        <untitled-ontology-57:CUI>C0554985</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">192083006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Episodes or outbursts of aggressive behavior towards others including aggressive verbal or physical behaviors.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/agitated -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/agitated">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abnormal_affect"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0000713</HPO>
        <untitled-ontology-57:CUI>C0085631</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24199005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A condition in which a person is unable to relax and be still. The person may be very tense and irritable, and become easily annoyed by small things. He or she may be eager to have an argument, and be unwilling to work with caregivers to make the situation better.</rdfs:isDefinedBy>
        <rdfs:seeAlso>agitation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/agnosia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/agnosia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_apraxia_dyslexia_or_agnosia"/>
        <untitled-ontology-57:CUI>C0001816</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">42341009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Inability to recognize objects not because of sensory deficit but because of the inability to combine components of sensory impressions into a complete pattern. Thus, agnosia is a neurological condition which results in an inability to know, to name, to identify, and to extract meaning from visual, auditory, or tactile impressions.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/agnosia_tactile -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/agnosia_tactile">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/agnosia"/>
        <Example_1>Could not recognize objects by touch.</Example_1>
        <synonym_1>astereognosis</synonym_1>
        <untitled-ontology-57:CUI>C0234505</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">25094008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Inability to recognize the form of objects by touch without visual input. That is, an impairment in the recognition of objects based only on based on the texture, size, weight and three-dimensional form of the object in the absence of any major somatosensory deficit.</rdfs:isDefinedBy>
        <rdfs:seeAlso>astereognosis</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/agnosia_topographic -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/agnosia_topographic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/agnosia"/>
        <Example_1>Unable to find way topographically</Example_1>
        <Example_2>Unable to orient oneself in ones surroundings.</Example_2>
        <Example_3>Unable to build mental representation of the environment.</Example_3>
        <synonym_1>topographical agnosia</synonym_1>
        <synonym_2>topographical disorientation</synonym_2>
        <synonym_3>topographagnosia</synonym_3>
        <untitled-ontology-57:CUI>C0271189</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">83824009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Topographical disorientation, also known as topographical agnosia and topographagnosia, is the inability to orient oneself in one&apos;s surroundings as a result of focal brain damage. This disability may result from the inability to make use of selective spatial information (e.g., environmental landmarks) or to orient by means of specific cognitive strategies such as the ability to form a mental representation of the environment, also known as a cognitive map. It may be part of a syndrome known as visuospatial dysgnosia.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/agnosia_visual -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/agnosia_visual">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/agnosia"/>
        <Example_1>Unable to recognize objects presented visually</Example_1>
        <Example_2>Impaired ability to recognize objects presented visually</Example_2>
        <untitled-ontology-57:CUI>C0234502</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">25762009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Difficulty in recognizing objects by visual input in absence of sensorial visual impairment</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/agraphesthesia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/agraphesthesia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/graphesthesia_impaired"/>
        <untitled-ontology-57:CUI>C1328618</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>The inability to recognize letters or numbers traced on the palm of the hand despite adequate sensation.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/agraphia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/agraphia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#language_disorders"/>
        <Example_1>unable to write</Example_1>
        <Example_2>Unable to use pen or pencil</Example_2>
        <synonym_1>dysgraphia</synonym_1>
        <synonym_2>impaired writing</synonym_2>
        <synonym_3>unable to write</synonym_3>
        <untitled-ontology-57:CUI>C0001825</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">27206009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An acquired inability to write.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/air_conduction_better_than_bone -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/air_conduction_better_than_bone">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cranial_nerve_8_finding"/>
        <untitled-ontology-57:CUI>C0423549</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">370377000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Bone conduction better than air conduction.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/akathisia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/akathisia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#abnormality_of_extrapyramidal_motor_function"/>
        <Example_1>motor restlessness</Example_1>
        <Example_1>restless uncontrolled movements that are not under voluntary control.</Example_1>
        <Example_2>restless motor activity</Example_2>
        <synonym_1>motor restlessness</synonym_1>
        <untitled-ontology-57:CUI>C0392156</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">285145004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A disorder characterized by an uncomfortable feeling of inner restlessness and inability to stay still; this is a side effect of some psychotropic drugs.</rdfs:isDefinedBy>
        <rdfs:seeAlso>motor_restlessness</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/akinetic_mutism -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/akinetic_mutism">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/mutism"/>
        <untitled-ontology-57:CUI>C0001889</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">53333005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A syndrome characterized by a silent and inert state without voluntary motor activity despite preserved sensorimotor pathways and vigilance. Bilateral frontal lobe dysfunction involving the anterior cingulate gyrus and related brain injuries are associated with this condition. This may result in impaired abilities to communicate and initiate motor activities.</rdfs:isDefinedBy>
        <rdfs:seeAlso>coma_vigil</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/alexia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/alexia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#language_disorders"/>
        <Example_1>Unable to read.</Example_1>
        <Example_2>Impaired reading.</Example_2>
        <synonym_1>dyslexia</synonym_1>
        <untitled-ontology-57:CUI>C0002018</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9236007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An acquired type of sensory aphasia where damage to the brain leads to the loss of the ability to read.</rdfs:isDefinedBy>
        <rdfs:seeAlso>dyslexia</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/allodynia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/allodynia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/sensory_finding"/>
        <Example_1>Pain induced by a non painful stimulus</Example_1>
        <synonym_1>allodynia</synonym_1>
        <untitled-ontology-57:CUI>C0458247</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Sensory</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">247404004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Allodynia is the elicitation of pain by stimuli that are normally not painful.</rdfs:isDefinedBy>
        <rdfs:seeAlso>painful_response_to_non_painful_stimulus</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/altered_behavior -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/altered_behavior">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/symptom"/>
        <Example_1>Changed behavior.</Example_1>
        <Example_2>Abnormal behavior.</Example_2>
        <untitled-ontology-57:CUI>C0004941</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>An abnormality of mental functioning including various affective, behavioural, cognitive and perceptual abnormalities.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/altered_consciousness -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/altered_consciousness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/consitutitional_symptoms"/>
        <synonym_1>altered level of alertness</synonym_1>
        <synonym_2>altered state of alertness</synonym_2>
        <untitled-ontology-57:CUI>C0150450</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>An altered state of consciousness (ASC), also called altered state of mind or mind alteration, is any condition which is significantly different from a normal waking state.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/altitudinal_hemianopia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/altitudinal_hemianopia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hemianopia"/>
        <untitled-ontology-57:CUI>C0271205</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">246669008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A field defect in either the upper or lower visual field that has a horizontal border.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/altitudinal_scotoma -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/altitudinal_scotoma">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/scotoma"/>
        <untitled-ontology-57:CUI>C0422991</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">246662004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An altitudinal visual field defect is a condition in which there is defect in the superior or inferior portion of the visual field that respects the horizontal midline. The altitudinal defect can be unilateral or bilateral</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/amaurosis_fugax -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/amaurosis_fugax">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/temporary_visual_disturbance"/>
        <Example_1>temporary blindness</Example_1>
        <Example_2>transient blindness</Example_2>
        <Example_3>temporary loss of vision</Example_3>
        <untitled-ontology-57:CUI>C0149793</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">88032003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A transient visual disturbance that is typically caused by a circulatory, ocular or neurological underlying condition</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/amenorrhea -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/amenorrhea">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/endocrine_symptoms"/>
        <Example_1>Absent menses.</Example_1>
        <Example_2>Absent menstrual period.</Example_2>
        <Example_3>Absent menstruation.</Example_3>
        <untitled-ontology-57:CUI>C0002453</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>absence of menses for three months or more.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/amnesia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/amnesia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_memory"/>
        <untitled-ontology-57:CUI>C0002622</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">48167000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Systematic and extensive loss of memory caused by organic or psychological factors. The loss may be temporary or permanent, and may involve old or recent memories.</rdfs:isDefinedBy>
        <rdfs:seeAlso>memory_loss</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/amusia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/amusia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/other_higher_cortical_functions"/>
        <untitled-ontology-57:CUI>C0234497</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">26610007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The inability to recognize musical tones or to reproduce them.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/anarthria -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/anarthria">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_speech"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0002425</HPO>
        <untitled-ontology-57:CUI>C0234517</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">48257004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Pure anarthria is a rare disorder commonly defined as a total inability to articulate speech in the absence of any deficit both of auditory comprehension and of written language. It can follow either cortical, subcortical, or brain stem lesions. Anarthria should be kept separate from mutism (inability or unwillingness to speak in the absence of any brain lesion capable of affect the articulatory planning), as well as from dysarthria (a speech disorder due to weakness or incoordination of speech muscles).</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/anhidrosis -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/anhidrosis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/skin_finding"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0000970</HPO>
        <untitled-ontology-57:CUI>C4024874</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>An absence of sweating.</rdfs:isDefinedBy>
        <rdfs:seeAlso>ipsilatera_absence_of_facial_sweating</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/anisocoria -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/anisocoria">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pupil_finding"/>
        <untitled-ontology-57:CUI>C0003079</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13045009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Anisocoria, or unequal pupil size, may represent a benign physiologic variant or a manifestation of disease.</rdfs:isDefinedBy>
        <rdfs:seeAlso>unequal_pupils</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ankle_clonus -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ankle_clonus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/clonus"/>
        <Example_1>clonus at the ankle.</Example_1>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0011448</HPO>
        <untitled-ontology-57:CUI>C0238651</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">39055007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Clonus is an involuntary tendon reflex that causes repeated flexion and extension of the foot. Ankle clonus is tested by rapidly flexing the foot upward.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/anomia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/anomia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/paraphasia"/>
        <untitled-ontology-57:CUI>C0003113</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10325006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A language dysfunction characterized by the inability to name people and objects that are correctly perceived.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/anorexia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/anorexia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/consitutitional_symptoms"/>
        <Example_1>no appetite</Example_1>
        <Example_2>poor appetite</Example_2>
        <Example_3>Aversion to food</Example_3>
        <untitled-ontology-57:CUI>C0003123</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">79890006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>clinical manifestation consisting of a physiopathological lack or loss of appetite accompanied by an aversion to food and the inability to eat.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/anosmia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/anosmia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyposmia"/>
        <Example_1>loss of smell.</Example_1>
        <Example_2>Unable to smell.</Example_2>
        <Example_3>Anosmia.</Example_3>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0000458</HPO>
        <untitled-ontology-57:CUI>C0003126</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">44169009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An inability to perceive odors. This is a general term describing inability to smell arising in any part of the process of smelling from absorption of odorants into the nasal mucous overlying the olfactory epithelium, diffusion to the cilia, binding to olfactory receptor sites, generation of action potentials in olfactory neurons, and perception of a smell.</rdfs:isDefinedBy>
        <rdfs:seeAlso>loss_of_smell</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/anosognosia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/anosognosia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/agnosia"/>
        <Example_1>Unaware of neurological deficits</Example_1>
        <Example_2>Unaware of illness</Example_2>
        <synonym_1>denial of illness</synonym_1>
        <synonym_2>unaware of illness or deficits</synonym_2>
        <untitled-ontology-57:CUI>C0234507</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20930002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A condition in which a person who suffers illness or disability seems unaware of or denies the existence of the illness or disabilit</rdfs:isDefinedBy>
        <rdfs:seeAlso>Denial_of_illness</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/anxiety -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/anxiety">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abnormal_affect"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0000739</HPO>
        <untitled-ontology-57:CUI>C0003467</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Feelings or emotions of dread, apprehension, and impending disaster but not disabling as with ANXIETY DISORDERS.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/apathy -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/apathy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#abnormal_behavior"/>
        <Example_1>Showing little drive or interest</Example_1>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0000741</HPO>
        <synonym_1>listless</synonym_1>
        <synonym_2>lacking energy</synonym_2>
        <synonym_3>apathetic</synonym_3>
        <untitled-ontology-57:CUI>C0085632</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20602000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Lack of emotion or emotional expression; a disorder of motivation that persists over time.</rdfs:isDefinedBy>
        <rdfs:seeAlso>listless</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#language_disorders"/>
        <Example_1>Impairment in comprehension, naming, repetition, and expression.</Example_1>
        <untitled-ontology-57:CUI>C0003537</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">87486003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Cognitive disorder marked by an impaired ability to comprehend or express language in its written or spoken form; caused by diseases which affect the language areas of the dominant hemisphere; general categories include receptive, expressive, and mixed forms of aphasia</rdfs:isDefinedBy>
        <rdfs:seeAlso>dysphasia</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_Broca -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_Broca">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia"/>
        <untitled-ontology-57:CUI>C0003550</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">229654003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An aphasia characterized by impairment of expressive LANGUAGE (speech, writing, signs) and relative preservation of receptive language abilities (i.e., comprehension). This condition is caused by lesions of the motor association cortex in the FRONTAL LOBE (BROCA AREA and adjacent cortical and white matter regions).</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_Wernicke -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_Wernicke">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia"/>
        <untitled-ontology-57:CUI>C1510456</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">69206000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Impairment in the comprehension of speech and meaning of words, both spoken and written, and of the meanings conveyed by their grammatical relationships in sentences. It is caused by lesions that primarily affect Wernicke&apos;s area, which lies in the posterior perisylvian region of the temporal lobe of the dominant hemisphere.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_anomic -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_anomic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia"/>
        <untitled-ontology-57:CUI>C2228041</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10325006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A mild form of aphasia with prominent problems in word retrieval and naming.  Repetition and comprehension are usually spared.  Speech is fluent.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_apraxia_dyslexia_or_agnosia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_apraxia_dyslexia_or_agnosia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#abnormality_of_higher_mental_function"/>
        <untitled-ontology-57:CUI>C1291740</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">106169008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Aphasia, apraxia, alexia, and agnosia are commonly grouped together as higher cortical functions.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_conduction -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_conduction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia"/>
        <untitled-ontology-57:CUI>C0234471</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">89410007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A type of fluent aphasia characterized by an impaired ability to repeat one and two word phrases, despite retained comprehension. This condition is associated with dominant hemisphere lesions involving the arcuate fasciculus (a white matter projection between Broca&apos;s and Wernicke&apos;s areas) and adjacent structures. Like patients with Wernicke aphasia (APHASIA, WERNICKE), patients with conduction aphasia are fluent but commit paraphasic errors during attempts at written and oral forms of communication.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_global -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_global">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia"/>
        <untitled-ontology-57:CUI>C0234469</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">23011003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A severe form of aphasia with disturbances of both comprehension, repetition, and expression.  Naming is impaired.</rdfs:isDefinedBy>
        <rdfs:seeAlso>total_aphasia</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_mixed -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_mixed">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia"/>
        <untitled-ontology-57:CUI>C0454576</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">229662006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A form of aphasia with both deficits in expression and comprehension.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_semantic -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_semantic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia"/>
        <untitled-ontology-57:CUI>C0234482</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">331652006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A form of aphasia with relatively preserved naming and repetition but deficits in comprehension of complex grammatical structures.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_subcortical -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_subcortical">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia"/>
        <untitled-ontology-57:CUI>C0234483</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5934007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Subcortical aphasia refers to language impairments that develop in association with damage-affecting regions other than the cerebral hemisphere, usually the left thalamus and basal ganglia.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_transcortical -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_transcortical">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia"/>
        <untitled-ontology-57:CUI>C0679447</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">130990006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Transcortical aphasia is a form of aphasia with preserved ability to repeat words and phrases.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/apraxia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/apraxia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_apraxia_dyslexia_or_agnosia"/>
        <Example_1>loss of ability to perform skilled movements.</Example_1>
        <untitled-ontology-57:CUI>C0003635</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">68345001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>loss of ability to perform familiar, purposeful movements in the absence of paralysis or other neural sensorimotor impairment.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/apraxia_constructional -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/apraxia_constructional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/apraxia"/>
        <untitled-ontology-57:CUI>C2243023</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">76251002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Constructional apraxia is characterized by an inability or difficulty to build, assemble, or draw objects.  Apraxia is a neurological disorder in which people are unable to perform tasks or movements even though they understand the task, are willing to complete it, and have the physical ability to perform the movements. Constructional apraxia may be caused by lesions in the parietal lobe following stroke or it may serve as an indicator for Alzheimer&apos;s disease.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/apraxia_dressing -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/apraxia_dressing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/apraxia"/>
        <Example_1>Unable to correctly put on clothing.</Example_1>
        <Example_2>Unable to dress self.</Example_2>
        <Example_3>Difficulty dressing oneself.</Example_3>
        <untitled-ontology-57:CUI>C0234529</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">179005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Dressing apraxia is a syndrome of the right (incorrectly defined as minor) hemisphere, indicating the incapacity of effectuating the acts of dressing correctly (for example passing the head in the sleeve or dressing trousers at the inverse etc…). However this difficulty should not be explained by a primary motor or sensory deficit or by a general attention failure (as it can be observed in patients with dementia, delirium or with a severe frontal syndrome). Interestingly, several cases reports of patients with pure dressing apraxia have been published, without the evidence of the co-presence of other forms of apraxia or other significant deficits in other cognitive spheres.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/apraxia_ideational -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/apraxia_ideational">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/apraxia"/>
        <Example_1>Could not perform complex sequential motor acts.</Example_1>
        <Example_2>Was not able to show how to light a match.</Example_2>
        <Example_3>Was not able to show how to seal an envelope.</Example_3>
        <untitled-ontology-57:CUI>C0234526</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">66397001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An inability to perform complex sequential motor acts due to brain disease.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/apraxia_ideomotor -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/apraxia_ideomotor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/apraxia"/>
        <Example_1>Was not able to pantomine how to deal cards or wave good bye.</Example_1>
        <Example_2>Was not able to pantomine how to use a screwdriver or a hammer.</Example_2>
        <Example_3>Was not able to show how to wave good bye or brush teeth.</Example_3>
        <synonym_1>motor apraxia</synonym_1>
        <synonym_2>ideomotor dyspraxia</synonym_2>
        <synonym_3>motor dyspraxia</synonym_3>
        <untitled-ontology-57:CUI>C0234523</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">229706001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A form of apraxia characterized by an acquired inability to carry out a complex motor activity despite the ability to mentally formulate the action. This condition has been attributed to a disruption of connections between the dominant parietal cortex and supplementary and premotor cortical regions in both hemispheres.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/apraxia_oral -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/apraxia_oral">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/apraxia"/>
        <Example_1>Loss of skill with oral musculature</Example_1>
        <Example_2>Unable to blow a kiss</Example_2>
        <Example_3>Unable to blow out candles or whistle</Example_3>
        <synonym_1>oral dyspraxia</synonym_1>
        <synonym_2>oral-buccal-lingual apraxia</synonym_2>
        <synonym_3>oral-buccal apraxia</synonym_3>
        <untitled-ontology-57:CUI>C0454608</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">361274000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Oral apraxia, for example, is an inability to voluntarily control the muscles used to move the mouth</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/areflexia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/areflexia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyporeflexia"/>
        <Example_1>Absent reflexes.</Example_1>
        <Example_2>No reflexes.</Example_2>
        <Example_3>Areflexia.</Example_3>
        <synonym_1>Absence of reflexes.</synonym_1>
        <untitled-ontology-57:CUI>C4228025</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">37280007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Absence of neurologic reflexes such as the knee-jerk reaction.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/areflexia_lower_limbs -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/areflexia_lower_limbs">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_tendon_reflex"/>
        <untitled-ontology-57:CUI>C1856694</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Inability to elicit tendon reflexes in the lower limbs.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/areflexia_upper_limbs -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/areflexia_upper_limbs">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/absent_tendon_reflex"/>
        <Example_1>absent deep tendon reflexes in the upper extremity</Example_1>
        <Example_2>absent deep tendon reflexes in the arm.</Example_2>
        <Example_3>Absent reflexes in the upper limb.</Example_3>
        <synonym_1>areflexia in the arm.</synonym_1>
        <synonym_2>areflexia in the upper extremity.</synonym_2>
        <synonym_3>areflexia in the upper limb.</synonym_3>
        <untitled-ontology-57:CUI>C2674177</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Reflex</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Inability to elicit tendon reflexes in the upper limbs.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/arms_not_swung_while_walking -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/arms_not_swung_while_walking">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_arm_swing"/>
        <untitled-ontology-57:CUI>C0424233</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">247906006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The reduced swinging of the arms while walking usually indicates an extra-pyramidal motor disorder such as Parkinson disease.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/arthralgia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/arthralgia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain"/>
        <untitled-ontology-57:CUI>C0003862</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Sensation of unpleasant feeling indicating potential or actual damage to some body structure felt in one or more joints. A disorder characterized by a sensation of marked discomfort in a joint.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ascending_numbness_and_weakness -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ascending_numbness_and_weakness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/numbness"/>
        <Example_1>ascending numbness</Example_1>
        <Example_2>ascending weakness</Example_2>
        <Example_3>weakness that began in legs and spread to the arms</Example_3>
        <synonym_1>numbness that began in the legs and spread to the arms</synonym_1>
        <untitled-ontology-57:CUI>C3549452</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Weakness and numbness that begins in the lower limbs and ascends to the upper limbs over time. Guillain-Barre syndrome often begins with tingling and weakness starting in your feet and legs and spreading to your upper body and arms.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ascites -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ascites">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/GI_symptoms"/>
        <synonym_1>ascites</synonym_1>
        <synonym_2>excess abdominal fluid</synonym_2>
        <untitled-ontology-57:CUI>C0003962</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">389026000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An abnormal accumulation of serous fluid in the abdominal cavity</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ash_leaf_spot -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ash_leaf_spot">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypomelanotic_macule"/>
        <synonym_1>ash leaf spot</synonym_1>
        <untitled-ontology-57:CUI>C4073125</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Skin</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">254243001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Hypomelanic macules (&quot;ash leaf spots&quot;) are present in about 90% of people with tuberous sclerosis. These small white or lighter patches of skin may appear anywhere on the body, and are caused by a lack of melanin. They are usually the only visible sign of tuberous sclerosis at birth.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/astasia_abasia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/astasia_abasia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hysterical_gait"/>
        <untitled-ontology-57:CUI>C0004090</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">71802006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Astasia-abasia refers to the inability to either stand or walk in a normal manner. Astasia refers to the inability to stand upright unassisted. Abasia refers to lack of motor coordination in walking.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/astereognosis -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/astereognosis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/stereognosis_impaired"/>
        <Example_1>Unable to recognize objects by touch.</Example_1>
        <Example_2>Did not recognize objects placed in hand</Example_2>
        <untitled-ontology-57:CUI>C2830446</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">25094008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Inability to recognize the form of objects by touch without visual input. That is, an impairment in the recognition of objects based only on based on the texture, size, weight and three-dimensional form of the object in the absence of any major somatosensory deficit.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/asterixis -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/asterixis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abnormal_involuntary_movement"/>
        <Example_1>the inability to maintain sustained posture with subsequent brief, shock-like, involuntary movements</Example_1>
        <synonym_1>liver flap</synonym_1>
        <synonym_2>flapping tremor</synonym_2>
        <untitled-ontology-57:CUI>C0232766</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">32838008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A clinical sign indicating a lapse of posture and is usually manifest by a bilateral flapping tremor at the wrist, metacarpophalangeal, and hip joints.</rdfs:isDefinedBy>
        <rdfs:seeAlso>flapping_tremor; liver_flap</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/asymmetric_smile -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/asymmetric_smile">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_paresis"/>
        <untitled-ontology-57:CUI>C3842129</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A smile in which both corners of the mouth do not elevate symmetrically, often a sign of facial weakness.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ataxia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ataxia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#cerebellar_signs"/>
        <Example_1>inaccurate movements</Example_1>
        <Example_2>imprecise movements</Example_2>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0001251</HPO>
        <synonym_1>dystaxia</synonym_1>
        <synonym_2>dyssynergia</synonym_2>
        <untitled-ontology-57:CUI>C0004134</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20262006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Ataxia is the presence of uncoordinated, imprecise, and inaccurate movements. Ataxia is the cardinal sign of cerebellar disease.</rdfs:isDefinedBy>
        <rdfs:seeAlso>dyssynergia; dystaxia</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ataxia_appendicular -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ataxia_appendicular">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ataxia"/>
        <untitled-ontology-57:CUI>C0750937</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Ataxia that affects primarily the limbs and can be elicited by the finger-to-nose test or heel-knee-shin test or rapid alternating movements.</rdfs:isDefinedBy>
        <rdfs:seeAlso>limb_ataxia</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ataxia_cerebellar -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ataxia_cerebellar">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ataxia"/>
        <untitled-ontology-57:CUI>C0007758</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">85102008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Cerebellar ataxia refers to ataxia due to dysfunction of the cerebellum. This causes a variety of elementary neurological deficits including asynergy (lack of coordination between muscles, limbs and joints), dysmetria (lack of ability to judge distances that can lead to under- or overshoot in grasping movements), and dysdiadochokinesia (inability to perform rapid movements requiring antagonizing muscle groups to be switched on and off repeatedly).</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ataxia_mild -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ataxia_mild">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ataxia"/>
        <untitled-ontology-57:CUI>C3278191</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Ataxia that is of mild severity.  See definition of ataxia.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ataxia_optic -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ataxia_optic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Balint_syndrome"/>
        <Example_1>Difficulty reaching for objects accurately under visual guidance.</Example_1>
        <Example_2>Impaired reaching under visual guidance</Example_2>
        <untitled-ontology-57:CUI>C4703584</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Difficulty reaching to visually guided goals in peripheral vision, with the deficit leaves voluntary eye movements largely unaffected.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ataxia_sensory -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ataxia_sensory">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ataxia"/>
        <untitled-ontology-57:CUI>C0240991</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">445458007</untitled-ontology-57:SNOMED>
        <rdfs:comment>Proprioceptive deficits may produce truncal or appendicular ataxia that resembles cerebellar ataxia.  The Romberg test may disclose that the truncal ataxia is due to proprioceptive as opposed to cerebellar dysfunction if the patient begins to sway with feet together when the eyes are closed.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ataxia_truncal -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ataxia_truncal">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ataxia"/>
        <untitled-ontology-57:CUI>C0427190</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">250067008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Truncal ataxia is manifested by swaying while standing or walking.  Its origins may reflect dysfunction of cerebellar or proprioceptive systems.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/athetosis -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/athetosis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyperkinesia"/>
        <Example_1>Slow writhing movements of hands or feet.</Example_1>
        <Example_2>writhing movements.</Example_2>
        <untitled-ontology-57:CUI>C0004158</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">58593005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A movement disorder consisting of slow, involuntary, and nonpurposeful writhing movements that usually affect the upper limbs.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/atrophy_of_the_small_muscles_in_the_hand -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/atrophy_of_the_small_muscles_in_the_hand">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/muscle_atrophy_hand_muscles"/>
        <untitled-ontology-57:CUI>C3808485</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Muscle atrophy in the small muscles of the hand.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/attention_problems -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/attention_problems">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impairment_of_attention"/>
        <untitled-ontology-57:CUI>C4522293</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Disorders of sustained attention. A failure to attend to stimuli.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/auditory_inattention -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/auditory_inattention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/extinction_and_neglect"/>
        <untitled-ontology-57:CUI>C0750942</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Inattention to sounds in one sphere of space or in one ear.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/autistic_features -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/autistic_features">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#abnormal_behavior"/>
        <untitled-ontology-57:CUI>C1846135</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>These are some of the characteristics of ASD: problems with social interaction with others. unusual interest in objects. need for sameness. great variation in abilities. under or over reaction to one or more of the five senses: sight, touch, taste, smell, or hearing. repeated actions or body movements. Delayed or abnormal language.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/automatisms -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/automatisms">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/seizure"/>
        <untitled-ontology-57:CUI>C0004377</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">52669001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Automatic, mechanical, and apparently undirected behavior which is outside of conscious control.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/autotopagnosia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/autotopagnosia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/agnosia"/>
        <Example_1>Unable to localize ones own body parts</Example_1>
        <Example_2>Unable to orient oneself to ones own body parts</Example_2>
        <synonym_1>body image agnosia</synonym_1>
        <synonym_2>somatotopagnosia</synonym_2>
        <untitled-ontology-57:CUI>C0234511</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24500009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Autotopagnosia is a form of agnosia, characterized by an inability to localize and orient different parts of the body.The disorder has also been referred to as &quot;body-image agnosia&quot; or &quot;somatotopagnosia.&quot; Somatotopagnosia has been argued to be a better suited term to describe the condition. While autotopagnosia emphasizes the deficiencies in localizing only one&apos;s own body parts and orientation, somatotopagnosia also considers the inability to orient and recognize the body parts of others or representations of the body (e.g., manikins, diagrams)</rdfs:isDefinedBy>
        <rdfs:seeAlso>body_image_agnosia</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/balance_finding -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/balance_finding">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/gait_disorder"/>
        <Example_1>Impairment of balance.</Example_1>
        <Example_2>Abnormal balance.</Example_2>
        <untitled-ontology-57:CUI>C0575082</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">298304004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A  finding of impaired balance which may include unsteadiness, swaying, or falling.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/barber_chair_sign -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/barber_chair_sign">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/Lhermitte_sign_positive"/>
        <Example_1>Lhermitte sign</Example_1>
        <Example_2>Lhermitte sign positive</Example_2>
        <Example_3>Electric shock like sensation down spine on neck flexion</Example_3>
        <synonym_1>barber chair sign present</synonym_1>
        <synonym_2>barber chair sign positive</synonym_2>
        <untitled-ontology-57:CUI>C0576702</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Neck</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">299950000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Lhermitte&apos;s sign (also known as Lhermitte&apos;s phenomenon also referred to as the barber chair phenomenon is the name which describes an electric shock-like sensation that occurs on flexion of the neck. This sensation radiates down the spine, often into the legs, arms, and sometimes to the trunk.</rdfs:isDefinedBy>
        <rdfs:seeAlso>barbers_chair_sign; Lhermittes_phenomenom</rdfs:seeAlso>
    </owl:Class>
    


