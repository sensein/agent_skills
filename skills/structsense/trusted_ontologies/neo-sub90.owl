        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">286756000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Behavior characterized by reduced control</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/inability_to_walk -->

