        <rdfs:isDefinedBy>Complete or partial loss of movement in the lower part of the body, including both legs</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/paresthesias -->

