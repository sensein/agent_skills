        <Example_2>spasm</Example_2>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0003394</HPO>
        <untitled-ontology-57:CUI>C0037763</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">45352006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Sudden and involuntary contractions of one or more muscles.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#muscle_tightness -->

