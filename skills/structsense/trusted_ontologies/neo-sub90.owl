        <untitled-ontology-57:Exam_Part>Course</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">255319006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A course characterized by remissions with improvement.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#retinal_finding -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#retinal_finding">
