    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#Kernig_sign -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#Kernig_sign">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/neck_stiffness"/>
        <Example_1>Unable to extend the knees due to neck stiffness.</Example_1>
        <Example_2>Positive Kernig sign.</Example_2>
        <Example_3>Kernig sign present.</Example_3>
        <synonym_1>Unable to extend legs at knees due to stiff neck.</synonym_1>
        <untitled-ontology-57:CUI>C0234178</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Neck</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Kernig described a positive sign as the inability to extend the knees more than 135 degrees.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#Kernig_sign_positive -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#Kernig_sign_positive">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#Kernig_sign"/>
        <Example_1>Kernig sign positive</Example_1>
        <Example_2>Kernig sign present.</Example_2>
        <Example_3>Unable to extend legs at knees due to stiff neck.</Example_3>
        <untitled-ontology-57:CUI>C0240103</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Neck</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Kernig described a positive sign as the inability to extend the knees more than 135 degrees.</rdfs:isDefinedBy>
    </owl:Class>
    


