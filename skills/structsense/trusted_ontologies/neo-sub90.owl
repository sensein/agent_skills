        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">343087000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Incomplete hearing loss.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/past_pointing -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/past_pointing">
