        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">246564008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Inattention to stimuli on one side of the body.</rdfs:isDefinedBy>
        <rdfs:seeAlso>hemi-inattention; sensory_inattention</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/neologism -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/neologism">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/paraphasia"/>
        <untitled-ontology-57:CUI>C0233647</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">54501006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>a new word that is coined especially by a person affected with schizophrenia, aphasia, or dementia and is meaningless except to the coiner, and is typically a combination of two existing words or a shortening or distortion of an existing word</rdfs:isDefinedBy>
    </owl:Class>
    


