        <untitled-ontology-57:CUI>C1847766</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Muscle atrophy in the shoulder girdle muscles.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/muscle_atrophy_tongue -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/muscle_atrophy_tongue">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/wasting_of_tongue"/>
        <Example_1>tongue atrophy</Example_1>
        <synonym_3>wasting of the tongue</synonym_3>
        <untitled-ontology-57:CUI>C0241423</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">50805004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Atrophy of the tongue.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/muscle_cramps -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/muscle_cramps">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/neuromuscular_symptoms"/>
        <Example_1>involuntary muscle contractions</Example_1>
        <Example_2>muscle cramps</Example_2>
        <Example_3>muscular cramping.</Example_3>
        <untitled-ontology-57:CUI>C0026821</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A sudden and involuntary contraction of a muscle muscle, which may be painful.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/muscle_fatigue -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/muscle_fatigue">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#motor_disorders"/>
        <Example_1>easy fatigue of muscles.</Example_1>
        <Example_2>muscles are fatiguable.</Example_2>
        <Example_3>Muscles lose strength on use.</Example_3>
        <synonym_1>Loss of muscle strength with continued effort.</synonym_1>
        <synonym_2>Loss of muscle strength with continued use.</synonym_2>
        <synonym_3>muscle fatigue</synonym_3>
        <untitled-ontology-57:CUI>C0242979</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">80449002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An abnormal, increased fatiguability of the musculature.</rdfs:isDefinedBy>
        <rdfs:seeAlso>fatiguability: muscle_tire_easily</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/muscle_hypertrophy -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/muscle_hypertrophy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#motor_disorders"/>
        <Example_1>enlarged muscles</Example_1>
        <Example_2>overgrown muscle</Example_2>
        <Example_3>large muscles</Example_3>
        <synonym_1>muscle enlargement</synonym_1>
        <untitled-ontology-57:CUI>C0236033</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">249829006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>general increase in bulk of a muscle due to an increase in cell volume; it is not due to tumor formation, nor to an increase in the number of cells.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/muscle_tenderness -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/muscle_tenderness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#motor_disorders"/>
        <Example_1>tender muscle</Example_1>
        <Example_2>tenderness of muscle noted</Example_2>
        <Example_3>tenderness of muscle was seen</Example_3>
        <untitled-ontology-57:CUI>C0240419</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22166009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Tenderness of the muscle on palpation.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/muscle_twitching -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/muscle_twitching">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/neuromuscular_symptoms"/>
        <untitled-ontology-57:CUI>C0231530</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">249966004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The occurrence of a single contraction or a series of contractions of a muscle.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/muscle_weakness_proximal_limb_muscle_mild_to_moderate -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/muscle_weakness_proximal_limb_muscle_mild_to_moderate">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_proximal_muscle"/>
        <untitled-ontology-57:CUI>C3149744</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Weakness in the proximal muscles of the arms and legs of mild to moderate severity</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/mutism -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/mutism">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_speech"/>
        <synonym_1>mute</synonym_1>
        <untitled-ontology-57:CUI>C0026884</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">88052002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The inability to generate oral-verbal expression, despite normal comprehension of speech. This may be associated with brain diseases or mental diseases.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/myalgias -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/myalgias">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain"/>
        <untitled-ontology-57:CUI>C0231528</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">68962001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Myalgias can be defined as muscle aches. Myalgias can be a deep, constant, dull ache, or a sharp, sporadic ache.</rdfs:isDefinedBy>
        <rdfs:seeAlso>muscle pain</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/mydriasis -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/mydriasis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pupil_finding"/>
        <Example_1>mydriatic pupil</Example_1>
        <Example_2>mydriasis</Example_2>
        <synonym_1>dilated pupil</synonym_1>
        <synonym_2>pupil dilated</synonym_2>
        <synonym_3>wide pupil</synonym_3>
        <untitled-ontology-57:CUI>C0026961</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">37125009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Abnormal dilatation of the iris.</rdfs:isDefinedBy>
        <rdfs:seeAlso>dilated_pupil</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/myedema -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/myedema">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#motor_disorders"/>
        <Example_1>edema of skeletal muscle</Example_1>
        <synonym_1>myoedema</synonym_1>
        <synonym_2>edema of skeletal muscle</synonym_2>
        <synonym_3>mioedema</synonym_3>
        <untitled-ontology-57:CUI>C0456703</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">277374006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A localized contraction of a degenerating muscle, occurring at the point of a sharp blow, independent of the nerve supply.  Sometimes a small bump occurs on a muscle at the site of a percussion blow.  Myoedema may also occur in uremia and myxedema.</rdfs:isDefinedBy>
        <rdfs:seeAlso>myoedema</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/myoclonic_seizures -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/myoclonic_seizures">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/seizure"/>
        <untitled-ontology-57:CUI>C4317123</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">37356005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A myoclonic seizure is a type of motor seizure characterised by sudden, brief (&lt;100 ms) involuntary single or multiple contraction of muscles or muscle groups of variable topography (axial, proximal limb, distal).</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/myoclonus -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/myoclonus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abnormal_involuntary_movement"/>
        <Example_1>myoclonus</Example_1>
        <Example_2>myoclonia</Example_2>
        <Example_3>myoclonic jerk</Example_3>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0001336</HPO>
        <synonym_1>myoclonic jerking</synonym_1>
        <untitled-ontology-57:CUI>C0027066</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17450006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A rapid, involuntary jerk of a muscle or group of muscles.</rdfs:isDefinedBy>
        <rdfs:seeAlso>myoclonic jerks</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/myoclonus_startle -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/myoclonus_startle">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyperexplexia"/>
        <Example_1>Myoclonic jerk when startled.</Example_1>
        <Example_2>Myoclonic jerk when startled by loud noise.</Example_2>
        <untitled-ontology-57:CUI>C1836826</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Its clinical presentation usually consists of an involuntary jerky movement (with blink, contortion of the face, flexion of neck and trunk, and abduction and flexion of the arms) evoked by a sudden and unexpected acoustic stimulus.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/myokimia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/myokimia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abnormal_involuntary_movement"/>
        <Example_1>Myokymias are localised involuntary contractions that are wavelike or vermicular and propagate through affected striated muscle</Example_1>
        <untitled-ontology-57:CUI>C0684219</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">27678003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Myokymia consists of involuntary, fine, continuous, undulating contractions that spread across the affected striated muscle.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/myotonia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/myotonia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#motor_disorders"/>
        <Example_1>tonic muscle contraction with delayed relaxation</Example_1>
        <Example_2>myotonia observed</Example_2>
        <Example_3>Delayed relaxation of muscle after contraction</Example_3>
        <synonym_1>myotonus</synonym_1>
        <synonym_2>tonic muscle spasm</synonym_2>
        <untitled-ontology-57:CUI>C0700153</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3434004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Prolonged failure of muscle relaxation after contraction. This may occur after voluntary contractions, muscle percussion, or electrical stimulation of the muscle.  Myotonia occurs in some myopathies such as myotonia congenita, paramyotonia, certain channelopathies, and some forms of musuclar paralysis related to potassium metabolism.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/narcolepsy -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/narcolepsy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#sleep_disturbance"/>
        <untitled-ontology-57:CUI>C0027404</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">60380001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>recurrent, uncontrollable brief episodes of sleep and lapses in consciousness, often associated with hypnagogic hallucinations, cataplexy, automatic behaviors and sleep paralysis</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/nasal_congestion -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/nasal_congestion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ENT_symptoms"/>
        <synonym_1>stuffy nose</synonym_1>
        <untitled-ontology-57:CUI>C0027424</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Nasal congestion or &quot;stuffy nose&quot; occurs when nasal and adjacent tissues and blood vessels become swollen with excess fluid, causing a &quot;stuffy&quot; plugged feeling. Nasal congestion may or may not include a nasal discharge or &quot;runny nose.&quot;</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/nausea -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/nausea">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/GI_symptoms"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0002018</HPO>
        <untitled-ontology-57:CUI>C0027497</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>a feeling of sickness with an inclination to vomit</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/neck_finding -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/neck_finding">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#sign"/>
        <Example_1>neck observation</Example_1>
        <Example_2>abnormality of the neck</Example_2>
        <Example_3>Finding of the neck,</Example_3>
        <untitled-ontology-57:CUI>C0575155</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Top</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">298378000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A physical finding in the neck region such as carotid bruit or neck stiffness.</rdfs:isDefinedBy>
        <rdfs:seeAlso>Observation of neck region;Finding of neck region</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/neck_pain_radiating_to_arm -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/neck_pain_radiating_to_arm">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain_radiating"/>
        <untitled-ontology-57:CUI>C2219659</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Pain that begins in the neck and radiates to an arm.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/neck_stiffness -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/neck_stiffness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/neck_finding"/>
        <Example_1>cervical rigidity</Example_1>
        <Example_2>stiff neck</Example_2>
        <Example_3>rigid neck</Example_3>
        <untitled-ontology-57:CUI>C0151315</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Neck</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">161882006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A sensation of tightness in the neck when attempting to move it, especially after a period of inactivity. Neck stiffness often involves soreness and difficulty moving the neck, especially when trying to turn the head to the side</rdfs:isDefinedBy>
        <rdfs:seeAlso>Neck stiffness; Stiff neck; Neck rigidity; cervical rigidity; Neck rigid</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/neglect_of_one_side_of_the_body -->

