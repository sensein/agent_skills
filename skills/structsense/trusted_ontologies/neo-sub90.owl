        <untitled-ontology-57:CUI>C2202993</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13530001000004108</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Weakness of the right hand</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weak_vocie -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weak_vocie">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypophonia"/>
        <untitled-ontology-57:CUI>C0241700</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A rather non-specific term that usually denotes decreased voice volume.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#motor_disorders"/>
        <synonym_1>loss of strength.</synonym_1>
        <synonym_2>muscle weakness</synonym_2>
        <synonym_3>loss of muscle power.</synonym_3>
        <untitled-ontology-57:CUI>C0030552</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">41786007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A general term referring to a mild to moderate degree of muscular weakness, occasionally used as a synonym for paralysis (severe or complete loss of motor function).</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_abdominals -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_abdominals">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_muscle_group"/>
        <untitled-ontology-57:CUI>C4062696</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Weakness of the abdominal muscles.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_ankle -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_ankle">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_leg"/>
        <untitled-ontology-57:CUI>C2228039</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED></untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Reduced strength of the muscles that lift or otherwise move the foot at the ankle.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_ankle_dorsiflexion -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_ankle_dorsiflexion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_ankle"/>
        <synonym_1>weak dorsiflexors of the ankle.</synonym_1>
        <untitled-ontology-57:CUI>C2230515</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>The foot and ankle dorsiflexors include the tibialis anterior, the extensor hallucis longus (EHL), and the extensor digitorum longus (EDL). These muscles help the body clear the foot during swing phase and control plantarflexion of the foot on heel strike.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_ankle_eversion -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_ankle_eversion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_ankle"/>
        <untitled-ontology-57:CUI>C2230518</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Weakness of ankle eversion.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_ankle_inversion -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_ankle_inversion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_ankle"/>
        <synonym_1>weak ankle inverters</synonym_1>
        <synonym_2>weak ankle inversion</synonym_2>
        <untitled-ontology-57:CUI>C2230517</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Weakness of ankle inversion.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_ankle_plantar_flexion -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_ankle_plantar_flexion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_ankle"/>
        <untitled-ontology-57:CUI>C2230516</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Plantar flexion is controlled by several muscles in the ankle, foot, and leg. These muscles coordinate with one another to stretch the foot forward. The triceps surae are two muscles that form the major muscles of the calf. These muscles are the gastrocnemius and the soleus, and they insert into the bone of the heel. Where they unite at the lower end of the calf, they form the Achilles tendon.  When the triceps surae contract, they cause plantar flexion. Out of all of the involved muscles, the gastrocnemius does most of the work in the movement. The soleus muscle is responsible for the action of pushing away from the ground, so is also crucial for plantar flexion. The plantaris muscle has a short belly and a long, thin tendon that extends behind the knee and into the calf. At the bottom of the calf, it connects directly with the heel bone. It works with the gastrocnemius and the soleus to facilitate plantar flexion. Interestingly, it is often considered vestigial and is absent in one or both legs in around 10% of individuals. The flexor muscles are the flexor hallucis longus and the flexor digitorum longus. The flexor hallucis longus flexes the joints of the big toe, and the flexor digitorum longus flexes the joints of the rest of the toes. These actions are both important in plantar flexion. The tibialis posterior muscle is located deep within the lower leg and assists with plantar flexion at the ankle. It is also important generally for stabilization of the ankle and leg.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_arm -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_arm">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_limb"/>
        <untitled-ontology-57:CUI>C0751409</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">249944006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Weakness in the arm including the bicep, triceps, brachioradialis, and otherr muscles of the arm.</rdfs:isDefinedBy>
        <rdfs:seeAlso>monoparesis_of_arm</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_biceps -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_biceps">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_arm"/>
        <untitled-ontology-57:CUI>C0741478</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Weakness of the biceps muscle.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_deltoid -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_deltoid">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_arm"/>
        <untitled-ontology-57:CUI>C2230475</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Weakness of the deltoid muscle.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_distal_muscle -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_distal_muscle">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness"/>
        <Example_1>Weakness distally in the hands and feet.</Example_1>
        <Example_2>Reduced strength in the distal muscles of the hands and feet.</Example_2>
        <Example_3>Reduced strength distally.</Example_3>
        <untitled-ontology-57:CUI>C0427065</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">249942005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Reduced strength of the musculature of the distal extremities</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_eye_closure -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_eye_closure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/facial_paresis"/>
        <untitled-ontology-57:CUI>C0427059</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">249935005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Difficulty closing the eyes due to facial nerve paresis.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_finger_flexors -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_finger_flexors">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_fingers"/>
        <untitled-ontology-57:CUI>C4477022</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Reduced ability to flex (bend) the fingers. This can manifest as incomplete closure of the hand due to weakness in finger flexion.</rdfs:isDefinedBy>
    </owl:Class>
    


