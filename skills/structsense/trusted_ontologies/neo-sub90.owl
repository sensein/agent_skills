        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2073000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A false belief regarding the self or persons or objects outside the self that persists despite the facts, and is not considered tenable by one&apos;s associates.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_cognition"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0000726</HPO>
        <untitled-ontology-57:CUI>C0497327</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">52448006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A loss of global cognitive ability of sufficient amount to interfere with normal social or occupational function. Dementia represents a loss of previously present cognitive abilities, generally in adults, and can affect memory, thinking, language, judgment, and behavior.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/denervation_atrophy_of_tongue -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/denervation_atrophy_of_tongue">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cranial_nerve_12_finding"/>
        <Example_1>Decreased tongue bulk due to denervation.</Example_1>
        <Example_1>atrophy of tongue</Example_1>
        <Example_2>atrophy of the tongue due to denervation.</Example_2>
        <Example_2>denervation atrophy of tongue</Example_2>
        <Example_3>wasting of tongue muscle.</Example_3>
        <untitled-ontology-57:CUI>C1274803</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">403451002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Atrophy of the tongue is manifested by a loss of bulk on the affected side.  With advanced atrophy, the tongue is furrowed, wrinkled, and obviously smaller on the affected side.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/depressed -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/depressed">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abnormal_affect"/>
        <untitled-ontology-57:CUI>C0344315</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">366979004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An emotional state characterized by feelings of sadness, emptiness, and/or tearfulness.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/depressive_disorder -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/depressive_disorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/depressed"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0000716</HPO>
        <untitled-ontology-57:CUI>C0011581</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35489007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Frequent feelings of being down, miserable, and/or hopeless; difficulty recovering from such moods; pessimism about the future; pervasive shame; feeling of inferior self-worth; thoughts of suicide and suicidal behavior.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/developmental_regression -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/developmental_regression">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cognitive_symptoms"/>
        <Example_1>Loss of developmental milestones.</Example_1>
        <Example_2>Developmental regression</Example_2>
        <untitled-ontology-57:CUI>C1836830</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">609225004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Loss of developmental skills, as manifested by loss of developmental milestones.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/deviation_uvula -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/deviation_uvula">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cranial_nerve_9_10_finding"/>
        <untitled-ontology-57:CUI>C0426994</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">249884003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The uvula will deviate away from the weak side if there is weakness of the soft palate.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/diaphoresis -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/diaphoresis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/consitutitional_symptoms"/>
        <synonym_1>sweating</synonym_1>
        <synonym_2>excessive sweating</synonym_2>
        <untitled-ontology-57:CUI>C0700590</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">415691001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>sweating, especially to an unusual degree as a symptom of disease or a side effect of a drug.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/diarrhea -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/diarrhea">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#bowel_problems"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0002014</HPO>
        <untitled-ontology-57:CUI>C0011991</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">62315008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Diarrhea is characterized by loose, watery stools or a frequent need to have a bowel movement. It usually lasts a few days and often disappears without any treatment. Diarrhea can be acute or chronic. Acute diarrhea occurs when the condition lasts for one to two days.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/difficulty_in_initiating_movements -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/difficulty_in_initiating_movements">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abulia"/>
        <untitled-ontology-57:CUI>C0562455</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">284511008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A slowness in initiating movements generally suggests a frontal lobe lesion damaging circuits involved in movement initiation.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/difficulty_in_speaking -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/difficulty_in_speaking">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/speech_impairment"/>
        <Example_1>difficulty speaking</Example_1>
        <Example_2>speech difficulty</Example_2>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0002465</HPO>
        <untitled-ontology-57:CUI>C1527347</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">47004009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A problem in speaking fluently and easily.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/difficulty_reading -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/difficulty_reading">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/unable_to_read"/>
        <Example_1>Unable to read.</Example_1>
        <Example_2>Impaired reading.</Example_2>
        <Example_3>Cannot read.</Example_3>
        <untitled-ontology-57:CUI>C0586742</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Experiencing difficulties in reading.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/difficulty_walking -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/difficulty_walking">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/neuromuscular_symptoms"/>
        <Example_1>Difficulty waking.</Example_1>
        <Example_2>Impaired walking.</Example_2>
        <Example_3>Walks poorly.</Example_3>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0002355</HPO>
        <untitled-ontology-57:CUI>C0311394</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">228158008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Reduced ability to walk (ambulate).</rdfs:isDefinedBy>
        <rdfs:seeAlso>trouble walking</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/difficulty_writing -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/difficulty_writing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/agraphia"/>
        <untitled-ontology-57:CUI>C0584995</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">102938007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Experiencing difficulties in writing which may be either linguistic or motor.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/diplegia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/diplegia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_limb"/>
        <untitled-ontology-57:CUI>C0221165</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6481005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Paralysis affecting corresponding parts on both sides of the body.</rdfs:isDefinedBy>
        <rdfs:seeAlso>bilateral_paralysis</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/diplegia_of_arms -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/diplegia_of_arms">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/diplegia"/>
        <untitled-ontology-57:CUI>C4302036</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">723157009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Weakness in both arms.</rdfs:isDefinedBy>
        <rdfs:seeAlso>paralysis_of_both_arms; unable_to_move_both_arms</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/diplegia_of_upper_limbs -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/diplegia_of_upper_limbs">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/diplegia_of_arms"/>
        <synonym_1>bilateral arm weakness</synonym_1>
        <untitled-ontology-57:CUI>C0154701</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Weakness of both arms.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/diplopia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/diplopia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abnormal_vision"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0000651</HPO>
        <untitled-ontology-57:CUI>C0012569</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24982008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Diplopia is a condition in which a single object is perceived as two images, it is also known as double vision.</rdfs:isDefinedBy>
        <rdfs:seeAlso>seeeing_double; double_vision</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disinhibition -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disinhibition">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#abnormal_behavior"/>
        <untitled-ontology-57:CUI>C0474398</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">247973004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Disinhibition can be defined as the inability to withhold a prepotent response or suppress an inappropriate or unwanted behavior. It can refer to the production of socially inappropriate comments and/or actions.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disorders_of_eyelid -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disorders_of_eyelid">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cranial_nerve_finding"/>
        <untitled-ontology-57:CUI>C0015423</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">60113004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Any disease affecting the eyelid.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disorientation -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disorientation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#abnormality_of_higher_mental_function"/>
        <Example_1>Confused as to location, time, or person.</Example_1>
        <Example_2>A temporary or permanent state of confusion regarding place, time, or personal identity</Example_2>
        <Example_3>Loss of one&apos;s sense of direction, position, or relationship with one&apos;s surroundings.</Example_3>
        <untitled-ontology-57:CUI>C0233407</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">62476001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>the condition of having lost one&apos;s sense of direction.</rdfs:isDefinedBy>
        <rdfs:seeAlso>disoriented</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disorientation_to_person_place_and_time -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disorientation_to_person_place_and_time">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disorientation"/>
        <untitled-ontology-57:CUI>C0278062</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">39538002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>No oriented to person, place, or time.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disoriented -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disoriented">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disorientation"/>
        <untitled-ontology-57:CUI>C1546414</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Lacking orientation to time, place, or person. Disoriented.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disoriented_in_place -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disoriented_in_place">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disorientation"/>
        <Example_1>Confused as to location.</Example_1>
        <Example_2>Disoriented to place.</Example_2>
        <Example_3>Confused as to place.</Example_3>
        <untitled-ontology-57:CUI>C0233409</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">72440003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Impaired awareness of place</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disoriented_in_time -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disoriented_in_time">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disoriented_to_time"/>
        <untitled-ontology-57:CUI>C0233408</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Lacking in orientation to time as in day, date, month, or year.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disoriented_to_person -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disoriented_to_person">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disorientation"/>
        <untitled-ontology-57:CUI>C0455741</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">62766000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Not knowing ones own name.  Disoriented to self.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disoriented_to_place -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disoriented_to_place">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disoriented_in_place"/>
        <untitled-ontology-57:CUI>C4062230</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Not knowing ones current location.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disoriented_to_time -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disoriented_to_time">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disorientation"/>
        <untitled-ontology-57:CUI>C4062229</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19657006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Lack of orientation to time.  Not knowing the day, month, date, or year.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disoriented_to_time_person_and_place -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disoriented_to_time_person_and_place">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/disorientation_to_person_place_and_time"/>
        <untitled-ontology-57:CUI>C1948161</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Not oriented to person, place, or time.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dissociative_convulsions -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dissociative_convulsions">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/conversion_disorder"/>
        <synonym_1>pseudoseizures</synonym_1>
        <synonym_2>psychogenic non-epileptic seizures</synonym_2>
        <synonym_3>PNES</synonym_3>
        <untitled-ontology-57:CUI>C0349245</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">191714002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Pseudoseizures, also called psychogenic nonepileptic seizures (PNES), are seizures that occur as a result of psychological causes, such as severe mental stress. Treating the underlying psychological cause can often help to reduce the number of seizures or prevent them happening.</rdfs:isDefinedBy>
        <rdfs:seeAlso>hysterical_seizures</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dissociative_tremor -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dissociative_tremor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/conversion_disorder"/>
        <untitled-ontology-57:CUI>C0349742</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">191713008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Tremor that is believed due to a dissociative disorder and without known physical cause.</rdfs:isDefinedBy>
        <rdfs:seeAlso>hysterical_tremor</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/distal_limb_muscle_atrophy_due_to_peripheral_neuropathy_mild -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/distal_limb_muscle_atrophy_due_to_peripheral_neuropathy_mild">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#distal_amyotrophy"/>
        <untitled-ontology-57:CUI>C1850396</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>muscle atrophy distally in the hands and feet.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/distal_muscle_weakness_mild -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/distal_muscle_weakness_mild">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/weakness_distal_muscle"/>
        <untitled-ontology-57:CUI>C1837343</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Mild weakness distally in the hands and the feet.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/distal_sensory_impairment -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/distal_sensory_impairment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hypesthesia"/>
        <Example_1>Loss of sensation distally in the hands and the feet.</Example_1>
        <Example_2>Distal sensory impairment.</Example_2>
        <Example_3>Distal loss of sensation in the fingers and toes.</Example_3>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0002936</HPO>
        <untitled-ontology-57:CUI>C1847584</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Sensory</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>An abnormal reduction in sensation in the distal portions of the extremities.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/distal_sensory_impairment_of_all_modalities -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/distal_sensory_impairment_of_all_modalities">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/distal_sensory_impairment"/>
        <untitled-ontology-57:CUI>C1836527</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Sensory</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Decreased sensation to pain, temperature, touch, and vibration distally in the hands and feet.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/distal_sensory_loss_of_proprioception_and_vibration_sense -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/distal_sensory_loss_of_proprioception_and_vibration_sense">
