        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">299942009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Loss of ability to sense joint position using proprioceptors.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_judgment -->

