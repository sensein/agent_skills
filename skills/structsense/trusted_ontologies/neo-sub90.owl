        <untitled-ontology-57:Exam_Part>Course</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Characterized by exacerbations and remissions.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#remitting -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#remitting">
