        <untitled-ontology-57:CUI>C4546137</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#adolescent -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#adolescent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#age"/>
        <untitled-ontology-57:CUI>C0205653</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Age</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">133937008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A person 13 to 18 years of age.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#adult -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#adult">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#age"/>
        <untitled-ontology-57:CUI>C4323874</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Age</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">133936004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>19 to 64 years of age</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#age -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#age">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#sign"/>
        <untitled-ontology-57:CUI>C0001779</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Top</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">424144002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>the length of time that a person has lived or a thing has existed.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#agrammatism -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#agrammatism">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_Broca"/>
        <synonym_1>agrammatic speech</synonym_1>
        <untitled-ontology-57:CUI>C0242186</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A type of aphasic disturbance in which patients speak in short sentences with substantive words preserved but functor words (prepositions, conjunctions, articles, adjectives) are often lost).  Speech has a telegraphic quality.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#akinesia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#akinesia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/bradykinesia"/>
        <Example_1>lack of movement</Example_1>
        <Example_2>poverty of movement</Example_2>
        <untitled-ontology-57:CUI>C0085623</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Inability to initiate changes in activity or movement and to perform ordinary volitional movements rapidly and easily</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#akinetic_rigidity_syndrome -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#akinetic_rigidity_syndrome">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/rigidity"/>
        <untitled-ontology-57:CUI>C1446219</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#alopecia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#alopecia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/skin_finding"/>
        <Example_1>hair loss</Example_1>
        <Example_2>baldness</Example_2>
        <synonym_1>alopecia</synonym_1>
        <untitled-ontology-57:CUI>C0002170</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Skin</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Hair loss, also known as alopecia or baldness, refers to a loss of hair from part of the head or body</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#anemia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#anemia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#hematologic_symptoms"/>
        <untitled-ontology-57:CUI>C0002871</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Anemia is a condition in which you lack enough healthy red blood cells to carry adequate oxygen to your body&apos;s tissues. Having anemia can make you feel tired and weak. There are many forms of anemia, each with its own cause. Anemia can be temporary or long term, and it can range from mild to severe.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#anhidrosis_symptom -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#anhidrosis_symptom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/anhidrosis"/>
        <untitled-ontology-57:CUI>C0003028</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#aphasia_logopenic -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#aphasia_logopenic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia"/>
        <untitled-ontology-57:CUI>C4274665</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>An aphasia with reduced word output, usually an expressive aphasia.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#aphonia -->

