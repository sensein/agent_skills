        <untitled-ontology-57:CUI>C0423319</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#atrophy_testes -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#atrophy_testes">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/endocrine_symptoms"/>
        <Example_1>reduced testicular volume</Example_1>
        <Example_2>testicular atrophy.</Example_2>
        <Example_3>Small testes.</Example_3>
        <untitled-ontology-57:CUI>C0156312</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17585008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Loss of testicular volume. (NCI)</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#autonomic_bladder_dysfunction -->

