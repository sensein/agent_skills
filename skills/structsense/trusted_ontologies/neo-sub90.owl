        <untitled-ontology-57:Exam_Part>Skin</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Redness of the skin produced by congestion of the capillaries.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#esotropia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#esotropia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/abnormal_vision"/>
        <untitled-ontology-57:CUI>C0014877</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A form of strabismus with one or both eyes turned inward (&apos;crossed&apos;) to a relatively severe degree, usually defined as 10 diopters or more. [HPO:probinson] (HPO)</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#exercise_induced_muscle_fatigue -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#exercise_induced_muscle_fatigue">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/muscle_fatigue"/>
        <Example_1>Muscle weakness induced by exercise.</Example_1>
        <Example_2>muscle fatigue due to exercise.</Example_2>
        <Example_3>Muscle fatigue due to use.</Example_3>
        <synonym_1>muscle fatigue related to exercise.</synonym_1>
        <untitled-ontology-57:CUI>C1855580</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>An abnormally increased tendency towards muscle fatigue induced by physical exercise.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#explosive_speech -->

