        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">397803000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Inability to develop or maintain an erection of the penis.</rdfs:isDefinedBy>
        <rdfs:seeAlso>impotence</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impulsive -->

