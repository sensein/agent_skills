        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/nystagmus"/>
        <untitled-ontology-57:CUI>C0271385</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">81756001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Nystagmus consisting of horizontal to-and-fro eye movements.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/nystagmus_on_lateral_gaze -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/nystagmus_on_lateral_gaze">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/nystagmus_horizontal"/>
        <untitled-ontology-57:CUI>C4013199</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Nystagmus that occurs on horizontal lateral gaze.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/nystagmus_pendular -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/nystagmus_pendular">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/nystagmus"/>
        <untitled-ontology-57:CUI>C0271388</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35743001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Rhythmic, involuntary sinusoidal oscillations of one or both eyes. The waveform of pendular nystagmus may occur in any direction.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/nystagmus_retraction -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/nystagmus_retraction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/nystagmus"/>
        <synonym_1>retraction nystagmus</synonym_1>
        <synonym_2>nystagmus retractorius</synonym_2>
        <untitled-ontology-57:CUI>C0520731</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9074007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Convergence‐retraction nystagmus is an irregular, jerky nystagmus in which both eyeballs rhythmically converge and retract into the orbit, particularly on attempting an upward gaze.1 In humans it is seen as part of Parinaud&apos;s syndrome, also known as dorsal midbrain syndrome, in which a lesion of dorsally located</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/nystagmus_rotatory -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/nystagmus_rotatory">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/nystagmus"/>
        <untitled-ontology-57:CUI>C0240595</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">95783006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A form of nystagmus in which the eyeball makes rotary motions around the axis.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/nystagmus_vertical -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/nystagmus_vertical">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/nystagmus"/>
        <untitled-ontology-57:CUI>C0271386</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">111533001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Vertical nystagmus may present with either up-beating or down-beating eye movements or both. When present in the straight-ahead position of gaze it is referred to as upbeat nystagmus or downbeat nystagmus.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/obscene_thoughts -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/obscene_thoughts">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/thought_process_finding"/>
        <untitled-ontology-57:CUI>C0424002</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">247651008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Sexual Intrusive Thoughts consist of unwanted sexual thoughts. This may include fears related to one’s sexual orientation or what others might think. It may also contain mental imagery of sexual behaviors that the individual finds immoral or abhorrent.  The person may fear committing a harmful sexual act or being sexually aggressive.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/obstructive_sleep_apnea -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/obstructive_sleep_apnea">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#sleep_disturbance"/>
        <Example_1>loud snoring during sleep</Example_1>
        <Example_2>apneic episodes during sleep.</Example_2>
        <untitled-ontology-57:CUI>C0520679</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">78275009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Obstructive sleep apnea (OSA) is a condition in which breathing stops involuntarily for brief periods of time during sleep. Normally, air flows smoothly from the mouth and nose into the lungs at all times. Periods when breathing stops are called apnea or apneic episodes.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/obtunded -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/obtunded">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_alertness"/>
        <synonym_1>obtunded</synonym_1>
        <synonym_2>stupor</synonym_2>
        <synonym_3>stuporous</synonym_3>
        <untitled-ontology-57:CUI>C0085628</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">89458003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A state of reduced sensibility and response to stimuli which is distinguished from coma in that the person can be aroused by vigorous and repeated stimulation. The person is still conscious and can make voluntary movements. Stupor is more severe than drowsiness and stuporous patients may not achieve full consciousness even with vigorous stimulation.</rdfs:isDefinedBy>
        <rdfs:seeAlso>obtundation; stuporous; obtunded</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ocular_apraxia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ocular_apraxia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/Balint_syndrome"/>
        <Example_1>Difficulty initiating saccadic eye movements.</Example_1>
        <Example_2>Difficulty initiating eye movements voluntarily.</Example_2>
        <untitled-ontology-57:CUI>C4693319</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">193662007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Oculomotor apraxia (OMA), is the absence or defect of controlled, voluntary, and purposeful eye movement. It was first described in 1952 by the American ophthalmologist David Glendenning Cogan. People with this condition have difficulty moving their eyes horizontally and moving them quickly. The main difficulty is in saccade initiation, but there is also impaired cancellation of the vestibulo-ocular reflex. Patients have to turn their head in order to compensate for the lack of eye movement initiation in order to follow an object or see objects in their peripheral vision, but they often exceed their target. There is controversy regarding whether OMA should be considered an apraxia, since apraxia is the inability to perform a learned or skilled motor action to command, and saccade initiation is neither a learned nor a skilled action.</rdfs:isDefinedBy>
        <rdfs:seeAlso>oculomotor_apraxia</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ocular_bobbing -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ocular_bobbing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_eye_movement"/>
        <untitled-ontology-57:CUI>C0234651</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">46794001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Ocular bobbing is a distinctive eye movement disorder seen in patients with pontine dysfunction. The typical phenomenon consists of abrupt, spontaneous downward jerks of the eyes with a slow return to the midposition in association with paralysis of spontaneous and reflex horizontal eye movements.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ocular_flutter -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/ocular_flutter">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_eye_movement"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0031931</HPO>
        <untitled-ontology-57:CUI>C0234650</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">33466002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>When these back to back saccades occur purely horizontally, they are known as “ocular flutter” and can be a stage of resolving opsoclonus.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/oculomasticatory_myorhythmia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/oculomasticatory_myorhythmia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/hyperkinesia"/>
        <untitled-ontology-57:CUI>C1321328</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">404685002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>unique pendular vergence oscillations of the eyes and concurrent contractions of the masticatory muscles, i.e., oculomasticatory myorhythmia (OMM).</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/olfactory_disorder -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/olfactory_disorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cranial_nerve_1_finding"/>
        <untitled-ontology-57:CUI>C0679441</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">362967002</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>disorder of smell and olfaction.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/opsoclonus -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/opsoclonus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/impaired_eye_movement"/>
        <untitled-ontology-57:CUI>C0242567</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">194177006</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Opsoclonus, also referred to as “saccadomania” or “dancing eyes”, is characterised by intermittent bursts of large amplitude high velocity multidirectional back to back saccades, and has also been reported in patients with viral encephalitis and metabolic encephalopathy, as well as in those with occult neuroblastoma and drug toxicity.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/optic_atrophy -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/optic_atrophy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/optic_disc_finding"/>
        <untitled-ontology-57:CUI>C0029124</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">76976005</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Atrophy of the optic nerve. Optic atrophy results from the death of the retinal ganglion cell axons that comprise the optic nerve and manifesting as a pale optic nerve on fundoscopy.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/optic_disc_finding -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/optic_disc_finding">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#visual_disturbance"/>
        <untitled-ontology-57:CUI>C0423451</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">247201009</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An abnomality of the optic nerve head.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/optic_nerve_pallor -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/optic_nerve_pallor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pallor_optic_disc"/>
        <untitled-ontology-57:CUI>C1608971</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Paleness of the optic nerve head.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/optic_neuritis -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/optic_neuritis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/optic_disc_finding"/>
        <untitled-ontology-57:CUI>C0029134</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">66760008</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Inflammation of the optic nerve. Commonly associated conditions include autoimmune disorders such as MULTIPLE SCLEROSIS, infections, and granulomatous diseases. Clinical features include retro-orbital pain that is aggravated by eye movement, loss of color vision, and contrast sensitivity that may progress to severe visual loss, an afferent pupillary defect (Marcus-Gunn pupil), and in some instances optic disc hyperemia and swelling. Inflammation may occur in the portion of the nerve within the globe (neuropapillitis or anterior optic neuritis) or the portion behind the globe (retrobulbar neuritis or posterior optic neuritis).</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/optokinetic_response_finding -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/optokinetic_response_finding">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/visual_field_defect"/>
        <Example_1>Absence of optokinetic nystagmus</Example_1>
        <synonym_1>Visually enhanced vestibulo-ocular reflex impairment</synonym_1>
        <synonym_2>absence of optokinetic response</synonym_2>
        <synonym_3>deficient optokinetic response</synonym_3>
        <untitled-ontology-57:CUI>C1287641</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>CN</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">366109004</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>The vestibulo-ocular reflex is responsible for the stabilization of the retinal image during movement. The visual vestibular ocular reflex (VVOR) or visual enhanced VOR, maintains ocular stability during head motion by generating compensatory eye movement opposite to head movement, and is a major component of visual vestibular interaction. This feature is an impairment of this reflex, manifested as the combined impairment of the three compensatory eye movement reflexes, namely the vestibulo-ocular reflex (VOR), smooth pursuit (SP) and optokinetic reflex (OKR).</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/oral_dyskinesia -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/oral_dyskinesia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/dyskinesia"/>
        <untitled-ontology-57:CUI>C0454606</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">229694001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Writhing and other hyperkinetic movements of the tongue and lips.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/orthostatic_hypotension -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/orthostatic_hypotension">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/cardiovascular_symptoms"/>
        <HPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0001278</HPO>
        <untitled-ontology-57:CUI>C0020651</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">28651003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>A fall in blood pressure associated with dizziness, syncope and blurred vision occurring upon standing or when standing motionless in a fixed position.</rdfs:isDefinedBy>
        <rdfs:seeAlso>postural hypotension</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/other_higher_cortical_functions -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/other_higher_cortical_functions">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/aphasia_apraxia_dyslexia_or_agnosia"/>
        <untitled-ontology-57:CUI>C2370893</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>MS</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">311465003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Other higher cortical functions other than aphasia, apraxia, agnosia, and alexia.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/symptom"/>
        <untitled-ontology-57:CUI>C0030193</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22253000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>physical suffering or discomfort caused by illness or injury.  unpleasant sensation induced by noxious stimuli and generally received by specialized nerve endings.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain_abdominal -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain_abdominal">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain"/>
        <untitled-ontology-57:CUI>C0000737</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">21522001</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) and perceived to originate in the abdomen</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain_arm -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain_arm">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain"/>
        <untitled-ontology-57:CUI>C0239377</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">102556003</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to the arm.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain_back -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain_back">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain"/>
        <untitled-ontology-57:CUI>C0004604</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Sensation of unpleasant feeling indicating potential or actual damage to some body structure felt in the back.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain_burning -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain_burning">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain"/>
        <untitled-ontology-57:CUI>C0234230</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>A sensation of intensely hot or searing discomfort.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain_buttock -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain_buttock">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain"/>
        <untitled-ontology-57:CUI>C0231710</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Buttock pain may indicate a problem in either of the sacroiliac joints, the lumbar spine (lower back), muscles of the pelvis or any of those other layers</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain_ear -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain_ear">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain"/>
        <synonym_1>aural pain.</synonym_1>
        <untitled-ontology-57:CUI>C0013456</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Painful sensation in the ear region.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain_electric_shock_sensations -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain_electric_shock_sensations">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57#pain_neuropathic"/>
        <untitled-ontology-57:CUI>C0549248</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Nerve pain often feels like a shooting, stabbing or burning sensation. Sometimes it can be as sharp and sudden as an electric shock. People with neuropathic pain are often very sensitive to touch or cold and can experience pain as a result of stimuli that would not normally be painful, such as brushing the skin</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain_eye -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain_eye">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain"/>
        <synonym_1>ocular pain.</synonym_1>
        <untitled-ontology-57:CUI>C0151827</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">41652007</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Pain in the eye. Ocular pain.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain_face -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain_face">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain"/>
        <untitled-ontology-57:CUI>C0015468</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>Pain in the face.</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain_foot -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain_foot">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain"/>
        <untitled-ontology-57:CUI>C0016512</untitled-ontology-57:CUI>
        <untitled-ontology-57:Exam_Part>SX</untitled-ontology-57:Exam_Part>
        <rdfs:isDefinedBy>An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to the foot. (HPO). A sensation of discomfort emanating from the foot, its supporting structures, or its articulation with the ankle. (NCI)</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain_hands -->

    <owl:Class rdf:about="http://www.semanticweb.org/danielhier/ontologies/2019/3/untitled-ontology-57/pain_hands">
