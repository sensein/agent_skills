        <untitled-ontology-57:Exam_Part>Motor</untitled-ontology-57:Exam_Part>
        <untitled-ontology-57:SNOMED rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">278287000</untitled-ontology-57:SNOMED>
        <rdfs:isDefinedBy>Weakness of left arm and leg</rdfs:isDefinedBy>
    </owl:Class>
    


