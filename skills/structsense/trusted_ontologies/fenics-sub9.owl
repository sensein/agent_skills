    <!-- http://webprotege.stanford.edu/R3Kr2TGkTE2Cs3wLLgOUHN -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R3Kr2TGkTE2Cs3wLLgOUHN">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R9sk2fOWBMQbWVog5qqITs7"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mild-moderate depolarizing shift of voltage dependence of fast inactivation is a depolarizing shift of voltage dependence of fast inactivation (right shift) of a voltage-gated ion channel in which the value of V1/2 is significantly increased by up to 15mV.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0061</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gain-of-function</rdfs:comment>
        <rdfs:label xml:lang="en-us">Mild-moderate depolarizing shift of voltage dependence of fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R5vvSMCBavnR4OPfmY6bjk -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R5vvSMCBavnR4OPfmY6bjk">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RwQyQ1jQlK4mhCi3frcbsW"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An effect on ion selectivity is a biophysical change in which the specificity of the mutant channel for a single ion type is different from wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0079</rdfs:ID>
        <rdfs:label xml:lang="en-us">Effect on ion selectivity</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R6Gg6Rc5Xl21OllEzn2N3h -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R6Gg6Rc5Xl21OllEzn2N3h">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBWAIKiQem63yDopljeSmcj"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCxkRIG6UqWPWVsBL3fvLdo"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A depolarizing shift of voltage dependence of slow inactivation (right shift) is an effect on shift of voltage dependence of slow inactivation (V1/2) of a voltage-gated ion channel leading to gain of function, in which channels change to the slow inactivated state at significantly more positive potentials.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0116</rdfs:ID>
        <rdfs:label xml:lang="en-us">Depolarizing shift of voltage dependence of slow inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R6mSCTdmZqoFcoMx49ADHU -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R6mSCTdmZqoFcoMx49ADHU">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R7YvyEoR5sDyyQqL5j9dQoK"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCkkho6vZp3kuq92L9UxQ7x"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normal persistent current is the absence of an effect on persistent current of a voltage-gated sodium channel, in which no significant difference in persistent current is observed compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0044</rdfs:ID>
        <rdfs:label xml:lang="en-us">Normal persistent current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R72fldK4dv27Jf7NqXalgS5 -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R72fldK4dv27Jf7NqXalgS5">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RD13eaB3fwGp3eE77vJf9J7"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A moderate increase in peak current is an increase in peak current of a voltage-gated ion channel in which the peak current density of the mutant is significantly increased to 130-200% of that of the wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0094</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCN1A, SCN8A, and SCN2A: 1.3-2 fold increase</rdfs:comment>
        <rdfs:label xml:lang="en-us">Moderate increase in peak current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R768x3xvHhzBT7WwmpcMUaP -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R768x3xvHhzBT7WwmpcMUaP">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCvk5iSgbniWz9P4mjJsdlC"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Overall mixed or unclear functional effect due to neuronal network properties is an overall mixed function in which the conflicting effects to the mutant channel&apos;s function is observed on systems of multiple neurons.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0146</rdfs:ID>
        <rdfs:label xml:lang="en-us">Overall mixed or unclear functional effect due to neuronal network properties</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R77VgsjEzz65xAcEUzaZXUt -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R77VgsjEzz65xAcEUzaZXUt">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBJiFsljKf9Ot340DhQvUT"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ramp current, also called ramp current amplitude, is the total amount of current (area under the curve) measured during a steady depolarization over time. An effect on ramp current is a compound biophysical effect in which the ramp current is different in the mutant protein compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0128</rdfs:ID>
        <rdfs:label xml:lang="en-us">Effect on ramp current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R787B5RAMG9oetmadppgGCh -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R787B5RAMG9oetmadppgGCh">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R989oVaOLlRTh0b3roVWMYa"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDI44zpLiKB8U9OBgFIDIop"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A decrease in slope of fast inactivation is an effect on slope of fast inactivation (k) of a voltage-gated ion channel leading to loss of function, in which there is significantly greater steepness of channel inactivation with respect to membrane potential.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0072</rdfs:ID>
        <rdfs:label xml:lang="en-us">Decrease in slope of fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R7J2tm52qaQH1SwgcywsIqQ -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R7J2tm52qaQH1SwgcywsIqQ">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDnQOos7Y952sZBt7bCl2A"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Overall normal function with respect of biophysical channel activity is an overall normal function in which the normal function of the mutant channel is concluded from the cumulative effect of the biophysical alterations to the channel.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0152</rdfs:ID>
        <rdfs:label xml:lang="en-us">Overall normal function with respect of biophysical channel activity</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R7KOr8G1xCnwPzwaON10MTm -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R7KOr8G1xCnwPzwaON10MTm">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R8oN6Lr9gpAWFhWBexO3rhu"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R989oVaOLlRTh0b3roVWMYa"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A hyperpolarizing shift of voltage dependence of fast inactivation (right shift) is an effect on shift of voltage dependence of fast inactivation (V1/2) of a voltage-gated ion channel leading to loss of function, in which channels change to the inactivated state at significantly more negative potentials.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0065</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LOSS-OF-FUNCTION</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">left shift of fast inactivation means that the channels takes &quot;longer&quot; to have 50% of channels available again for activation. Longer is difficult and means &quot;at more negative membrane potentials&quot;</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">loss-of-function</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mild: up to 7.5 mV shift, moderate 7.5-15 mV shift, severe &gt;15 mV shift</rdfs:comment>
        <rdfs:label xml:lang="en-us">Hyperpolarizing shift of voltage dependence of fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R7Q10ohyxQHPdcQsFmhC1Si -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R7Q10ohyxQHPdcQsFmhC1Si">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDrJoygIdb3JDax6AmGciVY"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The overall assessment of ion channel function refers to the experimenters&apos; conclusion regarding the sum total effect of individual parameters on the function of the ion channel.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0136</rdfs:ID>
        <rdfs:label xml:lang="en-us">Overall assessment of ion channel function</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R7WY7lrtkRqG9NQvD8Fs7Lo -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R7WY7lrtkRqG9NQvD8Fs7Lo">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R9YmpNJrUqHfe8VU8jjemmJ"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A severe decrease in peak current due to reduction in conductance is a severe decrease in peak current of a voltage-gated ion channel which is explained by a significantly reduced single-channel conductance in mutants compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0091</rdfs:ID>
        <rdfs:label xml:lang="en-us">Severe decrease in peak current due to reduction in conductance</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R7YvyEoR5sDyyQqL5j9dQoK -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R7YvyEoR5sDyyQqL5j9dQoK">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RC6e65svL8GnahTMiaHjRON"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Persistent current, also called noninactivating current, is the proportion of peak current in voltage-gated sodium channels that remains after the channel changes to the inactivated state. An effect on persistent current (INaP) is an effect on voltage-gated sodium channels in which the amount of persistent current is different in the mutant protein compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0038</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">INaP for sodium channels</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Important only in Na+ channels, not K+ channels</rdfs:comment>
        <rdfs:label xml:lang="en-us">Effect on persistent current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R7dNr0622a5wBESQGcaLkZg -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R7dNr0622a5wBESQGcaLkZg">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDrJoygIdb3JDax6AmGciVY"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Assessment of single biophysical property on ion channel function is the implied change that an effect on a particular parameter has on the overall behavior of the channel.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0002</rdfs:ID>
        <rdfs:label xml:lang="en-us">Assessment of single biophysical property on ion channel function</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R7eGXoO3n3Sj7LwciFM7iUY -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R7eGXoO3n3Sj7LwciFM7iUY">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBWAIKiQem63yDopljeSmcj"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/Rsw2n4guhiNupAT5yaAXtb"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An increase of subthreshold current is an effect on subthreshold current of a voltage-gated ion channel leading to gain-of-function, in which ion flow at membrane potentials below threshold is significantly increased compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0125</rdfs:ID>
        <rdfs:label xml:lang="en-us">Increase of subthreshold current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R7jOR4IAP4IwniBv4AwBnrm -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R7jOR4IAP4IwniBv4AwBnrm">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RwQyQ1jQlK4mhCi3frcbsW"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An effect on peak current is a biophysical change in which the maximum current density (pA/pF) is different in the mutant protein compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0082</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a</rdfs:comment>
        <rdfs:label xml:lang="en-us">Effect on peak current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R7rZoUywSrlnsR2QEdxddqS -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R7rZoUywSrlnsR2QEdxddqS">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBBfmTmxXmWBRBGEeKe7r0O"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCkkho6vZp3kuq92L9UxQ7x"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normal rate of recovery from fast inactivation is an absence of an effect on rate of recovery from fast inactivation of a voltage-gated ion channel, in which no significant difference in time constant (tau) is observed compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0054</rdfs:ID>
        <rdfs:label xml:lang="en-us">Normal rate of recovery from fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R7xYGfLUETEAY1cGj6zqYjl -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R7xYGfLUETEAY1cGj6zqYjl">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDI44zpLiKB8U9OBgFIDIop"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normal slope of fast inactivation is an absence of an effect on slope of fast inactivation (k) of a voltage-gated ion channel in which there is no significant difference observed in slope factor compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0074</rdfs:ID>
        <rdfs:label xml:lang="en-us">Normal slope of fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R7z6iE87cbBZePvVnmAKuLf -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R7z6iE87cbBZePvVnmAKuLf">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R86071iVxOmUgj1ljXI9RwA"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Overall loss-of-function effect with respect to biophysical channel activity is an overall loss-of-function in which the reduction to the mutant channel&apos;s function is concluded from the cumulative effect the of biophysical alterations to the channel.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0144</rdfs:ID>
        <rdfs:label xml:lang="en-us">Overall loss-of-function effect with respect to biophysical channel activity</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R7zJvOsCc8GUzB5y46iKkAM -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R7zJvOsCc8GUzB5y46iKkAM">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBWAIKiQem63yDopljeSmcj"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RwcubAXCIcP10yoVjk9JVf"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An acceleration of recovery from slow inactivation is an effect on recovery from slow inactivation of a voltage-gated ion channel leading to gain-of-function, in which the time constant (tau) is significantly reduced, corresponding to channels recovering faster compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0107</rdfs:ID>
        <rdfs:label xml:lang="en-us">Acceleration of recovery from slow inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R7zP9gQPx3KzITlYDUOFZfp -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R7zP9gQPx3KzITlYDUOFZfp">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCkkho6vZp3kuq92L9UxQ7x"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCxkRIG6UqWPWVsBL3fvLdo"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normal voltage dependence of slow inactivation is an absence of an effect on shift of voltage dependence of slow inactivation of a voltage-gated ion channel in which no significant difference in V1/2 is observed compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0118</rdfs:ID>
        <rdfs:label xml:lang="en-us">Normal voltage dependence of slow inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R80ryKpw9TZE2fSjbz1ykJ4 -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R80ryKpw9TZE2fSjbz1ykJ4">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RPGjvHXaR7w0A4dKjNGhVc"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mild slowing of fast inactivation (tau inactivation) is a slowing of fast inactivation of a voltage-gated ion channel in which the mutant has a time constant significantly increased by a factor of up to 2 compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0049</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mild (up to 2 fold)</rdfs:comment>
        <rdfs:label xml:lang="en-us">Mild slowing of fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R81aXvSVSyOYsrO0hq6JLkY -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R81aXvSVSyOYsrO0hq6JLkY">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R8tC7DUKEOwvWvpkJDURZZk"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBWAIKiQem63yDopljeSmcj"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A slowing of slow inactivation is an effect on rate of slow inactivation (tau inactivation) of a voltage-gated ion channel leading to gain-of-function, in which the time constant is significantly increased, corresponding to channels changing to the slow inactivated state slower compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0113</rdfs:ID>
        <rdfs:label xml:lang="en-us">Slowing of slow inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R82G1vBnkSQhiYsTT3hCskW -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R82G1vBnkSQhiYsTT3hCskW">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R989oVaOLlRTh0b3roVWMYa"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDFDJF4kvghH94F1afcua4w"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An increase in slope of activation is an effect on slope of activation (k) of a voltage-gated ion channel leading to loss of function, in which there is significantly reduced steepness of channel activation with respect to membrane potential.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0035</rdfs:ID>
        <rdfs:label xml:lang="en-us">Increase in slope of activation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R86071iVxOmUgj1ljXI9RwA -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R86071iVxOmUgj1ljXI9RwA">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R7Q10ohyxQHPdcQsFmhC1Si"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An overall loss-of-function is an overall assessment of ion channel function in which the experimenters conclude that the activity of the mutant channel is reduced relative to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0141</rdfs:ID>
        <rdfs:label xml:lang="en-us">Overall loss-of-function</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R89pOjwORB6pkvDW9u6hoXN -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R89pOjwORB6pkvDW9u6hoXN">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDnQOos7Y952sZBt7bCl2A"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Overall normal function due to neuronal network properties is an overall normal function in which the normal function of the mutant channel is observed on systems of multiple neurons.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0150</rdfs:ID>
        <rdfs:label xml:lang="en-us">Overall normal function due to neuronal network properties</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R8CM4SZ0Of9GemoYjDN3wjj -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R8CM4SZ0Of9GemoYjDN3wjj">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R9wEM2OxcV4ZL1GcpqWaE52"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Overall gain-of-function effect due to single-cell neuronal properties is an overall gain-of-function in which the enhancement to the mutant channel&apos;s function is observed at the level of single neuron, e.g. due to firing rates.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0139</rdfs:ID>
        <rdfs:label xml:lang="en-us">Overall gain-of-function effect due to single-cell neuronal properties</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R8IERLt4CJaeXzaPCOzquSB -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R8IERLt4CJaeXzaPCOzquSB">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R9YmpNJrUqHfe8VU8jjemmJ"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A severe decrease in peak current due to reduced opening probability is a severe decrease in peak current of a voltage-gated ion channel which is explained by a significantly reduced fraction of open mutant channels compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0088</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is rarely measured</rdfs:comment>
        <rdfs:label xml:lang="en-us">Severe decrease in peak current due to reduced opening probability</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R8KPCoFR36aEEBnmaUBp1tV -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R8KPCoFR36aEEBnmaUBp1tV">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBWAIKiQem63yDopljeSmcj"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDI44zpLiKB8U9OBgFIDIop"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An increase in slope of fast inactivation is an effect on slope of fast inactivation (k) of a voltage-gated ion channel leading to gain of function, in which there is significantly reduced steepness of channel inactivation with respect to membrane potential.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0073</rdfs:ID>
        <rdfs:label xml:lang="en-us">Increase in slope of fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R8KZofOQE10FYr0M6IpoJ72 -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R8KZofOQE10FYr0M6IpoJ72">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R86071iVxOmUgj1ljXI9RwA"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Overall loss-of-function effect due to single-cell neuronal properties is an overall loss-of-function in which the reduction to the mutant channel&apos;s function is observed at the level of single neuron, e.g. due to firing rates.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0143</rdfs:ID>
        <rdfs:label xml:lang="en-us">Overall loss-of-function effect due to single-cell neuronal properties</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R8KqfFzWrSaU9t4uXABtJRK -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R8KqfFzWrSaU9t4uXABtJRK">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RwQyQ1jQlK4mhCi3frcbsW"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Resurgent current is current conducted due to voltage-gated ion channels reopening in response to negative voltage changes after a normal transient current. An effect on resurgent current is a biophysical change in which there is a difference in the resurgent current between the mutant protein and wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0097</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">For sodium channel, ‘Resurgent sodium currents’ mechanism is unclear, but present in some cells</rdfs:comment>
        <rdfs:label xml:lang="en-us">Effect on resurgent current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R8Kyj6yec26dDePPO9tgqV2 -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R8Kyj6yec26dDePPO9tgqV2">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RwQyQ1jQlK4mhCi3frcbsW"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An effect on ion channel modulation is a biophysical change in which the mutant channel&apos;s response to modulators, such as channel blockers or openers, is significantly different compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0078</rdfs:ID>
        <rdfs:label xml:lang="en-us">Effect on ion channel modulation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R8LYDXXexzlysXjoPyjBePm -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R8LYDXXexzlysXjoPyjBePm">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/Rl7K1Hgqs34BVxM4PNtn4w"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A moderate hyperpolarizing shift of voltage dependence of activation is a hyperpolarizing shift of voltage dependence of activation (left shift) of a voltage-gated ion channel in which the value of V1/2 is significantly decreased by 5-10mV for Na+ channels or 10-20mV for K+ channels.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0030</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gain-of-function</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCN2A and SCN8A moderate: 5-10 mV shift</rdfs:comment>
        <rdfs:label xml:lang="en-us">Moderate hyperpolarizing shift of voltage dependence of activation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R8S5yVPOmxVdhhUOuyW4oyx -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R8S5yVPOmxVdhhUOuyW4oyx">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RD13eaB3fwGp3eE77vJf9J7"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A severe increase in peak current is an increase in peak current of a voltage-gated ion channel in which the peak current density of the mutant is significantly increased to more than 200% of that of the wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0095</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCN1A, SCN8A, and SCN2A: 2 or more fold increase</rdfs:comment>
        <rdfs:label xml:lang="en-us">Severe increase in peak current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R8asTBmmgK6PYqOlvlLtgpz -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R8asTBmmgK6PYqOlvlLtgpz">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/Rl7K1Hgqs34BVxM4PNtn4w"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mild hyperpolarizing shift of voltage dependence of activation is a hyperpolarizing shift of voltage dependence of activation (left shift) of a voltage-gated ion channel in which the value of V1/2 is significantly decreased by up to 5mV for Na+ channels or 10mV for K+ channels.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0029</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gain-of-function</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCN2A and SCN8A mild: up to 5 mV; K+ channels mild: up to 10mV</rdfs:comment>
        <rdfs:label xml:lang="en-us">Mild hyperpolarizing shift of voltage dependence of activation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R8boLFt6478JfJZLRmWETDi -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R8boLFt6478JfJZLRmWETDi">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R3Kr2TGkTE2Cs3wLLgOUHN"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A moderate depolarizing shift of voltage dependence of fast inactivation is a depolarizing shift of voltage dependence of fast inactivation (right shift) of a voltage-gated ion channel in which the value of V1/2 is significantly increased by 7.5-15mV.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0063</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">7.5 - 15 mV shift</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gain-of-function</rdfs:comment>
        <rdfs:label xml:lang="en-us">Moderate depolarizing shift of voltage dependence of fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R8elYee9oFnTyzGLbmLUaeO -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R8elYee9oFnTyzGLbmLUaeO">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RwQyQ1jQlK4mhCi3frcbsW"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gating-pore current is an alternative, abnormal pathway of ion flow created through the voltage-sensor domain (“omega current”) resulting in abnormal depolarization due to additional cation flow independent of the voltage-gated pore pathway. An effect on gating-pore current is a biophysical change in which gating-pore current is different in the mutant protein compared to wildtype (in which it is absent).</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0075</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">S4 segment mutations result in gating-pore current independent of the ion channel conductance. Cation flow results in abnormal depolarization. Completely normal pathway of letting ions through.</rdfs:comment>
        <rdfs:label xml:lang="en-us">Effect on gating-pore current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R8fyxz5nx0mgxsMOtEoRmWk -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R8fyxz5nx0mgxsMOtEoRmWk">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R8hFpMkdFDIganHQtA3nbJV"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R989oVaOLlRTh0b3roVWMYa"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A slowing of activation is an effect on rate of activation (tau activation) of a voltage-gated ion channel leading to loss-of-function, in which the time constant is increased, corresponding to channels changing to the activated state significantly slower compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0012</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">measured in ratio. mutant/wildtype</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mild: up to 1.25 mild to moderate: 1.25-2.0 severe: &gt; 2.00</rdfs:comment>
        <rdfs:label xml:lang="en-us">Slowing of activation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R8hFpMkdFDIganHQtA3nbJV -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R8hFpMkdFDIganHQtA3nbJV">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RByPM9kRtVogJhkqUM3lsh4"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An effect on rate of activation (tau activation) is an effect on activation of a voltage-gated ion channel in which the affected parameter is the time constant (tau) of activation, which measures how quickly or slowly the channel changes to the activated state with respect to time.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0009</rdfs:ID>
        <rdfs:label xml:lang="en-us">Effect on rate of activation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R8iqSYdEKz3pshaN6jwoBjg -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R8iqSYdEKz3pshaN6jwoBjg">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RXhKs55YyYQdgiLKwckPRg"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mild-moderate slowing of recovery from fast inactivation is a slowing of recovery from fast inactivation of a voltage-gated ion channel, in which the time constant (tau) is significantly increased by a factor of up to 3 compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0056</rdfs:ID>
        <rdfs:label xml:lang="en-us">Mild-moderate slowing of recovery from fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R8oN6Lr9gpAWFhWBexO3rhu -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R8oN6Lr9gpAWFhWBexO3rhu">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R9SbYpUEIgenr1NAQGsVJLA"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An effect on shift of voltage dependence of fast inactivation (V1/2) is an effect on voltage dependence of fast inactivation of a voltage-gated ion channel in which the affected parameter is half-maximal voltage (V1/2), the potential at which 50% of channels are in the inactivated state.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0059</rdfs:ID>
        <rdfs:label xml:lang="en-us">Effect on shift of voltage dependence of fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R8tC7DUKEOwvWvpkJDURZZk -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R8tC7DUKEOwvWvpkJDURZZk">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RobShQwofhZsmj29NgnSGj"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An effect on rate of slow inactivation (tau inactivation) is an effect on slow inactivation of a voltage-gated ion channel in which the affected parameter is the time constant (tau) of slow inactivation, which measures how quickly or slowly the channel changes to the slow inactivated state with respect to time.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0110</rdfs:ID>
        <rdfs:label xml:lang="en-us">Effect on rate of slow inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R8tp5Ovyd4qcM5Kfw7lDZCs -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R8tp5Ovyd4qcM5Kfw7lDZCs">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCQHSBGZT4JxStSfikvi8js"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCkkho6vZp3kuq92L9UxQ7x"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normal entry into slow inactivation is an absence of an effect on slow inactivation in which no significant difference in time of onset of slow inactivation is observed compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0104</rdfs:ID>
        <rdfs:label xml:lang="en-us">Normal entry into slow inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R918FRlaBUyZMXc8koNdkxQ -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R918FRlaBUyZMXc8koNdkxQ">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R99KATlEV5UUOxmTthHewYy"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBWAIKiQem63yDopljeSmcj"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hyperpolarizing shift of voltage dependence of activation - A hyperpolarizing shift of voltage dependence of activation (left shift) is an effect on shift of voltage dependence of activation (V1/2) of a voltage-gated ion channel leading to gain of function, in which channels open or change to the activated state at significantly more negative potentials.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0027</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GAIN-OF-FUNCTION</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCN2A and SCN8A mild: up to 5 mV; K+ channels mild: up to 10mV</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCN2A and SCN8A moderate: 5-10 mV shift</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCN2A and SCN8A severe: &gt;10 mV; K+ channels severe: &gt;20mV</rdfs:comment>
        <rdfs:label xml:lang="en-us">Hyperpolarizing shift of voltage dependence of activation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R989oVaOLlRTh0b3roVWMYa -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R989oVaOLlRTh0b3roVWMYa">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R7dNr0622a5wBESQGcaLkZg"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A component leading to gain-of-function is an alteration that contributes to overall reduced mutant function compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0004</rdfs:ID>
        <rdfs:label xml:lang="en-us">Component leading to Loss-of-Function (LoF)</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R99KATlEV5UUOxmTthHewYy -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R99KATlEV5UUOxmTthHewYy">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDyQ9lJFRvp1SJ8SKR7BkGn"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An effect on shift of voltage dependence of activation (V1/2) is an effect on voltage dependence of activation of a voltage-gated ion channel in which the affected parameter is half-maximal voltage (V1/2), the potential at which 50% of channels are in the open state.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0021</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Voltage which half of channels have activated</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Effect on shift of voltage dependence of activation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R9GXFE2OawwbLewohMEJYng -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R9GXFE2OawwbLewohMEJYng">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R8elYee9oFnTyzGLbmLUaeO"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBWAIKiQem63yDopljeSmcj"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The presence of abnormal gating pore current denotes abnormal ion channel function wherein ion flow through the voltage-sensing domain is detected.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0077</rdfs:ID>
        <rdfs:label xml:lang="en-us">Presence of abnormal gating pore current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R9HYQpAlzBNEVxccrGnZUKO -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R9HYQpAlzBNEVxccrGnZUKO">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCkkho6vZp3kuq92L9UxQ7x"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RwcubAXCIcP10yoVjk9JVf"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normal recovery from slow inactivation is an absence of an effect on recovery from slow inactivation, in which no significant difference in time constant (tau) of recovery is observed compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0108</rdfs:ID>
        <rdfs:label xml:lang="en-us">Normal recovery from slow inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R9NOUr9iWj3sPK7GlxuC6dy -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R9NOUr9iWj3sPK7GlxuC6dy">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RD13eaB3fwGp3eE77vJf9J7"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mild increase in peak current is an increase in peak current of a voltage-gated ion channel in which the peak current density of the mutant is significantly increased to up to, but less than, 130% of that of the wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0093</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCN1A, SCN8A, and SCN2A: up to 1.3 fold increase</rdfs:comment>
        <rdfs:label xml:lang="en-us">Mild increase in peak current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R9SJwUDkFAFc4AoKk8KpfDC -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R9SJwUDkFAFc4AoKk8KpfDC">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R7jOR4IAP4IwniBv4AwBnrm"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R86071iVxOmUgj1ljXI9RwA"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R989oVaOLlRTh0b3roVWMYa"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Absence of peak current may be referred to as &quot;no whole cell current&quot; and denotes a lack of detectable current through a voltage-gated ion channel, i.e. a peak current of 0, or complete loss-of-function.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0083</rdfs:ID>
        <rdfs:label xml:lang="en-us">Absence of peak current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R9SbYpUEIgenr1NAQGsVJLA -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R9SbYpUEIgenr1NAQGsVJLA">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RC6e65svL8GnahTMiaHjRON"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An effect on voltage dependence of fast inactivation is an effect on fast inactivation of a voltage-gated ion channel in which the affected parameter is the proportion of channels that are in inactivated states after being held at different membrane potentials/voltages.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0058</rdfs:ID>
        <rdfs:label xml:lang="en-us">Effect on voltage dependence of fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R9Up0isZLT8RDpuQWBovMas -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R9Up0isZLT8RDpuQWBovMas">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBRr02cNOD5wl0pS44hXqqX"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A moderate hyperpolarizing shift of voltage dependence of fast inactivation is a hyperpolarizing shift of voltage dependence of fast inactivation (left shift) of a voltage-gated ion channel in which the value of V1/2 is significantly reduced by 7.5-15mV.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0068</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">7.5-15 mV shift</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">loss-of-function</rdfs:comment>
        <rdfs:label xml:lang="en-us">Moderate hyperpolarizing shift of voltage dependence of fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R9YmpNJrUqHfe8VU8jjemmJ -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R9YmpNJrUqHfe8VU8jjemmJ">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBijWyJfrgnn2shZrQFKwyM"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A severe decrease in peak current is a decrease in peak current of a voltage-gated ion channel in which the peak current density of the mutant is significantly reduced to less than 20% of that of the wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0087</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Severe decrease in peak current, less than 20% of wildtype</rdfs:comment>
        <rdfs:label xml:lang="en-us">Severe decrease in peak current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R9Z6wISzLzKf2jr6s67a677 -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R9Z6wISzLzKf2jr6s67a677">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RPGjvHXaR7w0A4dKjNGhVc"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A moderate slowing of fast inactivation (tau inactivation) is a slowing of fast inactivation of a voltage-gated ion channel in which the mutant has a time constant significantly increased by a factor of 2-4 compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0050</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Moderate (2-4 fold)</rdfs:comment>
        <rdfs:label xml:lang="en-us">Moderate slowing of fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R9ZPhGuiK6bJRYHFi2PqXZJ -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R9ZPhGuiK6bJRYHFi2PqXZJ">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R8hFpMkdFDIganHQtA3nbJV"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCkkho6vZp3kuq92L9UxQ7x"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normal rate of activation is an absence of an effect on rate of activation (tau activation) of a voltage-gated ion channel in which no significant difference in time constant is observed compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0011</rdfs:ID>
        <rdfs:label xml:lang="en-us">Normal rate of activation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R9ZUbOgKjGPPQ9CPTMGPh9f -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R9ZUbOgKjGPPQ9CPTMGPh9f">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RXhKs55YyYQdgiLKwckPRg"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A severe slowing of recovery from fast inactivation is a slowing of recovery from fast inactivation of a voltage-gated ion channel in which the time constant (tau) is significantly increased by a factor of more than 3 compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0057</rdfs:ID>
        <rdfs:label xml:lang="en-us">Severe slowing of recovery from fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R9n9tt9GXmhInThrpajHuKY -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R9n9tt9GXmhInThrpajHuKY">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R77VgsjEzz65xAcEUzaZXUt"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCkkho6vZp3kuq92L9UxQ7x"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normal ramp current is an absence of an effect on ramp current, in which no significant difference is observed compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0131</rdfs:ID>
        <rdfs:label xml:lang="en-us">Normal ramp current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R9sk2fOWBMQbWVog5qqITs7 -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R9sk2fOWBMQbWVog5qqITs7">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R8oN6Lr9gpAWFhWBexO3rhu"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBWAIKiQem63yDopljeSmcj"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A depolarizing shift of voltage dependence of fast inactivation (right shift) is an effect on shift of voltage dependence of fast inactivation (V1/2) of a voltage-gated ion channel leading to gain of function, in which channels change to the inactivated state at significantly more positive potentials.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0060</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GAIN-OF-FUNCTION</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gain-of-function</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mild up to 7.5 mV shift, moderate 7.5-15 mV shift, severe &gt; 15 mV shift</rdfs:comment>
        <rdfs:label xml:lang="en-us">Depolarizing shift of voltage dependence of fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R9vNK7NGPSBEp5FQ7nMB7Z2 -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R9vNK7NGPSBEp5FQ7nMB7Z2">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R989oVaOLlRTh0b3roVWMYa"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/Rsw2n4guhiNupAT5yaAXtb"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A decrease of subthreshold current is an effect on subthreshold current of a voltage-gated ion channel leading to loss-of-function, in which ion flow at membrane potentials below threshold is significantly reduced compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0124</rdfs:ID>
        <rdfs:label xml:lang="en-us">Decrease of subthreshold current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R9wEM2OxcV4ZL1GcpqWaE52 -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R9wEM2OxcV4ZL1GcpqWaE52">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R7Q10ohyxQHPdcQsFmhC1Si"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An overall gain-of-function is an overall assessment of ion channel function in which the experimenters conclude that the activity of the mutant channel is enhanced relative to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0137</rdfs:ID>
        <rdfs:label xml:lang="en-us">Overall gain-of-function</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R9wmRpum1ZjBHKOc0cthMrv -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R9wmRpum1ZjBHKOc0cthMrv">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R989oVaOLlRTh0b3roVWMYa"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R99KATlEV5UUOxmTthHewYy"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A depolarizing shift of voltage dependence of activation (right shift) is an effect on shift of voltage dependence of activation (V1/2) of a voltage-gated ion channel leading to loss of function, in which channels open or change to the activated state at significantly more positive potentials.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0022</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LOSS-OF-FUNCTION</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCN2A and SCN8A mild: up to 5 mV; K+ channels mild: up to 10mV</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCN2A and SCN8A moderate: 5-10 mV shift</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCN2A and SCN8A severe: &gt;10 mV, K+ channels severe: &gt;20mV</rdfs:comment>
        <rdfs:label xml:lang="en-us">Depolarizing shift of voltage dependence of activation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RB39ECWMLncqVLZXtTVSuW3 -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RB39ECWMLncqVLZXtTVSuW3">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDXWDoljWFzQfFl2YI7DCtA"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An effect on slope of slow inactivation (k) is an effect on voltage dependence of slow inactivation of a voltage-gated ion channel in which the affected parameter is slope factor (k), which indicates the steepness of voltage dependence of inactivation when plotted with respect to voltage after fitting to a Boltzmann function.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0119</rdfs:ID>
        <rdfs:label xml:lang="en-us">Effect on slope of slow inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RBBfmTmxXmWBRBGEeKe7r0O -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RBBfmTmxXmWBRBGEeKe7r0O">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RC6e65svL8GnahTMiaHjRON"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An effect on rate of recovery from fast inactivation is an effect on fast inactivation of a voltage-gated ion channel in which the affected parameter is the time constant (tau) of recovery from fast inactivation, which measures how quickly or slowly the channel becomes available for activation after return to hyperpolarizing potentials to allow recovery from inactivation, i.e. the channel’s inactivation gate reopens.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0052</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Recovery from fast inactivation is usually after a conditioning step of &lt;1 second. Recovery is fit by one or more exponentials with amplitudes
Unlike slow inactivation, channels are recovered usually within 1s, with may recovered within 10 ms</rdfs:comment>
        <rdfs:label xml:lang="en-us">Effect on rate of recovery from fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RBH2UZNWWHmsOgLS1XKdf8N -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RBH2UZNWWHmsOgLS1XKdf8N">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R8KqfFzWrSaU9t4uXABtJRK"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCkkho6vZp3kuq92L9UxQ7x"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normal resurgent current is the absence of an effect on resurgent current of a voltage-gated ion channel, in which no significant difference is observed compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0100</rdfs:ID>
        <rdfs:label xml:lang="en-us">Normal resurgent current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RBIy27OxlnSdZXc0c2teiZD -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RBIy27OxlnSdZXc0c2teiZD">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R7jOR4IAP4IwniBv4AwBnrm"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCkkho6vZp3kuq92L9UxQ7x"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normal peak current is an absence of an effect on peak current in which no significant difference in peak current density is observed compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0096</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wide range of normal</rdfs:comment>
        <rdfs:label xml:lang="en-us">Normal peak current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RBJ0Krtjy03lvhvCmwvnsjZ -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RBJ0Krtjy03lvhvCmwvnsjZ">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R8hFpMkdFDIganHQtA3nbJV"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBWAIKiQem63yDopljeSmcj"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An acceleration of activation is an effect on rate of activation (tau activation) of a voltage-gated ion channel leading to gain-of-function, in which the time constant is reduced, corresponding to channels changing to the activated state significantly faster compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0010</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">likely not meaningful as hightest increase would be 1.2 fold</rdfs:comment>
        <rdfs:label xml:lang="en-us">Acceleration of activation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RBJiFsljKf9Ot340DhQvUT -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RBJiFsljKf9Ot340DhQvUT">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDrJoygIdb3JDax6AmGciVY"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An effect on ion channel function involving multiple biophysical properties is an effect on a single measured value which results from distinct biophysical effects but is not readily decomposed into independent parameters.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0127</rdfs:ID>
        <rdfs:label xml:lang="en-us">Effect on ion channel function involving multiple biophysical properties</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RBKM326sr6YtbqsamE9pEtf -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RBKM326sr6YtbqsamE9pEtf">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCkkho6vZp3kuq92L9UxQ7x"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/Rbfc13foQ6CEHIWiXh434p"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normal rate of fast inactivation (tau inactivation) is an absence of an effect on rate of fast inactivation of a voltage-gated ion channel in which no significant difference in time constant is observed compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0047</rdfs:ID>
        <rdfs:label xml:lang="en-us">Normal fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RBNgNEEXTwqRuFYweKcutxe -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RBNgNEEXTwqRuFYweKcutxe">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R7YvyEoR5sDyyQqL5j9dQoK"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBWAIKiQem63yDopljeSmcj"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An increase in persistent current is an effect on persistent current of a voltage-gated sodium channel leading to gain of function, in which a significantly greater current is conducted by the channel following fast inactivation.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0040</rdfs:ID>
        <rdfs:label xml:lang="en-us">Increase in persistent current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RBOVqte4ccjmqTJAI8jkV44 -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RBOVqte4ccjmqTJAI8jkV44">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCkkho6vZp3kuq92L9UxQ7x"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDFDJF4kvghH94F1afcua4w"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normal slope of activation is an absence of an effect on slope of activation (k) of a voltage-gated ion channel in which there is no significant difference in k observed compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0036</rdfs:ID>
        <rdfs:label xml:lang="en-us">Normal slope of activation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RBRr02cNOD5wl0pS44hXqqX -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RBRr02cNOD5wl0pS44hXqqX">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R7KOr8G1xCnwPzwaON10MTm"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mild-moderate hyperpolarizing shift of voltage dependence of fast inactivation is a hyperpolarizing shift of voltage dependence of fast inactivation (left shift) of a voltage-gated ion channel in which the value of V1/2 is significantly reduced by up to 15mV.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0066</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">loss-of-function</rdfs:comment>
        <rdfs:label xml:lang="en-us">Mild-moderate hyperpolarizing shift of voltage dependence of fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RBSKgEYTBWMuaYGCUWF6iOv -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RBSKgEYTBWMuaYGCUWF6iOv">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R86071iVxOmUgj1ljXI9RwA"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Overall loss-of-function effect due to neuronal network properties is an overall loss-of-function in which the reduction to the mutant channel&apos;s function is observed on systems of multiple neurons.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0142</rdfs:ID>
        <rdfs:label xml:lang="en-us">Overall loss-of-function effect due to neuronal network properties</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RBSg2tM1FbJBOPZrJ3Ipe0G -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RBSg2tM1FbJBOPZrJ3Ipe0G">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R3Kr2TGkTE2Cs3wLLgOUHN"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mild depolarizing shift of voltage dependence of fast inactivation is a depolarizing shift of voltage dependence of fast inactivation (right shift) of a voltage-gated ion channel in which the value of V1/2 is significantly increased by up to 7.5mV.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0062</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gain-of-function</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">up to 7.5 mV shift</rdfs:comment>
        <rdfs:label xml:lang="en-us">Mild depolarizing shift of voltage dependence of fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RBWAIKiQem63yDopljeSmcj -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RBWAIKiQem63yDopljeSmcj">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R7dNr0622a5wBESQGcaLkZg"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A component leading to gain-of-function is an alteration that contributes to overall enhanced mutant function compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0003</rdfs:ID>
        <rdfs:label xml:lang="en-us">Component leading to Gain-of-Function (GoF)</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RBc0zNLLgdk5NOgtaBohQMX -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RBc0zNLLgdk5NOgtaBohQMX">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R77VgsjEzz65xAcEUzaZXUt"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R989oVaOLlRTh0b3roVWMYa"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A decrease in ramp current is an effect on ramp current of a voltage-gated ion channel leading to loss of function, in which the current amplitude is significantly reduced compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0129</rdfs:ID>
        <rdfs:label xml:lang="en-us">Decrease in ramp current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RBdbOghIxdzmUv1FRMZcqMy -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RBdbOghIxdzmUv1FRMZcqMy">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RPGjvHXaR7w0A4dKjNGhVc"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A severe slowing of fast inactivation (tau inactivation) is a slowing of fast inactivation of a voltage-gated ion channel in which the mutant has a time constant significantly increased by a factor of &gt;4 compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0051</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Severe: more than 4 fold</rdfs:comment>
        <rdfs:label xml:lang="en-us">Severe slowing of fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RBeZ7v8FkpfoCRDKvHZD936 -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RBeZ7v8FkpfoCRDKvHZD936">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/ROWM5cmXNzjTPBn7ogKyII"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A severe decrease in peak current due to reduced trafficking due to phosphorylation is a severe decrease in peak current due to reduced trafficking of a voltage-gated ion channel in which the reduced trafficking is explained by significant changes to the pattern of attachment of phosphoryl groups to specific residues within the channel.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0090</rdfs:ID>
        <rdfs:label xml:lang="en-us">Severe decrease in peak current due to reduced trafficking due to phosphorylation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RBijWyJfrgnn2shZrQFKwyM -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RBijWyJfrgnn2shZrQFKwyM">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R7jOR4IAP4IwniBv4AwBnrm"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R989oVaOLlRTh0b3roVWMYa"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A decrease in peak current is an effect on peak current of a voltage-gated ion channel leading to loss-of-function, in which peak current density is significantly reduced compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0084</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Decrease in peak current, LOF 50-100% mild 20-50% moderate &lt;20% wild-type - severe</rdfs:comment>
        <rdfs:label xml:lang="en-us">Decrease in peak current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RBjmWtBKwt8nrHDyuxb6Nug -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RBjmWtBKwt8nrHDyuxb6Nug">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R99KATlEV5UUOxmTthHewYy"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCkkho6vZp3kuq92L9UxQ7x"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normal voltage dependence of activation is an absence of an effect on shift of voltage dependence of activation of a voltage-gated ion channel in which no significant difference in V1/2 is observed compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0032</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Helper term in bio-ontology, signified explicit absence of parent term</rdfs:comment>
        <rdfs:label xml:lang="en-us">Normal voltage dependence of activation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RBoUVhAjinxgCZHvQei6QsT -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RBoUVhAjinxgCZHvQei6QsT">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBWAIKiQem63yDopljeSmcj"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDFDJF4kvghH94F1afcua4w"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A decrease in slope of activation is an effect on slope of activation (k) of a voltage-gated ion channel leading to gain of function, in which there is significantly greater steepness of channel activation with respect to membrane potential.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0034</rdfs:ID>
        <rdfs:label xml:lang="en-us">Decrease in slope of activation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RBp4HSri5YtkrPJguFjDAxP -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RBp4HSri5YtkrPJguFjDAxP">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBNgNEEXTwqRuFYweKcutxe"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mild increase in persistent current is an increase in persistent current of a voltage-gated sodium channel in which the persistent current is significantly increased by a factor of up to 2 in the mutant compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0041</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">up to 2x increase</rdfs:comment>
        <rdfs:label xml:lang="en-us">Mild increase in persistent current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RBwtVQzCS1UVEiDyo07xcdJ -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RBwtVQzCS1UVEiDyo07xcdJ">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R5vvSMCBavnR4OPfmY6bjk"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCDQDyUZ1O1bMFQkiFtMAZu"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Abnormal ion selectivity is an effect on ion selectivity in which the mutant channel conducts a different type of ion.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0080</rdfs:ID>
        <rdfs:label xml:lang="en-us">Abnormal ion selectivity</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RBx87cocPenIzmpmFJRAE8E -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RBx87cocPenIzmpmFJRAE8E">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R989oVaOLlRTh0b3roVWMYa"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/Rbfc13foQ6CEHIWiXh434p"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An acceleration of fast inactivation (tau inactivation) is an effect on rate of fast inactivation of a voltage-gated ion channel leading to loss-of-function, in which the time constant is significantly reduced, corresponding to channels changing to the inactivated state faster compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0046</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No distinct subclasses, less milliseconds, LoF</rdfs:comment>
        <rdfs:label xml:lang="en-us">Acceleration of fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RByNptA431wiEbrBZa4Y14U -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RByNptA431wiEbrBZa4Y14U">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBNgNEEXTwqRuFYweKcutxe"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A moderate increase in persistent current is an increase in persistent current of a voltage-gated sodium channel in which the persistent current is signfiicantly increased by a factor of 2-3 in the mutant compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0042</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2-3x fold increase</rdfs:comment>
        <rdfs:label xml:lang="en-us">Moderate increase in persistent current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RByPM9kRtVogJhkqUM3lsh4 -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RByPM9kRtVogJhkqUM3lsh4">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RwQyQ1jQlK4mhCi3frcbsW"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The activated state is when the pore is open and the channel conducts current. An effect on activation is a biophysical change in which one of the parameters of channel changing to the activated state is different in the mutant protein compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0008</rdfs:ID>
        <rdfs:label xml:lang="en-us">Effect on activation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RC3aErf3GasgglmgYMcpS4n -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RC3aErf3GasgglmgYMcpS4n">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBBfmTmxXmWBRBGEeKe7r0O"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBWAIKiQem63yDopljeSmcj"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An acceleration of recovery from fast inactivation is an effect on rate of recovery from fast inactivation of a voltage-gated ion channel leading to gain-of-function, in which the time constant (tau) is significantly reduced, corresponding to channels recovering from inactivation faster compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0053</rdfs:ID>
        <rdfs:label xml:lang="en-us">Acceleration of recovery from fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RC3cyZOGS7bJrI8gBqDaHzo -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RC3cyZOGS7bJrI8gBqDaHzo">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RQjP2MguDr8OzKDeceZJ46"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A moderate depolarizing shift of voltage dependence of activation is a depolarizing shift of voltage dependence of activation (right shift) of a voltage-gated ion channel in which the value of V1/2 is significantly increased by 5-10mV for Na+ channels or 10-20mV for K+ channels.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0025</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Loss-of-function</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCN2A and SCN8A moderate: 5-10 mV shift</rdfs:comment>
        <rdfs:label xml:lang="en-us">Moderate depolarizing shift of voltage dependence of activation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RC6e65svL8GnahTMiaHjRON -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RC6e65svL8GnahTMiaHjRON">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RwQyQ1jQlK4mhCi3frcbsW"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The fast inactivated state is when the pore is open but does not conduct current. An effect on fast inactivation is a biophysical change in which one of the parameters of the channel changing to the fast inactivated state is different in the mutant protein compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0037</rdfs:ID>
        <rdfs:label xml:lang="en-us">Effect on fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RC7JvpnEA0enGEJxIIdz4c -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RC7JvpnEA0enGEJxIIdz4c">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R8fyxz5nx0mgxsMOtEoRmWk"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A severe slowing of activation (tau activation) of a voltage-gated ion channel in which the mutant has a time constant significantly increased by a factor of more than 2 compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0015</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KCNQ2: severe &gt; 2.00</rdfs:comment>
        <rdfs:label xml:lang="en-us">Severe slowing of activation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RC7UYgJd2o0EeyLF1F20qZG -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RC7UYgJd2o0EeyLF1F20qZG">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RQjP2MguDr8OzKDeceZJ46"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mild depolarizing shift of voltage dependence of activation is a depolarizing shift of voltage dependence of activation (right shift) of a voltage-gated ion channel in which the value of V1/2 is significantly increased by up to 5mV for Na+ channels or 10mV for K+ channels.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0024</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Loss-of-function</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCN2A and SCN8A mild: up to 5 mV; K+ channels mild: up to 10mV</rdfs:comment>
        <rdfs:label xml:lang="en-us">Mild depolarizing shift of voltage dependence of activation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RCCYzTbbm9jGGdBAcyrpQbn -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RCCYzTbbm9jGGdBAcyrpQbn">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R989oVaOLlRTh0b3roVWMYa"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCQHSBGZT4JxStSfikvi8js"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An acceleration of entry into slow inactivation is an effect on entry into slow inactivation of a voltage-gated ion channel leading to loss-of-function, in which the time of onset of slow inactivation is significantly reduced.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0103</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">measured in milliseconds/seconds</rdfs:comment>
        <rdfs:label xml:lang="en-us">Acceleration of entry into slow inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RCDQDyUZ1O1bMFQkiFtMAZu -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RCDQDyUZ1O1bMFQkiFtMAZu">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R7dNr0622a5wBESQGcaLkZg"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A component leading to uncertain biophysiological effect is an alteration for which it is unclear whether the contribution is to enhancement or reduction in mutant function compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0006</rdfs:ID>
        <rdfs:label xml:lang="en-us">Component leading to uncertain biophysiological effect</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RCEWxMPvxnLPQFI7e1TeyDC -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RCEWxMPvxnLPQFI7e1TeyDC">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R8KqfFzWrSaU9t4uXABtJRK"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBWAIKiQem63yDopljeSmcj"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An increase in resurgent current is an effect on resurgent current of a voltage-gated ion channel leading to gain-of-function, in which ion flow in mutant channels which reopened following the normal transient current is significantly increased compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0099</rdfs:ID>
        <rdfs:label xml:lang="en-us">Increase in resurgent current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RCJNYSXtzUQaxxxeigBc9rg -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RCJNYSXtzUQaxxxeigBc9rg">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R8elYee9oFnTyzGLbmLUaeO"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCkkho6vZp3kuq92L9UxQ7x"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The absence of abnormal gating pore current denotes normal ion channel function wherein no ion flow through the voltage-sensing domain is detected.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0076</rdfs:ID>
        <rdfs:label xml:lang="en-us">Absence of abnormal gating pore current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RCJZXn4sxIYSrwb8TbZJlqg -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RCJZXn4sxIYSrwb8TbZJlqg">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R5vvSMCBavnR4OPfmY6bjk"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normal ion selectivity is an absence of an effect on ion selectivity in which no significant difference in ion specificity is observed compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0081</rdfs:ID>
        <rdfs:label xml:lang="en-us">Normal ion selectivity</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RCQHSBGZT4JxStSfikvi8js -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RCQHSBGZT4JxStSfikvi8js">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RobShQwofhZsmj29NgnSGj"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An effect on entry into slow inactivation is an effect on slow inactivation of a voltage-gated ion channel in which the affected parameter is the time it takes for slow inactivation to begin.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0102</rdfs:ID>
        <rdfs:label xml:lang="en-us">Effect on entry into slow inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RCQdh0b9O2PwzpekxN1WriE -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RCQdh0b9O2PwzpekxN1WriE">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBRr02cNOD5wl0pS44hXqqX"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mild hyperpolarizing shift of voltage dependence of fast inactivation is a hyperpolarizing shift of voltage dependence of fast inactivation (left shift) of a voltage-gated ion channel in which the value of V1/2 is significantly reduced by up to 7.5mV.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0067</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">loss-of-function</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">up to 7.5 mV shift</rdfs:comment>
        <rdfs:label xml:lang="en-us">Mild hyperpolarizing shift of voltage dependence of fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RCkkho6vZp3kuq92L9UxQ7x -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RCkkho6vZp3kuq92L9UxQ7x">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R7dNr0622a5wBESQGcaLkZg"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A component leading to normal function is an alteration that contributes to no change in mutant function compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0005</rdfs:ID>
        <rdfs:label xml:lang="en-us">Component leading to normal ion channel function</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RCvk5iSgbniWz9P4mjJsdlC -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RCvk5iSgbniWz9P4mjJsdlC">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R7Q10ohyxQHPdcQsFmhC1Si"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An overall mixed or unclear function is an overall assessment of ion channel function in which the experimenters conclude that the activity of the mutant channel is neither explicitly enhanced nor reduced relative to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0145</rdfs:ID>
        <rdfs:label xml:lang="en-us">Overall mixed or unclear functional effect not able to be clearly categorized as Gain- or Loss-of-Function</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RCxkRIG6UqWPWVsBL3fvLdo -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RCxkRIG6UqWPWVsBL3fvLdo">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDXWDoljWFzQfFl2YI7DCtA"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An effect on shift of voltage dependence of slow inactivation (V1/2) is an effect on voltage dependence of slow inactivation of a voltage-gated ion channel in which the affected parameter is the half-maximal voltage (V1/2), the potential at which 50% of channels are in the slow inactivated state.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0115</rdfs:ID>
        <rdfs:label xml:lang="en-us">Effect on shift of voltage dependence of slow inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RD0BDIIzgUe4mtGYW27xz6H -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RD0BDIIzgUe4mtGYW27xz6H">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDnQOos7Y952sZBt7bCl2A"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Overall normal function due to single-cell neuronal properties is an overall normal function in which the normal function of the mutant channel is observed at the level of single neuron, e.g. due to firing rates.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0151</rdfs:ID>
        <rdfs:label xml:lang="en-us">Overall normal function due to single-cell neuronal properties</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RD13eaB3fwGp3eE77vJf9J7 -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RD13eaB3fwGp3eE77vJf9J7">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R7jOR4IAP4IwniBv4AwBnrm"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBWAIKiQem63yDopljeSmcj"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An increase in peak current is an effect on peak current of a voltage-gated ion channel leading to gain-of-function, in which peak current density is significantly increased compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0092</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2 fold or higher - severe
1.3-2 fold moderate
up to 1.3 fold is mild</rdfs:comment>
        <rdfs:label xml:lang="en-us">Increase in peak current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RD4l3irGmoY9l24tfaycvl -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RD4l3irGmoY9l24tfaycvl">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R989oVaOLlRTh0b3roVWMYa"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RWsIdPK9ef5X7RMzIebmPQ"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An increase of decay in current amplitude in use dependence is an effect on use dependence of a voltage-gated ion channel leading to loss of function, in which the use-dependent attenuation is significantly increased, leading to less current conducted over repeat depolarization.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0134</rdfs:ID>
        <rdfs:label xml:lang="en-us">Increase of decay in current amplitude in use dependence</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RD8Pi69ieWp9K2OhT9WJEG -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RD8Pi69ieWp9K2OhT9WJEG">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBWAIKiQem63yDopljeSmcj"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RWsIdPK9ef5X7RMzIebmPQ"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A decrease of decay in current amplitude in use dependence is an effect on use dependence of a voltage-gated ion channel leading to gain of function, in which the use-dependent attenuation is significantly reduced, leading to more current conducted over repeat depolarization.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0133</rdfs:ID>
        <rdfs:label xml:lang="en-us">Decrease of decay in current amplitude in use dependence</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RDFDJF4kvghH94F1afcua4w -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RDFDJF4kvghH94F1afcua4w">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDyQ9lJFRvp1SJ8SKR7BkGn"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An effect on slope of activation (k) is an effect on voltage dependence of activation of a voltage-gated ion channel in which the affected parameter is the slope factor (k), which indicates the steepness of voltage dependence of activation when plotted with respect to voltage after fitting to a Boltzmann function.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0033</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">change in activation for Na+ channels</rdfs:comment>
        <rdfs:label xml:lang="en-us">Effect on slope of activation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RDGPKWNIULbpyxm7b0wIuii -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RDGPKWNIULbpyxm7b0wIuii">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R989oVaOLlRTh0b3roVWMYa"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RB39ECWMLncqVLZXtTVSuW3"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A decrease in slope of slow inactivation is an effect on slope of slow inactivation (k) of a voltage-gated ion channel leading to loss of function, in which there is significantly greater steepness of channel inactivation with respect to membrane potential.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0120</rdfs:ID>
        <rdfs:label xml:lang="en-us">Decrease in slope of slow inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RDI44zpLiKB8U9OBgFIDIop -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RDI44zpLiKB8U9OBgFIDIop">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R9SbYpUEIgenr1NAQGsVJLA"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An effect on slope of fast inactivation (k) is an effect on voltage dependence of fast inactivation of a voltage-gated ion channel in which the affected parameter is slope factor (k), which indicates the steepness of voltage dependence of inactivation when plotted with respect to voltage after fitting to a Boltzmann function.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0071</rdfs:ID>
        <rdfs:label xml:lang="en-us">Effect on slope of fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RDM0lP4PmjUTUE8TDmx0vhO -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RDM0lP4PmjUTUE8TDmx0vhO">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R8fyxz5nx0mgxsMOtEoRmWk"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mild slowing of activation is a slowing of activation (tau activation) of a voltage-gated ion channel in which the mutant has a time constant increased significantly by a factor of up to 1.25 compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0013</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KCNQ2: up to 1.25</rdfs:comment>
        <rdfs:label xml:lang="en-us">Mild slowing of activation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RDN1HidwTo5yxEolQVUN1i2 -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RDN1HidwTo5yxEolQVUN1i2">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R989oVaOLlRTh0b3roVWMYa"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/Rwd2Okf7Sd1xsETaBGsjeS"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An acceleration of deactivation is an effect on rate of deactivation (tau deactivation) of a voltage-gated ion channel leading to loss-of-function, in which the time constant is reduced, corresponding to channels closing significantly faster compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0017</rdfs:ID>
        <rdfs:label xml:lang="en-us">Acceleration  of deactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RDTMAY4Nsd5P8hpcBUUypxU -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RDTMAY4Nsd5P8hpcBUUypxU">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R9wEM2OxcV4ZL1GcpqWaE52"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Overall gain-of-function effect due to neuronal network properties is an overall gain-of-function in which the enhancement to the mutant channel&apos;s function is observed on systems of multiple neurons.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0138</rdfs:ID>
        <rdfs:label xml:lang="en-us">Overall gain-of-function effect due to neuronal network properties</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RDXWDoljWFzQfFl2YI7DCtA -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RDXWDoljWFzQfFl2YI7DCtA">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RobShQwofhZsmj29NgnSGj"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An effect on voltage dependence of slow inactivation is an effect on slow inactivation of a voltage-gated ion channel in which the affected parameter is the proportion of channels that are in inactivated states after being held at different membrane potentials/voltages.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0114</rdfs:ID>
        <rdfs:label xml:lang="en-us">Effect on voltage dependence of slow inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RDcpKlApCB4PPPBO6hjgl6m -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RDcpKlApCB4PPPBO6hjgl6m">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R9sk2fOWBMQbWVog5qqITs7"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A severe depolarizing shift of voltage dependence of fast inactivation is a depolarizing shift of voltage dependence of fast inactivation (right shift) of a voltage-gated ion channel in which the value of V1/2 is significantly increased by &gt;15mV.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0064</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&gt; 15 mV shift</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gain-of-function</rdfs:comment>
        <rdfs:label xml:lang="en-us">Severe depolarizing shift of voltage dependence of fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RDnQOos7Y952sZBt7bCl2A -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RDnQOos7Y952sZBt7bCl2A">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R7Q10ohyxQHPdcQsFmhC1Si"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An overall normal function is an overall assessment of ion channel function in which the experimenters conclude that the activity of the mutant channel is similar to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0149</rdfs:ID>
        <rdfs:label xml:lang="en-us">Overall normal function</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RDrJoygIdb3JDax6AmGciVY -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RDrJoygIdb3JDax6AmGciVY">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Effect on ion channel function</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0001</rdfs:ID>
        <rdfs:label xml:lang="en-us">Effect on ion channel function</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RDtSd8oWO4IYoQfAWZxQBNy -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RDtSd8oWO4IYoQfAWZxQBNy">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R9wEM2OxcV4ZL1GcpqWaE52"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Overall gain-of-function effect with respect to biophysical channel activity is an overall gain-of-function in which the enhancement to the mutant channel&apos;s function is concluded from the cumulative effect of the biophysical alterations to the channel.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0140</rdfs:ID>
        <rdfs:label xml:lang="en-us">Overall gain-of-function effect with respect to biophysical channel activity</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RDuKs2x3U7Ftv1RPSUUW7bG -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RDuKs2x3U7Ftv1RPSUUW7bG">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCvk5iSgbniWz9P4mjJsdlC"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Overall mixed or unclear functional effect with respect to biophysical channel activity is an overall mixed function in which the conflicting effects to the mutant channel&apos;s function is concluded from the cumulative effect of the biophysical alterations to the channel.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0148</rdfs:ID>
        <rdfs:label xml:lang="en-us">Overall mixed or unclear functional effect with respect to biophysical channel activity</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RDufCzpibYChlFwDOguxQBk -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RDufCzpibYChlFwDOguxQBk">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R8tC7DUKEOwvWvpkJDURZZk"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R989oVaOLlRTh0b3roVWMYa"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An acceleration of slow inactivation is an effect on rate of slow inactivation (tau inactivation) of a voltage-gated ion channel leading to loss-of-function, in which the time constant is significantly reduced, corresponding to channels changing to the slow inactivated state faster compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0111</rdfs:ID>
        <rdfs:label xml:lang="en-us">Acceleration of slow inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RDyQ9lJFRvp1SJ8SKR7BkGn -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RDyQ9lJFRvp1SJ8SKR7BkGn">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RByPM9kRtVogJhkqUM3lsh4"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An effect on voltage dependence of activation is an effect on activation of a voltage-gated ion channel in which the affected parameter is the proportion of channels that are in activated states after being held at different membrane potentials/voltages.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0020</rdfs:ID>
        <rdfs:label xml:lang="en-us">Effect on voltage dependence of activation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RF33PdZrU9lQq5U6wsPKju -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RF33PdZrU9lQq5U6wsPKju">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCkkho6vZp3kuq92L9UxQ7x"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/Rwd2Okf7Sd1xsETaBGsjeS"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normal rate of deactivation is an absence of an effect on rate of deactivation (tau deactivation) of a voltage-gated ion channel in which no significant difference in time constant is observed compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0018</rdfs:ID>
        <rdfs:label xml:lang="en-us">Normal rate of deactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RFM4zJvoKLRdsir6FY0w37 -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RFM4zJvoKLRdsir6FY0w37">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBNgNEEXTwqRuFYweKcutxe"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A severe increase in persistent current is an increase in persistent current of a voltage-gated sodium channel in which the persistent current is significantly increased by a factor of more than 3 in the mutant compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0043</rdfs:ID>
        <rdfs:label xml:lang="en-us">Severe increase in persistent current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RFfobOSwAuTUYKPE2tL5xf -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RFfobOSwAuTUYKPE2tL5xf">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RB39ECWMLncqVLZXtTVSuW3"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normal slope of slow inactivation is an absence of an effect on slope of slow inactivation (k) in which there is no significant difference in slope factor observed compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0122</rdfs:ID>
        <rdfs:label xml:lang="en-us">Normal slope of slow inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RGZCWQhcAEWq0SY26S5m5e -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RGZCWQhcAEWq0SY26S5m5e">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R8oN6Lr9gpAWFhWBexO3rhu"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCkkho6vZp3kuq92L9UxQ7x"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normal voltage dependence of fast inactivation is an absence of an effect on voltage dependence of fast inactivation in which no significant difference in V1/2 is observed compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0070</rdfs:ID>
        <rdfs:label xml:lang="en-us">Normal voltage dependence of fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RHVrokWeLjYhM07ls02sTd -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RHVrokWeLjYhM07ls02sTd">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R77VgsjEzz65xAcEUzaZXUt"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBWAIKiQem63yDopljeSmcj"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An increase in ramp current is an effect on ramp current of a voltage-gated ion channel leading to gain of function, in which the current amplitude is significantly increased compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0130</rdfs:ID>
        <rdfs:label xml:lang="en-us">Increase in ramp current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RM0V7djo7NgfCr6xB32iax -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RM0V7djo7NgfCr6xB32iax">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBijWyJfrgnn2shZrQFKwyM"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mild decrease in peak current is a decrease in peak current of a voltage-gated ion channel in which peak current density in the mutant is significantly reduced to 50-100% of that of the wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0085</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">50-100% of wildtype</rdfs:comment>
        <rdfs:label xml:lang="en-us">Mild decrease in peak current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RMPJkbO62zkkObPHsJZpnf -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RMPJkbO62zkkObPHsJZpnf">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R7YvyEoR5sDyyQqL5j9dQoK"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R989oVaOLlRTh0b3roVWMYa"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A decrease in persistent current is an effect on persistent current of a voltage-gated sodium channel leading to loss of function, in which a significantly reduced current is conducted by the channel following fast inactivation.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0039</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reduced persistent current is an outlier SCN11a and SCN10a: technically can have reduced persistent current</rdfs:comment>
        <rdfs:label xml:lang="en-us">Decrease in persistent current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RMxVquE9c2j3gk6Vbhg9TW -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RMxVquE9c2j3gk6Vbhg9TW">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RB39ECWMLncqVLZXtTVSuW3"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBWAIKiQem63yDopljeSmcj"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An increase in slope of slow inactivation is an effect on slope of slow inactivation (k) of a voltage-gated ion channel leading to gain of function, in which there is significantly reduced steepness of channel inactivation with respect to membrane potential.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0121</rdfs:ID>
        <rdfs:label xml:lang="en-us">Increase in slope of slow inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RNbTxYjtlhgiWW8okEMzyj -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RNbTxYjtlhgiWW8okEMzyj">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCkkho6vZp3kuq92L9UxQ7x"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RWsIdPK9ef5X7RMzIebmPQ"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normal current amplitude in use dependence is an absence of effect on use dependence of a voltage-gated ion channel, in which no significant difference is observed compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0135</rdfs:ID>
        <rdfs:label xml:lang="en-us">Normal current amplitude in use dependence</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/ROWM5cmXNzjTPBn7ogKyII -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/ROWM5cmXNzjTPBn7ogKyII">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R9YmpNJrUqHfe8VU8jjemmJ"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A severe decrease in peak current due to reduced trafficking is a severe decrease in peak current of a voltage-gated ion channel which is explained by a significantly reduced fraction of mutant channels being trafficked to the plasma membrane compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0089</rdfs:ID>
        <rdfs:label xml:lang="en-us">Severe decrease in peak current due to reduced trafficking</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RPGjvHXaR7w0A4dKjNGhVc -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RPGjvHXaR7w0A4dKjNGhVc">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBWAIKiQem63yDopljeSmcj"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/Rbfc13foQ6CEHIWiXh434p"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A slowing of fast inactivation (tau inactivation) is an effect on rate of fast inactivation of a voltage-gated ion channel leading to gain-of-function, in which the time constant is significantly increased, corresponding to channels changing to the inactivated state more slowly than wildtype channels.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0048</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mild (up to 2 fold) Moderate (2-4 fold) Severe: more than 4 fold</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">more milliseconds, GoF</rdfs:comment>
        <rdfs:label xml:lang="en-us">Slowing of fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RQNDbYiHvI4VNvMipjKcIZ -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RQNDbYiHvI4VNvMipjKcIZ">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R989oVaOLlRTh0b3roVWMYa"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RwcubAXCIcP10yoVjk9JVf"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A slowing of recovery from slow inactivation is an effect on recovery from slow inactivation of a voltage-gated ion channel leading to loss-of-function, in which the time constant (tau) is significantly increased, corresponding to channels recovering slower compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0109</rdfs:ID>
        <rdfs:label xml:lang="en-us">Slowing of recovery from slow inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RQjP2MguDr8OzKDeceZJ46 -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RQjP2MguDr8OzKDeceZJ46">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R9wmRpum1ZjBHKOc0cthMrv"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mild-moderate depolarizing shift of voltage dependence of activation is a depolarizing shift of voltage dependence of activation (right shift) of a voltage-gated ion channel in which the value of V1/2 is significantly increased by up to 10mV for Na+ channels or 20mV for K+ channels.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0023</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Loss-of-function</rdfs:comment>
        <rdfs:label xml:lang="en-us">Mild-moderate depolarizing shift of voltage dependence of activation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RTJTAlmpfiiOAckMP7C8xY -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RTJTAlmpfiiOAckMP7C8xY">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBWAIKiQem63yDopljeSmcj"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/Rwd2Okf7Sd1xsETaBGsjeS"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A slowing of deactivation is an effect on rate of deactivation (tau deactivation) of a voltage-gated ion channel leading to gain-of-function, in which the time constant is increased, corresponding to channels closing significantly slower compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0019</rdfs:ID>
        <rdfs:label xml:lang="en-us">Slowing of deactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RVDcHrv1yHMY8q3VkhEV9W -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RVDcHrv1yHMY8q3VkhEV9W">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R8KqfFzWrSaU9t4uXABtJRK"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R989oVaOLlRTh0b3roVWMYa"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A decrease in resurgent current is an effect on resurgent current of a voltage-gated ion channel leading to loss-of-function, in which ion flow in mutant channels which reopened following the normal transient current is significantly reduced compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0098</rdfs:ID>
        <rdfs:label xml:lang="en-us">Decrease in resurgent current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RW0QrBvuBOwHBYFFJMntlo -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RW0QrBvuBOwHBYFFJMntlo">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBWAIKiQem63yDopljeSmcj"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCQHSBGZT4JxStSfikvi8js"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A slowing of entry into slow inactivation is an effect on entry into slow inactivation of a voltage-gated ion channel leading to gain-of-function, in which the time of onset of slow inactivation is significantly increased.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0105</rdfs:ID>
        <rdfs:label xml:lang="en-us">Slowing of entry into slow inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RWsIdPK9ef5X7RMzIebmPQ -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RWsIdPK9ef5X7RMzIebmPQ">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBJiFsljKf9Ot340DhQvUT"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use dependence refers to the attenuation of current conducted by a voltage-gated ion channel in response to repeated depolarization. An effect on use dependence is a compound biophysical effect in which this use-dependent decay in current amplitude is different in the mutant protein compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0132</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">amplitude goes down after repeat impulses, not biophysical property of channel itself</rdfs:comment>
        <rdfs:label xml:lang="en-us">Effect on use dependence</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RXhKs55YyYQdgiLKwckPRg -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RXhKs55YyYQdgiLKwckPRg">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R989oVaOLlRTh0b3roVWMYa"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBBfmTmxXmWBRBGEeKe7r0O"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A slowing of recovery from fast inactivation is an effect on rate of recovery from fast inactivation of a voltage-gated ion channel leading to loss-of-function, in which the time constant (tau) is significantly increased, corresponding to channels recovering more slowly compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0055</rdfs:ID>
        <rdfs:label xml:lang="en-us">Slowing of recovery from fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RYWQSm4huaAno89B4WFQZH -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RYWQSm4huaAno89B4WFQZH">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBijWyJfrgnn2shZrQFKwyM"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A moderate decrease in peak current is a decrease in peak current of a voltage-gated ion channel in which the peak current density of the mutant is significantly reduced to 20-49% of that of the wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0086</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">20-50% of wildtype</rdfs:comment>
        <rdfs:label xml:lang="en-us">Moderate decrease in peak current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/Rbfc13foQ6CEHIWiXh434p -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/Rbfc13foQ6CEHIWiXh434p">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RC6e65svL8GnahTMiaHjRON"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An effect on rate of fast inactivation (tau inactivation) is an effect on fast inactivation of a voltage-gated ion channel in which the affected parameter is the time constant (tau) of fast inactivation, which measures how quickly or slowly the open channel changes to the inactivated state with respect to time.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0045</rdfs:ID>
        <rdfs:label xml:lang="en-us">Effect on rate of fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RbjgdQVqMBklwux9sWTACl -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RbjgdQVqMBklwux9sWTACl">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R9wmRpum1ZjBHKOc0cthMrv"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A severe depolarizing shift of voltage dependence of activation is a depolarizing shift of voltage dependence of activation (right shift) of a voltage-gated ion channel in which the value of V1/2 is significantly increased by &gt;5mV for Na+ channels or &gt;10mV for K+ channels.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0026</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Loss-of-function</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCN2A and SCN8A severe: &gt;10 mV, K+ channels severe: &gt;20mV</rdfs:comment>
        <rdfs:label xml:lang="en-us">Severe depolarizing shift of voltage dependence of activation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RfJRsrblTGfIJ44dw2SyYJ -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RfJRsrblTGfIJ44dw2SyYJ">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R7KOr8G1xCnwPzwaON10MTm"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A severe hyperpolarizing shift of voltage dependence of fast inactivation is a hyperpolarizing shift of voltage dependence of fast inactivation (left shift) of a voltage-gated ion channel in which the value of V1/2 is significantly reduced by &gt;15mV.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0069</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">loss-of-function</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">more than 15 mV shift</rdfs:comment>
        <rdfs:label xml:lang="en-us">Severe hyperpolarizing shift of voltage dependence of fast inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RgGuZhqK1D3ro0nNhiBoXw -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RgGuZhqK1D3ro0nNhiBoXw">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCkkho6vZp3kuq92L9UxQ7x"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/Rsw2n4guhiNupAT5yaAXtb"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normal subthreshold current is an absence of an effect on subthreshold current, in which no significant difference is observed compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0126</rdfs:ID>
        <rdfs:label xml:lang="en-us">Normal subthreshold current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RiK8rUNBcWv8Rw4Rq5MIQX -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RiK8rUNBcWv8Rw4Rq5MIQX">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R8fyxz5nx0mgxsMOtEoRmWk"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mild to moderate slowing of activation is a slowing of activation (tau activation) of a voltage-gated ion channel in which the mutant has a time constant significantly increased by a factor of 1.25-2 compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0014</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KCNQ2: 1.25-2.0</rdfs:comment>
        <rdfs:label xml:lang="en-us">Moderate slowing of activation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/Rkesu9uJL9z5Q6W38xiAhQ -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/Rkesu9uJL9z5Q6W38xiAhQ">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R918FRlaBUyZMXc8koNdkxQ"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A severe hyperpolarizing shift of voltage dependence of activation is a hyperpolarizing shift of voltage dependence of activation (left shift) of a voltage-gated ion channel in which the value of V1/2 is significantly decreased by &gt;10mV for Na+ channels or &gt;20mV for K+ channels.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0031</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gain-of-function</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCN2A and SCN8A severe: &gt;10 mV; K+ channels severe: &gt;20mV</rdfs:comment>
        <rdfs:label xml:lang="en-us">Severe hyperpolarizing shift of voltage dependence of activation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/Rl7K1Hgqs34BVxM4PNtn4w -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/Rl7K1Hgqs34BVxM4PNtn4w">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R918FRlaBUyZMXc8koNdkxQ"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mild-moderate hyperpolarizing shift of voltage dependence of activation  is a hyperpolarizing shift of voltage dependence of activation (left shift) of a voltage-gated ion channel in which the value of V1/2 is significantly decreased by up to 10mV for Na+ channels or 20mV for K+ channels.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0028</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gain-of-function</rdfs:comment>
        <rdfs:label xml:lang="en-us">Mild-moderate hyperpolarizing shift of voltage dependence of activation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RoMCTYJPjBEU5d6aaVUh44 -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RoMCTYJPjBEU5d6aaVUh44">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R989oVaOLlRTh0b3roVWMYa"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCxkRIG6UqWPWVsBL3fvLdo"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A hyperpolarizing shift of voltage dependence of slow inactivation (left shift) is an effect on shift of voltage dependence of slow inactivation (V1/2) of a voltage-gated ion channel leading to loss of function, in which channels change to the slow inactivated state at significantly more negative potentials.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0117</rdfs:ID>
        <rdfs:label xml:lang="en-us">Hyperpolarizing shift of voltage dependence of slow inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RobShQwofhZsmj29NgnSGj -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RobShQwofhZsmj29NgnSGj">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RwQyQ1jQlK4mhCi3frcbsW"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Slow inactivation is the process by which voltage-gated sodium channels change to an inactivated state following long (seconds) or high frequency depolarizations, reducing the proportion of channels available for opening. An effect on slow inactivation is a biophysical change of sodium channels in which there is a difference in the parameters of slow inactivation in the mutant protein compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0101</rdfs:ID>
        <rdfs:label xml:lang="en-us">Effect on slow inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/Rsw2n4guhiNupAT5yaAXtb -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/Rsw2n4guhiNupAT5yaAXtb">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RwQyQ1jQlK4mhCi3frcbsW"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Subthreshold current is continuous low-level conduction of ions by voltage-gated ion channels. An effect on subthreshold current is a biophysical change in which this flow is different in the mutant protein compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0123</rdfs:ID>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Subthreshold, for example for sodium channels ‘low threshold sodium current’ sometimes designated INaP in papers</rdfs:comment>
        <rdfs:label xml:lang="en-us">Effect on subthreshold current</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RwQyQ1jQlK4mhCi3frcbsW -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RwQyQ1jQlK4mhCi3frcbsW">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDrJoygIdb3JDax6AmGciVY"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An effect on ion channel biophysical properties is an alteration to an experimental measurement corresponding to a specific biophysical parameter of ion channel function.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0007</rdfs:ID>
        <rdfs:label xml:lang="en-us">Effect on ion channel biophysical properties</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RwcubAXCIcP10yoVjk9JVf -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RwcubAXCIcP10yoVjk9JVf">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RobShQwofhZsmj29NgnSGj"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An effect on rate of recovery from slow inactivation is an effect on slow inactivation of a voltage-gated ion channel in which the affected parameter is the time constant (tau) of recovery from slow inactivation, which measures how quickly or slowly the channel becomes available for activation after return to hyperpolarizing potentials to allow recovery from inactivation, i.e. the channel’s inactivation gate reopens.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0106</rdfs:ID>
        <rdfs:label xml:lang="en-us">Effect on rate of recovery from slow inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/Rwd2Okf7Sd1xsETaBGsjeS -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/Rwd2Okf7Sd1xsETaBGsjeS">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RByPM9kRtVogJhkqUM3lsh4"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deactivation is the changing of the channel from the open state to the closed state in which the pore is closed and does not conduct current. An effect on rate of deactivation (tau deactivation) is an effect on activation of a voltage-gated ion channel in which the affected parameter is the time constant (tau) of deactivation, which measures how quickly or slowly the channel closes upon repolarization with respect to time.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0016</rdfs:ID>
        <rdfs:label xml:lang="en-us">Effect on rate of deactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/Rzl8n5oqmxsKFuEQoGs7ys -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/Rzl8n5oqmxsKFuEQoGs7ys">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R8tC7DUKEOwvWvpkJDURZZk"/>
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCkkho6vZp3kuq92L9UxQ7x"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normal rate of slow inactivation is an absence of an effect on rate of slow inactivation (tau inactivation) in which no significant difference in time constant is observed compared to wildtype.</webprotege:R8eSx6hpNKkLz78503nxvB0>
        <rdfs:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FENICS:0112</rdfs:ID>
        <rdfs:label xml:lang="en-us">Normal rate of slow inactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RzxAghzfGsgvWX3Ibm1dzr -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RzxAghzfGsgvWX3Ibm1dzr">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCvk5iSgbniWz9P4mjJsdlC"/>
        <webprotege:R8eSx6hpNKkLz78503nxvB0 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Overall mixed or unclear functional effect due to single-cell neuronal properties is an overall mixed function in which the conflicting effects to the mutant channel&apos;s function is observed at the level of single neuron, e.g. due to firing rates.</webprotege:R8eSx6hpNKkLz78503nxvB0>
