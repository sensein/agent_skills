		<skos:altLabel xml:lang="fr">histiocytose lipoïdique essentielle</skos:altLabel>
		<skos:altLabel xml:lang="fr">sphingolipidose</skos:altLabel>
		<skos:altLabel xml:lang="fr">déficit en sphingomyélinase</skos:altLabel>
		<skos:altLabel xml:lang="fr">lipidose à sphingomyéline</skos:altLabel>
		<skos:altLabel xml:lang="fr">maladie de Niemann-Pick</skos:altLabel>
		<skos:altLabel xml:lang="fr">sphingomyélinose</skos:altLabel>
		<skos:altLabel xml:lang="fr">Sphingolipidose, sans précision</skos:altLabel>
		<skos:definition xml:lang="en">A group of inherited metabolic disorders characterized by the intralysosomal accumulation of SPHINGOLIPIDS primarily in the CENTRAL NERVOUS SYSTEM and to a variable degree in the visceral organs. They are classified by the enzyme defect in the degradation pathway and the substrate accumulation (or storage). Clinical features vary in subtypes but neurodegeneration is a common sign. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0342804"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
	</owl:Class>

