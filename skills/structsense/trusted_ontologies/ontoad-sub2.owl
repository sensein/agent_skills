		<skos:altLabel xml:lang="en">Statins</skos:altLabel>
		<skos:altLabel xml:lang="en">HMG-CoA Reductase Inhibitors</skos:altLabel>
		<skos:altLabel xml:lang="en">Inhibitors, Hydroxymethylglutaryl-Coenzyme A</skos:altLabel>
		<skos:altLabel xml:lang="en">Inhibitors, Hydroxymethylglutaryl-CoA</skos:altLabel>
		<skos:altLabel xml:lang="en">Hydroxymethylglutaryl-coenzyme A reductase inhibitor</skos:altLabel>
		<skos:altLabel xml:lang="en">Statins, HMG-CoA</skos:altLabel>
		<skos:altLabel xml:lang="en">HMG-CoA reductase inhibitor</skos:altLabel>
