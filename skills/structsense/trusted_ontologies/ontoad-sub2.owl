	<owl:Class rdf:about="&OntoAD;C0039902">
		<skos:prefLabel xml:lang="en">Thioguanine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Thioguanine</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Tioguanine</skos:prefLabel>
