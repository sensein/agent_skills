		<skos:altLabel xml:lang="en">DENTAL LOSS</skos:altLabel>
		<skos:altLabel xml:lang="en">Acquired edentia</skos:altLabel>
		<skos:altLabel xml:lang="fr">perte des dents</skos:altLabel>
		<skos:altLabel xml:lang="fr">Chute de dent</skos:altLabel>
		<skos:altLabel xml:lang="fr">Perte de dent</skos:altLabel>
		<skos:altLabel xml:lang="fr">absence acquise de dents</skos:altLabel>
		<skos:altLabel xml:lang="fr">perte acquise de dents</skos:altLabel>
		<skos:altLabel xml:lang="fr">perte naturelle des dents</skos:altLabel>
		<skos:altLabel xml:lang="fr">chute des dents</skos:altLabel>
		<skos:definition xml:lang="en">The failure to retain teeth as a result of disease or injury. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">L'échec de retenir les dents à la suite de la maladie ou de la blessure. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0040435"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0426481"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0040426"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0021430">
		<skos:prefLabel xml:lang="en">Informed Consent</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">InformedConsent</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Consentement libre et éclairé</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ConsentementLibreEtÉclairé</skos:hiddenLabel>
		<skos:altLabel xml:lang="fr">consentement éclairé</skos:altLabel>
		<skos:definition xml:lang="en">Voluntary authorization, by a patient or research subject, with full comprehension of the risks involved, for diagnostic or investigative procedures, and for medical and surgical treatment. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">http://info.cancer.ca/f/glossary/C/Consentement__clair_.htm (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1519022"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0019191">
		<skos:prefLabel xml:lang="en">Hepatitis, Infectious Canine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Hepatitis,InfectiousCanine</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Hépatite infectieuse du chien</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">HépatiteInfectieuseDuChien</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Canine adenovirus infection</skos:altLabel>
		<skos:altLabel xml:lang="en">Hepatitis contagiosa canis</skos:altLabel>
		<skos:altLabel xml:lang="en">ICH</skos:altLabel>
		<skos:altLabel xml:lang="en">Infectious canine hepatitis</skos:altLabel>
		<skos:altLabel xml:lang="en">HEPATITIS CANINE INFECT</skos:altLabel>
		<skos:altLabel xml:lang="fr">Hépatite contagieuse canine</skos:altLabel>
		<skos:altLabel xml:lang="fr">Hépatite de Rubarth</skos:altLabel>
		<skos:altLabel xml:lang="fr">Hépatite contagieuse du chien</skos:altLabel>
		<skos:altLabel xml:lang="fr">Hépatite virale du chien</skos:altLabel>
		<skos:altLabel xml:lang="fr">Maladie de Rubarth</skos:altLabel>
		<skos:altLabel xml:lang="fr">infection à adénovirus canin</skos:altLabel>
		<skos:definition xml:lang="en">A contagious disease caused by canine adenovirus (ADENOVIRUSES, CANINE) infecting the LIVER, the EYE, the KIDNEY, and other organs in dogs, other canids, and bears. Symptoms include FEVER; EDEMA; VOMITING; and DIARRHEA. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Infection à adénovirus entraînant de la fièvre, un oedème, des vomissements, de la diarrhée chez les chiens (plus particulièrement les chiots). Chez les renards, elle provoque une encéphalite aiguë avec convulsions, paralysie, coma et mort. (source : MSHFRE)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1290827"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0400905"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1290883"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:has_associated_morphology rdf:resource="&OntoAD;C0021368"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0010232">
		<skos:prefLabel xml:lang="en">Cowpox</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Cowpox</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Cowpox</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Cowpox</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">yaba</skos:altLabel>
		<skos:altLabel xml:lang="en">Cow Pox</skos:altLabel>
		<skos:altLabel xml:lang="fr">Vaccine</skos:altLabel>
		<skos:altLabel xml:lang="fr">Cow-pox</skos:altLabel>
		<skos:definition xml:lang="en">A mild, eruptive skin disease of milk cows caused by COWPOX VIRUS, with lesions occurring principally on the udder and teats. Human infection may occur while milking an infected animal. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Maladie virale bénigne survenant chez les vaches laitières due au cowpox virus, se manifestant par des éruptions cutanées localisées principalement au niveau de la mamelle et des trayons. L'homme peut se contaminer lors de la traite d'un animal infecté. (source : MSHFRE)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1532229"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0042210">
		<skos:prefLabel xml:lang="en">Vaccines</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Vaccines</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Vaccins</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Vaccins</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">vaccine</skos:altLabel>
		<skos:altLabel xml:lang="en">B6 VACCINES</skos:altLabel>
		<skos:definition xml:lang="en">Suspensions of killed or attenuated microorganisms (bacteria, viruses, fungi, protozoa, or rickettsiae), antigenic proteins derived from them, or synthetic constructs, administered for the prevention, amelioration, or treatment of infectious and other diseases. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr"> Solution injectable destinée à immuniser l'organisme contre un virus ou une bactérie. Il existe plusieurs sortes de vaccins : les vaccins vivants atténués : le germe contenu dans le vaccin est vivant mais incapable de provoquer la maladie (BCG, rougeole, rubéole, oreillons...) ; les vaccins préparés à partir de fragments de germes tués : les parties les plus immunisantes du virus ou de la bactérie sont utilisées pour préparer le vaccin (vaccins polio, antihépatite...) ; les vaccins contenant de (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2093625"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0005525"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0360485"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1630493"/>
		<OntoAD:direct_substance_of rdf:resource="&OntoAD;C0205991"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0042214">
		<skos:prefLabel xml:lang="en">Vaccinia</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Vaccinia</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Vaccine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Vaccine</skos:hiddenLabel>
		<skos:altLabel xml:lang="fr">Virus de la vaccine</skos:altLabel>
		<skos:definition xml:lang="en">The cutaneous and occasional systemic reactions associated with vaccination using smallpox (variola) vaccine. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Réactions cutanées et parfois généralisées, secondaires à une vaccination contre la variole (source : MSHFRE)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1532229"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0406050"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C1123023"/>
	</owl:Class>

