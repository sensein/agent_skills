		<skos:altLabel xml:lang="fr">Tumeur neuro-ectodermique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tumeurs neuro-ectodermiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">tumeur neuroectodermique périphérique</skos:altLabel>
		<skos:altLabel xml:lang="fr">tumeur neuroectodermique, SAI</skos:altLabel>
		<skos:altLabel xml:lang="fr">tumeur neuroectodermique périphérique primitive, SAI</skos:altLabel>
		<skos:altLabel xml:lang="fr">PPNET</skos:altLabel>
		<skos:definition xml:lang="en">Malignant neoplasms arising in the neuroectoderm, the portion of the ectoderm of the early embryo that gives rise to the central and peripheral nervous systems, including some glial cells. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0027654"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0206715"/>
