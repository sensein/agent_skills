		<skos:altLabel xml:lang="en">Contraceptive agent</skos:altLabel>
		<skos:altLabel xml:lang="en">birth control agent</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments contraceptifs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents contraceptifs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents de contraception</skos:altLabel>
		<skos:definition xml:lang="en">Chemical substances that prevent or reduce the probability of CONCEPTION. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1277062"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0003385">
		<skos:prefLabel xml:lang="en">Muscarinic Antagonists</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">MuscarinicAntagonists</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Antagonistes muscariniques</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AntagonistesMuscariniques</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Antimuscarinic Agents</skos:altLabel>
		<skos:altLabel xml:lang="en">Antimuscarinics</skos:altLabel>
		<skos:altLabel xml:lang="en">Antimuscarinic</skos:altLabel>
		<skos:altLabel xml:lang="en">Cholinergic Muscarinic Antagonist</skos:altLabel>
		<skos:altLabel xml:lang="en">MUSCARINIC ANTAG</skos:altLabel>
		<skos:altLabel xml:lang="en">Muscarinic Anticholinergic Antagonist</skos:altLabel>
		<skos:altLabel xml:lang="en">Muscarinic Anticholinesterase Antagonist</skos:altLabel>
		<skos:altLabel xml:lang="fr">Anti-muscariniques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Antimuscariniques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments antimuscariniques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents antimuscariniques</skos:altLabel>
		<skos:altLabel xml:lang="fr">antimuscarinique</skos:altLabel>
		<skos:definition xml:lang="en">Drugs that bind to but do not activate MUSCARINIC RECEPTORS, thereby blocking the actions of endogenous ACETYLCHOLINE or exogenous agonists. Muscarinic antagonists have widespread effects including actions on the iris and ciliary muscle of the eye, the heart and blood vessels, secretions of the respiratory tract, GI system, and salivary glands, GI motility, urinary bladder tone, and the central nervous system. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0242896"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C2697975">
		<skos:prefLabel xml:lang="en">Agent Affecting Organs of Special Senses</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AgentAffectingOrgansOfSpecialSenses</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Agent Affecting the Visual, Auditory, Olfactory or Gustatory System</skos:altLabel>
		<skos:altLabel xml:lang="en">Agent Affecting Ears, Eyes ande</skos:altLabel>
		<skos:definition xml:lang="en">An agent that exerts a physiologic effect on the organs of special senses, including the eyes, ears and nose. This category includes otic, nasal and ophthalmic agents. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1254351"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1513783">
		<skos:prefLabel xml:lang="en">Mydriatic Agent</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">MydriaticAgent</skos:hiddenLabel>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2697975"/>
	</owl:Class>

