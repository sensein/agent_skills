	<owl:Class rdf:about="&OntoAD;C0014239">
		<skos:prefLabel xml:lang="en">Endoplasmic Reticulum</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">EndoplasmicReticulum</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Réticulum endoplasmique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">RéticulumEndoplasmique</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Ergastoplasm</skos:altLabel>
		<skos:altLabel xml:lang="en">Reticulum cytoplasmaticum</skos:altLabel>
		<skos:altLabel xml:lang="en">Reticulum endoplasmicum</skos:altLabel>
		<skos:altLabel xml:lang="en">endoplasmic reticulum (ER)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Ergastoplasme</skos:altLabel>
		<skos:altLabel xml:lang="fr">RE (Réticulum Endoplasmique)</skos:altLabel>
		<skos:altLabel xml:lang="fr">réticulum endoplasmique, SAI</skos:altLabel>
		<skos:altLabel xml:lang="fr">aggrégat de REG, SAI</skos:altLabel>
		<skos:altLabel xml:lang="fr">granule de Nissl</skos:altLabel>
		<skos:altLabel xml:lang="fr">substance de Nissl</skos:altLabel>
		<skos:definition xml:lang="en">A system of cisternae in the CYTOPLASM of many cells. In places the endoplasmic reticulum is continuous with the plasma membrane (CELL MEMBRANE) or outer membrane of the nuclear envelope. If the outer surfaces of the endoplasmic reticulum membranes are coated with ribosomes, the endoplasmic reticulum is said to be rough-surfaced (ENDOPLASMIC RETICULUM, ROUGH); otherwise it is said to be smooth-surfaced (ENDOPLASMIC RETICULUM, SMOOTH). (King and Stansfield, A Dictionary of Genetics, 4th ed) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1523869"/>
		<OntoAD:is_associated_anatomy_of_gene_product rdf:resource="&OntoAD;C0389003"/>
		<OntoAD:anatomic_structure_is_physical_part_of rdf:resource="&OntoAD;C0007634"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0027752">
		<skos:prefLabel xml:lang="en">Nerve Growth Factor 1</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">NerveGrowthFactor1</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Facteur de croissance nerveux</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">FacteurDeCroissanceNerveux</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Nerve Growth Factor</skos:altLabel>
		<skos:altLabel xml:lang="en">NGF</skos:altLabel>
		<skos:altLabel xml:lang="en">NERVE GROWTH FACTOR A 001</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteur de croissance du tissu nerveux</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteur de croissance NGF</skos:altLabel>
		<skos:altLabel xml:lang="fr">NGF (Nerve Growth Factor)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteur de croissance nerveuse</skos:altLabel>
		<skos:altLabel xml:lang="fr">FCN (Facteur de Croissance Nerveuse)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteur de croissance neurale</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteur de croissance-1 nerveux</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteur-1 de croissance nerveuse</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteur de croissance des nerfs</skos:altLabel>
		<skos:definition xml:lang="en">NERVE GROWTH FACTOR is the first of a series of neurotrophic factors that were found to influence the growth and differentiation of sympathetic and sensory neurons. It is comprised of alpha, beta, and gamma subunits. The beta subunit is responsible for its growth stimulating activity. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0132298"/>
