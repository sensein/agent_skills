	<owl:Class rdf:about="&OntoAD;C0199230">
		<skos:prefLabel xml:lang="en">Screening for cancer</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">ScreeningForCancer</skos:hiddenLabel>
