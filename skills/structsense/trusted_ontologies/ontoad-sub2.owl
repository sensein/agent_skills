	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0034019">
		<skos:prefLabel xml:lang="en">public health medicine (field)</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">PublicHealthMedicine(field)</skos:hiddenLabel>
