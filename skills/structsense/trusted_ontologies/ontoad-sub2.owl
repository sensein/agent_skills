		<skos:definition xml:lang="en">This gene may be involved in immunity, lipid metabolism and apoptosis. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1336818"/>
		<OntoAD:gene_associated_with_disease rdf:resource="&OntoAD;C0002395"/>
