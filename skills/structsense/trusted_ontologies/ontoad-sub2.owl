		<skos:altLabel xml:lang="en">LAV</skos:altLabel>
		<skos:altLabel xml:lang="en">Lymphadenopathy-associated virus, type I (LAV-I)</skos:altLabel>
		<skos:altLabel xml:lang="en">Lymphadenopathy-associated virus (LAV)</skos:altLabel>
		<skos:altLabel xml:lang="en">Human T-lymphotropic virus, type III (HTLV-III)</skos:altLabel>
		<skos:altLabel xml:lang="en">Human immunodeficiency virus</skos:altLabel>
		<skos:altLabel xml:lang="en">Acquired Immune Deficiency Syndrome Virus</skos:altLabel>
		<skos:altLabel xml:lang="en">Acquired Immunodeficiency Syndrome Virus</skos:altLabel>
		<skos:altLabel xml:lang="en">Virus-HIV</skos:altLabel>
		<skos:altLabel xml:lang="en">HUMAN IMMUNODEFIC VIRUSES</skos:altLabel>
		<skos:altLabel xml:lang="en">HTLV WIII</skos:altLabel>
		<skos:altLabel xml:lang="en">HUMAN LYMPHOTROPIC VIRUS TYPE III A T</skos:altLabel>
		<skos:altLabel xml:lang="fr">HTLV-III</skos:altLabel>
		<skos:altLabel xml:lang="fr">LAV-HTLV-III</skos:altLabel>
		<skos:altLabel xml:lang="fr">Human immunodeficiency virus</skos:altLabel>
		<skos:altLabel xml:lang="fr">Human T-lymphotropic virus type III</skos:altLabel>
		<skos:altLabel xml:lang="fr">LAV (Lymphadenopathy-Associated Virus)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Virus du SIDA</skos:altLabel>
		<skos:altLabel xml:lang="fr">Virus de l'immunodéficience humaine</skos:altLabel>
		<skos:altLabel xml:lang="fr">Virus du syndrome d'immunodéficience acquise</skos:altLabel>
		<skos:altLabel xml:lang="fr">Acquired immunodeficiency syndrome virus</skos:altLabel>
		<skos:altLabel xml:lang="fr">Lymphadenopathy-associated virus</skos:altLabel>
		<skos:altLabel xml:lang="fr">AIDS virus</skos:altLabel>
		<skos:altLabel xml:lang="fr">Human T-cell leukemia virus type III</skos:altLabel>
		<skos:altLabel xml:lang="fr">HIV (Human Immunodeficiency Virus)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Virus associé à la lymphadénopathie</skos:altLabel>
		<skos:altLabel xml:lang="fr">Virus de la leucémie T humaine de type III</skos:altLabel>
		<skos:altLabel xml:lang="fr">Virus de la leucémie humaine à cellules T de type III</skos:altLabel>
		<skos:altLabel xml:lang="fr">Virus T-lymphotrope humain de type III</skos:altLabel>
		<skos:altLabel xml:lang="fr">VIH</skos:altLabel>
		<skos:definition xml:lang="en">Human immunodeficiency virus. A non-taxonomic and historical term referring to any of two species, specifically HIV-1 and/or HIV-2. Prior to 1986, this was called human T-lymphotropic virus type III/lymphadenopathy-associated virus (HTLV-III/LAV). From 1986-1990, it was an official species called HIV. Since 1991, HIV was no longer considered an official species name; the two species were designated HIV-1 and HIV-2. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0206438"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0019340"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0042798"/>
