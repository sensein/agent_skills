		<OntoAD:interprets rdf:resource="&OntoAD;C0042789"/>
		<OntoAD:manifestation_of rdf:resource="&OntoAD;C0003076"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0019682"/>
	</owl:Class>

