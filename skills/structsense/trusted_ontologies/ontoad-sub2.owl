		<skos:altLabel xml:lang="en">Anxiolytic Agents</skos:altLabel>
		<skos:altLabel xml:lang="en">Tranquilizing Agents, Minor</skos:altLabel>
		<skos:altLabel xml:lang="en">Anti-Anxiety Drugs</skos:altLabel>
		<skos:altLabel xml:lang="en">Anxiolytics</skos:altLabel>
		<skos:altLabel xml:lang="en">minor tranquilizer</skos:altLabel>
		<skos:altLabel xml:lang="en">MISCELLANEOUS ANXIOLYTICS</skos:altLabel>
		<skos:altLabel xml:lang="en">anti-agents</skos:altLabel>
		<skos:altLabel xml:lang="en">antianxiety tranquilizers</skos:altLabel>
		<skos:altLabel xml:lang="en">Anxiolytic agent</skos:altLabel>
		<skos:altLabel xml:lang="en">Anxiolytic</skos:altLabel>
		<skos:altLabel xml:lang="en">Antianxiety Agent</skos:altLabel>
		<skos:altLabel xml:lang="en">Antianxiety Drugs</skos:altLabel>
		<skos:altLabel xml:lang="en">Minor Tanquilizer</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tranquillisants mineurs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents anxiolytiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments anxiolytiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">agent anxiolytique</skos:altLabel>
		<skos:definition xml:lang="en">Agents that alleviate ANXIETY, tension, and ANXIETY DISORDERS, promote sedation, and have a calming effect without affecting clarity of consciousness or neurologic conditions. ADRENERGIC BETA-ANTAGONISTS are commonly used in the symptomatic treatment of anxiety but are not included here. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2697973"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1268921"/>
	</owl:Class>

