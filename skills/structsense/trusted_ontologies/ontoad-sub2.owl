		<skos:altLabel xml:lang="en">Anepia</skos:altLabel>
		<skos:altLabel xml:lang="en">Logagnosia</skos:altLabel>
		<skos:altLabel xml:lang="en">Logamnesia</skos:altLabel>
		<skos:altLabel xml:lang="en">Logasthenia</skos:altLabel>
		<skos:altLabel xml:lang="en">Logamnesias</skos:altLabel>
		<skos:altLabel xml:lang="en">Logasthenias</skos:altLabel>
		<skos:altLabel xml:lang="en">Alogias</skos:altLabel>
		<skos:altLabel xml:lang="en">Anepias</skos:altLabel>
		<skos:altLabel xml:lang="en">inability to understand or express language</skos:altLabel>
		<skos:altLabel xml:lang="fr">aphasies</skos:altLabel>
		<skos:altLabel xml:lang="fr">Alogie</skos:altLabel>
		<skos:altLabel xml:lang="fr">Logagnosie</skos:altLabel>
		<skos:altLabel xml:lang="fr">trouble aphasique</skos:altLabel>
		<skos:altLabel xml:lang="fr">perte de la capacité d'expression ou de compréhension</skos:altLabel>
		<skos:altLabel xml:lang="fr">aphasique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Aphasie récente, régressive dans les 24 heures</skos:altLabel>
		<skos:definition xml:lang="en">A cognitive disorder marked by an impaired ability to comprehend or express language in its written or spoken form. This condition is caused by diseases which affect the language areas of the dominant hemisphere. Clinical features are used to classify the various subtypes of this condition. General categories include receptive, expressive, and mixed forms of aphasia. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">http://www.orpha.net/gor/cgi-bin//OGmain.php?Lng=FRetTyp=IdentetVal=26.0 (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1457887"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0038454"/>
		<OntoAD:manifestation_of rdf:resource="&OntoAD;C0022336"/>
	</owl:Class>

