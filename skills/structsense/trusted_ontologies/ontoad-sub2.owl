		<skos:altLabel xml:lang="en">N2  Nitrogen</skos:altLabel>
		<skos:altLabel xml:lang="en">N element</skos:altLabel>
		<skos:altLabel xml:lang="en">N2 element</skos:altLabel>
		<skos:definition xml:lang="en">An element with the atomic symbol N, atomic number 7, and atomic weight [14.00643; 14.00728]. Nitrogen exists as a diatomic gas and makes up about 78% of the earth's atmosphere by volume. It is a constituent of proteins and nucleic acids and found in all living cells. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0013879"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0232804"/>
	</owl:Class>

