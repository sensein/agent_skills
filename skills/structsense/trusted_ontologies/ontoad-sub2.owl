		<skos:altLabel xml:lang="fr">ischémique</skos:altLabel>
		<skos:definition xml:lang="en">A hypoperfusion of the BLOOD through an organ or tissue caused by a PATHOLOGIC CONSTRICTION or obstruction of its BLOOD VESSELS, or an absence of BLOOD CIRCULATION. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">http://www.orpha.net/gor/cgi-bin//OGmain.php?Lng=FRetTyp=IdentetVal=209.0 (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0232352"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0005847"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
