		<OntoAD:has_physical_part_of_anatomic_structure rdf:resource="&OntoAD;C0229671"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0221198">
		<skos:prefLabel xml:lang="en">Lesion</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Lesion</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">lésions</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Lésions</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">lesions</skos:altLabel>
		<skos:altLabel xml:lang="en">Visible Lesion</skos:altLabel>
		<skos:altLabel xml:lang="fr">lésion</skos:altLabel>
		<skos:definition xml:lang="en">An area of abnormal tissue. A lesion may be benign (not cancer) or malignant (cancer). (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;Finding"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0001175"/>
		<OntoAD:replaced_by rdf:resource="&OntoAD;C0332447"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0009247">
		<skos:prefLabel xml:lang="en">Cohort Studies</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CohortStudies</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Études de cohorte</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ÉtudesDeCohorte</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">cohort study</skos:altLabel>
		<skos:altLabel xml:lang="en">incidence studies</skos:altLabel>
		<skos:altLabel xml:lang="en">Cohort</skos:altLabel>
		<skos:altLabel xml:lang="en">Concurrent Studies</skos:altLabel>
		<skos:altLabel xml:lang="en">COHORT ANALYTIC STUDY</skos:altLabel>
		<skos:altLabel xml:lang="fr">étude de cohorte</skos:altLabel>
		<skos:altLabel xml:lang="fr">Études cohorte</skos:altLabel>
		<skos:definition xml:lang="en">Studies in which subsets of a defined population are identified. These groups may or may not be exposed to factors hypothesized to influence the probability of the occurrence of a particular disease or other outcome. Cohorts are defined populations which, as a whole, are followed in an attempt to determine distinguishing subgroup characteristics. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">études dans lesquelles les sous-ensembles d'une population définie sont identifiés. Ces groupes peuvent ou pouvoir ne pas être exposés aux facteurs hypothétiques pour influencer les chances de l'occurrence d'une maladie particulière ou d'autre résultat. Les cohortes sont des populations définies qui, en masse, sont suivies dans un essai de déterminer la distinction des caractéristiques de sous-groupe. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0023981"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0460148">
		<skos:prefLabel xml:lang="en">Human body structure</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">HumanBodyStructure</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Human body</skos:altLabel>
		<skos:altLabel xml:lang="en">Body structures</skos:altLabel>
		<skos:altLabel xml:lang="en">Body</skos:altLabel>
		<skos:definition xml:lang="en">Anatomical structure which is the aggregate material substance of an individual member of a species (source : FMA)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;AnatomicalStructure"/>
		<OntoAD:has_constitutional_part rdf:resource="&OntoAD;C0927232"/>
		<OntoAD:has_constitutional_part rdf:resource="&OntoAD;C1123023"/>
		<OntoAD:has_systemic_part rdf:resource="&OntoAD;C0035237"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1268086">
		<skos:prefLabel xml:lang="en">Body structure</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">BodyStructure</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Body</skos:altLabel>
		<skos:definition xml:lang="en">The entire physical structure of an organism. It is composed of anatomic systems, regions, cavities, and spaces. (NCI) (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;AnatomicalStructure"/>
	</owl:Class>

