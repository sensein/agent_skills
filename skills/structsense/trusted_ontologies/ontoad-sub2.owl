		<skos:altLabel xml:lang="fr">Voie métabolique</skos:altLabel>
		<skos:definition xml:lang="en">An elaboration of the known steps and interactions for the metabolism of a compound. (source : NCI)</skos:definition>
		<skos:definition xml:lang="fr">ensembles complexes enzymatiques les réactions raccordées l'un à l'autre via leur produit et substrat métabolites. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1704259"/>
	</owl:Class>

