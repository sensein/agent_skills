	<owl:Class rdf:about="&OntoAD;C0040132">
		<skos:prefLabel xml:lang="en">Thyroid Gland</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">ThyroidGland</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Glande thyroide</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">GlandeThyroide</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Thyroid</skos:altLabel>
		<skos:altLabel xml:lang="en">Glandula thyroidea</skos:altLabel>
		<skos:altLabel xml:lang="en">Thyroid structure</skos:altLabel>
		<skos:altLabel xml:lang="en">B6 THYROID GLAND</skos:altLabel>
		<skos:altLabel xml:lang="en">Head and Neck, Thyroid</skos:altLabel>
		<skos:altLabel xml:lang="fr">Thyroide</skos:altLabel>
		<skos:altLabel xml:lang="fr">Corps thyroïde</skos:altLabel>
		<skos:altLabel xml:lang="fr">glande thyroïde, SAI</skos:altLabel>
		<skos:altLabel xml:lang="fr">thyroïde, SAI</skos:altLabel>
		<skos:definition xml:lang="en">A highly vascularized endocrine gland consisting of two lobes joined by a thin band of tissue with one lobe on each side of the TRACHEA. It secretes THYROID HORMONES from the follicular cells and CALCITONIN from the parafollicular cells thereby regulating METABOLISM and CALCIUM level in blood, respectively. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0574117"/>
