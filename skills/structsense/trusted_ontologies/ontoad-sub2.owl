		<skos:altLabel xml:lang="en">hexose metabolism</skos:altLabel>
		<skos:definition xml:lang="en">The chemical reactions and pathways involving a hexose, any monosaccharide with a chain of six carbon atoms in the molecule. [ISBN:0198506732 'Oxford Dictionary of Biochemistry and Molecular Biology'] (source : GO)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1156447"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1145676">
