		<skos:altLabel xml:lang="fr">orphelin/orpheline</skos:altLabel>
		<skos:definition xml:lang="en">Child who has lost both parents through death or desertion. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0026193"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0041190">
		<skos:prefLabel xml:lang="en">Tropicamide</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Tropicamide</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Tropicamide</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Tropicamide</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">N-Ethyl-N-(4-pyridylmethyl)tropamide</skos:altLabel>
		<skos:altLabel xml:lang="en">N-Ethyl-alpha-(hydroxymethyl)-N-(4-pyridinylmethyl)benzeneacetamide</skos:altLabel>
		<skos:altLabel xml:lang="en">Bistropamide</skos:altLabel>
		<skos:altLabel xml:lang="en">N-Ethyl-2-phenyl-N-(4-pyridylmethyl)hydracrylamide</skos:altLabel>
		<skos:altLabel xml:lang="en">Tropimil</skos:altLabel>
		<skos:altLabel xml:lang="en">mydriatics tropicamide</skos:altLabel>
		<skos:altLabel xml:lang="fr">bistropamide</skos:altLabel>
		<skos:definition xml:lang="en">One of the MUSCARINIC ANTAGONISTS with pharmacologic action similar to ATROPINE and used mainly as an ophthalmic parasympatholytic or mydriatic. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003385"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0010586"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1444689"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0026964"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1262869">
		<skos:prefLabel xml:lang="en">Body position</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">BodyPosition</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Posture</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Posture</skos:hiddenLabel>
