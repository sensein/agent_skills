		<skos:altLabel xml:lang="en">Nicotinamide-Adenine Dinucleotide</skos:altLabel>
		<skos:altLabel xml:lang="en">Nadide</skos:altLabel>
		<skos:altLabel xml:lang="en">Adenosine 5'-(trihydrogen diphosphate), P'-5'-ester with 3-(aminocarbonyl)-1-beta-D-ribofuranosylpyr</skos:altLabel>
		<skos:altLabel xml:lang="en">Nicotinamide adenine dinucleotide</skos:altLabel>
		<skos:altLabel xml:lang="en">COENZYME A A 01</skos:altLabel>
		<skos:altLabel xml:lang="en">Codehydrogenase I</skos:altLabel>
		<skos:altLabel xml:lang="en">Adenosine 5'-(Trihydrogen Diphosphate), 5'-5'-Ester with 3-(Aminocarbonyl)-1-.Beta.-D-Ribofuranosylp</skos:altLabel>
		<skos:altLabel xml:lang="en">Cozymase</skos:altLabel>
		<skos:altLabel xml:lang="en">Co-I</skos:altLabel>
		<skos:altLabel xml:lang="fr">Nicotinamide adénine dinucléotide</skos:altLabel>
		<skos:definition xml:lang="en">A coenzyme composed of ribosylnicotinamide 5'-diphosphate coupled to adenosine 5'-phosphate by pyrophosphate linkage. It is found widely in nature and is involved in numerous enzymatic reactions in which it serves as an electron carrier by being alternately oxidized (NAD+) and reduced (NADH). (Dorland, 27th ed) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0242295"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0028630"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0034137"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0021755">
		<skos:prefLabel xml:lang="en">Interleukin-1</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Interleukin-1</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Interleukine-1</skos:prefLabel>
