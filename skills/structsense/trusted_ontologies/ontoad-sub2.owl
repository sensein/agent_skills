		<skos:hiddenLabel xml:lang="en">MalignantTumorOfColon</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Cancer du côlon</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">CancerDuCôlon</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Colorectal cancer</skos:altLabel>
		<skos:altLabel xml:lang="en">Malignant neoplasm of colon,</skos:altLabel>
		<skos:altLabel xml:lang="en">Cancer of Colon</skos:altLabel>
		<skos:altLabel xml:lang="en">CA  Cancer of colon</skos:altLabel>
		<skos:altLabel xml:lang="en">Colonic Cancer</skos:altLabel>
		<skos:altLabel xml:lang="en">Malig neop of colon</skos:altLabel>
		<skos:altLabel xml:lang="en">Malignant neoplasm of colon</skos:altLabel>
		<skos:altLabel xml:lang="en">Colon</skos:altLabel>
		<skos:altLabel xml:lang="en">Ca colon</skos:altLabel>
		<skos:altLabel xml:lang="en">Malignant neoplasm of colon part</skos:altLabel>
		<skos:altLabel xml:lang="en">Malignant Colonic Tumor</skos:altLabel>
		<skos:altLabel xml:lang="en">Colonic neoplasms malignant</skos:altLabel>
		<skos:altLabel xml:lang="en">Malignant neo colon</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tumeur maligne colique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tumeurs malignes du côlon</skos:altLabel>
		<skos:altLabel xml:lang="fr">Cancer colique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tumeur maligne du côlon</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tumeur maligne du côlon, sans précision</skos:altLabel>
		<skos:definition xml:lang="en">A primary or metastatic malignant neoplasm involving the colon. (source : NCI)</skos:definition>
		<skos:definition xml:lang="fr">http://info.cancer.ca/f/glossary/C/Cancer_du_c_lon.htm (source : CISMeF)</skos:definition>
