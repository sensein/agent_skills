		<skos:hiddenLabel xml:lang="en">Anxiolytic,SedativeAND/ORHypnotic</skos:hiddenLabel>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0033978"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0003015">
		<skos:prefLabel xml:lang="en">Angiotensin-Converting Enzyme Inhibitors</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Angiotensin-ConvertingEnzymeInhibitors</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Inhibiteurs de l'enzyme de conversion de l'angiotensine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">InhibiteursDeL'enzymeDeConversionDeL'angiotensine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Antagonists, Angiotensin-Converting Enzyme</skos:altLabel>
		<skos:altLabel xml:lang="en">Angiotensin I-Converting Enzyme Inhibitors</skos:altLabel>
		<skos:altLabel xml:lang="en">Kininase II Antagonists</skos:altLabel>
		<skos:altLabel xml:lang="en">Kininase II Inhibitors</skos:altLabel>
		<skos:altLabel xml:lang="en">ACE Inhibitors</skos:altLabel>
		<skos:altLabel xml:lang="en">Angiotensin-converting enzyme inhibitor agent</skos:altLabel>
		<skos:altLabel xml:lang="en">Angiotensin-converting Enzyme (ACE) Inhibitors</skos:altLabel>
		<skos:altLabel xml:lang="en">ANGIOTENSIN CONVERTING ENZYME ANTAG</skos:altLabel>
		<skos:altLabel xml:lang="en">KININASE II ANTAG</skos:altLabel>
		<skos:altLabel xml:lang="en">INHIB KININASE II</skos:altLabel>
		<skos:altLabel xml:lang="en">INHIB ANGIOTENSIN CONVERTING ENZYME</skos:altLabel>
		<skos:altLabel xml:lang="en">ANGIOTENSIN I CONVERTING ENZYME INHIB</skos:altLabel>
		<skos:altLabel xml:lang="en">ACE INHIB</skos:altLabel>
		<skos:altLabel xml:lang="en">Angiotensin Converting Enzyme Inhibitor</skos:altLabel>
		<skos:altLabel xml:lang="fr">Inhibiteurs ACE</skos:altLabel>
		<skos:altLabel xml:lang="fr">Inhibiteurs ECA</skos:altLabel>
		<skos:altLabel xml:lang="fr">Inhibiteurs de l'angiotensin converting enzyme</skos:altLabel>
		<skos:altLabel xml:lang="fr">Inhibiteurs de l'enzyme de conversion</skos:altLabel>
		<skos:altLabel xml:lang="fr">Inhibiteurs de la kininase II</skos:altLabel>
		<skos:altLabel xml:lang="fr">IEC (Inhibiteurs de l'Enzyme de Conversion)</skos:altLabel>
		<skos:altLabel xml:lang="fr">inhibiteur de l'enzyme de conversion de l'angiotensine</skos:altLabel>
		<skos:altLabel xml:lang="fr">inhibiteur ECA</skos:altLabel>
		<skos:definition xml:lang="en">A class of drugs whose main indications are the treatment of hypertension and heart failure. They exert their hemodynamic effect mainly by inhibiting the renin-angiotensin system. They also modulate sympathetic nervous system activity and increase prostaglandin synthesis. They cause mainly vasodilation and mild natriuresis without affecting heart rate and contractility. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003364"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0919438"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0054861">
		<skos:prefLabel xml:lang="en">Catecholamine Receptors</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CatecholamineReceptors</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Récepteurs catécholaminergiques</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">RécepteursCatécholaminergiques</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Catecholamine receptor site,</skos:altLabel>
		<skos:altLabel xml:lang="en">Catecholamine receptor</skos:altLabel>
		<skos:altLabel xml:lang="en">CATECHOLAMINE RECEPT</skos:altLabel>
		<skos:altLabel xml:lang="en">Receptors, Catecholamine</skos:altLabel>
		<skos:altLabel xml:lang="fr">Récepteur catécholamine</skos:altLabel>
		<skos:altLabel xml:lang="fr">Récepteurs aux catécholamines</skos:altLabel>
		<skos:altLabel xml:lang="fr">Récepteurs des catécholamines</skos:altLabel>
		<skos:altLabel xml:lang="fr">récepteur de la catécholamine</skos:altLabel>
		<skos:definition xml:lang="en">Cell surface proteins that bind catecholamines with high affinity and trigger intracellular changes which influence the behavior of cells. The catecholamine messengers epinephrine, norepinephrine, and dopamine are synthesized from tyrosine by a common biosynthetic pathway. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0597357"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0034784">
		<skos:prefLabel xml:lang="en">alpha-adrenergic receptor</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Alpha-adrenergicReceptor</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Récepteurs alpha-adrénergiques</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">RécepteursAlpha-adrénergiques</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">alpha-Adrenergic receptor site</skos:altLabel>
		<skos:altLabel xml:lang="en">ALPHA ADREN RECEPT</skos:altLabel>
		<skos:altLabel xml:lang="en">Receptors, Adrenergic, alpha</skos:altLabel>
		<skos:altLabel xml:lang="fr">récepteur adrénergique alpha</skos:altLabel>
		<skos:definition xml:lang="en">One of the two major pharmacological subdivisions of adrenergic receptors that were originally defined by the relative potencies of various adrenergic compounds. The alpha receptors were initially described as excitatory receptors that post-junctionally stimulate SMOOTH MUSCLE contraction. However, further analysis has revealed a more complex picture involving several alpha receptor subtypes and their involvement in feedback regulation. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0054861"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0682972"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0597357"/>
		<OntoAD:gene_product_has_associated_anatomy rdf:resource="&OntoAD;C0007603"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1334396"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1335671"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0242210"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0682972">
		<skos:prefLabel xml:lang="en">G-Protein-Coupled Receptors</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">G-Protein-CoupledReceptors</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Récepteurs couplés aux protéines G</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">RécepteursCouplésAuxProtéinesG</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">G-protein-associated receptor</skos:altLabel>
		<skos:altLabel xml:lang="en">G Protein-Complex Receptor</skos:altLabel>
		<skos:altLabel xml:lang="en">GPCR</skos:altLabel>
		<skos:altLabel xml:lang="en">G PROTEIN COUPLED RECEPT</skos:altLabel>
		<skos:altLabel xml:lang="en">Receptors, G-Protein-Coupled</skos:altLabel>
		<skos:altLabel xml:lang="fr">RCPG</skos:altLabel>
		<skos:definition xml:lang="en">The largest family of cell surface receptors involved in SIGNAL TRANSDUCTION. They share a common structure and signal through HETEROTRIMERIC G-PROTEINS. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0597357"/>
		<OntoAD:is_biochemical_function_of_gene_product rdf:resource="&OntoAD;C0291339"/>
		<OntoAD:is_biochemical_function_of_gene_product rdf:resource="&OntoAD;C0389726"/>
		<OntoAD:is_biochemical_function_of_gene_product rdf:resource="&OntoAD;C0391398"/>
		<OntoAD:gene_product_has_associated_anatomy rdf:resource="&OntoAD;C0007603"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1334396"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1335671"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0242210"/>
	</owl:Class>

