		<skos:altLabel xml:lang="fr">Vaisseau rétinien</skos:altLabel>
		<skos:altLabel xml:lang="fr">Vaisseau sanguin rétinien</skos:altLabel>
		<skos:altLabel xml:lang="fr">Vaisseaux sanguins rétiniens</skos:altLabel>
