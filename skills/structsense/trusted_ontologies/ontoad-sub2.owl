	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0553604">
		<skos:prefLabel xml:lang="en">Myotonic Disorders</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">MyotonicDisorders</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Troubles myotoniques</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">TroublesMyotoniques</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Myotonic disease or syndrome</skos:altLabel>
		<skos:altLabel xml:lang="en">Myotonic Diseases and Syndromes</skos:altLabel>
		<skos:altLabel xml:lang="en">Myopathies, Myotonic</skos:altLabel>
