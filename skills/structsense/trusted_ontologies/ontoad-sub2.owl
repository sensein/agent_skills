	<owl:Class rdf:about="&OntoAD;C0078944">
		<skos:prefLabel xml:lang="en">Patient-Controlled Analgesia</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Patient-ControlledAnalgesia</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Analgésie autocontrôlée</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AnalgésieAutocontrôlée</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">PCA</skos:altLabel>
		<skos:altLabel xml:lang="en">PCA  Pt controlled analgesia</skos:altLabel>
		<skos:altLabel xml:lang="en">PCA  Patient controlled analgesia</skos:altLabel>
		<skos:altLabel xml:lang="en">Patient controlled analgesia</skos:altLabel>
		<skos:altLabel xml:lang="fr">Analgésie auto-contrôlée</skos:altLabel>
		<skos:altLabel xml:lang="fr">AAC (Analgésie Autocontrôlée)</skos:altLabel>
		<skos:altLabel xml:lang="fr">ACP (Analgésie Contrôlée par le Patient)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Analgésie contrôlée par le patient</skos:altLabel>
		<skos:definition xml:lang="en">Relief of PAIN, without loss of CONSCIOUSNESS, through ANALGESIC AGENTS administered by the patients. It has been used successfully to control POSTOPERATIVE PAIN, during OBSTETRIC LABOR, after BURNS, and in TERMINAL CARE. The choice of agent, dose, and lockout interval greatly influence effectiveness. The potential for overdose can be minimized by combining small bolus doses with a mandatory interval between successive doses (lockout interval). (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0262176"/>
		<OntoAD:has_direct_substance rdf:resource="&OntoAD;C0002771"/>
	</owl:Class>

