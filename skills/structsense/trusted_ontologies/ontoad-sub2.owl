		<skos:altLabel xml:lang="en">trust</skos:altLabel>
		<skos:definition xml:lang="en">A feeling of trust (in someone or something). (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;MentalProcess"/>
		<OntoAD:biological_process_has_associated_location rdf:resource="&OntoAD;C0006104"/>
