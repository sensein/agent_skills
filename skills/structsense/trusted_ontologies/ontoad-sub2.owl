	<owl:Class rdf:about="&OntoAD;C0034821">
		<skos:prefLabel xml:lang="en">Low Density Lipoprotein Receptor</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">LowDensityLipoproteinReceptor</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Récepteurs aux lipoprotéines LDL</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">RécepteursAuxLipoprotéinesLDL</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Lipoprotein LDL Receptors</skos:altLabel>
		<skos:altLabel xml:lang="en">Receptors, LDL</skos:altLabel>
		<skos:altLabel xml:lang="en">LDL receptor site</skos:altLabel>
		<skos:altLabel xml:lang="en">LDLR</skos:altLabel>
		<skos:altLabel xml:lang="en">LDL receptor</skos:altLabel>
		<skos:altLabel xml:lang="en">Low density lipoprotein (LDL) receptor</skos:altLabel>
		<skos:altLabel xml:lang="en">LDL RECEPT LIPOPROTEIN</skos:altLabel>
		<skos:altLabel xml:lang="en">LDL RECEPT</skos:altLabel>
		<skos:altLabel xml:lang="en">LOW DENSITY LIPOPROTEIN RECEPT</skos:altLabel>
		<skos:altLabel xml:lang="fr">Récepteurs aux lipoprotéines de faible densité</skos:altLabel>
		<skos:altLabel xml:lang="fr">Récepteurs aux lipoprotéines de basse densité</skos:altLabel>
		<skos:altLabel xml:lang="fr">Récepteurs des lipoprotéines LDL</skos:altLabel>
		<skos:altLabel xml:lang="fr">Récepteurs LDLR</skos:altLabel>
		<skos:altLabel xml:lang="fr">Récepteurs aux LDL</skos:altLabel>
		<skos:altLabel xml:lang="fr">Récepteurs des LDL</skos:altLabel>
		<skos:altLabel xml:lang="fr">récepteur des LDL</skos:altLabel>
		<skos:definition xml:lang="en">Receptors on the plasma membrane of nonhepatic cells that specifically bind LDL. The receptors are localized in specialized regions called coated pits. Hypercholesteremia is caused by an allelic genetic defect of three types: 1, receptors do not bind to LDL; 2, there is reduced binding of LDL; and 3, there is normal binding but no internalization of LDL. In consequence, entry of cholesterol esters into the cell is impaired and the intracellular feedback by cholesterol on 3-hydroxy-3-methylglutar (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0034800"/>
		<OntoAD:gene_product_has_associated_anatomy rdf:resource="&OntoAD;C0007603"/>
		<OntoAD:gene_product_has_organism_source rdf:resource="&OntoAD;C0086418"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1334396"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1335671"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0242210"/>
	</owl:Class>

