		<skos:altLabel xml:lang="en">FISH Technique</skos:altLabel>
		<skos:altLabel xml:lang="en">fluorescent in situ hybridization (FISH)</skos:altLabel>
		<skos:altLabel xml:lang="en">FISH test</skos:altLabel>
		<skos:altLabel xml:lang="en">FISH  fluorescence in situ hybridization</skos:altLabel>
