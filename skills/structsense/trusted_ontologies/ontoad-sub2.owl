		<skos:altLabel xml:lang="en">CD49f Antigens</skos:altLabel>
		<skos:altLabel xml:lang="en">CD49f</skos:altLabel>
		<skos:altLabel xml:lang="en">CD49f  Cluster of diff ag 49f</skos:altLabel>
		<skos:altLabel xml:lang="en">CD49f  Cluster of differentiation antigen 49f</skos:altLabel>
		<skos:altLabel xml:lang="en">Cluster of diff antigen 49f</skos:altLabel>
		<skos:altLabel xml:lang="en">Cluster of differentiation antigen 49f</skos:altLabel>
		<skos:altLabel xml:lang="en">VLA-6  V late activ-6 a-chain</skos:altLabel>
		<skos:altLabel xml:lang="en">VLA-6  Very late activation-6 alpha chain</skos:altLabel>
		<skos:altLabel xml:lang="en">Very late activ-6 alpha chain</skos:altLabel>
		<skos:altLabel xml:lang="en">Very late activation-6 alpha chain</skos:altLabel>
		<skos:altLabel xml:lang="en">Lymphocyte antigen CD49F</skos:altLabel>
		<skos:altLabel xml:lang="en">INTEGRIN ALPHA A 06</skos:altLabel>
		<skos:altLabel xml:lang="en">CD 049F ANTIGENS</skos:altLabel>
		<skos:altLabel xml:lang="fr">Antigènes CD49f</skos:altLabel>
		<skos:altLabel xml:lang="fr">Antigène CD49f</skos:altLabel>
		<skos:altLabel xml:lang="fr">Intégrine alpha-6</skos:altLabel>
		<skos:altLabel xml:lang="fr">antigène lymphocytaire CD49F</skos:altLabel>
		<skos:definition xml:lang="en">An integrin alpha subunit that primarily associates with INTEGRIN BETA1 or INTEGRIN BETA4 to form laminin-binding heterodimers. Integrin alpha6 has two alternatively spliced isoforms: integrin alpha6A and integrin alpha6B, which differ in their cytoplasmic domains and are regulated in a tissue-specific and developmental stage-specific manner. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0443951"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0253930">
		<skos:prefLabel xml:lang="en">Integrin alphaV</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">IntegrinAlphaV</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Intégrine alphaV</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">IntégrineAlphaV</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">alpha(V) Integrin</skos:altLabel>
		<skos:altLabel xml:lang="en">CD51 Antigens</skos:altLabel>
		<skos:altLabel xml:lang="en">Lymphocyte antigen CD51</skos:altLabel>
		<skos:altLabel xml:lang="en">CD51</skos:altLabel>
		<skos:altLabel xml:lang="en">CD51  Cluster of diff ag 51</skos:altLabel>
		<skos:altLabel xml:lang="en">CD51  Cluster of differentiation antigen 51</skos:altLabel>
		<skos:altLabel xml:lang="en">Cluster of diff antigen 51</skos:altLabel>
		<skos:altLabel xml:lang="en">Cluster of differentiation antigen 51</skos:altLabel>
		<skos:altLabel xml:lang="en">Vitronectin recept alpha chain</skos:altLabel>
		<skos:altLabel xml:lang="en">Vitronectin receptor alpha chain</skos:altLabel>
		<skos:altLabel xml:lang="en">Integrin, Alpha V (Vitronectin Receptor, Alpha Polypeptide, Antigen CD51)</skos:altLabel>
		<skos:altLabel xml:lang="en">ITGAV Protein</skos:altLabel>
		<skos:altLabel xml:lang="en">CD 051 ANTIGENS</skos:altLabel>
		<skos:altLabel xml:lang="en">Vitronectin Receptor Alpha Subunit CD51 Antigen</skos:altLabel>
		<skos:altLabel xml:lang="fr">Antigène CD51</skos:altLabel>
		<skos:altLabel xml:lang="fr">Antigènes CD51</skos:altLabel>
		<skos:altLabel xml:lang="fr">Intégrine alpha-V</skos:altLabel>
		<skos:altLabel xml:lang="fr">antigène lymphocytaire CD51</skos:altLabel>
		<skos:definition xml:lang="en">An alpha integrin with a molecular weight of 160-kDa that is found in a variety of cell types. It undergoes posttranslational cleavage into a heavy and a light chain that are connected by disulfide bonds. Integrin alphaV can combine with several different beta subunits to form heterodimers that generally bind to RGD sequence-containing extracellular matrix proteins. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0007578"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0443951"/>
		<OntoAD:gene_product_has_associated_anatomy rdf:resource="&OntoAD;C0007603"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1334396"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1332870"/>
	</owl:Class>

