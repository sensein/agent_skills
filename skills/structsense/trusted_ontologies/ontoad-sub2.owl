		<OntoAD:has_part rdf:resource="&OntoAD;C0008654"/>
		<OntoAD:is_associated_anatomy_of_gene_product rdf:resource="&OntoAD;C0206588"/>
		<OntoAD:is_associated_anatomy_of_gene_product rdf:resource="&OntoAD;C0597519"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1511876">
