	<owl:Class rdf:about="&OntoAD;C0067684">
		<skos:prefLabel xml:lang="en">N-acetylaspartate</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">N-acetylaspartate</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">N-acetyl-L-aspartate</skos:altLabel>
		<skos:altLabel xml:lang="en">N-acetyl aspartate</skos:altLabel>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0311439"/>
