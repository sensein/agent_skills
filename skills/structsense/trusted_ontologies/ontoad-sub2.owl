		<skos:altLabel xml:lang="en">Thyromegaly</skos:altLabel>
		<skos:altLabel xml:lang="en">Thyroid enlarged</skos:altLabel>
		<skos:altLabel xml:lang="en">Thyroid enlargement</skos:altLabel>
		<skos:altLabel xml:lang="en">Struma of thyroid</skos:altLabel>
		<skos:altLabel xml:lang="en">Swelling of thyroid gland</skos:altLabel>
		<skos:altLabel xml:lang="en">Struma  goiter</skos:altLabel>
		<skos:altLabel xml:lang="en">Goitre</skos:altLabel>
		<skos:altLabel xml:lang="en">THYROID GOITER</skos:altLabel>
		<skos:altLabel xml:lang="en">struma</skos:altLabel>
		<skos:altLabel xml:lang="en">enlargement under Adam's apple</skos:altLabel>
		<skos:altLabel xml:lang="fr">AUGMENTATION VOLUME THYROIDE</skos:altLabel>
		<skos:altLabel xml:lang="fr">Goitre (SF T85 T86)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Thyromégalie</skos:altLabel>
		<skos:altLabel xml:lang="fr">Hypertrophie thyroïdienne</skos:altLabel>
		<skos:altLabel xml:lang="fr">strume</skos:altLabel>
		<skos:definition xml:lang="en">Enlargement of the THYROID GLAND that may increase from about 20 grams to hundreds of grams in human adults. Goiter is observed in individuals with normal thyroid function (euthyroidism), thyroid deficiency (HYPOTHYROIDISM), or hormone overproduction (HYPERTHYROIDISM). Goiter may be congenital or acquired, sporadic or endemic (GOITER, ENDEMIC). (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1335007"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2220244"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1335047"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:may_be_treated_by rdf:resource="&OntoAD;C0040123"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0020473"/>
		<OntoAD:may_be_treated_by rdf:resource="&OntoAD;C0040165"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0040132"/>
		<OntoAD:may_be_treated_by rdf:resource="&OntoAD;C0279175"/>
	</owl:Class>

