		<skos:altLabel xml:lang="en">Localization-related epilepsy</skos:altLabel>
		<skos:altLabel xml:lang="en">focal; epileptic</skos:altLabel>
		<skos:altLabel xml:lang="en">partial; epileptic</skos:altLabel>
