	<owl:Class rdf:about="&OntoAD;C0030568">
		<skos:prefLabel xml:lang="en">Parkinson Disease, Postencephalitic</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">ParkinsonDisease,Postencephalitic</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Maladie de Parkinson post-encéphalitique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">MaladieDeParkinsonPost-encéphalitique</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Postencephalitic Parkinsonism</skos:altLabel>
		<skos:altLabel xml:lang="en">von Economo Encephalitis Type Parkinsonism</skos:altLabel>
		<skos:altLabel xml:lang="en">Postencephalitic Economo-Type Parkinsonism</skos:altLabel>
		<skos:altLabel xml:lang="en">Encephalitis Lethargica Type Parkinsonism</skos:altLabel>
		<skos:altLabel xml:lang="en">Parkinsonian Syndrome, Postencephalitis</skos:altLabel>
		<skos:altLabel xml:lang="en">Parkinson Disease, Post-Encephalitic</skos:altLabel>
		<skos:altLabel xml:lang="en">Parkinsonism post encephalitic</skos:altLabel>
		<skos:altLabel xml:lang="en">ENCEPH LETHARGICA TYPE PARKINSONISM</skos:altLabel>
		<skos:altLabel xml:lang="en">POSTENCEPH ECONOMO TYPE PARKINSONISM</skos:altLabel>
		<skos:altLabel xml:lang="en">PARKINSON DIS POST ENCEPH</skos:altLabel>
		<skos:altLabel xml:lang="en">PARKINSONISM POSTENCEPH</skos:altLabel>
		<skos:altLabel xml:lang="en">PARKINSONIAN SYNDROME POSTENCEP</skos:altLabel>
		<skos:altLabel xml:lang="en">PARKINSON DIS POSTENCEPH</skos:altLabel>
		<skos:altLabel xml:lang="en">postencephalitic Parkinson's disease</skos:altLabel>
		<skos:altLabel xml:lang="fr">Maladie de Parkinson postencéphalitique</skos:altLabel>
		<skos:altLabel xml:lang="fr">PEP (PostEncephalitic Parkinsonism)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Parkinsonisme post-encéphalitique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Syndrome parkinsonien post-encéphalitique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Parkinsonisme post-encéphalite</skos:altLabel>
		<skos:altLabel xml:lang="fr">syndrome parkinsonien postencéphalitique</skos:altLabel>
		<skos:definition xml:lang="en">Parkinsonism following encephalitis, historically seen as a sequella of encephalitis lethargica (Von Economo Encephalitis). The early age of onset, the rapid progression of symptoms followed by stabilization, and the presence of a variety of other neurological disorders (e.g., sociopathic behavior; TICS; MUSCLE SPASMS; oculogyric crises; hyperphagia; and bizarre movements) distinguish this condition from primary PARKINSON DISEASE. Pathologic features include neuronal loss and gliosis concentrate (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0030567"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0030569"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0338664"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:disease_has_associated_anatomic_site rdf:resource="&OntoAD;C0027763"/>
		<OntoAD:disease_has_associated_anatomic_site rdf:resource="&OntoAD;C0927232"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0004781"/>
		<OntoAD:occurs_after rdf:resource="&OntoAD;C0014038"/>
		<OntoAD:may_be_treated_by rdf:resource="&OntoAD;C0036442"/>
	</owl:Class>

