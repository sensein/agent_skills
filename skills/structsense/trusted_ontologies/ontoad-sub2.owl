	<owl:Class rdf:about="&OntoAD;C1705169">
		<skos:prefLabel xml:lang="en">Biomaterial Treatment</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">BiomaterialTreatment</skos:hiddenLabel>
		<skos:definition xml:lang="en">The process by which a biomaterial is created (from source biomaterials). Treatments have an order and an action. (caMAGE) (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;ConceptualEntity"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0011900">
		<skos:prefLabel xml:lang="en">Diagnosis</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Diagnosis</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Diagnostic</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Diagnostic</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">diagnostics</skos:altLabel>
		<skos:altLabel xml:lang="en">diagnostic</skos:altLabel>
		<skos:altLabel xml:lang="en">DIAG</skos:altLabel>
		<skos:altLabel xml:lang="en">diagnosis (DX)</skos:altLabel>
		<skos:altLabel xml:lang="fr">diagnostics</skos:altLabel>
		<skos:altLabel xml:lang="fr">diagnostique</skos:altLabel>
		<skos:definition xml:lang="en">The determination of the nature of a disease or condition, or the distinguishing of one disease or condition from another. Assessment may be made through physical examination, laboratory tests, or the likes. Computerized programs may be used to enhance the decision-making process. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Détermination de la nature d'une maladie ou d'une condition, ou distinction d'une maladie ou condition d'une autre. L'évaluation peut être faite par un examen physique, des tests de laboratoire ou analogues, et peut être complétée par des programmes automatisés pour améliorer le processus de prise de décision. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0430022"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0001175"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1704656">
		<skos:prefLabel xml:lang="en">Diagnosis Study</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">DiagnosisStudy</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Diagnostic Study</skos:altLabel>
		<skos:definition xml:lang="en">A type of study protocol designed to evaluate intervention(s) aimed at identifying a disease or condition. (NCI) (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1710474"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1457887">
		<skos:prefLabel xml:lang="en">Symptoms</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Symptoms</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">symptômes</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Symptômes</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">symptom</skos:altLabel>
		<skos:altLabel xml:lang="en">general manifestation of disorders</skos:altLabel>
		<skos:altLabel xml:lang="fr">symptôme</skos:altLabel>
		<skos:altLabel xml:lang="fr">symptomatique</skos:altLabel>
		<skos:definition xml:lang="en">An indication that a person has a condition or disease. Some examples of symptoms are headache, fever, fatigue, nausea, vomiting, and pain. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;SignOrSymptom"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1882330">
