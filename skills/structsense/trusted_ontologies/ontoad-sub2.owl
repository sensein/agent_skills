		<skos:altLabel xml:lang="fr">Ligand Apo-2L</skos:altLabel>
		<skos:altLabel xml:lang="fr">Ligand du Apo-2</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine Apo-2L</skos:altLabel>
		<skos:altLabel xml:lang="fr">TNF-Related Apoptosis-Inducing Ligand</skos:altLabel>
		<skos:altLabel xml:lang="fr">Membre-10 de la superfamille des TNF ligands</skos:altLabel>
		<skos:altLabel xml:lang="fr">Membre-10 de la superfamille des ligands du facteur de nécrose tumorale</skos:altLabel>
		<skos:altLabel xml:lang="fr">Membre-10 de la famille du TNF</skos:altLabel>
		<skos:altLabel xml:lang="fr">Membre-10 de la superfamille des ligands du TNF</skos:altLabel>
		<skos:altLabel xml:lang="fr">Membre-10 de la famille des ligands du TNF</skos:altLabel>
		<skos:altLabel xml:lang="fr">Membre-10 de la superfamille du TNF</skos:altLabel>
		<skos:altLabel xml:lang="fr">Membre-10 de la famille des TNF ligands</skos:altLabel>
		<skos:definition xml:lang="en">A transmembrane-protein belonging to the TNF family of intercellular signaling proteins. It is a widely expressed ligand that activates APOPTOSIS by binding to TNF-RELATED APOPTOSIS-INDUCING LIGAND RECEPTORS. The membrane-bound form of the protein can be cleaved by specific CYSTEINE ENDOPEPTIDASES to form a soluble ligand form. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0041368"/>
		<OntoAD:gene_product_expressed_in_tissue rdf:resource="&OntoAD;C0024109"/>
