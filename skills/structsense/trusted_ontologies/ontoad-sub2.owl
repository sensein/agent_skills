		<skos:altLabel xml:lang="fr">frontal</skos:altLabel>
		<skos:altLabel xml:lang="fr">os frontal, SAI</skos:altLabel>
		<skos:definition xml:lang="en">The bone that forms the frontal aspect of the skull. Its flat part forms the forehead, articulating inferiorly with the NASAL BONE and the CHEEK BONE on each side of the face. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2337482"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0222649"/>
