		<skos:altLabel xml:lang="fr">Acides aminés cationiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Aminoacides basiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Amino-acides basiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Amino-acides cationiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Aminoacides cationiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">acides aminés de base</skos:altLabel>
		<skos:definition xml:lang="en">Amino acids with side chains that are positively charged at physiological pH. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0002520"/>
	</owl:Class>

