		<skos:altLabel xml:lang="en">TRAIL Protein</skos:altLabel>
		<skos:altLabel xml:lang="en">Tumor Necrosis Factor Ligand Superfamily Member 10</skos:altLabel>
		<skos:altLabel xml:lang="en">APO2 Ligand</skos:altLabel>
