		<skos:altLabel xml:lang="en">Preprocathepsin B</skos:altLabel>
		<skos:altLabel xml:lang="en">APP Secretase</skos:altLabel>
		<skos:altLabel xml:lang="en">Amyloid Precursor Protein Secretase</skos:altLabel>
