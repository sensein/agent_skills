		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C1565489"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0014544"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0011991"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0022661"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0085762"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0032285"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0403447"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0035078"/>
	</owl:Class>

