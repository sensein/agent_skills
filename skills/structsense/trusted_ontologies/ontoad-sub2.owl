		<skos:altLabel xml:lang="en">Anterior nuclear group of thalamus</skos:altLabel>
		<skos:altLabel xml:lang="en">Thalamus, anterior nucleus</skos:altLabel>
		<skos:altLabel xml:lang="en">Anterior Thalamic Nuclei</skos:altLabel>
		<skos:altLabel xml:lang="en">Nucleus thalamicus anterior</skos:altLabel>
		<skos:altLabel xml:lang="en">anterior thalamus</skos:altLabel>
		<skos:altLabel xml:lang="en">Nuclei anteriores (thalami)</skos:altLabel>
		<skos:altLabel xml:lang="en">Structure of anterior nuclear group of thalamus</skos:altLabel>
		<skos:altLabel xml:lang="en">Anterior thalamic nucleus</skos:altLabel>
		<skos:altLabel xml:lang="fr">Noyaux thalamiques antérieurs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Groupe nucléaire antérieur du thalamus</skos:altLabel>
