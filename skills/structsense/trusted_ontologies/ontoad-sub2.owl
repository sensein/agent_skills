		<skos:hiddenLabel xml:lang="en">Calomel</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Mercurous chloride</skos:altLabel>
		<skos:altLabel xml:lang="en">mercury(I) chloride</skos:altLabel>
