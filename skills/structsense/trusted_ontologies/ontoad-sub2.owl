		<skos:altLabel xml:lang="en">PhenX measure  executive function</skos:altLabel>
		<rdfs:subClassOf rdf:resource="&OntoAD;ClinicalAttribute"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1513918">
		<skos:prefLabel xml:lang="en">Negative Predictive Value of Diagnostic Test</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">NegativePredictiveValueOfDiagnosticTest</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">negative predictive value</skos:altLabel>
		<skos:altLabel xml:lang="en">NPV</skos:altLabel>
		<skos:definition xml:lang="en">The likelihood that an individual with a negative test result is truly unaffected and/or does not have the particular gene mutation in question. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;QuantitativeConcept"/>
	</owl:Class>

