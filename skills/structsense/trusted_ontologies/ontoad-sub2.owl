	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0018213">
		<skos:prefLabel xml:lang="en">Graves Disease</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">GravesDisease</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Maladie de Basedow</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">MaladieDeBasedow</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Basedow's Disease</skos:altLabel>
		<skos:altLabel xml:lang="en">Goiter, Exophthalmic</skos:altLabel>
		<skos:altLabel xml:lang="en">FLAJANI DISEASE</skos:altLabel>
		<skos:altLabel xml:lang="en">Toxic diffuse goiter with exophthalmos</skos:altLabel>
		<skos:altLabel xml:lang="en">Graves' disease with exophthalmos</skos:altLabel>
		<skos:altLabel xml:lang="en">HYPERTHYROIDISM GRAVES DISEASE</skos:altLabel>
		<skos:altLabel xml:lang="en">Graves' disease</skos:altLabel>
		<skos:altLabel xml:lang="en">goiter; exophthalmos</skos:altLabel>
		<skos:altLabel xml:lang="en">Basedow</skos:altLabel>
		<skos:altLabel xml:lang="en">struma; exophthalmic</skos:altLabel>
		<skos:altLabel xml:lang="en">Flajani</skos:altLabel>
		<skos:altLabel xml:lang="en">Graves</skos:altLabel>
		<skos:altLabel xml:lang="en">GRD</skos:altLabel>
		<skos:altLabel xml:lang="en">Graves-Basedow disease</skos:altLabel>
		<skos:altLabel xml:lang="en">BASEDOW DIS</skos:altLabel>
		<skos:altLabel xml:lang="en">GRAVES DIS</skos:altLabel>
		<skos:altLabel xml:lang="en">Autoimmune hyperthyroidism</skos:altLabel>
		<skos:altLabel xml:lang="en">Graves' disease (diffuse toxic goiter)</skos:altLabel>
		<skos:altLabel xml:lang="fr">GOITRE EXOPHTALMIQUE</skos:altLabel>
		<skos:altLabel xml:lang="fr">MALADIE DE GRAVES-BASEDOW</skos:altLabel>
		<skos:altLabel xml:lang="fr">Goitre toxique diffus</skos:altLabel>
		<skos:altLabel xml:lang="fr">Maladie de Graves</skos:altLabel>
		<skos:altLabel xml:lang="fr">Hyperthyroïdie autoimmune</skos:altLabel>
		<skos:altLabel xml:lang="fr">maladie de Flajani</skos:altLabel>
		<skos:altLabel xml:lang="fr">maladie de Parry</skos:altLabel>
		<skos:altLabel xml:lang="fr">goitre toxique diffus avec exophtalmie</skos:altLabel>
		<skos:altLabel xml:lang="fr">maladie de Basedow avec exophtalmie</skos:altLabel>
		<skos:altLabel xml:lang="fr">maladie de Graves avec exophtalmie</skos:altLabel>
		<skos:definition xml:lang="en">A common form of hyperthyroidism with a diffuse hyperplastic GOITER. It is an autoimmune disorder that produces antibodies against the THYROID STIMULATING HORMONE RECEPTOR. These autoantibodies activate the TSH receptor, thereby stimulating the THYROID GLAND and hypersecretion of THYROID HORMONES. These autoantibodies can also affect the eyes (GRAVES OPHTHALMOPATHY) and the skin (Graves dermopathy). (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0342552"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0600086"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0155265"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1285168"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0004238"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0040132"/>
		<OntoAD:due_to rdf:resource="&OntoAD;C0020517"/>
	</owl:Class>

