		<skos:altLabel xml:lang="en">PDB</skos:altLabel>
		<skos:altLabel xml:lang="en">Paget; bone</skos:altLabel>
		<skos:altLabel xml:lang="en">osteitis deformans; Paget</skos:altLabel>
		<skos:altLabel xml:lang="en">Osseous Paget's Disease</skos:altLabel>
		<skos:altLabel xml:lang="en">PAGET DIS OF BONE</skos:altLabel>
		<skos:altLabel xml:lang="fr">Maladie de Paget</skos:altLabel>
		<skos:altLabel xml:lang="fr">Maladie osseuse de Paget</skos:altLabel>
		<skos:altLabel xml:lang="fr">Ostéite déformante hypertrophique</skos:altLabel>
