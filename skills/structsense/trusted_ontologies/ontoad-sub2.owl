		<skos:altLabel xml:lang="en">OSTEOARTHRITIS SUSCEPTIBILITY 1</skos:altLabel>
		<skos:altLabel xml:lang="en">Osteoarthritis (M15-M19)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Ostéoarthrite</skos:altLabel>
		<skos:altLabel xml:lang="fr">Ostéoarthrose</skos:altLabel>
		<skos:altLabel xml:lang="fr">Arthrose généralisée ou localisée</skos:altLabel>
