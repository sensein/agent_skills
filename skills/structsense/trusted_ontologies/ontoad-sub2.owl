		<skos:altLabel xml:lang="en">Neuropathic Bladder</skos:altLabel>
		<skos:altLabel xml:lang="en">Bladder Disorder, Neurogenic</skos:altLabel>
		<skos:altLabel xml:lang="en">Neurogenic dysfunction of the urinary bladder</skos:altLabel>
		<skos:altLabel xml:lang="en">NEUROGENIC URINARY BLADDER DIS</skos:altLabel>
