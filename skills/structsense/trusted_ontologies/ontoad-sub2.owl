		<skos:altLabel xml:lang="fr">Céruloplasmine alpha2</skos:altLabel>
		<skos:altLabel xml:lang="fr">Céruloplasmine ferroxidase</skos:altLabel>
		<skos:altLabel xml:lang="fr">alpha2-Céruloplasmine</skos:altLabel>
