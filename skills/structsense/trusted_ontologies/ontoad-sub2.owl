		<skos:hiddenLabel xml:lang="en">Pupil</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Pupille</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Pupille</skos:hiddenLabel>
