		<skos:altLabel xml:lang="en">rnox cognition</skos:altLabel>
		<skos:altLabel xml:lang="fr">Thérapie cognito-comportementale</skos:altLabel>
		<skos:altLabel xml:lang="fr">Psychothérapie cognitive</skos:altLabel>
		<skos:altLabel xml:lang="fr">Thérapie cognitive comportementale</skos:altLabel>
		<skos:definition xml:lang="en">A direct form of psychotherapy based on the interpretation of situations (cognitive structure of experiences) that determine how an individual feels and behaves. It is based on the premise that cognition, the process of acquiring knowledge and forming beliefs, is a primary determinant of mood and behavior. The therapy uses behavioral and verbal techniques to identify and correct negative thinking that is at the root of the aberrant behavior. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0004933"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2921979"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0419150"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2142955"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0010377">
		<skos:prefLabel xml:lang="en">Crotoxin</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Crotoxin</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Crotoxine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Crotoxine</skos:hiddenLabel>
		<skos:definition xml:lang="en">A specific complex of toxic proteins from the venom of Crotalus durissus terrificus (South American rattlesnake). It can be separated into a phospholipase A and crotapotin fragment; the latter consists of three different amino acid chains, potentiates the enzyme, and is specifically neurotoxic. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0027934"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1519886"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1367551">
		<skos:prefLabel xml:lang="en">CALCA gene</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CALCAGene</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">CALCITONIN</skos:altLabel>
		<skos:altLabel xml:lang="en">CALCITONIN GENE-RELATED PEPTIDE</skos:altLabel>
		<skos:altLabel xml:lang="en">CGRP</skos:altLabel>
		<skos:altLabel xml:lang="en">CALC1</skos:altLabel>
		<skos:altLabel xml:lang="en">CALCA</skos:altLabel>
		<skos:altLabel xml:lang="en">CALCITONIN/CALCITONIN-RELATED POLYPEPTIDE, ALPHA</skos:altLabel>
		<skos:altLabel xml:lang="en">Calcitonin/Calcitonin-Related Polypeptide, Alpha Gene</skos:altLabel>
		<skos:altLabel xml:lang="en">calcitonin-related polypeptide alpha</skos:altLabel>
		<skos:definition xml:lang="en">This gene is involved in the regulation of bone incorporation and blood calcium and phosphate levels. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1335375"/>
		<OntoAD:gene_associated_with_disease rdf:resource="&OntoAD;C0029456"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1705783">
		<skos:prefLabel xml:lang="en">CALCA wt Allele</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CALCAWtAllele</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">CGRP</skos:altLabel>
		<skos:altLabel xml:lang="en">CALC1</skos:altLabel>
		<skos:altLabel xml:lang="en">CALCA</skos:altLabel>
		<skos:altLabel xml:lang="en">CGRP-I</skos:altLabel>
		<skos:altLabel xml:lang="en">CGRP1</skos:altLabel>
		<skos:altLabel xml:lang="en">Calcitonin/Calcitonin-Related Polypeptide, Alpha wt Allele</skos:altLabel>
		<skos:definition xml:lang="en">Human CALCA wild-type allele is located within 11p15.2-p15.1 and is approximately 6 kb in length. This allele, which encodes calcitonin protein, is involved in the regulation of circulating calcium levels. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1367551"/>
		<OntoAD:gene_associated_with_disease rdf:resource="&OntoAD;C0029456"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0042866">
		<skos:prefLabel xml:lang="en">Vitamin D</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">VitaminD</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Vitamine D</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">VitamineD</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Oleovitamin D preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">Vitamin D preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">Vitamin D product</skos:altLabel>
		<skos:altLabel xml:lang="en">vit d</skos:altLabel>
		<skos:altLabel xml:lang="en">Oleovitamin D</skos:altLabel>
		<skos:altLabel xml:lang="fr">vitamine D.</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation de vitamines D</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation d'oléovitamines D</skos:altLabel>
		<skos:altLabel xml:lang="fr">calciférol</skos:altLabel>
		<skos:definition xml:lang="en">A vitamin that includes both CHOLECALCIFEROLS and ERGOCALCIFEROLS, which have the common effect of preventing or curing RICKETS in animals. It can also be viewed as a hormone since it can be formed in SKIN by action of ULTRAVIOLET RAYS upon the precursors, 7-dehydrocholesterol and ERGOSTEROL, and acts on VITAMIN D RECEPTORS to regulate CALCIUM in opposition to PARATHYROID HORMONE. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0259753"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0038317"/>
		<OntoAD:active_ingredient_of rdf:resource="&OntoAD;C0310589"/>
		<OntoAD:chemical_structure_of rdf:resource="&OntoAD;C2936842"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0919553">
		<skos:prefLabel xml:lang="en">Histopathologic Grade</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">HistopathologicGrade</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Grading</skos:altLabel>
		<skos:altLabel xml:lang="en">Histologic grade</skos:altLabel>
		<skos:altLabel xml:lang="en">Histopathology Grade</skos:altLabel>
		<skos:definition xml:lang="en">A description of a tumor based on how abnormal the cancer cells look under a microscope and how quickly the tumor is likely to grow and spread. Grading systems are different for each type of cancer. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;Classification"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0023779">
		<skos:prefLabel xml:lang="en">Lipids</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Lipids</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Lipides</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Lipides</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Lipid</skos:altLabel>
		<skos:altLabel xml:lang="fr">lipide</skos:altLabel>
		<skos:definition xml:lang="en">A generic term for fats and lipoids, the alcohol-ether-soluble constituents of protoplasm, which are insoluble in water. They comprise the fats, fatty oils, essential oils, waxes, phospholipids, glycolipids, sulfolipids, aminolipids, chromolipids (lipochromes), and fatty acids. (Grant and Hackh's Chemical Dictionary, 5th ed) (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">terme générique pour les gras et ¤sllipoids¤sl, l'éther d'alcool les constituants solubles de protoplasme, qui sont insolubles dans l'eau. Ils comprennent les gras, les huiles gras, les pétroles essentiels, les cires, phospholipides, glycolipides, ¤slsulfolipids¤sl, ¤slaminolipids¤sl, ¤slchromolipids¤sl ¤sl(lipochromes)¤sl et les acides gras. (traduit de 'GrantetHackh's Chemical Dictionary, 5th ed') (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0443602"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0523744">
		<skos:prefLabel xml:lang="en">Lipids measurement</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">LipidsMeasurement</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Lipides</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Lipides</skos:hiddenLabel>
		<skos:altLabel xml:lang="fr">dosage des lipides</skos:altLabel>
		<skos:definition xml:lang="en">A quantitative measurement of the amount of lipids (cholesterol, lipoproteins, and triglycerides) present in a sample. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2316799"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0201682"/>
		<OntoAD:has_method rdf:resource="&OntoAD;C0242485"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0041427">
		<skos:prefLabel xml:lang="en">Twin sibling (person)</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">TwinSibling(person)</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Jumeaux</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Jumeaux</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Twin sibling</skos:altLabel>
		<skos:altLabel xml:lang="en">Twins</skos:altLabel>
		<skos:altLabel xml:lang="en">Twin</skos:altLabel>
		<skos:altLabel xml:lang="fr">Jumeau</skos:altLabel>
		<skos:altLabel xml:lang="fr">frère jumeau/soeur jumelle</skos:altLabel>
		<skos:definition xml:lang="en">Two individuals derived from two FETUSES that were fertilized at or about the same time, developed in the UTERUS simultaneously, and born to the same mother. Twins are either monozygotic (TWINS, MONOZYGOTIC) or dizygotic (TWINS, DIZYGOTIC). (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Deux individus provenant de deux FoetUS qui ont été fertilisés en même temps, se sont développés dans l'UTÉRUS simultanément et nés de la même mère. Les jumeaux sont soit monozygotes (JUMEAUX, MONOZYGOTES) ou dizygotes (JUMEAUX, dizygotes). (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0037047"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0337502"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0030569">
		<skos:prefLabel xml:lang="en">Secondary Parkinson Disease</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">SecondaryParkinsonDisease</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Syndrome parkinsonien secondaire</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">SyndromeParkinsonienSecondaire</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Symptomatic Parkinson Disease</skos:altLabel>
		<skos:altLabel xml:lang="en">Parkinsonism, Symptomatic</skos:altLabel>
		<skos:altLabel xml:lang="en">Paralysis agitans, secondary</skos:altLabel>
		<skos:altLabel xml:lang="en">Secondary Parkinsonism</skos:altLabel>
		<skos:altLabel xml:lang="en">Secondary parkinsm,unspecif</skos:altLabel>
		<skos:altLabel xml:lang="en">Dis presnt prim with parkinson</skos:altLabel>
		<skos:altLabel xml:lang="en">Disorders presenting primarily with parkinsonism</skos:altLabel>
		<skos:altLabel xml:lang="en">Syndrome Parkinsonism</skos:altLabel>
		<skos:altLabel xml:lang="en">Symptomatic parkinsonism</skos:altLabel>
		<skos:altLabel xml:lang="en">PARKINSON DIS SYMPTOMATIC</skos:altLabel>
		<skos:altLabel xml:lang="en">PARKINSON DIS SECOND</skos:altLabel>
		<skos:altLabel xml:lang="en">PARKINSONISM SECOND</skos:altLabel>
		<skos:altLabel xml:lang="en">Parkinson Disease, Secondary</skos:altLabel>
		<skos:altLabel xml:lang="fr">Maladie de Parkinson secondaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">Parkinsonisme secondaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">Syndrome parkinsonien secondaire, sans précision</skos:altLabel>
		<skos:definition xml:lang="en">Conditions which feature clinical manifestations resembling primary Parkinson disease that are caused by a known or suspected condition. Examples include parkinsonism caused by vascular injury, drugs, trauma, toxin exposure, neoplasms, infections and degenerative or hereditary conditions. Clinical features may include bradykinesia, rigidity, parkinsonian gait, and masked facies. In general, tremor is less prominent in secondary parkinsonism than in the primary form. (From Joynt, Clinical Neurolo (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0242422"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1335000"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:clinically_similar rdf:resource="&OntoAD;C0030567"/>
		<OntoAD:disease_has_associated_anatomic_site rdf:resource="&OntoAD;C0027763"/>
		<OntoAD:disease_has_associated_anatomic_site rdf:resource="&OntoAD;C0927232"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0004781"/>
	</owl:Class>

