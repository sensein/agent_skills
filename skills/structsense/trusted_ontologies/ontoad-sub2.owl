	<owl:Class rdf:about="&OntoAD;C0037900">
		<skos:prefLabel xml:lang="en">Sphingolipids</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Sphingolipids</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Sphingolipides</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Sphingolipides</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Sphingolipid</skos:altLabel>
		<skos:altLabel xml:lang="fr">Sphingolipide</skos:altLabel>
		<skos:definition xml:lang="en">A class of membrane lipids that have a polar head and two nonpolar tails. They are composed of one molecule of the long-chain amino alcohol sphingosine (4-sphingenine) or one of its derivatives, one molecule of a long-chain acid, a polar head alcohol and sometimes phosphoric acid in diester linkage at the polar head group. (Lehninger et al, Principles of Biochemistry, 2nd ed) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0012171"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0582212"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0021147">
		<skos:prefLabel xml:lang="en">Incentives</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Incentives</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Encouragements</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Encouragements</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">stimulation</skos:altLabel>
		<skos:altLabel xml:lang="en">inducement</skos:altLabel>
		<skos:altLabel xml:lang="fr">stimulation</skos:altLabel>
		<skos:altLabel xml:lang="fr">Mesures incitatives</skos:altLabel>
		<skos:altLabel xml:lang="fr">Stimulations</skos:altLabel>
		<skos:altLabel xml:lang="fr">Incitations</skos:altLabel>
		<skos:definition xml:lang="en">A benefit, consideration, or positive motivational influence, financial or otherwise, given to induce a specific action. (source : NCI)</skos:definition>
		<skos:definition xml:lang="fr">facteurs qui font qu'un organisme se comporte ou agit en fonction d'un but ou d'une manière satisfaisante. Ils peuvent être influencés par l'état physiologique ou des stimulus externes. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0026605"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0010439">
