		<skos:hiddenLabel xml:lang="en">LeadSalt</skos:hiddenLabel>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0303231"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0032521">
		<skos:prefLabel xml:lang="en">Polymers</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Polymers</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Polymères</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Polymères</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Polymer</skos:altLabel>
		<skos:altLabel xml:lang="en">Polymeric</skos:altLabel>
		<skos:altLabel xml:lang="en">Polymeric Macromolecules</skos:altLabel>
		<skos:definition xml:lang="en">Compounds formed by the joining of smaller, usually repeating, units linked by covalent bonds. These compounds often form large macromolecules (e.g., BIOPOLYMERS; PLASTICS). (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0729761"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0014298">
		<skos:prefLabel xml:lang="en">Enkephalins</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Enkephalins</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Enképhalines</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Enképhalines</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Enkephalin</skos:altLabel>
		<skos:altLabel xml:lang="fr">Encéphalines</skos:altLabel>
		<skos:altLabel xml:lang="fr">Enképhaline</skos:altLabel>
		<skos:altLabel xml:lang="fr">encéphaline</skos:altLabel>
		<skos:definition xml:lang="en">One of the three major families of endogenous opioid peptides. The enkephalins are pentapeptides that are widespread in the central and peripheral nervous systems and in the adrenal medulla. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0582246"/>
