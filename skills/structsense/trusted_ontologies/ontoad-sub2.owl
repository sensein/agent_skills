	<owl:Class rdf:about="&OntoAD;C0003290">
		<skos:prefLabel xml:lang="en">Tricyclic Antidepressive Agents</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">TricyclicAntidepressiveAgents</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Antidépresseurs tricycliques</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AntidépresseursTricycliques</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Antidepressants, Tricyclic</skos:altLabel>
		<skos:altLabel xml:lang="en">Antidepressant Drugs, Tricyclic</skos:altLabel>
		<skos:altLabel xml:lang="en">TCA</skos:altLabel>
		<skos:altLabel xml:lang="en">Tricyclic antidepressant</skos:altLabel>
		<skos:altLabel xml:lang="en">TRICYCLIC ANTIDEPRESSANTS</skos:altLabel>
		<skos:altLabel xml:lang="en">Tricyclics</skos:altLabel>
		<skos:altLabel xml:lang="en">tricyclic anti-depressants</skos:altLabel>
		<skos:altLabel xml:lang="en">Tricyclic antidepressant drug</skos:altLabel>
		<skos:altLabel xml:lang="en">Tricyclic Antidepressant (TCA)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments antidépresseurs tricycliques</skos:altLabel>
		<skos:altLabel xml:lang="fr">antidépresseur tricyclique</skos:altLabel>
		<skos:definition xml:lang="en">Substances that contain a fused three-ring moiety and are used in the treatment of depression. These drugs block the uptake of norepinephrine and serotonin into axon terminals and may block some subtypes of serotonin, adrenergic, and histamine receptors. However the mechanism of their antidepressant effects is not clear because the therapeutic effects usually take weeks to develop and may reflect compensatory changes in the central nervous system. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003289"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0011581"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0019560">
		<skos:prefLabel xml:lang="en">Hip Joint Implantable Prostheses (device)</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">HipJointImplantableProstheses(device)</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Prothèse de hanche</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ProthèseDeHanche</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Hip Prosthesis</skos:altLabel>
		<skos:altLabel xml:lang="en">Hip joint prosthesis</skos:altLabel>
		<skos:altLabel xml:lang="en">Hip Endoprostheses</skos:altLabel>
		<skos:altLabel xml:lang="en">Hip Implants</skos:altLabel>
		<skos:altLabel xml:lang="en">Hip prosthesis, device</skos:altLabel>
		<skos:altLabel xml:lang="en">Hip Joint Implantable Prostheses</skos:altLabel>
		<skos:altLabel xml:lang="en">Hip Replacement Systems, Implantable</skos:altLabel>
		<skos:altLabel xml:lang="fr">Prothèse articulaire de hanche</skos:altLabel>
		<skos:altLabel xml:lang="fr">PTH (Prothèse Totale de Hanche)</skos:altLabel>
