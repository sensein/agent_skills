	<owl:Class rdf:about="&OntoAD;C0497327">
		<skos:prefLabel xml:lang="en">Dementia</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Dementia</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Démence</skos:prefLabel>
