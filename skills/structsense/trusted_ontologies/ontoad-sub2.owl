	<owl:Class rdf:about="&OntoAD;C1704259">
		<skos:prefLabel xml:lang="en">Biochemical Pathway</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">BiochemicalPathway</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">pathways</skos:altLabel>
		<skos:altLabel xml:lang="en">Pathway</skos:altLabel>
		<skos:altLabel xml:lang="en">molecular pathway</skos:altLabel>
		<skos:definition xml:lang="en">A series of actions among molecules in a cell that leads to a certain end point or cell function. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;MolecularFunction"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1511884">
		<skos:prefLabel xml:lang="en">Diagnostic Specificity</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">DiagnosticSpecificity</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Specificity</skos:altLabel>
		<skos:altLabel xml:lang="en">Specificity of Diagnostic Test</skos:altLabel>
		<skos:definition xml:lang="en">The frequency with which a test yields a true negative result among individuals who do not have the disease or the gene mutation in question. A test with high specificity has a low false-positive rate and thus does a good job of correctly classifying unaffected individuals. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;QuantitativeConcept"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0007404">
		<skos:prefLabel xml:lang="en">Catechin</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Catechin</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Catéchine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Catéchine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Catechinic Acid</skos:altLabel>
		<skos:altLabel xml:lang="en">Catechu</skos:altLabel>
		<skos:altLabel xml:lang="en">Catechuic Acid</skos:altLabel>
		<skos:altLabel xml:lang="en">Cianidanol</skos:altLabel>
		<skos:definition xml:lang="en">An antioxidant flavonoid, occurring especially in woody plants as both (+)-catechin and (-)-epicatechin (cis) forms. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0011625"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0596577"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2348678"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1827173"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0009170">
		<skos:prefLabel xml:lang="en">Cocaine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Cocaine</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Cocaïne</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Cocaïne</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Coke</skos:altLabel>
		<skos:altLabel xml:lang="en">Snow</skos:altLabel>
		<skos:altLabel xml:lang="en">Blow</skos:altLabel>
		<skos:altLabel xml:lang="en">cocaine in any form</skos:altLabel>
		<skos:altLabel xml:lang="en">cocaine (Schedule I substance)</skos:altLabel>
		<skos:altLabel xml:lang="en">Flake</skos:altLabel>
		<skos:definition xml:lang="en">An alkaloid ester extracted from the leaves of plants including coca. It is a local anesthetic and vasoconstrictor and is clinically used for that purpose, particularly in the eye, ear, nose, and throat. It also has powerful central nervous system effects similar to the amphetamines and is a drug of abuse. Cocaine, like amphetamines, acts by multiple mechanisms on brain catecholaminergic neurons; the mechanism of its reinforcing effects is thought to involve inhibition of dopamine uptake. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0002763"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0740858"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0360098"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0042397"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0030193"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013182"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1556156">
		<skos:prefLabel xml:lang="en">Nutrition, Calories</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Nutrition,Calories</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">cal</skos:altLabel>
		<skos:altLabel xml:lang="en">calorie</skos:altLabel>
		<skos:altLabel xml:lang="en">kcal</skos:altLabel>
		<skos:altLabel xml:lang="en">Kilocalorie</skos:altLabel>
		<skos:altLabel xml:lang="en">Nutritionist's Calorie</skos:altLabel>
		<skos:altLabel xml:lang="en">Large Calorie</skos:altLabel>
		<skos:altLabel xml:lang="en">Kilogram Calorie</skos:altLabel>
		<skos:altLabel xml:lang="en">Dietician's Calorie</skos:altLabel>
		<skos:altLabel xml:lang="en">Food Calorie</skos:altLabel>
		<skos:altLabel xml:lang="en">caloris</skos:altLabel>
		<skos:definition xml:lang="en">A measurement of the energy content of food. The body needs calories as to perform its functions, such as breathing, circulating the blood, and physical activity. When a person is sick, their body may need extra calories to fight fever or other problems. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1518485"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0001347">
		<skos:prefLabel xml:lang="en">Acute-Phase Proteins</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Acute-PhaseProteins</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Protéine de la phase aigüe</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ProtéineDeLaPhaseAigüe</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Reactants, Acute-Phase</skos:altLabel>
		<skos:altLabel xml:lang="en">Acute phase reactant</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéines de la phase aiguë</skos:altLabel>
		<skos:altLabel xml:lang="fr">PPA (Protéines de la Phase Aigüe)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéines de phase aiguë</skos:altLabel>
		<skos:altLabel xml:lang="fr">réactif de la phase aiguë</skos:altLabel>
		<skos:definition xml:lang="en">Proteins that are secreted into the blood in increased or decreased quantities by hepatocytes in response to trauma, inflammation, or disease. These proteins can serve as inhibitors or mediators of the inflammatory processes. Certain acute-phase proteins have been used to diagnose and follow the course of diseases or as tumor markers. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0032120"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1364818">
		<skos:prefLabel xml:lang="en">APP gene</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">APPGene</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">PROTEASE NEXIN II</skos:altLabel>
		<skos:altLabel xml:lang="en">PN2</skos:altLabel>
		<skos:altLabel xml:lang="en">AMYLOID BETA A4 PRECURSOR PROTEIN</skos:altLabel>
		<skos:altLabel xml:lang="en">CVAP</skos:altLabel>
		<skos:altLabel xml:lang="en">Amyloid Beta (A4) Precursor Protein Gene</skos:altLabel>
		<skos:altLabel xml:lang="en">AMYLOID OF AGING AND ALZHEIMER DISEASE</skos:altLabel>
		<skos:altLabel xml:lang="en">CEREBRAL VASCULAR AMYLOID PEPTIDE</skos:altLabel>
		<skos:altLabel xml:lang="en">DEMENTIA, EARLY-ONSET PROGRESSIVE, AUTOSOMAL RECESSIVE</skos:altLabel>
		<skos:altLabel xml:lang="en">peptidase nexin-II</skos:altLabel>
		<skos:definition xml:lang="en">This gene is involved in transcriptional activation and mutations in the gene are correlated with Alzheimer disease. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1335671"/>
		<OntoAD:gene_associated_with_disease rdf:resource="&OntoAD;C0002395"/>
		<OntoAD:gene_encodes_gene_product rdf:resource="&OntoAD;C0611285"/>
		<OntoAD:gene_plays_role_in_process rdf:resource="&OntoAD;C0242606"/>
		<OntoAD:gene_plays_role_in_process rdf:resource="&OntoAD;C0162638"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0920317">
		<skos:prefLabel xml:lang="en">Meta Analysis (statistical procedure)</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">MetaAnalysis(statisticalProcedure)</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Méta-analyse comme sujet</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Méta-analyseCommeSujet</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">meta-analysis</skos:altLabel>
		<skos:altLabel xml:lang="en">meta-analyses</skos:altLabel>
		<skos:altLabel xml:lang="en">Meta Analysis</skos:altLabel>
		<skos:altLabel xml:lang="en">Clinical Trial Overviews</skos:altLabel>
		<skos:altLabel xml:lang="en">Data Pooling</skos:altLabel>
		<skos:altLabel xml:lang="en">Data Poolings</skos:altLabel>
		<skos:altLabel xml:lang="en">metaanalysis</skos:altLabel>
		<skos:altLabel xml:lang="en">CLIN TRIAL OVERVIEWS</skos:altLabel>
		<skos:altLabel xml:lang="en">Meta-Analysis as Topic</skos:altLabel>
		<skos:altLabel xml:lang="fr">méta-analyse</skos:altLabel>
		<skos:altLabel xml:lang="fr">Regroupement de données</skos:altLabel>
		<skos:altLabel xml:lang="fr">Revues d'essais cliniques</skos:altLabel>
		<skos:definition xml:lang="en">A quantitative method of combining the results of independent studies (usually drawn from the published literature) and synthesizing summaries and conclusions which may be used to evaluate therapeutic effectiveness, plan new studies, etc., with application chiefly in the areas of research and medicine. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1710191"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0003402">
		<skos:prefLabel xml:lang="en">Antioxidants</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Antioxidants</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Antioxydants</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Antioxydants</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">antioxidant</skos:altLabel>
		<skos:altLabel xml:lang="fr">Antioxidants</skos:altLabel>
		<skos:altLabel xml:lang="fr">Antioxygènes</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents antioxydants</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments antioxydants</skos:altLabel>
		<skos:altLabel xml:lang="fr">Anti-oxydants</skos:altLabel>
		<skos:altLabel xml:lang="fr">Anti-oxygènes</skos:altLabel>
		<skos:definition xml:lang="en">Naturally occurring or synthetic substances that inhibit or retard the oxidation of a substance to which it is added. They counteract the harmful and damaging effects of oxidation in animal tissues. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Au cours des réactions chimiques qui se produisent dans notre corps, se forment des substances appelées ' radicaux libres ' qui peuvent endommager les cellules. Certains sels minéraux (le sélénium ou le zinc, par exemple) et certaines vitamines (C, E et bêta-carotènes) sont connus pour contribuer à neutraliser les radicaux libres : ce sont des antioxydants. Ils participeraient également au renforcement des défenses immunitaires. Ils sont apportés en quantité suffisante par une alimentation équil (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2093625"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0033613"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0025265">
		<skos:prefLabel xml:lang="en">Memory, Short-Term</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Memory,Short-Term</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Mémoire à court terme</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">MémoireÀCourtTerme</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">short-term memory</skos:altLabel>
		<skos:altLabel xml:lang="en">working memory</skos:altLabel>
		<skos:altLabel xml:lang="en">Memory, Immediate</skos:altLabel>
		<skos:altLabel xml:lang="en">Immediate memory, function</skos:altLabel>
		<skos:altLabel xml:lang="en">Memory, Shortterm</skos:altLabel>
		<skos:altLabel xml:lang="fr">mémoire de travail</skos:altLabel>
		<skos:altLabel xml:lang="fr">Mémoire immédiate</skos:altLabel>
		<skos:definition xml:lang="en">Remembrance of information for a few seconds to hours. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Fonctions mentales qui produisent une réserve mnémonique temporaire et pouvant être pertubée, d'une durée d'environ 30 secondes, d'où l'information est perdue si elle n'est pas consolidée dans la mémoire à long terme. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0025260"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2266643"/>
		<OntoAD:biological_process_has_associated_location rdf:resource="&OntoAD;C0006104"/>
		<OntoAD:biological_process_has_associated_location rdf:resource="&OntoAD;C0027763"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0524851">
		<skos:prefLabel xml:lang="en">Neurodegenerative Disorders</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">NeurodegenerativeDisorders</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Maladies neurodégénératives</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">MaladiesNeurodégénératives</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">neurodegenerative disease</skos:altLabel>
		<skos:altLabel xml:lang="en">neurodegenerative diseases</skos:altLabel>
		<skos:altLabel xml:lang="en">neurodegenerative disorder</skos:altLabel>
		<skos:altLabel xml:lang="en">Degenerative disease or syndrome of nervous system</skos:altLabel>
		<skos:altLabel xml:lang="en">Degenerative disease of nervous system</skos:altLabel>
		<skos:altLabel xml:lang="en">Degenerative Diseases and Syndromes of Nervous System</skos:altLabel>
		<skos:altLabel xml:lang="en">Neurologic Degenerative Conditions</skos:altLabel>
		<skos:altLabel xml:lang="en">Degenerative Diseases, Nervous System</skos:altLabel>
		<skos:altLabel xml:lang="en">Neurologic Diseases, Degenerative</skos:altLabel>
		<skos:altLabel xml:lang="en">Degenerative Neurologic Disorders</skos:altLabel>
		<skos:altLabel xml:lang="en">NEURODEGENERATIVE DIS</skos:altLabel>
		<skos:altLabel xml:lang="en">DEGENERATIVE DIS NEUROLOGIC</skos:altLabel>
		<skos:altLabel xml:lang="en">DEGENERATIVE DIS NERVOUS SYSTEM</skos:altLabel>
		<skos:altLabel xml:lang="fr">maladie neurodégénérative</skos:altLabel>
		<skos:altLabel xml:lang="fr">troubles neurodégénératifs</skos:altLabel>
		<skos:altLabel xml:lang="fr">maladies neuro-dégénératives</skos:altLabel>
		<skos:altLabel xml:lang="fr">pathologies neurodégénératives</skos:altLabel>
		<skos:altLabel xml:lang="fr">maladies dégénératives</skos:altLabel>
		<skos:altLabel xml:lang="fr">pathologie neurodégénérative</skos:altLabel>
		<skos:altLabel xml:lang="fr">Atteintes neurodégénératives</skos:altLabel>
		<skos:altLabel xml:lang="fr">Trouble neurodégénératif</skos:altLabel>
		<skos:altLabel xml:lang="fr">Affections neurodégénératives</skos:altLabel>
		<skos:altLabel xml:lang="fr">États neurodégénératifs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Affection dégénérative du système nerveux, sans précision</skos:altLabel>
		<skos:definition xml:lang="en">Hereditary and sporadic conditions which are characterized by progressive nervous system dysfunction. These disorders are often associated with atrophy of the affected central or peripheral nervous system structures. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">affections héréditaires et sporadiques qui sont caractérisées par le dysfonctionnement de système nerveux progressif. Ces troubles sont souvent associés à l'atrophie des structures de système nerveux centrales ou périphériques affectées. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1285162"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1335000"/>
		<OntoAD:disease_has_associated_anatomic_site rdf:resource="&OntoAD;C0027763"/>
		<OntoAD:disease_has_associated_anatomic_site rdf:resource="&OntoAD;C0927232"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0033452">
		<skos:prefLabel xml:lang="en">Properdin</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Properdin</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Properdine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Properdine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Factor P</skos:altLabel>
		<skos:altLabel xml:lang="en">Complement Factor P</skos:altLabel>
		<skos:altLabel xml:lang="en">Properdin complement component</skos:altLabel>
		<skos:altLabel xml:lang="en">P  Properdin</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteur P du complément</skos:altLabel>
		<skos:altLabel xml:lang="fr">composant du complément de la properdine</skos:altLabel>
		<skos:definition xml:lang="en">A 53-kDa protein that is a positive regulator of the alternate pathway of complement activation (COMPLEMENT ACTIVATION PATHWAY, ALTERNATIVE). It stabilizes the ALTERNATIVE PATHWAY C3 CONVERTASE (C3bBb) and protects it from rapid inactivation, thus facilitating the cascade of COMPLEMENT ACTIVATION and the formation of MEMBRANE ATTACK COMPLEX. Individuals with mutation in the PFC gene exhibit properdin deficiency and have a high susceptibility to infections. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0443862"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0021054"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0080014">
		<skos:prefLabel xml:lang="en">Dietary Phosphorus</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">DietaryPhosphorus</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Phosphore alimentaire</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">PhosphoreAlimentaire</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">PHOSPHORUS</skos:altLabel>
		<skos:altLabel xml:lang="en">Phosphorus, Dietary</skos:altLabel>
		<skos:definition xml:lang="en">Phosphorus used in foods or obtained from food. This element is a major intracellular component which plays an important role in many biochemical pathways relating to normal physiological functions. High concentrations of dietary phosphorus can cause nephrocalcinosis which is associated with impaired kidney function. Low concentrations of dietary phosphorus cause an increase in calcitriol in the blood and osteoporosis. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0596444"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0162409">
		<skos:prefLabel xml:lang="en">spouse</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Spouse</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Conjoints</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Conjoints</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Married Persons</skos:altLabel>
		<skos:altLabel xml:lang="fr">Epoux</skos:altLabel>
		<skos:altLabel xml:lang="fr">conjoint</skos:altLabel>
		<skos:altLabel xml:lang="fr">Personne mariée</skos:altLabel>
		<skos:altLabel xml:lang="fr">Personnes mariées</skos:altLabel>
		<skos:definition xml:lang="en">Married persons, i.e., husbands and wives, or partners. Domestic partners, or spousal equivalents, are two adults who have chosen to share their lives in an intimate and committed relationship, reside together, and share a mutual obligation of support for the basic necessities of life. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">personnes mariées, c'est-à-dire, les maris et les femmes, ou les partenaires. Les partenaires domestiques, ou les équivalents conjugaux, sont deux adultes qui ont voulu partager leurs vies dans un rapport intime et déterminé, résident ensemble et partagent une obligation réciproque de soutien en faveur des nécessités fondamentales de vie. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0682323"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1273520"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0085400">
		<skos:prefLabel xml:lang="en">Neurofibrillary Tangles</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">NeurofibrillaryTangles</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Enchevêtrements neurofibrillaires</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">EnchevêtrementsNeurofibrillaires</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">neurofibrillary tangle</skos:altLabel>
		<skos:altLabel xml:lang="en">Neurofibrillary degeneration</skos:altLabel>
		<skos:altLabel xml:lang="en">Alzheimer's neurofibrillary change</skos:altLabel>
		<skos:altLabel xml:lang="en">Alzheimer's neurofibrillary degeneration</skos:altLabel>
		<skos:altLabel xml:lang="en">Argentophilic neuronal inclusion</skos:altLabel>
		<skos:altLabel xml:lang="en">NFT</skos:altLabel>
		<skos:altLabel xml:lang="fr">Enchevêtrement neurofibrillaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">Enchevêtrements de neurofibrilles</skos:altLabel>
		<skos:altLabel xml:lang="fr">dégénérescence neurofibrillaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">inclusion neuronale argentophile</skos:altLabel>
		<skos:altLabel xml:lang="fr">dégénérescence neurofibrillaire d'Alzheimer</skos:altLabel>
		<skos:altLabel xml:lang="fr">lésions neurofibrillaires d'Alzheimer</skos:altLabel>
		<skos:definition xml:lang="en">Abnormal structures located in various parts of the brain and composed of dense arrays of paired helical filaments (neurofilaments and microtubules). These double helical stacks of transverse subunits are twisted into left-handed ribbon-like filaments that likely incorporate the following proteins: (1) the intermediate filaments: medium- and high-molecular-weight neurofilaments; (2) the microtubule-associated proteins map-2 and tau; (3) actin; and (4) UBIQUITINS. As one of the hallmarks of ALZHE (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">structures anormales situées dans les parties différentes du cerveau et composé des matrices denses de filaments hélicoïdes appariés (neurofilaments et de microtubules). Ces meules hélicoïdes doubles de sous-unités transversales sont tournées dans les filaments semblables au cordon gauchers qui incorporent probablement les protéines suivantes : (1) les filaments intermédiaires : le médium - et le haut poids moléculaire neurofilaments ; (2) les protéines associées de microtubule font la carte 2 e (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0011164"/>
		<OntoAD:manifestation_of rdf:resource="&OntoAD;C0038868"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0234402">
		<skos:prefLabel xml:lang="en">Stimulus</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Stimulus</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">stimuli</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Stimuli</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">stimuli</skos:altLabel>
		<skos:altLabel xml:lang="en">Stimulus, function</skos:altLabel>
		<skos:definition xml:lang="en">An environmental event, agent, act, or influence that can be detected by a receptor in the body and will invariably produce a reaction in a living organism, e.g. change in the behavior, functional or trophic reaction. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;PhenomenonOrProcess"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0018759">
		<skos:prefLabel xml:lang="en">Health Status</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">HealthStatus</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">État de santé</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ÉtatDeSanté</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Level of Health</skos:altLabel>
		<skos:altLabel xml:lang="fr">État sanitaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">Situation sanitaire</skos:altLabel>
		<skos:definition xml:lang="en">The level of health of the individual, group, or population as subjectively assessed by the individual or by more objective measures. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Niveau de santé d'une personne, d'un groupe ou d'une population, mesuré subjectivement par la personne ou par des mesures plus objectives. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;QualitativeConcept"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0032529">
		<skos:prefLabel xml:lang="en">Genetic Polymorphism</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">GeneticPolymorphism</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Polymorphisme génétique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">PolymorphismeGénétique</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">polymorphisms</skos:altLabel>
		<skos:altLabel xml:lang="en">polymorphism</skos:altLabel>
		<skos:altLabel xml:lang="en">POLYMORPHISM GENET</skos:altLabel>
		<skos:altLabel xml:lang="fr">polymorphismes génétiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">polymorphisme</skos:altLabel>
		<skos:altLabel xml:lang="fr">Polymorphisme (génétique)</skos:altLabel>
		<skos:definition xml:lang="en">The regular and simultaneous occurrence in a single interbreeding population of two or more discontinuous genotypes. The concept includes differences in genotypes ranging in size from a single nucleotide site (POLYMORPHISM, SINGLE NUCLEOTIDE) to large nucleotide sequences visible at a chromosomal level. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">L'occurrence régulière et simultanée dans une population se croisant simple d'au moins deux génotypes discontinus. Le concept inclut des différences dans les génotypes variant dans la grandeur d'un site nucléotide simple (¤slPOLYMORPHISM¤sl, nucléotide SIMPLE) à de grands séquences nucléotide visibles à un niveau chromosomique. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;GeneticFunction"/>
		<OntoAD:interprets rdf:resource="&OntoAD;C0679560"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0003364">
		<skos:prefLabel xml:lang="en">Antihypertensive Agents</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AntihypertensiveAgents</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Antihypertenseurs</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Antihypertenseurs</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">antihypertensive</skos:altLabel>
		<skos:altLabel xml:lang="en">Antihypertensive Drugs</skos:altLabel>
		<skos:altLabel xml:lang="en">Anti-Hypertensive Agents</skos:altLabel>
		<skos:altLabel xml:lang="en">Anti-Hypertensive Drugs</skos:altLabel>
		<skos:altLabel xml:lang="en">Anti-Hypertensives</skos:altLabel>
		<skos:altLabel xml:lang="en">Antihypertensives</skos:altLabel>
		<skos:altLabel xml:lang="en">Hypotensive agent</skos:altLabel>
		<skos:altLabel xml:lang="en">Hypotensives</skos:altLabel>
		<skos:altLabel xml:lang="en">Hypotensive Drugs</skos:altLabel>
		<skos:altLabel xml:lang="en">blood pressure lowering drug</skos:altLabel>
		<skos:altLabel xml:lang="en">High Blood Pressure Medicines</skos:altLabel>
		<skos:altLabel xml:lang="en">Antihypertensive Medicines</skos:altLabel>
		<skos:altLabel xml:lang="en">Blood Pressure Medicines</skos:altLabel>
		<skos:altLabel xml:lang="fr">Anti-hypertenseurs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments antihypertenseurs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents antihypertenseurs</skos:altLabel>
		<skos:altLabel xml:lang="fr">agent hypotenseur</skos:altLabel>
		<skos:altLabel xml:lang="fr">médicament antihypertenseur</skos:altLabel>
		<skos:altLabel xml:lang="fr">agent antihypertenseur</skos:altLabel>
		<skos:altLabel xml:lang="fr">antihypertenseur</skos:altLabel>
		<skos:definition xml:lang="en">Drugs used in the treatment of acute or chronic vascular HYPERTENSION regardless of pharmacological mechanism. Among the antihypertensive agents are DIURETICS; (especially DIURETICS, THIAZIDE); ADRENERGIC BETA-ANTAGONISTS; ADRENERGIC ALPHA-ANTAGONISTS; ANGIOTENSIN-CONVERTING ENZYME INHIBITORS; CALCIUM CHANNEL BLOCKERS; GANGLIONIC BLOCKERS; and VASODILATOR AGENTS. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr"> Médicament qui lutte contre l'excès de tension artérielle. Les principaux sont les bêtabloquants, les diurétiques, les inhibiteurs calciques, les inhibiteurs de l'enzyme de conversion, les inhibiteurs de l'angiotensine IIet les vasodilatateurs. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0007220"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2697969"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0034656">
		<skos:prefLabel xml:lang="en">Randomization</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Randomization</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Attribution aléatoire</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AttributionAléatoire</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">randomisation</skos:altLabel>
		<skos:altLabel xml:lang="en">Random Allocation</skos:altLabel>
		<skos:altLabel xml:lang="en">RANDOM</skos:altLabel>
		<skos:altLabel xml:lang="en">randomized</skos:altLabel>
