	<owl:Class rdf:about="&OntoAD;C0018724">
		<skos:prefLabel xml:lang="en">Health Personnel</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">HealthPersonnel</skos:hiddenLabel>
