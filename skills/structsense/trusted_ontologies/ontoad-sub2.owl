		<skos:altLabel xml:lang="fr">TROUBLE AFFECTIF</skos:altLabel>
		<skos:altLabel xml:lang="fr">Troubles de l'affectivité</skos:altLabel>
		<skos:altLabel xml:lang="fr">Trouble de l'humeur</skos:altLabel>
		<skos:altLabel xml:lang="fr">trouble de l'affect</skos:altLabel>
		<skos:altLabel xml:lang="fr">Troubles de l’humeur [affectifs]</skos:altLabel>
