		<skos:altLabel xml:lang="fr">flavine-adénine-dinucléotide</skos:altLabel>
		<skos:altLabel xml:lang="fr">FAD</skos:altLabel>
		<skos:definition xml:lang="en">A condensation product of riboflavin and adenosine diphosphate. The coenzyme of various aerobic dehydrogenases, e.g., D-amino acid oxidase and L-amino acid oxidase. (Lehninger, Principles of Biochemistry, 1982, p972) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0035527"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0030016">
		<skos:prefLabel xml:lang="en">Oxidoreductase</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Oxidoreductase</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Oxidoreductases</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Oxidoreductases</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Dehydrogenases</skos:altLabel>
		<skos:altLabel xml:lang="en">Reductases</skos:altLabel>
		<skos:altLabel xml:lang="en">Dehydrogenase</skos:altLabel>
		<skos:altLabel xml:lang="en">Reductase</skos:altLabel>
		<skos:altLabel xml:lang="en">Oxidoreductases</skos:altLabel>
		<skos:altLabel xml:lang="fr">Oxydoréductases</skos:altLabel>
		<skos:altLabel xml:lang="fr">oxydoréductase</skos:altLabel>
		<skos:definition xml:lang="en">The class of all enzymes catalyzing oxidoreduction reactions. The substrate that is oxidized is regarded as a hydrogen donor. The systematic name is based on donor:acceptor oxidoreductase. The recommended name will be dehydrogenase, wherever this is possible; as an alternative, reductase can be used. Oxidase is only used in cases where O2 is the acceptor. (Enzyme Nomenclature, 1992, p9) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0014442"/>
		<OntoAD:is_biochemical_function_of_gene_product rdf:resource="&OntoAD;C0010762"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1333402"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1335186"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0054450">
		<skos:prefLabel xml:lang="en">Calcineurin</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Calcineurin</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Calcineurine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Calcineurine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Protein Phosphatase-2B</skos:altLabel>
		<skos:altLabel xml:lang="en">PROTEIN PHOSPHATASE B 02</skos:altLabel>
		<skos:altLabel xml:lang="en">Protein Phosphatase 3</skos:altLabel>
		<skos:altLabel xml:lang="fr">PP2B</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine-phosphatase-3</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protein Phosphatase-2B</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine-phosphatase-2B</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protein Phosphatase 3</skos:altLabel>
		<skos:definition xml:lang="en">A CALCIUM and CALMODULIN-dependent serine/threonine protein phosphatase that is composed of the calcineurin A catalytic subunit and the calcineurin B regulatory subunit. Calcineurin has been shown to dephosphorylate a number of phosphoproteins including HISTONES; MYOSIN LIGHT CHAIN; and the regulatory subunits of CAMP-DEPENDENT PROTEIN KINASES. It is involved in the regulation of signal transduction and is the target of an important class of immunophilin-immunosuppressive drug complexes. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Protéine-phosphatase Ca2+/calmoduline-dépendante composée d'une sous-unité catalyrtique et d'une sous-unité régulatrice. (source : MSHFRE)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0031686"/>
		<OntoAD:gene_product_has_associated_anatomy rdf:resource="&OntoAD;C0006104"/>
		<OntoAD:gene_product_plays_role_in_biological_process rdf:resource="&OntoAD;C0037083"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0036773">
		<skos:prefLabel xml:lang="en">Serum Albumin</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">SerumAlbumin</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Sérumalbumine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Sérumalbumine</skos:hiddenLabel>
		<skos:altLabel xml:lang="fr">Albumine sérique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Sérum-albumine</skos:altLabel>
		<skos:altLabel xml:lang="fr">Albumine du sérum sanguin</skos:altLabel>
		<skos:altLabel xml:lang="fr">Albumine du sérum</skos:altLabel>
		<skos:definition xml:lang="en">A major protein in the BLOOD. It is important in maintaining the colloidal osmotic pressure and transporting large organic molecules. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0033684"/>
	</owl:Class>

