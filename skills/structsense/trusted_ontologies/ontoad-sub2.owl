		<skos:altLabel xml:lang="en">PTGS2</skos:altLabel>
		<skos:altLabel xml:lang="en">Prostaglandin-endoperoxide synthase isoform 2</skos:altLabel>
		<skos:altLabel xml:lang="en">COX-2 Prostaglandin Synthase</skos:altLabel>
		<skos:altLabel xml:lang="en">CYCLOOXYGENASE 002</skos:altLabel>
		<skos:altLabel xml:lang="en">PGHS-2</skos:altLabel>
		<skos:altLabel xml:lang="fr">COX-2</skos:altLabel>
		<skos:altLabel xml:lang="fr">COX-2 prostaglandin synthase</skos:altLabel>
		<skos:altLabel xml:lang="fr">COX2</skos:altLabel>
		<skos:altLabel xml:lang="fr">Cyclo-oxygénase II</skos:altLabel>
		<skos:altLabel xml:lang="fr">Cyclo-oxygénase-2</skos:altLabel>
		<skos:altLabel xml:lang="fr">Cyclooxygénase-2</skos:altLabel>
		<skos:altLabel xml:lang="fr">PGH-synthase COX-2</skos:altLabel>
		<skos:altLabel xml:lang="fr">PGHS-2</skos:altLabel>
		<skos:altLabel xml:lang="fr">PTGS2</skos:altLabel>
		<skos:altLabel xml:lang="fr">Prostaglandin synthase COX-2</skos:altLabel>
		<skos:altLabel xml:lang="fr">Prostaglandine H synthase-2</skos:altLabel>
		<skos:definition xml:lang="en">An inducibly-expressed subtype of prostaglandin-endoperoxide synthase. It plays an important role in many cellular processes and INFLAMMATION. It is the target of COX2 INHIBITORS. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0033551"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0033607">
