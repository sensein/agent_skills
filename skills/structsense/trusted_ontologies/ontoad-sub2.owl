	<owl:Class rdf:about="&OntoAD;C0751937">
		<skos:prefLabel xml:lang="en">Olfactory Nerve Diseases</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">OlfactoryNerveDiseases</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Atteintes du nerf olfactif</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AtteintesDuNerfOlfactif</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Disorder of the first cranial nerve</skos:altLabel>
		<skos:altLabel xml:lang="en">Disorder of olfactory nerve</skos:altLabel>
		<skos:altLabel xml:lang="en">Disorders of olfactory nerve</skos:altLabel>
		<skos:altLabel xml:lang="en">Disorders of the first nerve</skos:altLabel>
		<skos:altLabel xml:lang="en">First cranial nerve disease or syndrome</skos:altLabel>
		<skos:altLabel xml:lang="en">Olfactory nerve disease or syndrome</skos:altLabel>
		<skos:altLabel xml:lang="en">First Cranial Nerve Diseases</skos:altLabel>
		<skos:altLabel xml:lang="en">Cranial Nerve I Diseases</skos:altLabel>
		<skos:altLabel xml:lang="en">Cranial Nerve I Disorders</skos:altLabel>
		<skos:altLabel xml:lang="en">Disorder of the 1st Nerve</skos:altLabel>
		<skos:altLabel xml:lang="en">disease; cranial nerve, first</skos:altLabel>
		<skos:altLabel xml:lang="en">disease; olfactory nerve</skos:altLabel>
		<skos:altLabel xml:lang="en">n.olfactorius; disorder</skos:altLabel>
		<skos:altLabel xml:lang="en">CRANIAL NERVE I DIS</skos:altLabel>
		<skos:altLabel xml:lang="en">FIRST CRANIAL NERVE DIS</skos:altLabel>
		<skos:altLabel xml:lang="en">OLFACTORY NERVE DIS</skos:altLabel>
		<skos:altLabel xml:lang="fr">Affection du nerf olfactif</skos:altLabel>
		<skos:altLabel xml:lang="fr">Affections du nerf olfactif</skos:altLabel>
		<skos:altLabel xml:lang="fr">Atteintes de la 1ère paire crânienne</skos:altLabel>
		<skos:altLabel xml:lang="fr">Atteintes de la première paire crânienne</skos:altLabel>
		<skos:altLabel xml:lang="fr">Atteintes du nerf olfactif (Ier)</skos:altLabel>
		<skos:altLabel xml:lang="fr">affection du premier nerf crânien</skos:altLabel>
		<skos:definition xml:lang="en">Diseases of the first cranial (olfactory) nerve, which usually feature anosmia or other alterations in the sense of smell and taste. Anosmia may be associated with NEOPLASMS; CENTRAL NERVOUS SYSTEM INFECTIONS; CRANIOCEREBRAL TRAUMA; inherited conditions; toxins; METABOLIC DISEASES; tobacco abuse; and other conditions. (Adams et al., Principles of Neurology, 6th ed, pp229-31) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0006111"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0010266"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0679441"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:disease_has_associated_anatomic_site rdf:resource="&OntoAD;C0027763"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0346319">
		<skos:prefLabel xml:lang="en">Neoplasm of olfactory nerve</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">NeoplasmOfOlfactoryNerve</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Tumor of olfactory tract</skos:altLabel>
		<skos:altLabel xml:lang="en">neoplasm of first cranial nerve</skos:altLabel>
		<skos:altLabel xml:lang="en">Tumor of the First Cranial Nerve</skos:altLabel>
		<skos:altLabel xml:lang="en">Neoplasms, Cranial Nerve I</skos:altLabel>
		<skos:altLabel xml:lang="en">Olfactory Neural Neoplasm</skos:altLabel>
		<skos:altLabel xml:lang="en">Tumor of the Olfactory Nerve</skos:altLabel>
		<skos:altLabel xml:lang="en">Olfactory Neural Tumor</skos:altLabel>
		<skos:definition xml:lang="en">Benign and malignant neoplasms which arise from or metastasize to the olfactory or first cranial nerve. Clinical features may include facial pain and impairments of taste or smell. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0751937"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1263885"/>
		<OntoAD:disease_has_associated_anatomic_site rdf:resource="&OntoAD;C0027763"/>
		<OntoAD:has_associated_morphology rdf:resource="&OntoAD;C0027651"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0496838">
		<skos:prefLabel xml:lang="en">Malignant neoplasm of olfactory nerve</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">MalignantNeoplasmOfOlfactoryNerve</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Olfactory nerve</skos:altLabel>
		<skos:altLabel xml:lang="en">malignant neoplasm of first cranial nerve</skos:altLabel>
		<skos:altLabel xml:lang="en">malignant tumor of first cranial nerve</skos:altLabel>
		<skos:altLabel xml:lang="en">Malignant Tumor of the Olfactory Nerve</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tumeur maligne du nerf olfactif</skos:altLabel>
		<skos:definition xml:lang="en">Abnormal malignant growth of the cells that comprise cranial nerve I. This can lead to difficulties with the sense of smell. Since taste and smell are intimately linked in terms of the enjoyment of food, a deficiency in the ability to smell can lead to decreased food intake with possible malnutrition. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0346319"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0153644"/>
		<OntoAD:disease_has_associated_anatomic_site rdf:resource="&OntoAD;C0027763"/>
		<OntoAD:has_associated_morphology rdf:resource="&OntoAD;C1288351"/>
	</owl:Class>

