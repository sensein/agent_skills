		<skos:altLabel xml:lang="fr">Thrombase</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation de thrombine</skos:altLabel>
		<skos:definition xml:lang="en">An enzyme formed from PROTHROMBIN that converts FIBRINOGEN to FIBRIN. (source : MSH)</skos:definition>
