		<skos:hiddenLabel xml:lang="en">Deficiency</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">déficient</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Déficient</skos:hiddenLabel>
