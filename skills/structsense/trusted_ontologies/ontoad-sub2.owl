		<skos:altLabel xml:lang="en">Vitamin E each test</skos:altLabel>
		<skos:altLabel xml:lang="en">vtmn E ea.tst</skos:altLabel>
		<skos:altLabel xml:lang="en">VITE</skos:altLabel>
		<skos:altLabel xml:lang="en">vitamin E blood level test</skos:altLabel>
		<skos:altLabel xml:lang="en">vitamin E test</skos:altLabel>
		<skos:altLabel xml:lang="fr">dosage de la vitamine E</skos:altLabel>
		<skos:altLabel xml:lang="fr">dosage de l'alpha-tocophérol</skos:altLabel>
		<skos:altLabel xml:lang="fr">dosage du tocophérol</skos:altLabel>
		<skos:definition xml:lang="en">The determination of the amount of Vitamin E present in a sample. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0428580"/>
		<OntoAD:has_method rdf:resource="&OntoAD;C0242485"/>
