		<skos:altLabel xml:lang="fr">groupes</skos:altLabel>
		<skos:altLabel xml:lang="fr">population</skos:altLabel>
		<skos:altLabel xml:lang="fr">populations</skos:altLabel>
		<skos:definition xml:lang="en">Individuals classified according to their sex, racial origin, religion, common place of living, financial or social status, or some other cultural or behavioral attribute. (UMLS, 2003) (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">individus ont classifié selon leur origine sexuelle, de race, religion, l'endroit commun de vie, statut financier ou social, ou autre attribut culturel ou de comportement. (traduit de 'UMLS, 2003') (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0037414"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1513302">
		<skos:prefLabel xml:lang="en">Mild Adverse Event</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">MildAdverseEvent</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">MILD</skos:altLabel>
		<skos:altLabel xml:lang="en">Grade 1</skos:altLabel>
		<skos:altLabel xml:lang="en">Common Terminology Criteria for Adverse Events Grade 1</skos:altLabel>
		<skos:altLabel xml:lang="en">Grade 1 Mild Adverse Event</skos:altLabel>
		<skos:altLabel xml:lang="en">CTCAE Grade 1</skos:altLabel>
		<skos:altLabel xml:lang="en">Standard Toxicity Grade 1</skos:altLabel>
		<skos:altLabel xml:lang="en">CTCAE v4 Grade 1</skos:altLabel>
		<skos:definition xml:lang="en">A type of adverse event that is usually transient and may require only minimal treatment or therapeutic intervention. The event does not generally interfere with usual activities of daily living. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2827350"/>
	</owl:Class>

