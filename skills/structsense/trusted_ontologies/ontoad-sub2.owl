		<skos:hiddenLabel xml:lang="fr">EntretiensCommeSujet</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">interviews</skos:altLabel>
		<skos:altLabel xml:lang="en">Interviews as Topic</skos:altLabel>
		<skos:altLabel xml:lang="fr">entretien</skos:altLabel>
		<skos:altLabel xml:lang="fr">Interviews comme sujet</skos:altLabel>
		<skos:definition xml:lang="en">Conversations with an individual or individuals held in order to obtain information about their background and other personal biographical data, their attitudes and opinions, etc. It includes school admission or job interviews. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Conversations avec un individu ou des individus afin d'obtenir des informations sur leur passé et d'autres données biographiques personnelles, leurs attitudes et avis, etc... Ils incluent les entretiens d'admission pour une école ou les entrevues pour un emploi.  (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0038951"/>
	</owl:Class>

