	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0085418">
		<skos:prefLabel xml:lang="en">Neurofilament Proteins</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">NeurofilamentProteins</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Protéines neurofilamenteuses</skos:prefLabel>
