		<skos:prefLabel xml:lang="fr">Soins aux patients</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">SoinsAuxPatients</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">care patients</skos:altLabel>
		<skos:altLabel xml:lang="en">care of patients</skos:altLabel>
		<skos:altLabel xml:lang="en">carers of patients</skos:altLabel>
		<skos:altLabel xml:lang="en">caregivers of patients</skos:altLabel>
		<skos:altLabel xml:lang="en">primary care</skos:altLabel>
		<skos:altLabel xml:lang="en">primary health care</skos:altLabel>
		<skos:altLabel xml:lang="en">Patient Care Delivery</skos:altLabel>
		<skos:altLabel xml:lang="fr">soins des patients</skos:altLabel>
		<skos:altLabel xml:lang="fr">soins primaires</skos:altLabel>
		<skos:altLabel xml:lang="fr">Soins aux malades</skos:altLabel>
		<skos:altLabel xml:lang="fr">Soins de santé aux patients</skos:altLabel>
		<skos:definition xml:lang="en">The services rendered by members of the health profession and non-professionals under their supervision for the benefit of the patient. (From Dorland, 28th ed, p269) (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Services fournis par les membres de la profession médicale et par les non-professionnels sous leur supervision au profit du patient. (Tiré de Dorland, 28th ed, p269) (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0086388"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0039796"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1519073">
