		<skos:altLabel xml:lang="en">Insecticide</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents insecticides</skos:altLabel>
		<skos:altLabel xml:lang="fr">Produits insecticides</skos:altLabel>
		<skos:altLabel xml:lang="fr">insecticide</skos:altLabel>
		<skos:altLabel xml:lang="fr">pesticide pour invertébrés</skos:altLabel>
		<skos:definition xml:lang="en">Pesticides designed to control insects that are harmful to man. The insects may be directly harmful, as those acting as disease vectors, or indirectly harmful, as destroyers of crops, food products, or textile fabrics. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0031253"/>
	</owl:Class>

