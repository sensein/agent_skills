		<skos:altLabel xml:lang="en">Epidermal Cell Derived Thymocyte-Activating Factor</skos:altLabel>
		<skos:altLabel xml:lang="en">Lymphocyte-Activating Factor</skos:altLabel>
		<skos:altLabel xml:lang="en">Lymphocyte-Stimulating Hormone</skos:altLabel>
		<skos:altLabel xml:lang="en">Macrophage Cell Factor</skos:altLabel>
		<skos:altLabel xml:lang="en">T Helper Factor</skos:altLabel>
		<skos:altLabel xml:lang="en">IL-1</skos:altLabel>
		<skos:altLabel xml:lang="en">Interleukin I</skos:altLabel>
		<skos:altLabel xml:lang="en">LAF</skos:altLabel>
		<skos:altLabel xml:lang="en">LAF (lymphocyte activating factor)</skos:altLabel>
		<skos:altLabel xml:lang="en">IL1B</skos:altLabel>
		<skos:altLabel xml:lang="en">IL1</skos:altLabel>
		<skos:altLabel xml:lang="en">IL 001</skos:altLabel>
		<skos:altLabel xml:lang="en">INTERLEUKIN 001</skos:altLabel>
		<skos:altLabel xml:lang="en">interleukin-1 (IL-1)</skos:altLabel>
		<skos:altLabel xml:lang="fr">IL-1</skos:altLabel>
		<skos:altLabel xml:lang="fr">Interleukine 1</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteur LAF</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteur d'activation des lymphocytes</skos:altLabel>
		<skos:altLabel xml:lang="fr">IL1 (Interleukine 1)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteur d'activation lymphocytaire LAF</skos:altLabel>
		<skos:altLabel xml:lang="fr">ETAF</skos:altLabel>
		<skos:altLabel xml:lang="fr">LAF (Lymphocyte-Activating Factor)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Epidermal Cell Derived Thymocyte-Activating Factor</skos:altLabel>
		<skos:altLabel xml:lang="fr">IL1</skos:altLabel>
		<skos:altLabel xml:lang="fr">LAF</skos:altLabel>
		<skos:altLabel xml:lang="fr">pyrogène endogène</skos:altLabel>
		<skos:altLabel xml:lang="fr">médiateur endogène leucocytaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">LEM</skos:altLabel>
		<skos:definition xml:lang="en">A soluble factor produced by MONOCYTES; MACROPHAGES, and other cells which activates T-lymphocytes and potentiates their response to mitogens or antigens. Interleukin-1 is a general term refers to either of the two distinct proteins, INTERLEUKIN-1ALPHA and INTERLEUKIN-1BETA. The biological effects of IL-1 include the ability to replace macrophage requirements for T-cell activation. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0021764"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1333196"/>
	</owl:Class>

