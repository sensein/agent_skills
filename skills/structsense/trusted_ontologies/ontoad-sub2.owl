		<skos:altLabel xml:lang="en">disease; arteriosclerotic, cardiovascular</skos:altLabel>
		<skos:altLabel xml:lang="en">Arterial Sclerosis</skos:altLabel>
		<skos:altLabel xml:lang="en">ASCVD (arteriosclerotic cardiovascular disease)</skos:altLabel>
		<skos:altLabel xml:lang="en">arteriosclerotic cardiovascular disease</skos:altLabel>
		<skos:altLabel xml:lang="en">arteriosclerotic CV disease</skos:altLabel>
		<skos:altLabel xml:lang="fr">Maladie cardiovasculaire artérioscléreuse</skos:altLabel>
		<skos:altLabel xml:lang="fr">MCV artérioscléreuse</skos:altLabel>
		<skos:altLabel xml:lang="fr">artériosclérose cardiovasculaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">dégénérescence cardiovasculaire par artériosclérose</skos:altLabel>
		<skos:altLabel xml:lang="fr">maladie cardiovasculaire par artériosclérose</skos:altLabel>
		<skos:altLabel xml:lang="fr">sclérose cardiovasculaire par artériosclérose</skos:altLabel>
		<skos:altLabel xml:lang="fr">maladie vasculaire artériosclérotique</skos:altLabel>
		<skos:altLabel xml:lang="fr">artérioscléreux</skos:altLabel>
		<skos:definition xml:lang="en">Thickening and loss of elasticity of the walls of ARTERIES of all sizes. There are many forms classified by the types of lesions and arteries involved, such as ATHEROSCLEROSIS with fatty lesions in the ARTERIAL INTIMA of medium and large muscular arteries. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1956346"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1285162"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0011164"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0410013"/>
