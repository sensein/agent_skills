	<owl:Class rdf:about="&OntoAD;C0003076">
		<skos:prefLabel xml:lang="en">Aniridia</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Aniridia</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Aniridie</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Aniridie</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Irideremia</skos:altLabel>
		<skos:altLabel xml:lang="en">Congenital absence of iris</skos:altLabel>
		<skos:altLabel xml:lang="en">Absence of iris</skos:altLabel>
		<skos:altLabel xml:lang="en">Absent iris</skos:altLabel>
		<skos:altLabel xml:lang="en">Agenesis of iris</skos:altLabel>
		<skos:altLabel xml:lang="en">Aplasia of iris</skos:altLabel>
		<skos:altLabel xml:lang="en">Anirida</skos:altLabel>
		<skos:altLabel xml:lang="en">Congenital aniridia</skos:altLabel>
		<skos:altLabel xml:lang="en">ANIRIDIA II, FORMERLY</skos:altLabel>
		<skos:altLabel xml:lang="en">AN2, FORMERLY</skos:altLabel>
		<skos:altLabel xml:lang="fr">ABSENCE D'IRIS</skos:altLabel>
		<skos:altLabel xml:lang="fr">Iridérémie totale</skos:altLabel>
		<skos:altLabel xml:lang="fr">Absence (congénitale) d’iris</skos:altLabel>
		<skos:definition xml:lang="en">A congenital abnormality in which there is only a rudimentary iris. This is due to the failure of the optic cup to grow. Aniridia also occurs in a hereditary form, usually autosomal dominant. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003119"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0339309"/>
