		<skos:hiddenLabel xml:lang="en">MedicalHistory</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Anamnèse (médecine)</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Anamnèse(médecine)</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">personal health record</skos:altLabel>
		<skos:altLabel xml:lang="en">History of</skos:altLabel>
		<skos:altLabel xml:lang="en">Past Medical History</skos:altLabel>
		<skos:altLabel xml:lang="en">Personal History</skos:altLabel>
		<skos:altLabel xml:lang="en">Personal Medical History</skos:altLabel>
		<skos:altLabel xml:lang="en">PMH</skos:altLabel>
		<skos:altLabel xml:lang="fr">Anamnèse</skos:altLabel>
		<skos:definition xml:lang="en">A collection of information about a person's health. It may include information about allergies, illnesses and surgeries, and dates and results of physical exams, tests, screenings, and immunizations. It may also include information about medicines taken and about diet and exercise. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;Finding"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0038951">
		<skos:prefLabel xml:lang="en">Surveys</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Surveys</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Enquêtes</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Enquêtes</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">survey</skos:altLabel>
		<skos:altLabel xml:lang="en">Survey Instrument</skos:altLabel>
		<skos:altLabel xml:lang="en">questionnaire or interview</skos:altLabel>
		<skos:altLabel xml:lang="fr">enquête</skos:altLabel>
		<skos:altLabel xml:lang="fr">Sondages</skos:altLabel>
		<skos:definition xml:lang="en">A document used in a method of data collection that involves interviewing (or giving questionnaires to) a representative and often large group of people. (source : NCI)</skos:definition>
		<skos:definition xml:lang="fr">Rassemblement systématique des données dans un but particulier à partir de diverses sources, y compris des questionnaires, des entrevues, des observations, d'enregistrements existants, et de dispositifs électroniques. Le processus est habituellement préliminaire à l'analyse statistique des données. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;IntellectualProduct"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0282462">
		<skos:prefLabel xml:lang="en">Phase 4 Clinical Trials</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Phase4ClinicalTrials</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Essais cliniques de phase IV comme sujet</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">EssaisCliniquesDePhaseIVCommeSujet</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Clinical Trials, Phase IV</skos:altLabel>
		<skos:altLabel xml:lang="en">Phase IV Trial</skos:altLabel>
		<skos:altLabel xml:lang="en">Phase IV Study</skos:altLabel>
		<skos:altLabel xml:lang="en">Phase 4 Study</skos:altLabel>
		<skos:altLabel xml:lang="en">Trial Phase 4</skos:altLabel>
		<skos:altLabel xml:lang="en">Clinical Trials, Phase 4 as Topic</skos:altLabel>
		<skos:altLabel xml:lang="en">Clinical Trials, Phase IV as Topic</skos:altLabel>
		<skos:altLabel xml:lang="fr">Essais cliniques de phase 4 comme sujet</skos:altLabel>
		<skos:definition xml:lang="en">Planned post-marketing studies of diagnostic, therapeutic, or prophylactic drugs, devices, or techniques that have been approved for general sale. These studies are often conducted to obtain additional data about the safety and efficacy of a product. This concept includes phase IV studies conducted in both the U.S. and in other countries. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2347801"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1517874">
		<skos:prefLabel xml:lang="en">Life Threatening Adverse Event</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">LifeThreateningAdverseEvent</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Grade 4</skos:altLabel>
		<skos:altLabel xml:lang="en">LIFE THREATENING</skos:altLabel>
		<skos:altLabel xml:lang="en">Common Terminology Criteria for Adverse Events Grade 4</skos:altLabel>
		<skos:altLabel xml:lang="en">Grade 4 Life Threatening or Disabling Adverse Event</skos:altLabel>
		<skos:altLabel xml:lang="en">CTCAE Grade 4</skos:altLabel>
		<skos:altLabel xml:lang="en">Standard Toxicity Grade 4</skos:altLabel>
		<skos:altLabel xml:lang="en">Life Threatening or Disabling Adverse Event</skos:altLabel>
		<skos:altLabel xml:lang="en">AESLIFE</skos:altLabel>
		<skos:altLabel xml:lang="en">CTCAE v4 Grade 4</skos:altLabel>
		<skos:altLabel xml:lang="en">AESDISAB</skos:altLabel>
		<skos:definition xml:lang="en">Any adverse event that places the patient, in the view of the initial reporter, at immediate risk of death from the adverse event as it occurred, i.e., it does not include an adverse experience that, had it occurred in a more severe form, might have caused death. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2827351"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0023981">
