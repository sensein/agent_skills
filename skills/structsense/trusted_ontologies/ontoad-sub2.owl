	<owl:Class rdf:about="&OntoAD;C0002624">
		<skos:prefLabel xml:lang="en">Retrograde amnesia</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">RetrogradeAmnesia</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Amnésie rétrograde</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AmnésieRétrograde</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Amnesia (retrograde)</skos:altLabel>
		<skos:altLabel xml:lang="en">RA  Retrograde amnesia</skos:altLabel>
		<skos:altLabel xml:lang="en">Amnesia, Retrograde</skos:altLabel>
		<skos:definition xml:lang="en">Loss of the ability to recall information that had been previously encoded in memory prior to a specified or approximate point in time. This process may be organic or psychogenic in origin. Organic forms may be associated with CRANIOCEREBRAL TRAUMA; CEREBROVASCULAR ACCIDENTS; SEIZURES; DEMENTIA; and a wide variety of other conditions that impair cerebral function. (From Adams et al., Principles of Neurology, 6th ed, pp426-9) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0002622"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:interprets rdf:resource="&OntoAD;C0392335"/>
		<OntoAD:interprets rdf:resource="&OntoAD;C1285654"/>
	</owl:Class>

