	<owl:Class rdf:about="&OntoAD;C0034394">
		<skos:prefLabel xml:lang="en">Questionnaires</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Questionnaires</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Questionnaires</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Questionnaires</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">questionnaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">questionnaire</skos:altLabel>
		<skos:definition xml:lang="en">Predetermined sets of questions used to collect data - clinical data, social status, occupational group, etc. The term is often applied to a self-completed survey instrument. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">ensembles prédéterminés des questions ont eu l'habitude de recueillir des données - les données cliniques, le statut social, le groupe du métier, etc. Le terme est souvent appliqué à un instrument d'enquête accompli de soi. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0038951"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0014507">
		<skos:prefLabel xml:lang="en">Epidemiology</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Epidemiology</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Épidémiologie</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Épidémiologie</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Epidemiologic</skos:altLabel>
		<skos:altLabel xml:lang="en">EPIDEMIOL</skos:altLabel>
		<skos:altLabel xml:lang="en">Epidemiological</skos:altLabel>
		<skos:definition xml:lang="en">Field of medicine concerned with the determination of causes, incidence, and characteristic behavior of disease outbreaks affecting human populations. It includes the interrelationships of host, agent, and environment as related to the distribution and control of disease. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Discipline médicale traitant la détermination des causes, l'incidence et le déroulement caractéristique des épidémies touchant les populations humaines. Cela inclut l'interrelation entre hôte, agent et environnement en lien avec la répartition et le contrôle de la maladie. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0034019"/>
	</owl:Class>

