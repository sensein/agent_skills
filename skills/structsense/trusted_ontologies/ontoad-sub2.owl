		<skos:altLabel xml:lang="en">Compulsion,</skos:altLabel>
		<skos:altLabel xml:lang="en">COMPULSIONS AND COMPULSIVE DISORDERS</skos:altLabel>
		<skos:altLabel xml:lang="en">COMPULSIVENESS</skos:altLabel>
		<skos:altLabel xml:lang="fr">Conduite compulsive</skos:altLabel>
		<skos:altLabel xml:lang="fr">Compulsions</skos:altLabel>
		<skos:altLabel xml:lang="fr">compulsion</skos:altLabel>
		<skos:definition xml:lang="en">The behavior of performing an act persistently and repetitively without it leading to reward or pleasure. The act is usually a small, circumscribed behavior, almost ritualistic, yet not pathologically disturbing. Examples of compulsive behavior include twirling of hair, checking something constantly, not wanting pennies in change, straightening tilted pictures, etc. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1306597"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0004927"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0278060"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2039359"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:manifestation_of rdf:resource="&OntoAD;C0040517"/>
	</owl:Class>

