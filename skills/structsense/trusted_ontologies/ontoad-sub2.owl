		<OntoAD:location_of rdf:resource="&OntoAD;C0243026"/>
		<OntoAD:location_of rdf:resource="&OntoAD;C0034150"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0229664">
		<skos:prefLabel xml:lang="en">peripheral blood</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">PeripheralBlood</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Reticuloendothelial System, Blood</skos:altLabel>
		<skos:altLabel xml:lang="fr">sang, SAI</skos:altLabel>
		<skos:altLabel xml:lang="fr">sang périphérique, SAI</skos:altLabel>
		<skos:definition xml:lang="en">A tissue with red blood cells, white blood cells, platelets, and other substances suspended in fluid called plasma. Blood takes oxygen and nutrients to the tissues, and carries away wastes. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0005767"/>
		<OntoAD:has_physical_part_of_anatomic_structure rdf:resource="&OntoAD;C0032105"/>
