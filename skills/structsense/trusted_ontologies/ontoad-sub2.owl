		<skos:altLabel xml:lang="en">Antidiabetic Hormone</skos:altLabel>
		<skos:altLabel xml:lang="en">Hyperglycemic-glycogenolytic factor product</skos:altLabel>
		<skos:altLabel xml:lang="en">GCG</skos:altLabel>
