		<skos:altLabel xml:lang="en">Nervy</skos:altLabel>
		<skos:altLabel xml:lang="en">Feeling of Nervousness</skos:altLabel>
		<skos:altLabel xml:lang="fr">ETAT DE TENSION NERVEUSE</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tension nerveuse</skos:altLabel>
