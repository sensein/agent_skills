		<skos:altLabel xml:lang="en">CANCER, BRAIN ASTROCYTOMA</skos:altLabel>
		<skos:altLabel xml:lang="en">BRAIN TUMOR, ASTROCYTOMA</skos:altLabel>
		<skos:altLabel xml:lang="en">INTRACRANIAL NEOPLASM, ASTROCYTOMA</skos:altLabel>
		<skos:altLabel xml:lang="en">Astrocytic tumor of brain</skos:altLabel>
		<skos:altLabel xml:lang="en">Astrocytoma, no ICD-O subtype</skos:altLabel>
		<skos:altLabel xml:lang="en">Astrocytic Neoplasm</skos:altLabel>
		<skos:altLabel xml:lang="en">Astrocytic Tumor</skos:altLabel>
		<skos:altLabel xml:lang="fr">Gliome astrocytaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">astrocytome, SAI</skos:altLabel>
		<skos:altLabel xml:lang="fr">astrogliome (obs)</skos:altLabel>
		<skos:altLabel xml:lang="fr">astrocytome diffus</skos:altLabel>
		<skos:altLabel xml:lang="fr">astrocytome de bas grade</skos:altLabel>
		<skos:altLabel xml:lang="fr">astrocytome diffus de bas grade</skos:altLabel>
		<skos:definition xml:lang="en">Neoplasms of the brain and spinal cord derived from glial cells which vary from histologically benign forms to highly anaplastic and malignant tumors. Fibrillary astrocytomas are the most common type and may be classified in order of increasing malignancy (grades I through IV). In the first two decades of life, astrocytomas tend to originate in the cerebellar hemispheres; in adults, they most frequently arise in the cerebrum and frequently undergo malignant transformation. (From Devita et al., C (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0555198"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0085136"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0349541"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1333132"/>
