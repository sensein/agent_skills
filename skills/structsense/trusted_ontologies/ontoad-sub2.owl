		<skos:altLabel xml:lang="en">White matter of brain syndrome</skos:altLabel>
		<skos:altLabel xml:lang="en">BRAIN WHITE MATTER DISEASE</skos:altLabel>
		<skos:altLabel xml:lang="en">Leukoencephalopathy</skos:altLabel>
