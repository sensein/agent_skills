	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0035423">
		<skos:prefLabel xml:lang="en">Rheology</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Rheology</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Rhéologie</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Rhéologie</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">RHEOL</skos:altLabel>
		<skos:definition xml:lang="en">The study of the deformation and flow of matter, usually liquids or fluids, and of the plastic flow of solids. The concept covers consistency, dilatancy, liquefaction, resistance to flow, shearing, thixotrophy, and VISCOSITY. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;OccupationalActivity"/>
	</owl:Class>

