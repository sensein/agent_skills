	<owl:Class rdf:about="&OntoAD;C0063684">
		<skos:prefLabel xml:lang="en">Amylin</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Amylin</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Polypeptide amyloïde des ilots</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">PolypeptideAmyloïdeDesIlots</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">diabetes associated peptide</skos:altLabel>
		<skos:altLabel xml:lang="en">IAPP</skos:altLabel>
		<skos:altLabel xml:lang="en">Insulinoma Amyloid Polypeptide</skos:altLabel>
		<skos:altLabel xml:lang="en">Islet Amyloid Polypeptide</skos:altLabel>
		<skos:altLabel xml:lang="en">Pancreatic Amylin</skos:altLabel>
		<skos:altLabel xml:lang="en">Amlintide</skos:altLabel>
		<skos:altLabel xml:lang="en">Amylin product</skos:altLabel>
		<skos:altLabel xml:lang="en">IAPP Protein</skos:altLabel>
		<skos:altLabel xml:lang="fr">Amyline pancréatique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine IAPP</skos:altLabel>
		<skos:altLabel xml:lang="fr">Amyline</skos:altLabel>
		<skos:altLabel xml:lang="fr">Amlintide</skos:altLabel>
		<skos:altLabel xml:lang="fr">Polypeptide amyloïde de l'insulinome</skos:altLabel>
		<skos:definition xml:lang="en">A pancreatic beta-cell hormone that is co-secreted with INSULIN. It displays an anorectic effect on nutrient metabolism by inhibiting gastric acid secretion, gastric emptying and postprandial GLUCAGON secretion. Islet amyloid polypeptide can fold into AMYLOID FIBRILS that have been found as a major constituent of pancreatic AMYLOID DEPOSITS. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0935929"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003620"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0030292"/>
	</owl:Class>

