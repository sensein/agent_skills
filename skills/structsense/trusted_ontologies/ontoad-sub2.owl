	<owl:Class rdf:about="&OntoAD;C0026837">
		<skos:prefLabel xml:lang="en">Muscle Rigidity</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">MuscleRigidity</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Raideur musculaire</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">RaideurMusculaire</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Rigidity, Muscular</skos:altLabel>
		<skos:altLabel xml:lang="en">Rigid</skos:altLabel>
		<skos:altLabel xml:lang="en">Rigidity,</skos:altLabel>
		<skos:altLabel xml:lang="en">Rigor</skos:altLabel>
		<skos:altLabel xml:lang="en">Muscular rigor</skos:altLabel>
		<skos:altLabel xml:lang="en">rigidity</skos:altLabel>
		<skos:altLabel xml:lang="en">rigidity was noted</skos:altLabel>
		<skos:altLabel xml:lang="fr">RIGIDITE MUSCULAIRE</skos:altLabel>
		<skos:altLabel xml:lang="fr">Hypertonie</skos:altLabel>
		<skos:altLabel xml:lang="fr">Rigidité</skos:altLabel>
		<skos:altLabel xml:lang="fr">Etat de rigidité musculaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">rigide</skos:altLabel>
		<skos:altLabel xml:lang="fr">raide</skos:altLabel>
		<skos:definition xml:lang="en">Continuous involuntary sustained muscle contraction which is often a manifestation of BASAL GANGLIA DISEASES. When an affected muscle is passively stretched, the degree of resistance remains constant regardless of the rate at which the muscle is stretched. This feature helps to distinguish rigidity from MUSCLE SPASTICITY. (From Adams et al., Principles of Neurology, 6th ed, p73) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0026859"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2243075"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0026826"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:manifestation_of rdf:resource="&OntoAD;C0038868"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0007758">
		<skos:prefLabel xml:lang="en">Cerebellar Ataxia</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CerebellarAtaxia</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Ataxie cérébelleuse</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AtaxieCérébelleuse</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Cerebellar Incoordination</skos:altLabel>
		<skos:altLabel xml:lang="fr">Incoordination cérébelleuse</skos:altLabel>
		<skos:altLabel xml:lang="fr">Ataxie cérébellaire</skos:altLabel>
		<skos:definition xml:lang="en">Incoordination of voluntary movements that occur as a manifestation of CEREBELLAR DISEASES. Characteristic features include a tendency for limb movements to overshoot or undershoot a target (dysmetria), a tremor that occurs during attempted movements (intention TREMOR), impaired force and rhythm of diadochokinesis (rapidly alternating movements), and GAIT ATAXIA. (From Adams et al., Principles of Neurology, 6th ed, p90) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0033132"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0018802"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0040336"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0007765"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0018681"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0013362">
		<skos:prefLabel xml:lang="en">Dysarthria</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Dysarthria</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Dysarthrie</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Dysarthrie</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">DYSARTHROSIS</skos:altLabel>
		<skos:altLabel xml:lang="en">Dysarthosis</skos:altLabel>
		<skos:altLabel xml:lang="en">speech articulation dysarthria</skos:altLabel>
		<skos:altLabel xml:lang="en">Late eff CV-dysarthria</skos:altLabel>
		<skos:altLabel xml:lang="en">Late effects of cerebrovascular disease, dysarthria</skos:altLabel>
		<skos:altLabel xml:lang="fr">DYSARTHROSE</skos:altLabel>
		<skos:definition xml:lang="en">Disorders of speech articulation caused by imperfect coordination of pharynx, larynx, tongue, or face muscles. This may result from CRANIAL NERVE DISEASES; NEUROMUSCULAR DISEASES; CEREBELLAR DISEASES; BASAL GANGLIA DISEASES; BRAIN STEM diseases; or diseases of the corticobulbar tracts (see PYRAMIDAL TRACTS). The cortical language centers are intact in this condition. (From Adams et al., Principles of Neurology, 6th ed, p489) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0237479"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0037822"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0038454"/>
		<OntoAD:manifestation_of rdf:resource="&OntoAD;C0026896"/>
		<OntoAD:manifestation_of rdf:resource="&OntoAD;C0038868"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0001175"/>
		<OntoAD:may_be_treated_by rdf:resource="&OntoAD;C0009011"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0497406">
		<skos:prefLabel xml:lang="en">Overweight</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Overweight</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Surpoids</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Surpoids</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Overweight (BMI 30)</skos:altLabel>
		<skos:altLabel xml:lang="en">Patient overweight</skos:altLabel>
		<skos:altLabel xml:lang="en">Overweight (BMI 25-30)</skos:altLabel>
		<skos:altLabel xml:lang="en">OVER WEIGHT</skos:altLabel>
		<skos:altLabel xml:lang="en">clinical overweight</skos:altLabel>
		<skos:altLabel xml:lang="fr">Exces de poids (IMC 30)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Surcharge pondérale</skos:altLabel>
		<skos:altLabel xml:lang="fr">Excédent de poids</skos:altLabel>
		<skos:altLabel xml:lang="fr">Surplus de poids</skos:altLabel>
		<skos:altLabel xml:lang="fr">Excès de poids</skos:altLabel>
		<skos:altLabel xml:lang="fr">gain de poids corporel excessif</skos:altLabel>
		<skos:altLabel xml:lang="fr">patient en surpoids</skos:altLabel>
		<skos:definition xml:lang="en">A status with BODY WEIGHT that is above certain standard of acceptable or desirable weight. In the scale of BODY MASS INDEX, overweight is defined as having a BMI of 25.0-29.9 kg/m2. Overweight may or may not be due to increases in body fat (ADIPOSE TISSUE), hence overweight does not equal 'over fat'. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">statut avec le POIDS DE CORPS qui est au-dessus d'une certaine norme de poids acceptable ou désirable. Dans l'échelle d'INDEX DE MASSE DE CORPS, l'EXCÈS DE POIDS est défini comme le fait d'avoir un BMI de 25.0-29.9 kg/m2. l'EXCÈS DE POIDS peut ou pouvoir ne pas être en raison des augmentations dans le gras de corps (TISSU ADIPEUX), dorénavant l'EXCÈS DE POIDS n'égale pas ''sur le gras''. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0025517"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1305866"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0004015">
		<skos:prefLabel xml:lang="en">Aspartic Acid</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AsparticAcid</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Acide aspartique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AcideAspartique</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Asp</skos:altLabel>
		<skos:altLabel xml:lang="en">L-Aspartic Acid</skos:altLabel>
		<skos:definition xml:lang="en">One of the non-essential amino acids commonly occurring in the L-form. It is found in animals and plants, especially in sugar cane and sugar beets. It may be a neurotransmitter. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1268874"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0311461"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0311462"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2348255"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013182"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0028128">
		<skos:prefLabel xml:lang="en">Nitric Oxide</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">NitricOxide</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Monoxyde d'azote</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">MonoxydeD'azote</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Endogenous Nitrate Vasodilator</skos:altLabel>
		<skos:altLabel xml:lang="en">Endothelium-Derived Relaxing Factor</skos:altLabel>
		<skos:altLabel xml:lang="en">Nitrogen Monoxide</skos:altLabel>
		<skos:altLabel xml:lang="en">nitrogen protoxide</skos:altLabel>
		<skos:altLabel xml:lang="en">Nitric Oxide, Endothelium-Derived</skos:altLabel>
		<skos:altLabel xml:lang="en">Nitrogen oxide (NO)</skos:altLabel>
		<skos:altLabel xml:lang="en">Nitric oxide gas</skos:altLabel>
		<skos:altLabel xml:lang="en">NO  Nitric oxide</skos:altLabel>
		<skos:altLabel xml:lang="en">endothelial cell derived relaxing factor</skos:altLabel>
		<skos:altLabel xml:lang="en">Mononitrogen Monoxide</skos:altLabel>
		<skos:altLabel xml:lang="en">EDRF</skos:altLabel>
		<skos:altLabel xml:lang="en">vasodilators pulmonary nitric oxide</skos:altLabel>
		<skos:altLabel xml:lang="fr">Oxyde nitrique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Oxyde azotique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Monoxyde d'azote dérivé de l'endothélium</skos:altLabel>
		<skos:definition xml:lang="en">A free radical gas produced endogenously by a variety of mammalian cells, synthesized from ARGININE by NITRIC OXIDE SYNTHASE. Nitric oxide is one of the ENDOTHELIUM-DEPENDENT RELAXING FACTORS released by the vascular endothelium and mediates VASODILATION. It also inhibits platelet aggregation, induces disaggregation of aggregated platelets, and inhibits platelet adhesion to the vascular endothelium. Nitric oxide activates cytosolic GUANYLATE CYCLASE and thus elevates intracellular levels of CYCL (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0027908"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0006280"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2143186"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0028167"/>
		<OntoAD:induces rdf:resource="&OntoAD;C0041657"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013182"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0014939">
		<skos:prefLabel xml:lang="en">Estrogens</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Estrogens</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Oestrogènes</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Oestrogènes</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">estrogen</skos:altLabel>
		<skos:altLabel xml:lang="en">Estrogen preparation,</skos:altLabel>
		<skos:altLabel xml:lang="en">Estrogen product</skos:altLabel>
		<skos:altLabel xml:lang="en">Estrogenic preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">Estrogenic drug</skos:altLabel>
		<skos:altLabel xml:lang="en">Estrogenic Agents</skos:altLabel>
		<skos:altLabel xml:lang="en">Estrogenic Compounds</skos:altLabel>
		<skos:altLabel xml:lang="en">Therapeutic Estrogen</skos:altLabel>
		<skos:altLabel xml:lang="fr">Ostrogenes</skos:altLabel>
		<skos:altLabel xml:lang="fr">Oestrogene</skos:altLabel>
		<skos:altLabel xml:lang="fr">Estrogènes</skos:altLabel>
		<skos:altLabel xml:lang="fr">Composés estrogéniques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents oestrogéniques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Composés oestrogéniques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents estrogéniques</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation d'oestrogènes</skos:altLabel>
		<skos:altLabel xml:lang="fr">médicament oestrogénique</skos:altLabel>
		<skos:altLabel xml:lang="fr">estrogène</skos:altLabel>
		<skos:definition xml:lang="en">Compounds that interact with ESTROGEN RECEPTORS in target tissues to bring about the effects similar to those of ESTRADIOL. Estrogens stimulate the female reproductive organs, and the development of secondary female SEX CHARACTERISTICS. Estrogenic chemicals include natural, synthetic, steroidal, or non-steroidal compounds. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0301819"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0036884"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C1458155"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013182"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0017817">
		<skos:prefLabel xml:lang="en">Glutathione</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Glutathione</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Glutathion</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Glutathion</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Glycine, N-(N-L-gamma-glutamyl-L-cysteinyl)-</skos:altLabel>
		<skos:altLabel xml:lang="en">gamma-L-Glu-L-Cys-Gly</skos:altLabel>
		<skos:altLabel xml:lang="en">gamma-L-Glutamyl-L-Cysteinylglycine</skos:altLabel>
		<skos:altLabel xml:lang="en">GSH</skos:altLabel>
		<skos:altLabel xml:lang="fr">Philothion</skos:altLabel>
		<skos:altLabel xml:lang="fr">gamma-L-Glutamyl-L-cystéine</skos:altLabel>
		<skos:altLabel xml:lang="fr">gamma-Glutamyl-cystéinyl-glycocolle</skos:altLabel>
		<skos:definition xml:lang="en">A tripeptide with many roles in cells. It conjugates to drugs to make them more soluble for excretion, is a cofactor for some enzymes, is involved in protein disulfide bond rearrangement and reduces peroxides. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0242295"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0002520"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003402"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0311439"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0033308">
		<skos:prefLabel xml:lang="en">Progesterone</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Progesterone</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Progestérone</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Progestérone</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Corpus Luteum Hormone</skos:altLabel>
		<skos:altLabel xml:lang="en">Pregnenedione</skos:altLabel>
		<skos:altLabel xml:lang="en">Pregn-4-ene-3,20-dione</skos:altLabel>
		<skos:altLabel xml:lang="en">Luteal hormone</skos:altLabel>
		<skos:altLabel xml:lang="en">Luteine</skos:altLabel>
		<skos:altLabel xml:lang="en">Pregnendione preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">Progesterone preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">Progesterone product</skos:altLabel>
		<skos:altLabel xml:lang="en">PRG  Progesterone</skos:altLabel>
		<skos:altLabel xml:lang="en">PRG</skos:altLabel>
		<skos:altLabel xml:lang="en">Delta4-pregnene-3,20-dione</skos:altLabel>
		<skos:altLabel xml:lang="en">Therapeutic Progesterone</skos:altLabel>
		<skos:altLabel xml:lang="en">progestrogens progesterone</skos:altLabel>
		<skos:altLabel xml:lang="fr">Prégnènedione</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation de progestérone</skos:altLabel>
		<skos:altLabel xml:lang="fr">lutéine</skos:altLabel>
		<skos:altLabel xml:lang="fr">hormone lutéale</skos:altLabel>
		<skos:definition xml:lang="en">The major progestational steroid that is secreted primarily by the CORPUS LUTEUM and the PLACENTA. Progesterone acts on the UTERUS, the MAMMARY GLANDS and the BRAIN. It is required in EMBRYO IMPLANTATION; PREGNANCY maintenance, and the development of mammary tissue for MILK production. Progesterone, converted from PREGNENOLONE, also serves as an intermediate in the biosynthesis of GONADAL STEROID HORMONES and adrenal CORTICOSTEROIDS. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0033306"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0010094"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0729511"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C1458155"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C2937358"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013182"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0023895"/>
	</owl:Class>

