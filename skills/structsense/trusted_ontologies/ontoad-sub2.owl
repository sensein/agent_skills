		<rdfs:subClassOf rdf:resource="&OntoAD;C1516895"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0030289"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0012237">
		<skos:prefLabel xml:lang="en">Digestants</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Digestants</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Digestifs</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Digestifs</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Digestant</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments digestifs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents digestifs</skos:altLabel>
		<skos:altLabel xml:lang="fr">digestif</skos:altLabel>
		<skos:definition xml:lang="en">An agent that favors or assists the process of digestion. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0017173"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0450442"/>
