		<skos:hiddenLabel xml:lang="en">Leukodystrophy</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Leucodystrophie</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Leucodystrophie</skos:hiddenLabel>
		<skos:altLabel xml:lang="fr">Leucodystrophies</skos:altLabel>
