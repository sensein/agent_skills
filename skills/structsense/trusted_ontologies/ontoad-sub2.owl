		<skos:altLabel xml:lang="en">cox proportional hazards models</skos:altLabel>
		<skos:altLabel xml:lang="fr">modèle de Cox</skos:altLabel>
		<rdfs:subClassOf rdf:resource="&OntoAD;QuantitativeConcept"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;IntellectualProduct"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C2931784">
		<skos:prefLabel xml:lang="en">Amyloid angiopathy</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AmyloidAngiopathy</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">angiopathie amyloïde</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AngiopathieAmyloïde</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">cerebral amyloid</skos:altLabel>
		<skos:altLabel xml:lang="en">cerebral amyloid angiopathy</skos:altLabel>
		<skos:altLabel xml:lang="en">Senile cerebral amyloid angiopathy</skos:altLabel>
		<skos:altLabel xml:lang="en">Amyloidosis  cerebral</skos:altLabel>
		<skos:altLabel xml:lang="fr">amyloïde cérébrale</skos:altLabel>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0085220"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0162783">
		<skos:prefLabel xml:lang="en">Prefrontal Cortex</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">PrefrontalCortex</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Cortex préfrontal</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">CortexPréfrontal</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Prefrontal association cortex</skos:altLabel>
		<skos:altLabel xml:lang="fr">Aire préfrontale</skos:altLabel>
		<skos:definition xml:lang="en">The rostral part of the frontal lobe, bounded by the inferior precentral fissure in humans, which receives projection fibers from the mediodorsal nucleus of the thalamus. The prefrontal cortex receives afferent fibers from numerous structures of the diencephalon, mesencephalon, and limbic system as well as cortical afferents of visual, auditory, and somatic origin. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">partie rostrale du lobe frontal, limité par la fissure précentrale inférieure chez les humains, qui reçoit des fibres de projection du nucléus médiodorsal du thalamus. Le cortex préfrontal reçoit des fibres afférentes de nombreuses structures du diencéphale, du mésencéphale et du système limbique aussi bien que d'afférents corticaux d'origine visuelle, auditive et somatique. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2337243"/>
		<OntoAD:receives_input_from rdf:resource="&OntoAD;C0007776"/>
		<OntoAD:sends_output_to rdf:resource="&OntoAD;C0228249"/>
		<OntoAD:has_regional_part rdf:resource="&OntoAD;C0152298"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0871060">
		<skos:prefLabel xml:lang="en">Performance Tests</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">PerformanceTests</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">performance on tests</skos:altLabel>
		<skos:altLabel xml:lang="en">test performance</skos:altLabel>
		<skos:definition xml:lang="en">Tests requiring nonverbal responses, for example, the manipulation of objects or the performance of motor skills. (source : PSY)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0242485"/>
	</owl:Class>

