		<skos:altLabel xml:lang="en">sulfur aminoacid</skos:altLabel>
		<skos:altLabel xml:lang="fr">Amino-acides soufrés</skos:altLabel>
		<skos:altLabel xml:lang="fr">Aminoacides soufrés</skos:altLabel>
		<skos:altLabel xml:lang="fr">acide aminé sulfuré</skos:altLabel>
		<skos:definition xml:lang="en">any aminoacid containing sulfur. (source : CSP)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0002520"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0311461">
