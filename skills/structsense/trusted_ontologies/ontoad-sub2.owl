		<skos:altLabel xml:lang="en">c-ALL  Common acute lymphoblastic leukemia antigen</skos:altLabel>
		<skos:altLabel xml:lang="en">CALLA  Common acute lymphoblastic leukemia antigen</skos:altLabel>
		<skos:altLabel xml:lang="en">Lymphocyte antigen CD10</skos:altLabel>
		<skos:altLabel xml:lang="en">CD10</skos:altLabel>
		<skos:altLabel xml:lang="en">kidney brush border neutral peptidase</skos:altLabel>
		<skos:altLabel xml:lang="en">C10</skos:altLabel>
		<skos:altLabel xml:lang="en">NEP</skos:altLabel>
		<skos:altLabel xml:lang="en">CALLA Antigen</skos:altLabel>
		<skos:altLabel xml:lang="en">Common ALL Antigen</skos:altLabel>
		<skos:altLabel xml:lang="en">CD10 Ag</skos:altLabel>
