		<OntoAD:chemical_or_drug_is_product_of_biological_process rdf:resource="&OntoAD;C0598312"/>
		<OntoAD:has_attributed_constitutional_part rdf:resource="&OntoAD;C0017366"/>
	</owl:Class>

