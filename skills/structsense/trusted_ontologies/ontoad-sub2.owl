		<skos:altLabel xml:lang="en">Diagnostic Imaging Technique</skos:altLabel>
		<skos:definition xml:lang="en">A method of producing pictures of areas inside the body. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0449851"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0430022"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0016995">
		<skos:prefLabel xml:lang="en">Gambling</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Gambling</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Jeu de hasard</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">JeuDeHasard</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Gamblings</skos:altLabel>
		<skos:altLabel xml:lang="en">wagering</skos:altLabel>
		<skos:altLabel xml:lang="en">betting</skos:altLabel>
		<skos:altLabel xml:lang="fr">Pari</skos:altLabel>
		<skos:altLabel xml:lang="fr">Jeu d'argent</skos:altLabel>
		<skos:altLabel xml:lang="fr">Jeux de hasard</skos:altLabel>
		<skos:altLabel xml:lang="fr">jeux d'argent</skos:altLabel>
		<skos:definition xml:lang="en">An activity distinguished primarily by an element of risk in trying to obtain a desired goal, e.g., playing a game of chance for money. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0600104"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0019564">
		<skos:prefLabel xml:lang="en">Hippocampus (Brain)</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Hippocampus(Brain)</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Hippocampe</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Hippocampe</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">hippocampus</skos:altLabel>
		<skos:altLabel xml:lang="en">Ammon Horn</skos:altLabel>
		<skos:altLabel xml:lang="en">Cornu Ammonis</skos:altLabel>
		<skos:altLabel xml:lang="en">hippocampus major</skos:altLabel>
		<skos:altLabel xml:lang="en">hippocampus proper</skos:altLabel>
		<skos:altLabel xml:lang="en">Hippocampal structure</skos:altLabel>
		<skos:altLabel xml:lang="en">Hippocampal</skos:altLabel>
		<skos:altLabel xml:lang="en">Hippocampus proprius</skos:altLabel>
		<skos:altLabel xml:lang="fr">hippocampus</skos:altLabel>
		<skos:altLabel xml:lang="fr">Corne d'Ammon</skos:altLabel>
		<skos:altLabel xml:lang="fr">Grand hippocampe</skos:altLabel>
		<skos:definition xml:lang="en">A curved elevation of gray matter extending the entire length of the floor of the temporal horn of the lateral ventricle. The hippocampus, subiculum, and DENTATE GYRUS constitute the hippocampal formation. Sometimes authors include the ENTORHINAL CORTEX in the hippocampal formation. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Relief formé par la circonvolution de la substance grise s'étendant le long du plancher de la corne temporale du ventricule cérébral. L'hippocampe, le subiculum, et le gyrus denté constituent la formation hippocampique. Il arrive que des auteurs incluent le cortex entothinal dans la formation hippocampique. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0039485"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0175202"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2951054"/>
		<OntoAD:has_constitutional_part rdf:resource="&OntoAD;C0152314"/>
		<OntoAD:regional_part_of rdf:resource="&OntoAD;C0023715"/>
		<OntoAD:receives_input_from rdf:resource="&OntoAD;C0228318"/>
		<OntoAD:part_of rdf:resource="&OntoAD;C1268978"/>
		<OntoAD:finding_site_of rdf:resource="&OntoAD;C1504404"/>
		<OntoAD:sends_output_to rdf:resource="&OntoAD;C0020663"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0007457">
		<skos:prefLabel xml:lang="en">Caucasoid Race</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CaucasoidRace</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Race caucasienne</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">RaceCaucasienne</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Caucasian Race</skos:altLabel>
		<skos:altLabel xml:lang="en">Caucasian</skos:altLabel>
		<skos:altLabel xml:lang="en">Race: White</skos:altLabel>
		<skos:altLabel xml:lang="en">Occidental</skos:altLabel>
		<skos:altLabel xml:lang="en">Caucasoid</skos:altLabel>
		<skos:altLabel xml:lang="en">Race: Caucasian</skos:altLabel>
		<skos:altLabel xml:lang="en">racial background Caucasian</skos:altLabel>
		<skos:altLabel xml:lang="fr">race européenne</skos:altLabel>
		<skos:altLabel xml:lang="fr">race caucasoïde</skos:altLabel>
		<skos:definition xml:lang="en">A group distinguished by classification according to physical features. This group, also called Europoid, centers around the Mediterranean Sea but includes other parts of Europe. (from Winick: Dictionary of Anthropology, 1972; American Heritage Dictionary, 2d College ed) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0034510"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0043157">
		<skos:prefLabel xml:lang="en">Caucasians</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Caucasians</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Blancs</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Blancs</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">White</skos:altLabel>
		<skos:altLabel xml:lang="en">Whites</skos:altLabel>
		<skos:altLabel xml:lang="en">white race</skos:altLabel>
		<skos:altLabel xml:lang="en">RaceWhite</skos:altLabel>
		<skos:altLabel xml:lang="en">White  ethnic group</skos:altLabel>
		<skos:altLabel xml:lang="en">Caucasoid</skos:altLabel>
		<skos:altLabel xml:lang="en">Caucasian</skos:altLabel>
		<skos:altLabel xml:lang="en">white people</skos:altLabel>
		<skos:altLabel xml:lang="fr">blanche</skos:altLabel>
		<skos:altLabel xml:lang="fr">caucasien</skos:altLabel>
		<skos:definition xml:lang="en">An ethnic group of putative Caucasoid origin. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">individus dont les origines ancestrales sont dans le continent de l'Europe.; un groupe distingué selon la classification selon les caractéristiques physiques. Ce groupe, ¤slEuropoid¤sl aussi appelé, centre autour de la Méditerranée, mais inclut d'autres parties de l'Europe. ( Winick : le Dictionnaire d'Anthropologie, 1972; le Dictionnaire d'Héritage américain, 2ème édition de Collège); un groupe ethnique d'origine ¤slCaucasoid¤sl putative. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0015031"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0242481">
		<skos:prefLabel xml:lang="en">Research Activities</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">ResearchActivities</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Activités de recherche</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ActivitésDeRecherche</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Research</skos:altLabel>
		<skos:definition xml:lang="en">Systematic investigation into a subject in order to discover facts, establish or revise a theory, or develop a plan of action based on the facts discovered. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1516654"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0027361">
		<skos:prefLabel xml:lang="en">Persons</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Persons</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Individus</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Individus</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">people</skos:altLabel>
		<skos:altLabel xml:lang="en">person</skos:altLabel>
		<skos:altLabel xml:lang="en">individuals</skos:altLabel>
		<skos:altLabel xml:lang="en">subjects</skos:altLabel>
		<skos:altLabel xml:lang="en">Individual</skos:altLabel>
		<skos:altLabel xml:lang="fr">personnes</skos:altLabel>
		<skos:altLabel xml:lang="fr">sujets</skos:altLabel>
		<skos:altLabel xml:lang="fr">Gens</skos:altLabel>
		<skos:definition xml:lang="en">Persons as individuals (e.g., ABORTION APPLICANTS) or as members of a group (e.g., HISPANIC AMERICANS). It is not used for members of the various professions (e.g., PHYSICIANS) or occupations (e.g., LIBRARIANS) for which OCCUPATIONAL GROUPS is available. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">personnes comme les individus (par ex., les CANDIDATS D'AVORTEMENT) ou comme les membres d'un groupe (par ex., AMÉRICAINS HISPANIQUES). Il n'est pas utilisé pour les membres des professions différentes (par ex., les DOCTEURS) ou les occupations (par ex., les BIBLIOTHÉCAIRES) pour lesquels les GROUPES DU MÉTIER est disponible. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1257890"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0611285">
		<skos:prefLabel xml:lang="en">APP protein, human</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">APPProtein,Human</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Protease Nexin II</skos:altLabel>
		<skos:altLabel xml:lang="en">APPI protein, human</skos:altLabel>
		<skos:altLabel xml:lang="en">PN2</skos:altLabel>
		<skos:altLabel xml:lang="en">ABPP</skos:altLabel>
		<skos:altLabel xml:lang="en">Alzheimer Disease 1 Protein</skos:altLabel>
		<skos:altLabel xml:lang="en">Amyloid Beta A4 Protein Precursor</skos:altLabel>
		<skos:altLabel xml:lang="en">Amyloid of Aging and Alzheimer Disease Protein</skos:altLabel>
		<skos:altLabel xml:lang="en">Alzheimer's Disease Amyloid Protein</skos:altLabel>
		<skos:altLabel xml:lang="en">Protease Nexin-II, Alzheimer Disease</skos:altLabel>
		<skos:altLabel xml:lang="en">Amyloid Beta-Peptide</skos:altLabel>
		<skos:altLabel xml:lang="en">Cerebralvascular Amyloid Peptide</skos:altLabel>
		<skos:altLabel xml:lang="en">APPI</skos:altLabel>
		<skos:altLabel xml:lang="en">CVAP</skos:altLabel>
		<skos:altLabel xml:lang="en">PN II</skos:altLabel>
		<skos:altLabel xml:lang="en">PreA4</skos:altLabel>
		<skos:altLabel xml:lang="en">amyloid beta (A4) precursor protein</skos:altLabel>
		<skos:altLabel xml:lang="en">protease nexin 2, human</skos:altLabel>
		<skos:altLabel xml:lang="en">peptidase nexin-II, human</skos:altLabel>
		<skos:definition xml:lang="en">Encoded by human APP Gene (APP Family), Amyloid Beta A4 Protein Precursor is an N-/O-glycosylated sulfated metal ion-binding type I cell surface protein containing a BPTI protease inhibitor domain. Widely expressed APP is processed by secretases into soluble peptides, membrane-anchored fragments, plaque amyloid components, and cytotoxic fragments. Phosphorylation by Casein Kinases, CDC5, CDC2, and MAPK10 can affect processing, interaction with Fe65, and SHC binding. A kinesin I membrane receptor (source : )</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0597357"/>
		<OntoAD:gene_product_malfunction_associated_with_disease rdf:resource="&OntoAD;C0002395"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1364818"/>
		<OntoAD:gene_product_plays_role_in_biological_process rdf:resource="&OntoAD;C0242606"/>
		<OntoAD:gene_product_has_associated_anatomy rdf:resource="&OntoAD;C0007610"/>
		<OntoAD:gene_product_has_associated_anatomy rdf:resource="&OntoAD;C0007603"/>
		<OntoAD:gene_product_has_organism_source rdf:resource="&OntoAD;C0086418"/>
		<OntoAD:gene_product_plays_role_in_biological_process rdf:resource="&OntoAD;C0162638"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1334396"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1335671"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0242210"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0026339">
		<skos:prefLabel xml:lang="en">Biological Models</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">BiologicalModels</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Modèles biologiques</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ModèlesBiologiques</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">modeling</skos:altLabel>
		<skos:altLabel xml:lang="en">models</skos:altLabel>
		<skos:altLabel xml:lang="en">model system</skos:altLabel>
		<skos:altLabel xml:lang="en">Scientific modelling</skos:altLabel>
		<skos:altLabel xml:lang="en">model</skos:altLabel>
		<skos:altLabel xml:lang="en">Models, Biologic</skos:altLabel>
		<skos:altLabel xml:lang="en">MODEL BIOL</skos:altLabel>
		<skos:altLabel xml:lang="fr">modèle</skos:altLabel>
		<skos:definition xml:lang="en">Theoretical representations that simulate the behavior or activity of biological processes or diseases. For disease models in living animals, DISEASE MODELS, ANIMAL is available. Biological models include the use of mathematical equations, computers, and other electronic equipment. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;ResearchDevice"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;IntellectualProduct"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0039484">
		<skos:prefLabel xml:lang="en">Temporal bone structure</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">TemporalBoneStructure</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Os temporal</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">OsTemporal</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Temporal Bone</skos:altLabel>
		<skos:altLabel xml:lang="en">Os temporale</skos:altLabel>
		<skos:altLabel xml:lang="fr">temporal</skos:altLabel>
		<skos:altLabel xml:lang="fr">os temporal, SAI</skos:altLabel>
		<skos:definition xml:lang="en">Either of a pair of compound bones forming the lateral (left and right) surfaces and base of the skull which contains the organs of hearing. It is a large bone formed by the fusion of parts: the squamous (the flattened anterior-superior part), the tympanic (the curved anterior-inferior part), the mastoid (the irregular posterior portion), and the petrous (the part at the base of the skull). (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">N'importe laquelle d'une paire d'os composés formant le latéral (quitté{laissé} et le droit) les surfaces et la base du crâne contenant les organes d'audition. C'est un grand os formé par la fusion de parties : le squameux (partie supérieure-antérieure écrasée), le TYMPANIQUE (partie inférieure-antérieure courbée), le mastoïde (la portion postérieure irrégulière) et le pétreux (la partie à la base du crâne). (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2337482"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0222650"/>
		<OntoAD:anatomic_structure_is_physical_part_of rdf:resource="&OntoAD;C0037303"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0228174">
		<skos:prefLabel xml:lang="en">Cerebral hemisphere structure (body structure)</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CerebralHemisphereStructure(bodyStructure)</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Hémisphères cérébraux</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">HémisphèresCérébraux</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Cerebral hemisphere structure</skos:altLabel>
		<skos:altLabel xml:lang="en">Cerebral Hemispheres</skos:altLabel>
		<skos:altLabel xml:lang="en">Cerebrum</skos:altLabel>
		<skos:altLabel xml:lang="en">CEREBRAL HEMISPHERES: GENERAL TERMS</skos:altLabel>
		<skos:altLabel xml:lang="en">Cerebral</skos:altLabel>
		<skos:altLabel xml:lang="en">Brain Hemisphere</skos:altLabel>
		<skos:altLabel xml:lang="en">Hemispherium cerebri</skos:altLabel>
		<skos:altLabel xml:lang="en">Hemispherium cerebralis</skos:altLabel>
		<skos:altLabel xml:lang="fr">Hémisphère cérébral</skos:altLabel>
		<skos:altLabel xml:lang="fr">hémisphère cérébral, SAI</skos:altLabel>
		<skos:definition xml:lang="en">One of two bilateral, largely symmetrical organ subdivisions within the telencephalon which contain the cerebral cortex and cerebral white matter. (source : FMA)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1998020"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0039452"/>
