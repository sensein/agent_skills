		<OntoAD:finding_site_of rdf:resource="&OntoAD;C0018021"/>
		<OntoAD:finding_site_of rdf:resource="&OntoAD;C0600086"/>
		<OntoAD:is_primary_anatomic_site_of_disease rdf:resource="&OntoAD;C1335047"/>
	</owl:Class>

