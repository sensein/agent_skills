		<skos:altLabel xml:lang="en">Heart insufficiency</skos:altLabel>
		<skos:altLabel xml:lang="en">heart; weakness</skos:altLabel>
		<skos:altLabel xml:lang="en">Heart weak</skos:altLabel>
		<skos:altLabel xml:lang="en">cardiac insufficiency</skos:altLabel>
		<skos:altLabel xml:lang="fr">insuffisance cardiaque</skos:altLabel>
