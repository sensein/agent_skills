		<skos:altLabel xml:lang="fr">Sclérose de l'artère coronaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">MCAS</skos:altLabel>
		<skos:altLabel xml:lang="fr">maladie cardiaque athérosclérotique</skos:altLabel>
