	<owl:Class rdf:about="&OntoAD;C0011206">
		<skos:prefLabel xml:lang="en">Delirium</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Delirium</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Délire avec confusion</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">DélireAvecConfusion</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">delusions</skos:altLabel>
		<skos:altLabel xml:lang="en">Acute brain syndrome</skos:altLabel>
		<skos:altLabel xml:lang="en">Acute delirium</skos:altLabel>
		<skos:altLabel xml:lang="en">ABS  Acute brain syndrome</skos:altLabel>
		<skos:altLabel xml:lang="en">Delirious</skos:altLabel>
		<skos:altLabel xml:lang="fr">délire</skos:altLabel>
		<skos:altLabel xml:lang="fr">SYNDROME ENCEPHALIQUE AIGU</skos:altLabel>
		<skos:altLabel xml:lang="fr">Délires</skos:altLabel>
		<skos:altLabel xml:lang="fr">Délire confusionnel</skos:altLabel>
		<skos:altLabel xml:lang="fr">Délirant</skos:altLabel>
		<skos:altLabel xml:lang="fr">Délire aigu</skos:altLabel>
		<skos:altLabel xml:lang="fr">Syndrome cérébral aigu</skos:altLabel>
		<skos:altLabel xml:lang="fr">Délirium</skos:altLabel>
		<skos:altLabel xml:lang="fr">encéphalopathie aiguë</skos:altLabel>
		<skos:altLabel xml:lang="fr">Delirium, sans précision</skos:altLabel>
		<skos:definition xml:lang="en">A disorder characterized by CONFUSION; inattentiveness; disorientation; ILLUSIONS; HALLUCINATIONS; agitation; and in some instances autonomic nervous system overactivity. It may result from toxic/metabolic conditions or structural brain lesions. (From Adams et al., Principles of Neurology, 6th ed, pp411-2) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0009676"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0009241"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0234428"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0497327"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0006104"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0038663"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0243026"/>
		<OntoAD:interprets rdf:resource="&OntoAD;C0234425"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0085762"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0085401">
		<skos:prefLabel xml:lang="en">tau Proteins</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">TauProteins</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Protéines tau</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ProtéinesTau</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">tau protein</skos:altLabel>
		<skos:altLabel xml:lang="en">Tau factor</skos:altLabel>
		<skos:altLabel xml:lang="en">Microtubule associated tau protein</skos:altLabel>
		<skos:altLabel xml:lang="en">Microtubule protein tau</skos:altLabel>
		<skos:altLabel xml:lang="fr">protéine tau</skos:altLabel>
		<skos:altLabel xml:lang="fr">tau</skos:altLabel>
		<skos:definition xml:lang="en">Microtubule-associated proteins that are mainly expressed in neurons. Tau proteins constitute several isoforms and play an important role in the assembly of tubulin monomers into microtubules and in maintaining the cytoskeleton and axonal transport. Aggregation of specific sets of tau proteins in filamentous inclusions is the common feature of intraneuronal and glial fibrillar lesions (NEUROFIBRILLARY TANGLES; NEUROPIL THREADS) in numerous neurodegenerative disorders (ALZHEIMER DISEASE; TAUOPATH (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">protéines associées de microtubule qui sont surtout exprimées dans les neurones. Les protéines de ¤slTau¤sl constituent plusieurs isoformes et jouent un rôle important dans l'assemblage de tubuline monomères dans les microtubules et dans le maintien le transport d'axonale et du cytosquelette. L'agrégation d'ensembles spécifiques tau les protéines dans les inclusions filamenteux est la caractéristique commune de l'¤slintraneuronal¤sl et de gliale fibrillaire les lésions (les ENCHEVÊTREMENTS de ¤s (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0033684"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0527316">
		<skos:prefLabel xml:lang="en">donepezil</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Donepezil</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">donepezil</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Donepezil</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">DONEP</skos:altLabel>
		<skos:definition xml:lang="en">A drug that is used to treat Alzheimer disease and is being studied in the treatment of side effects caused by radiation therapy to the brain. It is a type of cholinesterase inhibitor. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0001046"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0594440"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1531592"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0002395"/>
