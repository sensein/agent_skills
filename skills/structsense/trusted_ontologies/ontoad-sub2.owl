	<owl:Class rdf:about="&OntoAD;C0001675">
		<skos:prefLabel xml:lang="en">Adult</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Adult</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Adulte</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Adulte</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">adults</skos:altLabel>
		<skos:altLabel xml:lang="en">Adult Human (21+)</skos:altLabel>
		<skos:altLabel xml:lang="en">Human, Adult</skos:altLabel>
		<skos:altLabel xml:lang="fr">adultes</skos:altLabel>
		<skos:altLabel xml:lang="fr">Adulte âge 19-44</skos:altLabel>
		<skos:definition xml:lang="en">A person having attained full growth or maturity. Adults are of 19 through 44 years of age. For a person between 19 and 24 years of age, YOUNG ADULT is available. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0027362"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1444710"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0684320">
		<skos:prefLabel xml:lang="en">Disease regression</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">DiseaseRegression</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Regressing</skos:altLabel>
		<skos:definition xml:lang="en">A decrease in the size of a tumor or in the extent of cancer in the body. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0449259"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0684321">
		<skos:prefLabel xml:lang="en">Regression - mental defense mechanism</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Regression-MentalDefenseMechanism</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Régression (psychologie)</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Régression(psychologie)</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">regression</skos:altLabel>
		<skos:altLabel xml:lang="en">regression analysis</skos:altLabel>
		<skos:altLabel xml:lang="en">Regression  mental defense mechanism</skos:altLabel>
		<skos:altLabel xml:lang="en">Regressive behavior</skos:altLabel>
		<skos:altLabel xml:lang="en">Regression  mental defen mech</skos:altLabel>
		<skos:altLabel xml:lang="en">REGRESSION PSYCHOL</skos:altLabel>
		<skos:altLabel xml:lang="fr">régression</skos:altLabel>
		<skos:altLabel xml:lang="fr">régressions</skos:altLabel>
		<skos:altLabel xml:lang="fr">Régression (statistiques)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Comportement régressif</skos:altLabel>
		<skos:altLabel xml:lang="fr">Régression psychologique</skos:altLabel>
		<skos:definition xml:lang="en">A return to earlier, especially to infantile, patterns of thought or behavior, or stage of functioning, e.g., feelings of helplessness and dependency in a patient with a serious physical illness. (From APA, Thesaurus of Psychological Index Terms, 1994). (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">retour à plus tôt, surtout à infantile, les dessins de pensée ou conduite, ou stade de fonctionnement, par ex., les sentiments d'impuissance et la dépendance dans un patient avec une maladie physique sérieuse. (D'APA, le Trésor de Termes d'Index Psychologiques, 1994). (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0233513"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0030664">
		<skos:prefLabel xml:lang="en">Pathology</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Pathology</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Anatomopathologie</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Anatomopathologie</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">pathological</skos:altLabel>
		<skos:altLabel xml:lang="en">PATHOL</skos:altLabel>
		<skos:altLabel xml:lang="fr">Anatomie pathologique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Anatomo-pathologie</skos:altLabel>
		<skos:definition xml:lang="en">A specialty concerned with the nature and cause of disease as expressed by changes in cellular or tissue structure and function caused by the disease process. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;BiomedicalOccupationOrDiscipline"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0334866">
		<skos:prefLabel xml:lang="en">Medical pathologist</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">MedicalPathologist</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Pathologist</skos:altLabel>
		<skos:altLabel xml:lang="fr">pathologiste (médecine)</skos:altLabel>
		<skos:definition xml:lang="en">A doctor who identifies diseases by studying cells and tissues under a microscope. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0334886"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0444504">
		<skos:prefLabel xml:lang="en">Statistical mean</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">StatisticalMean</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Mean</skos:altLabel>
		<skos:definition xml:lang="en">The sum of a set of values divided by the number of values in the set. (NIST Dictionary of Algorithms and Data Structures) (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0871676"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0011923">
		<skos:prefLabel xml:lang="en">Diagnostic Imaging</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">DiagnosticImaging</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Diagnostic par imagerie</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">DiagnosticParImagerie</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">imaging</skos:altLabel>
		<skos:altLabel xml:lang="en">images</skos:altLabel>
		<skos:altLabel xml:lang="en">picture</skos:altLabel>
		<skos:altLabel xml:lang="en">Imaging by method</skos:altLabel>
		<skos:altLabel xml:lang="en">IMAGING DIAG</skos:altLabel>
		<skos:altLabel xml:lang="fr">images</skos:altLabel>
		<skos:altLabel xml:lang="fr">image</skos:altLabel>
		<skos:altLabel xml:lang="fr">imagerie</skos:altLabel>
		<skos:altLabel xml:lang="fr">Imagerie diagnostique</skos:altLabel>
		<skos:definition xml:lang="en">Any visual display of structural or functional patterns of organs or tissues for diagnostic evaluation. It includes measuring physiologic and metabolic responses to physical and chemical stimuli, as well as ultramicroscopy. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">http://www.fnclcc.fr/fr/patients/dico/definition.php?id_definition=787 (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0079595"/>
		<OntoAD:has_method rdf:resource="&OntoAD;C1275506"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0079595">
		<skos:prefLabel xml:lang="en">Imaging Techniques</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">ImagingTechniques</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Procédure d'imagerie</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ProcédureD'imagerie</skos:hiddenLabel>
