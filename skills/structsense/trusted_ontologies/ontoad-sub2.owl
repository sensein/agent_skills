		<skos:altLabel xml:lang="en">Acetyl-CoA:choline O-acetyltransferase</skos:altLabel>
		<skos:altLabel xml:lang="fr">Choline acétylase</skos:altLabel>
		<skos:altLabel xml:lang="fr">choline acétyltransférase</skos:altLabel>
		<skos:definition xml:lang="en">An enzyme that catalyzes the formation of acetylcholine from acetyl-CoA and choline. EC 2.3.1.6. (source : MSH)</skos:definition>
