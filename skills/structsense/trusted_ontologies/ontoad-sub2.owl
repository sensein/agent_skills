		<skos:hiddenLabel xml:lang="fr">ÉvénementsDeVie</skos:hiddenLabel>
		<skos:definition xml:lang="en">Those occurrences, including social, psychological, and environmental, which require an adjustment or effect a change in an individual's pattern of living. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Événements sociaux, psychologiques ou environnementaux qui exigent un ajustement ou un changement dans le mode de vie d'un individu. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;PhenomenonOrProcess"/>
	</owl:Class>

