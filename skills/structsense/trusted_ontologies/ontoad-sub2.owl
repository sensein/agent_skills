		<skos:altLabel xml:lang="en">SYSTEM, TOMOGRAPHY, COMPUTED, EMISSION</skos:altLabel>
		<skos:altLabel xml:lang="en">PET scanner</skos:altLabel>
		<skos:altLabel xml:lang="en">Scanning Systems, Positron Emission Tomography</skos:altLabel>
		<skos:altLabel xml:lang="en">Scanners, Positron Emission Tomography</skos:altLabel>
