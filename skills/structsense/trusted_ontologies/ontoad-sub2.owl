	<owl:Class rdf:about="&OntoAD;C0162701">
		<skos:prefLabel xml:lang="en">Polysomnography</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Polysomnography</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Polysomnographie</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Polysomnographie</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Monitoring, Sleep</skos:altLabel>
		<skos:altLabel xml:lang="en">Somnography</skos:altLabel>
		<skos:altLabel xml:lang="en">SLEEP DISORDER TESTS AND PROCEDURES</skos:altLabel>
		<skos:altLabel xml:lang="en">Polysomnogram</skos:altLabel>
		<skos:altLabel xml:lang="en">Full sleep study</skos:altLabel>
		<skos:altLabel xml:lang="en">sleep testing</skos:altLabel>
		<skos:altLabel xml:lang="en">Sleep studies</skos:altLabel>
		<skos:altLabel xml:lang="en">PSG</skos:altLabel>
		<skos:altLabel xml:lang="en">Sleep recording</skos:altLabel>
		<skos:altLabel xml:lang="en">sleep measurement</skos:altLabel>
		<skos:altLabel xml:lang="en">POLYSOMNOGR</skos:altLabel>
		<skos:altLabel xml:lang="en">SOMNOGR</skos:altLabel>
		<skos:altLabel xml:lang="en">Somnographies</skos:altLabel>
		<skos:altLabel xml:lang="fr">Etude du sommeil</skos:altLabel>
		<skos:altLabel xml:lang="fr">Monitorage du sommeil</skos:altLabel>
		<skos:altLabel xml:lang="fr">Polygraphie du sommeil</skos:altLabel>
		<skos:altLabel xml:lang="fr">Somnographie</skos:altLabel>
		<skos:altLabel xml:lang="fr">exploration fonctionnelle d'un trouble du sommeil</skos:altLabel>
		<skos:altLabel xml:lang="fr">polysomnogramme</skos:altLabel>
		<skos:definition xml:lang="en">Simultaneous and continuous monitoring of several parameters during sleep to study normal and abnormal sleep. The study includes monitoring of brain waves, to assess sleep stages, and other physiological variables such as breathing, eye movements, and blood oxygen levels which exhibit a disrupted pattern with sleep disturbances. (source : MSH)</skos:definition>
