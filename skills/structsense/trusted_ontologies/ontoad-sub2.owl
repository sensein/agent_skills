		<skos:altLabel xml:lang="en">Normal Tissue</skos:altLabel>
		<skos:altLabel xml:lang="en">Textus</skos:altLabel>
		<skos:altLabel xml:lang="en">Tiss</skos:altLabel>
		<skos:altLabel xml:lang="en">Body tissue structure</skos:altLabel>
		<skos:altLabel xml:lang="en">Portion of tissue</skos:altLabel>
		<skos:altLabel xml:lang="fr">tissu</skos:altLabel>
		<skos:altLabel xml:lang="fr">tissu corporel, SAI</skos:altLabel>
		<skos:altLabel xml:lang="fr">tissu, SAI</skos:altLabel>
		<skos:definition xml:lang="en">Collections of differentiated CELLS, such as EPITHELIUM; CONNECTIVE TISSUE; MUSCLES; and NERVE TISSUE. Tissues are cooperatively arranged to form organs with specialized functions such as RESPIRATION; DIGESTION; REPRODUCTION; MOVEMENT; and others. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">collections de CELLULES différenciées, comme l'ÉPITHÉLIUM; TISSU CONJONCTIF; MUSCLES; et TISSU NERVEUX. Les tissus sont coopérativement arrangés pour former des organes avec les fonctions spécialisées comme la RESPIRATION; DIGESTION; REPRODUCTION; MOUVEMENT; et d'autres. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;Tissue"/>
		<OntoAD:has_constitutional_part rdf:resource="&OntoAD;C0007634"/>
	</owl:Class>

