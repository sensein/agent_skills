		<skos:altLabel xml:lang="en">syncope; syncope</skos:altLabel>
		<skos:altLabel xml:lang="fr">décès</skos:altLabel>
		<skos:altLabel xml:lang="fr">COLLAPSUS TRANSITOIRE</skos:altLabel>
		<skos:altLabel xml:lang="fr">ETAT SYNCOPAL</skos:altLabel>
		<skos:altLabel xml:lang="fr">EVANOUISSEMENT</skos:altLabel>
		<skos:altLabel xml:lang="fr">Evanouissement/syncope</skos:altLabel>
		<skos:altLabel xml:lang="fr">PERTE DE CONNAISSANCE</skos:altLabel>
		<skos:altLabel xml:lang="fr">Collapsus passager</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tendance lipothymique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Chutes fréquentes</skos:altLabel>
		<skos:altLabel xml:lang="fr">Lipothymie</skos:altLabel>
		<skos:altLabel xml:lang="fr">Syncope et collapsus</skos:altLabel>
		<skos:altLabel xml:lang="fr">Pâmoison</skos:altLabel>
		<skos:altLabel xml:lang="fr">Evanouissements</skos:altLabel>
		<skos:altLabel xml:lang="fr">Ivre mort</skos:altLabel>
		<skos:altLabel xml:lang="fr">syncope vasovagale</skos:altLabel>
		<skos:altLabel xml:lang="fr">évanoui</skos:altLabel>
		<skos:altLabel xml:lang="fr">Syncope et collapsus (sauf choc)</skos:altLabel>
		<skos:definition xml:lang="en">A transient loss of consciousness and postural tone caused by diminished blood flow to the brain (i.e., BRAIN ISCHEMIA). Presyncope refers to the sensation of lightheadedness and loss of strength that precedes a syncopal event or accompanies an incomplete syncope. (From Adams et al., Principles of Neurology, 6th ed, pp367-9) (source : MSH)</skos:definition>
