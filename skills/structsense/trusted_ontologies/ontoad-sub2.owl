		<skos:altLabel xml:lang="en">Passage</skos:altLabel>
		<skos:definition xml:lang="en">Removal of a cell culture from the culture vessel with a subculture (passage) process, in order to keep the cells at a sufficiently low density to stimulate further growth. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0040284"/>
	</owl:Class>

