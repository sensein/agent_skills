		<skos:altLabel xml:lang="en">Gestagenic Agents</skos:altLabel>
		<skos:altLabel xml:lang="en">Progestagenic Agents</skos:altLabel>
		<skos:altLabel xml:lang="en">Progestational Agents</skos:altLabel>
		<skos:altLabel xml:lang="en">Progestational Compounds</skos:altLabel>
		<skos:altLabel xml:lang="en">Progestational hormone</skos:altLabel>
