		<skos:altLabel xml:lang="en">prevalence</skos:altLabel>
		<skos:altLabel xml:lang="en">statistical proportion</skos:altLabel>
		<skos:definition xml:lang="en">The total number of cases of a given disease in a specified population at a designated time. It is differentiated from INCIDENCE, which refers to the number of new cases in the population at a given time. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">http://www.fnclcc.fr/fr/patients/dico/definition.php?id_definition=1313 (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0026538"/>
	</owl:Class>

