		<skos:hiddenLabel xml:lang="en">DiscreteDistribution</skos:hiddenLabel>
		<skos:definition xml:lang="en">A statistical distribution whose elements may only assume discreet values. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0038205"/>
	</owl:Class>

