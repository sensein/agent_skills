		<OntoAD:has_manifestation rdf:resource="&OntoAD;C0017601"/>
		<OntoAD:has_manifestation rdf:resource="&OntoAD;C0086543"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1418276">
		<skos:prefLabel xml:lang="en">PAX6 gene</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">PAX6Gene</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">PAX6</skos:altLabel>
		<skos:altLabel xml:lang="en">WAGR</skos:altLabel>
		<skos:altLabel xml:lang="en">D11S812E</skos:altLabel>
		<skos:altLabel xml:lang="en">PAIRED BOX GENE 6</skos:altLabel>
		<skos:altLabel xml:lang="en">paired box 6</skos:altLabel>
		<skos:altLabel xml:lang="en">aniridia, keratitis</skos:altLabel>
		<skos:definition xml:lang="en">This gene plays a role in transcriptional regulation. (source : NCI)</skos:definition>
