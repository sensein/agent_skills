		<skos:altLabel xml:lang="en">breast cancer anti-estrogen resistance 1</skos:altLabel>
		<skos:altLabel xml:lang="en">Breast Cancer Anti-Estrogen Resistance 1 Gene</skos:altLabel>
		<skos:altLabel xml:lang="en">BREAST CANCER ANTIESTROGEN RESISTANCE 1</skos:altLabel>
		<skos:altLabel xml:lang="en">CASS1</skos:altLabel>
		<skos:altLabel xml:lang="en">Cas scaffolding protein family member 1</skos:altLabel>
		<skos:definition xml:lang="en">This gene plays a role in signal transduction and is involved in cell adhesion, migration and proliferation. (source : NCI)</skos:definition>
