	<owl:Class rdf:about="&OntoAD;C0175996">
		<skos:prefLabel xml:lang="en">Protoplasm</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Protoplasm</skos:hiddenLabel>
