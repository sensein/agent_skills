	<owl:Class rdf:about="&OntoAD;C0015644">
		<skos:prefLabel xml:lang="en">Muscular fasciculation</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">MuscularFasciculation</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Fasciculation</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Fasciculation</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">fasciculation</skos:altLabel>
		<skos:altLabel xml:lang="en">Muscle fasciculation</skos:altLabel>
		<skos:altLabel xml:lang="en">muscle twitching</skos:altLabel>
		<skos:altLabel xml:lang="en">Flickering muscles</skos:altLabel>
		<skos:altLabel xml:lang="en">Fluttering muscles</skos:altLabel>
		<skos:altLabel xml:lang="en">Writhing muscles</skos:altLabel>
		<skos:altLabel xml:lang="en">Fasciculation, Neural</skos:altLabel>
		<skos:altLabel xml:lang="en">Spontaneous contraction of muscle</skos:altLabel>
		<skos:altLabel xml:lang="en">fasciculations</skos:altLabel>
		<skos:altLabel xml:lang="fr">CONTRACTIONS FASCICULAIRES</skos:altLabel>
		<skos:altLabel xml:lang="fr">Fasciculation musculaire</skos:altLabel>
		<skos:definition xml:lang="en">Involuntary contraction of the muscle fibers innervated by a motor unit. Fasciculations can often by visualized and take the form of a muscle twitch or dimpling under the skin, but usually do not generate sufficient force to move a limb. They may represent a benign condition or occur as a manifestation of MOTOR NEURON DISEASE or PERIPHERAL NERVOUS SYSTEM DISEASES. (Adams et al., Principles of Neurology, 6th ed, p1294) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0026650"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0026859"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0027740"/>
	</owl:Class>

