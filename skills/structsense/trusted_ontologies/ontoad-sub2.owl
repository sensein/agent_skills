	<owl:Class rdf:about="&OntoAD;C2746052">
		<skos:prefLabel xml:lang="en">mTOR Inhibitor</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">MTORInhibitor</skos:hiddenLabel>
		<skos:definition xml:lang="en">Any agents that inhibit mTOR (FK506 binding protein 12-rapamycin associated protein 1), one of the protein kinases mediate cellular responses to stresses such as DNA damage and nutrient deprivation. mTOR acts as the target for the cell-cycle arrest and immunosuppressive effects of the FKBP12-rapamycin complex. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1449702"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0022947">
		<skos:prefLabel xml:lang="en">Lactones</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Lactones</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Lactones</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Lactones</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Lactone Compound</skos:altLabel>
		<skos:altLabel xml:lang="en">Lactone</skos:altLabel>
		<skos:definition xml:lang="en">Cyclic esters of hydroxy carboxylic acids, containing a 1-oxacycloalkan-2-one structure. Large cyclic lactones of over a dozen atoms are MACROLIDES. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0029224"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0282563">
		<skos:prefLabel xml:lang="en">Macrolides</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Macrolides</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Macrolides</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Macrolides</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Macrolide</skos:altLabel>
		<skos:altLabel xml:lang="en">Macrolide-class Agent</skos:altLabel>
		<skos:definition xml:lang="en">A group of often glycosylated macrocyclic compounds formed by chain extension of multiple PROPIONATES cyclized into a large (typically 12, 14, or 16)-membered lactone. Macrolides belong to the POLYKETIDES class of natural products, and many members exhibit ANTIBIOTIC properties. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0022947"/>
	</owl:Class>

