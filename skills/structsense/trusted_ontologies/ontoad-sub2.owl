		<skos:hiddenLabel xml:lang="fr">CéphaléesVasculaires</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Cephalgia, Vascular</skos:altLabel>
		<skos:altLabel xml:lang="en">Vascular headache</skos:altLabel>
		<skos:altLabel xml:lang="fr">CEPHALEE VASCULAIRE</skos:altLabel>
		<skos:definition xml:lang="en">Secondary headache disorders attributed to a variety of cranial or cervical vascular disorders, such as BRAIN ISCHEMIA; INTRACRANIAL HEMORRHAGES; and CENTRAL NERVOUS SYSTEM VASCULAR MALFORMATIONS. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0042373"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0393735"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0559232"/>
	</owl:Class>

