	<owl:Class rdf:about="&OntoAD;C0025260">
		<skos:prefLabel xml:lang="en">Memory</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Memory</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Mémoire</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Mémoire</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">memory function</skos:altLabel>
		<skos:altLabel xml:lang="en">memories</skos:altLabel>
		<skos:altLabel xml:lang="en">Memory functions</skos:altLabel>
		<skos:altLabel xml:lang="fr">Memory</skos:altLabel>
		<skos:altLabel xml:lang="fr">fonction mnésique</skos:altLabel>
		<skos:altLabel xml:lang="fr">souvenirs</skos:altLabel>
		<skos:definition xml:lang="en">Complex mental function having four distinct phases: (1) memorizing or learning, (2) retention, (3) recall, and (4) recognition. Clinically, it is usually subdivided into immediate, recent, and remote memory. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Fonction mentale complexe ayant quatre phases distinctes : (1) la mémorisation ou apprentissage, (2) la rétention, (3) la mémoire et (4) la reconnaissance. Cliniquement, il est en général subdivisé en mémoire immédiate, récente et lointaine. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1154338"/>
		<OntoAD:biological_process_has_associated_location rdf:resource="&OntoAD;C0006104"/>
		<OntoAD:biological_process_has_associated_location rdf:resource="&OntoAD;C0027763"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1947933">
