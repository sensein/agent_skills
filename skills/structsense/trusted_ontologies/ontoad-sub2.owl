	<owl:Class rdf:about="&OntoAD;C0016967">
		<skos:prefLabel xml:lang="en">Galantamine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Galantamine</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Galantamine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Galantamine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Galantamin</skos:altLabel>
		<skos:altLabel xml:lang="en">Galanthamine</skos:altLabel>
		<skos:altLabel xml:lang="en">Lycoremine</skos:altLabel>
		<skos:altLabel xml:lang="fr">Galanthamine</skos:altLabel>
		<skos:definition xml:lang="en">A benzazepine derived from norbelladine. It is found in GALANTHUS and other AMARYLLIDACEAE. It is a cholinesterase inhibitor that has been used to reverse the muscular effects of GALLAMINE TRIETHIODIDE and TUBOCURARINE and has been studied as a treatment for ALZHEIMER DISEASE and other central nervous system disorders. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Une benzazépine qui est dérivée de la norbelladine. On la trouve dans le galanthus et dans d'autres amaryllidaceae. C'est un inhibiteur de la cholinestérase qui a été utilisé pour inverser les effets musculaires de la gallamine triéthiodure et de la tubocurarine et qui a été étudié dans le traitement de la maladie d'Alzheimer et d'autres troubles du système nerveux central. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0001046"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0594440"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1531592"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0002395"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0020517"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0035078"/>
	</owl:Class>

