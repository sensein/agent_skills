		<rdfs:subClassOf rdf:resource="&OntoAD;C0242485"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0004271">
		<skos:prefLabel xml:lang="en">Attitude</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Attitude</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Attitude</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Attitude</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Outlook</skos:altLabel>
		<skos:altLabel xml:lang="fr">Attitudes</skos:altLabel>
		<skos:definition xml:lang="en">An enduring, learned predisposition to behave in a consistent way toward a given class of objects, or a persistent mental and/or neural state of readiness to react to a certain class of objects, not as they are but as they are conceived to be. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0013126"/>
