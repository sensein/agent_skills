		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1336646"/>
		<OntoAD:gene_product_plays_role_in_biological_process rdf:resource="&OntoAD;C0007587"/>
		<OntoAD:gene_product_plays_role_in_biological_process rdf:resource="&OntoAD;C0162638"/>
