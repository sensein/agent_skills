		<skos:altLabel xml:lang="en">Acetylcholine receptor site</skos:altLabel>
		<skos:altLabel xml:lang="en">Cholinergic receptor site</skos:altLabel>
		<skos:altLabel xml:lang="en">Cholinergic receptor</skos:altLabel>
		<skos:altLabel xml:lang="en">RECEPT CHOLINERGIC</skos:altLabel>
		<skos:altLabel xml:lang="en">RECEPT ACH</skos:altLabel>
		<skos:altLabel xml:lang="en">RECEPT ACETYLCHOLINE</skos:altLabel>
		<skos:altLabel xml:lang="en">Receptors, Cholinergic</skos:altLabel>
		<skos:altLabel xml:lang="fr">Récepteur cholinergique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Récepteurs de l'ACh</skos:altLabel>
		<skos:altLabel xml:lang="fr">Récepteurs à l'ACh</skos:altLabel>
		<skos:altLabel xml:lang="fr">Cholinocepteurs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Récepteurs de l'acétylcholine</skos:altLabel>
		<skos:altLabel xml:lang="fr">Récepteurs à l'acétylcholine</skos:altLabel>
		<skos:altLabel xml:lang="fr">récepteur de l'acétyl-choline</skos:altLabel>
		<skos:definition xml:lang="en">Cell surface proteins that bind acetylcholine with high affinity and trigger intracellular changes influencing the behavior of cells. Cholinergic receptors are divided into two major classes, muscarinic and nicotinic, based originally on their affinity for nicotine and muscarine. Each group is further subdivided based on pharmacology, location, mode of action, and/or molecular biology. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0597357"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C2936699">
		<skos:prefLabel xml:lang="en">Recommendations, Health Planning</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Recommendations,HealthPlanning</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Recommandations</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Recommandations</skos:hiddenLabel>
		<rdfs:subClassOf rdf:resource="&OntoAD;IdeaOrConcept"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0035039">
		<skos:prefLabel xml:lang="en">Religion</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Religion</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Religion</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Religion</skos:hiddenLabel>
		<skos:definition xml:lang="en">A set of beliefs concerning the nature, cause, and purpose of the universe, especially when considered as the creation of a superhuman agency. It usually involves devotional and ritual observances and often a moral code for the conduct of human affairs. (Random House Collegiate Dictionary, rev. ed.) (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">ensemble de convictions concernant la nature, la cause et le but de l'univers, surtout quand considéré comme la création d'une agence surhumaine. Il implique en général des observations de piété et rituelles et souvent un code moral pour la conduite d'affaires humaines. (traduit de 'Random House Collegiate Dictionary, rev. ed.') (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0740697"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0038376">
		<skos:prefLabel xml:lang="en">Storeroom</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Storeroom</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Réserve</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Réserve</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">reserve</skos:altLabel>
		<skos:altLabel xml:lang="fr">réserves</skos:altLabel>
		<skos:altLabel xml:lang="fr">Magasin</skos:altLabel>
		<skos:definition xml:lang="fr">L'administration de toute l'obtention, la distribution et l'entreposage d'équipement et réserves, aussi bien qu'administration de logistique en incluant la blanchisserie, en traitant de ¤slreusables¤sl, etc. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;ManufacturedObject"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0035345">
		<skos:prefLabel xml:lang="en">Retirement</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Retirement</skos:hiddenLabel>
