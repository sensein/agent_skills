	<owl:Class rdf:about="&OntoAD;C0009498">
		<skos:prefLabel xml:lang="en">Complement System Proteins</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">ComplementSystemProteins</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Protéines du système du complément</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ProtéinesDuSystèmeDuComplément</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Complement</skos:altLabel>
		<skos:altLabel xml:lang="en">Complement Proteins</skos:altLabel>
		<skos:altLabel xml:lang="en">complement (serum protein)</skos:altLabel>
		<skos:altLabel xml:lang="en">Complement, thermolabile serum protein complex with cytotoxic effect</skos:altLabel>
		<skos:altLabel xml:lang="en">Complement Component Protein</skos:altLabel>
		<skos:altLabel xml:lang="fr">complément</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéines du complément</skos:altLabel>
		<skos:definition xml:lang="en">Serum glycoproteins participating in the host defense mechanism of COMPLEMENT ACTIVATION that creates the COMPLEMENT MEMBRANE ATTACK COMPLEX. Included are glycoproteins in the various pathways of complement activation (CLASSICAL COMPLEMENT PATHWAY; ALTERNATIVE COMPLEMENT PATHWAY; and LECTIN COMPLEMENT PATHWAY). (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Système complexe sensible à la chaleur présent dans le sérum frais humain ou d'autres espèces qui, en combination avec les anticorps, est important dans le mécanisme de défense de l'organisme face à l'aggression d'autres organismes. Au moins 20 protéines sériques distinctes participent au système du complément. (From McGraw-Hill Dictionary of Scientific Terms, 4th ed) (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0005525"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0021072"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1292104"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1254349"/>
		<OntoAD:gene_product_has_associated_anatomy rdf:resource="&OntoAD;C0229671"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0815047"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1334166"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0018591">
		<skos:prefLabel xml:lang="en">Haplotypes</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Haplotypes</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Haplotypes</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Haplotypes</skos:hiddenLabel>
		<skos:altLabel xml:lang="fr">haplotype</skos:altLabel>
		<skos:definition xml:lang="en">The genetic constitution of individuals with respect to one member of a pair of allelic genes, or sets of genes that are closely linked and tend to be inherited together such as those of the MAJOR HISTOCOMPATIBILITY COMPLEX. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Matériel génétique porté par un seul des deux chromosomese et généralement transmis . Exemple : allèles du système HLA (Complexe Majeur d'histocompatibilité). (source : MSHFRE)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0017431"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0040160">
		<skos:prefLabel xml:lang="en">Thyrotropin</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Thyrotropin</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Thyréostimuline</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Thyréostimuline</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Thyroid-Stimulating Hormone</skos:altLabel>
		<skos:altLabel xml:lang="en">TSH (Thyroid Stimulating Hormone)</skos:altLabel>
		<skos:altLabel xml:lang="en">TSH</skos:altLabel>
		<skos:altLabel xml:lang="en">Thyreotropin</skos:altLabel>
		<skos:altLabel xml:lang="en">Thyrotropic hormone preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">Thyrotrophic hormone product</skos:altLabel>
		<skos:altLabel xml:lang="en">TSH preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">Thyrotrophin product</skos:altLabel>
		<skos:altLabel xml:lang="en">TSH-Thyroid stim horm</skos:altLabel>
		<skos:altLabel xml:lang="en">Thyrotropic Hormone</skos:altLabel>
		<skos:altLabel xml:lang="en">Thyroid stimulating hormone</skos:altLabel>
		<skos:altLabel xml:lang="fr">thyrotropine</skos:altLabel>
		<skos:altLabel xml:lang="fr">Thyrotrophine</skos:altLabel>
		<skos:altLabel xml:lang="fr">Hormone thyréotrope</skos:altLabel>
		<skos:altLabel xml:lang="fr">TSH (Thyroid-stimulating hormone)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Thyréotrophine</skos:altLabel>
		<skos:altLabel xml:lang="fr">Thyréotropine</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation de thyréostimuline</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation de TSH</skos:altLabel>
		<skos:definition xml:lang="en">A glycoprotein hormone secreted by the adenohypophysis (PITUITARY GLAND, ANTERIOR). Thyrotropin stimulates THYROID GLAND by increasing the iodide transport, synthesis and release of thyroid hormones (THYROXINE and TRIIODOTHYRONINE). Thyrotropin consists of two noncovalently linked subunits, alpha and beta. Within a species, the alpha subunit is common in the pituitary glycoprotein hormones (TSH; LUTEINIZING HORMONE and FSH), but the beta subunit is unique and confers its biological specificity. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0040162"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0032016"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1254352"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0032015"/>
	</owl:Class>

