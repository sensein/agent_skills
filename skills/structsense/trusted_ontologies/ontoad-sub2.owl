	<owl:Class rdf:about="&OntoAD;C1514509">
		<skos:prefLabel xml:lang="en">Prostate Cancer Prevention Trial</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">ProstateCancerPreventionTrial</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">PCPT</skos:altLabel>
		<skos:definition xml:lang="en">A phase III, randomized, placebo-controlled cancer prevention trial of >18,000 men coordinated by the Southwest Oncology Group. The trial will determine the effect of a daily dose of finasteride taken for seven years on the biopsy-proven prevalence of prostate cancer. It is scheduled to be completed in 2004. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1516220"/>
	</owl:Class>

