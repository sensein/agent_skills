		<skos:altLabel xml:lang="en">Rheumatoid disease</skos:altLabel>
		<skos:altLabel xml:lang="en">R arthritis</skos:altLabel>
		<skos:altLabel xml:lang="en">Rh arthritis</skos:altLabel>
		<skos:altLabel xml:lang="en">Systemic rheumatoid arthritis</skos:altLabel>
		<skos:altLabel xml:lang="en">Rheumatoid arthritis, siteified</skos:altLabel>
		<skos:altLabel xml:lang="en">Arthritis or polyarthritis, atrophic</skos:altLabel>
