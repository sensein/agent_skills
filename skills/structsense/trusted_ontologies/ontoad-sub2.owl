	<owl:Class rdf:about="&OntoAD;C2699938">
		<skos:prefLabel xml:lang="en">Thyrotropin-Releasing Hormone Analogue</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Thyrotropin-ReleasingHormoneAnalogue</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">TRH Analogue</skos:altLabel>
		<skos:altLabel xml:lang="en">TRF Analog</skos:altLabel>
		<skos:altLabel xml:lang="en">Thyrotropin Secretagogue</skos:altLabel>
		<skos:definition xml:lang="en">Any structural or functional analogue that mimics the physiological actions of thyrotropin-releasing hormone (TRH). Although TRH analogues appear to have a minimal influence on the biosynthesis of TSH, they seem to exert various neuromodulating activities, such as central nervous system-stimulating, analeptic, analgesic, antidepressant, and neuroprotective effects. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0019932"/>
	</owl:Class>

