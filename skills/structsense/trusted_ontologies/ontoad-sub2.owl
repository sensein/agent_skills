		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0456909"/>
		<OntoAD:manifestation_of rdf:resource="&OntoAD;C0003076"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0003864"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0086543"/>
		<OntoAD:may_be_treated_by rdf:resource="&OntoAD;C0009014"/>
		<OntoAD:may_be_treated_by rdf:resource="&OntoAD;C0031849"/>
