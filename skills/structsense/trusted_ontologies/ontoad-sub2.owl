		<skos:altLabel xml:lang="en">Endothelium-derived relaxing factor synthase</skos:altLabel>
		<skos:altLabel xml:lang="en">Nitric-oxide synthase</skos:altLabel>
		<skos:altLabel xml:lang="en">EC 1.14.13.39</skos:altLabel>
		<skos:altLabel xml:lang="en">synthase</skos:altLabel>
		<skos:altLabel xml:lang="fr">Nitric-oxide synthase</skos:altLabel>
		<skos:altLabel xml:lang="fr">Synthase oxyde nitrique</skos:altLabel>
		<skos:definition xml:lang="en">An NADPH-dependent enzyme that catalyzes the conversion of L-ARGININE and OXYGEN to produce CITRULLINE and NITRIC OXIDE. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0030016"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0023689"/>
