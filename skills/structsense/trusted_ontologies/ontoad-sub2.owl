	<owl:Class rdf:about="&OntoAD;C0812327">
		<skos:prefLabel xml:lang="en">Transcription factor genes</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">TranscriptionFactorGenes</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Proto-Oncogene, Transcription Factor</skos:altLabel>
