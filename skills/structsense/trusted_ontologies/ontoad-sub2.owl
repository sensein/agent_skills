		<skos:altLabel xml:lang="en">capacityQuantity</skos:altLabel>
		<skos:definition xml:lang="en">The amount that can be contained. It can refer to the volume that can be held, such as lung capacity, or the number of people that can be contained in a room or building. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;QuantitativeConcept"/>
	</owl:Class>

