		<skos:altLabel xml:lang="en">Herpetoviridae</skos:altLabel>
		<skos:altLabel xml:lang="en">Herpes virus group</skos:altLabel>
		<skos:altLabel xml:lang="en">Family Herpesviridae</skos:altLabel>
		<skos:altLabel xml:lang="en">Herpes Virus</skos:altLabel>
		<skos:altLabel xml:lang="fr">virus Herpes</skos:altLabel>
		<skos:altLabel xml:lang="fr">Herpèsvirus</skos:altLabel>
		<skos:altLabel xml:lang="fr">Virus herpétiques</skos:altLabel>
		<skos:definition xml:lang="en">A family of enveloped, linear, double-stranded DNA viruses infecting a wide variety of animals. Subfamilies, based on biological characteristics, include: ALPHAHERPESVIRINAE; BETAHERPESVIRINAE; and GAMMAHERPESVIRINAE. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1512048"/>
		<OntoAD:causative_agent_of rdf:resource="&OntoAD;C0019372"/>
	</owl:Class>

