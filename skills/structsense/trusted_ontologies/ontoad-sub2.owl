		<skos:definition xml:lang="en">broad term with many narrower terms that can apply more specifically to most projects; it should be used ONLY when specific narrower therapy terms do not apply, e.g., if a project is dealing with drugs in therapy, do not index drugs and therapy, index instead the particular drugs plus chemotherapy or the specific type of chemotherapy. (source : CSP)</skos:definition>
		<skos:definition xml:lang="fr">procédures concernées avec le traitement de rattrapage ou la prévention de maladies. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1948041"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0418956"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1285155"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0940824"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1522326">
		<skos:prefLabel xml:lang="en">Treating</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Treating</skos:hiddenLabel>
		<skos:definition xml:lang="en">Subject to a process with the aim of readying for some purpose, improving, or remedying a condition. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C3266814"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1533734">
		<skos:prefLabel xml:lang="en">Administration procedure</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AdministrationProcedure</skos:hiddenLabel>
		<skos:definition xml:lang="en">Introduction of a substance to the body (source : SNOMEDCT)</skos:definition>
