		<skos:altLabel xml:lang="en">Proteobacteria epsilon subdivision</skos:altLabel>
		<skos:altLabel xml:lang="en">epsilon subdivision</skos:altLabel>
		<skos:altLabel xml:lang="en">epsilon subgroup</skos:altLabel>
		<skos:altLabel xml:lang="en">not Epsilobacteria Cavalier-Smith 2002</skos:altLabel>
		<skos:altLabel xml:lang="en">not Epsilobacteria</skos:altLabel>
		<skos:altLabel xml:lang="en">EPSILONPROTEOBACT</skos:altLabel>
		<skos:altLabel xml:lang="en">EPSILON PROTEOBACT</skos:altLabel>
		<skos:altLabel xml:lang="en">Class Epsilonproteobacteria</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéobactéries epsilon</skos:altLabel>
		<skos:altLabel xml:lang="fr">epsilon-Protéobactéries</skos:altLabel>
		<skos:definition xml:lang="en">A group of proteobacteria consisting of chemoorganotrophs usually associated with the DIGESTIVE SYSTEM of humans and animals. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0751985"/>
	</owl:Class>

