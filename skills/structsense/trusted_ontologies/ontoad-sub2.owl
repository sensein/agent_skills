	<owl:Class rdf:about="&OntoAD;C1552262">
		<skos:prefLabel xml:lang="en">Nurse Practitioner - Family</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">NursePractitioner-Family</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Nurse Practitioner  Family</skos:altLabel>
		<skos:altLabel xml:lang="en">FNP</skos:altLabel>
		<skos:definition xml:lang="en">A registered nurse with specialized and advanced education in treating all age groups. The Family Nurse Practitioner can treat both pediatric and adult members of the family who suffer from acute or chronic illnesses, as well as address psychosocial issues that may be affecting the family. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0028657"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0033105">
