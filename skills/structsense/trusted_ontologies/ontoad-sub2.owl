		<skos:altLabel xml:lang="en">Blood group A</skos:altLabel>
		<skos:altLabel xml:lang="en">Blood group A (ABO blood group)</skos:altLabel>
		<skos:altLabel xml:lang="en">blood type A</skos:altLabel>
		<skos:altLabel xml:lang="fr">groupe AS</skos:altLabel>
		<skos:definition xml:lang="en">A blood group indicating the presence on erythrocytes of only the A form of the H Antigen. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0344389"/>
		<OntoAD:interprets rdf:resource="&OntoAD;C0679560"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0043020">
		<skos:prefLabel xml:lang="en">Wallerian Degeneration</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">WallerianDegeneration</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Dégénérescence wallerienne</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">DégénérescenceWallerienne</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Secondary degeneration</skos:altLabel>
		<skos:altLabel xml:lang="en">Degeneration, secondary Wallerian</skos:altLabel>
		<skos:altLabel xml:lang="fr">dégénérescence secondaire</skos:altLabel>
		<skos:definition xml:lang="en">Degeneration of distal aspects of a nerve axon following injury to the cell body or proximal portion of the axon. The process is characterized by fragmentation of the axon and its MYELIN SHEATH. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">dégénérescence des aspects distaux d'un nerf axone suite à une blessure du corps cellulaire ou à une portion proximale de l'axone. Le processus est caractérisé par la fragmentation de l'axone et de la MYELINE. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0011164"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1335024"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1709838"/>
		<OntoAD:disease_has_associated_anatomic_site rdf:resource="&OntoAD;C0027763"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0018687">
		<skos:prefLabel xml:lang="en">Health behavior</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">HealthBehavior</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Comportement en matière de santé</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ComportementEnMatièreDeSanté</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">rndx health behavior</skos:altLabel>
		<skos:altLabel xml:lang="fr">comportements de santé</skos:altLabel>
		<skos:altLabel xml:lang="fr">Comportement de santé</skos:altLabel>
		<skos:altLabel xml:lang="fr">Comportement sanitaire</skos:altLabel>
		<skos:definition xml:lang="en">Behaviors expressed by individuals to protect, maintain or promote their health status. For example, proper diet, and appropriate exercise are activities perceived to influence health status. Life style is closely associated with health behavior and factors influencing life style are socioeconomic, educational, and cultural. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">conduites exprimées par les individus pour protéger, pour maintenir ou promouvoir leur statut de santé. Par exemple, le régime nécessaire et l'exercice approprié sont des activités perçues pour influencer le statut de santé. Le style de vie est de près associé à la conduite de santé et les facteurs influençant le style de vie sont socio-économiques, éducatifs et culturels. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0028684"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1519022"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0019369">
		<skos:prefLabel xml:lang="en">Herpesviridae</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Herpesviridae</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Herpesviridae</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Herpesviridae</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Herpesviruses</skos:altLabel>
