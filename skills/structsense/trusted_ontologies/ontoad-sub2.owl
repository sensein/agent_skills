		<skos:altLabel xml:lang="en">signaling pathway</skos:altLabel>
		<skos:altLabel xml:lang="en">Signal Transduction Systems</skos:altLabel>
		<skos:altLabel xml:lang="en">biological signal transduction</skos:altLabel>
		<skos:altLabel xml:lang="en">Cell Signaling</skos:altLabel>
