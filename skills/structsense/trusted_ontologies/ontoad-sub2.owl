	<owl:Class rdf:about="&OntoAD;C0018021">
		<skos:prefLabel xml:lang="en">Goiter</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Goiter</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Goitre</skos:prefLabel>
