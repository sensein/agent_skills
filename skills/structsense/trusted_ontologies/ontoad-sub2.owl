	<owl:Class rdf:about="&OntoAD;C0039601">
		<skos:prefLabel xml:lang="en">Testosterone</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Testosterone</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Testostérone</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Testostérone</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Testosterone product</skos:altLabel>
		<skos:altLabel xml:lang="en">Total testosterone</skos:altLabel>
		<skos:altLabel xml:lang="en">Androst-4-en-17beta-ol-3-one</skos:altLabel>
		<skos:altLabel xml:lang="en">Testosterone preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">TESTO</skos:altLabel>
		<skos:altLabel xml:lang="en">Delta4-androsten-17beta-ol-3-one</skos:altLabel>
		<skos:altLabel xml:lang="en">therapeutic testosterone</skos:altLabel>
		<skos:altLabel xml:lang="en">Trans-Testosterone</skos:altLabel>
		<skos:definition xml:lang="en">A potent androgenic steroid and major product secreted by the LEYDIG CELLS of the TESTIS. Its production is stimulated by LUTEINIZING HORMONE from the PITUITARY GLAND. In turn, testosterone exerts feedback control of the pituitary LH and FSH secretion. Depending on the tissues, testosterone can be further converted to DIHYDROTESTOSTERONE or ESTRADIOL. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0002744"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0582128"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0039586"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0443588"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0018802"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C1458155"/>
