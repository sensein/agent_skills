	<owl:Class rdf:about="&OntoAD;C0314657">
		<skos:prefLabel xml:lang="en">Genetic Predisposition to Disease</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">GeneticPredispositionToDisease</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Prédisposition génétique à une maladie</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">PrédispositionGénétiqueÀUneMaladie</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">genetic susceptibility</skos:altLabel>
		<skos:altLabel xml:lang="en">Genetic Predisposition</skos:altLabel>
		<skos:altLabel xml:lang="en">Inherited Predisposition</skos:altLabel>
		<skos:altLabel xml:lang="en">Inherited Susceptibility</skos:altLabel>
		<skos:altLabel xml:lang="en">GENET PREDISPOSITION DIS</skos:altLabel>
		<skos:altLabel xml:lang="en">GENET PREDISPOSITION</skos:altLabel>
		<skos:altLabel xml:lang="en">GENET SUSCEPTIBILITY</skos:altLabel>
		<skos:altLabel xml:lang="en">genetics predisposition</skos:altLabel>
		<skos:altLabel xml:lang="fr">Prédisposition génétique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Susceptibilité génétique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Susceptibilité génétique à une maladie</skos:altLabel>
		<skos:definition xml:lang="en">A latent susceptibility to disease at the genetic level, which may be activated under certain conditions. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Une sensibilité latente à une maladie au niveau génétique qui pourrait être activer dans certaines conditions (source : MSHFRE)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;OrganismAttribute"/>
		<OntoAD:interprets rdf:resource="&OntoAD;C0679560"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0017428">
		<skos:prefLabel xml:lang="en">Genome</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Genome</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Génome</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Génome</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Genomic</skos:altLabel>
		<skos:definition xml:lang="en">The genetic complement of an organism, including all of its GENES, as represented in its DNA, or in some cases, its RNA. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">complément génétique d'un organisme, en incluant tous ses GÈNES, comme représenté dans son ADN, ou dans certains cas, son ARN. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0017337"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0017639">
		<skos:prefLabel xml:lang="en">Gliosis</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Gliosis</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Gliose</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Gliose</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Astrocytic cell proliferation</skos:altLabel>
		<skos:altLabel xml:lang="en">Proliferation of glial fibers</skos:altLabel>
		<skos:altLabel xml:lang="en">Fibrillary gliosis</skos:altLabel>
		<skos:altLabel xml:lang="en">Astrogliosis</skos:altLabel>
		<skos:altLabel xml:lang="fr">gliose fibrillaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">prolifération des astrocytes</skos:altLabel>
		<skos:altLabel xml:lang="fr">prolifération du réseau névroglique</skos:altLabel>
		<skos:definition xml:lang="en">The production of a dense fibrous network of neuroglia; includes astrocytosis, which is a proliferation of astrocytes in the area of a degenerative lesion. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1265981"/>
		<OntoAD:manifestation_of rdf:resource="&OntoAD;C0236642"/>
		<OntoAD:manifestation_of rdf:resource="&OntoAD;C0038868"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0347988">
		<skos:prefLabel xml:lang="en">Metals, Heavy</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Metals,Heavy</skos:hiddenLabel>
