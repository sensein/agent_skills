		<skos:altLabel xml:lang="en">SCYB2</skos:altLabel>
		<skos:altLabel xml:lang="en">CINC-2A</skos:altLabel>
		<skos:altLabel xml:lang="en">MIP-2A</skos:altLabel>
		<skos:altLabel xml:lang="en">MGSA-b</skos:altLabel>
		<skos:altLabel xml:lang="en">GRO2</skos:altLabel>
		<skos:altLabel xml:lang="en">MIP2</skos:altLabel>
		<skos:altLabel xml:lang="en">SCYA</skos:altLabel>
		<skos:altLabel xml:lang="en">Chemokine (C-X-C Motif) Ligand 2 wt Allele</skos:altLabel>
		<skos:definition xml:lang="en">Human CXCL2 wild-type allele is located within 4q21 and is approximately 2 kb in length. This allele, which encodes macrophage inflammatory protein 2-alpha precursor protein, is involved in tissue-specific regulation. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0812310"/>
		<OntoAD:gene_plays_role_in_process rdf:resource="&OntoAD;C1155266"/>
