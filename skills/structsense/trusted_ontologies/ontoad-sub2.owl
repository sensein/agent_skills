	<owl:Class rdf:about="&OntoAD;C0008679">
		<skos:prefLabel xml:lang="en">Chronic disease</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">ChronicDisease</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Maladie chronique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">MaladieChronique</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">chronic diseases</skos:altLabel>
		<skos:altLabel xml:lang="en">chronic illness</skos:altLabel>
		<skos:altLabel xml:lang="en">Chronic disorder</skos:altLabel>
		<skos:altLabel xml:lang="en">CHRONIC DIS</skos:altLabel>
		<skos:altLabel xml:lang="fr">maladies chroniques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Pathologie chronique</skos:altLabel>
		<skos:definition xml:lang="en">Diseases which have one or more of the following characteristics: they are permanent, leave residual disability, are caused by nonreversible pathological alteration, require special training of the patient for rehabilitation, or may be expected to require a long period of supervision, observation, or care. (Dictionary of Health Services Management, 2d ed) (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">http://info.cancer.ca/f/glossary/C/Chronique.htm (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0012634"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0007786">
		<skos:prefLabel xml:lang="en">Brain Ischemia</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">BrainIschemia</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Encéphalopathie ischémique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">EncéphalopathieIschémique</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Ischemic Encephalopathy</skos:altLabel>
		<skos:altLabel xml:lang="en">brain; ischemic</skos:altLabel>
		<skos:altLabel xml:lang="en">ENCEPH ISCHEMIC</skos:altLabel>
		<skos:altLabel xml:lang="fr">Ischémie intracérébrale</skos:altLabel>
		<skos:definition xml:lang="en">Localized reduction of blood flow to brain tissue due to arterial obstruction or systemic hypoperfusion. This frequently occurs in conjunction with brain hypoxia (HYPOXIA, BRAIN). Prolonged ischemia is associated with BRAIN INFARCTION. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0006111"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0006104"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:occurs_after rdf:resource="&OntoAD;C0022116"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0949664">
		<skos:prefLabel xml:lang="en">Tauopathies</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Tauopathies</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Tauopathies</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Tauopathies</skos:hiddenLabel>
		<skos:altLabel xml:lang="fr">tauopathie</skos:altLabel>
		<skos:definition xml:lang="en">Neurodegenerative disorders involving deposition of abnormal tau protein isoforms (TAU PROTEINS) in neurons and glial cells in the brain. Pathological aggregations of tau proteins are associated with mutation of the tau gene on chromosome 17 in patients with ALZHEIMER DISEASE; DEMENTIA; PARKINSONIAN DISORDERS; progressive supranuclear palsy (SUPRANUCLEAR PALSY, PROGRESSIVE); and corticobasal degeneration. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0524851"/>
	</owl:Class>

