		<skos:altLabel xml:lang="en">Autonomic Drugs</skos:altLabel>
		<skos:altLabel xml:lang="en">Drug groups affecting ANS</skos:altLabel>
		<skos:altLabel xml:lang="en">Drug groups primarily affecting the autonomic nervous system</skos:altLabel>
		<skos:altLabel xml:lang="en">MISCELLANEOUS AUTONOMIC DRUGS</skos:altLabel>
		<skos:altLabel xml:lang="en">Autonomic agent</skos:altLabel>
		<skos:altLabel xml:lang="en">Autonomic drug</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents du système neurovégétatif</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments du système nerveux autonome</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents du système végétatif</skos:altLabel>
		<skos:altLabel xml:lang="fr">médicament agissant sur le système nerveux autonome</skos:altLabel>
		<skos:definition xml:lang="en">Agents affecting the function of, or mimicking the actions of, the autonomic nervous system and thereby having an effect on such processes as respiration, circulation, digestion, body temperature regulation, certain endocrine gland secretions, etc. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0013227"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0039052">
		<skos:prefLabel xml:lang="en">Sympathomimetics</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Sympathomimetics</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Sympathomimétiques</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Sympathomimétiques</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Sympathomimetic Agents</skos:altLabel>
		<skos:altLabel xml:lang="en">Sympathomimetic Drugs</skos:altLabel>
		<skos:altLabel xml:lang="en">Sympathomimetic compound</skos:altLabel>
		<skos:altLabel xml:lang="en">Sympathomimetic agent</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents sympathomimétiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments sympathomimétiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">agent sympathomimétique</skos:altLabel>
		<skos:altLabel xml:lang="fr">agent adrénergique</skos:altLabel>
		<skos:definition xml:lang="en">Drugs that mimic the effects of stimulating postganglionic adrenergic sympathetic nerves. Included here are drugs that directly stimulate adrenergic receptors and drugs that act indirectly by provoking the release of adrenergic transmitters. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0004382"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2064865"/>
	</owl:Class>

