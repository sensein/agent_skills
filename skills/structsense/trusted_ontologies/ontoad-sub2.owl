		<skos:hiddenLabel xml:lang="fr">Pravastatine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Eptastatin</skos:altLabel>
		<skos:altLabel xml:lang="en">PRAV</skos:altLabel>
		<skos:altLabel xml:lang="en">[1S-[1alpha(betaS*,deltaS*),2alpha,6alpha,8beta(R*),8aalpha]]-1,2,6,7,8,8a-Hexahydro-beta,!d,6-trihy</skos:altLabel>
		<skos:altLabel xml:lang="en">HMG-CoA reductase inhibitors pravastatin</skos:altLabel>
		<skos:altLabel xml:lang="fr">Eptastatine</skos:altLabel>
		<skos:definition xml:lang="en">An antilipemic fungal metabolite isolated from cultures of Nocardia autotrophica. It acts as a competitive inhibitor of HMG CoA reductase (HYDROXYMETHYLGLUTARYL COA REDUCTASES). (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0360714"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0027375"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0020443"/>
		<OntoAD:may_prevent rdf:resource="&OntoAD;C1956346"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013182"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0033325">
		<skos:prefLabel xml:lang="en">Forecast of outcome</skos:prefLabel>
