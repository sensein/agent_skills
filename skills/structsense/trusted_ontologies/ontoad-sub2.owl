	<owl:Class rdf:about="&OntoAD;C0004611">
		<skos:prefLabel xml:lang="en">Bacteria</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Bacteria</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Bactéries</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Bactéries</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Eubacteria</skos:altLabel>
		<skos:altLabel xml:lang="en">not Bacteria Haeckel 1894</skos:altLabel>
		<skos:altLabel xml:lang="en">Bacterium</skos:altLabel>
		<skos:altLabel xml:lang="en">Domain Bacteria</skos:altLabel>
		<skos:altLabel xml:lang="en">BACT</skos:altLabel>
		<skos:altLabel xml:lang="en">Superkingdom Bacteria</skos:altLabel>
		<skos:altLabel xml:lang="en">Bacteria prokaryote</skos:altLabel>
		<skos:altLabel xml:lang="fr">bactérie</skos:altLabel>
		<skos:altLabel xml:lang="fr">Bacteria</skos:altLabel>
		<skos:altLabel xml:lang="fr">Eubactéries</skos:altLabel>
		<skos:altLabel xml:lang="fr">Eubacteria</skos:altLabel>
		<skos:altLabel xml:lang="fr">bactérien</skos:altLabel>
		<skos:definition xml:lang="en">One of the three domains of life (the others being Eukarya and ARCHAEA), also called Eubacteria. They are unicellular prokaryotic microorganisms which generally possess rigid cell walls, multiply by cell division, and exhibit three principal forms: round or coccal, rodlike or bacillary, and spiral or spirochetal. Bacteria can be classified by their response to OXYGEN: aerobic, anaerobic, or facultatively anaerobic; by the mode by which they obtain their energy: chemotrophy (via chemical reaction (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1256405"/>
		<OntoAD:causative_agent_of rdf:resource="&OntoAD;C0004623"/>
		<OntoAD:causative_agent_of rdf:resource="&OntoAD;C0729518"/>
		<OntoAD:causative_agent_of rdf:resource="&OntoAD;C0729520"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0751985">
		<skos:prefLabel xml:lang="en">Proteobacteria</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Proteobacteria</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Proteobacteria</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Proteobacteria</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Purple Bacteria</skos:altLabel>
		<skos:altLabel xml:lang="en">purple photosynthetic bacteria</skos:altLabel>
		<skos:altLabel xml:lang="en">purple photosynthetic bacteria and relatives</skos:altLabel>
		<skos:altLabel xml:lang="en">purple bacteria and relatives</skos:altLabel>
		<skos:altLabel xml:lang="en">Phylum Proteobacteria</skos:altLabel>
		<skos:altLabel xml:lang="en">Proteobacteria Garrity et al. 2005</skos:altLabel>
		<skos:altLabel xml:lang="en">Purple Non-sulfur Bacteria</skos:altLabel>
		<skos:altLabel xml:lang="en">BACT PURPLE</skos:altLabel>
		<skos:altLabel xml:lang="en">PROTEOBACT</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéobactéries</skos:altLabel>
		<skos:definition xml:lang="en">A phylum of bacteria consisting of the purple bacteria and their relatives which form a branch of the eubacterial tree. This group of predominantly gram-negative bacteria is classified based on homology of equivalent nucleotide sequences of 16S ribosomal RNA or by hybridization of ribosomal RNA or DNA with 16S and 23S ribosomal RNA. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0004611"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0751990">
		<skos:prefLabel xml:lang="en">Epsilonproteobacteria</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Epsilonproteobacteria</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Epsilonproteobacteria</skos:prefLabel>
