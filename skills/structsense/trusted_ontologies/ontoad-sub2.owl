	<owl:Class rdf:about="&OntoAD;C0025462">
		<skos:prefLabel xml:lang="en">Midbrain structure</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">MidbrainStructure</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Mésencéphale</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Mésencéphale</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Mesencephalon</skos:altLabel>
		<skos:altLabel xml:lang="en">Midbrain</skos:altLabel>
		<skos:altLabel xml:lang="en">Mesencephalic</skos:altLabel>
		<skos:altLabel xml:lang="en">Mid-brain</skos:altLabel>
		<skos:altLabel xml:lang="fr">Cerveau moyen</skos:altLabel>
		<skos:altLabel xml:lang="fr">Isthme de l'encéphale</skos:altLabel>
		<skos:altLabel xml:lang="fr">Isthme du cerveau</skos:altLabel>
		<skos:altLabel xml:lang="fr">mésencéphale, SAI</skos:altLabel>
		<skos:altLabel xml:lang="fr">mésencéphalique</skos:altLabel>
		<skos:definition xml:lang="en">The middle of the three primitive cerebral vesicles of the embryonic brain. Without further subdivision, midbrain develops into a short, constricted portion connecting the PONS and the DIENCEPHALON. Midbrain contains two major parts, the dorsal TECTUM MESENCEPHALI and the ventral TEGMENTUM MESENCEPHALI, housing components of auditory, visual, and other sensorimoter systems. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0445620"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0228392"/>
		<OntoAD:regional_part_of rdf:resource="&OntoAD;C0006104"/>
		<OntoAD:regional_part_of rdf:resource="&OntoAD;C0006121"/>
		<OntoAD:has_physical_part_of_anatomic_structure rdf:resource="&OntoAD;C0021358"/>
		<OntoAD:has_physical_part_of_anatomic_structure rdf:resource="&OntoAD;C0010087"/>
		<OntoAD:has_attributed_part rdf:resource="&OntoAD;C0039433"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1268149">
		<skos:prefLabel xml:lang="en">Midbrain part</skos:prefLabel>
