	<owl:Class rdf:about="&OntoAD;C1705952">
		<skos:prefLabel xml:lang="en">TNFSF10 wt Allele</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">TNFSF10WtAllele</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Apo-2L</skos:altLabel>
