		<skos:altLabel xml:lang="fr">sang, SAI</skos:altLabel>
		<skos:altLabel xml:lang="fr">sang périphérique, SAI</skos:altLabel>
		<skos:definition xml:lang="en">The body fluid that circulates in the vascular system (BLOOD VESSELS). Whole blood includes PLASMA and BLOOD CELLS. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">http://www.fnclcc.fr/fr/patients/dico/definition.php?id_definition=1463 (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0005889"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0440737"/>
