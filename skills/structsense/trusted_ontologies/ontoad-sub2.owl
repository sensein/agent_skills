	<owl:Class rdf:about="&OntoAD;C0596620">
		<skos:prefLabel xml:lang="en">glucose metabolism</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">GlucoseMetabolism</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">métabolisme du glucose</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">MétabolismeDuGlucose</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">glucose metabolic process</skos:altLabel>
		<skos:altLabel xml:lang="en">cellular glucose metabolic process</skos:altLabel>
		<skos:definition xml:lang="en">The chemical reactions and pathways involving glucose, the aldohexose gluco-hexose. D-glucose is dextrorotatory and is sometimes known as dextrose; it is an important source of energy for living organisms and is found free as well as combined in homo- and hetero-oligosaccharides and polysaccharides. [ISBN:0198506732 'Oxford Dictionary of Biochemistry and Molecular Biology'] (source : GO)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1156448"/>
	</owl:Class>

