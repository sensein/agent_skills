	<owl:Class rdf:about="&OntoAD;C0175196">
		<skos:prefLabel xml:lang="en">Structure of entorhinal cortex</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">StructureOfEntorhinalCortex</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Cortex entorhinal</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">CortexEntorhinal</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">entorhinal cortex</skos:altLabel>
		<skos:altLabel xml:lang="en">Entorhinal Area</skos:altLabel>
		<skos:altLabel xml:lang="en">Area entorhinalis</skos:altLabel>
		<skos:altLabel xml:lang="en">area 28 of Brodmann (Crosby)</skos:altLabel>
		<skos:altLabel xml:lang="en">secondary olfactory cortical area (Carpenter)</skos:altLabel>
		<skos:altLabel xml:lang="en">Cortex entorhinalis</skos:altLabel>
		<skos:altLabel xml:lang="en">secondary olfactory cortex</skos:altLabel>
		<skos:altLabel xml:lang="fr">cortex enthorinal</skos:altLabel>
		<skos:altLabel xml:lang="fr">Aire entorhinale</skos:altLabel>
		<skos:altLabel xml:lang="fr">Cortex entorhinaux</skos:altLabel>
		<skos:definition xml:lang="en">The cytoarchitecturally well-defined area of multilaminate cerebral cortex on the medial aspect of the parahippocampal gyrus, immediately caudal to the olfactory cortex of the uncus. The entorhinal cortex is the origin of the major neural fiber system afferent to the hippocampus, the so-called PERFORANT PATHWAY. (Stedman, 25th ed) (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Secteur bien défini du cortex cérébral sur la partie médiane du gyrus parahippocampique, à la suite du cortex olfactif de l'uncus. Le cortex entorhinal est à l'origine de la plupart des fibres nerveuses du système afférent de l'hippocampe (réseau perforant). (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0228249"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1281965"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1709627">
