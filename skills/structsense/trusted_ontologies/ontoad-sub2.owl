		<skos:altLabel xml:lang="en">Microgliocyte</skos:altLabel>
		<skos:altLabel xml:lang="en">Gitter cell</skos:altLabel>
		<skos:altLabel xml:lang="en">Hortega cell</skos:altLabel>
		<skos:altLabel xml:lang="en">mesoglia</skos:altLabel>
		<skos:altLabel xml:lang="en">perivascular glial cell</skos:altLabel>
