	<owl:Class rdf:about="&OntoAD;C0003216">
		<skos:prefLabel xml:lang="en">Anti-Ulcer Agents</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Anti-UlcerAgents</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Antiulcéreux</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Antiulcéreux</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Anti-Ulcer Drugs</skos:altLabel>
		<skos:altLabel xml:lang="en">ANTIULCER AGENTS</skos:altLabel>
		<skos:altLabel xml:lang="en">antiulcer drug</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments antiulcéreux</skos:altLabel>
		<skos:altLabel xml:lang="fr">Anti-ulcéreux</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents antiulcéreux</skos:altLabel>
		<skos:definition xml:lang="en">Various agents with different action mechanisms used to treat or ameliorate PEPTIC ULCER or irritation of the gastrointestinal tract. This has included ANTIBIOTICS to treat HELICOBACTER INFECTIONS; HISTAMINE H2 ANTAGONISTS to reduce GASTRIC ACID secretion; and ANTACIDS for symptomatic relief. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2697970"/>
	</owl:Class>

