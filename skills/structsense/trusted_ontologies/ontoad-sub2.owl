	<owl:Class rdf:about="&OntoAD;C0023965">
		<skos:prefLabel xml:lang="en">Logistic Models</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">LogisticModels</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Modèles logistiques</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ModèlesLogistiques</skos:hiddenLabel>
		<skos:definition xml:lang="en">Statistical models which describe the relationship between a qualitative dependent variable (that is, one which can take only certain discrete values, such as the presence or absence of a disease) and an independent variable. A common application is in epidemiology for estimating an individual's risk (probability of a disease) as a function of a given risk factor. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0034980"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0023962">
		<skos:prefLabel xml:lang="en">Log-Linear Models</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Log-LinearModels</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Modèles log-linéaires</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ModèlesLog-linéaires</skos:hiddenLabel>
		<skos:altLabel xml:lang="fr">Modèles loglinéaires</skos:altLabel>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0023732"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0019855">
		<skos:prefLabel xml:lang="en">Home Care Services</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">HomeCareServices</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Services de soins à domicile</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ServicesDeSoinsÀDomicile</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">home care</skos:altLabel>
		<skos:altLabel xml:lang="en">Domiciliary Care</skos:altLabel>
		<skos:altLabel xml:lang="en">In-home Care</skos:altLabel>
		<skos:altLabel xml:lang="en">home health care</skos:altLabel>
		<skos:altLabel xml:lang="en">CARE SERV HOME</skos:altLabel>
		<skos:altLabel xml:lang="fr">Hospitalisation à domicile</skos:altLabel>
		<skos:definition xml:lang="en">Community health and NURSING SERVICES providing coordinated multiple services to the patient at the patient's homes. These home-care services are provided by a visiting nurse, home health agencies, HOSPITALS, or organized community groups using professional staff for care delivery. It differs from HOME NURSING which is provided by non-professionals. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">services communautaires de santé et de soins, coordonnés et délivrés à domicile, pour les patients. Sont inclus les services de soins infirmiers, d'agences de soins à domicile, d'hôpitaux, ou d'associations de professionnels. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0002424"/>
	</owl:Class>

