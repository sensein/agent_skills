		<skos:prefLabel xml:lang="fr">Troubles du langage</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">TroublesDuLangage</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Language impairment</skos:altLabel>
