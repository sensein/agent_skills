		<skos:altLabel xml:lang="en">Posterior Cerebral Artery</skos:altLabel>
		<skos:altLabel xml:lang="en">PCA  Posterior cerebr artery</skos:altLabel>
		<skos:altLabel xml:lang="en">PCA  Posterior cerebral artery</skos:altLabel>
