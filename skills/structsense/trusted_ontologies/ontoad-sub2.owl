	<owl:Class rdf:about="&OntoAD;C0242948">
		<skos:prefLabel xml:lang="en">Nicotinic Agonists</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">NicotinicAgonists</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Agonistes nicotiniques</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AgonistesNicotiniques</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Cholinergic Agonists, Nicotinic</skos:altLabel>
		<skos:altLabel xml:lang="en">NICOTINIC AGON</skos:altLabel>
		<skos:altLabel xml:lang="en">CHOLINERGIC AG NICOTINIC</skos:altLabel>
		<skos:altLabel xml:lang="en">CHOLINERGIC AGON NICOTINIC</skos:altLabel>
		<skos:altLabel xml:lang="en">NICOTINIC AG</skos:altLabel>
		<skos:altLabel xml:lang="en">Nicotinic Acetylcholine Receptor Agonist</skos:altLabel>
		<skos:altLabel xml:lang="en">nAChR Agonist</skos:altLabel>
		<skos:altLabel xml:lang="en">Nicotinic Receptor Agonist</skos:altLabel>
		<skos:altLabel xml:lang="en">Cholinergic Nicotinic Agonist</skos:altLabel>
		<skos:altLabel xml:lang="en">Nicotine Agonist</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agonistes cholinergiques nicotiniques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agoniste nicotinique</skos:altLabel>
		<skos:definition xml:lang="en">Drugs that bind to and activate nicotinic cholinergic receptors (RECEPTORS, NICOTINIC). Nicotinic agonists act at postganglionic nicotinic receptors, at neuroeffector junctions in the peripheral nervous system, and at nicotinic receptors in the central nervous system. Agents that function as neuromuscular depolarizing blocking agents are included here because they activate nicotinic receptors, although they are used clinically to block nicotinic transmission. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0242894"/>
	</owl:Class>

