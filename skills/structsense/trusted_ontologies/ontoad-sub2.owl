		<skos:altLabel xml:lang="en">Putamen</skos:altLabel>
		<skos:altLabel xml:lang="en">Nucleus putamen</skos:altLabel>
		<skos:definition xml:lang="en">The largest and most lateral of the basal ganglia lying between the lateral medullary lamina of the globus pallidus and the external capsule. It is part of the neostriatum and forms part of the lentiform nucleus along with the globus pallidus. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0162342"/>
		<OntoAD:receives_input_from rdf:resource="&OntoAD;C0007776"/>
