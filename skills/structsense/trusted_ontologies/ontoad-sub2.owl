		<skos:altLabel xml:lang="en">Heavy metal</skos:altLabel>
		<skos:altLabel xml:lang="fr">Métal lourd</skos:altLabel>
		<skos:definition xml:lang="en">Metals with high specific gravity, typically larger than 5. They have complex spectra, form colored salts and double salts, have a low electrode potential, are mainly amphoteric, yield weak bases and weak acids, and are oxidizing or reducing agents (From Grant and Hackh's Chemical Dictionary, 5th ed) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0025552"/>
	</owl:Class>

