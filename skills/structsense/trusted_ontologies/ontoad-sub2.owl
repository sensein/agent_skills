	<owl:Class rdf:about="&OntoAD;C2244312">
		<skos:prefLabel xml:lang="en">ovulation cycle process</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">OvulationCycleProcess</skos:hiddenLabel>
		<skos:definition xml:lang="en">A process involved in the sexual cycle seen in females, often with physiologic changes in the endometrium that recur at regular intervals during the reproductive years. [GOC:isa_complete] (source : GO)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1523018"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1818633">
		<skos:prefLabel xml:lang="en">menstrual cycle phase</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">MenstrualCyclePhase</skos:hiddenLabel>
		<skos:definition xml:lang="en">The progression of physiological phases, occurring in the endometrium during the menstrual cycle that recur at regular intervals during the reproductive years. The menstrual cycle is an ovulation cycle where the endometrium is shed if pregnancy does not occur. [GOC:dph, GOC:isa_complete, GOC:jid] (source : GO)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2244312"/>
	</owl:Class>

