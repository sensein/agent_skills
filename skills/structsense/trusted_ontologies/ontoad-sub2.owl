		<skos:altLabel xml:lang="en">Type I Phosphatidylinositol Kinase</skos:altLabel>
		<skos:altLabel xml:lang="en">PI 3 Kinase</skos:altLabel>
		<skos:altLabel xml:lang="en">PI3K</skos:altLabel>
		<skos:altLabel xml:lang="en">EC 2.7.1.153</skos:altLabel>
		<skos:altLabel xml:lang="en">Type III Phosphoinositide 3-Kinase</skos:altLabel>
		<skos:altLabel xml:lang="en">PHOSPHATIDYLINOSITOL KINASE 01 03</skos:altLabel>
		<skos:altLabel xml:lang="en">PHOSPHATIDYLINOSITOL KINASE 03</skos:altLabel>
		<skos:definition xml:lang="en">A phosphatidylinositol 3-kinase that catalyzes the conversion of 1-phosphatidylinositol into 1-phosphatidylinositol 3-phosphate. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0031727"/>
