	<owl:Class rdf:about="&OntoAD;C0973669">
		<skos:prefLabel xml:lang="en">VITAMINS,OTHER</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">VITAMINS,OTHER</skos:hiddenLabel>
		<skos:definition xml:lang="en">Organic substances belonging to diverse chemical families and present in foods in minute amounts, Vitamins are essential to normal metabolism and biochemical functions, usually as coenzymes. Vitamins can be classified by solubility: lipo-soluble (vitamins A, D, E, K, F) and water-soluble (B- complex). Lack of one or more vitamins in the diet cause metabolic deficiency diseases. (NCI04) (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0242295"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0017313">
