	<owl:Class rdf:about="&OntoAD;C0030131">
		<skos:prefLabel xml:lang="en">p-Chloroamphetamine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">P-Chloroamphetamine</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">4-Chloro-amphétamine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">4-Chloro-amphétamine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">PCA</skos:altLabel>
		<skos:altLabel xml:lang="en">p-Chloramphetamine</skos:altLabel>
		<skos:altLabel xml:lang="en">para-Chloroamphetamine</skos:altLabel>
		<skos:altLabel xml:lang="en">Benzeneethanamine, 4-chloro-alpha-methyl-</skos:altLabel>
		<skos:altLabel xml:lang="en">Parachloroamphetamine</skos:altLabel>
		<skos:altLabel xml:lang="en">alpha-Methyl-p-chlorophenethylamine</skos:altLabel>
		<skos:altLabel xml:lang="en">4-Chloroamphetamine</skos:altLabel>
		<skos:altLabel xml:lang="en">narcotics PCA</skos:altLabel>
		<skos:altLabel xml:lang="en">narcotics patient controlled anesthesia (PCA)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Para-chloroamphétamine</skos:altLabel>
		<skos:altLabel xml:lang="fr">4-Chloroamphétamine</skos:altLabel>
		<skos:definition xml:lang="en">Chlorinated analog of AMPHETAMINE. Potent neurotoxin that causes release and eventually depletion of serotonin in the CNS. It is used as a research tool. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0027415"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0027934"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0034330">
		<skos:prefLabel xml:lang="en">Pyrrolidonecarboxylic Acid</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">PyrrolidonecarboxylicAcid</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Acide pyrrolidonecarboxylique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AcidePyrrolidonecarboxylique</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">5-Ketoproline</skos:altLabel>
		<skos:altLabel xml:lang="en">5-Oxoproline</skos:altLabel>
		<skos:altLabel xml:lang="en">PCA</skos:altLabel>
		<skos:altLabel xml:lang="en">Pyroglutamic Acid</skos:altLabel>
		<skos:altLabel xml:lang="en">Pidolic Acid</skos:altLabel>
		<skos:altLabel xml:lang="en">OXOPROLINE 05</skos:altLabel>
		<skos:altLabel xml:lang="en">L-Glutamic Acid Gamma-Lactam</skos:altLabel>
		<skos:altLabel xml:lang="en">L-Pyroglutamic Acid</skos:altLabel>
		<skos:altLabel xml:lang="fr">Acide glutiminique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Acide pyroglutamique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Acide pyrrolidone carboxylique-5</skos:altLabel>
		<skos:altLabel xml:lang="fr">Acide pidolique</skos:altLabel>
		<skos:definition xml:lang="en">A cyclized derivative of L-GLUTAMIC ACID. Elevated blood levels may be associated with problems of GLUTAMINE or GLUTATHIONE metabolism. (source : MSH)</skos:definition>
