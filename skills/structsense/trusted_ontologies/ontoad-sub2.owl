		<skos:altLabel xml:lang="en">Methyl xanthine</skos:altLabel>
		<skos:altLabel xml:lang="en">Methylated xanthine derivative</skos:altLabel>
		<skos:altLabel xml:lang="en">Methylxanthine-class Agent</skos:altLabel>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0043314"/>
	</owl:Class>

