		<skos:altLabel xml:lang="en">MULTIPLE ENDOCRINE NEOPL SYNDROMES</skos:altLabel>
		<skos:altLabel xml:lang="en">MEN syndrome</skos:altLabel>
		<skos:altLabel xml:lang="fr">Apudomatose</skos:altLabel>
		<skos:altLabel xml:lang="fr">Polyadénomatose endocrinienne</skos:altLabel>
		<skos:altLabel xml:lang="fr">Adénomatose endocrinienne multiple</skos:altLabel>
		<skos:altLabel xml:lang="fr">Syndromes des tumeurs endocriniennes multiples</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tumeurs endocriniennes multiples</skos:altLabel>
		<skos:altLabel xml:lang="fr">NEM (Néoplasie Endocrinienne Multiple)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tumeurs endocrines multiples</skos:altLabel>
		<skos:altLabel xml:lang="fr">dysfonctionnement pluriglandulaire au cours de l'adénomatose pluri-endocrinienne</skos:altLabel>
		<skos:altLabel xml:lang="fr">adénomatose pluri-endocrinienne familiale</skos:altLabel>
		<skos:altLabel xml:lang="fr">polyadénomatose endocrine</skos:altLabel>
		<skos:definition xml:lang="en">A group of autosomal dominant diseases characterized by the combined occurrence of tumors involving two or more ENDOCRINE GLANDS that secrete PEPTIDE HORMONES or AMINES. These neoplasias are often benign but can be malignant. They are classified by the endocrine glands involved and the degree of aggressiveness. The two major forms are MEN1 and MEN2 with gene mutations on CHROMOSOME 11 and CHROMOSOME 10, respectively. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1302701"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0154222"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0686496"/>
		<OntoAD:disease_has_normal_tissue_origin rdf:resource="&OntoAD;C0014609"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0127527">
		<skos:prefLabel xml:lang="en">Menogaril</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Menogaril</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Ménogaril</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Ménogaril</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">TUT-7</skos:altLabel>
		<skos:definition xml:lang="en">A semisynthetic anthracycline with the amino sugar on the D ring. It displays broad-spectrum antineoplastic activity against a variety of tumors. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003234"/>
	</owl:Class>

