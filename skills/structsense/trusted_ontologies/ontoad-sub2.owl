		<skos:altLabel xml:lang="fr">facteur de croissance des plasmocytomes et des hybridomes</skos:altLabel>
		<skos:altLabel xml:lang="fr">HPGF</skos:altLabel>
		<skos:altLabel xml:lang="fr">IL-HP1</skos:altLabel>
		<skos:altLabel xml:lang="fr">facteur de croissance des plasmacytomes</skos:altLabel>
		<skos:altLabel xml:lang="fr">PCTGF</skos:altLabel>
		<skos:altLabel xml:lang="fr">facteur de croissance des hybridomes</skos:altLabel>
		<skos:altLabel xml:lang="fr">HGF</skos:altLabel>
		<skos:altLabel xml:lang="fr">protéine de différenciation myéloïde</skos:altLabel>
		<skos:altLabel xml:lang="fr">MGI-2A</skos:altLabel>
		<skos:altLabel xml:lang="fr">inducteur type 2 monocytaire-granulocytaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">MGI-2</skos:altLabel>
		<skos:altLabel xml:lang="fr">interféron bêta2</skos:altLabel>
		<skos:altLabel xml:lang="fr">INF bêta2</skos:altLabel>
		<skos:definition xml:lang="en">A cytokine that stimulates the growth and differentiation of B-LYMPHOCYTES and is also a growth factor for HYBRIDOMAS and plasmacytomas. It is produced by many different cells including T-LYMPHOCYTES; MONOCYTES; and FIBROBLASTS. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0021764"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1334961"/>
		<OntoAD:gene_product_has_organism_source rdf:resource="&OntoAD;C0086418"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C0812325"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1333196"/>
		<OntoAD:gene_product_plays_role_in_biological_process rdf:resource="&OntoAD;C0007589"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0008664">
		<skos:prefLabel xml:lang="en">Chromosomes, Human, Pair 21</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Chromosomes,Human,Pair21</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Chromosomes humains de la paire 21</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ChromosomesHumainsDeLaPaire21</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Chromosome 21</skos:altLabel>
		<skos:altLabel xml:lang="en">Chromosome pair 21</skos:altLabel>
		<skos:altLabel xml:lang="fr">Paire de chromosomes 21</skos:altLabel>
		<skos:altLabel xml:lang="fr">Chromosome 21</skos:altLabel>
		<skos:altLabel xml:lang="fr">Chromosome 21 humain</skos:altLabel>
		<skos:altLabel xml:lang="fr">Chromosomes de la paire 21</skos:altLabel>
		<skos:altLabel xml:lang="fr">Chromosomes 21 humains</skos:altLabel>
		<skos:altLabel xml:lang="fr">chromosomes, paire 21</skos:altLabel>
		<skos:definition xml:lang="en">A specific pair of GROUP G CHROMOSOMES of the human chromosome classification. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0008643"/>
		<OntoAD:part_of rdf:resource="&OntoAD;C0007610"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0079183">
		<skos:prefLabel xml:lang="en">Cyclins</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Cyclins</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Cyclines</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Cyclines</skos:hiddenLabel>
		<skos:altLabel xml:lang="fr">Cycline</skos:altLabel>
		<skos:definition xml:lang="en">A large family of regulatory proteins that function as accessory subunits to a variety of CYCLIN-DEPENDENT KINASES. They generally function as ENZYME ACTIVATORS that drive the CELL CYCLE through transitions between phases. A subset of cyclins may also function as transcriptional regulators. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0243021"/>
		<OntoAD:gene_product_has_associated_anatomy rdf:resource="&OntoAD;C0007610"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0815047"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C0017362"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0006772">
		<skos:prefLabel xml:lang="en">Calmodulin</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Calmodulin</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Calmoduline</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Calmoduline</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Calcium-Dependent Regulator</skos:altLabel>
		<skos:altLabel xml:lang="en">Calcium-Dependent Activator Protein</skos:altLabel>
		<skos:altLabel xml:lang="en">Phosphodiesterase Activating Factor</skos:altLabel>
		<skos:altLabel xml:lang="en">Phosphodiesterase Protein Activator</skos:altLabel>
		<skos:altLabel xml:lang="en">CALCIUM DEPENDENT REG</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine régulatrice dépendant du calcium</skos:altLabel>
		<skos:altLabel xml:lang="fr">Régulateur dépendant du calcium</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine régulatrice de la phosphodiestérase</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine activatrice dépendant du calcium</skos:altLabel>
		<skos:definition xml:lang="en">A heat-stable, low-molecular-weight activator protein found mainly in the brain and heart. The binding of calcium ions to this protein allows this protein to bind to cyclic nucleotide phosphodiesterases and to adenyl cyclase with subsequent activation. Thereby this protein modulates cyclic AMP and cyclic GMP levels. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0006732"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0018353">
		<skos:prefLabel xml:lang="en">Guanosine Triphosphate</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">GuanosineTriphosphate</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Guanosine triphosphate</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">GuanosineTriphosphate</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">GTP</skos:altLabel>
		<skos:altLabel xml:lang="en">Guanosine 5'-(tetrahydrogen triphosphate)</skos:altLabel>
		<skos:altLabel xml:lang="en">Guanosine triphosphate (GTP)</skos:altLabel>
		<skos:altLabel xml:lang="fr">GTP</skos:altLabel>
		<skos:altLabel xml:lang="fr">guanosine-triphosphate</skos:altLabel>
		<skos:definition xml:lang="en">Guanosine 5'-(tetrahydrogen triphosphate). A guanine nucleotide containing three phosphate groups esterified to the sugar moiety. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0035548"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0016904">
		<skos:prefLabel xml:lang="en">gamma-Aminobutyric Acid</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Gamma-AminobutyricAcid</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Acide gamma-amino-butyrique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AcideGamma-amino-butyrique</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Aminalone</skos:altLabel>
		<skos:altLabel xml:lang="en">Aminalon</skos:altLabel>
		<skos:altLabel xml:lang="en">Butanoic acid, 4-amino-</skos:altLabel>
		<skos:altLabel xml:lang="en">GABA</skos:altLabel>
		<skos:altLabel xml:lang="en">GABA  Gamma-aminobutyric acid</skos:altLabel>
		<skos:altLabel xml:lang="en">Piperidic Acid</skos:altLabel>
		<skos:altLabel xml:lang="en">AMINOBUTYRIC ACID 04</skos:altLabel>
		<skos:altLabel xml:lang="fr">GABA</skos:altLabel>
		<skos:altLabel xml:lang="fr">Acide gamma-aminobutyrique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Acide 4-amino-butyrique</skos:altLabel>
		<skos:definition xml:lang="en">The most common inhibitory neurotransmitter in the central nervous system. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0002520"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0027908"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0038838">
		<skos:prefLabel xml:lang="en">Superoxide Dismutase</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">SuperoxideDismutase</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Superoxide dismutase</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">SuperoxideDismutase</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Erythrocuprein</skos:altLabel>
		<skos:altLabel xml:lang="en">Hemocuprein</skos:altLabel>
		<skos:altLabel xml:lang="en">Superoxide:superoxide oxidoreductase</skos:altLabel>
		<skos:altLabel xml:lang="en">Superoxide Dismutase (SOD)</skos:altLabel>
		<skos:altLabel xml:lang="en">cytocuprein</skos:altLabel>
		<skos:altLabel xml:lang="en">SOD</skos:altLabel>
		<skos:altLabel xml:lang="en">super oxide dismutase</skos:altLabel>
		<skos:altLabel xml:lang="en">E.C. 1.15.1.1</skos:altLabel>
		<skos:altLabel xml:lang="fr">superoxyde dismutase</skos:altLabel>
		<skos:definition xml:lang="en">An oxidoreductase that catalyzes the reaction between superoxide anions and hydrogen to yield molecular oxygen and hydrogen peroxide. The enzyme protects the cell against dangerous levels of superoxide. EC 1.15.1.1. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0030016"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2240391"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0014442"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1333402"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1335186"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0107103">
		<skos:prefLabel xml:lang="en">Brain-Derived Neurotrophic Factor</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Brain-DerivedNeurotrophicFactor</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Facteur neurotrophique dérivé du cerveau</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">FacteurNeurotrophiqueDérivéDuCerveau</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">BDNF</skos:altLabel>
		<skos:altLabel xml:lang="en">brain derived neurotrophic factor (BDNF)</skos:altLabel>
		<skos:altLabel xml:lang="en">MGC34632</skos:altLabel>
		<skos:altLabel xml:lang="fr">BDNF</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteur neurotrope dérivé du cerveau</skos:altLabel>
		<skos:definition xml:lang="en">A member of the nerve growth factor family of trophic factors. In the brain BDNF has a trophic action on retinal, cholinergic, and dopaminergic neurons, and in the peripheral nervous system it acts on both motor and sensory neurons. (From Kendrew, The Encyclopedia of Molecular Biology, 1994) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0132298"/>
		<OntoAD:gene_product_plays_role_in_biological_process rdf:resource="&OntoAD;C0814002"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C0812325"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0034830">
		<skos:prefLabel xml:lang="en">Nicotinic Receptors</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">NicotinicReceptors</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Récepteurs nicotiniques</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">RécepteursNicotiniques</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Nicotinic Acetylcholine Receptors</skos:altLabel>
		<skos:altLabel xml:lang="en">Nicotinic receptor site</skos:altLabel>
		<skos:altLabel xml:lang="en">Nicotinic receptor</skos:altLabel>
		<skos:altLabel xml:lang="en">NICOTINIC RECEPT</skos:altLabel>
		<skos:altLabel xml:lang="en">NICOTINIC ACETYLCHOLINE RECEPT</skos:altLabel>
		<skos:altLabel xml:lang="en">Receptors, Nicotinic</skos:altLabel>
		<skos:altLabel xml:lang="fr">Récepteur nicotinique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Récepteurs cholinergiques de type nicotinique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Récepteur nicotinique de l'acétylcholine</skos:altLabel>
		<skos:altLabel xml:lang="fr">Récepteurs nicotiniques de l'acétylcholine</skos:altLabel>
		<skos:altLabel xml:lang="fr">Récepteurs nicotiniques à l'acétylcholine</skos:altLabel>
		<skos:definition xml:lang="en">One of the two major classes of cholinergic receptors. Nicotinic receptors were originally distinguished by their preference for NICOTINE over MUSCARINE. They are generally divided into muscle-type and neuronal-type (previously ganglionic) based on pharmacology, and subunit composition of the receptors. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0034792"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0039064"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0034826">
		<skos:prefLabel xml:lang="en">Muscarinic Acetylcholine Receptor</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">MuscarinicAcetylcholineReceptor</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Récepteur muscarinique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">RécepteurMuscarinique</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Receptors, Muscarinic</skos:altLabel>
		<skos:altLabel xml:lang="en">Muscarinic receptor site</skos:altLabel>
		<skos:altLabel xml:lang="en">Muscarinic receptor</skos:altLabel>
		<skos:altLabel xml:lang="en">MUSCARINIC RECEPT</skos:altLabel>
		<skos:altLabel xml:lang="en">MUSCARINIC ACETYLCHOLINE RECEPT</skos:altLabel>
		<skos:altLabel xml:lang="en">muscarinics receptors</skos:altLabel>
		<skos:definition xml:lang="en">One of the two major classes of cholinergic receptors. Muscarinic receptors were originally defined by their preference for MUSCARINE over NICOTINE. There are several subtypes (usually M1, M2, M3....) that are characterized by their cellular actions, pharmacology, and molecular biology. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0034792"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0039064"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0085255">
		<skos:prefLabel xml:lang="en">Synaptophysin</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Synaptophysin</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Synaptophysine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Synaptophysine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">P38 Membrane Protein, Synaptic Vesicle</skos:altLabel>
		<skos:altLabel xml:lang="en">Protein P38, Synaptic Vesicle</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine p38 membranaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine membranaire p38</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine p38 de la vésicule synaptique</skos:altLabel>
		<skos:definition xml:lang="en">A 38-kDa integral membrane glycoprotein of the presynaptic vesicles in neuron and neuroendocrine cells. It is expressed by a variety of normal and neoplastic neuroendocrine cells and is therefore used as an immunocytochemical marker for neuroendocrine differentiation in various tumors. In ALZHEIMER DISEASE and other dementing disorders, there is an important synapse loss due in part to a decrease of synaptophysin in the presynaptic vesicles. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;AminoAcid,Peptide,OrProtein"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;BiologicallyActiveSubstance"/>
	</owl:Class>

