	<owl:Class rdf:about="&OntoAD;C0596473">
		<skos:prefLabel xml:lang="en">Early Diagnosis</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">EarlyDiagnosis</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Diagnostic précoce</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">DiagnosticPrécoce</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">early detection</skos:altLabel>
		<skos:altLabel xml:lang="fr">détection précoce</skos:altLabel>
		<skos:definition xml:lang="en">Methods to determine in patients the nature of a disease or disorder at its early stage of progression. Generally, early diagnosis improves PROGNOSIS and TREATMENT OUTCOME. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Méthodes permettant de déterminer précocément la nature de la maladie ou du trouble. Généralement, le diagnostic précoce permet d'améliorer le pronostic et les résultats du traitement. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1511790"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1947912">
