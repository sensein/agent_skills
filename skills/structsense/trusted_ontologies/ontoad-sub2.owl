	<owl:Class rdf:about="&OntoAD;C0376298">
		<skos:prefLabel xml:lang="en">Consensus</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Consensus</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Consensus</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Consensus</skos:hiddenLabel>
		<skos:definition xml:lang="en">General agreement or collective opinion; the judgment arrived at by most of those concerned. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Accord général ou opinion collective ; ce jugement résulte de la concertation de la plupart des individus concernés. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;SocialBehavior"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0001617">
		<skos:prefLabel xml:lang="en">Adrenal Cortex Hormones</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AdrenalCortexHormones</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Hormones corticosurrénaliennes</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">HormonesCorticosurrénaliennes</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Corticoids</skos:altLabel>
		<skos:altLabel xml:lang="en">Corticosteroids</skos:altLabel>
		<skos:altLabel xml:lang="en">Adrenal cortical hormone</skos:altLabel>
		<skos:altLabel xml:lang="en">Adrenocorticosteroids</skos:altLabel>
		<skos:altLabel xml:lang="en">Corticoid preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">Adrenal Cortex Steroids</skos:altLabel>
		<skos:altLabel xml:lang="en">adrenal corticosteroids</skos:altLabel>
		<skos:altLabel xml:lang="en">Therapeutic Corticosteroid</skos:altLabel>
		<skos:altLabel xml:lang="en">Corticosteroid</skos:altLabel>
		<skos:altLabel xml:lang="fr">corticoïdes</skos:altLabel>
		<skos:altLabel xml:lang="fr">Corticostéroïdes</skos:altLabel>
		<skos:altLabel xml:lang="fr">Hormones cortico-surrénaliennes</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation de corticoïde</skos:altLabel>
		<skos:altLabel xml:lang="fr">hormone corticosurrénalienne</skos:altLabel>
		<skos:definition xml:lang="en">any of the 21-carbon steroids elaborated by the adrenal cortex (excluding the sex hormones of adrenal origin) in response to adrenocorticotropic hormone (ACTH) released by the pituitary gland or to angiotensin II; called also adrenocorticoid, corticoid, adrenal cortical or adrenocortical steroid, and adrenocortical or cortical hormone. (source : CSP)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1445654"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0021081"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0280077"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0162698">
		<skos:prefLabel xml:lang="en">Cost of Illness</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CostOfIllness</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Coût de la maladie</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">CoûtDeLaMaladie</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Sickness Cost</skos:altLabel>
		<skos:altLabel xml:lang="en">Burden of Illness</skos:altLabel>
		<skos:altLabel xml:lang="en">Disease Costs</skos:altLabel>
		<skos:altLabel xml:lang="en">COST DIS</skos:altLabel>
		<skos:altLabel xml:lang="fr">coûts de la maladie</skos:altLabel>
		<skos:altLabel xml:lang="fr">Fardeau de la maladie</skos:altLabel>
		<skos:altLabel xml:lang="fr">Fardeau économique de la maladie</skos:altLabel>
		<skos:altLabel xml:lang="fr">Coûts des maladies</skos:altLabel>
		<skos:definition xml:lang="en">The personal cost of acute or chronic disease. The cost to the patient may be an economic, social, or psychological cost or personal loss to self, family, or immediate community. The cost of illness may be reflected in absenteeism, productivity, response to treatment, peace of mind, QUALITY OF LIFE, etc. It differs from HEALTH CARE COSTS, meaning the societal cost of providing services related to the delivery of health care, rather than personal impact on individuals. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">coût  personnel d'une maladie aiguë ou chronique. Le coût pour le patient peut être un coût économique, social, psychologique ou une perte personnelle pour l'individu, la famille, ou la communauté immédiate. Le coût de la maladie peut être reflété dans l'absentéisme, la productivité, la réponse au traitement, la paix de l'esprit, la qualité de vie, etc... Il diffère des coûts soins médicaux, signifiant le coût social des services en relation avec les soins de santé, plutôt que l'imp (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;QuantitativeConcept"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0010181">
		<skos:prefLabel xml:lang="en">Cost Effectiveness</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CostEffectiveness</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Coût-efficacité</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Coût-efficacité</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">cost-effectiveness</skos:altLabel>
		<skos:altLabel xml:lang="en">COST EFF</skos:altLabel>
		<skos:altLabel xml:lang="fr">Rentabilité</skos:altLabel>
		<skos:definition xml:lang="en">tangible economic benefits produced by money spent; use in conjunction with another term describing what is being cost effective. (source : CSP)</skos:definition>
		<skos:definition xml:lang="fr">Méthode de comparaison du coût d'un programme avec ses bénéfices attendus en dollars (ou une autre devise). Le rapport coût-bénéfice est une mesure du rendement total attendu par unité d'argent dépensé. Cette analyse ne prend généralement pas en considération les facteurs qui ne sont pas, en fin de compte, mesurés en termes économiques. Le rapport coût-efficacité compare des méthodes alternatives de réaliser un ensemble spécifique de résultats. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;QuantitativeConcept"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0011318">
		<skos:prefLabel xml:lang="en">Denmark</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Denmark</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Danemark</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Danemark</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">DNK</skos:altLabel>
		<skos:definition xml:lang="en">A country in Northern Europe, bordering the Baltic Sea and the North Sea, on a peninsula north of Germany (Jutland); also includes two major islands (Sjaelland and Fyn). (NCI) (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0454664"/>
		<OntoAD:conceptual_part_of rdf:resource="&OntoAD;C0015176"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0945826">
		<skos:prefLabel xml:lang="en">Ambulation</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Ambulation</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Marche (locomotion)</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Marche(locomotion)</skos:hiddenLabel>
		<skos:altLabel xml:lang="fr">Deambulation</skos:altLabel>
		<skos:altLabel xml:lang="fr">Ambulation</skos:altLabel>
		<skos:definition xml:lang="en">Ability to walk from place to place independently with or without assistive device (source : NOC)</skos:definition>
		<skos:definition xml:lang="fr">activité dans laquelle le corps avance à un lent pour modérer le pas en déplaçant les pieds d'une manière coordonnée. Cela inclut des promenades à pied de récréation, marchant pour la santé physique et les promenades à pied de course compétitives. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0425245"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0036453">
