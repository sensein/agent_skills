		<skos:altLabel xml:lang="en">C-X-C Chemokines</skos:altLabel>
		<skos:altLabel xml:lang="en">Chemokines, CXC</skos:altLabel>
		<skos:altLabel xml:lang="fr">Chémokines CXC</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéines CXC</skos:altLabel>
		<skos:altLabel xml:lang="fr">alpha-Chémokines</skos:altLabel>
		<skos:altLabel xml:lang="fr">alpha-Chimiokines</skos:altLabel>
