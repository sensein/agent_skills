		<skos:altLabel xml:lang="fr">retour d'âge</skos:altLabel>
		<skos:altLabel xml:lang="fr">climatère féminin</skos:altLabel>
		<skos:altLabel xml:lang="fr">état ménopausique</skos:altLabel>
		<skos:altLabel xml:lang="fr">état climatérique féminin</skos:altLabel>
		<skos:altLabel xml:lang="fr">ménopausée</skos:altLabel>
		<skos:definition xml:lang="en">The last menstrual period. Permanent cessation of menses (MENSTRUATION) is usually defined after 6 to 12 months of AMENORRHEA in a woman over 45 years of age. In the United States, menopause generally occurs in women between 48 and 55 years of age. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1818633"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0029928"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0006684">
