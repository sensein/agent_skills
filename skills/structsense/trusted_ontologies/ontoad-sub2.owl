	<owl:Class rdf:about="&OntoAD;C0270707">
		<skos:prefLabel xml:lang="en">Kluver-Bucy Syndrome</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Kluver-BucySyndrome</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Syndrome de Klüver-Bucy</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">SyndromeDeKlüver-Bucy</skos:hiddenLabel>
		<skos:altLabel xml:lang="fr">Syndrome de Kluver-Bucy</skos:altLabel>
		<skos:altLabel xml:lang="fr">syndrome comportemental post-lobectomie temporale</skos:altLabel>
		<skos:definition xml:lang="en">A neurobehavioral syndrome associated with bilateral medial temporal lobe dysfunction. Clinical manifestations include oral exploratory behavior; tactile exploratory behavior; hypersexuality; BULIMIA; MEMORY DISORDERS; placidity; and an inability to recognize objects or faces. This disorder may result from a variety of conditions, including CRANIOCEREBRAL TRAUMA; infections; ALZHEIMER DISEASE; PICK DISEASE OF THE BRAIN; and CEREBROVASCULAR DISORDERS. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0039082"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1709838"/>
		<OntoAD:manifestation_of rdf:resource="&OntoAD;C0338451"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0022802">
		<skos:prefLabel xml:lang="en">Kuru</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Kuru</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Kuru</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Kuru</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Kuru encephalitis</skos:altLabel>
		<skos:altLabel xml:lang="en">Kuru agent infection</skos:altLabel>
		<skos:altLabel xml:lang="en">Kuru Encephalopathy</skos:altLabel>
		<skos:altLabel xml:lang="en">disease; kuru</skos:altLabel>
		<skos:altLabel xml:lang="en">kuru; disease</skos:altLabel>
		<skos:altLabel xml:lang="en">ENCEPH KURU</skos:altLabel>
		<skos:altLabel xml:lang="fr">Infection par l'agent du Kuru</skos:altLabel>
		<skos:definition xml:lang="en">A prion disease found exclusively among the Fore linguistic group natives of the highlands of NEW GUINEA. The illness is primarily restricted to adult females and children of both sexes. It is marked by the subacute onset of tremor and ataxia followed by motor weakness and incontinence. Death occurs within 3-6 months of disease onset. The condition is associated with ritual cannibalism, and has become rare since this practice has been discontinued. Pathologic features include a noninflammatory l (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0162534"/>
		<OntoAD:has_location rdf:resource="&OntoAD;C0006104"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0242202"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0023570">
		<skos:prefLabel xml:lang="en">Levodopa</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Levodopa</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Lévodopa</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Lévodopa</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">L-Dopa</skos:altLabel>
		<skos:altLabel xml:lang="en">Levo Dopa</skos:altLabel>
		<skos:altLabel xml:lang="en">L-3,4-Dihydroxyphenylalanine</skos:altLabel>
		<skos:altLabel xml:lang="en">L-3-hydroxytyrosine</skos:altLabel>
		<skos:altLabel xml:lang="en">L-Dopa  Levodopa</skos:altLabel>
		<skos:altLabel xml:lang="en">L-dopa preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">beta-(3,4-Dihydroxyphenyl)-L-alanine</skos:altLabel>
		<skos:altLabel xml:lang="en">DOPA A L</skos:altLabel>
		<skos:altLabel xml:lang="fr">L-Dopa</skos:altLabel>
		<skos:altLabel xml:lang="fr">dihydroxyphénylalanine</skos:altLabel>
		<skos:altLabel xml:lang="fr">L-3-hydroxytyrosine</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation de L-dopa</skos:altLabel>
		<skos:definition xml:lang="en">The naturally occurring form of DIHYDROXYPHENYLALANINE and the immediate precursor of DOPAMINE. Unlike dopamine itself, it can be taken orally and crosses the blood-brain barrier. It is rapidly taken up by dopaminergic neurons and converted to DOPAMINE. It is used for the treatment of PARKINSONIAN DISORDERS and is usually given with agents that inhibit its conversion to dopamine outside of the central nervous system. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0013023"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0030567"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013182"/>
	</owl:Class>

