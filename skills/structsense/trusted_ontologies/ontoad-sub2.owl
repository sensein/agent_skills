		<skos:altLabel xml:lang="en">Consciousness, Loss of</skos:altLabel>
		<skos:altLabel xml:lang="en">Unconscious</skos:altLabel>
		<skos:altLabel xml:lang="en">Unconsciousness</skos:altLabel>
		<skos:altLabel xml:lang="en">Loss of consiousness</skos:altLabel>
		<skos:altLabel xml:lang="en">Loss of consciousness</skos:altLabel>
		<skos:altLabel xml:lang="en">LOC  Loss of consciousness</skos:altLabel>
		<skos:altLabel xml:lang="en">Consciousness awaking loss</skos:altLabel>
		<skos:altLabel xml:lang="en">Lost consciousness</skos:altLabel>
		<skos:altLabel xml:lang="en">LOC</skos:altLabel>
		<skos:altLabel xml:lang="en">Unconscious(ness)</skos:altLabel>
		<skos:altLabel xml:lang="en">locs</skos:altLabel>
		<skos:altLabel xml:lang="fr">inconscience</skos:altLabel>
		<skos:altLabel xml:lang="fr">Anosognosie</skos:altLabel>
		<skos:altLabel xml:lang="fr">Inconscient</skos:altLabel>
		<skos:altLabel xml:lang="fr">Perte de connaissance</skos:altLabel>
		<skos:altLabel xml:lang="fr">État inconscient</skos:altLabel>
		<skos:altLabel xml:lang="fr">Perte de consc</skos:altLabel>
		<skos:altLabel xml:lang="fr">A perdu connaissance</skos:altLabel>
		<skos:altLabel xml:lang="fr">Perte de connaissance au réveil</skos:altLabel>
		<skos:definition xml:lang="en">Loss of the ability to maintain awareness of self and environment combined with markedly reduced responsiveness to environmental stimuli. (From Adams et al., Principles of Neurology, 6th ed, pp344-5) (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">perte de la capacité à maintenir une conscience de soi et de l'environnement combinée avec une sensibilité nettement réduite aux stimulus de l'environnement. (traduit de 'From Adams et al., Principles of Neurology, 6th ed, pp344-5') (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0549249"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0036572"/>
