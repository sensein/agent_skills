	<owl:Class rdf:about="&OntoAD;C0027740">
		<skos:prefLabel xml:lang="en">Nerve</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Nerve</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Nervus</skos:altLabel>
