	<owl:Class rdf:about="&OntoAD;C1430701">
		<skos:prefLabel xml:lang="en">RPL29 protein, human</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">RPL29Protein,Human</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">HIP</skos:altLabel>
		<skos:altLabel xml:lang="en">Ribosomal Protein L29</skos:altLabel>
		<skos:altLabel xml:lang="en">Cell Surface Heparin-Binding Protein HIP</skos:altLabel>
		<skos:altLabel xml:lang="en">Heparin/Heparan Sulfate-Binding Protein</skos:altLabel>
		<skos:altLabel xml:lang="en">HP/HS-Interacting Protein</skos:altLabel>
		<skos:altLabel xml:lang="en">Heparin/Heparan Sulfate-Interacting Protein</skos:altLabel>
		<skos:altLabel xml:lang="en">HUMRPL29</skos:altLabel>
		<skos:altLabel xml:lang="en">RPL29</skos:altLabel>
		<skos:altLabel xml:lang="en">HP-HS-interacting protein (HIP), human</skos:altLabel>
		<skos:altLabel xml:lang="en">heparin-interacting protein, human</skos:altLabel>
		<skos:altLabel xml:lang="en">heparin sulfate-interacting protein, human</skos:altLabel>
		<skos:altLabel xml:lang="en">HIP protein, human</skos:altLabel>
		<skos:altLabel xml:lang="en">ribosomal protein L29, human</skos:altLabel>
		<skos:definition xml:lang="en">Ribosomes, the organelles that catalyze protein synthesis, consist of a small 40S subunit and a large 60S subunit. Together these subunits are composed of 4 RNA species and approximately 80 structurally distinct proteins. Ribosomal Protein L29, encoded by the RPL29 gene, is a ribosomal protein that is a component of the large 60S ribosomal subunit. This protein belongs to the L19E family of ribosomal proteins. It is located in the cytoplasm. The protein is also a peripheral membrane protein expr (source : )</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0035552"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1335638"/>
		<OntoAD:gene_product_has_organism_source rdf:resource="&OntoAD;C0086418"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1704840">
		<skos:prefLabel xml:lang="en">ST13 wt Allele</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">ST13WtAllele</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">HIP</skos:altLabel>
		<skos:altLabel xml:lang="en">HOP</skos:altLabel>
		<skos:altLabel xml:lang="en">Heat Shock 70kD Protein Binding Protein Gene</skos:altLabel>
		<skos:altLabel xml:lang="en">FAM10A1</skos:altLabel>
		<skos:altLabel xml:lang="en">HSPABP</skos:altLabel>
		<skos:altLabel xml:lang="en">HSPABP1</skos:altLabel>
		<skos:altLabel xml:lang="en">P48</skos:altLabel>
		<skos:altLabel xml:lang="en">PRO0786</skos:altLabel>
		<skos:altLabel xml:lang="en">SNC6</skos:altLabel>
		<skos:altLabel xml:lang="en">Suppression of Tumorigenicity 13 (Colon Carcinoma) (Hsp70 Interacting Protein) wt Allele</skos:altLabel>
		<skos:definition xml:lang="en">Human ST13 wild-type allele is located in the vicinity of 22q13.2 and is approximately 32 kb in length. This allele, which encodes Hsc70-interacting protein, is involved in the determination of protein conformation. This gene is expressed at reduced levels in colorectal carcinomas. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1337104"/>
	</owl:Class>

