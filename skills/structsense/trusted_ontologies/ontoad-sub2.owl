	<owl:Class rdf:about="&OntoAD;C1336806">
		<skos:prefLabel xml:lang="en">Translation Process Gene</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">TranslationProcessGene</skos:hiddenLabel>
		<skos:definition xml:lang="en">Genes that encode products which participate in translation, a complex mechanism that occurs on ribosomes. During this process, a peptide or protein is synthesized by utilizing an mRNA transcript to specify the sequence of amino acids in the resulting polypeptide. There are numerous translation process genes, as the synthesis of polypeptides requires ribosomal RNA, transfer RNA, GTP and proteins involved specifically in the activation of amino acids, initiation of synthesis, elongation and termi (source : )</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0017337"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1335786">
		<skos:prefLabel xml:lang="en">Ribosome Subunit Gene</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">RibosomeSubunitGene</skos:hiddenLabel>
		<skos:definition xml:lang="en">Ribosome Subunit Genes encode Ribosomal Proteins, present in either the small or the large ribosomal subunit and involved in protein synthesis. In eukaryotes there are 50 proteins in the large subunit and 33 in the small subunit. (NCI) (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1336806"/>
	</owl:Class>

