	<owl:Class rdf:about="&OntoAD;C0001898">
		<skos:prefLabel xml:lang="en">Alanine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Alanine</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Alanine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Alanine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">L-Alanine</skos:altLabel>
		<skos:altLabel xml:lang="en">Ala</skos:altLabel>
		<skos:altLabel xml:lang="en">Alanine, L-Isomer</skos:altLabel>
		<skos:altLabel xml:lang="en">alpha-Aminopropionic acid</skos:altLabel>
		<skos:altLabel xml:lang="fr">L-Alanine</skos:altLabel>
		<skos:definition xml:lang="en">A non-essential amino acid that occurs in high levels in its free state in plasma. It is produced from pyruvate by transamination. It is involved in sugar and acid metabolism, increases IMMUNITY, and provides energy for muscle tissue, BRAIN, and the CENTRAL NERVOUS SYSTEM. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0301715"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0311461"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0311462"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2348255"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0556084"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013182"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0003968">
		<skos:prefLabel xml:lang="en">Ascorbic Acid</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AscorbicAcid</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Acide ascorbique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AcideAscorbique</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">L-Ascorbic Acid</skos:altLabel>
		<skos:altLabel xml:lang="en">Vitamin C</skos:altLabel>
		<skos:altLabel xml:lang="en">Ascorbic acid preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">Ascorbic acid product</skos:altLabel>
		<skos:altLabel xml:lang="en">Vitamin C preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">Vitamin C product</skos:altLabel>
		<skos:altLabel xml:lang="en">VIT C</skos:altLabel>
		<skos:altLabel xml:lang="en">VITC  Ascorbic acid</skos:altLabel>
		<skos:altLabel xml:lang="en">vitamins ascorbic acid</skos:altLabel>
		<skos:altLabel xml:lang="fr">Vitamine C</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation de vitamine C</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation d'acide ascorbique</skos:altLabel>
		<skos:definition xml:lang="en">A six carbon compound related to glucose. It is found naturally in citrus fruits and many vegetables. Ascorbic acid is an essential nutrient in human diets, and necessary to maintain connective tissue and bone. Its biologically active form, vitamin C, functions as a reducing agent and coenzyme in several metabolic pathways. Vitamin C is considered an antioxidant. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003402"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0259754"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0038651"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013182"/>
	</owl:Class>

