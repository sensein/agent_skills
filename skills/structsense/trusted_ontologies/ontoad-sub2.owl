	<owl:Class rdf:about="&OntoAD;C0303231">
		<skos:prefLabel xml:lang="en">Lead compound</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">LeadCompound</skos:hiddenLabel>
		<skos:altLabel xml:lang="fr">composé de plomb</skos:altLabel>
		<skos:definition xml:lang="en">An inorganic or organic substance that contains the metallic element lead either in its positive-2 or 4 valence state. Lead compounds have a wide variety of applications in industry. Exposure to lead compounds affects the lungs, central nervous system and kidneys. Lead compounds are possible mutagens and are reasonably anticipated to be human carcinogens. The substance may be associated with an increased risk of developing lung and stomach cancer. (NCI05) (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0303229"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1707283"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0589331">
