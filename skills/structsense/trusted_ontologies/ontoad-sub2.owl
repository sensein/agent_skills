		<rdfs:subClassOf rdf:resource="&OntoAD;C1292269"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0019080"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013182"/>
	</owl:Class>

