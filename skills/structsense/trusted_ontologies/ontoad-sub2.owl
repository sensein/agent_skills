		<skos:altLabel xml:lang="en">HIV-related dementia</skos:altLabel>
		<skos:altLabel xml:lang="en">Dementia Complex, AIDS-Related</skos:altLabel>
		<skos:altLabel xml:lang="en">AIDS with dementia</skos:altLabel>
		<skos:altLabel xml:lang="en">HIV disease; dementia</skos:altLabel>
		<skos:altLabel xml:lang="en">HIV disease; resulting in, dementia</skos:altLabel>
		<skos:altLabel xml:lang="en">dementia; human immunodeficiency virus disease</skos:altLabel>
