	<owl:Class rdf:about="&OntoAD;C0034117">
		<skos:prefLabel xml:lang="en">Puncture procedure</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">PunctureProcedure</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Ponctions</skos:prefLabel>
