	<owl:Class rdf:about="&OntoAD;C0007272">
		<skos:prefLabel xml:lang="en">Carotid Arteries</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CarotidArteries</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Artères carotides</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ArtèresCarotides</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">carotid artery</skos:altLabel>
		<skos:altLabel xml:lang="en">Carotid artery structure</skos:altLabel>
		<skos:altLabel xml:lang="fr">artère carotide, SAI</skos:altLabel>
		<skos:definition xml:lang="en">Either of the two principal arteries on both sides of the neck that supply blood to the head and neck; each divides into two branches, the internal carotid artery and the external carotid artery. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003842"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1267283"/>
		<OntoAD:finding_site_of rdf:resource="&OntoAD;C0007282"/>
		<OntoAD:finding_site_of rdf:resource="&OntoAD;C0007273"/>
		<OntoAD:finding_site_of rdf:resource="&OntoAD;C0577631"/>
		<OntoAD:finding_site_of rdf:resource="&OntoAD;C0265101"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0162859">
		<skos:prefLabel xml:lang="en">Common carotid artery</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CommonCarotidArtery</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Artère carotide commune</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ArtèreCarotideCommune</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Arteria carotis communis</skos:altLabel>
		<skos:altLabel xml:lang="en">Trunk of common carotid tree</skos:altLabel>
		<skos:altLabel xml:lang="en">Common carotid artery structure</skos:altLabel>
		<skos:altLabel xml:lang="fr">Artère carotide primitive</skos:altLabel>
		<skos:altLabel xml:lang="fr">artère carotide primitive, SAI</skos:altLabel>
		<skos:altLabel xml:lang="fr">artère carotide commune, SAI</skos:altLabel>
		<skos:definition xml:lang="en">The two principal arteries supplying the structures of the head and neck. They ascend in the neck, one on each side, and at the level of the upper border of the thyroid cartilage, each divides into two branches, the external (CAROTID ARTERY, EXTERNAL) and internal (CAROTID ARTERY, INTERNAL) carotid arteries. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0007272"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0933549"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1283791"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0014272">
		<skos:prefLabel xml:lang="en">Energy Metabolism</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">EnergyMetabolism</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Métabolisme énergétique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">MétabolismeÉnergétique</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">energy expenditure</skos:altLabel>
		<skos:altLabel xml:lang="en">ENERGY METAB</skos:altLabel>
		<skos:altLabel xml:lang="en">Energy Metabolism Process</skos:altLabel>
		<skos:altLabel xml:lang="fr">Dépense énergétique</skos:altLabel>
		<skos:definition xml:lang="en">The chemical reactions involved in the production and utilization of various forms of energy in cells. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;PhysiologicFunction"/>
		<OntoAD:biological_process_involves_gene_product rdf:resource="&OntoAD;C0021641"/>
		<OntoAD:process_involves_gene rdf:resource="&OntoAD;C1337112"/>
		<OntoAD:biological_process_has_result_chemical_or_drug rdf:resource="&OntoAD;C0001480"/>
		<OntoAD:biological_process_involves_gene_product rdf:resource="&OntoAD;C0010760"/>
	</owl:Class>

