		<rdfs:subClassOf rdf:resource="&OntoAD;C0454690"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0036591">
		<skos:prefLabel xml:lang="en">Self-Assessment</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Self-Assessment</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Autoévaluation</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Autoévaluation</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Self Assessment</skos:altLabel>
