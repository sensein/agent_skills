	<owl:Class rdf:about="&OntoAD;C0030695">
		<skos:prefLabel xml:lang="en">Patient Monitoring</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">PatientMonitoring</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Monitorage du patient</skos:prefLabel>
