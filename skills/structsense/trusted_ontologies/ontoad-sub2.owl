	<owl:Class rdf:about="&OntoAD;C0079189">
		<skos:prefLabel xml:lang="en">cytokine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Cytokine</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Cytokines</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Cytokines</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">cytokines</skos:altLabel>
		<skos:altLabel xml:lang="fr">cytokine</skos:altLabel>
		<skos:definition xml:lang="en">Non-antibody proteins secreted by inflammatory leukocytes and some non-leukocytic cells, that act as intercellular mediators. They differ from classical hormones in that they are produced by a number of tissue or cell types rather than by specialized glands. They generally act locally in a paracrine or autocrine rather than endocrine manner. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">http://info.cancer.ca/f/glossary/C/Cytokine.htm (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0017968"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0815043"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0301974"/>
		<OntoAD:is_biochemical_function_of_gene_product rdf:resource="&OntoAD;C0079460"/>
		<OntoAD:is_biochemical_function_of_gene_product rdf:resource="&OntoAD;C0385242"/>
		<OntoAD:is_biochemical_function_of_gene_product rdf:resource="&OntoAD;C0021745"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1333196"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1524094">
		<skos:prefLabel xml:lang="en">Recombinant Cytokines</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">RecombinantCytokines</skos:hiddenLabel>
		<skos:definition xml:lang="en">A substance that is made by cells of the immune system. Some cytokines can boost the immune response and others can suppress it. Cytokines can also be made in the laboratory by recombinant DNA technology and used in the treatment of various diseases, including cancer. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0005525"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2979985"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0052201">
		<skos:prefLabel xml:lang="en">Apolipoprotein E4</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">ApolipoproteinE4</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Apolipoprotéine E4</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ApolipoprotéineE4</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">APOE4</skos:altLabel>
		<skos:altLabel xml:lang="en">APOE e4</skos:altLabel>
		<skos:altLabel xml:lang="en">APOE e4 allele</skos:altLabel>
		<skos:altLabel xml:lang="en">APOE epsilon 4</skos:altLabel>
		<skos:altLabel xml:lang="en">APOE epsilon 4 allele</skos:altLabel>
		<skos:altLabel xml:lang="en">APOE epsilon4</skos:altLabel>
		<skos:altLabel xml:lang="en">APOE epsilon4 allele</skos:altLabel>
		<skos:altLabel xml:lang="en">APOE-epsilon 4</skos:altLabel>
		<skos:altLabel xml:lang="en">APOE-epsilon 4 allele</skos:altLabel>
		<skos:altLabel xml:lang="en">epsilon 4 allele</skos:altLabel>
		<skos:altLabel xml:lang="en">Apolipoprotein E-4</skos:altLabel>
		<skos:altLabel xml:lang="en">Apo E-4</skos:altLabel>
		<skos:altLabel xml:lang="en">Apo E4</skos:altLabel>
		<skos:altLabel xml:lang="en">Apo E epsilon 4</skos:altLabel>
		<skos:altLabel xml:lang="en">Apolipoprotein E-IV</skos:altLabel>
		<skos:altLabel xml:lang="en">APOLIPOPROTEIN E 004</skos:altLabel>
		<skos:altLabel xml:lang="fr">ApoE4</skos:altLabel>
		<skos:altLabel xml:lang="fr">ApoE4+</skos:altLabel>
		<skos:altLabel xml:lang="fr">allèle epsilon</skos:altLabel>
		<skos:altLabel xml:lang="fr">Apolipoprotéine epsilon E4</skos:altLabel>
		<skos:altLabel xml:lang="fr">Apolipoprotéine E-4</skos:altLabel>
		<skos:altLabel xml:lang="fr">Apo E-4</skos:altLabel>
		<skos:altLabel xml:lang="fr">Apo E4</skos:altLabel>
		<skos:altLabel xml:lang="fr">Apolipoprotéine de type E4</skos:altLabel>
		<skos:definition xml:lang="en">A major and the second most common isoform of apolipoprotein E. In humans, Apo E4 differs from APOLIPOPROTEIN E3 at only one residue 112 (cysteine is replaced by arginine), and exhibits a lower resistance to denaturation and greater propensity to form folded intermediates. Apo E4 is a risk factor for ALZHEIMER DISEASE and CARDIOVASCULAR DISEASES. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">commandant et deuxième isoforme le plus commun d'apolipoprotéine E. Chez les humains, Apo E4 diffère d'APOLIPOPROTÉINE E3 à seulement un résidu 112 (cystéine est remplacé par arginine ) et expose une résistance plus basse à dénaturation et la plus grande propension de former des intermédiaires pliés. Apo E4 est un facteur de risque pour la MALADIE ALZHEIMER et les MALADIES CARDIOVASCULAIRES. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0443526"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0038661">
		<skos:prefLabel xml:lang="en">Suicide</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Suicide</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Suicide</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Suicide</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">F-D06 SUICIDES</skos:altLabel>
		<skos:altLabel xml:lang="en">suicide completion</skos:altLabel>
		<skos:definition xml:lang="en">The act of killing oneself. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">http://www.fnclcc.fr/fr/patients/dico/definition.php?id_definition=1562 (source : CISMeF)</skos:definition>
