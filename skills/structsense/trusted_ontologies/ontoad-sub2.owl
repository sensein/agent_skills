	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0035527">
		<skos:prefLabel xml:lang="en">Riboflavin</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Riboflavin</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Riboflavine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Riboflavine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Vitamin B 2</skos:altLabel>
		<skos:altLabel xml:lang="en">Vitamin G</skos:altLabel>
		<skos:altLabel xml:lang="en">Vitamin B2</skos:altLabel>
		<skos:altLabel xml:lang="en">Vitamin B2 preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">Vitamin G preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">Lactoflavin preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">Riboflavin preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">Lactoflavin</skos:altLabel>
		<skos:altLabel xml:lang="en">Vitamin B2 preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">Riboflavine preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">VITAMIN B A 02</skos:altLabel>
		<skos:altLabel xml:lang="en">vitamins riboflavin</skos:altLabel>
		<skos:altLabel xml:lang="fr">Lactoflavine</skos:altLabel>
		<skos:altLabel xml:lang="fr">Ovoflavine</skos:altLabel>
		<skos:altLabel xml:lang="fr">Vitamine B2</skos:altLabel>
		<skos:altLabel xml:lang="fr">Vitamine G</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation de riboflavine</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation de lactoflavine</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation de vitamine B2</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation de vitamine G</skos:altLabel>
		<skos:altLabel xml:lang="fr">vitamine B2</skos:altLabel>
		<skos:definition xml:lang="en">Nutritional factor found in milk, eggs, malted barley, liver, kidney, heart, and leafy vegetables. The richest natural source is yeast. It occurs in the free form only in the retina of the eye, in whey, and in urine; its principal forms in tissues and cells are as FLAVIN MONONUCLEOTIDE and FLAVIN-ADENINE DINUCLEOTIDE. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0042849"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1704763"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0162713"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013182"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0162713">
		<skos:prefLabel xml:lang="en">Photosensitizing Agents</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">PhotosensitizingAgents</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Photosensibilisants</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Photosensibilisants</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Photosensitizers</skos:altLabel>
		<skos:altLabel xml:lang="en">Photosensitizing agent</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents photosensibilisants</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments photosensibilisants</skos:altLabel>
		<skos:definition xml:lang="en">Drugs that are pharmacologically inactive but when exposed to ultraviolet radiation or sunlight are converted to their active metabolite to produce a beneficial reaction affecting the diseased tissue. These compounds can be administered topically or systemically and have been used therapeutically to treat psoriasis and various types of neoplasms. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003392"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0032017">
		<skos:prefLabel xml:lang="en">Posterior Pituitary Hormones</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">PosteriorPituitaryHormones</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Hormones post-hypophysaires</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">HormonesPost-hypophysaires</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">POSTERIOR PITUITARY</skos:altLabel>
		<skos:altLabel xml:lang="en">Neurohypophyseal Hormones</skos:altLabel>
		<skos:altLabel xml:lang="en">Posterior pituitary hormone</skos:altLabel>
		<skos:altLabel xml:lang="en">Neurohypophyseal Peptides</skos:altLabel>
		<skos:altLabel xml:lang="en">Pituitary Hormones, Posterior</skos:altLabel>
		<skos:altLabel xml:lang="fr">Hormones neurohypophysaires</skos:altLabel>
		<skos:altLabel xml:lang="fr">Hormones posthypophysaires</skos:altLabel>
		<skos:altLabel xml:lang="fr">Hormones neuro-hypophysaires</skos:altLabel>
		<skos:altLabel xml:lang="fr">hormone posthypophysaire</skos:altLabel>
		<skos:definition xml:lang="en">Hormones released from the neurohypophysis (PITUITARY GLAND, POSTERIOR). They include a number of peptides which are formed in the NEURONS in the HYPOTHALAMUS, bound to NEUROPHYSINS, and stored in the nerve terminals in the posterior pituitary. Upon stimulation, these peptides are released into the hypophysial portal vessel blood. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0032015"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0304812"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1336771">
		<skos:prefLabel xml:lang="en">Trace Metal Storage Protein</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">TraceMetalStorageProtein</skos:hiddenLabel>
		<skos:definition xml:lang="en">A protein that binds to and stores essential metals in the body both to make them available for biological processes and to prevent the toxic effects of free metals in an organism. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0242210"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1334396"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0040691">
		<skos:prefLabel xml:lang="en">Transforming Growth Factors</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">TransformingGrowthFactors</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Facteurs de croissance transformants</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">FacteursDeCroissanceTransformants</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Animal growth regulators, transforming growth factors</skos:altLabel>
		<skos:altLabel xml:lang="en">TGF</skos:altLabel>
		<skos:altLabel xml:lang="en">Tumor Growth Factors</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteurs de transformation</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteurs transformants de croissance</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteurs TGF</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteurs transformants TGF</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteur de croissance TGF</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteur de croissance transformant</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteur transformant TGF</skos:altLabel>
		<skos:altLabel xml:lang="fr">TGF (Transforming Growth Factor)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteurs de croissance TGF</skos:altLabel>
		<skos:definition xml:lang="en">Hormonally active polypeptides that can induce the transformed phenotype when added to normal, non-transformed cells. They have been found in culture fluids from retrovirally transformed cells and in tumor-derived cells as well as in non-neoplastic sources. Their transforming activities are due to the simultaneous action of two otherwise unrelated factors, TRANSFORMING GROWTH FACTOR ALPHA and TRANSFORMING GROWTH FACTOR BETA. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0018284"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C0812325"/>
	</owl:Class>

