	<owl:Class rdf:about="&OntoAD;C0019360">
		<skos:prefLabel xml:lang="en">Herpes zoster disease</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">HerpesZosterDisease</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Zona</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Zona</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Herpes Zoster</skos:altLabel>
		<skos:altLabel xml:lang="en">Herpes zoster infection</skos:altLabel>
		<skos:altLabel xml:lang="en">Shingles</skos:altLabel>
		<skos:altLabel xml:lang="en">Zona</skos:altLabel>
		<skos:altLabel xml:lang="en">Zoster</skos:altLabel>
		<skos:altLabel xml:lang="en">Zoste</skos:altLabel>
		<skos:altLabel xml:lang="en">herpes zona</skos:altLabel>
		<skos:altLabel xml:lang="en">zonas</skos:altLabel>
		<skos:altLabel xml:lang="fr">HERPES ZOSTER</skos:altLabel>
		<skos:altLabel xml:lang="fr">syndrome radiculo-ganglionnaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">zona sans mention de complications</skos:altLabel>
		<skos:altLabel xml:lang="fr">Zona [herpes zoster]</skos:altLabel>
		<skos:definition xml:lang="en">An acute infectious, usually self-limited, disease believed to represent activation of latent varicella-zoster virus (HERPESVIRUS 3, HUMAN) in those who have been rendered partially immune after a previous attack of CHICKENPOX. It involves the SENSORY GANGLIA and their areas of innervation and is characterized by severe neuralgic pain along the distribution of the affected nerve and crops of clustered vesicles over the area. (From Dorland, 27th ed) (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Infection aiguë mais généralement limitée, due à une réactivation du virus de la varicelle et du zona (herpès virus 3 humain). Cette infection survient obligatoirement chez des personnes ayant déjà fait une varicelle (partiellement immunisées). Le virus reste latent dans les cellules des ganglions des nerfs sensitifs et la réactivation se fait dans le territoire d'un des nerfs sensitifs. Elle est caractérisée au niveau de la peau par une éruption vésiculaire à topographie radiculaire, en général (source : MSHFRE)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2047214"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1264605"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0586989"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0010934"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:has_associated_morphology rdf:resource="&OntoAD;C0021368"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0019340"/>
		<OntoAD:has_causative_agent rdf:resource="&OntoAD;C0042338"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0001175"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1318464">
		<skos:prefLabel xml:lang="en">Occupational therapy regime</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">OccupationalTherapyRegime</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Ergothérapie</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Ergothérapie</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">occupational therapy</skos:altLabel>
		<skos:altLabel xml:lang="en">Occupational therapist service</skos:altLabel>
		<skos:altLabel xml:lang="en">OT  Occupational therapy</skos:altLabel>
		<skos:altLabel xml:lang="en">OCCUP THER</skos:altLabel>
		<skos:altLabel xml:lang="en">rnrx occupational therapist service</skos:altLabel>
		<skos:altLabel xml:lang="fr">thérapie occupationnelle</skos:altLabel>
		<skos:definition xml:lang="en">Skilled treatment that helps individuals achieve independence in all facets of their lives. It assists in the development of skills needed for independent living. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Méthode de rééducation aux gestes de la vie quotidienne visant à aider les personnes atteintes de maladies physiques et/ou psychiques. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2266628"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2922251"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1443532"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0011546">
		<skos:prefLabel xml:lang="en">emotional dependency</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">EmotionalDependency</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Dépendance (psychologie)</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Dépendance(psychologie)</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">dependency</skos:altLabel>
		<skos:altLabel xml:lang="en">dependence</skos:altLabel>
		<skos:altLabel xml:lang="en">Dependency (Personality)</skos:altLabel>
		<skos:altLabel xml:lang="en">DEPENDENCY PSYCHOL</skos:altLabel>
		<skos:altLabel xml:lang="fr">dépendance</skos:altLabel>
		<skos:altLabel xml:lang="fr">Dépendance psychologique</skos:altLabel>
		<skos:definition xml:lang="en">The tendency of an individual or individuals to rely on others for advice, guidance, or support. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Tendance d'un ou de plusieurs individus à compter sur les autres pour un avis, une conduite à tenir, ou un soutien. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0233849"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0004057">
		<skos:prefLabel xml:lang="en">Aspirin</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Aspirin</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Acide acétylsalicylique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AcideAcétylsalicylique</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Acetylsalicylic Acid</skos:altLabel>
		<skos:altLabel xml:lang="en">Antiplatelet aspirin</skos:altLabel>
		<skos:altLabel xml:lang="en">ASA</skos:altLabel>
		<skos:altLabel xml:lang="en">Acetylsalicylic acid  chemical</skos:altLabel>
		<skos:altLabel xml:lang="en">Aspirin  chemical</skos:altLabel>
		<skos:altLabel xml:lang="en">Aspirin product</skos:altLabel>
		<skos:altLabel xml:lang="en">acetylsalicyclic acid</skos:altLabel>
		<skos:altLabel xml:lang="fr">aspirine</skos:altLabel>
		<skos:definition xml:lang="en">The prototypical analgesic used in the treatment of mild to moderate pain. It has anti-inflammatory and antipyretic properties and acts as an inhibitor of cyclooxygenase which results in the inhibition of the biosynthesis of prostaglandins. Aspirin also inhibits platelet aggregation and is used in the prevention of arterial and venous thrombosis. (From Martindale, The Extra Pharmacopoeia, 30th ed, p5) (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Analgésique employé dans le traitement de la douleur moyenne à modérée. Elle a des propriétés anti-inflammatoires et antipyrétiques; elle inhibe la cyclooxygénase, ce qui a pour conséquence l'inhibition de la synthèse des prostaglandines. L'aspirine également empêche l'agrégation des plaquettes et est employée dans la prévention des thromboses artérielle et veineuse. (de Martindale, de la pharmacopée supplémentaire, du 30ème ED, du p5) (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0036077"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0036075"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0085826"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0016018"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0013182"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0029408"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0021368"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0042769"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0018099"/>
		<OntoAD:may_prevent rdf:resource="&OntoAD;C0007785"/>
		<OntoAD:may_prevent rdf:resource="&OntoAD;C0027051"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0003873"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0004096"/>
		<OntoAD:may_prevent rdf:resource="&OntoAD;C0030193"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0035436"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0005779"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0005818"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0020255">
		<skos:prefLabel xml:lang="en">Hydrocephalus</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Hydrocephalus</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Hydrocéphalie</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Hydrocéphalie</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Hydrencephalus</skos:altLabel>
		<skos:altLabel xml:lang="en">Hydrencephaly</skos:altLabel>
		<skos:altLabel xml:lang="en">Hydrocephaly</skos:altLabel>
		<skos:altLabel xml:lang="en">Water on the brain</skos:altLabel>
		<skos:altLabel xml:lang="fr">Hydrocéphalie, sans précision</skos:altLabel>
		<skos:definition xml:lang="en">Excessive accumulation of cerebrospinal fluid within the cranium which may be associated with dilation of cerebral ventricles, INTRACRANIAL HYPERTENSION; HEADACHE; lethargy; URINARY INCONTINENCE; and ATAXIA. (source : MSH)</skos:definition>
