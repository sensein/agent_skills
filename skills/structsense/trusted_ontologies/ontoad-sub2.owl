		<skos:altLabel xml:lang="en">Oculomotor Paralysis</skos:altLabel>
		<skos:altLabel xml:lang="en">EYE MOVEMENT IMPAIRMENT</skos:altLabel>
		<skos:altLabel xml:lang="en">Muscle paralysis eye</skos:altLabel>
		<skos:altLabel xml:lang="en">Paralysis extraocular muscle (s)</skos:altLabel>
		<skos:altLabel xml:lang="en">Ophthalmoplegia syndrome</skos:altLabel>
		<skos:altLabel xml:lang="fr">PARALYSIE OCULOMOTRICE</skos:altLabel>
		<skos:altLabel xml:lang="fr">Paralysie oculo-motrice</skos:altLabel>
		<skos:altLabel xml:lang="fr">Paralysie de muscles extraoculaires</skos:altLabel>
		<skos:altLabel xml:lang="fr">Paralysie du muscle oculaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">Paralysie musculaire d'un oeil</skos:altLabel>
		<skos:definition xml:lang="en">Paralysis of one or more of the ocular muscles due to disorders of the eye muscles, neuromuscular junction, supporting soft tissue, tendons, or innervation to the muscles. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1290846"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0029132"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0027763"/>
		<OntoAD:manifestation_of rdf:resource="&OntoAD;C0349464"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1456784">
		<skos:prefLabel xml:lang="en">Paranoia</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Paranoia</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Troubles paranoïaques</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">TroublesParanoïaques</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Paranoid Disorders</skos:altLabel>
		<skos:altLabel xml:lang="en">Psychoses, Paranoid</skos:altLabel>
		<skos:altLabel xml:lang="en">Paranoia (Psychosis)</skos:altLabel>
		<skos:altLabel xml:lang="en">Psychotic Paranoia</skos:altLabel>
		<skos:altLabel xml:lang="en">Paranoid disorder</skos:altLabel>
		<skos:altLabel xml:lang="en">Paranoid psychosis</skos:altLabel>
		<skos:altLabel xml:lang="en">PARANOID DIS</skos:altLabel>
		<skos:altLabel xml:lang="fr">PSYCHOSE PARANOIAQUE</skos:altLabel>
		<skos:altLabel xml:lang="fr">Paranoïa</skos:altLabel>
		<skos:altLabel xml:lang="fr">Psychoses paranoïdes</skos:altLabel>
		<skos:altLabel xml:lang="fr">Troubles paranoïdes</skos:altLabel>
		<skos:altLabel xml:lang="fr">Psychose paranoïde</skos:altLabel>
		<skos:altLabel xml:lang="fr">trouble paranoïaque</skos:altLabel>
		<skos:definition xml:lang="en">Chronic mental disorders in which there has been an insidious development of a permanent and unshakeable delusional system (persecutory delusions or delusions of jealousy), accompanied by preservation of clear and orderly thinking. Emotional responses and behavior are consistent with the delusional state. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0011251"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0524899">
		<skos:prefLabel xml:lang="en">Penetrance</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Penetrance</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Pénétrance</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Pénétrance</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Genetic Penetrance</skos:altLabel>
		<skos:definition xml:lang="en">The percent frequency with which a dominant or homozygous recessive gene or gene combination manifests itself in the phenotype of the carriers. (From Glossary of Genetics, 5th ed) (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">La fréquence avec laquelle un gène dominant ou récessif homozygote ou une combinaison de gènes est exprimée avec le phénotype correspondant chez les porteurs. La pénétrance est la probabilité qu’un individu présente le phénotype pathologique sachant qu’il a le génotype à risque. La pénétrance est dite complète si cette probabilité est égale à 1 et incomplète si elle est inférieure à 1. La pénétrance incomplète peut alors expliquer des anomalies de transmission ou de distribution dans des maladie (source : MSHFRE)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0031437"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0073379">
		<skos:prefLabel xml:lang="en">Riluzole</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Riluzole</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Riluzole</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Riluzole</skos:hiddenLabel>
		<skos:definition xml:lang="en">A glutamate antagonist (RECEPTORS, GLUTAMATE) used as an anticonvulsant (ANTICONVULSANTS) and to prolong the survival of patients with AMYOTROPHIC LATERAL SCLEROSIS. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003286"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0242910"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0242912"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2091312"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0002736"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0020517"/>
	</owl:Class>

