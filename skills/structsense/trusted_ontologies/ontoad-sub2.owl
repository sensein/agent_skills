		<skos:altLabel xml:lang="fr">Photothérapies</skos:altLabel>
		<skos:altLabel xml:lang="fr">Traitement par la lumière</skos:altLabel>
		<skos:altLabel xml:lang="fr">Traitement à la lumière</skos:altLabel>
