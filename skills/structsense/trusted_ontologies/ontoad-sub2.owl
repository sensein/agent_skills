	<owl:Class rdf:about="&OntoAD;C0078058">
		<skos:prefLabel xml:lang="en">Vascular Endothelial Growth Factor A</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">VascularEndothelialGrowthFactorA</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Facteur de croissance endothéliale vasculaire de type A</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">FacteurDeCroissanceEndothélialeVasculaireDeTypeA</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Vascular Permeability Factor</skos:altLabel>
		<skos:altLabel xml:lang="en">Vasculotropin</skos:altLabel>
		<skos:altLabel xml:lang="en">Vascular Endothelial Growth Factor</skos:altLabel>
		<skos:altLabel xml:lang="en">VPF</skos:altLabel>
		<skos:altLabel xml:lang="en">VEGF-A</skos:altLabel>
		<skos:altLabel xml:lang="en">VEGF</skos:altLabel>
		<skos:altLabel xml:lang="en">VEGF148</skos:altLabel>
		<skos:altLabel xml:lang="en">vascular endothelial growth factor A (VEGF-A)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteur de croissance endothéliale vasculaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteur de croissance de l'endothélium vasculaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteur de croissance endothéliale vasculaire A</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteur de perméabilité vasculaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">VEGF</skos:altLabel>
		<skos:altLabel xml:lang="fr">VEGF-A</skos:altLabel>
		<skos:altLabel xml:lang="fr">Vasculotropine</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteur de croissance de l'endothélium vasculaire A</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteur de croissance de l'endothélium vasculaire de type A</skos:altLabel>
		<skos:definition xml:lang="en">The original member of the family of endothelial cell growth factors referred to as VASCULAR ENDOTHELIAL GROWTH FACTORS. Vascular endothelial growth factor-A was originally isolated from tumor cells and referred to as 'tumor angiogenesis factor' and 'vascular permeability factor'. Although expressed at high levels in certain tumor-derived cells it is produced by a wide variety of cell types. In addition to stimulating vascular growth and vascular permeability it may play a role in stimulating VA (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1332296"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1823619"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C1335962"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C0017362"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1171892">
		<skos:prefLabel xml:lang="en">VEGF protein, human</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">VEGFProtein,Human</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">vascular permeability factor</skos:altLabel>
		<skos:altLabel xml:lang="en">Vasculotropin</skos:altLabel>
		<skos:altLabel xml:lang="en">Vascular endothelial growth factor</skos:altLabel>
		<skos:altLabel xml:lang="en">HBGF</skos:altLabel>
		<skos:altLabel xml:lang="en">VPF</skos:altLabel>
		<skos:altLabel xml:lang="en">vascular endothelial growth factor-A, human</skos:altLabel>
		<skos:altLabel xml:lang="en">vascular endothelial growth factor, human</skos:altLabel>
		<skos:altLabel xml:lang="en">VEGFA protein, human</skos:altLabel>
		<skos:altLabel xml:lang="en">VEGF</skos:altLabel>
		<skos:altLabel xml:lang="en">VEGF-A protein, human</skos:altLabel>
		<skos:definition xml:lang="en">heparin binding growth factor that regulates endothelial cell proliferation; also acts as an angiogenic factor. (source : CSP)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0018284"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1522575">
		<skos:prefLabel xml:lang="en">Recombinant Vascular Endothelial Growth Factor</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">RecombinantVascularEndothelialGrowthFactor</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Vascular Permeability Factor</skos:altLabel>
		<skos:altLabel xml:lang="en">Vascular Endothelial Growth Factor</skos:altLabel>
		<skos:altLabel xml:lang="en">VPF</skos:altLabel>
		<skos:altLabel xml:lang="en">VEGF</skos:altLabel>
		<skos:altLabel xml:lang="en">rhuVEGF</skos:altLabel>
		<skos:definition xml:lang="en">A recombinant therapeutic agent which is chemically identical to or similar to endogenous vascular endothelial growth factor (VEGF). Produced by a wide variety of cell types, endogenous VEGF is a homodimeric, glycosylated protein that is a highly specific mitogen for vascular endothelial cells; significantly influences vascular permeability; appears to play a role in neovascularisation under physiological conditions; is a potent chemoattractant; has pro-coagulatory activities; and is hypoxia-ind (source : )</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1515387"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0031253">
		<skos:prefLabel xml:lang="en">Pesticides</skos:prefLabel>
