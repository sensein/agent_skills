	<owl:Class rdf:about="&OntoAD;C0001046">
		<skos:prefLabel xml:lang="en">Acetylcholinesterase Inhibitors</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AcetylcholinesteraseInhibitors</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Inhibiteurs de l'acétylcholinesterase</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">InhibiteursDeL'acétylcholinesterase</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">ACETYLCHOLINESTERASE INHIB</skos:altLabel>
		<skos:altLabel xml:lang="en">AcCholE Inhibitor</skos:altLabel>
		<skos:altLabel xml:lang="en">Acetylcholine Hydrolase Inhibitor</skos:altLabel>
		<skos:altLabel xml:lang="fr">inhibiteurs de l' acétylcholinestérase</skos:altLabel>
		<skos:altLabel xml:lang="fr">Inhibiteurs de l’acetylcholinesterase</skos:altLabel>
		<skos:altLabel xml:lang="fr">inhibiteurs de l'acéthylcholinestérase</skos:altLabel>
		<skos:definition xml:lang="en">Any agent that inhibits the enzymatic activity or the synthesis of acetylcholinesterase. Inhibition of acetylcholinesterase prevents breakdown of the neurotransmitter acetylcholine (Ach). (source : NCI)</skos:definition>
		<skos:definition xml:lang="fr"> Substance qui s'oppose à la destruction de l'acétylcholine par une enzyme, la cholinestérase. En augmentant le taux d'acétylcholine, un anticholinestérasique (à faibles doses) a des effets comparables à ceux de l'acétylcholine, mais plus durables. Des médicaments anticholinestérasiques sont utilisés dans le traitement de la myasthénieou en cas d'atonie intestinale grave. L'emploi d'anticholinestérasique dans la maladie d'Alzheimer est récent et repose sur l'hypothèse d'un déficit en acétylcholi (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0919438"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0002625">
		<skos:prefLabel xml:lang="en">Amnestic Disorder</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AmnesticDisorder</skos:hiddenLabel>
