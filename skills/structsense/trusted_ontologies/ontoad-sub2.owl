		<skos:prefLabel xml:lang="fr">Anxiété</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Anxiété</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Anxiety reaction</skos:altLabel>
		<skos:altLabel xml:lang="en">Anxious</skos:altLabel>
		<skos:altLabel xml:lang="en">Anxiousness</skos:altLabel>
		<skos:altLabel xml:lang="en">angst</skos:altLabel>
		<skos:altLabel xml:lang="en">Feeling anxious</skos:altLabel>
		<skos:altLabel xml:lang="en">unfocused anxiety</skos:altLabel>
		<skos:altLabel xml:lang="en">anxious; sensation</skos:altLabel>
		<skos:altLabel xml:lang="en">rndx anxiety</skos:altLabel>
		<skos:altLabel xml:lang="fr">angoisse</skos:altLabel>
		<skos:altLabel xml:lang="fr">REACTION D'ANXIETE</skos:altLabel>
		<skos:altLabel xml:lang="fr">Sentiment d'angoissee</skos:altLabel>
		<skos:altLabel xml:lang="fr">humeur anxieuse</skos:altLabel>
		<skos:altLabel xml:lang="fr">anxieux</skos:altLabel>
		<skos:definition xml:lang="en">Feeling or emotion of dread, apprehension, and impending disaster but not disabling as with ANXIETY DISORDERS. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Sentiment persistant de crainte, appréhension et désastre imminent. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1306597"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0684322"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0237088"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0036594"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0001721"/>
