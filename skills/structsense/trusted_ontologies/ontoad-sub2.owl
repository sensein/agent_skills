	<owl:Class rdf:about="&OntoAD;C0020971">
		<skos:prefLabel xml:lang="en">Immunization</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Immunization</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Immunisation</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Immunisation</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Sensitization, Immunologic</skos:altLabel>
		<skos:altLabel xml:lang="en">Immunologic Stimulation</skos:altLabel>
		<skos:altLabel xml:lang="en">Immunostimulation</skos:altLabel>
		<skos:altLabel xml:lang="en">Immunization procedure</skos:altLabel>
		<skos:altLabel xml:lang="en">Immunoprophylaxis</skos:altLabel>
		<skos:altLabel xml:lang="en">Immunological Stimulation</skos:altLabel>
		<skos:altLabel xml:lang="en">Sensitization, Immunological</skos:altLabel>
		<skos:altLabel xml:lang="en">Administration of substance to produce immunity, either active or passive</skos:altLabel>
		<skos:altLabel xml:lang="en">Immunisation</skos:altLabel>
		<skos:altLabel xml:lang="en">Inoculations  prophylacyic</skos:altLabel>
		<skos:altLabel xml:lang="en">IMMUNOL SENSITIZATION</skos:altLabel>
		<skos:altLabel xml:lang="en">IMMUNOL STIMULATION</skos:altLabel>
		<skos:altLabel xml:lang="fr">Immunisations</skos:altLabel>
		<skos:altLabel xml:lang="fr">Stimulation immunologique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Sensibilisation immunologique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Immunostimulation</skos:altLabel>
		<skos:altLabel xml:lang="fr">inoculation</skos:altLabel>
		<skos:definition xml:lang="en">Deliberate stimulation of the host's immune response. ACTIVE IMMUNIZATION involves administration of ANTIGENS or IMMUNOLOGIC ADJUVANTS. PASSIVE IMMUNIZATION involves administration of IMMUNE SERA or LYMPHOCYTES or their extracts (e.g., transfer factor, immune RNA) or transplantation of immunocompetent cell producing tissue (thymus or bone marrow). (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0150270"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0033144"/>
		<OntoAD:has_direct_substance rdf:resource="&OntoAD;C1630493"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0042196">
		<skos:prefLabel xml:lang="en">Vaccination</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Vaccination</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Vaccination</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Vaccination</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">active immunization</skos:altLabel>
		<skos:altLabel xml:lang="en">VACCIN</skos:altLabel>
		<skos:altLabel xml:lang="en">Inoculation</skos:altLabel>
		<skos:altLabel xml:lang="en">Inoculations  prophylactic</skos:altLabel>
		<skos:altLabel xml:lang="en">Prophylactic vaccination</skos:altLabel>
		<skos:altLabel xml:lang="en">vaccinations</skos:altLabel>
		<skos:altLabel xml:lang="fr">Vaccination prophylactique</skos:altLabel>
		<skos:altLabel xml:lang="fr">inoculation</skos:altLabel>
		<skos:definition xml:lang="en">Administration of vaccines to stimulate the host's immune response. This includes any preparation intended for active immunological prophylaxis. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0042210"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0205991"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0041980">
		<skos:prefLabel xml:lang="en">Uric Acid</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">UricAcid</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Acide urique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AcideUrique</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Trioxopurine</skos:altLabel>
		<skos:altLabel xml:lang="en">UA  Uric acid</skos:altLabel>
		<skos:altLabel xml:lang="en">Uricum acidum / uric acid</skos:altLabel>
		<skos:altLabel xml:lang="fr">Urique, acide</skos:altLabel>
		<skos:definition xml:lang="en">An oxidation product, via XANTHINE OXIDASE, of oxypurines such as XANTHINE and HYPOXANTHINE. It is the final oxidation product of purine catabolism in humans and primates, whereas in most other mammals URATE OXIDASE further oxidizes it to ALLANTOIN. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr"> Déchet du métabolisme, normalement éliminé par les reins. Son accumulation peut provoquer une crise de goutte. L'acide urique peut également former des calculs dans les voies urinaires. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003402"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0574031"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0043315"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0202239">
		<skos:prefLabel xml:lang="en">Uric acid measurement (procedure)</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">UricAcidMeasurement(procedure)</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Acide urique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AcideUrique</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Uric acid measurement</skos:altLabel>
		<skos:altLabel xml:lang="en">URATE</skos:altLabel>
