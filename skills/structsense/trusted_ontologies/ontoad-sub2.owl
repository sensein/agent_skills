	<owl:Class rdf:about="&OntoAD;C0085084">
		<skos:prefLabel xml:lang="en">Motor Neuron Disease</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">MotorNeuronDisease</skos:hiddenLabel>
