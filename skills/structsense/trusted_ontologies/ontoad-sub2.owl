		<skos:altLabel xml:lang="fr">Alpha 1-GPA</skos:altLabel>
		<skos:altLabel xml:lang="fr">alpha1-Glycoprotéine acide</skos:altLabel>
		<skos:altLabel xml:lang="fr">alpha-1-Glycoprotéine acide</skos:altLabel>
		<skos:altLabel xml:lang="fr">Glycoprotéine acide alpha-1</skos:altLabel>
		<skos:altLabel xml:lang="fr">Glycoprotéine acide alpha1</skos:altLabel>
		<skos:altLabel xml:lang="fr">Séromucoïde acide</skos:altLabel>
		<skos:altLabel xml:lang="fr">Séromucoïde alpha-1</skos:altLabel>
		<skos:altLabel xml:lang="fr">AGP</skos:altLabel>
		<skos:altLabel xml:lang="fr">alpha1 glycoprotéine</skos:altLabel>
		<skos:altLabel xml:lang="fr">alpha1 séromucoïde</skos:altLabel>
		<skos:definition xml:lang="en">family of plasma proteins with oligosaccharide side chains or glycoproteins believed to be associated with inflammation. (source : CSP)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0001347"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0017968"/>
