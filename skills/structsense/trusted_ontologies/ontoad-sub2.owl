	<owl:Class rdf:about="&OntoAD;C0028622">
		<skos:prefLabel xml:lang="en">Nucleic Acids, Nucleotides, and Nucleosides</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">NucleicAcids,Nucleotides,AndNucleosides</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Nucléosides et nucléotides</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">NucléosidesEtNucléotides</skos:hiddenLabel>
		<skos:definition xml:lang="en">Complex compounds of high molecular weight occurring in living cells. These are basically of two types, ribonucleic (RNA) and deoxyribonucleic (DNA) acids, both of which consist of nucleotides (nucleoside phosphates linked together by phosphate bridges). (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0029224"/>
	</owl:Class>

