		<skos:altLabel xml:lang="en">PEPTIDASE INHIB</skos:altLabel>
		<skos:altLabel xml:lang="en">ENDOPEPTIDASE INHIB</skos:altLabel>
		<skos:altLabel xml:lang="en">protease inhibitors</skos:altLabel>
		<skos:altLabel xml:lang="fr">Antiprotéases</skos:altLabel>
		<skos:altLabel xml:lang="fr">Anti-protéinases</skos:altLabel>
		<skos:altLabel xml:lang="fr">Inhibiteurs de la protéase</skos:altLabel>
		<skos:altLabel xml:lang="fr">Antiprotéinases</skos:altLabel>
		<skos:altLabel xml:lang="fr">Anti-protéases</skos:altLabel>
		<skos:altLabel xml:lang="fr">Inhibiteurs de protéinases</skos:altLabel>
		<skos:altLabel xml:lang="fr">Inhibiteurs de peptidases</skos:altLabel>
		<skos:altLabel xml:lang="fr">Inhibiteurs d'endopeptidases</skos:altLabel>
		<skos:definition xml:lang="en">Compounds which inhibit or antagonize biosynthesis or actions of proteases (ENDOPEPTIDASES). (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0014432"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0919438"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003451"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0017968">
		<skos:prefLabel xml:lang="en">Glycoproteins</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Glycoproteins</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Glycoprotéines</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Glycoprotéines</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Glycoprotein</skos:altLabel>
		<skos:altLabel xml:lang="fr">glycoprotéine</skos:altLabel>
		<skos:definition xml:lang="en">Conjugated protein-carbohydrate compounds including mucins, mucoid, and amyloid glycoproteins. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0175168"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0007427">
		<skos:prefLabel xml:lang="en">CATHEPSIN D</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CATHEPSIND</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Cathepsine D</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">CathepsineD</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">EC 3.4.23.5</skos:altLabel>
		<skos:altLabel xml:lang="en">Cathepsin D (Lysosomal Aspartyl Protease)</skos:altLabel>
		<skos:altLabel xml:lang="en">CTSD</skos:altLabel>
		<skos:definition xml:lang="en">An intracellular proteinase found in a variety of tissue. It has specificity similar to but narrower than that of pepsin A. The enzyme is involved in catabolism of cartilage and connective tissue. EC 3.4.23.5. (Formerly EC 3.4.4.23). (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0007428"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0078989"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0014442"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C2717969"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1333402"/>
		<OntoAD:gene_product_has_organism_source rdf:resource="&OntoAD;C0086418"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1334064"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1335528"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0105770">
		<skos:prefLabel xml:lang="en">beta catenin</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">BetaCatenin</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">bêta-Caténine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Bêta-Caténine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Cadherin-Associated Protein, Beta 1 (88kD)</skos:altLabel>
		<skos:altLabel xml:lang="en">Catenin, Beta-1</skos:altLabel>
		<skos:altLabel xml:lang="en">Cadherin-Associated Protein, Beta</skos:altLabel>
		<skos:altLabel xml:lang="en">CTNNB1</skos:altLabel>
		<skos:altLabel xml:lang="en">PRO2286</skos:altLabel>
		<skos:altLabel xml:lang="fr">b-Caténine</skos:altLabel>
		<skos:altLabel xml:lang="fr">Caténine-bêta</skos:altLabel>
		<skos:definition xml:lang="en">A multi-functional catenin that participates in CELL ADHESION and nuclear signaling. Beta catenin binds CADHERINS and helps link their cytoplasmic tails to the ACTIN in the CYTOSKELETON via ALPHA CATENIN. It also serves as a transcriptional co-activator and downstream component of WNT PROTEIN-mediated SIGNAL TRANSDUCTION PATHWAYS. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1335962"/>
		<OntoAD:gene_product_plays_role_in_biological_process rdf:resource="&OntoAD;C0037083"/>
		<OntoAD:gene_product_has_organism_source rdf:resource="&OntoAD;C0086418"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C0935996"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0021745">
		<skos:prefLabel xml:lang="en">Interferon Type II</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">InterferonTypeII</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Interféron-gamma</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Interféron-gamma</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Interferon-gamma</skos:altLabel>
		<skos:altLabel xml:lang="en">Interferon, Immune</skos:altLabel>
		<skos:altLabel xml:lang="en">Interferon gamma (human lymphocyte protein moiety reduced)</skos:altLabel>
		<skos:altLabel xml:lang="en">IFNG</skos:altLabel>
		<skos:altLabel xml:lang="en">Interferon gamma</skos:altLabel>
		<skos:altLabel xml:lang="en">Gamma interferon</skos:altLabel>
		<skos:altLabel xml:lang="en">IFN-g</skos:altLabel>
		<skos:altLabel xml:lang="en">lFN-Gamma</skos:altLabel>
		<skos:altLabel xml:lang="fr">Interféron gamma</skos:altLabel>
		<skos:altLabel xml:lang="fr">Interféron de type II</skos:altLabel>
		<skos:altLabel xml:lang="fr">IFN-gamma</skos:altLabel>
		<skos:altLabel xml:lang="fr">Interféron immun</skos:altLabel>
		<skos:altLabel xml:lang="fr">Interféron-g</skos:altLabel>
		<skos:altLabel xml:lang="fr">Interféron de type 2</skos:altLabel>
		<skos:definition xml:lang="en">The major interferon produced by mitogenically or antigenically stimulated LYMPHOCYTES. It is structurally different from TYPE I INTERFERON and its major activity is immunoregulation. It has been implicated in the expression of CLASS II HISTOCOMPATIBILITY ANTIGENS in cells that do not normally produce them, leading to AUTOIMMUNE DISEASES. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0733470"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0021747"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0301340"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0079189"/>
		<OntoAD:gene_product_is_biomarker_type rdf:resource="&OntoAD;C1511983"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1333196"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0022917">
		<skos:prefLabel xml:lang="en">Lactate Dehydrogenase</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">LactateDehydrogenase</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">L-Lactate dehydrogenase</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">L-LactateDehydrogenase</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">LDH</skos:altLabel>
		<skos:altLabel xml:lang="en">Lactic acid dehydrogenase</skos:altLabel>
		<skos:altLabel xml:lang="en">L-Lactate Dehydrogenase</skos:altLabel>
		<skos:altLabel xml:lang="en">LD  Lactate dehydrogenase</skos:altLabel>
		<skos:altLabel xml:lang="en">LDH  Lactate dehydrogenase</skos:altLabel>
		<skos:altLabel xml:lang="en">L-Lactic Acid Dehydrogenase</skos:altLabel>
		<skos:altLabel xml:lang="en">NAD-Lactate Dehydrogenase</skos:altLabel>
		<skos:altLabel xml:lang="en">EC 1.1.1.27</skos:altLabel>
		<skos:altLabel xml:lang="fr">L-Lactate déshydrogénase</skos:altLabel>
		<skos:altLabel xml:lang="fr">Lactate déshydrogénase</skos:altLabel>
		<skos:altLabel xml:lang="fr">acide lactique déshydrogénase</skos:altLabel>
		<skos:definition xml:lang="en">A tetrameric enzyme that, along with the coenzyme NAD+, catalyzes the interconversion of LACTATE and PYRUVATE. In vertebrates, genes for three different subunits (LDH-A, LDH-B and LDH-C) exist. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0030016"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1333402"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1335186"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0005210">
		<skos:prefLabel xml:lang="en">beta-Endorphin</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Beta-Endorphin</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">bêta-Endorphine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Bêta-Endorphine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">beta-Endorphin (1-31)</skos:altLabel>
		<skos:altLabel xml:lang="en">B endorphin</skos:altLabel>
		<skos:altLabel xml:lang="en">beta Endorphin</skos:altLabel>
		<skos:altLabel xml:lang="fr">Endorphine beta</skos:altLabel>
		<skos:altLabel xml:lang="fr">Endorphine-beta</skos:altLabel>
		<skos:altLabel xml:lang="fr">beta Endorphine</skos:altLabel>
		<skos:altLabel xml:lang="fr">bêta-Endorphine (1-31)</skos:altLabel>
		<skos:definition xml:lang="en">A 31-amino acid peptide that is the C-terminal fragment of BETA-LIPOTROPIN. It acts on OPIOID RECEPTORS and is an analgesic. Its first four amino acids at the N-terminal are identical to the tetrapeptide sequence of METHIONINE ENKEPHALIN and LEUCINE ENKEPHALIN. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0014242"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0032923">
		<skos:prefLabel xml:lang="en">Prealbumin</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Prealbumin</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Préalbumine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Préalbumine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Proalbumin</skos:altLabel>
		<skos:altLabel xml:lang="en">Transthyretin</skos:altLabel>
		<skos:altLabel xml:lang="en">ATTR</skos:altLabel>
		<skos:altLabel xml:lang="en">TTR</skos:altLabel>
		<skos:altLabel xml:lang="en">TBPA</skos:altLabel>
		<skos:altLabel xml:lang="fr">Proalbumine</skos:altLabel>
		<skos:altLabel xml:lang="fr">Transthyrétine</skos:altLabel>
		<skos:definition xml:lang="en">A tetrameric protein, molecular weight between 50,000 and 70,000, consisting of 4 equal chains, and migrating on electrophoresis in 3 fractions more mobile than serum albumin. Its concentration ranges from 7 to 33 per cent in the serum, but levels decrease in liver disease. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0007292"/>
		<OntoAD:gene_product_malfunction_associated_with_disease rdf:resource="&OntoAD;C0002726"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1334396"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1336818"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0165073">
		<skos:prefLabel xml:lang="en">Synucleins</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Synucleins</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Synucléines</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Synucléines</skos:hiddenLabel>
		<skos:altLabel xml:lang="fr">synucléine</skos:altLabel>
		<skos:definition xml:lang="en">A family of homologous proteins of low MOLECULAR WEIGHT that are predominately expressed in the BRAIN and that have been implicated in a variety of human diseases. They were originally isolated from CHOLINERGIC FIBERS of TORPEDO. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;AminoAcid,Peptide,OrProtein"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;BiologicallyActiveSubstance"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0021669">
		<skos:prefLabel xml:lang="en">Insulinase</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Insulinase</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Insulinase</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Insulinase</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Insulin Proteinase</skos:altLabel>
		<skos:altLabel xml:lang="en">Insulin-Degrading Enzyme</skos:altLabel>
		<skos:altLabel xml:lang="en">Insulin Protease</skos:altLabel>
		<skos:altLabel xml:lang="en">Insulysin</skos:altLabel>
		<skos:definition xml:lang="en">An enzyme the catalyzes the degradation of insulin, glucagon and other polypeptides. It is inhibited by bacitracin, chelating agents EDTA and 1,10-phenanthroline, and by thiol-blocking reagents such as N-ethylmaleimide, but not phosphoramidon. (Eur J Biochem 1994;223:1-5) EC 3.4.24.56. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0020289"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0025252">
		<skos:prefLabel xml:lang="en">Membrane Proteins</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">MembraneProteins</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Protéines membranaires</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ProtéinesMembranaires</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Membrane-Associated Proteins</skos:altLabel>
		<skos:altLabel xml:lang="en">Surface Proteins</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéines de surface</skos:altLabel>
		<skos:definition xml:lang="en">Proteins which are found in membranes including cellular and intracellular membranes. They consist of two types, peripheral and integral proteins. They include most membrane-associated enzymes, antigenic proteins, transport proteins, and drug, hormone, and lectin receptors. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1367806"/>
		<OntoAD:gene_product_has_associated_anatomy rdf:resource="&OntoAD;C0007603"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0017822">
		<skos:prefLabel xml:lang="en">GLUTATHIONE PEROXIDASE</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">GLUTATHIONEPEROXIDASE</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Glutathione peroxidase</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">GlutathionePeroxidase</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Glutathione:hydrogen-peroxide oxidoreductase</skos:altLabel>
		<skos:altLabel xml:lang="en">GPX1  Glutathione peroxidase</skos:altLabel>
		<skos:altLabel xml:lang="fr">Glutathion peroxidase</skos:altLabel>
		<skos:altLabel xml:lang="fr">glutathion peroxydase</skos:altLabel>
		<skos:definition xml:lang="en">An enzyme catalyzing the oxidation of 2 moles of glutathione in the presence of hydrogen peroxide to yield oxidized glutathione and water. EC 1.11.1.9. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0031179"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0009325">
		<skos:prefLabel xml:lang="en">Collagen</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Collagen</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Collagène</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Collagène</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Collagen hemostatic</skos:altLabel>
		<skos:altLabel xml:lang="en">Collagen product</skos:altLabel>
		<skos:definition xml:lang="en">A polypeptide substance comprising about one third of the total protein in mammalian organisms. It is the main constituent of SKIN; CONNECTIVE TISSUE; and the organic substance of bones (BONE AND BONES) and teeth (TOOTH). (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0036425"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0019120"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0079323"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C0017366"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1333497"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0582263"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1706373">
		<skos:prefLabel xml:lang="en">Adenosinetriphosphatase</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Adenosinetriphosphatase</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Adenosinetriphosphatase</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Adenosinetriphosphatase</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">ATPase</skos:altLabel>
		<skos:altLabel xml:lang="en">Adenosine Triphosphatase</skos:altLabel>
		<skos:altLabel xml:lang="fr">ATPase</skos:altLabel>
		<skos:altLabel xml:lang="fr">Adénosine triphosphatase</skos:altLabel>
		<rdfs:subClassOf rdf:resource="&OntoAD;AminoAcid,Peptide,OrProtein"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;Enzyme"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0040679">
		<skos:prefLabel xml:lang="en">Transferrin</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Transferrin</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Transferrine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Transferrine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Iron binding protein</skos:altLabel>
		<skos:altLabel xml:lang="en">Serotransferrin</skos:altLabel>
		<skos:altLabel xml:lang="en">Siderophilin</skos:altLabel>
		<skos:altLabel xml:lang="en">Granulocyte/Pollen-Binding Protein</skos:altLabel>
		<skos:altLabel xml:lang="en">beta-1 Metal-Binding Globulin</skos:altLabel>
		<skos:altLabel xml:lang="fr">Sidérophiline</skos:altLabel>
		<skos:altLabel xml:lang="fr">protéine fixant le fer</skos:altLabel>
		<skos:definition xml:lang="en">An iron-binding beta1-globulin that is synthesized in the LIVER and secreted into the blood. It plays a central role in the transport of IRON throughout the circulation. A variety of transferrin isoforms exist in humans, including some that are considered markers for specific disease states. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0001347"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0007292"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0018928"/>
		<OntoAD:gene_product_has_organism_source rdf:resource="&OntoAD;C0086418"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1334396"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0036825"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1336818"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0033681">
		<skos:prefLabel xml:lang="en">Protein Tyrosine Kinase</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">ProteinTyrosineKinase</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Protein-tyrosine kinases</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Protein-tyrosineKinases</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Tyrosine Kinase</skos:altLabel>
		<skos:altLabel xml:lang="en">Tyrosine-Specific Protein Kinase</skos:altLabel>
		<skos:altLabel xml:lang="en">Tyrosylprotein Kinase</skos:altLabel>
		<skos:altLabel xml:lang="en">ATP:protein-tyrosine O-phosphotransferase</skos:altLabel>
		<skos:altLabel xml:lang="en">Hydroxyaryl-protein kinase</skos:altLabel>
		<skos:altLabel xml:lang="en">PTK</skos:altLabel>
		<skos:altLabel xml:lang="en">Protein-tyrosine kinase</skos:altLabel>
		<skos:altLabel xml:lang="en">EC 2.7.1.112</skos:altLabel>
		<skos:altLabel xml:lang="en">tyrosyl protein kinase</skos:altLabel>
		<skos:altLabel xml:lang="en">Protein-Tyrosine Kinases</skos:altLabel>
		<skos:altLabel xml:lang="fr">Hydroxyaryl-protéine kinase</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protein-tyrosine kinase</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine kinase(tyrosine)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tyrosylprotéine kinase</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéines tyrosine-kinase</skos:altLabel>
		<skos:altLabel xml:lang="fr">PTK (Protéines Tyrosine Kinase)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine-tyrosine kinases</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéines à activité tyrosine kinase</skos:altLabel>
		<skos:altLabel xml:lang="fr">protéine-tyrosine kinase</skos:altLabel>
		<skos:altLabel xml:lang="fr">protéine kinase (tyrosine)</skos:altLabel>
		<skos:definition xml:lang="en">Protein kinases that catalyze the PHOSPHORYLATION of TYROSINE residues in proteins with ATP or other nucleotides as phosphate donors. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0033640"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0014442"/>
		<OntoAD:gene_product_plays_role_in_biological_process rdf:resource="&OntoAD;C0037083"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1333402"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1336799"/>
		<OntoAD:gene_product_plays_role_in_biological_process rdf:resource="&OntoAD;C0007589"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0010749">
		<skos:prefLabel xml:lang="en">Cytochromes c</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CytochromesC</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Cytochromes c</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">CytochromesC</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Ferricytochrome c</skos:altLabel>
		<skos:altLabel xml:lang="en">Ferrocytochrome c</skos:altLabel>
		<skos:altLabel xml:lang="fr">Ferricytochromes c</skos:altLabel>
		<skos:altLabel xml:lang="fr">Ferrocytochromes c</skos:altLabel>
		<skos:definition xml:lang="en">Cytochromes of the c type that are found in eukaryotic MITOCHONDRIA. They serve as redox intermediates that accept electrons from MITOCHONDRIAL ELECTRON TRANSPORT COMPLEX III and transfer them to MITOCHONDRIAL ELECTRON TRANSPORT COMPLEX IV. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0010798"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0038585">
		<skos:prefLabel xml:lang="en">Substance P</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">SubstanceP</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Substance P</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">SubstanceP</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Euler-Gaddum Substance P</skos:altLabel>
		<skos:altLabel xml:lang="en">SP(1-11)</skos:altLabel>
		<skos:altLabel xml:lang="en">SP  Substance P</skos:altLabel>
		<skos:altLabel xml:lang="en">neurokinin 1</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteur P</skos:altLabel>
		<skos:altLabel xml:lang="fr">SP(1-11)</skos:altLabel>
		<skos:definition xml:lang="en">An eleven-amino acid neurotransmitter that appears in both the central and peripheral nervous systems. It is involved in transmission of PAIN, causes rapid contractions of the gastrointestinal smooth muscle, and modulates inflammatory and immune responses. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0017182"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0582246"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0027895"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1254352"/>
		<OntoAD:gene_product_plays_role_in_biological_process rdf:resource="&OntoAD;C0027793"/>
	</owl:Class>

