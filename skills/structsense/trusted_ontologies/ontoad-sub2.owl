	<owl:Class rdf:about="&OntoAD;C0175202">
		<skos:prefLabel xml:lang="en">Hippocampal Formation</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">HippocampalFormation</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Formation hippocampique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">FormationHippocampique</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">hippocampus (Crosby)</skos:altLabel>
		<skos:altLabel xml:lang="en">Formatio hippocampi</skos:altLabel>
		<skos:altLabel xml:lang="en">Structure of hippocampal formation</skos:altLabel>
		<skos:definition xml:lang="fr">Relief formé par la circonvolution de la substance grise s'étendant le long du plancher de la corne temporale du ventricule cérébral. L'hippocampe, le subiculum, et le gyrus denté constituent la formation hippocampique. Il arrive que des auteurs incluent le cortex entothinal dans la formation hippocampique. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0598598"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0178324">
		<skos:prefLabel xml:lang="en">Vascular System Injuries</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">VascularSystemInjuries</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Lésions du système vasculaire</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">LésionsDuSystèmeVasculaire</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">vascular lesions</skos:altLabel>
		<skos:altLabel xml:lang="en">Injury to blood vessels of site</skos:altLabel>
		<skos:altLabel xml:lang="en">Injury of blood vessel</skos:altLabel>
		<skos:altLabel xml:lang="en">Vascular Injuries</skos:altLabel>
		<skos:altLabel xml:lang="en">Inj bl vess unsp body reg</skos:altLabel>
		<skos:altLabel xml:lang="en">Injury of blood vessel(s) of body region</skos:altLabel>
		<skos:altLabel xml:lang="en">D-40 INJURIES OF THE BLOOD VESSELS</skos:altLabel>
		<skos:altLabel xml:lang="en">Vessel injury</skos:altLabel>
		<skos:altLabel xml:lang="fr">lésions vasculaires</skos:altLabel>
		<skos:altLabel xml:lang="fr">Vascular injury</skos:altLabel>
		<skos:altLabel xml:lang="fr">Lésion vasculaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">Lésion des vaisseaux sanguins d'un site</skos:altLabel>
		<skos:altLabel xml:lang="fr">lésion traumatique d'un vaisseau sanguin</skos:altLabel>
		<skos:altLabel xml:lang="fr">Lésion traumatique de vaisseau(x) sanguin(s) d’une partie du corps non précisée</skos:altLabel>
		<skos:definition xml:lang="en">Injuries to blood vessels caused by laceration, contusion, puncture, or crush and other types of injuries. Symptoms vary by site and mode of injuries and may include bleeding, bruising, swelling, pain, and numbness. It does not include injuries secondary to pathologic function or diseases such as ATHEROSCLEROSIS. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0042373"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0560570"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0340666"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0037578"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0005847"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:has_associated_morphology rdf:resource="&OntoAD;C0221206"/>
	</owl:Class>

