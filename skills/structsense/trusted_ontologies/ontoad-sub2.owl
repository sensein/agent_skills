	<owl:Class rdf:about="&OntoAD;C0038394">
		<skos:prefLabel xml:lang="en">Streptococcaceae</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Streptococcaceae</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Streptococcaceae</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Streptococcaceae</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Family Streptococcaceae</skos:altLabel>
		<skos:altLabel xml:lang="en">Streptococcaceae Deibel and Seeley 1974</skos:altLabel>
		<skos:altLabel xml:lang="fr">Streptococcacés</skos:altLabel>
		<skos:definition xml:lang="en">A family of gram-positive non-sporing bacteria including many parasitic, pathogenic, and saprophytic forms. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C3245526"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0038402">
		<skos:prefLabel xml:lang="en">Streptococcus</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Streptococcus</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Streptococcus</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Streptococcus</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Streptococcal</skos:altLabel>
		<skos:altLabel xml:lang="en">Streptococci sp.</skos:altLabel>
		<skos:altLabel xml:lang="en">Streptococcus Rosenbach 1884</skos:altLabel>
		<skos:altLabel xml:lang="en">Genus Streptococcus</skos:altLabel>
		<skos:altLabel xml:lang="en">STREP</skos:altLabel>
		<skos:altLabel xml:lang="en">streptococcus bacteria</skos:altLabel>
		<skos:altLabel xml:lang="fr">Streptocoque</skos:altLabel>
		<skos:altLabel xml:lang="fr">Streptocoques</skos:altLabel>
		<skos:altLabel xml:lang="fr">streptococcique</skos:altLabel>
		<skos:definition xml:lang="en">A genus of gram-positive, coccoid bacteria whose organisms occur in pairs or chains. No endospores are produced. Many species exist as commensals or parasites on man or animals with some being highly pathogenic. A few species are saprophytes and occur in the natural environment. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0038394"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0579242">
		<skos:prefLabel xml:lang="en">Hemolytically variant streptococcus</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">HemolyticallyVariantStreptococcus</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Haemolyt variant streptococcus</skos:altLabel>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0038402"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0318154">
		<skos:prefLabel xml:lang="en">Beta-hemolytic streptococcus</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Beta-hemolyticStreptococcus</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">beta Streptococcus</skos:altLabel>
		<skos:altLabel xml:lang="en">STREP BETA HEMOLYTIC</skos:altLabel>
		<skos:altLabel xml:lang="fr">streptocoque bêta-hémolytique</skos:altLabel>
		<skos:definition xml:lang="en">A bacterium that is assigned to the genus Streptococcus that is able to facilitate the complete rupturing of red blood cells, thus producing wide, clear, zones around colonies on blood agar plates. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0579242"/>
	</owl:Class>

