	<owl:Class rdf:about="&OntoAD;C0002744">
		<skos:prefLabel xml:lang="en">Anabolic steroids</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AnabolicSteroids</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Anabolic</skos:altLabel>
		<skos:altLabel xml:lang="en">Anabolic steroid preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">Anabolic steroid</skos:altLabel>
		<skos:altLabel xml:lang="en">Anabolic-Androgenic Steroids</skos:altLabel>
		<skos:altLabel xml:lang="en">anabolics</skos:altLabel>
		<skos:altLabel xml:lang="en">anabolic steroid drug</skos:altLabel>
		<skos:altLabel xml:lang="fr">stéroïde anabolisant</skos:altLabel>
		<skos:altLabel xml:lang="fr">biosynthèse</skos:altLabel>
		<skos:altLabel xml:lang="fr">anabolique</skos:altLabel>
		<skos:definition xml:lang="en">a natural or synthetic steroid that promotes bone and muscle growth (source : CHV)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1289975"/>
		<OntoAD:adjectival_form_of rdf:resource="&OntoAD;C0220781"/>
