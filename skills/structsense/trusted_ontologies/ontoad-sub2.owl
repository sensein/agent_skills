		<skos:altLabel xml:lang="en">Early Cancer Detection</skos:altLabel>
		<skos:altLabel xml:lang="en">Neoplasm screening</skos:altLabel>
		<skos:altLabel xml:lang="fr">dépistage du cancer</skos:altLabel>
		<skos:definition xml:lang="en">Procedures performed on people to identify those who have NEOPLASMS or PRENEOPLASTIC CONDITIONS. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1710031"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0730227"/>
