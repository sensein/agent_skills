		<skos:hiddenLabel xml:lang="fr">PersonnesApparentées</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">relatives</skos:altLabel>
		<skos:altLabel xml:lang="en">relation</skos:altLabel>
		<skos:altLabel xml:lang="en">relationship</skos:altLabel>
		<skos:altLabel xml:lang="en">Relationships</skos:altLabel>
		<skos:altLabel xml:lang="en">Relative</skos:altLabel>
		<skos:altLabel xml:lang="fr">relation</skos:altLabel>
		<skos:altLabel xml:lang="fr">relations</skos:altLabel>
		<skos:altLabel xml:lang="fr">Personnes parentes</skos:altLabel>
		<skos:definition xml:lang="en">A person related by blood or marriage. (source : NCI)</skos:definition>
		<skos:definition xml:lang="fr">Groupe social constitué des parents ou des parents de substitution, et des enfants. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0086282"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0032105">
		<skos:prefLabel xml:lang="en">Plasma</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Plasma</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Plasma sanguin</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">PlasmaSanguin</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Blood Plasma</skos:altLabel>
		<skos:altLabel xml:lang="en">Portion of plasma</skos:altLabel>
		<skos:altLabel xml:lang="fr">plasma</skos:altLabel>
		<skos:definition xml:lang="en">The residual portion of BLOOD that is left after removal of BLOOD CELLS by CENTRIFUGATION without prior BLOOD COAGULATION. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">http://www.fnclcc.fr/fr/patients/dico/definition.php?id_definition=1274 (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0443120"/>
