		<skos:altLabel xml:lang="fr">déficit cognitif</skos:altLabel>
		<skos:altLabel xml:lang="fr">trouble cognitif</skos:altLabel>
		<skos:altLabel xml:lang="fr">déficits cognitifs</skos:altLabel>
