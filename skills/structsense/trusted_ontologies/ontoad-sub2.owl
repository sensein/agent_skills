		<OntoAD:is_mechanism_of_action_of_chemical_or_drug rdf:resource="&OntoAD;C0073096"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1279941">
		<skos:prefLabel xml:lang="en">Late stage</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">LateStage</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Late</skos:altLabel>
		<skos:altLabel xml:lang="en">Late (modifier)</skos:altLabel>
		<skos:altLabel xml:lang="en">late-stage cancer</skos:altLabel>
		<skos:altLabel xml:lang="fr">stade avancé</skos:altLabel>
		<skos:altLabel xml:lang="fr">phase pré-terminale</skos:altLabel>
		<skos:definition xml:lang="en">Cancer that has spread too extensively beyond its original site of growth to allow complete surgical removal. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;TemporalConcept"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0028738">
		<skos:prefLabel xml:lang="en">Nystagmus</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Nystagmus</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Nystagmus pathologique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">NystagmusPathologique</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Nystagmus, Pathologic</skos:altLabel>
		<skos:altLabel xml:lang="fr">NYSTAGMUS</skos:altLabel>
		<skos:definition xml:lang="en">Involuntary movements of the eye that are divided into two types, jerk and pendular. Jerk nystagmus has a slow phase in one direction followed by a corrective fast phase in the opposite direction, and is usually caused by central or peripheral vestibular dysfunction. Pendular nystagmus features oscillations that are of equal velocity in both directions and this condition is often associated with visual loss early in life. (Adams et al., Principles of Neurology, 6th ed, p272) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0235031"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2228439"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0339666"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:manifestation_of rdf:resource="&OntoAD;C0206307"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0085762"/>
	</owl:Class>

