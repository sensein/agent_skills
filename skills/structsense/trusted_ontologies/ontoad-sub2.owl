		<skos:altLabel xml:lang="en">Broca Area</skos:altLabel>
		<skos:altLabel xml:lang="en">Motor speech area</skos:altLabel>
		<skos:definition xml:lang="en">An area located in the left cerebral hemisphere that is highly involved in speech and language processes. (source : PSY)</skos:definition>
