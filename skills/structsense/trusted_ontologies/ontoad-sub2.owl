		<skos:altLabel xml:lang="en">Neuroendocrine neoplasm</skos:altLabel>
		<skos:altLabel xml:lang="en">Neuroendocrine tumor</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tumeur neuroendocrine</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tumeurs neuro-endocrines</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tumeurs neuro-endocriniennes</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tumeurs neuroendocriniennes</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tumeur neuroendocrinienne</skos:altLabel>
		<skos:definition xml:lang="en">Tumors whose cells possess secretory granules and originate from the neuroectoderm, i.e., the cells of the ectoblast or epiblast that program the neuroendocrine system. Common properties across most neuroendocrine tumors include ectopic hormone production (often via APUD CELLS), the presence of tumor-associated antigens, and isozyme composition. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0014132"/>
		<OntoAD:disease_has_normal_tissue_origin rdf:resource="&OntoAD;C0014609"/>
	</owl:Class>

