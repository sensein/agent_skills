	<owl:Class rdf:about="&OntoAD;C1705510">
		<skos:prefLabel xml:lang="en">FASTK wt Allele</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">FASTKWtAllele</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">FAST</skos:altLabel>
		<skos:altLabel xml:lang="en">FLJ13079</skos:altLabel>
		<skos:altLabel xml:lang="en">Fas-Activated Serine/Threonine Kinase wt Allele</skos:altLabel>
		<skos:definition xml:lang="en">Human FASTK wild-type allele is located within 7q35 and is approximately 4 kb in length. This allele, which encodes Fas-activated serine/threonine kinase protein, is involved in apoptotic inhibition via a mechanism mediated by the translational silencer TIA-1. (source : NCI)</skos:definition>
