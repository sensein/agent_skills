		<skos:altLabel xml:lang="fr">menstruation normale</skos:altLabel>
		<skos:altLabel xml:lang="fr">ménorrhée</skos:altLabel>
		<skos:altLabel xml:lang="fr">flux cataménial</skos:altLabel>
		<skos:altLabel xml:lang="fr">flux menstruel</skos:altLabel>
		<skos:altLabel xml:lang="fr">menstruel</skos:altLabel>
		<skos:definition xml:lang="en">The periodic shedding of the ENDOMETRIUM and associated menstrual bleeding in the MENSTRUAL CYCLE of humans and primates. Menstruation is due to the decline in circulating PROGESTERONE, and occurs at the late LUTEAL PHASE when LUTEOLYSIS of the CORPUS LUTEUM takes place. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1333389"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1818633"/>
