	<owl:Class rdf:about="&OntoAD;C0008152">
		<skos:prefLabel xml:lang="en">Chlamydiaceae</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Chlamydiaceae</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Chlamydiaceae</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Chlamydiaceae</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Family Chlamydiaceae</skos:altLabel>
		<skos:altLabel xml:lang="fr">Chlamydiacés</skos:altLabel>
		<skos:definition xml:lang="en">A family of gram-negative, coccoid microorganisms, in the order CHLAMYDIALES, pathogenic for vertebrates. Genera include CHLAMYDIA and CHLAMYDOPHILA. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1532614"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0887972">
		<skos:prefLabel xml:lang="en">Chlamydophila</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Chlamydophila</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Chlamydophila</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Chlamydophila</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Chlamydophila Everett et al. 1999</skos:altLabel>
		<skos:altLabel xml:lang="en">Genus Chlamydophila</skos:altLabel>
		<skos:definition xml:lang="en">A genus of the family CHLAMYDIACEAE comprising gram-negative non CHLAMYDIA TRACHOMATIS-like species infecting vertebrates. Chlamydophila do not produce detectable quantities of glycogen. The type species is CHLAMYDOPHILA PSITTACI. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0008152"/>
	</owl:Class>

