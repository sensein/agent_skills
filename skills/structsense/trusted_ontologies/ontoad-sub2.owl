		<OntoAD:may_be_treated_by rdf:resource="&OntoAD;C0018546"/>
		<OntoAD:has_manifestation rdf:resource="&OntoAD;C0600104"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0228061"/>
