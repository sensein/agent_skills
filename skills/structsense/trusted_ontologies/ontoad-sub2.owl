		<OntoAD:gene_encodes_gene_product rdf:resource="&OntoAD;C0066563"/>
		<OntoAD:gene_encodes_gene_product rdf:resource="&OntoAD;C0166417"/>
		<OntoAD:gene_encodes_gene_product rdf:resource="&OntoAD;C0297429"/>
		<OntoAD:gene_encodes_gene_product rdf:resource="&OntoAD;C0034804"/>
		<OntoAD:gene_encodes_gene_product rdf:resource="&OntoAD;C1521863"/>
		<OntoAD:gene_encodes_gene_product rdf:resource="&OntoAD;C0206588"/>
		<OntoAD:gene_encodes_gene_product rdf:resource="&OntoAD;C0597519"/>
		<OntoAD:gene_encodes_gene_product rdf:resource="&OntoAD;C1336788"/>
