		<skos:altLabel xml:lang="fr">Famine</skos:altLabel>
		<skos:altLabel xml:lang="fr">effets de la faim</skos:altLabel>
		<skos:altLabel xml:lang="fr">famine due à un manque de nourriture</skos:altLabel>
		<skos:altLabel xml:lang="fr">inanition due à un manque de nourriture</skos:altLabel>
