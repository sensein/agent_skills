	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0270611">
		<skos:prefLabel xml:lang="en">Brain Injuries</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">BrainInjuries</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Lésions encéphaliques</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">LésionsEncéphaliques</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">brain damage</skos:altLabel>
		<skos:altLabel xml:lang="en">Brain tissue injury</skos:altLabel>
		<skos:altLabel xml:lang="en">Intracerebral injury</skos:altLabel>
		<skos:altLabel xml:lang="en">brain lesion</skos:altLabel>
		<skos:altLabel xml:lang="en">injury; cerebral</skos:altLabel>
		<skos:altLabel xml:lang="en">Cerebral damage</skos:altLabel>
		<skos:altLabel xml:lang="en">Brain injury</skos:altLabel>
		<skos:altLabel xml:lang="en">acquired brain injury</skos:altLabel>
		<skos:altLabel xml:lang="en">INJ BRAIN</skos:altLabel>
		<skos:altLabel xml:lang="fr">lésions cérébrales</skos:altLabel>
		<skos:altLabel xml:lang="fr">Lésion du cerveau</skos:altLabel>
		<skos:altLabel xml:lang="fr">Lésions de l'encéphale</skos:altLabel>
		<skos:altLabel xml:lang="fr">Atteinte du cerveau</skos:altLabel>
		<skos:altLabel xml:lang="fr">Blessures encéphaliques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Blessures de l'encéphale</skos:altLabel>
		<skos:altLabel xml:lang="fr">lésion cérébrale</skos:altLabel>
		<skos:definition xml:lang="en">Acute and chronic (see also BRAIN INJURIES, CHRONIC) injuries to the brain, including the cerebral hemispheres, CEREBELLUM, and BRAIN STEM. Clinical manifestations depend on the nature of injury. Diffuse trauma to the brain is frequently associated with DIFFUSE AXONAL INJURY or COMA, POST-TRAUMATIC. Localized injuries may be associated with NEUROBEHAVIORAL MANIFESTATIONS; HEMIPARESIS, or other focal neurologic deficits. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0009792"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0751792"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1456496"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0006104"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:has_associated_morphology rdf:resource="&OntoAD;C0010957"/>
		<OntoAD:occurs_before rdf:resource="&OntoAD;C0338618"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0004388">
		<skos:prefLabel xml:lang="en">Autonomic nervous system</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AutonomicNervousSystem</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Système nerveux autonome</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">SystèmeNerveuxAutonome</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">ANS</skos:altLabel>
		<skos:altLabel xml:lang="en">Visceral nervous system</skos:altLabel>
		<skos:altLabel xml:lang="en">autonomic nervous system (ANS)</skos:altLabel>
		<skos:altLabel xml:lang="en">involuntary nervous system</skos:altLabel>
		<skos:altLabel xml:lang="en">Autonomic nervous system structure</skos:altLabel>
		<skos:altLabel xml:lang="en">Autonomic</skos:altLabel>
		<skos:altLabel xml:lang="fr">Système nerveux végétatif</skos:altLabel>
		<skos:altLabel xml:lang="fr">SNV (Système Nerveux Végétatif)</skos:altLabel>
		<skos:altLabel xml:lang="fr">SNA (Système Nerveux Autonome)</skos:altLabel>
		<skos:altLabel xml:lang="fr">système nerveux autonome, SAI</skos:altLabel>
		<skos:altLabel xml:lang="fr">système nerveux végétatif, SAI</skos:altLabel>
		<skos:altLabel xml:lang="fr">système neurovégétatif, SAI</skos:altLabel>
		<skos:definition xml:lang="en">The enteric, parasympathetic, and sympathetic nervous systems taken together. Generally speaking, the autonomic nervous system regulates the internal environment during both peaceful activity and physical or emotional stress. Autonomic activity is controlled and integrated by the central nervous system, especially the hypothalamus and the solitary nucleus, which receive information relayed from VISCERAL AFFERENTS; these and related central and sensory structures are sometimes (but not here) cons (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0027763"/>
		<OntoAD:part_of rdf:resource="&OntoAD;C1269560"/>
		<OntoAD:is_primary_anatomic_site_of_disease rdf:resource="&OntoAD;C0031511"/>
		<OntoAD:is_primary_anatomic_site_of_disease rdf:resource="&OntoAD;C0030421"/>
		<OntoAD:is_primary_anatomic_site_of_disease rdf:resource="&OntoAD;C0334415"/>
	</owl:Class>

