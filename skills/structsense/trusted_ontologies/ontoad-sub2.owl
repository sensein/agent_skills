		<skos:altLabel xml:lang="en">Apolipoprotein E gene</skos:altLabel>
		<skos:definition xml:lang="en">This gene is involved in lipid transport and metabolism. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1445865"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1336818"/>
