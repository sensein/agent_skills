	<owl:Class rdf:about="&OntoAD;C0026218">
		<skos:prefLabel xml:lang="en">Misonidazole</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Misonidazole</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Misonidazole</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Misonidazole</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">alpha-(Methoxymethyl)-2-nitro-1H-imidazole-1-ethanol</skos:altLabel>
		<skos:definition xml:lang="en">A nitroimidazole that sensitizes normally radio-resistant hypoxic cells to radiation. It may also be directly cytotoxic to hypoxic cells and has been proposed as an antineoplastic. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0034541"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0020923"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0028179"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0028403">
		<skos:prefLabel xml:lang="en">Octopamine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Octopamine</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Octopamine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Octopamine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">4-Octopamine</skos:altLabel>
		<skos:altLabel xml:lang="en">Norsympatol</skos:altLabel>
		<skos:altLabel xml:lang="en">Norsynephrine</skos:altLabel>
		<skos:altLabel xml:lang="en">para-Octopamine</skos:altLabel>
		<skos:altLabel xml:lang="en">alpha-(Aminoethyl)-4-hydroxybenzenemethanol</skos:altLabel>
		<skos:altLabel xml:lang="en">p-Octopamine</skos:altLabel>
		<skos:altLabel xml:lang="en">Benzenemethanol, alpha-(aminomethyl)-4-hydroxy-</skos:altLabel>
		<skos:altLabel xml:lang="fr">Norsynéphrine</skos:altLabel>
		<skos:definition xml:lang="en">An alpha-adrenergic sympathomimetic amine, biosynthesized from tyramine in the CNS and platelets and also in invertebrate nervous systems. It is used to treat hypotension and as a cardiotonic. The natural D(-) form is more potent than the L(+) form in producing cardiovascular adrenergic responses. It is also a neurotransmitter in some invertebrates. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0042397"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0001640"/>
	</owl:Class>

