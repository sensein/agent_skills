	<owl:Class rdf:about="&OntoAD;C0016441">
		<skos:prefLabel xml:lang="en">Follow-Up Studies</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Follow-UpStudies</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Études de suivi</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ÉtudesDeSuivi</skos:hiddenLabel>
