		<skos:altLabel xml:lang="en">Progestin</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents progestatifs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Hormones progestatives</skos:altLabel>
		<skos:altLabel xml:lang="fr">Progestatifs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Progestines synthétiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Progestogènes</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments progestatifs</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation de progestine</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation de progestogène</skos:altLabel>
		<skos:definition xml:lang="en">Compounds that interact with PROGESTERONE RECEPTORS in target tissues to bring about the effects similar to those of PROGESTERONE. Primary actions of progestins, including natural and synthetic steroids, are on the UTERUS and the MAMMARY GLAND in preparation for and in maintenance of PREGNANCY. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0683001"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0009905"/>
	</owl:Class>

