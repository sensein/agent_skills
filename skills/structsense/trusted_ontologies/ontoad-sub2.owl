		<skos:altLabel xml:lang="en">disease; basal ganglia</skos:altLabel>
		<skos:altLabel xml:lang="en">Disorder of basal ganglia</skos:altLabel>
		<skos:altLabel xml:lang="en">BASAL GANGLIA DIS</skos:altLabel>
		<skos:altLabel xml:lang="fr">Affections des ganglions basaux</skos:altLabel>
		<skos:altLabel xml:lang="fr">Affections des noyaux gris centraux</skos:altLabel>
		<skos:altLabel xml:lang="fr">Atteinte de ganglion basal</skos:altLabel>
		<skos:altLabel xml:lang="fr">Atteintes des ganglions basaux</skos:altLabel>
		<skos:altLabel xml:lang="fr">Atteintes des ganglions de la base</skos:altLabel>
		<skos:altLabel xml:lang="fr">Atteintes des noyaux gris centraux</skos:altLabel>
		<skos:altLabel xml:lang="fr">Maladies des ganglions basaux</skos:altLabel>
		<skos:altLabel xml:lang="fr">Maladies des ganglions de la base</skos:altLabel>
		<skos:altLabel xml:lang="fr">Maladies des noyaux gris centraux</skos:altLabel>
		<skos:altLabel xml:lang="fr">maladie des noyaux gris centraux</skos:altLabel>
		<skos:altLabel xml:lang="fr">maladie des noyaux basaux</skos:altLabel>
		<skos:definition xml:lang="en">Diseases of the BASAL GANGLIA including the PUTAMEN; GLOBUS PALLIDUS; claustrum; AMYGDALA; and CAUDATE NUCLEUS. DYSKINESIAS (most notably involuntary movements and alterations of the rate of movement) represent the primary clinical manifestations of these disorders. Common etiologies include CEREBROVASCULAR DISORDERS; NEURODEGENERATIVE DISEASES; and CRANIOCEREBRAL TRAUMA. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0006111"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0004781"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0006208">
		<skos:prefLabel xml:lang="en">Structure of Broca's area</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">StructureOfBroca'sArea</skos:hiddenLabel>
