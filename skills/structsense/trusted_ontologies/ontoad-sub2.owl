	<owl:Class rdf:about="&OntoAD;C0034380">
		<skos:prefLabel xml:lang="en">Quality of life</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">QualityOfLife</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Qualité de vie</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">QualitéDeVie</skos:hiddenLabel>
		<skos:definition xml:lang="en">A generic concept reflecting concern with the modification and enhancement of life attributes, e.g., physical, political, moral and social environment; the overall condition of a human life. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">concept générique reflétant l'inquiétude avec la modification et la majoration d'attributs de vie, par ex., environnement physique, politique, moral et social; la condition générale d'une vie humaine. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;IdeaOrConcept"/>
	</owl:Class>

