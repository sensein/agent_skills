	<owl:Class rdf:about="&OntoAD;C0234502">
		<skos:prefLabel xml:lang="en">Visual Agnosia</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">VisualAgnosia</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Agnosie visuelle</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AgnosieVisuelle</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Visuoperceptual agnosia</skos:altLabel>
		<skos:altLabel xml:lang="en">visual agnosia was noted</skos:altLabel>
		<skos:definition xml:lang="en">An inability to recognize or interpret objects by sight. (source : NCI)</skos:definition>
		<skos:definition xml:lang="fr">Perte de la capacité de comprendre le sens ou de reconnaître l'importance de différentes formes de stimulation, qui ne peut pas être attribuée á l'affaiblissement d'une modalité sensorielle primaire. L'agnosie tactile se caractérise par l'incapacité de percevoir la forme et la nature d'un objet par le toucher seul, malgré la sensation inaltérée au toucher léger, position ou autres modalités sensorielles primaires. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2139233"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0155001"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0155006"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1709253"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0036606">
		<skos:prefLabel xml:lang="en">Support Groups</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">SupportGroups</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Groupes d'entraide</skos:prefLabel>
