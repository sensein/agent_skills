		<skos:altLabel xml:lang="en">Gene Locus</skos:altLabel>
		<skos:definition xml:lang="en">The position of a gene or a chromosomal marker on a chromosome; also, a stretch of DNA at a particular place on a particular chromosome. The use of locus is sometimes restricted to mean regions of DNA that are expressed. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0729606"/>
		<OntoAD:anatomic_structure_is_physical_part_of rdf:resource="&OntoAD;C0007634"/>
	</owl:Class>

