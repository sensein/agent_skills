		<skos:altLabel xml:lang="en">Kininase II</skos:altLabel>
		<skos:altLabel xml:lang="en">ACE</skos:altLabel>
		<skos:altLabel xml:lang="en">Dipeptidyl Peptidase A</skos:altLabel>
		<skos:altLabel xml:lang="en">Dipeptidyl carboxypeptidase I</skos:altLabel>
		<skos:altLabel xml:lang="en">Peptidase P</skos:altLabel>
		<skos:altLabel xml:lang="en">ACE-Angiotensin-converting enz</skos:altLabel>
		<skos:altLabel xml:lang="en">ACE  Angiotensin-converting enzyme</skos:altLabel>
		<skos:altLabel xml:lang="en">CD143 Antigens</skos:altLabel>
		<skos:altLabel xml:lang="en">Angiotensin-converting enzyme</skos:altLabel>
		<skos:altLabel xml:lang="en">EC 3.2.1.-</skos:altLabel>
		<skos:altLabel xml:lang="en">CD143</skos:altLabel>
		<skos:altLabel xml:lang="en">Dipeptidyl Carboxypeptidase 1</skos:altLabel>
		<skos:altLabel xml:lang="en">CD 143 ANTIGENS</skos:altLabel>
		<skos:altLabel xml:lang="en">kininase</skos:altLabel>
		<skos:altLabel xml:lang="en">EC 3.4.15.1</skos:altLabel>
		<skos:altLabel xml:lang="fr">Carboxycathepsine</skos:altLabel>
		<skos:altLabel xml:lang="fr">Peptidase P</skos:altLabel>
		<skos:altLabel xml:lang="fr">Enzyme de conversion de l'angiotensine</skos:altLabel>
		<skos:altLabel xml:lang="fr">Kininase A</skos:altLabel>
		<skos:altLabel xml:lang="fr">Angiotensin Converting Enzyme</skos:altLabel>
		<skos:altLabel xml:lang="fr">Antigène CD143</skos:altLabel>
		<skos:altLabel xml:lang="fr">Angiotensin I-Converting Enzyme</skos:altLabel>
		<skos:altLabel xml:lang="fr">Dipeptidyl carboxypeptidase-I</skos:altLabel>
		<skos:altLabel xml:lang="fr">Kininase-II</skos:altLabel>
		<skos:altLabel xml:lang="fr">Dipeptidyl Peptidase A</skos:altLabel>
		<skos:altLabel xml:lang="fr">dipeptidyl carboxypeptidase I</skos:altLabel>
		<skos:altLabel xml:lang="fr">kininase II</skos:altLabel>
		<skos:definition xml:lang="en">A peptidyl-dipeptidase that catalyzes the release of a C-terminal dipeptide, -Xaa-*-Xbb-Xcc, when neither Xaa nor Xbb is Pro. It is a Cl(-)-dependent, zinc glycoprotein that is generally membrane-bound and active at neutral pH. It may also have endopeptidase activity on some substrates. (From Enzyme Nomenclature, 1992) EC 3.4.15.1. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0007075"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1254349"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0014442"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1333402"/>
		<OntoAD:gene_product_has_organism_source rdf:resource="&OntoAD;C0086418"/>
		<OntoAD:gene_product_plays_role_in_biological_process rdf:resource="&OntoAD;C0302820"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1334064"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0031669">
		<skos:prefLabel xml:lang="en">Phospholipase C</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">PhospholipaseC</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">PLC (Phospholipase C)</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">PLC(PhospholipaseC)</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">alpha-toxin</skos:altLabel>
		<skos:altLabel xml:lang="en">Lecithinase C</skos:altLabel>
		<skos:altLabel xml:lang="en">phosphatidylcholine cholinephosphohydrolase</skos:altLabel>
		<skos:altLabel xml:lang="en">Clostridium welchii alpha-toxin</skos:altLabel>
		<skos:altLabel xml:lang="en">Clostridium oedematens beta- and gamma-toxins</skos:altLabel>
		<skos:altLabel xml:lang="en">Lipophosphodiesterase I</skos:altLabel>
		<skos:altLabel xml:lang="en">PLC</skos:altLabel>
		<skos:altLabel xml:lang="fr">Lipophosphodiestérase I</skos:altLabel>
		<skos:altLabel xml:lang="fr">Lécithinase C</skos:altLabel>
		<skos:altLabel xml:lang="fr">Phosphatidylcholine cholinephosphohydrolase</skos:altLabel>
		<skos:altLabel xml:lang="fr">Phospholipase C</skos:altLabel>
		<skos:altLabel xml:lang="fr">Clostridium welchii alpha-toxine</skos:altLabel>
		<skos:altLabel xml:lang="fr">Clostridium oedematens bêta- et gamma-toxines</skos:altLabel>
		<skos:definition xml:lang="en">An enzyme found in the alpha-toxin of Clostridium welchii and other strains of clostridia and bacilli. It hydrolyzes glycerophosphatidates with the formation of 1,2-diacylglycerol and a phosphorylated nitrogenous base such as choline. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0031671"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1704708">
		<skos:prefLabel xml:lang="en">Protein Phosphatase 2A</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">ProteinPhosphatase2A</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Protein Phosphatase 2</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ProteinPhosphatase2</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">PP2A</skos:altLabel>
		<skos:altLabel xml:lang="en">Protein Phosphatase 2</skos:altLabel>
		<skos:altLabel xml:lang="en">PROTEIN PHOSPHATASE 002</skos:altLabel>
		<skos:altLabel xml:lang="fr">Phosphoprotéine-phosphatase de type 2A</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine phosphatase-2</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine phosphatase de type 2</skos:altLabel>
		<skos:altLabel xml:lang="fr">Phosphatase de type PP2A</skos:altLabel>
		<skos:altLabel xml:lang="fr">Phosphoprotéine-phosphatase de type 2</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine phosphatase-2A</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine phosphatase de type 2A</skos:altLabel>
		<skos:altLabel xml:lang="fr">PP2A</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protein Phosphatase II</skos:altLabel>
		<skos:definition xml:lang="en">A phosphoprotein phosphatase subtype that is comprised of a catalytic subunit and two different regulatory subunits. At least two genes encode isoforms of the protein phosphatase catalytic subunit, while several isoforms of regulatory subunits exist due to the presence of multiple genes and the alternative splicing of their mRNAs. Protein phosphatase 2 acts on a broad variety of cellular proteins and may play a role as a regulator of intracellular signaling processes. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;AminoAcid,Peptide,OrProtein"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;Enzyme"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0031686"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0024075">
		<skos:prefLabel xml:lang="en">Luciferases</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Luciferases</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Luciferases</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Luciferases</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Immunologic, Luciferase</skos:altLabel>
		<skos:altLabel xml:lang="fr">Luciferase</skos:altLabel>
		<skos:definition xml:lang="en">Enzymes that oxidize certain LUMINESCENT AGENTS to emit light (PHYSICAL LUMINESCENCE). The luciferases from different organisms have evolved differently so have different structures and substrates. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0030016"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0014442"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1333402"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1335186"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0006675">
		<skos:prefLabel xml:lang="en">Calcium</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Calcium</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Calcium</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Calcium</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Factor IV</skos:altLabel>
		<skos:altLabel xml:lang="en">Ca  Calcium</skos:altLabel>
		<skos:altLabel xml:lang="en">Calcium coagulation factor</skos:altLabel>
		<skos:altLabel xml:lang="en">Coagulation Factor IV</skos:altLabel>
		<skos:altLabel xml:lang="en">Blood Coagulation Factor IV</skos:altLabel>
		<skos:altLabel xml:lang="en">Calcium analyte</skos:altLabel>
		<skos:altLabel xml:lang="en">Ca++ element</skos:altLabel>
		<skos:altLabel xml:lang="en">BLOOD COAG FACTOR IV</skos:altLabel>
		<skos:altLabel xml:lang="en">COAG FACTOR IV</skos:altLabel>
		<skos:altLabel xml:lang="en">[TN420] CALCIUM</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteur IV</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteur IV de la coagulation</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteur IV de la coagulation sanguine</skos:altLabel>
		<skos:definition xml:lang="en">A basic element found in nearly all organized tissues. It is a member of the alkaline earth family of metals with the atomic symbol Ca, atomic number 20, and atomic weight 40. Calcium is the most abundant mineral in the body and combines with phosphorus to form calcium phosphate in the bones and teeth. It is essential for the normal functioning of nerves and muscles and plays a role in blood coagulation (as factor IV) and in many enzymatic processes. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">http://info.cancer.ca/f/glossary/C/Calcium.htm (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0556112"/>
		<OntoAD:measured_by rdf:resource="&OntoAD;C0728876"/>
		<OntoAD:ingredient_of rdf:resource="&OntoAD;C0731033"/>
		<OntoAD:measured_by rdf:resource="&OntoAD;C1254493"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0030054">
		<skos:prefLabel xml:lang="en">Oxygen</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Oxygen</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Oxygène</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Oxygène</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Chemical oxygen</skos:altLabel>
		<skos:altLabel xml:lang="en">Elemental oxygen</skos:altLabel>
		<skos:altLabel xml:lang="en">O2  Oxygen</skos:altLabel>
		<skos:altLabel xml:lang="en">O2</skos:altLabel>
		<skos:altLabel xml:lang="en">O element</skos:altLabel>
		<skos:altLabel xml:lang="en">O2 element</skos:altLabel>
		<skos:altLabel xml:lang="fr">oxygène chimique</skos:altLabel>
		<skos:altLabel xml:lang="fr">oxygène élémentaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">O2</skos:altLabel>
		<skos:definition xml:lang="en">An element with atomic symbol O, atomic number 8, and atomic weight [15.99903; 15.99977]. It is the most abundant element on earth and essential for respiration. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1254347"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0443356"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0032285"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0043047">
		<skos:prefLabel xml:lang="en">Water</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Water</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Eau</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Eau</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Hydrogen Oxide</skos:altLabel>
		<skos:altLabel xml:lang="en">H2O  Water</skos:altLabel>
		<skos:altLabel xml:lang="en">Water product</skos:altLabel>
		<skos:altLabel xml:lang="en">WATER,PURIFIED</skos:altLabel>
		<skos:altLabel xml:lang="fr">Oxyde de dihydrogène</skos:altLabel>
		<skos:altLabel xml:lang="fr">Hydroxyde d'hydrogène</skos:altLabel>
		<skos:definition xml:lang="en">A clear, odorless, tasteless liquid that is essential for most animal and plant life and is an excellent solvent for many substances. The chemical formula is hydrogen oxide (H2O). (McGraw-Hill Dictionary of Scientific and Technical Terms, 4th ed) (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">liquide clair, sans odeur, fade qui est essentiel chez la plupart des animaux et des PLANTES et qui est un solvant excellent de beaucoup de substances. (traduit de 'McGraw-Hill Dictionary of Scientific and Technical Terms, 4th ed') (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1688568"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1706946"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1289922"/>
		<OntoAD:direct_substance_of rdf:resource="&OntoAD;C0020311"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0020275">
		<skos:prefLabel xml:lang="en">Hydrogen</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Hydrogen</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Hydrogène</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Hydrogène</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">H  Hydrogen</skos:altLabel>
		<skos:altLabel xml:lang="en">H2  Hydrogen</skos:altLabel>
		<skos:altLabel xml:lang="en">H element</skos:altLabel>
		<skos:definition xml:lang="en">The first chemical element in the periodic table. It has the atomic symbol H, atomic number 1, and atomic weight [1.00784; 1.00811]. It exists, under normal conditions, as a colorless, odorless, tasteless, diatomic gas. Hydrogen ions are PROTONS. Besides the common H1 isotope, hydrogen exists as the stable isotope DEUTERIUM and the unstable, radioactive isotope TRITIUM. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0013879"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0220839">
		<skos:prefLabel xml:lang="en">Glutamate</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Glutamate</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">L-Glutamate</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">L-Glutamate</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">L-Glutamate</skos:altLabel>
		<skos:altLabel xml:lang="en">Glu</skos:altLabel>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2317427"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0008405">
		<skos:prefLabel xml:lang="en">Choline</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Choline</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Choline</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Choline</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Ethanaminium, 2-hydroxy-N,N,N-trimethyl-</skos:altLabel>
		<skos:altLabel xml:lang="en">Choline preparation</skos:altLabel>
		<skos:altLabel xml:lang="fr">Bilineurine</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation de choline</skos:altLabel>
		<skos:definition xml:lang="en">A basic constituent of lecithin that is found in many plants and animal organs. It is important as a precursor of acetylcholine, as a methyl donor in various metabolic processes, and in lipid metabolism. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0042849"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0023831"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013182"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0036720">
		<skos:prefLabel xml:lang="en">Serine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Serine</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Sérine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Sérine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">L-Serine</skos:altLabel>
		<skos:altLabel xml:lang="en">Ser</skos:altLabel>
		<skos:altLabel xml:lang="en">beta-Hydroxyalanine</skos:altLabel>
		<skos:altLabel xml:lang="en">serine (SER)</skos:altLabel>
		<skos:altLabel xml:lang="fr">L-Sérine</skos:altLabel>
		<skos:definition xml:lang="en">A non-essential amino acid occurring in natural form as the L-isomer. It is synthesized from GLYCINE or THREONINE. It is involved in the biosynthesis of PURINES; PYRIMIDINES; and other amino acids. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0301715"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0311461"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0311462"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2348255"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0001041">
		<skos:prefLabel xml:lang="en">Acetylcholine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Acetylcholine</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Acétylcholine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Acétylcholine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Ethanaminium, 2-(acetyloxy)-N,N,N-trimethyl-</skos:altLabel>
		<skos:altLabel xml:lang="en">Acetylcholine preparation</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation d'acétylcholine</skos:altLabel>
		<skos:definition xml:lang="en">A neurotransmitter found at neuromuscular junctions, autonomic ganglia, parasympathetic effector junctions, a subset of sympathetic effector junctions, and at many sites in the central nervous system. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0242893"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0027908"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0042402"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0026207"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0242894"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013182"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0302583">
		<skos:prefLabel xml:lang="en">Iron</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Iron</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Fer</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Fer</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Iron preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">Iron product</skos:altLabel>
		<skos:altLabel xml:lang="en">Iron drug</skos:altLabel>
		<skos:altLabel xml:lang="en">Fe  Iron</skos:altLabel>
		<skos:altLabel xml:lang="en">Fe element</skos:altLabel>
		<skos:altLabel xml:lang="en">Iron agent</skos:altLabel>
		<skos:altLabel xml:lang="en">ferric ion</skos:altLabel>
		<skos:altLabel xml:lang="en">hematinics iron preparations</skos:altLabel>
		<skos:altLabel xml:lang="en">iron preparations</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation de fer</skos:altLabel>
		<skos:definition xml:lang="en">A metallic element with atomic symbol Fe, atomic number 26, and atomic weight 55.85. It is an essential constituent of HEMOGLOBINS; CYTOCHROMES; and IRON-BINDING PROTEINS. It plays a role in cellular redox reactions and in the transport of OXYGEN. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0347988"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0556113"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0040577"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0018928"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013182"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0002878"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0039245">
		<skos:prefLabel xml:lang="en">Tacrine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Tacrine</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Tacrine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Tacrine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Tetrahydroaminoacridine</skos:altLabel>
		<skos:altLabel xml:lang="en">THA</skos:altLabel>
		<skos:definition xml:lang="en">A cholinesterase inhibitor that crosses the blood-brain barrier. Tacrine has been used to counter the effects of muscle relaxants, as a respiratory stimulant, and in the treatment of Alzheimer's disease and other central nervous system disorders. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0001046"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0304408"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0594440"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1531592"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2067217"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0001186"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0002395"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0020517"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0009968">
		<skos:prefLabel xml:lang="en">Copper</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Copper</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Cuivre</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Cuivre</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Cu  Copper</skos:altLabel>
		<skos:altLabel xml:lang="en">Cu element</skos:altLabel>
		<skos:altLabel xml:lang="en">mineral supplements copper</skos:altLabel>
		<skos:altLabel xml:lang="en">copper in a drug form</skos:altLabel>
		<skos:definition xml:lang="en">A heavy metal trace element with the atomic symbol Cu, atomic number 29, and atomic weight 63.55. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">http://www.fnclcc.fr/fr/patients/dico/definition.php?id_definition=438 (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0347988"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0556113"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0040577"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2145047"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1254347"/>
		<OntoAD:measured_by rdf:resource="&OntoAD;C0373587"/>
		<OntoAD:has_active_ingredient rdf:resource="&OntoAD;C0303182"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0002367">
		<skos:prefLabel xml:lang="en">Aluminum</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Aluminum</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Aluminium</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Aluminium</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">aluminium</skos:altLabel>
		<skos:altLabel xml:lang="en">Al  Aluminum</skos:altLabel>
		<skos:altLabel xml:lang="en">Aluminum material</skos:altLabel>
		<skos:altLabel xml:lang="en">Aluminum element</skos:altLabel>
		<skos:altLabel xml:lang="en">Al element</skos:altLabel>
		<skos:definition xml:lang="en">A metallic element that has the atomic number 13, atomic symbol Al, and atomic weight 26.98. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1254347"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0041485">
		<skos:prefLabel xml:lang="en">Tyrosine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Tyrosine</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Tyrosine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Tyrosine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">para-Tyrosine</skos:altLabel>
		<skos:altLabel xml:lang="en">L-Tyrosine</skos:altLabel>
		<skos:altLabel xml:lang="en">TYR</skos:altLabel>
		<skos:altLabel xml:lang="en">Tyrosine, L-isomer</skos:altLabel>
		<skos:altLabel xml:lang="en">L-Phenylalanine, 4-hydroxy-</skos:altLabel>
		<skos:altLabel xml:lang="en">L-TYROSINE 98.5 %</skos:altLabel>
		<skos:altLabel xml:lang="en">tyrosine (Tyr)</skos:altLabel>
		<skos:altLabel xml:lang="fr">L-Tyrosine</skos:altLabel>
		<skos:altLabel xml:lang="fr">Isomère L de la tyrosine</skos:altLabel>
		<skos:definition xml:lang="en">A non-essential amino acid. In animals it is synthesized from PHENYLALANINE. It is also the precursor of EPINEPHRINE; THYROID HORMONES; and melanin. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0556082"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0311461"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2348255"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0301713"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0301715"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0311462"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013182"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0010654">
		<skos:prefLabel xml:lang="en">Cysteine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Cysteine</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Cystéine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Cystéine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Half-Cystine</skos:altLabel>
		<skos:altLabel xml:lang="en">L-Cysteine</skos:altLabel>
		<skos:altLabel xml:lang="en">Cys</skos:altLabel>
		<skos:altLabel xml:lang="en">Cysteine preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">R)-2-Amino-3-sulfanyl-propanoic acid</skos:altLabel>
		<skos:altLabel xml:lang="fr">Thioalanine</skos:altLabel>
		<skos:altLabel xml:lang="fr">L-Cystéine</skos:altLabel>
		<skos:definition xml:lang="en">A thiol-containing non-essential amino acid that is oxidized to form CYSTINE. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0002527"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0301715"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0311462"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0311461"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2348255"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0280082"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0043481">
		<skos:prefLabel xml:lang="en">Zinc</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Zinc</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Zinc</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Zinc</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Zinc preparation,</skos:altLabel>
		<skos:altLabel xml:lang="en">Zinc product</skos:altLabel>
		<skos:altLabel xml:lang="en">Zn  Zinc</skos:altLabel>
		<skos:altLabel xml:lang="en">Zn element</skos:altLabel>
		<skos:altLabel xml:lang="en">Zinc preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">mineral supplements zinc</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation de zinc</skos:altLabel>
		<skos:definition xml:lang="en">A metallic element of atomic number 30 and atomic weight 65.38. It is a necessary trace element in the diet, forming an essential part of many enzymes, and playing an important role in protein synthesis and in cell division. Zinc deficiency is associated with ANEMIA, short stature, HYPOGONADISM, impaired WOUND HEALING, and geophagia. It is known by the symbol Zn. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0347988"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0556112"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0040577"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0013030">
		<skos:prefLabel xml:lang="en">Dopamine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Dopamine</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Dopamine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Dopamine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Hydroxytyramine</skos:altLabel>
		<skos:altLabel xml:lang="en">Dopamine agent</skos:altLabel>
		<skos:altLabel xml:lang="en">Dopamine preparation</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation de dopamine</skos:altLabel>
		<skos:altLabel xml:lang="fr">hydroxytyramine</skos:altLabel>
		<skos:definition xml:lang="en">One of the catecholamine NEUROTRANSMITTERS in the brain. It is derived from TYROSINE and is the precursor to NOREPINEPHRINE and EPINEPHRINE. Dopamine is a major transmitter in the extrapyramidal system of the brain, and important in regulating movement. A family of receptors (RECEPTORS, DOPAMINE) mediate its action. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0007412"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0007209"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0039052"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0042510"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0031511"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0037473">
		<skos:prefLabel xml:lang="en">Sodium</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Sodium</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Sodium</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Sodium</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Sodium product</skos:altLabel>
		<skos:altLabel xml:lang="en">Na  Sodium</skos:altLabel>
		<skos:altLabel xml:lang="en">Na element</skos:altLabel>
		<skos:definition xml:lang="en">An element that is a member of the alkali group of metals. It has the atomic symbol Na, atomic number 11, and atomic weight 23. With a valence of 1, it has a strong affinity for oxygen and other nonmetallic elements. Sodium provides the chief cation of the extracellular body fluids. Its salts are the most widely used in medicine. (From Dorland, 27th ed) Physiologically the sodium ion plays a major role in blood pressure regulation, maintenance of fluid volume, and electrolyte balance. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0304459"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1254347"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0949756">
		<skos:prefLabel xml:lang="en">D-Aspartate</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">D-Aspartate</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">D-Aspartate</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">D-Aspartate</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">ASPARATE D</skos:altLabel>
		<rdfs:subClassOf rdf:resource="&OntoAD;AminoAcid,Peptide,OrProtein"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;BiologicallyActiveSubstance"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0071499">
		<skos:prefLabel xml:lang="en">polyacrylamide</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Polyacrylamide</skos:hiddenLabel>
		<skos:definition xml:lang="en">white, water soluable polymer based on acrylamide; used as a thickening or suspending agent in water based formulations. (source : CSP)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0576733"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0017911">
		<skos:prefLabel xml:lang="en">Glycogen</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Glycogen</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Glycogène</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Glycogène</skos:hiddenLabel>
		<skos:definition xml:lang="en">large branched polysaccharide consisting of glucose residues; the major carbohydrate reserve of animals, stored primarily in liver and muscle, synthesized and degraded for energy as demanded. (source : CSP)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0032594"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0037125">
		<skos:prefLabel xml:lang="en">Silver</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Silver</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Argent</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Argent</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Ag  Silver</skos:altLabel>
		<skos:altLabel xml:lang="en">Ag element</skos:altLabel>
		<skos:definition xml:lang="en">Silver. An element with the atomic symbol Ag, atomic number 47, and atomic weight 107.87. It is a soft metal that is used medically in surgical instruments, dental prostheses, and alloys. Long-continued use of silver salts can lead to a form of poisoning known as ARGYRIA. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0347988"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0038836">
		<skos:prefLabel xml:lang="en">Superoxides</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Superoxides</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Superoxydes</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Superoxydes</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Superoxide Anion</skos:altLabel>
		<skos:altLabel xml:lang="en">Superoxide Radical</skos:altLabel>
		<skos:altLabel xml:lang="fr">Superoxyde</skos:altLabel>
		<skos:altLabel xml:lang="fr">Anion hyperoxyde</skos:altLabel>
		<skos:altLabel xml:lang="fr">Radicaux superoxydes</skos:altLabel>
		<skos:altLabel xml:lang="fr">Radical superoxyde</skos:altLabel>
		<skos:definition xml:lang="en">Highly reactive compounds produced when oxygen is reduced by a single electron. In biological systems, they may be generated during the normal catalytic function of a number of enzymes and during the oxidation of hemoglobin to METHEMOGLOBIN. In living organisms, SUPEROXIDE DISMUTASE protects the cell from the deleterious effects of superoxides. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0162772"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0025646">
		<skos:prefLabel xml:lang="en">Methionine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Methionine</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Méthionine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Méthionine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Methionine product</skos:altLabel>
		<skos:altLabel xml:lang="en">L-Methionine</skos:altLabel>
		<skos:altLabel xml:lang="en">Met</skos:altLabel>
		<skos:altLabel xml:lang="en">Methionine, L-Isomer</skos:altLabel>
		<skos:altLabel xml:lang="en">Methionine preparation</skos:altLabel>
		<skos:altLabel xml:lang="fr">Isomère L de la méthionine</skos:altLabel>
		<skos:altLabel xml:lang="fr">L-Méthionine</skos:altLabel>
		<skos:definition xml:lang="en">A sulfur containing essential amino acid that is important in many body functions. It is a chelating agent for heavy metals. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0002525"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0301715"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0311462"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0556083"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0353698"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0009742">
		<skos:prefLabel xml:lang="en">Congo Red</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CongoRed</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Rouge Congo</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">RougeCongo</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Direct red 28</skos:altLabel>
		<skos:altLabel xml:lang="en">Congo red stain</skos:altLabel>
		<skos:definition xml:lang="en">An acid dye used in testing for hydrochloric acid in gastric contents. It is also used histologically to test for AMYLOIDOSIS. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0301161"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0079883">
		<skos:prefLabel xml:lang="en">N-Methylaspartate</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">N-Methylaspartate</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">N-Méthyl-aspartate</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">N-Méthyl-aspartate</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">N-Methyl-D-aspartic acid</skos:altLabel>
		<skos:altLabel xml:lang="en">N-Methyl-D-aspartate</skos:altLabel>
		<skos:altLabel xml:lang="en">NMDA</skos:altLabel>
		<skos:altLabel xml:lang="en">NMDA (N methyl D aspartate)</skos:altLabel>
		<skos:altLabel xml:lang="en">METHYLASPARTATE ND</skos:altLabel>
		<skos:altLabel xml:lang="en">n-methylaspartate (NMA)</skos:altLabel>
		<skos:altLabel xml:lang="fr">NMDA</skos:altLabel>
		<skos:altLabel xml:lang="fr">N-Méthyl-D-aspartate</skos:altLabel>
		<skos:altLabel xml:lang="fr">N-Méthylaspartate</skos:altLabel>
		<skos:definition xml:lang="en">An amino acid that, as the D-isomer, is the defining agonist for the NMDA receptor subtype of glutamate receptors (RECEPTORS, NMDA). (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">aminoacide que, comme le D-isomère, est agoniste définissant pour le sous-type de récepteur NMDA de récepteurs glutamate (RÉCEPTEURS, NMDA ). (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0004015"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0001443">
		<skos:prefLabel xml:lang="en">Adenosine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Adenosine</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Adénosine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Adénosine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Adenosine product</skos:altLabel>
		<skos:altLabel xml:lang="en">Adenosine agent</skos:altLabel>
		<skos:altLabel xml:lang="en">Adenosine  chemical</skos:altLabel>
		<skos:altLabel xml:lang="en">Adenosine preparation</skos:altLabel>
		<skos:definition xml:lang="en">A nucleoside that is composed of adenine and d-ribose. Adenosine or adenosine derivatives play many important biological roles in addition to being components of DNA and RNA. Adenosine itself is a neurotransmitter. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0027908"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0002771"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0042402"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0004238"/>
		<OntoAD:ingredient_of rdf:resource="&OntoAD;C0001480"/>
		<OntoAD:ingredient_of rdf:resource="&OntoAD;C0001465"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013182"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0032821">
		<skos:prefLabel xml:lang="en">Potassium</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Potassium</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Potassium</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Potassium</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Potassium product</skos:altLabel>
		<skos:altLabel xml:lang="en">K  Potassium</skos:altLabel>
		<skos:altLabel xml:lang="en">K element</skos:altLabel>
		<skos:altLabel xml:lang="en">potassium preparations</skos:altLabel>
		<skos:definition xml:lang="en">An element that is in the alkali group of metals. It has an atomic symbol K, atomic number 19, and atomic weight 39.10. It is the chief cation in the intracellular fluid of muscle and other cells. Potassium ion is a strong electrolyte and it plays a significant role in the regulation of fluid volume and maintenance of the water-electrolyte balance. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2064887"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0304459"/>
		<OntoAD:has_active_ingredient rdf:resource="&OntoAD;C0303275"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0021968">
		<skos:prefLabel xml:lang="en">Iodine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Iodine</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Iode</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Iode</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">I- element</skos:altLabel>
		<skos:altLabel xml:lang="en">Iodine product</skos:altLabel>
		<skos:altLabel xml:lang="en">Jodum</skos:altLabel>
		<skos:altLabel xml:lang="en">vaginal preparations iodine vaginal</skos:altLabel>
		<skos:definition xml:lang="en">A nonmetallic element of the halogen group that is represented by the atomic symbol I, atomic number 53, and atomic weight of 126.90. It is a nutritionally essential element, especially important in thyroid hormone synthesis. In solution, it has anti-infective properties and is used topically. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0206109"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003205"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0303013"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2064912"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2064785"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0020517"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0003765">
		<skos:prefLabel xml:lang="en">Arginine</skos:prefLabel>
