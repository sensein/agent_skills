	<owl:Class rdf:about="&OntoAD;C0021079">
		<skos:prefLabel xml:lang="en">Therapeutic immunosuppression</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">TherapeuticImmunosuppression</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Immunosuppression thérapeutique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ImmunosuppressionThérapeutique</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Immunosuppression</skos:altLabel>
		<skos:altLabel xml:lang="en">Antirejection Therapy</skos:altLabel>
		<skos:altLabel xml:lang="en">artificial immunosuppression</skos:altLabel>
		<skos:altLabel xml:lang="en">IMMUNE SUPPRESSION</skos:altLabel>
		<skos:altLabel xml:lang="en">Immunosuppressive therapy</skos:altLabel>
		<skos:altLabel xml:lang="en">Anti-Rejection Therapy</skos:altLabel>
		<skos:altLabel xml:lang="en">THER ANTIREJECTION</skos:altLabel>
		<skos:altLabel xml:lang="en">THER ANTI REJECTION</skos:altLabel>
		<skos:altLabel xml:lang="fr">Thérapie anti-rejet</skos:altLabel>
		<skos:altLabel xml:lang="fr">Thérapie antirejet</skos:altLabel>
		<skos:altLabel xml:lang="fr">Immuno-suppression thérapeutique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Immunodépression thérapeutique</skos:altLabel>
		<skos:altLabel xml:lang="fr">thérapie immunosuppressive</skos:altLabel>
		<skos:definition xml:lang="en">Deliberate prevention or diminution of the host's immune response. It may be nonspecific as in the administration of immunosuppressive agents (drugs or radiation) or by lymphocyte depletion or may be specific as in desensitization or the simultaneous administration of antigen and immunosuppressive drugs. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0021083"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0021081">
		<skos:prefLabel xml:lang="en">Immunosuppressive Agents</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">ImmunosuppressiveAgents</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Immunosuppresseurs</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Immunosuppresseurs</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Immunosuppressant agent,</skos:altLabel>
		<skos:altLabel xml:lang="en">immunosuppressive</skos:altLabel>
		<skos:altLabel xml:lang="en">Immunosuppressants</skos:altLabel>
		<skos:altLabel xml:lang="en">Immunosupressant agent,</skos:altLabel>
		<skos:altLabel xml:lang="en">IMMUNE SUPPRESSANTS</skos:altLabel>
		<skos:altLabel xml:lang="en">Immunosuppressant</skos:altLabel>
		<skos:altLabel xml:lang="fr">Immunodépresseurs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments immunodépresseurs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments immuno-suppresseurs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents immunodépresseurs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents immunosuppresseurs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Immuno-dépresseurs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Immuno-suppresseurs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments immunosuppresseurs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments immuno-dépresseurs</skos:altLabel>
		<skos:altLabel xml:lang="fr">agent immunosuppresseur</skos:altLabel>
		<skos:definition xml:lang="en">Agents that suppress immune function by one of several mechanisms of action. Classical cytotoxic immunosuppressants act by inhibiting DNA synthesis. Others may act through activation of T-CELLS or by inhibiting the activation of HELPER CELLS. While immunosuppression has been brought about in the past primarily to prevent rejection of transplanted organs, new applications involving mediation of the effects of INTERLEUKINS and other CYTOKINES are emerging. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0021079"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1527392"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0005525"/>
	</owl:Class>

