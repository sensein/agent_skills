		<skos:hiddenLabel xml:lang="en">ResponseToWounding</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">physiological response to wounding</skos:altLabel>
		<skos:definition xml:lang="en">Any process that results in a change in state or activity of a cell or an organism (in terms of movement, secretion, enzyme production, gene expression, etc.) as a result of a stimulus indicating damage to the organism. [GOC:go_curators] (source : GO)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0149784"/>
	</owl:Class>

