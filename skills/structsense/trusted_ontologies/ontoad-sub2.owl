	<owl:Class rdf:about="&OntoAD;C2347026">
		<skos:prefLabel xml:lang="en">Biospecimen</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Biospecimen</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Specimen</skos:altLabel>
		<skos:altLabel xml:lang="en">Sample</skos:altLabel>
		<skos:altLabel xml:lang="en">Biological Specimen</skos:altLabel>
		<skos:altLabel xml:lang="en">Biological Sample</skos:altLabel>
		<skos:altLabel xml:lang="en">Bio-Specimen</skos:altLabel>
		<skos:altLabel xml:lang="en">BiologicSpecimen</skos:altLabel>
		<skos:definition xml:lang="en">Any material sample taken from a biological entity for testing, diagnostic, propagation, treatment or research purposes, including a sample obtained from a living organism or taken from the biological object after halting of all its life functions. Biospecimen can contain one or more components including but not limited to cellular molecules, cells, tissues, organs, body fluids, embryos, and body excretory products. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0370003"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0016732">
		<skos:prefLabel xml:lang="en">Frontal bone structure</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">FrontalBoneStructure</skos:hiddenLabel>
