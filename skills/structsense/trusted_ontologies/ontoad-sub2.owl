		<skos:hiddenLabel xml:lang="fr">Amfétamine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Desoxynorephedrin</skos:altLabel>
		<skos:altLabel xml:lang="en">Phenopromin</skos:altLabel>
		<skos:altLabel xml:lang="en">dl-Amphetamine</skos:altLabel>
		<skos:altLabel xml:lang="en">Benzeneethanamine, alpha-methyl-, (+-)-</skos:altLabel>
		<skos:altLabel xml:lang="en">d,1-alpha- Methylphenethylamine</skos:altLabel>
		<skos:altLabel xml:lang="en">Phenylaminopropane</skos:altLabel>
		<skos:altLabel xml:lang="en">Phenamine</skos:altLabel>
		<skos:altLabel xml:lang="en">Desoxynorephedrine</skos:altLabel>
		<skos:altLabel xml:lang="fr">Amphétamine</skos:altLabel>
		<skos:altLabel xml:lang="fr">d,1-alpha-méthylphénéthylamine</skos:altLabel>
		<skos:altLabel xml:lang="fr">phénylaminopropane</skos:altLabel>
		<skos:definition xml:lang="en">A powerful central nervous system stimulant and sympathomimetic. Amphetamine has multiple mechanisms of action including blocking uptake of adrenergics and dopamine, stimulation of release of monamines, and inhibiting monoamine oxidase. Amphetamine is also a drug of abuse and a psychotomimetic. The l- and the d,l-forms are included here. The l-form has less central nervous system activity but stronger cardiovascular effects. The d-form is DEXTROAMPHETAMINE. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0002763"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0001637"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0039052"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0002667"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0443078"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1445631"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0020538"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0003850"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0017601"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C1263846"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013182"/>
	</owl:Class>

