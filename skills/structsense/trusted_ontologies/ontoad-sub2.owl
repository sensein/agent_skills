		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1334064"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1335528"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0007428">
		<skos:prefLabel xml:lang="en">Cathepsins</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Cathepsins</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Cathepsines</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Cathepsines</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Cathepsin</skos:altLabel>
		<skos:definition xml:lang="en">A group of lysosomal proteinases or endopeptidases found in aqueous extracts of a variety of animal tissues. They function optimally within an acidic pH range. The cathepsins occur as a variety of enzyme subtypes including SERINE PROTEASES; ASPARTIC PROTEINASES; and CYSTEINE PROTEASES. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0030946"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0443871"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0014442"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0020289"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1333402"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1334064"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1335528"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0770343">
		<skos:prefLabel xml:lang="en">Pancrelipase</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Pancrelipase</skos:hiddenLabel>
