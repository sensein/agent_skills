		<skos:definition xml:lang="en">Human gamma-enolase protein (433 aa, approximately 47 kD) is encoded by the ENO2 gene. This neuron-specific enzyme catalyzes the formation of pyruvate from D-glyceraldehyde 3-phosphate during glycolysis. It is involved in both neurotrophy and neuroprotection. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0024188"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0014442"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1333402"/>
		<OntoAD:gene_product_has_organism_source rdf:resource="&OntoAD;C0086418"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0751295">
