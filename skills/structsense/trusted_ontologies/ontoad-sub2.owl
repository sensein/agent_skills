		<skos:hiddenLabel xml:lang="en">HistocompatibilityAntigensClassII</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Antigènes d'histocompatibilité de classe II</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AntigènesD'histocompatibilitéDeClasseII</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Class II Antigens</skos:altLabel>
		<skos:altLabel xml:lang="en">Ia-Like Antigens</skos:altLabel>
		<skos:altLabel xml:lang="en">Ia Antigens</skos:altLabel>
		<skos:altLabel xml:lang="en">Immune Response Antigens</skos:altLabel>
		<skos:altLabel xml:lang="en">Immune-Response-Associated Antigens</skos:altLabel>
		<skos:altLabel xml:lang="en">Class II Major Histocompatibility Antigens</skos:altLabel>
		<skos:altLabel xml:lang="en">I-A Antigen</skos:altLabel>
		<skos:altLabel xml:lang="en">Human Leukocyte Antigen</skos:altLabel>
		<skos:altLabel xml:lang="en">MHC class II antigen</skos:altLabel>
		<skos:altLabel xml:lang="en">HLA</skos:altLabel>
		<skos:altLabel xml:lang="en">Major Histocompatibility Complex Class II</skos:altLabel>
		<skos:altLabel xml:lang="en">MHC Class II Molecule</skos:altLabel>
		<skos:altLabel xml:lang="en">MHC Class II Protein</skos:altLabel>
		<skos:altLabel xml:lang="en">IR ANTIGENS</skos:altLabel>
		<skos:altLabel xml:lang="en">HISTOCOMPATIBILITY ANTIGENS CLASS 02</skos:altLabel>
		<skos:altLabel xml:lang="en">human lymphocyte antigen</skos:altLabel>
		<skos:altLabel xml:lang="fr">Antigènes de la réponse immune</skos:altLabel>
		<skos:altLabel xml:lang="fr">Antigènes associés à la réponse immune</skos:altLabel>
		<skos:altLabel xml:lang="fr">Antigène d'histocompatibilité de classe II</skos:altLabel>
		<skos:altLabel xml:lang="fr">Antigènes d'histocompatibilité de classe 2</skos:altLabel>
		<skos:altLabel xml:lang="fr">Antigènes du CMH de classe II</skos:altLabel>
		<skos:altLabel xml:lang="fr">Antigène I-A</skos:altLabel>
		<skos:altLabel xml:lang="fr">Antigène IA</skos:altLabel>
		<skos:altLabel xml:lang="fr">Antigènes majeurs d'histocompatibilité de classe II</skos:altLabel>
		<skos:altLabel xml:lang="fr">Antigènes d'histocompatibilité majeurs de classe II</skos:altLabel>
		<skos:altLabel xml:lang="fr">Antigènes de classe II du complexe majeur d'histocompatibilité</skos:altLabel>
		<skos:altLabel xml:lang="fr">Antigène de classe II</skos:altLabel>
		<skos:altLabel xml:lang="fr">Antigènes de classe II</skos:altLabel>
		<skos:definition xml:lang="en">Large, transmembrane, non-covalently linked glycoproteins (alpha and beta). Both chains can be polymorphic although there is more structural variation in the beta chains. The class II antigens in humans are called HLA-D ANTIGENS and are coded by a gene on chromosome 6. In mice, two genes named IA and IE on chromosome 17 code for the H-2 antigens. The antigens are found on B-lymphocytes, macrophages, epidermal cells, and sperm and are thought to mediate the competence of and cellular cooperation  (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0021072"/>
		<OntoAD:gene_product_has_associated_anatomy rdf:resource="&OntoAD;C0007603"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1334166"/>
	</owl:Class>

