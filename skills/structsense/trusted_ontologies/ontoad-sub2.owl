	<owl:Class rdf:about="&OntoAD;C0376544">
		<skos:prefLabel xml:lang="en">Hematopoietic Neoplasms</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">HematopoieticNeoplasms</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Tumeurs hématopoïétiques</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">TumeursHématopoïétiques</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Hematopoietic Malignancies</skos:altLabel>
		<skos:altLabel xml:lang="en">Hematopoietic Cancer</skos:altLabel>
		<skos:altLabel xml:lang="en">Hematopoietic and Lymphoid Cell Neoplasm</skos:altLabel>
		<skos:altLabel xml:lang="en">Hematopoietic Cell Tumor</skos:altLabel>
		<skos:altLabel xml:lang="en">Hematopoietic Neoplasms including Lymphomas</skos:altLabel>
		<skos:altLabel xml:lang="en">Hematopoietic, Including Myeloma</skos:altLabel>
		<skos:altLabel xml:lang="en">Hematopoietic and Lymphoid Neoplasms</skos:altLabel>
		<skos:altLabel xml:lang="en">Malignant hematopoietic neoplasm</skos:altLabel>
		<skos:altLabel xml:lang="en">Hematopoietic Tumor</skos:altLabel>
		<skos:altLabel xml:lang="en">Hematopoietic neoplasm</skos:altLabel>
		<skos:altLabel xml:lang="en">HEMATOPOIETIC NEOPL</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tumeur hématopoïétique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tumeurs malignes hématopoïétiques</skos:altLabel>
		<skos:definition xml:lang="en">A neoplasm arising from hematopoietic cells found in the bone marrow, peripheral blood, lymph nodes and spleen (organs of the hematopoietic system). Hematopoietic cell neoplasms can also involve other anatomic sites (e.g. central nervous system, gastrointestinal tract), either by metastasis, direct tumor infiltration, or neoplastic transformation of extranodal lymphoid tissues. The commonest forms are the various types of leukemia, Hodgkin and non-Hodgkin lymphomas, and myelodysplastic syndromes (source : )</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0474796"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1512377"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1512393"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1288351"/>
		<OntoAD:associated_morphology_of rdf:resource="&OntoAD;C1532168"/>
		<OntoAD:disease_has_normal_cell_origin rdf:resource="&OntoAD;C1512385"/>
		<OntoAD:associated_morphology_of rdf:resource="&OntoAD;C0348393"/>
		<OntoAD:disease_has_normal_tissue_origin rdf:resource="&OntoAD;C1512398"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1512393">
		<skos:prefLabel xml:lang="en">Hematopoietic and Lymphoid System Neoplasm</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">HematopoieticAndLymphoidSystemNeoplasm</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Hematopoietic and Lymphoid System Tumor</skos:altLabel>
		<skos:definition xml:lang="en">Neoplasms of the hematopoietic system, including hematopoietic cell neoplasms (e.g. leukemias, lymphomas) and non-hematopoietic cell neoplasms that can affect the hematopoietic system (e.g. lymph node and splenic sarcomas). --2003 (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0851353"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0027653"/>
	</owl:Class>

