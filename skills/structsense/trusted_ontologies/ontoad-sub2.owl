	<owl:Class rdf:about="&OntoAD;C0015689">
		<skos:prefLabel xml:lang="en">Omega-3 Fatty Acids</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Omega-3FattyAcids</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Acides gras omega-3</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AcidesGrasOmega-3</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Omega-3 fatty acid</skos:altLabel>
		<skos:altLabel xml:lang="en">n-3 Fatty Acids</skos:altLabel>
		<skos:altLabel xml:lang="en">OMEGA-3 POLYUNSATURATED FATTY ACIDS</skos:altLabel>
		<skos:altLabel xml:lang="en">omega-3 PUFA</skos:altLabel>
		<skos:altLabel xml:lang="en">n-3 Polyunsaturated Fatty Acid</skos:altLabel>
		<skos:altLabel xml:lang="en">Omega-3</skos:altLabel>
		<skos:altLabel xml:lang="en">N-3 fatty acid</skos:altLabel>
		<skos:altLabel xml:lang="en">O3FA</skos:altLabel>
		<skos:altLabel xml:lang="en">FATTY ACIDS N 03</skos:altLabel>
		<skos:altLabel xml:lang="en">FATTY ACIDS OMEGA 03</skos:altLabel>
		<skos:altLabel xml:lang="en">dietary supplements fatty acidsomega-3</skos:altLabel>
		<skos:altLabel xml:lang="en">Fatty Acids, Omega-3</skos:altLabel>
		<skos:altLabel xml:lang="en">n-3 PUFA</skos:altLabel>
		<skos:altLabel xml:lang="en">Omega-3 Fatty Acid-class Agent</skos:altLabel>
		<skos:altLabel xml:lang="fr">Omega 3</skos:altLabel>
		<skos:altLabel xml:lang="fr">Omega-3</skos:altLabel>
		<skos:altLabel xml:lang="fr">acides gras Oméga3</skos:altLabel>
		<skos:altLabel xml:lang="fr">acides gras oméga</skos:altLabel>
		<skos:definition xml:lang="en">A group of fatty acids, often of marine origin, which have the first unsaturated bond in the third position from the omega carbon. These fatty acids are believed to reduce serum triglycerides, prevent insulin resistance, improve lipid profile, prolong bleeding times, reduce platelet counts, and decrease platelet adhesiveness. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">L'acide linoléique (oméga-6) et l'acide linolénique (oméga-3) sont les principaux acides gras essentiels. Ils se trouvent dans les poissons gras et les huiles végétales (tournesol et maïs pour le premier ; colza, noix, pépins de raisin et soja pour le second). Ces acides gras essentiels sont indispensables au bon fonctionnement du corps. Néanmoins, pris en excès, ces acides gras peuvent provoquer une baisse de l'immunité, une fragilisation des membranes des cellules et des troubles de la coagula (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0032615"/>
		<OntoAD:may_prevent rdf:resource="&OntoAD;C0003811"/>
		<OntoAD:has_physiologic_effect rdf:resource="&OntoAD;C0544958"/>
	</owl:Class>

