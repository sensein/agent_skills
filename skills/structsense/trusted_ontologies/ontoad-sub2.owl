		<skos:altLabel xml:lang="fr">musculeuse</skos:altLabel>
		<skos:definition xml:lang="en">The detrusor muscle of the bladder, forming the muscular wall of the bladder, consisting of the inner longitudinal; middle circular; and outer longitudinal layers. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1267092"/>
	</owl:Class>

