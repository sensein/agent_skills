		<skos:altLabel xml:lang="en">Cachectin</skos:altLabel>
		<skos:altLabel xml:lang="en">Cachectin-Tumor Necrosis Factor</skos:altLabel>
		<skos:altLabel xml:lang="en">Tumor Necrosis Factor</skos:altLabel>
		<skos:altLabel xml:lang="en">TNF</skos:altLabel>
		<skos:altLabel xml:lang="en">TNFA</skos:altLabel>
		<skos:altLabel xml:lang="en">Tumor necrosis factor alpha</skos:altLabel>
