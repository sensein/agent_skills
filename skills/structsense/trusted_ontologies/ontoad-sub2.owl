		<skos:definition xml:lang="en">Human TNFSF10 wild-type allele is located within 3q26 and is approximately 18 kb in length. This allele, which encodes tumor necrosis factor ligand superfamily member 10 protein, is involved in the induction and modulation of apoptosis. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1336646"/>
		<OntoAD:gene_plays_role_in_process rdf:resource="&OntoAD;C0007587"/>
		<OntoAD:gene_found_in_organism rdf:resource="&OntoAD;C0086418"/>
		<OntoAD:gene_plays_role_in_process rdf:resource="&OntoAD;C0162638"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0042510">
		<skos:prefLabel xml:lang="en">Ventricular Fibrillation</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">VentricularFibrillation</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Fibrillation ventriculaire</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">FibrillationVentriculaire</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Ventricular fibrillation paroxysm</skos:altLabel>
		<skos:altLabel xml:lang="en">Fibrillation paroxysmal vent</skos:altLabel>
		<skos:altLabel xml:lang="en">Cardiac arrest-ventric fibrill</skos:altLabel>
		<skos:altLabel xml:lang="en">Cardiac arrest  ventricular fibrillation</skos:altLabel>
		<skos:altLabel xml:lang="en">VF  Ventricular fibrillation</skos:altLabel>
		<skos:altLabel xml:lang="en">Ventricular fibrillation paroxysmal</skos:altLabel>
		<skos:altLabel xml:lang="en">VFib</skos:altLabel>
		<skos:altLabel xml:lang="fr">FIBRILLATION VENTRIC PAROXYSTIQUE</skos:altLabel>
		<skos:altLabel xml:lang="fr">Fibrillation ventriculaire paroxystique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Fibrillation paroxystique ventr</skos:altLabel>
		<skos:definition xml:lang="en">A potentially lethal cardiac arrhythmia that is characterized by uncoordinated extremely rapid firing of electrical impulses (400-600/min) in HEART VENTRICLES. Such asynchronous ventricular quivering or fibrillation prevents any effective cardiac output and results in unconsciousness (SYNCOPE). It is one of the major electrocardiographic patterns seen with CARDIAC ARREST. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0085612"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:disease_has_associated_anatomic_site rdf:resource="&OntoAD;C0007226"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0010054"/>
		<OntoAD:disease_has_associated_anatomic_site rdf:resource="&OntoAD;C0035237"/>
		<OntoAD:may_be_treated_by rdf:resource="&OntoAD;C1705480"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013030"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0851578">
		<skos:prefLabel xml:lang="en">Sleep Disorders</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">SleepDisorders</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Troubles du sommeil</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">TroublesDuSommeil</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">sleep disturbances</skos:altLabel>
		<skos:altLabel xml:lang="en">sleep disorder</skos:altLabel>
		<skos:altLabel xml:lang="en">Sleep-wake disorder</skos:altLabel>
		<skos:altLabel xml:lang="en">Sleep problem</skos:altLabel>
		<skos:altLabel xml:lang="en">Sleep dysfunction</skos:altLabel>
		<skos:altLabel xml:lang="en">parasomnia</skos:altLabel>
		<skos:altLabel xml:lang="en">Sleep disorders and disturbances</skos:altLabel>
		<skos:altLabel xml:lang="en">SLEEP DIS</skos:altLabel>
		<skos:altLabel xml:lang="fr">Trouble du sommeil</skos:altLabel>
		<skos:altLabel xml:lang="fr">Troubles et anomalies du sommeil</skos:altLabel>
		<skos:altLabel xml:lang="fr">Trouble du sommeil, sans précision</skos:altLabel>
		<skos:definition xml:lang="en">Conditions characterized by disturbances of usual sleep patterns or behaviors. Sleep disorders may be divided into three major categories: DYSSOMNIAS (i.e. disorders characterized by insomnia or hypersomnia), PARASOMNIAS (abnormal sleep behaviors), and sleep disorders secondary to medical or psychiatric disorders. (From Thorpy, Sleep Disorders Medicine, 1994, p187) (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">affections caractérisées par les troubles de sommeil ordinaire modèlent ou les conduites. Les troubles de sommeil peuvent être divisés en trois catégories importantes : ¤slDYSSOMNIAS¤sl (c'est-à-dire les troubles caractérisés par l'insomnie ou ¤slhypersomnia¤sl ), ¤slPARASOMNIAS¤sl (conduites de sommeil anormales) et les troubles de sommeil secondaires aux troubles médicaux ou psychiatriques. (traduit de 'From Thorpy, Sleep Disorders Medicine, 1994, p187') (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0004936"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0220952"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0011581"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0038454"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0018802"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0039070"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0027765">
		<skos:prefLabel xml:lang="en">nervous system disorder</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">NervousSystemDisorder</skos:hiddenLabel>
