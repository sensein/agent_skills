		<OntoAD:finding_site_of rdf:resource="&OntoAD;C0007760"/>
		<OntoAD:finding_site_of rdf:resource="&OntoAD;C0033132"/>
		<OntoAD:finding_site_of rdf:resource="&OntoAD;C0262404"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0014038">
		<skos:prefLabel xml:lang="en">Encephalitis</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Encephalitis</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Encéphalite</skos:prefLabel>
