	<owl:Class rdf:about="&OntoAD;C0039062">
		<skos:prefLabel xml:lang="en">Synapses</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Synapses</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Synapses</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Synapses</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">synapse</skos:altLabel>
		<skos:altLabel xml:lang="en">neuron junction</skos:altLabel>
		<skos:altLabel xml:lang="en">neuron-neuron junction</skos:altLabel>
		<skos:altLabel xml:lang="en">Synaptic junction</skos:altLabel>
		<skos:altLabel xml:lang="en">Synapse structure</skos:altLabel>
		<skos:altLabel xml:lang="fr">Synapse</skos:altLabel>
		<skos:altLabel xml:lang="fr">Jonctions synaptiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Jonction synaptique</skos:altLabel>
		<skos:definition xml:lang="en">Specialized junctions at which a neuron communicates with a target cell. At classical synapses, a neuron's presynaptic terminal releases a chemical transmitter stored in synaptic vesicles which diffuses across a narrow synaptic cleft and activates receptors on the postsynaptic membrane of the target cell. The target may be a dendrite, cell body, or axon of another neuron, or a specialized region of a muscle or secretory cell. Neurons may also communicate via direct electrical coupling with ELECT (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0027763"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0021721"/>
		<OntoAD:anatomic_structure_is_physical_part_of rdf:resource="&OntoAD;C0007634"/>
		<OntoAD:part_of rdf:resource="&OntoAD;C1269560"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0039729">
		<skos:prefLabel xml:lang="en">Thalamic structure</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">ThalamicStructure</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Thalamus</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Thalamus</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">thalamus</skos:altLabel>
		<skos:altLabel xml:lang="en">Dorsal thalamus</skos:altLabel>
		<skos:altLabel xml:lang="en">Thalamic</skos:altLabel>
		<skos:altLabel xml:lang="en">dorsal thalamus (Anthoney)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Couche optique</skos:altLabel>
		<skos:altLabel xml:lang="fr">thalamus, SAI</skos:altLabel>
		<skos:altLabel xml:lang="fr">thalamique</skos:altLabel>
		<skos:definition xml:lang="en">Paired bodies containing mostly gray substance and forming part of the lateral wall of the third ventricle of the brain. The thalamus represents the major portion of the diencephalon and is commonly divided into cellular aggregates known as nuclear groups. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1268162"/>
