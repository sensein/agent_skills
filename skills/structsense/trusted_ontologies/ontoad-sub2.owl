	<owl:Class rdf:about="&OntoAD;C2733158">
		<skos:prefLabel xml:lang="en">Cerebral Small Vessel Diseases</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CerebralSmallVesselDiseases</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Maladies des petits vaisseaux cérébraux</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">MaladiesDesPetitsVaisseauxCérébraux</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">cerebral small vessel disease</skos:altLabel>
		<skos:altLabel xml:lang="en">cerebral vessel disease</skos:altLabel>
		<skos:altLabel xml:lang="en">Cerebral Microangiopathies</skos:altLabel>
		<skos:altLabel xml:lang="en">Small vessel cerebrovascular disease</skos:altLabel>
		<skos:altLabel xml:lang="fr">pathologie cérébrale microvasculaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">Microangiopathies cérébrales</skos:altLabel>
		<skos:altLabel xml:lang="fr">Pathologie chronique des petits vaisseaux cérébraux</skos:altLabel>
		<skos:altLabel xml:lang="fr">Microangiopathie cérébrale</skos:altLabel>
		<skos:definition xml:lang="en">Pathological processes or diseases where cerebral MICROVESSELS show abnormalities. They are often associated with aging, hypertension and risk factors for lacunar infarcts (see LACUNAR INFARCTION); LEUKOARAIOSIS; and CEREBRAL HEMORRHAGE. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0007820"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0225992"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0033137">
		<skos:prefLabel xml:lang="en">Primary Health Care</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">PrimaryHealthCare</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Soins de santé primaires</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">SoinsDeSantéPrimaires</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">primary care</skos:altLabel>
		<skos:altLabel xml:lang="en">Care Patients</skos:altLabel>
		<skos:altLabel xml:lang="en">Primary Healthcare</skos:altLabel>
		<skos:altLabel xml:lang="fr">soins primaires</skos:altLabel>
		<skos:altLabel xml:lang="fr">soin primaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">Soins de santé primaire</skos:altLabel>
		<skos:definition xml:lang="en">Care which provides integrated, accessible health care services by clinicians who are accountable for addressing a large majority of personal health care needs, developing a sustained partnership with patients, and practicing in the context of family and community. (JAMA 1995;273(3):192) (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Soins fournissant des services de santé intégrés et accessibles par des cliniciens responsables de satisfaire une grande majorité des besoins personnels de soin de santé, qui établissent des partenariats avec les patients et qui pratiquent dans le contexte de la famille et de la communauté. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0017313"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0033522">
		<skos:prefLabel xml:lang="en">Prospective Studies</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">ProspectiveStudies</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Études prospectives</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ÉtudesProspectives</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">prospective study</skos:altLabel>
		<skos:altLabel xml:lang="en">prospective population-based study</skos:altLabel>
		<skos:altLabel xml:lang="en">longitudinal study</skos:altLabel>
		<skos:altLabel xml:lang="en">longitudinal cohort study</skos:altLabel>
		<skos:altLabel xml:lang="en">projective study</skos:altLabel>
		<skos:altLabel xml:lang="en">prospective longitudinal study</skos:altLabel>
		<skos:altLabel xml:lang="fr">étude prospective</skos:altLabel>
		<skos:altLabel xml:lang="fr">analyses longitudinales</skos:altLabel>
		<skos:altLabel xml:lang="fr">étude longitudinale</skos:altLabel>
		<skos:altLabel xml:lang="fr">Études longitudinales prospectives</skos:altLabel>
		<skos:definition xml:lang="en">Observation of a population for a sufficient number of persons over a sufficient number of years to generate incidence or mortality rates subsequent to the selection of the study group. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">L'observation d'une population pour un nombre suffisant de personnes sur un nombre suffisant d'années pour produire l'incidence ou les mortalités ultérieures à la sélection du groupe d'étude. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;ResearchActivity"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0935584">
		<skos:prefLabel xml:lang="en">Executive Function</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">ExecutiveFunction</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Fonctions exécutives</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">FonctionsExécutives</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">executive control</skos:altLabel>
		<skos:altLabel xml:lang="en">executive functioning</skos:altLabel>
		<skos:altLabel xml:lang="en">executive functions</skos:altLabel>
		<skos:altLabel xml:lang="fr">Contrôle exécutif</skos:altLabel>
		<skos:definition xml:lang="en">A set of cognitive functions that controls complex, goal-directed thought and behavior. Executive function involves multiple domains, such as CONCEPT FORMATION, goal management, cognitive flexibility, INHIBITION control, and WORKING MEMORY. Impaired executive function is seen in a range of disorders, e.g., SCHIZOPHRENIA; and ADHD. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;MentalProcess"/>
		<OntoAD:biological_process_has_associated_location rdf:resource="&OntoAD;C0006104"/>
		<OntoAD:biological_process_has_associated_location rdf:resource="&OntoAD;C0027763"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0206031">
		<skos:prefLabel xml:lang="en">Logistic Regression</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">LogisticRegression</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Régression logistique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">RégressionLogistique</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">logistic regression models</skos:altLabel>
		<skos:definition xml:lang="en">A type of regression analysis used to predict whether or not something will happen. Most often used when the dependent variable is dichotomous or categorical. (source : PSY)</skos:definition>
		<skos:definition xml:lang="fr">modèles statistiques qui décrivent le rapport entre une variable dépendante qualitative (c'est-à-dire celui qui peut prendre de seulement certaines valeurs séparées, comme la présence ou l'absence d'une maladie) et une variable indépendante. Une application commune est dans l'épidémiologie pour estimer le risque d'un individu (les chances d'une maladie) comme une fonction d'un facteur de risque donné. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;ResearchActivity"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0033489">
		<skos:prefLabel xml:lang="en">Proportional Hazards Models</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">ProportionalHazardsModels</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Modèles de hasards proportionnels</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ModèlesDeHasardsProportionnels</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">proportional hazard models</skos:altLabel>
		<skos:altLabel xml:lang="en">proportional hazards model</skos:altLabel>
		<skos:altLabel xml:lang="fr">Régression de Cox</skos:altLabel>
		<skos:altLabel xml:lang="fr">Modèles à risques proportionnels</skos:altLabel>
		<skos:altLabel xml:lang="fr">Modèles à risque proportionnel</skos:altLabel>
		<skos:definition xml:lang="en">Statistical models used in survival analysis that assert that the effect of the study factors on the hazard rate in the study population is multiplicative and does not change over time. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">modèles statistiques utilisaient dans l'analyse de survivance qui affirment que l'effet des facteurs d'étude sur le taux de hasard dans la population d'étude est ¤slmultiplicative¤sl et ne change pas complètement de temps. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0034980"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0038953"/>
	</owl:Class>

