		<skos:hiddenLabel xml:lang="fr">Helicobacter</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Helicobacter Goodwin et al. 1989 emend. Vandamme et al. 1991</skos:altLabel>
		<skos:altLabel xml:lang="en">Genus Helicobacter</skos:altLabel>
		<skos:altLabel xml:lang="en">helicobacter bacteria</skos:altLabel>
		<skos:definition xml:lang="en">A genus of gram-negative, spiral-shaped bacteria that has been isolated from the intestinal tract of mammals, including humans. It has been associated with PEPTIC ULCER. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1029239"/>
	</owl:Class>

