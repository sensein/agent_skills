	<owl:Class rdf:about="&OntoAD;C0206194">
		<skos:prefLabel xml:lang="en">Survivors</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Survivors</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Survivants</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Survivants</skos:hiddenLabel>
		<skos:definition xml:lang="en">Persons who have experienced a prolonged survival after serious disease or who continue to live with a usually life-threatening condition as well as family members, significant others, or individuals surviving traumatic life events. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Personnes qui ont l'expérience d'une survie prolongée après une maladie grave ou qui continuent à vivre avec un état représentant habituellement un danger pour la vie, ou individus qui ont survécu à des évènements traumatiques de la vie. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0027361"/>
	</owl:Class>

