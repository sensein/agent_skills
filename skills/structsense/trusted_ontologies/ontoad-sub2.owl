	<owl:Class rdf:about="&OntoAD;C2827465">
		<skos:prefLabel xml:lang="en">APOE wt Allele</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">APOEWtAllele</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">LPG</skos:altLabel>
		<skos:altLabel xml:lang="en">Alzheimer Disease 2 Gene</skos:altLabel>
		<skos:altLabel xml:lang="en">AD2</skos:altLabel>
		<skos:altLabel xml:lang="en">LDLCQ5</skos:altLabel>
		<skos:altLabel xml:lang="en">MGC1571</skos:altLabel>
		<skos:altLabel xml:lang="en">Apolipoprotein E wt Allele</skos:altLabel>
		<skos:definition xml:lang="en">Human APOE wild-type allele is located in the vicinity of 19q13.2 and is approximately 4 kb in length. This allele, which encodes apolipoprotein E protein, plays a role in the mediation of lipid transport and metabolism. Genetic variation is involved in both cardiovascular disease and Alzheimer's disease. Mutation of the gene is associated with type III hyperlipoproteinemia. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1412481"/>
		<OntoAD:gene_associated_with_disease rdf:resource="&OntoAD;C0002395"/>
		<OntoAD:gene_associated_with_disease rdf:resource="&OntoAD;C0004153"/>
		<OntoAD:gene_plays_role_in_process rdf:resource="&OntoAD;C0037083"/>
		<OntoAD:gene_found_in_organism rdf:resource="&OntoAD;C0086418"/>
		<OntoAD:gene_plays_role_in_process rdf:resource="&OntoAD;C0598783"/>
	</owl:Class>

