	<owl:Class rdf:about="&OntoAD;C0031511">
		<skos:prefLabel xml:lang="en">Pheochromocytoma</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Pheochromocytoma</skos:hiddenLabel>
