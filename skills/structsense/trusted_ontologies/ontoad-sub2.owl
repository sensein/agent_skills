	<owl:Class rdf:about="&OntoAD;C0242970">
		<skos:prefLabel xml:lang="en">Diet, Fat-Restricted</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Diet,Fat-Restricted</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Régime pauvre en graisses</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">RégimePauvreEnGraisses</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Low-fat diet</skos:altLabel>
		<skos:altLabel xml:lang="en">Diet, Low-Fat</skos:altLabel>
		<skos:altLabel xml:lang="en">LF  Low fat diet</skos:altLabel>
		<skos:altLabel xml:lang="en">LFD  Low fat diet</skos:altLabel>
		<skos:altLabel xml:lang="en">Low fat diet</skos:altLabel>
		<skos:altLabel xml:lang="fr">Régime hypolipidique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Régime pauvre en lipides</skos:altLabel>
		<skos:altLabel xml:lang="fr">Régime alimentaire pauvre en graisses</skos:altLabel>
		<skos:definition xml:lang="en">A diet that contains limited amounts of fat with less than 30% of calories from all fats and less than 10% from saturated fat. Such a diet is used in control of HYPERLIPIDEMIAS. (From Bondy et al, Metabolic Control and Disease, 8th ed, pp468-70; Dorland, 27th ed) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2183378"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0452286"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0018546">
		<skos:prefLabel xml:lang="en">Haloperidol</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Haloperidol</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Halopéridol</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Halopéridol</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Haloperidol antipsychotic</skos:altLabel>
		<skos:definition xml:lang="en">A phenyl-piperidinyl-butyrophenone that is used primarily to treat SCHIZOPHRENIA and other PSYCHOSES. It is also used in schizoaffective disorder, DELUSIONAL DISORDERS, ballism, and TOURETTE SYNDROME (a drug of choice) and occasionally as adjunctive therapy in INTELLECTUAL DISABILITY and the chorea of HUNTINGTON DISEASE. It is a potent antiemetic and is used in the treatment of intractable HICCUPS. (From AMA Drug Evaluations Annual, 1994, p279) (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Une phényl-piperidynyl-butyrophénone qui fut d'abord utilisée dans le traitement des schizophrénies et autres psychoses. Il est aussi employé dans les troubles psycho-affectifs, les troubles paranoïaques, le syndrome de Tourette, et de temps en temps comme traitement adjuvant des retards mentaux et de la chorée de Huntington. C'est aussi un antiémétique efficace et il est employé dans le traitement des hoquets réfractaires. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2092061"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0304387"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1268911"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0242702"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0030567"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0033975"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0036341"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0010068"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0040517"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0042963"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0005956"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013182"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0023895"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0015127">
		<skos:prefLabel xml:lang="en">Etiology aspects</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">EtiologyAspects</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">cause</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Cause</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">causality</skos:altLabel>
		<skos:altLabel xml:lang="en">Causes</skos:altLabel>
		<skos:altLabel xml:lang="en">etiology</skos:altLabel>
		<skos:altLabel xml:lang="en">aetiology</skos:altLabel>
		<skos:altLabel xml:lang="en">ETIOL</skos:altLabel>
		<skos:altLabel xml:lang="fr">causes</skos:altLabel>
		<skos:altLabel xml:lang="fr">étiologie</skos:altLabel>
		<skos:definition xml:lang="en">Used with diseases for causative agents including microorganisms and includes environmental and social factors and personal habits as contributing factors. It includes pathogenesis. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">(C, F3) /etiology /etiol ou /ET s'applique aux maladies pour les facteurs responsables de l'affection y compris les micro-organismes. Il comprend également les facteurs environnementaux ou sociaux et les habitudes de vie. Il inclut la pathogenèse. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;FunctionalConcept"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0005697">
		<skos:prefLabel xml:lang="en">Neurogenic Urinary Bladder</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">NeurogenicUrinaryBladder</skos:hiddenLabel>
