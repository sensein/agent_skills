	<owl:Class rdf:about="&OntoAD;C0032015">
		<skos:prefLabel xml:lang="en">Pituitary Hormones</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">PituitaryHormones</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Hormones hypophysaires</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">HormonesHypophysaires</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">hypophysial hormone</skos:altLabel>
		<skos:altLabel xml:lang="en">Pituitary hormone</skos:altLabel>
		<skos:altLabel xml:lang="fr">hormone hypophysaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">hormone pituitaire</skos:altLabel>
		<skos:definition xml:lang="en">Hormones secreted by the PITUITARY GLAND including those from the anterior lobe (adenohypophysis), the posterior lobe (neurohypophysis), and the ill-defined intermediate lobe. Structurally, they include small peptides, proteins, and glycoproteins. They are under the regulation of neural signals (NEUROTRANSMITTERS) or neuroendocrine signals (HYPOTHALAMIC HORMONES) from the hypothalamus as well as feedback from their targets such as ADRENAL CORTEX HORMONES; ANDROGENS; ESTROGENS. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0729633"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0597192"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1260930"/>
		<OntoAD:is_biochemical_function_of_gene_product rdf:resource="&OntoAD;C0040160"/>
		<OntoAD:is_biochemical_function_of_gene_product rdf:resource="&OntoAD;C0037663"/>
		<OntoAD:is_biochemical_function_of_gene_product rdf:resource="&OntoAD;C0030095"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1335375"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0032016">
		<skos:prefLabel xml:lang="en">Pituitary Hormones, Anterior</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">PituitaryHormones,Anterior</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Hormones antéhypophysaires</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">HormonesAntéhypophysaires</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Adenohypophyseal Hormones</skos:altLabel>
		<skos:altLabel xml:lang="en">ANTERIOR PITUITARY</skos:altLabel>
		<skos:altLabel xml:lang="en">Anterior pituitary hormone</skos:altLabel>
