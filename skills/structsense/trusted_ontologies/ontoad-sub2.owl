		<skos:altLabel xml:lang="en">Analeptic Drugs</skos:altLabel>
		<skos:altLabel xml:lang="en">Analeptic agent</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents analeptiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments analeptiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">agent analeptique</skos:altLabel>
