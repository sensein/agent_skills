		<skos:altLabel xml:lang="en">Spectral</skos:altLabel>
		<skos:definition xml:lang="en">A charted band of wavelengths of electromagnetic vibrations. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;QuantitativeConcept"/>
	</owl:Class>

