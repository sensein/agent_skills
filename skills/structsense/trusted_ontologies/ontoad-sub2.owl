	<owl:Class rdf:about="&OntoAD;C0012322">
		<skos:prefLabel xml:lang="en">Dihydroxyacetone</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Dihydroxyacetone</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Dihydroxyacétone</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Dihydroxyacétone</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">DHA</skos:altLabel>
		<skos:altLabel xml:lang="en">DHA preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">Dihydroxyacetone preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">DHA agent</skos:altLabel>
		<skos:altLabel xml:lang="en">Dihydroxyacetone agent</skos:altLabel>
		<skos:altLabel xml:lang="en">repigmentation agents dihydroxyacetone</skos:altLabel>
		<skos:altLabel xml:lang="fr">DHA</skos:altLabel>
		<skos:altLabel xml:lang="fr">Oxétone</skos:altLabel>
		<skos:altLabel xml:lang="fr">Propanediolone</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation de dihydroxyacétone</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation de DHA</skos:altLabel>
		<skos:definition xml:lang="en">A ketotriose compound. Its addition to blood preservation solutions results in better maintenance of 2,3-diphosphoglycerate levels during storage. It is readily phosphorylated to dihydroxyacetone phosphate by triokinase in erythrocytes. In combination with naphthoquinones it acts as a sunscreening agent. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0280079"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0007004"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2064824"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0043251"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013182"/>
	</owl:Class>

