	<owl:Class rdf:about="&OntoAD;C0333559">
		<skos:prefLabel xml:lang="en">Infarction, Lacunar</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Infarction,Lacunar</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Infarctus lacunaire</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">InfarctusLacunaire</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">lacunar infarcts</skos:altLabel>
		<skos:altLabel xml:lang="en">Infarct, Lacunar</skos:altLabel>
		<skos:altLabel xml:lang="en">LACI  Lacunar infarction</skos:altLabel>
		<skos:altLabel xml:lang="en">LI  Lacunar infarction</skos:altLabel>
		<skos:altLabel xml:lang="en">Lacunar infarct</skos:altLabel>
		<skos:altLabel xml:lang="en">Lacunar infarction</skos:altLabel>
		<skos:altLabel xml:lang="fr">infarctus lacunaires</skos:altLabel>
		<skos:definition xml:lang="en">Brain infarction that affects small subcortical vessels due to occlusion of a penetrating artery deep in the brain. It may lead to lacunar stroke. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Tissu nécrose dans n'importe quelle région{domaine} du cerveau, en incluant les HÉMISPHÈRES CÉRÉBRAUX, LE CERVELET et le TRONC CEREBRAL. L'INFARCTUS ENCÉPHALIQUE est le résultat d'une cascade d'événements lancés par le flux sanguin insuffisant par le cerveau qui est suivi par l'HYPOXIE et l'HYPOGLYCÉMIE dans le tissu du cerveau. Le dommage peut être temporaire, permanent, sélectif ou pan-necrosis. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0021308"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0007785"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1263853"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0242202"/>
	</owl:Class>

