	<owl:Class rdf:about="&OntoAD;C0282461">
		<skos:prefLabel xml:lang="en">Phase 3 Clinical Trials</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Phase3ClinicalTrials</skos:hiddenLabel>
