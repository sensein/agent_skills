		<skos:altLabel xml:lang="fr">Hormone testiculaire</skos:altLabel>
		<skos:definition xml:lang="en">Hormones produced in the testis. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0301819"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0002844">
		<skos:prefLabel xml:lang="en">Androgens</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Androgens</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Androgènes</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Androgènes</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Androgen preparation,</skos:altLabel>
		<skos:altLabel xml:lang="en">Androgen product</skos:altLabel>
		<skos:altLabel xml:lang="en">Androgenic drug</skos:altLabel>
		<skos:altLabel xml:lang="en">Androgenic preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">Androgenic Agents</skos:altLabel>
		<skos:altLabel xml:lang="en">Androgenic Compounds</skos:altLabel>
		<skos:altLabel xml:lang="en">Androgen</skos:altLabel>
		<skos:altLabel xml:lang="en">Androgen Receptor Agonists</skos:altLabel>
		<skos:altLabel xml:lang="en">Therapeutic Androgen</skos:altLabel>
		<skos:altLabel xml:lang="en">Androgen-class Agent</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agonistes des récepteurs des androgènes</skos:altLabel>
		<skos:altLabel xml:lang="fr">Composés androgéniques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agonistes des récepteurs androgéniques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agonistes des récepteurs aux androgènes</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation androgène</skos:altLabel>
		<skos:altLabel xml:lang="fr">médicament androgénique</skos:altLabel>
		<skos:altLabel xml:lang="fr">androgène</skos:altLabel>
		<skos:definition xml:lang="en">Compounds that interact with ANDROGEN RECEPTORS in target tissues to bring about the effects similar to those of TESTOSTERONE. Depending on the target tissues, androgenic effects can be on SEX DIFFERENTIATION; male reproductive organs, SPERMATOGENESIS; secondary male SEX CHARACTERISTICS; LIBIDO; development of muscle mass, strength, and power. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0683001"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0036884"/>
	</owl:Class>

