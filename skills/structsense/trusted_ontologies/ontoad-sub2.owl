		<skos:prefLabel xml:lang="fr">Métabolisme</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Métabolisme</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Metabolic Processes</skos:altLabel>
		<skos:altLabel xml:lang="en">General metabolic function</skos:altLabel>
		<skos:altLabel xml:lang="en">Intermediary Metabolism</skos:altLabel>
		<skos:altLabel xml:lang="en">METAB</skos:altLabel>
		<skos:altLabel xml:lang="en">METAB PROCESSES</skos:altLabel>
		<skos:altLabel xml:lang="en">Intermediary Metabolic Process</skos:altLabel>
		<skos:altLabel xml:lang="fr">Processus métaboliques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Processus métabolique</skos:altLabel>
		<skos:altLabel xml:lang="fr">fonction métabolique générale</skos:altLabel>
		<skos:altLabel xml:lang="fr">métabolique</skos:altLabel>
		<skos:definition xml:lang="en">The chemical reactions that occur within the cells, tissues, or an organism. These processes include both the biosynthesis (ANABOLISM) and the breakdown (CATABOLISM) of organic materials utilized by the living organism. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Ensemble des actions de transformation qu'effectue l'organisme, aboutissant à la création d'énergie ou à l'élaboration de substances diverses. On distingue l'anabolisme (métabolisme de fabrication) du catabolisme (métabolisme de dégradation). (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;OrganismFunction"/>
		<OntoAD:biological_process_involves_gene_product rdf:resource="&OntoAD;C0010762"/>
	</owl:Class>

