		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0020649"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0027763"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0026769"/>
	</owl:Class>

