	<owl:Class rdf:about="&OntoAD;C0042849">
		<skos:prefLabel xml:lang="en">Vitamin B Complex</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">VitaminBComplex</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Complexe vitaminique B</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ComplexeVitaminiqueB</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">vitamin B</skos:altLabel>
		<skos:altLabel xml:lang="en">B vitamins</skos:altLabel>
		<skos:altLabel xml:lang="en">Neurobion</skos:altLabel>
		<skos:altLabel xml:lang="en">Vitamin B group product</skos:altLabel>
		<skos:altLabel xml:lang="fr">Vitamine B</skos:altLabel>
		<skos:altLabel xml:lang="fr">vitamines B</skos:altLabel>
		<skos:definition xml:lang="en">A group of water-soluble vitamins, some of which are COENZYMES. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">groupe de vitamines solubles-d'eau, dont certaines sont ¤slCOENZYMES¤sl. (source : CISMeF)</skos:definition>
