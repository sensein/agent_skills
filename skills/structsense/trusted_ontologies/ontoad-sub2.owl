	<owl:Class rdf:about="&OntoAD;C0772415">
		<skos:prefLabel xml:lang="en">Rivastigmine tartrate</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">RivastigmineTartrate</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">rivastigmine (as rivastigmine tatrate)</skos:altLabel>
		<skos:altLabel xml:lang="en">Carbamic Acid, Ethylmethyl-, 3-((1S)-1-(dimethylamino)ethyl)phenyl Ester,(2R,3R)-2,3-dihydroxybutane</skos:altLabel>
		<skos:altLabel xml:lang="en">Rivastigmine hydrogen tartrate</skos:altLabel>
		<skos:definition xml:lang="en">The tartrate salt form of rivastigmine, a phenylcarbamate derivative exhibiting cognitive stimulating property. Although the mechanism of action has not been fully elucidated, rivastigmine tartrate may bind reversibly to cholinesterase, thereby decreasing the breakdown of acetylcholine and enhancing cholinergic function. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0649350"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0002395"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0020517"/>
	</owl:Class>

