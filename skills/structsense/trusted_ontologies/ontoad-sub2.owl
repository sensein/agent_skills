		<skos:altLabel xml:lang="fr">muscle strié, SAI</skos:altLabel>
		<skos:altLabel xml:lang="fr">musculaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">muscle du squelette, SAI</skos:altLabel>
		<skos:definition xml:lang="en">One of two types of muscle in the body, characterized by the array of bands observed under microscope. Striated muscles can be divided into two subtypes: the CARDIAC MUSCLE and the SKELETAL MUSCLE. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0026845"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2328219"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C2328219">
