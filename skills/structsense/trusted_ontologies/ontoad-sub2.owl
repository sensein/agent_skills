		<OntoAD:disease_has_normal_cell_origin rdf:resource="&OntoAD;C1518293"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1334953">
		<skos:prefLabel xml:lang="en">Neuroblastic Tumor</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">NeuroblasticTumor</skos:hiddenLabel>
		<skos:definition xml:lang="en">A group of nervous system tumors which display neuronal differentiation. It includes tumors that are composed of immature round cells and tumors that display advanced differentiation and the formation of ganglion cells. (source : NCI)</skos:definition>
