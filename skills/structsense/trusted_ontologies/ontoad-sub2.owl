		<skos:altLabel xml:lang="en">HLA tissue typing</skos:altLabel>
		<skos:altLabel xml:lang="en">HLA Testing</skos:altLabel>
		<skos:altLabel xml:lang="en">Human leukocyte antigen (HLA) tissue typing</skos:altLabel>
