		<skos:hiddenLabel xml:lang="en">Study</skos:hiddenLabel>
		<skos:definition xml:lang="en">A detailed examination, analysis, or critical inspection of a subject designed to discover facts about it. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0242481"/>
	</owl:Class>

