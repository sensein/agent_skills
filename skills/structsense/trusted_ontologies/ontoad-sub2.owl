		<skos:altLabel xml:lang="fr">Criblage d'association pan-génomique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Étude d'association pan-génomique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Analyse d'association génétique</skos:altLabel>
