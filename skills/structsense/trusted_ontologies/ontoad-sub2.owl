	<owl:Class rdf:about="&OntoAD;C0011305">
		<skos:prefLabel xml:lang="en">Dendrites</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Dendrites</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Dendrites</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Dendrites</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Dendritic</skos:altLabel>
		<skos:altLabel xml:lang="en">Dendrite</skos:altLabel>
		<skos:altLabel xml:lang="fr">Dendrite</skos:altLabel>
		<skos:altLabel xml:lang="fr">Prolongements dendritiques</skos:altLabel>
		<skos:definition xml:lang="en">Extensions of the nerve cell body. They are short and branched and receive stimuli from other NEURONS. (source : MSH)</skos:definition>
