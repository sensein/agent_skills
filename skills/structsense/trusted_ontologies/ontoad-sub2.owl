	<owl:Class rdf:about="&OntoAD;C0008377">
		<skos:prefLabel xml:lang="en">Cholesterol</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Cholesterol</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Cholestérol</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Cholestérol</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Cholest-5-en-3-ol (3beta)-</skos:altLabel>
		<skos:definition xml:lang="en">The principal sterol of all higher animals, distributed in body tissues, especially the brain and spinal cord, and in animal fats and oils. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr"> Principale graisse circulant dans le sang. Elle est utilisée dans l'organisme comme matière première, notamment pour l'enveloppe des cellules et pour la synthèse des hormones stéroïdes. En excès, le cholestérol est éliminé dans la bile, mais il peut également s'accumuler dans les artères et former des plaques d'athérome. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0038317"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0038323"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2348285"/>
