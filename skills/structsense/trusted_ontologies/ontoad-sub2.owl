	<owl:Class rdf:about="&OntoAD;C0031307">
		<skos:prefLabel xml:lang="en">Phagocytes</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Phagocytes</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Phagocytes</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Phagocytes</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Phagocytic Cell</skos:altLabel>
		<skos:altLabel xml:lang="en">amebocyte</skos:altLabel>
		<skos:altLabel xml:lang="fr">Phagocyte</skos:altLabel>
		<skos:altLabel xml:lang="fr">cellule phagocytaire</skos:altLabel>
