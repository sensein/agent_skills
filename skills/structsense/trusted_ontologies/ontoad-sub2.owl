	<owl:Class rdf:about="&OntoAD;C1704799">
		<skos:prefLabel xml:lang="en">BCR wt Allele</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">BCRWtAllele</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">CML</skos:altLabel>
		<skos:altLabel xml:lang="en">ALL</skos:altLabel>
		<skos:altLabel xml:lang="en">BCR1</skos:altLabel>
		<skos:altLabel xml:lang="en">D22S11</skos:altLabel>
		<skos:altLabel xml:lang="en">D22S662</skos:altLabel>
		<skos:altLabel xml:lang="en">PHL</skos:altLabel>
		<skos:altLabel xml:lang="en">Breakpoint Cluster Region wt Allele</skos:altLabel>
		<skos:definition xml:lang="en">Human BCR wild-type allele is located in the vicinity of 22q11.23 and is approximately 138 kb in length. This allele, which encodes breakpoint cluster region protein, is involved in promoting the activating exchange of GTP for GDP bound by p21rac or CDC42. The BCR gene forms fusion genes with ABL1 or FGFR1 in chronic myeloid leukemia (CML) and with PDGFRA in a CML-like myeloproliferative disease. The BCR-ABL fusion gene is found in acute myeloid leukemia and acute lymphoblastic leukemia. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0812385"/>
		<OntoAD:gene_associated_with_disease rdf:resource="&OntoAD;C0023449"/>
		<OntoAD:gene_plays_role_in_process rdf:resource="&OntoAD;C0031715"/>
		<OntoAD:gene_plays_role_in_process rdf:resource="&OntoAD;C0037083"/>
		<OntoAD:gene_found_in_organism rdf:resource="&OntoAD;C0086418"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1961102">
		<skos:prefLabel xml:lang="en">Precursor Cell Lymphoblastic Leukemia Lymphoma</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">PrecursorCellLymphoblasticLeukemiaLymphoma</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Leucémie-lymphome lymphoblastique à précurseurs B et T</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Leucémie-lymphomeLymphoblastiqueÀPrécurseursBEtT</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Leukemia, Lymphoid, Acute</skos:altLabel>
		<skos:altLabel xml:lang="en">Lymphocytic Leukemia, Acute</skos:altLabel>
		<skos:altLabel xml:lang="en">Leukemia, Lymphoblastic</skos:altLabel>
		<skos:altLabel xml:lang="en">Leukemia, Lymphoblastic, Acute</skos:altLabel>
		<skos:altLabel xml:lang="en">Lymphoblastic Lymphoma</skos:altLabel>
		<skos:altLabel xml:lang="en">ALL</skos:altLabel>
		<skos:altLabel xml:lang="en">ALL1</skos:altLabel>
		<skos:altLabel xml:lang="en">Precursor cell lymphoblastic leukemia</skos:altLabel>
		<skos:altLabel xml:lang="en">Acute lymphoblastic leukemia, precursor-cell type</skos:altLabel>
		<skos:altLabel xml:lang="en">Precursor cell lymphoblastic leukemia, not phenotyped</skos:altLabel>
		<skos:altLabel xml:lang="en">Precursor cell lymphoblastic leukemia, no ICD-O subtype</skos:altLabel>
		<skos:altLabel xml:lang="en">Precursor Cell Lymphoblastic Leukemia-Lymphoma</skos:altLabel>
		<skos:altLabel xml:lang="fr">Lymphome lymphoblastique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Leucémie lymphoblastique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Leucémie lymphoblastique aiguë</skos:altLabel>
		<skos:altLabel xml:lang="fr">Leucémie aigüe lymphoblastique</skos:altLabel>
		<skos:altLabel xml:lang="fr">LAL (Leucémie Aigüe Lymphoblastique)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Leucémie lymphoblastique aigüe</skos:altLabel>
		<skos:altLabel xml:lang="fr">Leucémie-lymphome lymphoblastique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Leucémie-lymphome à précurseurs lymphoblastiques</skos:altLabel>
		<skos:definition xml:lang="en">A neoplasm characterized by abnormalities of the lymphoid cell precursors leading to excessive lymphoblasts in the marrow and other organs. It is the most common cancer in children and accounts for the vast majority of all childhood leukemias. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0023449"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1531702"/>
		<OntoAD:may_be_treated_by rdf:resource="&OntoAD;C0000618"/>
	</owl:Class>

