		<skos:altLabel xml:lang="en">Feeling high</skos:altLabel>
		<skos:altLabel xml:lang="en">emotionally high</skos:altLabel>
		<skos:altLabel xml:lang="en">Euphoric</skos:altLabel>
		<skos:altLabel xml:lang="en">mood euphoric</skos:altLabel>
		<skos:altLabel xml:lang="fr">SENSATION DE BONHEUR ANORMALE</skos:altLabel>
		<skos:altLabel xml:lang="fr">Humeur euphorique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Euphorique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Sensation d'euphorie</skos:altLabel>
		<skos:altLabel xml:lang="fr">A éprouvé un sentiment d'euphorie</skos:altLabel>
		<skos:altLabel xml:lang="fr">Sentiment d'euphorie</skos:altLabel>
		<skos:definition xml:lang="en">An exaggerated feeling of physical and emotional well-being not consonant with apparent stimuli or events; usually of psychologic origin, but also seen in organic brain disease and toxic states. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2232697"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0233492"/>
