	<owl:Class rdf:about="&OntoAD;C1336799">
		<skos:prefLabel xml:lang="en">Transferase Gene</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">TransferaseGene</skos:hiddenLabel>
		<skos:definition xml:lang="en">Transferase Genes encode enzymes (Transferases) that transfer a group, such as a methyl group or a glycosyl group, from one compound (donor) to another (acceptor). (NCI) (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1333402"/>
