		<rdfs:subClassOf rdf:resource="&OntoAD;C0008972"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1510859">
		<skos:prefLabel xml:lang="en">Allied Health Profession</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AlliedHealthProfession</skos:hiddenLabel>
		<skos:definition xml:lang="en">Professional health-care providers who are not physicians, especially medical assistants, technicians, and therapists but not nurses. (dictionary.com) (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0028811"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1519808">
		<skos:prefLabel xml:lang="en">Unlicensed Assistive Personnel</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">UnlicensedAssistivePersonnel</skos:hiddenLabel>
		<skos:definition xml:lang="en">Personnel trained to assist with the direct care of patients in all health settings and in the home. Unlicensed Assistive Personnel work under the direct supervision of RNs to extend the abilities of the nurse to provide for patients' activities of daily living. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1510859"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0018100">
		<skos:prefLabel xml:lang="en">Gout Suppressants</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">GoutSuppressants</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Antigoutteux</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Antigoutteux</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Antigout Agents</skos:altLabel>
		<skos:altLabel xml:lang="en">gout drug</skos:altLabel>
		<skos:altLabel xml:lang="en">Drugs for the treatment of gout</skos:altLabel>
		<skos:altLabel xml:lang="en">Anti-gout agent</skos:altLabel>
		<skos:altLabel xml:lang="fr">Anti-goutteux</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments de la goutte</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments anti-goutte</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments antigoutteux</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents antigoutteux</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents anti-goutte</skos:altLabel>
		<skos:definition xml:lang="en">Agents that increase uric acid excretion by the kidney (URICOSURIC AGENTS), decrease uric acid production (antihyperuricemics), or alleviate the pain and inflammation of acute attacks of gout. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1298773"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0360271"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0018099"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0041983">
		<skos:prefLabel xml:lang="en">Uricosuric Agents</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">UricosuricAgents</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Uricosuriques</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Uricosuriques</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Uricosuric agent</skos:altLabel>
		<skos:altLabel xml:lang="en">Uricosuric product</skos:altLabel>
		<skos:altLabel xml:lang="en">Hyperuricaemia Agents</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents uricosuriques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments uricosuriques</skos:altLabel>
		<skos:altLabel xml:lang="fr">agent uricosurique</skos:altLabel>
		<skos:definition xml:lang="en">Gout suppressants that act directly on the renal tubule to increase the excretion of uric acid, thus reducing its concentrations in plasma. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0018100"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0033613"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0012798"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0302609">
		<skos:prefLabel xml:lang="en">Xanthine Oxidase Inhibitors</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">XanthineOxidaseInhibitors</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Xanthine oxidase inhibitor</skos:altLabel>
		<skos:definition xml:lang="en">any substance or agent which suppresses, prevents or opposes the action of xanthine oxidase. (source : CSP)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0919438"/>
	</owl:Class>

