	<owl:Class rdf:about="&OntoAD;C0038317">
		<skos:prefLabel xml:lang="en">Steroids</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Steroids</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Stéroïdes</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Stéroïdes</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Steroid</skos:altLabel>
		<skos:altLabel xml:lang="en">Steroid Compound</skos:altLabel>
		<skos:altLabel xml:lang="fr">hormone stéroïde</skos:altLabel>
		<skos:altLabel xml:lang="fr">stéroïde</skos:altLabel>
		<skos:definition xml:lang="en">A group of polycyclic compounds closely related biochemically to TERPENES. They include cholesterol, numerous hormones, precursors of certain vitamins, bile acids, alcohols (STEROLS), and certain natural drugs and poisons. Steroids have a common nucleus, a fused, reduced 17-carbon atom ring system, cyclopentanoperhydrophenanthrene. Most steroids also have two methyl groups and an aliphatic side-chain attached to the nucleus. (From Hawley's Condensed Chemical Dictionary, 11th ed) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0023779"/>
		<OntoAD:chemical_or_drug_is_product_of_biological_process rdf:resource="&OntoAD;C0597520"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0038323">
		<skos:prefLabel xml:lang="en">Sterols</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Sterols</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Stérols</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Stérols</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Sterol</skos:altLabel>
		<skos:altLabel xml:lang="fr">stérol</skos:altLabel>
		<skos:definition xml:lang="en">Steroids with a hydroxyl group at C-3 and most of the skeleton of cholestane. Additional carbon atoms may be present in the side chain. (IUPAC Steroid Nomenclature, 1987) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0023779"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C2348284">
		<skos:prefLabel xml:lang="en">Dietary Steroid</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">DietarySteroid</skos:hiddenLabel>
		<skos:definition xml:lang="en">Any substance found in the diet, comprising a terpenoid characterized by a conjugated carbon structure of four rings: three cyclohexane rings and one cyclopentane ring. Individual steroids vary by the functional groups attached to these rings and by the oxidation state of the rings. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0012171"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C2348285">
		<skos:prefLabel xml:lang="en">Dietary Sterol</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">DietarySterol</skos:hiddenLabel>
		<skos:definition xml:lang="en">Any substance found in the diet, comprising a cholestane skeleton with a hydroxyl group at the position C-3. They occur naturally in plants, animals and fungi. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2348284"/>
	</owl:Class>

