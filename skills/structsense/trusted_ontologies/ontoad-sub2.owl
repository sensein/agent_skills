		<skos:altLabel xml:lang="en">Autoimmune Status</skos:altLabel>
		<skos:altLabel xml:lang="fr">Maladie auto-immune</skos:altLabel>
		<skos:altLabel xml:lang="fr">Autoimmunité</skos:altLabel>
		<skos:altLabel xml:lang="fr">état auto-immunitaire</skos:altLabel>
		<skos:definition xml:lang="en">Process whereby the immune system reacts against the body's own tissues. Autoimmunity may produce or be caused by AUTOIMMUNE DISEASES. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0018759"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
	</owl:Class>

