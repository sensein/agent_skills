		<skos:altLabel xml:lang="en">SPECT imaging</skos:altLabel>
		<skos:altLabel xml:lang="en">Single photon emission computerised tomogram</skos:altLabel>
		<skos:altLabel xml:lang="en">Single photon emission computed tomography  action</skos:altLabel>
		<skos:altLabel xml:lang="en">Single photon emission computerized tomography</skos:altLabel>
		<skos:altLabel xml:lang="en">Medical Imaging, Single Photon Emission Computed Tomography</skos:altLabel>
