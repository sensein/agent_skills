		<skos:hiddenLabel xml:lang="en">Syncope</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Syncope</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Syncope</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">death</skos:altLabel>
		<skos:altLabel xml:lang="en">Fainting</skos:altLabel>
		<skos:altLabel xml:lang="en">Faintness</skos:altLabel>
		<skos:altLabel xml:lang="en">Syncope and collapse</skos:altLabel>
		<skos:altLabel xml:lang="en">FAINTING EPISODES</skos:altLabel>
		<skos:altLabel xml:lang="en">Collapse fleeting</skos:altLabel>
		<skos:altLabel xml:lang="en">COLLAPSE TRANSIENT</skos:altLabel>
		<skos:altLabel xml:lang="en">FALLING OUT</skos:altLabel>
		<skos:altLabel xml:lang="en">Passed out</skos:altLabel>
		<skos:altLabel xml:lang="en">SWOONING</skos:altLabel>
		<skos:altLabel xml:lang="en">Syncope symptom</skos:altLabel>
		<skos:altLabel xml:lang="en">A faint</skos:altLabel>
		<skos:altLabel xml:lang="en">fainting (syncope)</skos:altLabel>
		<skos:altLabel xml:lang="en">Syncope attack</skos:altLabel>
