		<skos:altLabel xml:lang="en">Arteria cerebri posterior</skos:altLabel>
		<skos:altLabel xml:lang="fr">artère cérébrale postérieure, SAI</skos:altLabel>
		<skos:definition xml:lang="en">Artery formed by the bifurcation of the BASILAR ARTERY. Branches of the posterior cerebral artery supply portions of the OCCIPITAL LOBE; PARIETAL LOBE; inferior temporal gyrus, brainstem, and CHOROID PLEXUS. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0007770"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1185381"/>
		<OntoAD:anatomic_structure_is_physical_part_of rdf:resource="&OntoAD;C0228174"/>
		<OntoAD:anatomic_structure_has_location rdf:resource="&OntoAD;C0037303"/>
		<OntoAD:regional_part_of rdf:resource="&OntoAD;C0004811"/>
	</owl:Class>

