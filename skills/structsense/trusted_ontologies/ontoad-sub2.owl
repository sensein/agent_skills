	<owl:Class rdf:about="&OntoAD;C0242912">
		<skos:prefLabel xml:lang="en">Neuroprotective Agents</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">NeuroprotectiveAgents</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Neuroprotecteurs</skos:prefLabel>
