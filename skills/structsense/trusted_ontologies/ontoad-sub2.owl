	<owl:Class rdf:about="&OntoAD;C0002763">
		<skos:prefLabel xml:lang="en">Central Nervous System Stimulants</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CentralNervousSystemStimulants</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Stimulants du système nerveux central</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">StimulantsDuSystèmeNerveuxCentral</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Analeptics</skos:altLabel>
		<skos:altLabel xml:lang="en">Central Stimulants</skos:altLabel>
		<skos:altLabel xml:lang="en">CNS STIMULANTS</skos:altLabel>
		<skos:altLabel xml:lang="en">Analeptic Agent</skos:altLabel>
		<skos:altLabel xml:lang="en">Stimulant</skos:altLabel>
		<skos:altLabel xml:lang="en">CNS Stimulating Drugs</skos:altLabel>
		<skos:altLabel xml:lang="en">ergogenics</skos:altLabel>
		<skos:altLabel xml:lang="en">Central stimulant</skos:altLabel>
		<skos:altLabel xml:lang="en">Central Nervous System Stimulant</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments stimulants du SNC</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents stimulants du système nerveux central</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents stimulants du SNC</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments stimulants du système nerveux central</skos:altLabel>
		<skos:altLabel xml:lang="fr">Stimulants du SNC</skos:altLabel>
		<skos:altLabel xml:lang="fr">stimulant respiratoire et cérébral</skos:altLabel>
		<skos:altLabel xml:lang="fr">stimulant du système nerveux central</skos:altLabel>
		<skos:definition xml:lang="en">A loosely defined group of drugs that tend to increase behavioral alertness, agitation, or excitation. They work by a variety of mechanisms, but usually not by direct excitation of neurons. The many drugs that have such actions as side effects to their main therapeutic use are not included here. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2697973"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0304403"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2064865"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0003592">
		<skos:prefLabel xml:lang="en">Apolipoproteins A</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">ApolipoproteinsA</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Apolipoprotéines A</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ApolipoprotéinesA</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Apo-A</skos:altLabel>
		<skos:altLabel xml:lang="en">Apolipoprotein A</skos:altLabel>
		<skos:altLabel xml:lang="en">ApoA</skos:altLabel>
		<skos:altLabel xml:lang="fr">Apolipoprotéine A</skos:altLabel>
		<skos:altLabel xml:lang="fr">Apo-A</skos:altLabel>
		<skos:altLabel xml:lang="fr">ApoA</skos:altLabel>
		<skos:altLabel xml:lang="fr">Apolipoprotéines de type A</skos:altLabel>
		<skos:definition xml:lang="en">Structural proteins of the alpha-lipoproteins (HIGH DENSITY LIPOPROTEINS), including APOLIPOPROTEIN A-I and APOLIPOPROTEIN A-II. They can modulate the activity of LECITHIN CHOLESTEROL ACYLTRANSFERASE. These apolipoproteins are low in atherosclerotic patients. They are either absent or present in extremely low plasma concentration in TANGIER DISEASE. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003591"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0004782">
		<skos:prefLabel xml:lang="en">Basal Ganglia Diseases</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">BasalGangliaDiseases</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Affections des ganglions de la base</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AffectionsDesGanglionsDeLaBase</skos:hiddenLabel>
