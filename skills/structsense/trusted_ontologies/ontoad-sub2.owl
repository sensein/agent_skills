	<owl:Class rdf:about="&OntoAD;C0301819">
		<skos:prefLabel xml:lang="en">Gonadal Hormones</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">GonadalHormones</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Hormones gonadiques</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">HormonesGonadiques</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Gonadal hormone</skos:altLabel>
		<skos:altLabel xml:lang="fr">hormone gonadique</skos:altLabel>
		<skos:definition xml:lang="en">Hormones produced by the GONADS, including both steroid and peptide hormones. The major steroid hormones include ESTRADIOL and PROGESTERONE from the OVARY, and TESTOSTERONE from the TESTIS. The major peptide hormones include ACTIVINS and INHIBINS. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0019932"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0036884">
		<skos:prefLabel xml:lang="en">Gonadal Steroid Hormones</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">GonadalSteroidHormones</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Hormones sexuelles stéroïdiennes</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">HormonesSexuellesStéroïdiennes</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Sex Hormones</skos:altLabel>
		<skos:altLabel xml:lang="en">Sex hormone chemical</skos:altLabel>
		<skos:altLabel xml:lang="en">Sex hormone product</skos:altLabel>
		<skos:altLabel xml:lang="en">gonadal steroids</skos:altLabel>
		<skos:altLabel xml:lang="en">Sex Steroid Hormones</skos:altLabel>
		<skos:altLabel xml:lang="en">Sex hormone</skos:altLabel>
		<skos:altLabel xml:lang="fr">Hormones sexuelles</skos:altLabel>
		<skos:altLabel xml:lang="fr">Hormones stéroïdiennes gonadiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Hormones stéroïdiennes sexuelles</skos:altLabel>
		<skos:altLabel xml:lang="fr">Stéroïdes sexuels</skos:altLabel>
		<skos:altLabel xml:lang="fr">Hormones sexuelles gonadiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Hormones stéroïdes gonadiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Hormones stéroïdes sexuelles</skos:altLabel>
		<skos:definition xml:lang="en">Steroid hormones produced by the GONADS. They stimulate reproductive organs, germ cell maturation, and the secondary sex characteristics in the males and the females. The major sex steroid hormones include ESTRADIOL; PROGESTERONE; and TESTOSTERONE. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0301818"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0019928"/>
	</owl:Class>

