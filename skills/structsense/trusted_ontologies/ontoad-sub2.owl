		<skos:altLabel xml:lang="en">CA INHIB EXOGENOUS</skos:altLabel>
		<skos:altLabel xml:lang="en">CA CHANNEL BLOCK</skos:altLabel>
		<skos:altLabel xml:lang="en">CA ANTAG EXOGENOUS</skos:altLabel>
		<skos:altLabel xml:lang="fr">Inhibiteurs des canaux calciques exogènes</skos:altLabel>
		<skos:altLabel xml:lang="fr">Antagonistes calciques exogènes</skos:altLabel>
		<skos:altLabel xml:lang="fr">Inhibiteurs calciques</skos:altLabel>
