	<owl:Class rdf:about="&OntoAD;C0003062">
		<skos:prefLabel xml:lang="en">Animals</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Animals</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Animaux</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Animaux</skos:hiddenLabel>
