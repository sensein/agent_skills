		<skos:altLabel xml:lang="fr">Réseau de soutien social</skos:altLabel>
		<skos:altLabel xml:lang="fr">Réseaux de soutien social</skos:altLabel>
		<skos:definition xml:lang="en">A formal or informal linkage, association, or network of individuals or groups that share common interests, contacts, knowledge, or resources. Compare SOCIAL SUPPORT NETWORKS and SUPPORT GROUPS. (source : PSY)</skos:definition>
		<skos:definition xml:lang="fr">soutien proposant aide et encouragement aux individus diminués sur le plan physique ou émotionnel afin qu'ils puissent mieux faire face. L'appui social informel est habituellement fourni par des amis, des parents, ou des pairs, alors que l'aide formelle est fournie par des églises, des groupes, etc (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;PopulationGroup"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0026896">
