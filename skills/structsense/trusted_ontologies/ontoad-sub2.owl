	<owl:Class rdf:about="&OntoAD;C0008217">
		<skos:prefLabel xml:lang="en">Chlormerodrin</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Chlormerodrin</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Chlormérodrine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Chlormérodrine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Chlormeroprin</skos:altLabel>
		<skos:altLabel xml:lang="en">Promeran</skos:altLabel>
		<skos:altLabel xml:lang="en">Mercury, (3-((aminocarbonyl)amino)-2-methoxypropyl-C1,O3)chloro-</skos:altLabel>
		<skos:altLabel xml:lang="en">Chlormerodrin  chemical</skos:altLabel>
		<skos:definition xml:lang="en">A mercurial compound that has been used as a diuretic but is now superseded by more potent and less toxic drugs. The radiolabeled form has been used as a diagnostic and research tool. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0012799"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0025397">
		<skos:prefLabel xml:lang="en">Merbromin</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Merbromin</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Merbromine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Merbromine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Merbromine</skos:altLabel>
		<skos:altLabel xml:lang="en">Mercury, (2',7'-dibromo-3',6'-dihydroxy-3-oxospiro(isobenzofuran-1(3H),9'-(9H)xanthen)-4'-yl)hydroxy</skos:altLabel>
		<skos:definition xml:lang="en">A once-popular mercury containing topical antiseptic. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003205"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0358213"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0304580"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0031488">
		<skos:prefLabel xml:lang="en">Phenylmercuric Acetate</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">PhenylmercuricAcetate</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Acétate phénylmercure</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AcétatePhénylmercure</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Acetoxyphenylmercury</skos:altLabel>
		<skos:altLabel xml:lang="en">Mercury, (acetato-O)phenyl-</skos:altLabel>
		<skos:altLabel xml:lang="en">Phenyl mercuric acetate</skos:altLabel>
		<skos:altLabel xml:lang="en">vaginal preparations phenylmercuric acetate</skos:altLabel>
		<skos:altLabel xml:lang="fr">acétate mercurique de phényle</skos:altLabel>
		<skos:definition xml:lang="en">A phenyl mercury compound used mainly as a fungicide. Has also been used as a herbicide, slimicide, and bacteriocide. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0392419"/>
