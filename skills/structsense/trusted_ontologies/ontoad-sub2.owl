		<skos:altLabel xml:lang="en">voice changed</skos:altLabel>
		<skos:definition xml:lang="en">Change in the sound and/or speed of the voice. Causes include laryngeal polyp, laryngitis, laryngeal carcinoma, throat carcinoma, Parkinson's disease, multiple sclerosis, stroke, hypothyroidism, oral surgery, tracheostomy, tracheal injury, and laryngeal injury. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1457887"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0042943"/>
