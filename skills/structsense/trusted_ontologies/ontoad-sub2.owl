		<skos:altLabel xml:lang="en">public health medicine</skos:altLabel>
		<skos:altLabel xml:lang="en">PUBLICHEALTH</skos:altLabel>
		<skos:definition xml:lang="en">Branch of medicine concerned with the prevention and control of disease and disability, and the promotion of physical and mental health of the population on the international, national, state, or municipal level. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">branche de la médecine traitant la prévention et le contrôle des maladies et infirmités et la promotion des santés mentales et physiques de la population au niveau international, national, public, ou municipal. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;BiomedicalOccupationOrDiscipline"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0036581">
		<skos:prefLabel xml:lang="en">Selenium</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Selenium</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Sélénium</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Sélénium</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Selenium product</skos:altLabel>
		<skos:altLabel xml:lang="en">Se  Selenium</skos:altLabel>
		<skos:altLabel xml:lang="en">Se element</skos:altLabel>
		<skos:altLabel xml:lang="en">mineral supplements selenium</skos:altLabel>
		<skos:definition xml:lang="en">An element with the atomic symbol Se, atomic number 34, and atomic weight 78.96. It is an essential micronutrient for mammals and other animals but is toxic in large amounts. Selenium protects intracellular structures against oxidative damage. It is an essential component of GLUTATHIONE PEROXIDASE. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003402"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0011625"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0040577"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2145047"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1254347"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013182"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0074393">
