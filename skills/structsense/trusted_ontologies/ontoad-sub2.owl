		<skos:altLabel xml:lang="en">TNFSF10</skos:altLabel>
		<skos:altLabel xml:lang="en">TRAIL</skos:altLabel>
		<skos:altLabel xml:lang="en">APO2L/TRAIL</skos:altLabel>
		<skos:altLabel xml:lang="en">TNF Superfamily, Member 10</skos:altLabel>
