		<skos:altLabel xml:lang="fr">ESPT</skos:altLabel>
		<skos:altLabel xml:lang="fr">TSPT</skos:altLabel>
		<skos:altLabel xml:lang="fr">États de stress post-traumatique</skos:altLabel>
		<skos:altLabel xml:lang="fr">SSPT</skos:altLabel>
		<skos:altLabel xml:lang="fr">état de stress post-traumatique</skos:altLabel>
		<skos:definition xml:lang="en">A class of traumatic stress disorders with symptoms that last more than one month. There are various forms of post-traumatic stress disorder, depending on the time of onset and the duration of these stress symptoms. In the acute form, the duration of the symptoms is between 1 to 3 months. In the chronic form, symptoms last more than 3 months. With delayed onset, symptoms develop more than 6 months after the traumatic event. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003469"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:has_definitional_manifestation rdf:resource="&OntoAD;C0003467"/>
		<OntoAD:may_be_treated_by rdf:resource="&OntoAD;C0023870"/>
		<OntoAD:may_be_treated_by rdf:resource="&OntoAD;C0070122"/>
		<OntoAD:may_be_treated_by rdf:resource="&OntoAD;C0074393"/>
	</owl:Class>

