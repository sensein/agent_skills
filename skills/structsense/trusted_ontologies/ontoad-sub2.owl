		<skos:altLabel xml:lang="en">Fetuin-A</skos:altLabel>
		<skos:altLabel xml:lang="fr">Fétuine-A</skos:altLabel>
		<skos:altLabel xml:lang="fr">alpha2 Heremans-Schmid glycoprotéine</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine AHSG</skos:altLabel>
		<skos:altLabel xml:lang="fr">alpha-2HS glycoprotéine</skos:altLabel>
		<skos:altLabel xml:lang="fr">alpha(2) HS glycoprotéine</skos:altLabel>
		<skos:altLabel xml:lang="fr">alpha2HS glycoprotéine</skos:altLabel>
		<skos:altLabel xml:lang="fr">alpha2 HS glycoprotéine</skos:altLabel>
		<skos:definition xml:lang="en">A fetuin subtype that is synthesized by HEPATOCYTES and secreted into the circulation. It plays a major role in preventing CALCIUM precipitation in the BLOOD. (source : MSH)</skos:definition>
