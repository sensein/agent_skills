	<owl:Class rdf:about="&OntoAD;C0033634">
		<skos:prefLabel xml:lang="en">Protein Kinase C</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">ProteinKinaseC</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Protéine kinase C</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ProtéineKinaseC</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Calcium-Activated Phospholipid-Dependent Kinase</skos:altLabel>
		<skos:altLabel xml:lang="en">Calcium Phospholipid-Dependent Protein Kinase</skos:altLabel>
		<skos:altLabel xml:lang="en">Phospholipid-Sensitive Calcium-Dependent Protein Kinase</skos:altLabel>
		<skos:altLabel xml:lang="en">Calcium phospholipid protein kinase</skos:altLabel>
		<skos:altLabel xml:lang="en">PKC Serine-Threonine Kinase</skos:altLabel>
		<skos:altLabel xml:lang="en">PKC</skos:altLabel>
		<skos:altLabel xml:lang="en">EC 2.7.11.13</skos:altLabel>
		<skos:altLabel xml:lang="en">protein kinase C (PKC)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine kinase dépendante du calcium et des phospholipides</skos:altLabel>
		<skos:altLabel xml:lang="fr">PKC Serine-Threonine Kinase</skos:altLabel>
		<skos:definition xml:lang="en">An serine-threonine protein kinase that requires the presence of physiological concentrations of CALCIUM and membrane PHOSPHOLIPIDS. The additional presence of DIACYLGLYCEROLS markedly increases its sensitivity to both calcium and phospholipids. The sensitivity of the enzyme can also be increased by PHORBOL ESTERS and it is believed that protein kinase C is the receptor protein of tumor-promoting phorbol esters. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0033640"/>
		<OntoAD:gene_product_is_biomarker_type rdf:resource="&OntoAD;C0005516"/>
		<OntoAD:gene_product_plays_role_in_biological_process rdf:resource="&OntoAD;C0037083"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0072402"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0026454">
		<skos:prefLabel xml:lang="en">Monoamine Oxidase</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">MonoamineOxidase</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Monoamine oxidase</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">MonoamineOxidase</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Amine oxidase</skos:altLabel>
		<skos:altLabel xml:lang="en">Tyramine Oxidase</skos:altLabel>
		<skos:altLabel xml:lang="en">Amine Oxidase (Flavin-Containing)</skos:altLabel>
		<skos:altLabel xml:lang="en">MAO</skos:altLabel>
		<skos:altLabel xml:lang="en">Amine:oxygen oxidoreductase (deaminating) (flavin-containing)</skos:altLabel>
		<skos:altLabel xml:lang="en">Adrenaline oxidase</skos:altLabel>
		<skos:altLabel xml:lang="en">MAO  Monoamine oxidase</skos:altLabel>
		<skos:altLabel xml:lang="en">Tyraminase</skos:altLabel>
		<skos:altLabel xml:lang="en">amine oxidase (flavin)</skos:altLabel>
		<skos:altLabel xml:lang="en">adrenalin oxidase</skos:altLabel>
		<skos:altLabel xml:lang="en">Epinephrine oxidase</skos:altLabel>
		<skos:altLabel xml:lang="fr">MAO</skos:altLabel>
		<skos:altLabel xml:lang="fr">Adrenaline oxidase</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tyraminase</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tyramine oxidase</skos:altLabel>
		<skos:altLabel xml:lang="fr">amine oxydase (contenant flavine)</skos:altLabel>
		<skos:altLabel xml:lang="fr">monoamine oxydase</skos:altLabel>
		<skos:altLabel xml:lang="fr">tyramine oxydase</skos:altLabel>
		<skos:altLabel xml:lang="fr">amine oxydase</skos:altLabel>
		<skos:altLabel xml:lang="fr">adrénaline oxydase</skos:altLabel>
		<skos:definition xml:lang="en">An enzyme that catalyzes the oxidative deamination of naturally occurring monoamines. It is a flavin-containing enzyme that is localized in mitochondrial membranes, whether in nerve terminals, the liver, or other organs. Monoamine oxidase is important in regulating the metabolic degradation of catecholamines and serotonin in neural or target tissues. Hepatic monoamine oxidase has a crucial defensive role in inactivating circulating monoamines or those, such as tyramine, that originate in the gut (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0030016"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0242417"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0022709">
		<skos:prefLabel xml:lang="en">Peptidyl-Dipeptidase A</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Peptidyl-DipeptidaseA</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Peptidyl-Dipeptidase A</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Peptidyl-DipeptidaseA</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Angiotensin Converting Enzyme</skos:altLabel>
		<skos:altLabel xml:lang="en">Angiotensin I-Converting Enzyme</skos:altLabel>
		<skos:altLabel xml:lang="en">Carboxycathepsin</skos:altLabel>
		<skos:altLabel xml:lang="en">dipeptidyl peptidase</skos:altLabel>
