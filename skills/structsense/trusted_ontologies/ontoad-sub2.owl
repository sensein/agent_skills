	<owl:Class rdf:about="&OntoAD;C0039586">
		<skos:prefLabel xml:lang="en">Testicular Hormones</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">TesticularHormones</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Hormones testiculaires</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">HormonesTesticulaires</skos:hiddenLabel>
