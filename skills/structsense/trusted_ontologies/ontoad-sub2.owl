	<owl:Class rdf:about="&OntoAD;C0034196">
		<skos:prefLabel xml:lang="en">Pylorus</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Pylorus</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Pylore</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Pylore</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">pylori</skos:altLabel>
		<skos:altLabel xml:lang="en">Caudal one third of stomach</skos:altLabel>
		<skos:altLabel xml:lang="en">Pars pylorica gastris</skos:altLabel>
		<skos:altLabel xml:lang="en">Pars pylorica ventriculi</skos:altLabel>
		<skos:altLabel xml:lang="en">Pyloric portion of stomach</skos:altLabel>
		<skos:altLabel xml:lang="en">Pyloric</skos:altLabel>
		<skos:altLabel xml:lang="en">Pyloro-</skos:altLabel>
		<skos:altLabel xml:lang="en">Pyloric region of stomach</skos:altLabel>
		<skos:altLabel xml:lang="en">Pyloric structure of stomach</skos:altLabel>
		<skos:altLabel xml:lang="en">Pyloric part of stomach</skos:altLabel>
		<skos:altLabel xml:lang="en">Pylorus structure</skos:altLabel>
		<skos:altLabel xml:lang="en">Pars pylorica gastricae</skos:altLabel>
		<skos:altLabel xml:lang="fr">pylorique</skos:altLabel>
		<skos:altLabel xml:lang="fr">pyloro-</skos:altLabel>
		<skos:definition xml:lang="en">The region of the STOMACH at the junction with the DUODENUM. It is marked by the thickening of circular muscle layers forming the pyloric sphincter to control the opening and closure of the lumen. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">région de l'ESTOMAC à la jonction avec le DUODÉNUM. Il est marqué par l'épaississant de couches de muscle circulaires formant le pylorique sphincter pour contrôler l'ouverture et la fermeture du lumen. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;BodyPart,Organ,OrOrganComponent"/>
		<OntoAD:location_of rdf:resource="&OntoAD;C0005558"/>
		<OntoAD:location_of rdf:resource="&OntoAD;C1533685"/>
		<OntoAD:location_of rdf:resource="&OntoAD;C0940830"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0013072">
