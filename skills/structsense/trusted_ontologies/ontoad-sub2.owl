	<owl:Class rdf:about="&OntoAD;C0024337">
		<skos:prefLabel xml:lang="en">Lysine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Lysine</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Lysine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Lysine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">L-Lysine</skos:altLabel>
		<skos:altLabel xml:lang="en">Lys</skos:altLabel>
		<skos:altLabel xml:lang="en">L-LYSINE MONOHYDRATE</skos:altLabel>
		<skos:altLabel xml:lang="en">Lysine Monohydrate</skos:altLabel>
		<skos:altLabel xml:lang="en">L-alpha,epsilon-Diaminocaproic Acid</skos:altLabel>
		<skos:altLabel xml:lang="fr">L-Lysine</skos:altLabel>
		<skos:definition xml:lang="en">An essential amino acid. It is often added to animal feed. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0556082"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0002525"/>
