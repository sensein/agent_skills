		<skos:altLabel xml:lang="en">cardiac ischaemia</skos:altLabel>
		<skos:altLabel xml:lang="en">Coronary artery atherosclerosis</skos:altLabel>
		<skos:altLabel xml:lang="en">Coronary artery sclerosis</skos:altLabel>
		<skos:altLabel xml:lang="en">CORONARY ATHEROSCLEROTIC HEART DISEASE</skos:altLabel>
