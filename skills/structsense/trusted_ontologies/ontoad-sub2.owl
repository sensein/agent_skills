	<owl:Class rdf:about="&OntoAD;C0028580">
		<skos:prefLabel xml:lang="en">Nuclear Magnetic Resonance</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">NuclearMagneticResonance</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">RMN (Résonance magnétique nucléaire)</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">RMN(RésonanceMagnétiqueNucléaire)</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">magnetic resonance</skos:altLabel>
		<skos:altLabel xml:lang="en">Nuclear magnetic resonance (NMR)</skos:altLabel>
		<skos:altLabel xml:lang="en">NMR</skos:altLabel>
		<skos:altLabel xml:lang="fr">résonance magnétique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Résonance magnétique nucléaire</skos:altLabel>
		<skos:definition xml:lang="en">A physical phenomenon involving the interaction of atomic nuclei placed in an external magnetic field with an applied electromagnetic field oscillating at a particular frequency. Magnetic conditions within the material are measured by monitoring the radiation absorbed and emitted by the atomic nuclei. It is the underlying principle of Magnetic Resonance Imaging (MRI). (source : NCI)</skos:definition>
		<skos:definition xml:lang="fr">méthode spectroscopique pour mesurer le moment magnétique des particules élémentaires comme les nucléus atomiques, les protons ou les électrons. Elle est employée dans les applications cliniques comme la Tomographie NMR (IMAGERIE par RÉSONANCE MAGNÉTIQUE). (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;NaturalPhenomenonOrProcess"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0220825">
		<skos:prefLabel xml:lang="en">Evaluation</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Evaluation</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Évaluation</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Évaluation</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">assessment</skos:altLabel>
		<skos:altLabel xml:lang="en">estimates</skos:altLabel>
		<skos:altLabel xml:lang="en">effectiveness assessment</skos:altLabel>
		<skos:altLabel xml:lang="en">efficacy assessment</skos:altLabel>
		<skos:altLabel xml:lang="en">Assessment  action</skos:altLabel>
		<skos:altLabel xml:lang="en">Evaluation Procedure</skos:altLabel>
		<skos:altLabel xml:lang="en">Evaluate</skos:altLabel>
		<skos:altLabel xml:lang="fr">évaluations</skos:altLabel>
		<skos:definition xml:lang="en">Conceptually broad term referring to the appraisal of the characteristics, significance, importance, or relative value of a person, organization, or thing. (source : PSY)</skos:definition>
		<skos:definition xml:lang="fr">Etudes déterminant l'efficacité ou la valeur des processus, du personnel et de l'équipement ou le matériel pour entreprendre de telles études. Pour les médicaments et les appareils, on peut utiliser, essai clinique, évaluation médicament et évaluation préclinique. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C3266814"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0039082">
		<skos:prefLabel xml:lang="en">Syndrome</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Syndrome</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Syndrome</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Syndrome</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">syndromes</skos:altLabel>
		<skos:altLabel xml:lang="fr">syndromes</skos:altLabel>
		<skos:altLabel xml:lang="fr">présence de maladie ou de syndrome</skos:altLabel>
		<skos:altLabel xml:lang="fr">présence de syndrome ou de maladie clinique</skos:altLabel>
		<skos:altLabel xml:lang="fr">syndrome ou maladie clinique</skos:altLabel>
		<skos:definition xml:lang="en">A symptom complex of unknown etiology, that is characteristic of a particular abnormality. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Ensemble de symptômes (signes) fréquemment associés ; un syndrome grippal, par exemple, associe une fièvre élevée, des courbatures et un mal de tête. Un même syndrome peut être présent dans des maladies de causes différentes. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0012634"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1705180">
		<skos:prefLabel xml:lang="en">Recall (activity)</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Recall(activity)</skos:hiddenLabel>
		<skos:definition xml:lang="en">A removal or correction of a marketed product that the FDA considers to be in violation of the laws it administers and against which the agency would initiate legal action, such as seizure. A recall may be a voluntary action conducted by the manufacturer, by FDA request, or by FDA order under statutory authority. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1709895"/>
	</owl:Class>

