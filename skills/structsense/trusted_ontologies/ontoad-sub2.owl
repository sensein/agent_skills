	<owl:Class rdf:about="&OntoAD;C0009905">
		<skos:prefLabel xml:lang="en">Contraceptives, Oral</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Contraceptives,Oral</skos:hiddenLabel>
