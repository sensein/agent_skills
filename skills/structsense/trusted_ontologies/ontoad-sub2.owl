		<skos:altLabel xml:lang="en">Observational Trial</skos:altLabel>
		<skos:definition xml:lang="en">A type of study in which individuals are observed or certain outcomes are measured. No attempt is made to affect the outcome (for example, no treatment is given). (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0242481"/>
