		<skos:altLabel xml:lang="en">Visual disorder</skos:altLabel>
		<skos:altLabel xml:lang="en">Disorder sight</skos:altLabel>
		<skos:altLabel xml:lang="en">Visual system disorder</skos:altLabel>
		<skos:altLabel xml:lang="en">Visual Field Disorder</skos:altLabel>
		<skos:altLabel xml:lang="en">difficulty with vision</skos:altLabel>
		<skos:altLabel xml:lang="en">Dysfunction;vision</skos:altLabel>
		<skos:altLabel xml:lang="en">Disorder of vision</skos:altLabel>
		<skos:altLabel xml:lang="en">visual dysfunction</skos:altLabel>
		<skos:altLabel xml:lang="en">VISION DIS</skos:altLabel>
		<skos:altLabel xml:lang="en">eyesight problems</skos:altLabel>
		<skos:altLabel xml:lang="en">visual problems</skos:altLabel>
		<skos:altLabel xml:lang="fr">troubles visuels</skos:altLabel>
		<skos:altLabel xml:lang="fr">APPAREIL VISUEL</skos:altLabel>
		<skos:altLabel xml:lang="fr">Trouble de la vue</skos:altLabel>
		<skos:altLabel xml:lang="fr">affection de la vision</skos:altLabel>
		<skos:altLabel xml:lang="fr">altération visuelle</skos:altLabel>
		<skos:definition xml:lang="en">Visual impairments limiting one or more of the basic functions of the eye: visual acuity, dark adaptation, color vision, or peripheral vision. These may result from EYE DISEASES; OPTIC NERVE DISEASES; VISUAL PATHWAY diseases; OCCIPITAL LOBE diseases; OCULAR MOTILITY DISORDERS; and other conditions. Visual disability refers to inability of the individual to perform specific visual tasks, such as reading, writing, orientation, or traveling unaided. (From Newell, Ophthalmology: Principles and Conce (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0586406"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1333305"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1285159"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
	</owl:Class>

