		<skos:altLabel xml:lang="fr">maladies neurologiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">troubles neurologiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Trouble neurologique</skos:altLabel>
		<skos:altLabel xml:lang="fr">SYSTEME NERVEUX CENTRAL ET PERIPH.</skos:altLabel>
		<skos:altLabel xml:lang="fr">Neuropathies</skos:altLabel>
		<skos:altLabel xml:lang="fr">Affections du système nerveux</skos:altLabel>
		<skos:altLabel xml:lang="fr">Trouble du système nerveux</skos:altLabel>
		<skos:altLabel xml:lang="fr">Nerv</skos:altLabel>
		<skos:definition xml:lang="en">Diseases of the central and peripheral nervous system. This includes disorders of the brain, spinal cord, cranial nerves, peripheral nerves, nerve roots, autonomic nervous system, neuromuscular junction, and muscle. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Maladies du système nerveux central et périphérique. Cela inclut des troubles du cerveau, la moelle épinière, les nerfs crâniens, les nerfs périphériques, les racines de nerf, autonome le système nerveux, neuromusculaire la jonction et le muscle. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1333305"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1285159"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0038454"/>
