		<skos:altLabel xml:lang="en">Apolipoprotein E-3</skos:altLabel>
		<skos:altLabel xml:lang="en">Isoapolipoprotein E3</skos:altLabel>
		<skos:altLabel xml:lang="en">Apo E-3</skos:altLabel>
		<skos:altLabel xml:lang="en">Apo E3</skos:altLabel>
		<skos:altLabel xml:lang="en">APOE-epsilon 3</skos:altLabel>
		<skos:altLabel xml:lang="en">APOE-epsilon3</skos:altLabel>
		<skos:altLabel xml:lang="en">Apolipoprotein E-epsilon3</skos:altLabel>
		<skos:altLabel xml:lang="en">Apolipoprotein E-III</skos:altLabel>
		<skos:altLabel xml:lang="en">ApoE3</skos:altLabel>
		<skos:altLabel xml:lang="en">APOLIPOPROTEIN E 003</skos:altLabel>
		<skos:altLabel xml:lang="fr">Apo E3</skos:altLabel>
		<skos:altLabel xml:lang="fr">Apo E-3</skos:altLabel>
		<skos:altLabel xml:lang="fr">ApoE3</skos:altLabel>
		<skos:altLabel xml:lang="fr">APOE-epsilon 3</skos:altLabel>
		<skos:altLabel xml:lang="fr">APOE-epsilon3</skos:altLabel>
		<skos:altLabel xml:lang="fr">Apolipoprotéine epsilon E3</skos:altLabel>
		<skos:altLabel xml:lang="fr">Apolipoprotéine de type E3</skos:altLabel>
		<skos:definition xml:lang="en">A 34-kDa glycosylated protein. A major and most common isoform of apolipoprotein E. Therefore, it is also known as apolipoprotein E (ApoE). In human, Apo E3 is a 299-amino acid protein with a cysteine at the 112 and an arginine at the 158 position. It is involved with the transport of TRIGLYCERIDES; PHOSPHOLIPIDS; CHOLESTEROL; and CHOLESTERYL ESTERS in and out of the cells. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0443526"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1533698">
		<skos:prefLabel xml:lang="en">Nitric Oxide Synthase Type II</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">NitricOxideSynthaseTypeII</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Nitric oxide synthase type II</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">NitricOxideSynthaseTypeII</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">INOS Enzyme</skos:altLabel>
		<skos:altLabel xml:lang="en">Inducible Nitric Oxide Synthase</skos:altLabel>
		<skos:altLabel xml:lang="en">NOS-II</skos:altLabel>
		<skos:altLabel xml:lang="en">Nitric Oxide Synthase II</skos:altLabel>
		<skos:altLabel xml:lang="en">Inducible Protein</skos:altLabel>
		<skos:altLabel xml:lang="fr">INOS Enzyme</skos:altLabel>
		<skos:altLabel xml:lang="fr">Inducible nitric oxide synthase</skos:altLabel>
		<skos:altLabel xml:lang="fr">NO synthétase inductible</skos:altLabel>
		<skos:altLabel xml:lang="fr">NOS-II</skos:altLabel>
		<skos:altLabel xml:lang="fr">Nitrique oxyde synthétase inductible</skos:altLabel>
		<skos:altLabel xml:lang="fr">Oxyde nitrique synthétase de type II</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine iNOS</skos:altLabel>
		<skos:definition xml:lang="en">A CALCIUM-independent subtype of nitric oxide synthase that may play a role in immune function. It is an inducible enzyme whose expression is transcriptionally regulated by a variety of CYTOKINES. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0132555"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0006784">
		<skos:prefLabel xml:lang="en">Calpain</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Calpain</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Calpain</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Calpain</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Calcium-Activated Neutral Protease</skos:altLabel>
		<skos:altLabel xml:lang="en">Calcium-Activated Protease</skos:altLabel>
		<skos:altLabel xml:lang="en">Calcium-Dependent Neutral Proteinase</skos:altLabel>
		<skos:altLabel xml:lang="en">Desminase</skos:altLabel>
		<skos:altLabel xml:lang="en">Ca2+-Activated Protease</skos:altLabel>
		<skos:altLabel xml:lang="en">Calcium-Activated Neutral Proteinase</skos:altLabel>
		<skos:altLabel xml:lang="en">Calcium-Dependent Neutral Protease</skos:altLabel>
		<skos:altLabel xml:lang="en">Papain-Like Cysteine Protease</skos:altLabel>
		<skos:altLabel xml:lang="fr">calpaïne</skos:altLabel>
		<skos:definition xml:lang="en">Cysteine proteinase found in many tissues. Hydrolyzes a variety of endogenous proteins including NEUROPEPTIDES; CYTOSKELETAL PROTEINS; proteins from SMOOTH MUSCLE; CARDIAC MUSCLE; liver; platelets; and erythrocytes. Two subclasses having high and low calcium sensitivity are known. Removes Z-discs and M-lines from myofibrils. Activates phosphorylase kinase and cyclic nucleotide-independent protein kinase. This enzyme was formerly listed as EC 3.4.22.4. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0030940"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2717970"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0014442"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C1947941"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0020289"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1333402"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1334064"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1335528"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0234238">
		<skos:prefLabel xml:lang="en">Ache</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Ache</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Douleur sourde</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">DouleurSourde</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Aching pain</skos:altLabel>
		<skos:altLabel xml:lang="en">ACH</skos:altLabel>
		<skos:altLabel xml:lang="en">Aching sensation quality</skos:altLabel>
		<skos:altLabel xml:lang="en">ach pain</skos:altLabel>
		<skos:altLabel xml:lang="fr">Endolorissement</skos:altLabel>
		<skos:altLabel xml:lang="fr">Mal</skos:altLabel>
		<skos:altLabel xml:lang="fr">vague endolorissement</skos:altLabel>
		<skos:definition xml:lang="en">A dull persistent (usually moderately intense) pain. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1444779"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0007367">
		<skos:prefLabel xml:lang="en">CATALASE</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CATALASE</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Catalase</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Catalase</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">CAT Protein</skos:altLabel>
		<skos:altLabel xml:lang="en">EC 1.11.1.6</skos:altLabel>
		<skos:definition xml:lang="en">An oxidoreductase that catalyzes the conversion of HYDROGEN PEROXIDE to water and oxygen. It is present in many animal cells. A deficiency of this enzyme results in ACATALASIA. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003402"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0031179"/>
		<OntoAD:gene_product_plays_role_in_biological_process rdf:resource="&OntoAD;C0242606"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0014442"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1333402"/>
