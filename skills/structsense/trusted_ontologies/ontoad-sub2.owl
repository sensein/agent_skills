	<owl:Class rdf:about="&OntoAD;C1705612">
		<skos:prefLabel xml:lang="en">TG wt Allele</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">TGWtAllele</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Thyroglobulin wt Allele</skos:altLabel>
		<skos:definition xml:lang="en">Human TG wild-type allele is located in the vicinity of 8q24 and is approximately 268 kb in length. This allele, which encodes thyroglobulin protein, plays a role in the mediation of thyroid hormone production. Mutations in the gene are involved in goiter formation and genetic variants are associated with autoimmune thyroid disease type 3. (SwissProt) (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1420709"/>
	</owl:Class>

