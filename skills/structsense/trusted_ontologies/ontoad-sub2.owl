		<skos:altLabel xml:lang="fr">Glycoprotéine 2 sulfatée</skos:altLabel>
		<skos:altLabel xml:lang="fr">Glycoprotéine-2 sulfatée</skos:altLabel>
		<skos:altLabel xml:lang="fr">Inhibiteur SP40, 40</skos:altLabel>
		<skos:altLabel xml:lang="fr">Ionizing radiation-induced protein-8</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine ApoJ</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine SGP-2</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine SP-40,40</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine TRPM-2</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine XIP8</skos:altLabel>
		<skos:altLabel xml:lang="fr">Testosterone-repressed prostate message-2 protein</skos:altLabel>
		<skos:altLabel xml:lang="fr">X-Ray-inducible protein 8</skos:altLabel>
		<skos:altLabel xml:lang="fr">Inhibiteur de la lyse induite par le complément</skos:altLabel>
		<skos:altLabel xml:lang="fr">Inhibiteur SP-40,40</skos:altLabel>
		<skos:definition xml:lang="en">A highly conserved heterodimeric glycoprotein that is differentially expressed during many severe physiological disturbance states such as CANCER; APOPTOSIS; and various NEUROLOGICAL DISORDERS. Clusterin is ubiquitously expressed and appears to function as a secreted MOLECULAR CHAPERONE. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003591"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0007292"/>
		<OntoAD:gene_product_malfunction_associated_with_disease rdf:resource="&OntoAD;C0002395"/>
