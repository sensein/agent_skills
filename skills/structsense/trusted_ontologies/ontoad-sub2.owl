		<skos:altLabel xml:lang="en">vitamins hydroxocobalamin</skos:altLabel>
		<skos:altLabel xml:lang="fr">Vitamine B12A</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation de vitamine B12</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation d'hydroxycobalamine</skos:altLabel>
