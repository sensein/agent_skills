		<skos:altLabel xml:lang="en">FTLD WITH TAU INCLUSIONS</skos:altLabel>
		<skos:altLabel xml:lang="fr">démence fronto-temporale</skos:altLabel>
		<skos:altLabel xml:lang="fr">démences fronto-temporales</skos:altLabel>
		<skos:altLabel xml:lang="fr">Démence fronto-temporale liée au chromosome 17</skos:altLabel>
		<skos:altLabel xml:lang="fr">Dégénérescence Lobaire Fronto-Temporale (DLFT)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Démence frontotemporelle</skos:altLabel>
		<skos:altLabel xml:lang="fr">DFT (Démence FrontoTemporale)</skos:altLabel>
		<skos:definition xml:lang="en">The most common clinical form of FRONTOTEMPORAL LOBAR DEGENERATION, this dementia presents with personality and behavioral changes often associated with disinhibition, apathy, and lack of insight. (source : MSH)</skos:definition>
