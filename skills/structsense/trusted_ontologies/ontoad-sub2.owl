		<OntoAD:disease_has_associated_anatomic_site rdf:resource="&OntoAD;C0927232"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0242202"/>
		<OntoAD:has_definitional_manifestation rdf:resource="&OntoAD;C0009951"/>
		<OntoAD:has_definitional_manifestation rdf:resource="&OntoAD;C0036572"/>
	</owl:Class>

