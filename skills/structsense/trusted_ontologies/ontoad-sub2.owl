	<owl:Class rdf:about="&OntoAD;C2828081">
		<skos:prefLabel xml:lang="en">NINCDS-ADRDA Criteria for Alzheimer's Disease</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">NINCDS-ADRDACriteriaForAlzheimer'sDisease</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">National Institute of Neurological and Communicative Disorders and Stroke and Alzheimer's Disease an</skos:altLabel>
		<skos:definition xml:lang="en">Criteria for the diagnosis of Alzheimer's disease (AD), proposed in 1984 by the National Institute of Neurological and Communicative Disorders (NINCDS) and the Stroke-Alzheimer's Disease and Related Disorders Association (ADRDA, now the Alzheimer's Association). The criteria state that existing cognitive impairment may be considered possible or probable AD by neuropsychological testing but definitive diagnosis requires histopathologic confirmation. They specify eight cognitive domains that may b (source : )</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;Finding"/>
	</owl:Class>

