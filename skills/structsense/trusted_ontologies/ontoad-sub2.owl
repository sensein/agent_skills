	<owl:Class rdf:about="&OntoAD;C0063555">
		<skos:prefLabel xml:lang="en">Inosine Dialdehyde</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">InosineDialdehyde</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">alpha-(hydroxymethyl)-alpha'-(6-hydroxy-9H-purin-9-yl) diglycolaldehyde</skos:altLabel>
		<skos:altLabel xml:lang="en">diglycolaldehyde</skos:altLabel>
		<skos:altLabel xml:lang="en">inox</skos:altLabel>
		<skos:altLabel xml:lang="en">diglycoaldehyde</skos:altLabel>
		<skos:altLabel xml:lang="en">IdA</skos:altLabel>
		<skos:definition xml:lang="en">A toxic purine analogue. Inosine dialdehyde inhibits ribonucleotide reductase, resulting in decreased synthesis of DNA, RNA, and proteins, and G2/M-phase cell cycle arrest. This agent also forms stable covalent crosslinks in proteins, thereby inhibiting the activity of enzymes involved in nucleic acid synthesis. Check for 'http://www.cancer.gov/Search/ClinicalTrialsLink.aspx?id=39218andidtype=1' active clinical trials or 'http://www.cancer.gov/Search/ClinicalTrialsLink.aspx?id=39218andidtype=1andclose (source : )</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0280038"/>
	</owl:Class>

