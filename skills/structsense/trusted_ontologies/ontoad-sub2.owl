		<skos:hiddenLabel xml:lang="en">LongInterspersedElements</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">LINES</skos:altLabel>
		<skos:definition xml:lang="en">LINEs. Highly repeated sequences, 6000-8000 base pairs in length that contain RNA polymerase II promoters. They also have a region with sequence similarity to the reverse transcriptase of retroviruses, but they do not contain LTRs (long terminal repeats). (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0729606"/>
		<OntoAD:anatomic_structure_is_physical_part_of rdf:resource="&OntoAD;C0007634"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0014912">
		<skos:prefLabel xml:lang="en">Estradiol</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Estradiol</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Oestradiol</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Oestradiol</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Estradiol-17 beta</skos:altLabel>
		<skos:altLabel xml:lang="en">Estra-1,3,5(10)-triene-3,17-diol (17beta)-</skos:altLabel>
		<skos:altLabel xml:lang="en">Estradiol preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">Estradiol product</skos:altLabel>
		<skos:altLabel xml:lang="en">Estraldine</skos:altLabel>
		<skos:altLabel xml:lang="en">E2  Estradiol</skos:altLabel>
		<skos:altLabel xml:lang="en">Estradiol-17beta</skos:altLabel>
		<skos:altLabel xml:lang="en">ESDL</skos:altLabel>
		<skos:altLabel xml:lang="en">Therapeutic Estradiol</skos:altLabel>
		<skos:altLabel xml:lang="en">ESTRADIOL A 017 BETA</skos:altLabel>
		<skos:altLabel xml:lang="fr">estradiol</skos:altLabel>
		<skos:altLabel xml:lang="fr">Oestradiol-17beta</skos:altLabel>
		<skos:altLabel xml:lang="fr">Oestradiol 17beta</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation d'estradiol</skos:altLabel>
		<skos:altLabel xml:lang="fr">dihydrofolliculine</skos:altLabel>
		<skos:definition xml:lang="en">Generally refers to the 17-beta-isomer of estradiol, an aromatized C18 steroid with hydroxyl group at 3-beta- and 17-beta-position. Estradiol-17-beta is the most potent form of mammalian estrogenic steroids. In humans, it is produced primarily by the cyclic ovaries and the PLACENTA. It is also produced by the adipose tissue of men and postmenopausal women. The 17-alpha-isomer of estradiol binds weakly to estrogen receptors (RECEPTORS, ESTROGEN) and exhibits little estrogenic activity in estrogen (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1514972"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0582127"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C1458155"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013182"/>
	</owl:Class>

