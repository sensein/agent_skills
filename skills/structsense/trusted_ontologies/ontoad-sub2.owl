	<owl:Class rdf:about="&OntoAD;C0042850">
		<skos:prefLabel xml:lang="en">Vitamin B Deficiency</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">VitaminBDeficiency</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Carence en vitamines B</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">CarenceEnVitaminesB</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Deficiency of B-complex components</skos:altLabel>
		<skos:altLabel xml:lang="en">Vitamin B-complex deficiency</skos:altLabel>
		<skos:altLabel xml:lang="en">Vitamin B complex deficiency disease</skos:altLabel>
		<skos:altLabel xml:lang="en">B-complex deficiency</skos:altLabel>
		<skos:altLabel xml:lang="en">vitamin; deficiency, group B</skos:altLabel>
		<skos:altLabel xml:lang="en">VITAMIN B DEFIC</skos:altLabel>
		<skos:altLabel xml:lang="fr">Carence en vitamines du groupe B</skos:altLabel>
		<skos:altLabel xml:lang="fr">Déficit en vit B</skos:altLabel>
		<skos:altLabel xml:lang="fr">Déficit en vitamines B</skos:altLabel>
		<skos:altLabel xml:lang="fr">Carence en composants du complexe B</skos:altLabel>
		<skos:altLabel xml:lang="fr">carence en vitamine B</skos:altLabel>
		<skos:altLabel xml:lang="fr">carence en complexe vitaminique B</skos:altLabel>
		<skos:altLabel xml:lang="fr">Avitaminose du groupe B, sans précision</skos:altLabel>
		<skos:definition xml:lang="en">A condition due to deficiency in any member of the VITAMIN B COMPLEX. These B vitamins are water-soluble and must be obtained from the diet because they are easily lost in the urine. Unlike the lipid-soluble vitamins, they cannot be stored in the body fat. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1510471"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1332129"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1272558"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
	</owl:Class>

