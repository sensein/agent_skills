	<owl:Class rdf:about="&OntoAD;C0003451">
		<skos:prefLabel xml:lang="en">Antiviral Agents</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AntiviralAgents</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Antiviraux</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Antiviraux</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Antiviral Drugs</skos:altLabel>
		<skos:altLabel xml:lang="en">Antivirals</skos:altLabel>
		<skos:altLabel xml:lang="en">Antiviral preparations</skos:altLabel>
		<skos:altLabel xml:lang="en">Miscellaneous Antivirals</skos:altLabel>
		<skos:altLabel xml:lang="en">Antiviral agent</skos:altLabel>
		<skos:altLabel xml:lang="en">Miscellaneous Antiviral Agent</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents antiviraux</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents virostatiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments antiviraux</skos:altLabel>
		<skos:altLabel xml:lang="fr">Virostatiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments virostatiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">agent antiviral</skos:altLabel>
		<skos:definition xml:lang="en">Agents used in the prophylaxis or therapy of VIRUS DISEASES. Some of the ways they may act include preventing viral replication by inhibiting viral DNA polymerase; binding to specific cell-surface receptors and inhibiting viral penetration or uncoating; inhibiting viral protein synthesis; or blocking late stages of virus assembly. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1136254"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0030946">
		<skos:prefLabel xml:lang="en">Endopeptidases</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Endopeptidases</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Endopeptidases</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Endopeptidases</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Peptide Peptidohydrolases</skos:altLabel>
		<skos:altLabel xml:lang="en">Protease</skos:altLabel>
		<skos:altLabel xml:lang="en">Proteinase</skos:altLabel>
		<skos:altLabel xml:lang="en">Proteolytic enzyme</skos:altLabel>
		<skos:altLabel xml:lang="en">Endopeptidase</skos:altLabel>
		<skos:altLabel xml:lang="en">Protease preparation</skos:altLabel>
		<skos:altLabel xml:lang="fr">Peptide peptidohydrolases</skos:altLabel>
		<skos:altLabel xml:lang="fr">Endo-peptidases</skos:altLabel>
		<skos:definition xml:lang="en">A subclass of PEPTIDE HYDROLASES that catalyze the internal cleavage of PEPTIDES or PROTEINS. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1947941"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0770343"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0014442"/>
