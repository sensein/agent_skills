		<skos:altLabel xml:lang="fr">Globule blanc</skos:altLabel>
		<skos:altLabel xml:lang="fr">Leucocyte</skos:altLabel>
		<skos:altLabel xml:lang="fr">Globules blancs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Numération GB</skos:altLabel>
		<skos:altLabel xml:lang="fr">leucocyte, SAI</skos:altLabel>
