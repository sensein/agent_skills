		<skos:altLabel xml:lang="en">Transmission</skos:altLabel>
		<skos:altLabel xml:lang="en">Transmitted</skos:altLabel>
		<skos:altLabel xml:lang="en">Communicable Disease Transmission</skos:altLabel>
		<skos:altLabel xml:lang="en">Disease Transmission, Infectious</skos:altLabel>
		<skos:altLabel xml:lang="en">Infection Transmission</skos:altLabel>
		<skos:altLabel xml:lang="en">Pathogen Transmission</skos:altLabel>
		<skos:altLabel xml:lang="fr">Transmission d'infection</skos:altLabel>
		<skos:altLabel xml:lang="fr">Transmission de maladie contagieuse</skos:altLabel>
		<skos:altLabel xml:lang="fr">Transmission d'agent pathogène</skos:altLabel>
		<skos:definition xml:lang="en">The transmission of infectious disease or pathogens. When transmission is within the same species, the mode can be horizontal or vertical (INFECTIOUS DISEASE TRANSMISSION, VERTICAL). (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0699748"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0034019"/>
	</owl:Class>

