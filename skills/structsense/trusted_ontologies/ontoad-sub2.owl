	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0034865">
		<skos:prefLabel xml:lang="en">Recombination, Genetic</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Recombination,Genetic</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Recombinaison génétique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">RecombinaisonGénétique</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Recombination</skos:altLabel>
		<skos:altLabel xml:lang="en">DNA recombination</skos:altLabel>
		<skos:altLabel xml:lang="en">Genetic recombination</skos:altLabel>
		<skos:altLabel xml:lang="en">RECOMBINATION GENET</skos:altLabel>
		<skos:altLabel xml:lang="en">DNA Recombination Process</skos:altLabel>
		<skos:altLabel xml:lang="fr">Recombinaison</skos:altLabel>
		<skos:definition xml:lang="en">Production of new arrangements of DNA by various mechanisms such as assortment and segregation, CROSSING OVER; GENE CONVERSION; GENETIC TRANSFORMATION; GENETIC CONJUGATION; GENETIC TRANSDUCTION; or mixed infection of viruses. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0683142"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1511695"/>
		<OntoAD:interprets rdf:resource="&OntoAD;C0679560"/>
	</owl:Class>

