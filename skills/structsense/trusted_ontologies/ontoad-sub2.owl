		<skos:altLabel xml:lang="en">Antidiabetic agent</skos:altLabel>
		<skos:altLabel xml:lang="en">Antidiabetic preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">Anti-diabetic Agent</skos:altLabel>
