		<skos:altLabel xml:lang="en">RHEUMATOID ARTHRITIS, SUSCEPTIBILITY TO</skos:altLabel>
		<skos:altLabel xml:lang="en">Arthritis, Rheumatoid</skos:altLabel>
		<skos:altLabel xml:lang="fr">ARTHRITE RHUMATOIDE</skos:altLabel>
		<skos:altLabel xml:lang="fr">Polyarthrite chronique évolutive</skos:altLabel>
		<skos:altLabel xml:lang="fr">PR (Polyarthrite Rhumatoïde)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Arthrite rhumatoïde systémique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Polyarthrite rh</skos:altLabel>
		<skos:altLabel xml:lang="fr">Arthrite d</skos:altLabel>
		<skos:altLabel xml:lang="fr">PCE (Polyarthrite Chronique Évolutive)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Polyarthrite rhumatismale</skos:altLabel>
		<skos:altLabel xml:lang="fr">goutte asthénique primitive</skos:altLabel>
		<skos:altLabel xml:lang="fr">polyarthrite rhumatismale chronique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Polyarthrite rhumatoïde, sans précision</skos:altLabel>
		<skos:altLabel xml:lang="fr">Polyarthrite rhumatoïde, sans précision - Siège non précisé</skos:altLabel>
		<skos:definition xml:lang="en">A chronic systemic disease, primarily of the joints, marked by inflammatory changes in the synovial membranes and articular structures, widespread fibrinoid degeneration of the collagen fibers in mesenchymal tissues, and by atrophy and rarefaction of bony structures. Etiology is unknown, but autoimmune mechanisms have been implicated. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003864"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0004364"/>
