		<skos:altLabel xml:lang="en">Neurocognitive Disturbance</skos:altLabel>
		<skos:altLabel xml:lang="en">Neurocognitive Dysfunction</skos:altLabel>
		<skos:altLabel xml:lang="fr">atteinte cognitive</skos:altLabel>
