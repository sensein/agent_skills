	<owl:Class rdf:about="&OntoAD;C0023186">
		<skos:prefLabel xml:lang="en">Learning Disorders</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">LearningDisorders</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Troubles de l'apprentissage</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">TroublesDeL'apprentissage</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Academic skill disorder</skos:altLabel>
		<skos:altLabel xml:lang="en">LEARNING DIS</skos:altLabel>
		<skos:altLabel xml:lang="en">Learning differences</skos:altLabel>
		<skos:altLabel xml:lang="fr">Trouble de l'apprentissage</skos:altLabel>
		<skos:altLabel xml:lang="fr">Troubles des apprentissages</skos:altLabel>
		<skos:altLabel xml:lang="fr">trouble des acquisitions scolaires</skos:altLabel>
		<skos:definition xml:lang="en">Conditions characterized by a significant discrepancy between an individual's perceived level of intellect and their ability to acquire new language and other cognitive skills. These disorders may result from organic or psychological conditions. Relatively common subtypes include DYSLEXIA, dyscalculia, and dysgraphia. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2984904"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0003873">
