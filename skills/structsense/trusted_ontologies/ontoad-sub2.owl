		<rdfs:subClassOf rdf:resource="&OntoAD;C0370003"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0003379">
		<skos:prefLabel xml:lang="en">Antimitotic Agents</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AntimitoticAgents</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Antimitotiques</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Antimitotiques</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Antimitotics</skos:altLabel>
		<skos:altLabel xml:lang="en">Antimitotic Drugs</skos:altLabel>
		<skos:altLabel xml:lang="en">Mitotic inhibitor</skos:altLabel>
		<skos:altLabel xml:lang="en">Antimitotic agent</skos:altLabel>
		<skos:altLabel xml:lang="en">Mitosis Inhibitor Agents</skos:altLabel>
		<skos:altLabel xml:lang="en">Mitotic Inhibitor Agents</skos:altLabel>
		<skos:altLabel xml:lang="en">Mitosis Inhibitor Drugs</skos:altLabel>
		<skos:altLabel xml:lang="en">Mitotic Inhibitor Drugs</skos:altLabel>
		<skos:altLabel xml:lang="en">Microtubular Function Inhibitors</skos:altLabel>
		<skos:altLabel xml:lang="en">Mitosis Inhibitors</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents antimitotiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Anti-mitotiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments antimitotiques</skos:altLabel>
		<skos:definition xml:lang="en">Agents that arrest cells in MITOSIS, most notably TUBULIN MODULATORS. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003392"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1563757">
		<skos:prefLabel xml:lang="en">Tubulin Modulators</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">TubulinModulators</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Modulateurs de la polymérisation de la tubuline</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ModulateursDeLaPolymérisationDeLaTubuline</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Microtubule Modulators</skos:altLabel>
		<skos:altLabel xml:lang="en">Microtubule inhibitor</skos:altLabel>
		<skos:definition xml:lang="en">Agents that interact with TUBULIN to inhibit or promote polymerization of MICROTUBULES. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003379"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0042672">
		<skos:prefLabel xml:lang="en">Vinca Alkaloids</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">VincaAlkaloids</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Alcaloïdes pervenche</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AlcaloïdesPervenche</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Vinca alkaloid</skos:altLabel>
		<skos:altLabel xml:lang="en">Vinca Alkaloid Compound</skos:altLabel>
		<skos:altLabel xml:lang="fr">alcaloïde de la pervenche</skos:altLabel>
		<skos:definition xml:lang="en">A group of indole-indoline dimers which are ALKALOIDS obtained from the VINCA genus of plants. They inhibit polymerization of TUBULIN into MICROTUBULES thus blocking spindle formation and arresting cells in METAPHASE. They are some of the most useful ANTINEOPLASTIC AGENTS. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1563757"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0301258"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1519664">
		<skos:prefLabel xml:lang="en">Tubulin Binding Agent</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">TubulinBindingAgent</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">antimicrotubule agent</skos:altLabel>
		<skos:definition xml:lang="en">A type of drug that blocks cell growth by stopping mitosis (cell division). Antimicrotubule agents interfere with microtubules (cellular structures that help move chromosomes during mitosis). They are used to treat cancer. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003379"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1883533">
