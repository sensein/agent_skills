	<owl:Class rdf:about="&OntoAD;C1579433">
		<skos:prefLabel xml:lang="en">Insulin [EPC]</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Insulin[EPC]</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Insulines</skos:prefLabel>
