	<owl:Class rdf:about="&OntoAD;C0015684">
		<skos:prefLabel xml:lang="en">Fatty Acids</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">FattyAcids</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Acides gras</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AcidesGras</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">fatty acid</skos:altLabel>
		<skos:altLabel xml:lang="fr">Acide gras</skos:altLabel>
		<skos:definition xml:lang="en">Organic, monobasic acids derived from hydrocarbons by the equivalent of oxidation of a methyl group to an alcohol, aldehyde, and then acid. Fatty acids are saturated and unsaturated (FATTY ACIDS, UNSATURATED). (Grant and Hackh's Chemical Dictionary, 5th ed) (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Acides organiques monobasiques dérivés des hydrocarbures, formés par oxydation successive d'un groupement méthyl en alcool, aldéhyde, et puis acide. Les acides gras sont saturés et insaturés. (Grant et dictionnaire chimique de Hackh, 5ème ED) (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0023779"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0007066"/>
	</owl:Class>

