	<owl:Class rdf:about="&OntoAD;C0030971">
		<skos:prefLabel xml:lang="en">Perception</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Perception</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Perception</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Perception</skos:hiddenLabel>
