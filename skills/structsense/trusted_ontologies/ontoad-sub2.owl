		<skos:altLabel xml:lang="en">PHF-Tau</skos:altLabel>
		<skos:altLabel xml:lang="en">Neurofibrillary Tangle Protein</skos:altLabel>
		<skos:definition xml:lang="en">Microtubule-associated protein tau (758 aa, ~79 kDa) is encoded by the human MAPT gene. This protein may be involved in axon stability. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0010852"/>
