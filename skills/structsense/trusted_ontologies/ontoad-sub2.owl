	<owl:Class rdf:about="&OntoAD;C0403447">
		<skos:prefLabel xml:lang="en">Chronic Kidney Insufficiency</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">ChronicKidneyInsufficiency</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Insuffisance rénale chronique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">InsuffisanceRénaleChronique</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Renal Insufficiency, Chronic</skos:altLabel>
		<skos:altLabel xml:lang="en">Chronic renal impairment</skos:altLabel>
		<skos:altLabel xml:lang="en">Chronic renal disease</skos:altLabel>
		<skos:altLabel xml:lang="en">insufficiency; renal, chronic, end stage renal disease</skos:altLabel>
		<skos:altLabel xml:lang="en">Chronic kidney disease</skos:altLabel>
		<skos:altLabel xml:lang="en">insufficiency; renal, end stage</skos:altLabel>
		<skos:altLabel xml:lang="en">CKD  chronic kidney disease</skos:altLabel>
		<skos:altLabel xml:lang="en">chronic renal insufficiency</skos:altLabel>
		<skos:altLabel xml:lang="fr">Dégradation chronique de la fonction rénale</skos:altLabel>
		<skos:altLabel xml:lang="fr">IRC (Insuffisance Rénale Chronique)</skos:altLabel>
		<skos:definition xml:lang="en">Conditions in which the KIDNEYS perform below the normal level for more than three months. Chronic kidney insufficiency is classified by five stages according to the decline in GLOMERULAR FILTRATION RATE and the degree of kidney damage (as measured by the level of PROTEINURIA). The most severe form is the end-stage renal disease (CHRONIC KIDNEY FAILURE). (Kidney Foundation: Kidney Disease Outcome Quality Initiative, 2002) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1565489"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0035078"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1263743"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0341697"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
