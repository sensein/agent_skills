	<owl:Class rdf:about="&OntoAD;C0004153">
		<skos:prefLabel xml:lang="en">Atherosclerosis</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Atherosclerosis</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Athérosclérose</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Athérosclérose</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Atheromatosis</skos:altLabel>
		<skos:altLabel xml:lang="en">VASCULAR DISEASE ATHEROSCLEROTIC</skos:altLabel>
		<skos:altLabel xml:lang="en">AS  Atherosclerosis</skos:altLabel>
		<skos:altLabel xml:lang="en">Atherosclerotic cardiovasc dis</skos:altLabel>
		<skos:altLabel xml:lang="en">Atherosclerotic cardiovascular disease</skos:altLabel>
		<skos:altLabel xml:lang="en">Atherosclerotic cardiovascular disease, so described</skos:altLabel>
		<skos:altLabel xml:lang="fr">Maladie cardiovasculaire athéroscléreuse</skos:altLabel>
		<skos:altLabel xml:lang="fr">Athéromatose</skos:altLabel>
		<skos:altLabel xml:lang="fr">athéroscléreux</skos:altLabel>
		<skos:altLabel xml:lang="fr">Athérosclérose cardio-vasculaire, décrite ainsi</skos:altLabel>
		<skos:definition xml:lang="en">A thickening and loss of elasticity of the walls of ARTERIES that occurs with formation of ATHEROSCLEROTIC PLAQUES within the ARTERIAL INTIMA. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">L'épaississement et la perte d'élasticité des parois des ARTERES musculaires moyennes et grandes, avec des lésions sur la couche interne de l'artère (TUNIQUE INTIME). Le processus d'athérogenèse comprend la rétention des LIPOPROTEINES riches en cholestérol et leur liaison aux PROTEOGLYCANS de la tunique intime, la production des molécules pro-inflammatoires qui recrutent des MACROPHAGES dans l'espace sub-endothélial, la formation des CELLULES SPUMEUSES et éventuellement la calcification du paroi (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003850"/>
		<OntoAD:disease_has_associated_anatomic_site rdf:resource="&OntoAD;C0007226"/>
		<OntoAD:associated_with_malfunction_of_gene_product rdf:resource="&OntoAD;C0003595"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C1565489"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0007282"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0040336"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0020443"/>
		<OntoAD:disease_has_associated_gene rdf:resource="&OntoAD;C2827465"/>
		<OntoAD:disease_has_associated_gene rdf:resource="&OntoAD;C1412481"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0020473"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0403447"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0752347">
		<skos:prefLabel xml:lang="en">Lewy Body Disease</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">LewyBodyDisease</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Maladie à corps de Lewy</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">MaladieÀCorpsDeLewy</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Lewy</skos:altLabel>
		<skos:altLabel xml:lang="en">Lewy body dementia</skos:altLabel>
		<skos:altLabel xml:lang="en">Lewy body diseases</skos:altLabel>
		<skos:altLabel xml:lang="en">dementia with Lewy bodies</skos:altLabel>
		<skos:altLabel xml:lang="en">Diffuse Lewy Body Disease</skos:altLabel>
		<skos:altLabel xml:lang="en">SDLT  Sen dement Lewy bdy typ</skos:altLabel>
		<skos:altLabel xml:lang="en">Senile dement of Lewy bdy type</skos:altLabel>
		<skos:altLabel xml:lang="en">CLBD  Cortical Lewy body dis</skos:altLabel>
		<skos:altLabel xml:lang="en">CLBD  Cortical Lewy body disease</skos:altLabel>
		<skos:altLabel xml:lang="en">Lewy Body Disease, Cortical</skos:altLabel>
		<skos:altLabel xml:lang="en">SDLT  Senile dementia of the Lewy body type</skos:altLabel>
		<skos:altLabel xml:lang="en">Lewy Body Type Senile Dementia</skos:altLabel>
		<skos:altLabel xml:lang="en">DLBD  Diffuse Lewy body dis</skos:altLabel>
		<skos:altLabel xml:lang="en">DLBD  Diffuse Lewy body disease</skos:altLabel>
		<skos:altLabel xml:lang="en">LBD  Lewy body disease</skos:altLabel>
		<skos:altLabel xml:lang="en">Lewy body variant of Alzheimer's disease</skos:altLabel>
		<skos:altLabel xml:lang="en">Dementia of the Lewy body type</skos:altLabel>
		<skos:altLabel xml:lang="en">Dementia, Lewy Body</skos:altLabel>
		<skos:altLabel xml:lang="en">Senile dementia of the Lewy body type</skos:altLabel>
		<skos:altLabel xml:lang="en">DLB</skos:altLabel>
		<skos:altLabel xml:lang="en">CORTICAL LEWY BODY DIS</skos:altLabel>
		<skos:altLabel xml:lang="en">LEWY BODY DIS</skos:altLabel>
		<skos:altLabel xml:lang="en">DIFFUSE LEWY BODY DIS</skos:altLabel>
		<skos:altLabel xml:lang="en">Dementia w Lewy bodies</skos:altLabel>
		<skos:altLabel xml:lang="en">body dementia lewis</skos:altLabel>
		<skos:altLabel xml:lang="en">body disease lewis</skos:altLabel>
		<skos:altLabel xml:lang="fr">démence à corps de Lewy</skos:altLabel>
		<skos:altLabel xml:lang="fr">Lewy</skos:altLabel>
		<skos:altLabel xml:lang="fr">Démence sénile de type corps de Lewy</skos:altLabel>
		<skos:altLabel xml:lang="fr">Maladie à corps de Lewy diffuse</skos:altLabel>
		<skos:altLabel xml:lang="fr">atteinte diffuse à corps de Lewy</skos:altLabel>
		<skos:altLabel xml:lang="fr">variante à corps de Lewy de la maladie d'Alzheimer</skos:altLabel>
		<skos:definition xml:lang="en">A neurodegenerative disease characterized by dementia, mild parkinsonism, and fluctuations in attention and alertness. The neuropsychiatric manifestations tend to precede the onset of bradykinesia, MUSCLE RIGIDITY, and other extrapyramidal signs. DELUSIONS and visual HALLUCINATIONS are relatively frequent in this condition. Histologic examination reveals LEWY BODIES in the CEREBRAL CORTEX and BRAIN STEM. SENILE PLAQUES and other pathologic features characteristic of ALZHEIMER DISEASE may also be (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">maladie neurodégénératif caractérisée par la démence, syndrome parkinsonien léger et les fluctuations dans l'attention et l'attention. Les manifestations ¤slneuropsychiatric¤sl ont tendance à précéder le commencement de bradycinésie, la RIGIDITÉ DE MUSCLE et d'autres signes de l'extra-pyramidal. Les ILLUSIONS et les HALLUCINATIONS visuelles sont relativement fréquents dans cette affection. L'examen de Histologique révèle des corps de Lewy dans le CORTEX et le TRONC CEREBRAL. LES PLAQUES SÉNILES  (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0011268"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0349723"/>
		<OntoAD:clinically_similar rdf:resource="&OntoAD;C0002395"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:has_associated_morphology rdf:resource="&OntoAD;C0085200"/>
		<OntoAD:has_manifestation rdf:resource="&OntoAD;C0242422"/>
		<OntoAD:disease_has_associated_anatomic_site rdf:resource="&OntoAD;C0027763"/>
		<OntoAD:disease_has_associated_anatomic_site rdf:resource="&OntoAD;C0927232"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0242202"/>
		<OntoAD:associated_with_malfunction_of_gene_product rdf:resource="&OntoAD;C0285890"/>
		<OntoAD:has_manifestation rdf:resource="&OntoAD;C0011253"/>
		<OntoAD:has_associated_morphology rdf:resource="&OntoAD;C0011164"/>
		<OntoAD:has_manifestation rdf:resource="&OntoAD;C0233763"/>
		<OntoAD:has_manifestation rdf:resource="&OntoAD;C0743039"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0228061"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0027540">
		<skos:prefLabel xml:lang="en">Necrosis</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Necrosis</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Nécrose</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Nécrose</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Cellular necrosis</skos:altLabel>
		<skos:altLabel xml:lang="en">Tissue devitalization</skos:altLabel>
		<skos:altLabel xml:lang="en">Necrotic</skos:altLabel>
		<skos:altLabel xml:lang="en">tissue death</skos:altLabel>
		<skos:altLabel xml:lang="en">necrotic cell death</skos:altLabel>
		<skos:altLabel xml:lang="en">Necrotic Process</skos:altLabel>
		<skos:altLabel xml:lang="fr">dévitalisation tissulaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">nécrose cellulaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">nécrotique</skos:altLabel>
		<skos:definition xml:lang="en">The pathological process occurring in cells that are dying from irreparable injuries. It is caused by the progressive, uncontrolled action of degradative ENZYMES, leading to MITOCHONDRIAL SWELLING, nuclear flocculation, and cell lysis. Distinguish it from APOPTOSIS which is a normal, regulated cellular process. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">http://www.fnclcc.fr/fr/patients/dico/definition.php?id_definition=1105 (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0007587"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0030660"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0010957"/>
		<OntoAD:consider rdf:resource="&OntoAD;C0162638"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0028661">
		<skos:prefLabel xml:lang="en">Nurses</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Nurses</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Infirmières et infirmiers</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">InfirmièresEtInfirmiers</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">nurse</skos:altLabel>
		<skos:altLabel xml:lang="en">Personnel, Nursing</skos:altLabel>
		<skos:altLabel xml:lang="en">Professional nurse</skos:altLabel>
		<skos:altLabel xml:lang="en">Nursing personnel</skos:altLabel>
		<skos:altLabel xml:lang="en">NURS PERSONNEL</skos:altLabel>
		<skos:altLabel xml:lang="fr">Infirmiers qualifiés</skos:altLabel>
		<skos:altLabel xml:lang="fr">Infirmières qualifiées</skos:altLabel>
		<skos:altLabel xml:lang="fr">Personnel infirmier qualifié</skos:altLabel>
		<skos:altLabel xml:lang="fr">infirmier diplômé, en général</skos:altLabel>
		<skos:altLabel xml:lang="fr">infirmière diplômée, en général</skos:altLabel>
		<skos:definition xml:lang="en">Professionals qualified by education at an accredited school of nursing and licensed by state law to practice nursing. They provide services to patients requiring assistance in recovering or maintaining their physical or mental health. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">http://www.fnclcc.fr/fr/patients/dico/definition.php?id_definition=810 (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0028677"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1513058"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1306452"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0334881"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1320928">
		<skos:prefLabel xml:lang="en">Resident (physician)</skos:prefLabel>
