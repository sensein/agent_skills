		<skos:prefLabel xml:lang="en">tarenflurbil</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Tarenflurbil</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">R-flurbiprofen</skos:altLabel>
		<skos:altLabel xml:lang="fr">tarenflurbil</skos:altLabel>
		<skos:definition xml:lang="en">A substance that is being studied as a treatment for cancer. It belongs to the family of drugs called nonsteroidal anti-inflammatory drugs (NSAIDs). (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003211"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1519313"/>
	</owl:Class>

