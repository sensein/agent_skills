		<skos:altLabel xml:lang="en">psychotherapeutic drugs</skos:altLabel>
		<skos:altLabel xml:lang="en">psychotherapeutics</skos:altLabel>
		<skos:altLabel xml:lang="en">psychotropic agents</skos:altLabel>
