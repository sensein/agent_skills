		<skos:altLabel xml:lang="en">Animalia</skos:altLabel>
		<skos:altLabel xml:lang="en">multicellular animals</skos:altLabel>
		<skos:altLabel xml:lang="en">Kingdom Animalia</skos:altLabel>
		<skos:altLabel xml:lang="en">animal kingdom</skos:altLabel>
		<skos:altLabel xml:lang="fr">Animal</skos:altLabel>
		<skos:altLabel xml:lang="fr">Animalia</skos:altLabel>
		<skos:definition xml:lang="en">Unicellular or multicellular, heterotrophic organisms, that have sensation and the power of voluntary movement. Under the older five kingdom paradigm, Animalia was one of the kingdoms. Under the modern three domain model, Animalia represents one of the many groups in the domain EUKARYOTA. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;Animal"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0003184">
