	<owl:Class rdf:about="&OntoAD;C0039433">
		<skos:prefLabel xml:lang="en">Tectum Mesencephali</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">TectumMesencephali</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Tectum du mésencéphale</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">TectumDuMésencéphale</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Tectum</skos:altLabel>
		<skos:altLabel xml:lang="en">Tectum of midbrain</skos:altLabel>
		<skos:altLabel xml:lang="en">mesencephalic tectum</skos:altLabel>
		<skos:altLabel xml:lang="en">Tectum mesencephalicum</skos:altLabel>
		<skos:altLabel xml:lang="en">Tectum structure</skos:altLabel>
		<skos:altLabel xml:lang="en">Neuraxis tectum</skos:altLabel>
		<skos:altLabel xml:lang="en">tectums</skos:altLabel>
		<skos:altLabel xml:lang="fr">Toit du mésencéphale</skos:altLabel>
		<skos:altLabel xml:lang="fr">tectum</skos:altLabel>
		<skos:definition xml:lang="en">The dorsal portion or roof of the midbrain. It is composed of two pairs of bumps, the inferior and the superior colliculi. These four colliculi are also called the quadrigeminal bodies (TECTUM MESENCEPHALI). They are centers for auditory and visual functions. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1268149"/>
		<OntoAD:attributed_part_of rdf:resource="&OntoAD;C0025462"/>
	</owl:Class>

