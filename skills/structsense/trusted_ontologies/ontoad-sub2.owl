		<skos:altLabel xml:lang="en">TNFSF2</skos:altLabel>
		<skos:altLabel xml:lang="en">TNFA</skos:altLabel>
		<skos:altLabel xml:lang="en">Tumor Necrosis Factor (TNF Superfamily, Member 2) Gene</skos:altLabel>
		<skos:altLabel xml:lang="en">TNF superfamily, member 2</skos:altLabel>
		<skos:altLabel xml:lang="en">TNF, MACROPHAGE-DERIVED</skos:altLabel>
