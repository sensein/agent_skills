		<skos:altLabel xml:lang="en">Transdermal Route of Administration</skos:altLabel>
		<skos:altLabel xml:lang="en">TRANSCUTANEOUS ADMIN</skos:altLabel>
		<skos:altLabel xml:lang="en">TRANSDERMAL ADMIN</skos:altLabel>
		<skos:altLabel xml:lang="fr">Voie intradermique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Voie transcutanée</skos:altLabel>
		<skos:altLabel xml:lang="fr">Administration par voie intradermique</skos:altLabel>
		<skos:altLabel xml:lang="fr">administration par voie transdermique</skos:altLabel>
		<skos:definition xml:lang="en">A topical route that begins on the skin and has the propensity for systemic absorption via the dermal layer. (source : SNOMEDCT)</skos:definition>
