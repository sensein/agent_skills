		<skos:altLabel xml:lang="fr">Hôpital psychiatrique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Institutions psychiatriques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Établissements de santé mentale</skos:altLabel>
