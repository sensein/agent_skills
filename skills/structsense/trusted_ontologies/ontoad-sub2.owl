		<skos:prefLabel xml:lang="fr">Phthiraptera</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Phthiraptera</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Phthiraptera</skos:altLabel>
		<skos:altLabel xml:lang="en">Biting and sucking lice</skos:altLabel>
		<skos:altLabel xml:lang="en">Order Phthiraptera</skos:altLabel>
		<skos:altLabel xml:lang="fr">Poux</skos:altLabel>
		<skos:altLabel xml:lang="fr">Phthiraptères</skos:altLabel>
		<skos:altLabel xml:lang="fr">Pou</skos:altLabel>
		<skos:definition xml:lang="en">An order of small, wingless parasitic insects, commonly known as lice. The suborders include ANOPLURA (sucking lice); AMBLYCERA; ISCHNOCERA; and Rhynchophthirina (elephant and warthog lice). (source : MSH)</skos:definition>
