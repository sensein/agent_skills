		<skos:hiddenLabel xml:lang="en">Triacetyluridine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">TAU</skos:altLabel>
		<skos:definition xml:lang="en">A substance that is being studied for its ability to protect against the gastrointestinal side effects caused by fluorouracil. It belongs to the family of drugs called cytoprotective agents. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0280039"/>
	</owl:Class>

