		<skos:hiddenLabel xml:lang="en">Protokylol</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">alpha-(alpha-methyl-3,4-methylenedioxyphenethylamino)methyl protocatechuyl alcohol</skos:altLabel>
		<skos:altLabel xml:lang="fr">protokylol</skos:altLabel>
		<skos:altLabel xml:lang="fr">chlorhydrate de protokylol</skos:altLabel>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0001644"/>
