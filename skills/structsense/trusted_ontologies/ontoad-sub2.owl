		<skos:altLabel xml:lang="fr">HLA-BR</skos:altLabel>
		<skos:altLabel xml:lang="fr">locus HLA-DR</skos:altLabel>
		<skos:definition xml:lang="en">A subclass of HLA-D antigens that consist of alpha and beta chains. The inheritance of HLA-DR antigens differs from that of the HLA-DQ ANTIGENS and HLA-DP ANTIGENS. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0312653"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0242318"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0019630"/>
		<OntoAD:gene_product_has_associated_anatomy rdf:resource="&OntoAD;C0007603"/>
		<OntoAD:gene_product_has_organism_source rdf:resource="&OntoAD;C0086418"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0021072"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1334166"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0006685">
		<skos:prefLabel xml:lang="en">Calcium Channel</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CalciumChannel</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Canaux calciques</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">CanauxCalciques</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Ion Channels, Calcium</skos:altLabel>
		<skos:altLabel xml:lang="en">Receptors, Calcium Channel Blocker</skos:altLabel>
		<skos:altLabel xml:lang="en">Calcium Channel Antagonist Receptor</skos:altLabel>
		<skos:altLabel xml:lang="en">Voltage-Dependent Calcium Channels</skos:altLabel>
		<skos:altLabel xml:lang="en">VDCC</skos:altLabel>
		<skos:altLabel xml:lang="en">CA CHANNEL BLOCK RECEPT</skos:altLabel>
		<skos:altLabel xml:lang="en">CA CHANNELS</skos:altLabel>
		<skos:altLabel xml:lang="en">ION CHANNEL CA</skos:altLabel>
		<skos:altLabel xml:lang="en">RECEPT CALCIUM CHANNEL BLOCKER</skos:altLabel>
		<skos:altLabel xml:lang="en">CA CHANNEL ANTAG RECEPT</skos:altLabel>
		<skos:altLabel xml:lang="en">Calcium Channels</skos:altLabel>
		<skos:altLabel xml:lang="fr">Canal calcique voltage-dépendant</skos:altLabel>
		<skos:altLabel xml:lang="fr">Canaux calciques voltage-dépendants</skos:altLabel>
		<skos:altLabel xml:lang="fr">Canaux à ions calcium</skos:altLabel>
		<skos:altLabel xml:lang="fr">Canal calcique</skos:altLabel>
		<skos:altLabel xml:lang="fr">CCVD</skos:altLabel>
		<skos:altLabel xml:lang="fr">Canaux calciques potentiel-dépendants</skos:altLabel>
		<skos:altLabel xml:lang="fr">Canaux calcium</skos:altLabel>
		<skos:altLabel xml:lang="fr">Canal calcique potentiel-dépendant</skos:altLabel>
		<skos:altLabel xml:lang="fr">Canal calcium</skos:altLabel>
		<skos:altLabel xml:lang="fr">Canaux ioniques à calcium</skos:altLabel>
		<skos:definition xml:lang="en">Voltage-dependent cell membrane glycoproteins selectively permeable to calcium ions. They are categorized as L-, T-, N-, P-, Q-, and R-types based on the activation and inactivation kinetics, ion specificity, and sensitivity to drugs and toxins. The L- and T-types are present throughout the cardiovascular and central nervous systems and the N-, P-, Q-, and R-types are located in neuronal tissue. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;AminoAcid,Peptide,OrProtein"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;BiologicallyActiveSubstance"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0010762">
		<skos:prefLabel xml:lang="en">Cytochrome P450</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CytochromeP450</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Cytochrome P-450 enzyme system</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">CytochromeP-450EnzymeSystem</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Cytochrome P-450</skos:altLabel>
		<skos:altLabel xml:lang="en">Cytochrome P-450 Enzyme System</skos:altLabel>
		<skos:altLabel xml:lang="en">P450</skos:altLabel>
		<skos:altLabel xml:lang="en">CYP (cytochrome P450)</skos:altLabel>
		<skos:altLabel xml:lang="en">Cytochrome p450 enzyme</skos:altLabel>
		<skos:altLabel xml:lang="en">Cytochrome p-450 enzyme</skos:altLabel>
		<skos:altLabel xml:lang="en">cytochrome P450 enzyme system</skos:altLabel>
		<skos:altLabel xml:lang="fr">Système enzymatique du cytochrome P-450</skos:altLabel>
		<skos:altLabel xml:lang="fr">Système cytochrome P450</skos:altLabel>
		<skos:definition xml:lang="en">A superfamily of hundreds of closely related HEMEPROTEINS found throughout the phylogenetic spectrum, from animals, plants, fungi, to bacteria. They include numerous complex monooxygenases (MIXED FUNCTION OXYGENASES). In animals, these P-450 enzymes serve two major functions: (1) biosynthesis of steroids, fatty acids, and bile acids; (2) metabolism of endogenous and a wide variety of exogenous substrates, such as toxins and drugs (BIOTRANSFORMATION). They are classified, according to their seque (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0018974"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0020364"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0010798"/>
		<OntoAD:gene_product_plays_role_in_biological_process rdf:resource="&OntoAD;C0025519"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0014442"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0030016"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1333402"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1335186"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0085295">
		<skos:prefLabel xml:lang="en">Interleukin-10</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Interleukin-10</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Interleukine-10</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Interleukine-10</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">CSIF-10</skos:altLabel>
		<skos:altLabel xml:lang="en">Cytokine Synthesis Inhibitory Factor</skos:altLabel>
		<skos:altLabel xml:lang="en">IL-10</skos:altLabel>
		<skos:altLabel xml:lang="en">IL10</skos:altLabel>
		<skos:altLabel xml:lang="en">Cytokine formation-inhibiting factor (mouse clone F115 protein moiety reduced)</skos:altLabel>
		<skos:altLabel xml:lang="en">CSIF</skos:altLabel>
		<skos:altLabel xml:lang="en">Cytokine synthesis inhibiting factor</skos:altLabel>
		<skos:altLabel xml:lang="en">Interleukin 10 Precursor</skos:altLabel>
		<skos:altLabel xml:lang="en">IL10A</skos:altLabel>
		<skos:altLabel xml:lang="en">TGIF</skos:altLabel>
		<skos:altLabel xml:lang="en">CYTOKINE SYN INHIB FACTOR</skos:altLabel>
		<skos:altLabel xml:lang="en">IL 010</skos:altLabel>
		<skos:altLabel xml:lang="en">INTERLEUKIN 010</skos:altLabel>
		<skos:altLabel xml:lang="fr">IL-10</skos:altLabel>
		<skos:altLabel xml:lang="fr">Interleukine 10</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteur inhibiteur de la synthèse des cytokines</skos:altLabel>
		<skos:altLabel xml:lang="fr">IL10</skos:altLabel>
		<skos:altLabel xml:lang="fr">facteur inhibant la synthèse de cytokines</skos:altLabel>
		<skos:altLabel xml:lang="fr">CSIF</skos:altLabel>
		<skos:definition xml:lang="en">A cytokine produced by a variety of cell types, including T-LYMPHOCYTES; MONOCYTES; DENDRITIC CELLS; and EPITHELIAL CELLS that exerts a variety of effects on immunoregulation and INFLAMMATION. Interleukin-10 combines with itself to form a homodimeric molecule that is the biologically active form of the protein. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0021764"/>
		<OntoAD:gene_product_plays_role_in_biological_process rdf:resource="&OntoAD;C1155266"/>
		<OntoAD:gene_product_has_organism_source rdf:resource="&OntoAD;C0086418"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1333196"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0010760">
		<skos:prefLabel xml:lang="en">CYTOCHROME C OXIDASE</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CYTOCHROMECOXIDASE</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Complexe IV de la chaîne respiratoire</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ComplexeIVDeLaChaîneRespiratoire</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Cytochrome-c Oxidase (Complex IV)</skos:altLabel>
		<skos:altLabel xml:lang="en">Cytochrome Oxidase</skos:altLabel>
		<skos:altLabel xml:lang="en">Ferrocytochrome c Oxygen Oxidoreductase</skos:altLabel>
		<skos:altLabel xml:lang="en">Ferricytochrome-c:oxygen oxidoreductase</skos:altLabel>
		<skos:altLabel xml:lang="en">Complex IV</skos:altLabel>
		<skos:altLabel xml:lang="en">Electron Transport Complex IV</skos:altLabel>
		<skos:altLabel xml:lang="en">Electron Transport Chain Complex IV</skos:altLabel>
		<skos:altLabel xml:lang="fr">Cytochrome C oxydase</skos:altLabel>
		<skos:altLabel xml:lang="fr">Cytochrome oxydase</skos:altLabel>
		<skos:altLabel xml:lang="fr">Complexe IV de la chaîne de transport d'électrons</skos:altLabel>
		<skos:altLabel xml:lang="fr">Complexe de la chaîne de transport d'électrons de type IV</skos:altLabel>
		<skos:altLabel xml:lang="fr">Complexe-4 de la chaîne de transport d'électrons</skos:altLabel>
		<skos:altLabel xml:lang="fr">Complexe-4 de la chaîne respiratoire</skos:altLabel>
		<skos:altLabel xml:lang="fr">cytochrome-c oxydase</skos:altLabel>
		<skos:altLabel xml:lang="fr">cytochrome a3</skos:altLabel>
		<skos:altLabel xml:lang="fr">cytochrome aa3</skos:altLabel>
		<skos:definition xml:lang="en">A multisubunit enzyme complex containing CYTOCHROME A GROUP; CYTOCHROME A3; two copper atoms; and 13 different protein subunits. It is the terminal oxidase complex of the RESPIRATORY CHAIN and collects electrons that are transferred from the reduced CYTOCHROME C GROUP and donates them to molecular OXYGEN, which is then reduced to water. The redox reaction is simultaneously coupled to the transport of PROTONS across the inner mitochondrial membrane. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0242417"/>
		<OntoAD:gene_product_plays_role_in_biological_process rdf:resource="&OntoAD;C0014272"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0006100">
		<skos:prefLabel xml:lang="en">Bradykinin</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Bradykinin</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Bradykinine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Bradykinine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Kallidin I</skos:altLabel>
		<skos:altLabel xml:lang="en">Arg-Pro-Pro-Gly-Phe-Ser-Pro-Phe-Arg</skos:altLabel>
		<skos:altLabel xml:lang="en">kallidin 9</skos:altLabel>
		<skos:altLabel xml:lang="fr">kallidine I</skos:altLabel>
		<skos:definition xml:lang="en">A nonapeptide messenger that is enzymatically produced from KALLIDIN in the blood where it is a potent but short-lived agent of arteriolar dilation and increased capillary permeability. Bradykinin is also released from MAST CELLS during asthma attacks, from gut walls as a gastrointestinal vasodilator, from damaged tissues as a pain signal, and may be a neurotransmitter. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0042402"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0027895"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0301974"/>
		<OntoAD:gene_product_plays_role_in_biological_process rdf:resource="&OntoAD;C1155266"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0034818">
		<skos:prefLabel xml:lang="en">Insulin Receptor</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">InsulinReceptor</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Récepteur à l'insuline</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">RécepteurÀL'insuline</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Insulin-Dependent Tyrosine Protein Kinase</skos:altLabel>
		<skos:altLabel xml:lang="en">Insulin Receptor Protein-Tyrosine Kinase</skos:altLabel>
		<skos:altLabel xml:lang="en">Insulin receptor site</skos:altLabel>
		<skos:altLabel xml:lang="en">INSR</skos:altLabel>
		<skos:altLabel xml:lang="en">INSULIN RECEPT</skos:altLabel>
		<skos:altLabel xml:lang="en">Receptor, Insulin</skos:altLabel>
		<skos:altLabel xml:lang="fr">Récepteur d'insuline</skos:altLabel>
		<skos:altLabel xml:lang="fr">récepteur de l'insuline</skos:altLabel>
		<skos:definition xml:lang="en">A cell surface receptor for INSULIN. It comprises a tetramer of two alpha and two beta subunits which are derived from cleavage of a single precursor protein. The receptor contains an intrinsic TYROSINE KINASE domain that is located within the beta subunit. Activation of the receptor by INSULIN results in numerous metabolic changes including increased uptake of GLUCOSE into the liver, muscle, and ADIPOSE TISSUE. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1335534"/>
		<OntoAD:gene_product_malfunction_associated_with_disease rdf:resource="&OntoAD;C0011849"/>
		<OntoAD:gene_product_has_associated_anatomy rdf:resource="&OntoAD;C0007603"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0206454"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1334396"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1335671"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0242210"/>
		<OntoAD:gene_product_plays_role_in_biological_process rdf:resource="&OntoAD;C0302820"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0023810">
		<skos:prefLabel xml:lang="en">Lipopolysaccharides</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Lipopolysaccharides</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Lipopolysaccharides</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Lipopolysaccharides</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Lipoglycans</skos:altLabel>
		<skos:altLabel xml:lang="en">LPS</skos:altLabel>
		<skos:altLabel xml:lang="en">Lipopolysaccharide</skos:altLabel>
		<skos:altLabel xml:lang="en">lipopolysaccharide (LPS)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Lipopolyosides</skos:altLabel>
		<skos:altLabel xml:lang="fr">Lipoglycanes</skos:altLabel>
		<skos:altLabel xml:lang="fr">Lipoglycannes</skos:altLabel>
		<skos:altLabel xml:lang="fr">lipopolysaccharide</skos:altLabel>
		<skos:definition xml:lang="en">Lipid-containing polysaccharides which are endotoxins and important group-specific antigens. They are often derived from the cell wall of gram-negative bacteria and induce immunoglobulin secretion. The lipopolysaccharide molecule consists of three parts: LIPID A, core polysaccharide, and O-specific chains (O ANTIGENS). When derived from Escherichia coli, lipopolysaccharides serve as polyclonal B-cell mitogens commonly used in laboratory immunology. (From Dorland, 28th ed) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0023779"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0032594"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0062503">
		<skos:prefLabel xml:lang="en">Heparan Sulfate Proteoglycans</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">HeparanSulfateProteoglycans</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Protéoglycanes à sulfate d'héparane</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ProtéoglycanesÀSulfateD'héparane</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Proteoheparan Sulfate</skos:altLabel>
		<skos:altLabel xml:lang="en">HSPG</skos:altLabel>
		<skos:altLabel xml:lang="fr">Héparane sulfate protéoglycane</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéoglycane héparane sulfate</skos:altLabel>
		<skos:altLabel xml:lang="fr">HSPG</skos:altLabel>
		<skos:altLabel xml:lang="fr">Héparane-sulfate protéoglycane</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéoglycane à sulfate d'héparane</skos:altLabel>
		<skos:definition xml:lang="en">Ubiquitous macromolecules associated with the cell surface and extracellular matrix of a wide range of cells of vertebrate and invertebrate tissues. They are essential cofactors in cell-matrix adhesion processes, in cell-cell recognition systems, and in receptor-growth factor interactions. (From Cancer Metastasis Rev 1996; 15(2): 177-86; Hepatology 1996; 24(3): 524-32) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0033692"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0033692">
		<skos:prefLabel xml:lang="en">Proteoglycan</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Proteoglycan</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Protéoglycanes</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Protéoglycanes</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Proteoglycans</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéoglycannes</skos:altLabel>
		<skos:altLabel xml:lang="fr">protéoglycane</skos:altLabel>
		<skos:definition xml:lang="en">Glycoproteins which have a very high polysaccharide content. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0017968"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0017973"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0054444">
