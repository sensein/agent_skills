	<owl:Class rdf:about="&OntoAD;C0004763">
		<skos:prefLabel xml:lang="en">Barrett Esophagus</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">BarrettEsophagus</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Oesophage de Barrett</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">OesophageDeBarrett</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Columnar-lined esophagus</skos:altLabel>
		<skos:altLabel xml:lang="en">Barrett's oesophagitis</skos:altLabel>
		<skos:altLabel xml:lang="en">Barrett Syndrome</skos:altLabel>
		<skos:altLabel xml:lang="en">CELLO  Col epith-lin low oeso</skos:altLabel>
		<skos:altLabel xml:lang="en">CELLO  Columnar epithelial-lined lower esophagus</skos:altLabel>
		<skos:altLabel xml:lang="en">CLE  Columnar-lined esophagus</skos:altLabel>
		<skos:altLabel xml:lang="en">CLE  Columnar-lined oeso</skos:altLabel>
		<skos:altLabel xml:lang="en">Columnar epith-lined low oeso</skos:altLabel>
		<skos:altLabel xml:lang="en">Columnar epithelial-lined lower esophagus</skos:altLabel>
		<skos:altLabel xml:lang="en">Gastric metaplasia of esophagus</skos:altLabel>
		<skos:altLabel xml:lang="en">BO  Barrett's oesophagus</skos:altLabel>
		<skos:altLabel xml:lang="en">Barrett's esophagus</skos:altLabel>
		<skos:altLabel xml:lang="en">Endobrachyoesophagus</skos:altLabel>
		<skos:altLabel xml:lang="en">Endobrachyooesophagus</skos:altLabel>
		<skos:altLabel xml:lang="en">Barrett</skos:altLabel>
		<skos:altLabel xml:lang="en">CELLO</skos:altLabel>
		<skos:altLabel xml:lang="en">CLE</skos:altLabel>
		<skos:altLabel xml:lang="en">Barrett's disease</skos:altLabel>
		<skos:altLabel xml:lang="fr">Endobrachyoesophage</skos:altLabel>
		<skos:altLabel xml:lang="fr">Syndrome de Barrett</skos:altLabel>
		<skos:altLabel xml:lang="fr">Oesophagite de Barrett</skos:altLabel>
		<skos:altLabel xml:lang="fr">Endo-brachy-oesophage de Barrett</skos:altLabel>
		<skos:altLabel xml:lang="fr">Endobrachy-oesophage de Barrett</skos:altLabel>
		<skos:altLabel xml:lang="fr">ulcère de Barrett</skos:altLabel>
		<skos:altLabel xml:lang="fr">métaplasie gastrique de l'oesophage</skos:altLabel>
		<skos:altLabel xml:lang="fr">métaplasie gastrique oesophagienne</skos:altLabel>
		<skos:definition xml:lang="en">A condition with damage to the lining of the lower ESOPHAGUS resulting from chronic acid reflux (ESOPHAGITIS, REFLUX). Through the process of metaplasia, the squamous cells are replaced by a columnar epithelium with cells resembling those of the INTESTINE or the salmon-pink mucosa of the STOMACH. Barrett's columnar epithelium is a marker for severe reflux and precursor to ADENOCARCINOMA of the esophagus. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1333465"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1290615"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:disease_may_have_finding rdf:resource="&OntoAD;C0041582"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1705452">
		<skos:prefLabel xml:lang="en">EIF2B5 wt Allele</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">EIF2B5WtAllele</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">CLE</skos:altLabel>
		<skos:altLabel xml:lang="en">CACH</skos:altLabel>
		<skos:altLabel xml:lang="en">LVWM</skos:altLabel>
		<skos:altLabel xml:lang="en">Eukaryotic Translation Initiation Factor 2B, Subunit 5 Epsilon, 82kDa wt Allele</skos:altLabel>
		<skos:altLabel xml:lang="en">EIF2BE</skos:altLabel>
		<skos:definition xml:lang="en">Human EIF2B5 wild-type allele is located in the vicinity of 3q27.1 and is approximately 10 kb in length. This allele, which encodes translation initiation factor eIF-2B subunit epsilon protein, is involved in the regulation of messenger RNA translation. Genetic mutations in the allele are linked to Cree leukoencephalopathy, leukoencephalopathy with vanishing white matter and ovarioleukodystrophy. (SwissProt) (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1414331"/>
		<OntoAD:gene_associated_with_disease rdf:resource="&OntoAD;C0270612"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1524082">
		<skos:prefLabel xml:lang="en">Derivation procedure</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">DerivationProcedure</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Derivation</skos:altLabel>
		<skos:definition xml:lang="en">A drawing of fluids from one part of the body to another, to relieve symptoms, reduce the inflammation or to otherwise lessen a morbid process. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0030231"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0525045">
