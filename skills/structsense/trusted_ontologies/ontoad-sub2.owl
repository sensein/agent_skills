		<OntoAD:has_physical_part_of_anatomic_structure rdf:resource="&OntoAD;C0023516"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0851353">
		<skos:prefLabel xml:lang="en">Blood and lymphatic system disorders</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">BloodAndLymphaticSystemDisorders</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Affections hématologiques et du système lymphatique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AffectionsHématologiquesEtDuSystèmeLymphatique</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Blood and Lymphatic Disorders</skos:altLabel>
		<skos:altLabel xml:lang="en">Hematopoietic and Lymphoid System Disease</skos:altLabel>
		<skos:altLabel xml:lang="en">Hematopoietic and Lymphoid System Disorder</skos:altLabel>
		<skos:definition xml:lang="en">Any deviation from the normal structure or function of the blood or lymphatic system that is manifested by a characteristic set of symptoms and signs. (NCI) (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1333305"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0032042">
		<skos:prefLabel xml:lang="en">Placebos</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Placebos</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Placebo</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Placebo</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">placebo</skos:altLabel>
		<skos:altLabel xml:lang="en">Placebo (Medicine)</skos:altLabel>
		<skos:altLabel xml:lang="en">Sham Treatment</skos:altLabel>
		<skos:altLabel xml:lang="en">sham therapy</skos:altLabel>
		<skos:altLabel xml:lang="en">PLCB</skos:altLabel>
		<skos:altLabel xml:lang="en">fake drug</skos:altLabel>
		<skos:altLabel xml:lang="en">placebo therapy</skos:altLabel>
		<skos:altLabel xml:lang="fr">Traitement fictif</skos:altLabel>
		<skos:definition xml:lang="en">Any dummy medication or treatment. Although placebos originally were medicinal preparations having no specific pharmacological activity against a targeted condition, the concept has been extended to include treatments or procedures, especially those administered to control groups in clinical trials in order to provide baseline measurements for the experimental protocol. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">http://www.fnclcc.fr/fr/patients/dico/definition.php?id_definition=1270 (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;TherapeuticOrPreventiveProcedure"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1706408">
		<skos:prefLabel xml:lang="en">Placebo Control</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">PlaceboControl</skos:hiddenLabel>
		<skos:definition xml:lang="en">Use of an inactive compound identical in appearance to drug or treatment being tested in experimental research, which may or may not be known to the physician and/or subject, administered to distinguish between drug action and suggestive effect of the drug or treatment under study. The effects of the active drug or treatment are compared to the effects of the placebo. (NCI) (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;ResearchActivity"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0002085">
