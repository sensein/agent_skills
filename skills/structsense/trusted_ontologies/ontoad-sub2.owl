	<owl:Class rdf:about="&OntoAD;C0009240">
		<skos:prefLabel xml:lang="en">Cognition</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Cognition</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Cognition</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Cognition</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">cognition/thought processes</skos:altLabel>
		<skos:altLabel xml:lang="fr">processus cognitifs</skos:altLabel>
		<skos:definition xml:lang="en">Intellectual or mental process whereby an organism becomes aware of or obtains knowledge. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Fonctions mentales générales nécessaires pour comprendre et intégrer de façon constructive les diverses fonctions mentales, y compris toutes les fonctions cognitives et leur développement au cours de la vie. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;MentalProcess"/>
		<OntoAD:biological_process_has_associated_location rdf:resource="&OntoAD;C0006104"/>
		<OntoAD:biological_process_is_part_of_process rdf:resource="&OntoAD;C0004927"/>
		<OntoAD:process_includes_biological_process rdf:resource="&OntoAD;C0004448"/>
		<OntoAD:process_includes_biological_process rdf:resource="&OntoAD;C0030971"/>
		<OntoAD:biological_process_has_associated_location rdf:resource="&OntoAD;C0027763"/>
		<OntoAD:process_includes_biological_process rdf:resource="&OntoAD;C0023185"/>
		<OntoAD:has_sign_or_symptom rdf:resource="&OntoAD;C0233569"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0085537">
		<skos:prefLabel xml:lang="en">Caregiver</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Caregiver</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Aidants</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Aidants</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">caregivers</skos:altLabel>
		<skos:altLabel xml:lang="en">caregivers of persons</skos:altLabel>
		<skos:altLabel xml:lang="en">carers</skos:altLabel>
		<skos:altLabel xml:lang="en">care givers</skos:altLabel>
		<skos:altLabel xml:lang="fr">aidant</skos:altLabel>
		<skos:altLabel xml:lang="fr">Soignant</skos:altLabel>
		<skos:altLabel xml:lang="fr">soignants</skos:altLabel>
		<skos:altLabel xml:lang="fr">aidants de personnes</skos:altLabel>
		<skos:definition xml:lang="en">Persons who provide care to those who need supervision or assistance in illness or disability. They may provide the care in the home, in a hospital, or in an institution. Although caregivers include trained medical, nursing, and other health personnel, the concept also refers to parents, spouses, or other family members, friends, members of the clergy, teachers, social workers, fellow patients. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Individus délivrant des soins aux personnes qui ont besoin de surveillance ou d'aide du fait d''une maladie ou d'une incapacité. Ils peuvent délivrer ces soins à la maison, dans un hôpital, ou dans un établissement. Bien que les soignants incluent les médecins, les infirmiers et les professionnels de santé en général, le concept fait aussi allusion aux parents, aux conjoints, aux autres membres de la famille, aux amis, aux membres du clergé, aux professeurs, aux ouvriers sociaux, etc. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0580210"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0439793">
		<skos:prefLabel xml:lang="en">Severities</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Severities</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">sévérité</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Sévérité</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">severity</skos:altLabel>
		<skos:altLabel xml:lang="en">SEV</skos:altLabel>
		<skos:altLabel xml:lang="fr">dont la sévérité est</skos:altLabel>
		<skos:definition xml:lang="en">Used of the degree of something undesirable e.g. pain or weather; also, strictness. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;QualitativeConcept"/>
		<OntoAD:severity_of rdf:resource="&OntoAD;C0235146"/>
