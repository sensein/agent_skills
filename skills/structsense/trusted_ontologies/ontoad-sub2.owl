		<skos:altLabel xml:lang="fr">Tics (trouble)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tics anormaux</skos:altLabel>
		<skos:altLabel xml:lang="fr">Trouble de tic</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tic, sans précision</skos:altLabel>
		<skos:definition xml:lang="en">Disorders characterized by recurrent TICS that may interfere with speech and other activities. Tics are sudden, rapid, nonrhythmic, stereotyped motor movements or vocalizations which may be exacerbated by stress and are generally attenuated during absorbing activities. Tic disorders are distinguished from conditions which feature other types of abnormal movements that may accompany general medical conditions. (From DSM-IV, 1994) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0026650"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0178546"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0027763"/>
		<OntoAD:may_be_treated_by rdf:resource="&OntoAD;C0009011"/>
	</owl:Class>

