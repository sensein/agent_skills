	<owl:Class rdf:about="&OntoAD;C1955840">
		<skos:prefLabel xml:lang="en">Azabicyclo Compounds</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AzabicycloCompounds</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Composés azabicycliques</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ComposésAzabicycliques</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Azabicyclo compound</skos:altLabel>
		<skos:altLabel xml:lang="fr">Composés azotés bicycliques</skos:altLabel>
		<skos:definition xml:lang="en">Bicyclic bridged compounds that contain a nitrogen which has three bonds. The nomenclature indicates the number of atoms in each path around the rings, such as [2.2.2] for three equal length paths. Some members are TROPANES and BETA LACTAMS. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2585482"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0041177">
		<skos:prefLabel xml:lang="en">Tropanes</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Tropanes</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Tropanes</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Tropanes</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Tropane</skos:altLabel>
		<skos:altLabel xml:lang="en">Tropane alkaloid</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tropanines</skos:altLabel>
		<skos:definition xml:lang="en">N-methyl-8-azabicyclo[3.2.1]octanes best known for the ones found in PLANTS. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1955840"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0007412">
		<skos:prefLabel xml:lang="en">Catecholamines</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Catecholamines</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Catécholamines</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Catécholamines</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Sympathins</skos:altLabel>
		<skos:altLabel xml:lang="en">Total catecholamines</skos:altLabel>
		<skos:altLabel xml:lang="en">Coumel</skos:altLabel>
		<skos:altLabel xml:lang="en">Catecholamine</skos:altLabel>
		<skos:altLabel xml:lang="en">Catecholamine-class Agent</skos:altLabel>
		<skos:altLabel xml:lang="fr">catécholamine</skos:altLabel>
		<skos:definition xml:lang="en">A general class of ortho-dihydroxyphenylalkylamines derived from tyrosine. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0019932"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0027908"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0301822">
		<skos:prefLabel xml:lang="en">Adrenal medullary hormone</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AdrenalMedullaryHormone</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Adrenal Medulla Hormones</skos:altLabel>
		<skos:altLabel xml:lang="fr">hormone médullosurrénalienne</skos:altLabel>
		<skos:definition xml:lang="en">chemical substances having a specific regulatory effect on the activity of a certain organ or organs; secreted by the inner part of the adrenal gland. (source : CSP)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1445654"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1445654">
		<skos:prefLabel xml:lang="en">Adrenal hormone preparation</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AdrenalHormonePreparation</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Adrenal hormone</skos:altLabel>
		<skos:altLabel xml:lang="en">Corticosteroid preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">Adrenal</skos:altLabel>
		<skos:altLabel xml:lang="en">Adrenal hormone agent</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation d'hormone surrénalienne</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation de corticostéroïde</skos:altLabel>
		<skos:altLabel xml:lang="fr">hormone surrénalienne</skos:altLabel>
		<skos:definition xml:lang="en">Hormones made from cholesterol and protein produced by the adrenal glands and regulate electrolyte balance, blood pressure, inflammation, blood sugar balance, and immune system control. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0729633"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0019928"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0556082">
