	<owl:Class rdf:about="&OntoAD;C0040300">
		<skos:prefLabel xml:lang="en">Body tissue</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">BodyTissue</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Tissus</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Tissus</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">tissue</skos:altLabel>
		<skos:altLabel xml:lang="en">Tissue Types</skos:altLabel>
