	<owl:Class rdf:about="&OntoAD;C0003850">
		<skos:prefLabel xml:lang="en">Arteriosclerosis</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Arteriosclerosis</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Artériosclérose</skos:prefLabel>
