		<skos:altLabel xml:lang="fr">connaissances</skos:altLabel>
		<skos:definition xml:lang="en">The body of truths or facts accumulated in the course of time, the cumulated sum of information, its volume and nature, in any civilization, period, or country. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Verités ou faits accumulés dans le temps, somme cumulée d'informations, son importance et sa nature, dans n'importe quelle civilisation, période, ou pays. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;IntellectualProduct"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0234421">
