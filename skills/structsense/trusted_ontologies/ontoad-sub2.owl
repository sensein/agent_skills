		<skos:hiddenLabel xml:lang="en">PalliativeCare</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Soins palliatifs</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">SoinsPalliatifs</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">comfort care</skos:altLabel>
		<skos:altLabel xml:lang="en">end-of-life care</skos:altLabel>
		<skos:altLabel xml:lang="en">Palliative Treatment</skos:altLabel>
		<skos:altLabel xml:lang="en">Therapy, Palliative</skos:altLabel>
		<skos:altLabel xml:lang="en">Symptoms Management</skos:altLabel>
		<skos:altLabel xml:lang="en">PALLIATIVE THER</skos:altLabel>
		<skos:altLabel xml:lang="en">palliation</skos:altLabel>
		<skos:altLabel xml:lang="fr">Traitement palliatif</skos:altLabel>
		<skos:altLabel xml:lang="fr">Thérapie palliative</skos:altLabel>
		<skos:definition xml:lang="en">Care alleviating symptoms without curing the underlying disease. (Stedman, 25th ed) (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">http://www.fnclcc.fr/fr/patients/dico/definition.php?id_definition=1187 (source : CISMeF)</skos:definition>
