		<skos:altLabel xml:lang="fr">mammaire</skos:altLabel>
		<skos:definition xml:lang="en">In humans, one of the paired regions in the anterior portion of the THORAX. The breasts consist of the MAMMARY GLANDS, the SKIN, the MUSCLES, the ADIPOSE TISSUE, and the CONNECTIVE TISSUES. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1285092"/>
		<OntoAD:finding_site_of rdf:resource="&OntoAD;C0006142"/>
