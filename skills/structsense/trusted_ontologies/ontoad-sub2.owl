		<skos:hiddenLabel xml:lang="en">PortionOfMuscleTissue</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Muscle tissue</skos:altLabel>
		<skos:altLabel xml:lang="en">Textus muscularis</skos:altLabel>
		<skos:definition xml:lang="en">Tissue, which consists of muscle cells surrounded by sheets of collagen. Examples: cardiac muscle, skeletal muscle, smooth muscle. (source : UWDA)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0040300"/>
	</owl:Class>

