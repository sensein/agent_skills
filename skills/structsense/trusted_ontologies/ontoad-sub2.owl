		<skos:altLabel xml:lang="en">Major depressive illness</skos:altLabel>
		<skos:altLabel xml:lang="en">MDD</skos:altLabel>
		<skos:altLabel xml:lang="en">DEPRESSIVE DIS MAJOR</skos:altLabel>
		<skos:altLabel xml:lang="en">Depressive Disorder, Major</skos:altLabel>
