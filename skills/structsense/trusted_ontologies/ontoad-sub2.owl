	<owl:Class rdf:about="&OntoAD;C0026867">
		<skos:prefLabel xml:lang="en">Music</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Music</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Musique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Musique</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">musical arts</skos:altLabel>
		<skos:altLabel xml:lang="en">Musics</skos:altLabel>
		<skos:definition xml:lang="en">science or art of ordering tones or sounds in succession, in combination and temporal relationships to produce a composition having unity and continuity. (source : CSP)</skos:definition>
		<skos:definition xml:lang="fr">http://www.fnclcc.fr/fr/patients/dico/definition.php?id_definition=1083 (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;IntellectualProduct"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0027396">
		<skos:prefLabel xml:lang="en">Naproxen</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Naproxen</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Naproxène</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Naproxène</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Methoxypropiocin</skos:altLabel>
		<skos:altLabel xml:lang="en">MNPA</skos:altLabel>
		<skos:altLabel xml:lang="en">Naproxen product</skos:altLabel>
		<skos:altLabel xml:lang="en">d-2-(6-Methoxy-2-naphthyl)propionic Acid</skos:altLabel>
		<skos:altLabel xml:lang="en">non-prescription naproxen</skos:altLabel>
		<skos:altLabel xml:lang="fr">Naproxen</skos:altLabel>
		<skos:definition xml:lang="en">An anti-inflammatory agent with analgesic and antipyretic properties. Both the acid and its sodium salt are used in the treatment of rheumatoid arthritis and other rheumatic or musculoskeletal disorders, dysmenorrhea, and acute gout. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0085387"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1626403"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0018100"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0029408"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0021368"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0018099"/>
		<OntoAD:may_prevent rdf:resource="&OntoAD;C0030193"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013182"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0027817">
		<skos:prefLabel xml:lang="en">Neurobiology</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Neurobiology</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Neurobiologie</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Neurobiologie</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Neural Growth/Development/Degeneration</skos:altLabel>
		<skos:altLabel xml:lang="en">NEUROBIOL</skos:altLabel>
		<skos:altLabel xml:lang="fr">Neuro-biologie</skos:altLabel>
		<skos:definition xml:lang="en">The study of the structure, growth, activities, and functions of NEURONS and the NERVOUS SYSTEM. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;BiomedicalOccupationOrDiscipline"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0870956">
		<skos:prefLabel xml:lang="en">Neuropsychiatry</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Neuropsychiatry</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Neuropsychiatrie</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Neuropsychiatrie</skos:hiddenLabel>
		<skos:altLabel xml:lang="fr">Neuro-psychiatrie</skos:altLabel>
		<skos:definition xml:lang="en">A subfield of psychiatry that emphasizes the somatic substructure on which mental operations and emotions are based, and the functional or organic disturbances of the central nervous system that give rise to, contribute to, or are associated with mental and emotional disorders. (From Campbell's Psychiatric Dictionary, 8th ed.) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0033873"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0028094">
		<skos:prefLabel xml:lang="en">Nimodipine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Nimodipine</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Nimodipine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Nimodipine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">NIMO</skos:altLabel>
		<skos:altLabel xml:lang="fr">Bay-e 9736</skos:altLabel>
		<skos:definition xml:lang="en">A calcium channel blockader with preferential cerebrovascular activity. It has marked cerebrovascular dilating effects and lowers blood pressure. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0042402"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2945601"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0020649"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013182"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0028423">
		<skos:prefLabel xml:lang="en">Norway</skos:prefLabel>
