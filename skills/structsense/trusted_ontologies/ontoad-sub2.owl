		<skos:hiddenLabel xml:lang="en">OralHealth</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Santé buccodentaire</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">SantéBuccodentaire</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Dental Health</skos:altLabel>
		<skos:altLabel xml:lang="fr">Santé bucco-dentaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">Santé dentaire</skos:altLabel>
