	<owl:Class rdf:about="&OntoAD;C0010090">
		<skos:prefLabel xml:lang="en">Corpus Callosum</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CorpusCallosum</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Corps calleux</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">CorpsCalleux</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Corpus callosum structure</skos:altLabel>
		<skos:altLabel xml:lang="en">CC  Corpus callosum</skos:altLabel>
		<skos:altLabel xml:lang="en">Corpus Callosums</skos:altLabel>
		<skos:altLabel xml:lang="en">Commissura magna</skos:altLabel>
		<skos:altLabel xml:lang="en">interhemispheric commissure</skos:altLabel>
		<skos:altLabel xml:lang="fr">Corpus callosum</skos:altLabel>
		<skos:altLabel xml:lang="fr">corps calleux, SAI</skos:altLabel>
		<skos:definition xml:lang="en">Broad plate of dense myelinated fibers that reciprocally interconnect regions of the cortex in all lobes with corresponding regions of the opposite hemisphere. The corpus callosum is located deep in the longitudinal fissure. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0152295"/>
		<OntoAD:anatomic_structure_is_physical_part_of rdf:resource="&OntoAD;C0006104"/>
