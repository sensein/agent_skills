	<owl:Class rdf:about="&OntoAD;C0149778">
		<skos:prefLabel xml:lang="en">Soft Tissue Infections</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">SoftTissueInfections</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Infections des tissus mous</skos:prefLabel>
