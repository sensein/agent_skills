		<skos:altLabel xml:lang="fr">Médicaments adrénergiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">agent sympathomimétique</skos:altLabel>
		<skos:altLabel xml:lang="fr">agent adrénergique</skos:altLabel>
		<skos:definition xml:lang="en">Drugs that act on adrenergic receptors or affect the life cycle of adrenergic transmitters. Included here are adrenergic agonists and antagonists and agents that affect the synthesis, storage, uptake, metabolism, or release of adrenergic transmitters. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2697973"/>
	</owl:Class>

