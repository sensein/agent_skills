		<rdfs:subClassOf rdf:resource="&OntoAD;C1305879"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0153474"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0496838"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0153392"/>
