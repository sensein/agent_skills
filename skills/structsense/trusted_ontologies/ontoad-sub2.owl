	<owl:Class rdf:about="&OntoAD;C0025309">
		<skos:prefLabel xml:lang="en">Meningoencephalitis</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Meningoencephalitis</skos:hiddenLabel>
