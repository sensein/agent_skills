		<skos:altLabel xml:lang="en">Contraceptive pills for bc</skos:altLabel>
		<skos:altLabel xml:lang="en">CONTRACEPTIVE PILLS FOR BIRTH CONTROL</skos:altLabel>
		<skos:altLabel xml:lang="en">oral contraceptives</skos:altLabel>
		<skos:altLabel xml:lang="fr">Contraceptif oral</skos:altLabel>
		<skos:altLabel xml:lang="fr">Contraceptifs par voie orale</skos:altLabel>
		<skos:altLabel xml:lang="fr">Pilules contraceptives</skos:altLabel>
		<skos:altLabel xml:lang="fr">COR (Contraceptifs ORaux)</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation de contraceptif oral</skos:altLabel>
		<skos:altLabel xml:lang="fr">pilule contraceptive</skos:altLabel>
		<skos:altLabel xml:lang="fr">agent contraceptif oral</skos:altLabel>
		<skos:definition xml:lang="en">Compounds, usually hormonal, taken orally in order to block ovulation and prevent the occurrence of pregnancy. The hormones are generally estrogen or progesterone or both. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0009871"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0036884"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0009871">
		<skos:prefLabel xml:lang="en">Contraceptive Agents</skos:prefLabel>
