	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0061465">
		<skos:prefLabel xml:lang="en">Glutamate Receptor</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">GlutamateReceptor</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Récepteurs au glutamate</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">RécepteursAuGlutamate</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">GLUTAMATE RECEPT</skos:altLabel>
		<skos:altLabel xml:lang="en">Receptors, Glutamate</skos:altLabel>
		<skos:altLabel xml:lang="fr">Récepteur au glutamate</skos:altLabel>
		<skos:altLabel xml:lang="fr">Récepteurs de glutamate</skos:altLabel>
		<skos:definition xml:lang="en">Cell-surface proteins that bind glutamate and trigger changes which influence the behavior of cells. Glutamate receptors include ionotropic receptors (AMPA, kainate, and N-methyl-D-aspartate receptors), which directly control ion channels, and metabotropic receptors which act through second messenger systems. Glutamate receptors are the most common mediators of fast excitatory synaptic transmission in the central nervous system. They have also been implicated in the mechanisms of memory and of m (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;AminoAcid,Peptide,OrProtein"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;Receptor"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0071744">
		<skos:prefLabel xml:lang="en">Cystatin C (substance)</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CystatinC(substance)</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Cystatine C</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">CystatineC</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Cystatin C</skos:altLabel>
		<skos:altLabel xml:lang="en">Post-gamma-Globulin</skos:altLabel>
		<skos:altLabel xml:lang="en">gamma-Trace</skos:altLabel>
		<skos:altLabel xml:lang="en">Cystatin 3</skos:altLabel>
		<skos:altLabel xml:lang="en">Neuroendocrine Basic Polypeptide</skos:altLabel>
		<skos:altLabel xml:lang="fr">Neuroendocrine Basic Polypeptide</skos:altLabel>
		<skos:altLabel xml:lang="fr">Post-gamma-globuline</skos:altLabel>
		<skos:altLabel xml:lang="fr">gamma-Trace</skos:altLabel>
		<skos:altLabel xml:lang="fr">Cystatine-3</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine CST3</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine CST-3</skos:altLabel>
		<skos:definition xml:lang="en">An extracellular cystatin subtype that is abundantly expressed in bodily fluids. It may play a role in the inhibition of interstitial CYSTEINE PROTEASES. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1291116"/>
		<OntoAD:gene_product_malfunction_associated_with_disease rdf:resource="&OntoAD;C0242383"/>
		<OntoAD:gene_product_malfunction_associated_with_disease rdf:resource="&OntoAD;C0002726"/>
