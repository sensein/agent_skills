	<owl:Class rdf:about="&OntoAD;C1138412">
		<skos:prefLabel xml:lang="en">Diet, Mediterranean</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Diet,Mediterranean</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Régime méditerranéen</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">RégimeMéditerranéen</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Mediterranean diet</skos:altLabel>
		<skos:altLabel xml:lang="fr">Régime alimentaire méditerranéen</skos:altLabel>
		<skos:definition xml:lang="en">A diet typical of the Mediterranean region characterized by a pattern high in fruits and vegetables, cereals and bread, potatoes, poultry, beans, nuts, olive oil and fish while low in red meat and dairy and moderate in alcohol consumption. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">régime typique de la région Méditerranéenne caractérisée par un dessin haut dans les fruits et les légumes, les céréales et le pain, les pommes de terre, la volaille, les haricots, les noix, l'huile d'olive et le poisson pendant que bas dans la viande rouge et la crémerie et modéré dans la consommation d'alcool. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0012159"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0242606">
		<skos:prefLabel xml:lang="en">Oxidative Stress</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">OxidativeStress</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Stress oxydatif</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">StressOxydatif</skos:hiddenLabel>
		<skos:altLabel xml:lang="fr">stress oxydant</skos:altLabel>
		<skos:altLabel xml:lang="fr">Stress oxydatifs</skos:altLabel>
		<skos:definition xml:lang="en">A disturbance in the prooxidant-antioxidant balance in favor of the former, leading to potential damage. Indicators of oxidative stress include damaged DNA bases, protein oxidation products, and lipid peroxidation products (Sies, Oxidative Stress, 1991, pxv-xvi). (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">troubles dans l'équilibre prooxidant-antioxydant en faveur du premier, causant des dommages potentiels. Les indicateurs de tension de l'oxydant incluent des bases d'ADN endommagées, des produits d'oxydation de protéines et des produits de péroxidation de lipides (Sies, Oxidative Stress, 1991, pxv-xvi). (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1516373"/>
		<OntoAD:biological_process_involves_gene_product rdf:resource="&OntoAD;C0611285"/>
		<OntoAD:process_involves_gene rdf:resource="&OntoAD;C1364818"/>
		<OntoAD:process_involves_gene rdf:resource="&OntoAD;C1705543"/>
		<OntoAD:biological_process_has_initiator_chemical_or_drug rdf:resource="&OntoAD;C0016693"/>
		<OntoAD:biological_process_involves_gene_product rdf:resource="&OntoAD;C0007367"/>
		<OntoAD:biological_process_has_result_biological_process rdf:resource="&OntoAD;C1516374"/>
		<OntoAD:biological_process_has_result_biological_process rdf:resource="&OntoAD;C0012899"/>
	</owl:Class>

