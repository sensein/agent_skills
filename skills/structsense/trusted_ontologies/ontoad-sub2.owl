	<owl:Class rdf:about="&OntoAD;C0085552">
		<skos:prefLabel xml:lang="en">Health Care Costs</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">HealthCareCosts</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Coûts des soins de santé</skos:prefLabel>
