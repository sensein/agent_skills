	<owl:Class rdf:about="&OntoAD;C0027793">
		<skos:prefLabel xml:lang="en">Synaptic Transmission</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">SynapticTransmission</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Transmission synaptique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">TransmissionSynaptique</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">neurotransmission</skos:altLabel>
		<skos:altLabel xml:lang="en">Neural Transmission</skos:altLabel>
		<skos:altLabel xml:lang="en">Nerve Impulse Transmission</skos:altLabel>
		<skos:altLabel xml:lang="en">Synaptic transmission, function</skos:altLabel>
		<skos:altLabel xml:lang="en">Nerve Transmission</skos:altLabel>
		<skos:altLabel xml:lang="en">Neuronal Transmission</skos:altLabel>
		<skos:altLabel xml:lang="en">NEURAL TRANSM</skos:altLabel>
		<skos:altLabel xml:lang="en">SYNAPTIC TRANSM</skos:altLabel>
		<skos:altLabel xml:lang="en">signal transmission across a synapse</skos:altLabel>
		<skos:altLabel xml:lang="fr">Transmission nerveuse</skos:altLabel>
		<skos:altLabel xml:lang="fr">Transmission neurale</skos:altLabel>
		<skos:definition xml:lang="en">The communication from a NEURON to a target (neuron, muscle, or secretory cell) across a SYNAPSE. In chemical synaptic transmission, the presynaptic neuron releases a NEUROTRANSMITTER that diffuses across the synaptic cleft and binds to specific synaptic receptors, activating them. The activated receptors modulate specific ion channels and/or second-messenger systems in the postsynaptic cell. In electrical synaptic transmission, electrical signals are communicated as an ionic current flow across (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;CellFunction"/>
		<OntoAD:biological_process_has_associated_location rdf:resource="&OntoAD;C0027882"/>
		<OntoAD:biological_process_involves_gene_product rdf:resource="&OntoAD;C0285890"/>
		<OntoAD:biological_process_involves_gene_product rdf:resource="&OntoAD;C0037659"/>
		<OntoAD:biological_process_involves_gene_product rdf:resource="&OntoAD;C0038585"/>
		<OntoAD:biological_process_has_initiator_chemical_or_drug rdf:resource="&OntoAD;C0027908"/>
		<OntoAD:biological_process_involves_gene_product rdf:resource="&OntoAD;C0040162"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0027908">
		<skos:prefLabel xml:lang="en">Neurotransmitters</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Neurotransmitters</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Neurotransmetteur</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Neurotransmetteur</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">neurotransmitter</skos:altLabel>
		<skos:altLabel xml:lang="en">Transmitter Substances, Nerve</skos:altLabel>
		<skos:altLabel xml:lang="en">NERVE TRANSM SUBSTANCES</skos:altLabel>
		<skos:altLabel xml:lang="en">NEUROTRANSM</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médiateurs chimiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Neurotransmetteurs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Neuromédiateurs endogènes</skos:altLabel>
		<skos:definition xml:lang="en">Endogenous signaling molecules secreted by neurons that alter the behavior of neurons or effector cells. Neurotransmitter is used here in its most general sense, including not only messengers that act directly to regulate ion channels, but also those that act through second messenger systems, and those that act at a distance from their site of release. Included are neuromodulators, neuroregulators, neuromediators, neurohormones, and neurohumors, whether or not acting at synapses. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2979985"/>
		<OntoAD:chemical_or_drug_initiates_biological_process rdf:resource="&OntoAD;C0027793"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0028630">
		<skos:prefLabel xml:lang="en">Nucleotides</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Nucleotides</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Nucléotides</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Nucléotides</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Nucleotide</skos:altLabel>
		<skos:altLabel xml:lang="fr">Nucléotide</skos:altLabel>
		<skos:definition xml:lang="en">The monomeric units from which DNA or RNA polymers are constructed. They consist of a purine or pyrimidine base, a pentose sugar, and a phosphate group. (From King and Stansfield, A Dictionary of Genetics, 4th ed) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0028622"/>
		<OntoAD:constitutional_part_of rdf:resource="&OntoAD;C0017366"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0029089">
		<skos:prefLabel xml:lang="en">Ophthalmoplegia</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Ophthalmoplegia</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Ophtalmoplégie</skos:prefLabel>
