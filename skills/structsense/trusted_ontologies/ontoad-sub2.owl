		<skos:hiddenLabel xml:lang="en">PhysicalChemicalTechnique</skos:hiddenLabel>
		<skos:definition xml:lang="en">Techniques based on the principles of physical and chemical science, for the study of biological problems. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0035177"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1179862">
		<skos:prefLabel xml:lang="en">Portion of cell substance</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">PortionOfCellSubstance</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Cell substance</skos:altLabel>
		<skos:definition xml:lang="en">Portion of body substance in liquid state contained in a cell cavity proper, cavity of cell nucleus or cavity of cytoplasmic organelle. Examples: mitochondrial matrix, vacuoplasm. (source : FMA)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0504082"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1511146">
		<skos:prefLabel xml:lang="en">Biological Immunotherapy</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">BiologicalImmunotherapy</skos:hiddenLabel>
		<skos:definition xml:lang="en">The use of biological agents to enhance the host immune system. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0021083"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1709342">
		<skos:prefLabel xml:lang="en">Organo-nitrogen Carcinogen</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Organo-nitrogenCarcinogen</skos:hiddenLabel>
		<skos:definition xml:lang="en">An organic carcinogen having a C-N bond incorporated in its structure. (NCI05) (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1709339"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1708357">
		<skos:prefLabel xml:lang="en">Heterocyclic Amine Carcinogen</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">HeterocyclicAmineCarcinogen</skos:hiddenLabel>
		<skos:definition xml:lang="en">A cyclic compound that has at least one nitrogen incorporated into its structure instead of carbon and contains an amino (-NH2) group. Heterocyclic Amines are formed from cooking meat such as beef, pork, fowl, and fish when amino acids and creatine (found in muscle) react at high temperatures. Because of the high temperatures used, frying, broiling, and barbecuing produce the largest amounts of heterocyclic amines. These compounds that result from cooking meat may increase human cancer risk. (NC (source : )</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1709342"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0026193">
		<skos:prefLabel xml:lang="en">Minor (person)</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Minor(person)</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Mineurs</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Mineurs</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Minor</skos:altLabel>
		<skos:altLabel xml:lang="en">Minors</skos:altLabel>
		<skos:definition xml:lang="en">A person who has not attained the age at which full civil rights are accorded. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1444710"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0751792">
		<skos:prefLabel xml:lang="en">Trauma, Nervous System</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Trauma,NervousSystem</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Traumatismes du système nerveux</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">TraumatismesDuSystèmeNerveux</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Neurological injury</skos:altLabel>
		<skos:altLabel xml:lang="en">Nervous System Injuries</skos:altLabel>
		<skos:altLabel xml:lang="en">Injury of nervous system</skos:altLabel>
		<skos:altLabel xml:lang="en">Neurological Damage</skos:altLabel>
		<skos:altLabel xml:lang="en">INJ NERVOUS SYSTEM</skos:altLabel>
		<skos:definition xml:lang="en">Traumatic injuries to the brain, cranial nerves, spinal cord, autonomic nervous system, or neuromuscular system, including iatrogenic injuries induced by surgical procedures. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0027765"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0175677"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C3263723"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0027763"/>
		<OntoAD:has_associated_morphology rdf:resource="&OntoAD;C0221206"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1332163">
		<skos:prefLabel xml:lang="en">Adaptor Signaling Protein Gene</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AdaptorSignalingProteinGene</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Adaptor Protein Gene</skos:altLabel>
		<skos:definition xml:lang="en">A class of genes that encode signaling pathway proteins that function to mediate the coupling of multiple cell surface receptors to downstream signaling pathways in the regulation of various cellular functions. (from Oncogene 2001;20:6315-21) (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0935996"/>
		<OntoAD:gene_encodes_gene_product rdf:resource="&OntoAD;C1451357"/>
		<OntoAD:gene_plays_role_in_process rdf:resource="&OntoAD;C0037083"/>
		<OntoAD:gene_encodes_gene_product rdf:resource="&OntoAD;C1135629"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0282532">
		<skos:prefLabel xml:lang="en">Antineoplastic Agents, Alkylating</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AntineoplasticAgents,Alkylating</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Antinéoplasiques alcoylants</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AntinéoplasiquesAlcoylants</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Antineoplastics, Alkylating</skos:altLabel>
		<skos:altLabel xml:lang="en">Antineoplastic Drugs, Alkylating</skos:altLabel>
		<skos:altLabel xml:lang="en">ANTINEOPLASTICS,ALKYLATING AGENTS</skos:altLabel>
		<skos:altLabel xml:lang="en">Chemotherapy Alkylating Agents</skos:altLabel>
		<skos:altLabel xml:lang="en">Chemotherapy Alkylators</skos:altLabel>
		<skos:altLabel xml:lang="en">ALKYLATING AGENTS ANTINEOPL</skos:altLabel>
		<skos:altLabel xml:lang="en">ALKYLATING ANTINEOPL</skos:altLabel>
		<skos:altLabel xml:lang="en">ALKYLATING ANTINEOPL DRUGS</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents anticancéreux alkylants</skos:altLabel>
		<skos:altLabel xml:lang="fr">Anticancéreux alcoylants</skos:altLabel>
		<skos:altLabel xml:lang="fr">Antinéoplasiques alkylants</skos:altLabel>
		<skos:altLabel xml:lang="fr">Anticancéreux alkylants</skos:altLabel>
		<skos:definition xml:lang="en">A class of drugs that differs from other alkylating agents used clinically in that they are monofunctional and thus unable to cross-link cellular macromolecules. Among their common properties are a requirement for metabolic activation to intermediates with antitumor efficacy and the presence in their chemical structures of N-methyl groups, that after metabolism, can covalently modify cellular DNA. The precise mechanisms by which each of these drugs acts to kill tumor cells are not completely und (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003392"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1292533">
		<skos:prefLabel xml:lang="en">Tissue specimen</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">TissueSpecimen</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Tissue Sample</skos:altLabel>
		<skos:definition xml:lang="en">A piece of tissue removed from an organism for examination, analysis, or propagation. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2347026"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0586522"/>
		<OntoAD:specimen_of rdf:resource="&OntoAD;C0430445"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0870032">
		<skos:prefLabel xml:lang="en">Skin AND subcutaneous tissue structure</skos:prefLabel>
