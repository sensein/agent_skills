		<skos:altLabel xml:lang="en">Menstruation, normal</skos:altLabel>
		<skos:altLabel xml:lang="en">Menstrual flow</skos:altLabel>
		<skos:altLabel xml:lang="en">Menses</skos:altLabel>
		<skos:altLabel xml:lang="en">Menstruation, function</skos:altLabel>
		<skos:altLabel xml:lang="en">menstrual period</skos:altLabel>
