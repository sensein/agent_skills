		<skos:altLabel xml:lang="en">the senses</skos:altLabel>
		<skos:altLabel xml:lang="en">Sensory perception, function</skos:altLabel>
		<skos:altLabel xml:lang="en">Finding of sensation</skos:altLabel>
		<skos:altLabel xml:lang="en">Organoleptic</skos:altLabel>
		<skos:altLabel xml:lang="fr">Organoleptique</skos:altLabel>
		<skos:altLabel xml:lang="fr">esthésie</skos:altLabel>
		<skos:altLabel xml:lang="fr">perception sensorielle</skos:altLabel>
		<skos:definition xml:lang="en">The process in which specialized SENSORY RECEPTOR CELLS transduce peripheral stimuli (physical or chemical) into NERVE IMPULSES which are then transmitted to the various sensory centers in the CENTRAL NERVOUS SYSTEM. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0027903"/>
