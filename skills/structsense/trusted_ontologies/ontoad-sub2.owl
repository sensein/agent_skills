	<owl:Class rdf:about="&OntoAD;C0019116">
		<skos:prefLabel xml:lang="en">Hemostatic function</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">HemostaticFunction</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Hémostase</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Hémostase</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Hemostasis</skos:altLabel>
		<skos:altLabel xml:lang="en">Hemostatic</skos:altLabel>
		<skos:altLabel xml:lang="en">stopping bleeding</skos:altLabel>
		<skos:altLabel xml:lang="fr">fonction hémostatique</skos:altLabel>
		<skos:altLabel xml:lang="fr">coagulation sanguine</skos:altLabel>
		<skos:altLabel xml:lang="fr">hémostasie</skos:altLabel>
		<skos:altLabel xml:lang="fr">hémostatique</skos:altLabel>
		<skos:definition xml:lang="en">The process which spontaneously arrests the flow of BLOOD from vessels carrying blood under pressure. It is accomplished by contraction of the vessels, adhesion and aggregation of formed blood elements (eg. ERYTHROCYTE AGGREGATION), and the process of BLOOD COAGULATION. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0237477"/>
	</owl:Class>

