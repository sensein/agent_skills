		<OntoAD:anatomic_structure_is_physical_part_of rdf:resource="&OntoAD;C0027763"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0032615">
		<skos:prefLabel xml:lang="en">Polyunsaturated Fatty Acids</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">PolyunsaturatedFattyAcids</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Acides gras polyinsaturés</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AcidesGrasPolyinsaturés</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">PUFA  Polyunsat fatty acid</skos:altLabel>
		<skos:altLabel xml:lang="en">PUFA  Polyunsaturated fatty acid</skos:altLabel>
		<skos:altLabel xml:lang="en">PUFA</skos:altLabel>
		<skos:altLabel xml:lang="en">Polyunsaturated fatty acid</skos:altLabel>
		<skos:altLabel xml:lang="en">Fatty Acid, Total Polyunsaturated</skos:altLabel>
		<skos:altLabel xml:lang="fr">AGPI</skos:altLabel>
		<skos:altLabel xml:lang="fr">acides gras polysaturés</skos:altLabel>
		<skos:definition xml:lang="en">fatty acid containing more than one double bond (C=C). The essential fatty acids omega-3 and omega-6 are polyunsaturated fatty acids (PUFAs) that contain 2 or more cis double bonds. Dietary intake of some PUFAs may have beneficial effects on blood pressure, serum lipds, and inflammation. Some PUFAs, such as omega-3 PUFAs, may have antineoplastic or chemopreventive activities. (source : NCI)</skos:definition>
		<skos:definition xml:lang="fr">Acides gras dans lesquels la chaîne de carbone contient une ou plusieurs doubles ou triples liaisons carbone-carbone. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0015690"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2348264"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0034135">
		<skos:prefLabel xml:lang="en">Purine-Nucleoside Phosphorylase</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Purine-NucleosidePhosphorylase</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Purine nucleoside phosphorylase</skos:prefLabel>
