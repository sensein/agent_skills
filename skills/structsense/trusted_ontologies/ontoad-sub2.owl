		<rdfs:subClassOf rdf:resource="&OntoAD;C2015805"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1519022"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1134548">
		<skos:prefLabel xml:lang="en">herba scutellaria barbatae preparation</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">HerbaScutellariaBarbataePreparation</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Ban Zhi Lian</skos:altLabel>
		<skos:altLabel xml:lang="en">herba scutellaria barbata</skos:altLabel>
		<skos:altLabel xml:lang="en">HSB</skos:altLabel>
		<skos:altLabel xml:lang="en">Barbed Skullcap Herb</skos:altLabel>
		<skos:altLabel xml:lang="en">Scutellaria barbata (Aqueous Extract)</skos:altLabel>
		<skos:altLabel xml:lang="en">Scutellaria barbata</skos:altLabel>
		<skos:definition xml:lang="en">An herb that belongs to a group of herbs named the Scutellaria species or scullcap. Both the root and the above-ground part have been used to make herbal medicines. The root has been used in traditional Chinese medicine to treat lung cancer and other medical problems. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1516024"/>
	</owl:Class>

