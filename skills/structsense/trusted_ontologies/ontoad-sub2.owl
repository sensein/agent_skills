	<owl:Class rdf:about="&OntoAD;C0206111">
		<skos:prefLabel xml:lang="en">Enteric Nervous System</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">EntericNervousSystem</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Système nerveux entérique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">SystèmeNerveuxEntérique</skos:hiddenLabel>
		<skos:altLabel xml:lang="fr">Système nerveux autonome gastrointestinal</skos:altLabel>
		<skos:altLabel xml:lang="fr">Système nerveux autonome du tractus gastro-intestinal</skos:altLabel>
		<skos:altLabel xml:lang="fr">Système nerveux autonome gastro-intestinal</skos:altLabel>
		<skos:altLabel xml:lang="fr">Plexus nerveux entérique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Plexus entérique</skos:altLabel>
		<skos:altLabel xml:lang="fr">SNE (Système nerveux entérique)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Plexus entériques</skos:altLabel>
		<skos:definition xml:lang="en">Two ganglionated neural plexuses in the gut wall which form one of the three major divisions of the autonomic nervous system. The enteric nervous system innervates the gastrointestinal tract, the pancreas, and the gallbladder. It contains sensory neurons, interneurons, and motor neurons. Thus the circuitry can autonomously sense the tension and the chemical environment in the gut and regulate blood vessel tone, motility, secretions, and fluid transport. The system is itself governed by the centr (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;BodySystem"/>
		<OntoAD:regional_part_of rdf:resource="&OntoAD;C0027763"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0042024">
		<skos:prefLabel xml:lang="en">Urinary Incontinence</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">UrinaryIncontinence</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Incontinence urinaire</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">IncontinenceUrinaire</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">incontinence</skos:altLabel>
		<skos:altLabel xml:lang="en">Absence of bladder continence</skos:altLabel>
		<skos:altLabel xml:lang="en">Bladder incontinence</skos:altLabel>
		<skos:altLabel xml:lang="en">Urine incontinence</skos:altLabel>
		<skos:altLabel xml:lang="en">URINARY BLADDER INCONTINENCE</skos:altLabel>
		<skos:altLabel xml:lang="en">incontinent of urine</skos:altLabel>
		<skos:altLabel xml:lang="en">Micturition involuntary</skos:altLabel>
		<skos:altLabel xml:lang="en">Involuntary urination</skos:altLabel>
		<skos:altLabel xml:lang="en">Lack of bladder control</skos:altLabel>
		<skos:altLabel xml:lang="en">Loss of bladder control</skos:altLabel>
		<skos:altLabel xml:lang="en">Unable to control bladder</skos:altLabel>
		<skos:altLabel xml:lang="en">Unable to prevent bladder emptying</skos:altLabel>
		<skos:altLabel xml:lang="en">Unable prevent bladder emptyng</skos:altLabel>
		<skos:altLabel xml:lang="en">Weak bladder</skos:altLabel>
		<skos:altLabel xml:lang="en">Unable to hold fluids</skos:altLabel>
		<skos:altLabel xml:lang="en">Unable to hold urine</skos:altLabel>
		<skos:altLabel xml:lang="en">UI  Urinary incontinence</skos:altLabel>
		<skos:altLabel xml:lang="en">Leaking of urine</skos:altLabel>
		<skos:altLabel xml:lang="en">Bladder: incontinent</skos:altLabel>
		<skos:altLabel xml:lang="en">Incontinence of urine</skos:altLabel>
		<skos:altLabel xml:lang="en">unable to restrain urination</skos:altLabel>
		<skos:altLabel xml:lang="en">loss of control of urination</skos:altLabel>
		<skos:altLabel xml:lang="en">urinary loss of control</skos:altLabel>
		<skos:altLabel xml:lang="fr">INCONTINENCE D'URINE</skos:altLabel>
		<skos:altLabel xml:lang="fr">INCONTINENCE VESICALE</skos:altLabel>
		<skos:altLabel xml:lang="fr">MICTION INVOLONTAIRE</skos:altLabel>
		<skos:altLabel xml:lang="fr">Urination involontaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">incontinence paradoxale</skos:altLabel>
		<skos:altLabel xml:lang="fr">incontinence par trop plein</skos:altLabel>
		<skos:altLabel xml:lang="fr">miction par regorgement</skos:altLabel>
		<skos:altLabel xml:lang="fr">Incontinence urinaire, sans précision</skos:altLabel>
		<skos:definition xml:lang="en">Involuntary loss of URINE, such as leaking of urine. It is a symptom of various underlying pathological processes. Major types of incontinence include URINARY URGE INCONTINENCE and URINARY STRESS INCONTINENCE. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">perte involontaire d'URINE, comme la cas de la fuite d'urine. C'est un symptôme de processus pathologiques sous-jacents différents. Les types importants d'incontinence incluent l'INCONTINENCE DE BESOIN URINAIRE et l'INCONTINENCE DE TENSION URINAIRE. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0021167"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0426359"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0005686"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0497327"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0038454"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0029408"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0080274"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0018802"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0002736"/>
		<OntoAD:manifestation_of rdf:resource="&OntoAD;C0751587"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0013175">
