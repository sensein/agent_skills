	<owl:Class rdf:about="&OntoAD;C0740277">
		<skos:prefLabel xml:lang="en">Bile duct carcinoma</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">BileDuctCarcinoma</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Cancer des canaux biliaires</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">CancerDesCanauxBiliaires</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Bile Duct Cancer</skos:altLabel>
		<skos:altLabel xml:lang="fr">CANCER DU CANAL BILIAIRE</skos:altLabel>
		<skos:altLabel xml:lang="fr">CARCINOME DES VOIES BILIAIRES</skos:altLabel>
		<skos:altLabel xml:lang="fr">Cancer du canal cholédoque</skos:altLabel>
		<skos:altLabel xml:lang="fr">Cancer des voies biliaires</skos:altLabel>
		<skos:altLabel xml:lang="fr">Cancer d'un canal biliaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tumeur maligne d'un canal biliaire</skos:altLabel>
