		<skos:altLabel xml:lang="en">Consciousness functions</skos:altLabel>
		<skos:altLabel xml:lang="en">Conscious State</skos:altLabel>
		<skos:altLabel xml:lang="fr">Conscience de soi</skos:altLabel>
