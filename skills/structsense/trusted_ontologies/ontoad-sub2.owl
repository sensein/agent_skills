		<skos:altLabel xml:lang="en">muscular; dystrophy, congenital (hereditary) (progressive)</skos:altLabel>
		<skos:altLabel xml:lang="en">Hered prog musc dystrphy</skos:altLabel>
		<skos:altLabel xml:lang="fr">DYSTROPHIE MUSCULAIRE</skos:altLabel>
		<skos:altLabel xml:lang="fr">Myodystrophies</skos:altLabel>
		<skos:altLabel xml:lang="fr">Dystrophie musculaire évolutive héréditaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">dystrophie musculaire progressive héréditaire</skos:altLabel>
		<skos:definition xml:lang="en">A heterogeneous group of inherited MYOPATHIES, characterized by wasting and weakness of the SKELETAL MUSCLE. They are categorized by the sites of MUSCLE WEAKNESS; AGE OF ONSET; and INHERITANCE PATTERNS. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1285162"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2102996"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1533847"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1709838"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1335043"/>
