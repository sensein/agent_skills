	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0035078">
		<skos:prefLabel xml:lang="en">Kidney Failure</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">KidneyFailure</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Défaillance du rein</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">DéfaillanceDuRein</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Renal Failure</skos:altLabel>
		<skos:altLabel xml:lang="en">Renal failure syndrome</skos:altLabel>
		<skos:altLabel xml:lang="en">Renal insufficiency syndrome</skos:altLabel>
		<skos:altLabel xml:lang="en">Renal failureified</skos:altLabel>
		<skos:altLabel xml:lang="en">RF  Renal failure</skos:altLabel>
		<skos:altLabel xml:lang="fr">Défaillance rénale</skos:altLabel>
		<skos:altLabel xml:lang="fr">syndrome d'insuffisance rénale</skos:altLabel>
		<skos:altLabel xml:lang="fr">Défaillance du rein, sans précision</skos:altLabel>
		<skos:definition xml:lang="en">A severe irreversible decline in the ability of kidneys to remove wastes, concentrate URINE, and maintain ELECTROLYTE BALANCE; BLOOD PRESSURE; and CALCIUM metabolism. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;DiseaseOrSyndrome"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0497327"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0022646"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0020538"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0018802"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0016967"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0014695"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0036572"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0020443"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0001175"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0032825"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0020625"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0002871"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0039601"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0022661"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0271899"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0740394"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0085762"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0027498"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0341697">
		<skos:prefLabel xml:lang="en">Renal impairment</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">RenalImpairment</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Atteinte de la fonction rénale</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AtteinteDeLaFonctionRénale</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">kidney failure</skos:altLabel>
		<skos:altLabel xml:lang="en">renal failure</skos:altLabel>
		<skos:altLabel xml:lang="en">Impaired renal function</skos:altLabel>
		<skos:altLabel xml:lang="fr">Troubles de la fonction rénale</skos:altLabel>
		<skos:definition xml:lang="en">A condition in which the kidneys stop working and are not able to remove waste and extra water from the blood or keep body chemicals in balance. Acute or severe renal failure happens suddenly (for example, after an injury) and may be treated and cured. Chronic renal failure develops over many years, may be caused by conditions like high blood pressure or diabetes, and cannot be cured. Chronic renal failure may lead to total and long-lasting renal failure, called end-stage renal disease (ESRD). A (source : )</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;DiseaseOrSyndrome"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0022646"/>
	</owl:Class>

