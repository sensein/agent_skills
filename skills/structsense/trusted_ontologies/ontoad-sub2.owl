		<skos:altLabel xml:lang="en">Identification  ment def mech</skos:altLabel>
		<skos:altLabel xml:lang="en">Identification  mental defense mechanism</skos:altLabel>
		<skos:altLabel xml:lang="en">IDENTIFICATION PSYCHOL</skos:altLabel>
		<skos:altLabel xml:lang="fr">identification</skos:altLabel>
		<skos:altLabel xml:lang="fr">Identification psychologique</skos:altLabel>
		<skos:definition xml:lang="en">A process by which an individual unconsciously endeavors to pattern himself after another. This process is also important in the development of the personality, particularly the superego or conscience, which is modeled largely on the behavior of adult significant others. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;MentalProcess"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
	</owl:Class>

