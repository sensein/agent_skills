		<skos:hiddenLabel xml:lang="fr">Royaume-Uni</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">GBR</skos:altLabel>
		<skos:altLabel xml:lang="en">UK-Utd Kgdom Gt Brit/N Ireland</skos:altLabel>
		<skos:altLabel xml:lang="en">Utd Kingdom Gt Brit/N Ireland</skos:altLabel>
		<skos:altLabel xml:lang="en">UK  United Kingdom of Great Britain and Northern Ireland</skos:altLabel>
		<skos:altLabel xml:lang="en">United Kingdom of Great Britain and Northern Ireland</skos:altLabel>
		<skos:altLabel xml:lang="fr">Royaume Uni</skos:altLabel>
		<skos:definition xml:lang="en">A country in Western Europe, comprising islands, including the northern one-sixth of the island of Ireland, between the North Atlantic Ocean and the North Sea, northwest of France. (NCI) (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0454664"/>
