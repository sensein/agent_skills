		<skos:altLabel xml:lang="en">HIV-Associated Cognitive Motor Complex</skos:altLabel>
		<skos:altLabel xml:lang="en">Dementia in human immunodeficiency virus disease</skos:altLabel>
		<skos:altLabel xml:lang="en">AIDS  Acquired immune deficiency syndrome dementia complex</skos:altLabel>
