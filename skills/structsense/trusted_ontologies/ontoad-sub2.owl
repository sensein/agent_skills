	<owl:Class rdf:about="&OntoAD;C0030094">
		<skos:prefLabel xml:lang="en">Oxytocics</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Oxytocics</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Ocytociques</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Ocytociques</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Oxytocic Agents</skos:altLabel>
		<skos:altLabel xml:lang="en">Oxytocic Drugs</skos:altLabel>
		<skos:altLabel xml:lang="en">Uterine Stimulants</skos:altLabel>
		<skos:altLabel xml:lang="en">Oxytocic hormone</skos:altLabel>
		<skos:altLabel xml:lang="en">Oxytocic preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">Oxytocic agent</skos:altLabel>
		<skos:altLabel xml:lang="en">Oxytocic</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments ocytociques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents ocytociques</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation ocytoxique</skos:altLabel>
		<skos:definition xml:lang="en">Drugs that stimulate contraction of the myometrium. They are used to induce LABOR, OBSTETRIC at term, to prevent or control postpartum or postabortion hemorrhage, and to assess fetal status in high risk pregnancies. They may also be used alone or with other drugs to induce abortions (ABORTIFACIENTS). Oxytocics used clinically include the neurohypophyseal hormone OXYTOCIN and certain prostaglandins and ergot alkaloids. (From AMA Drug Evaluations, 1994, p1157) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1320003"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1277062"/>
	</owl:Class>

