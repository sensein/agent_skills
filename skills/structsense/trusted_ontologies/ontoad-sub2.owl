	<owl:Class rdf:about="&OntoAD;C0025219">
		<skos:prefLabel xml:lang="en">Melatonin</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Melatonin</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Mélatonine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Mélatonine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Acetamide, N-(2-(5-methoxy-1H-indol-3-yl)ethyl)-</skos:altLabel>
		<skos:altLabel xml:lang="en">MIH</skos:altLabel>
		<skos:altLabel xml:lang="en">melanocyte-inhibiting factor</skos:altLabel>
		<skos:altLabel xml:lang="en">Melatonin preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">MLT</skos:altLabel>
		<skos:definition xml:lang="en">A biogenic amine that is found in animals and plants. In mammals, melatonin is produced by the PINEAL GLAND. Its secretion increases in darkness and decreases during exposure to light. Melatonin is implicated in the regulation of SLEEP, mood, and REPRODUCTION. Melatonin is also an effective antioxidant. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003402"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0019932"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0457550"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0007681"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0032016"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0083001"/>
		<OntoAD:endogenous_product_related_to rdf:resource="&OntoAD;C1527137"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1295184">
		<skos:prefLabel xml:lang="en">Melatonin Measurement</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">MelatoninMeasurement</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">MLATONIN</skos:altLabel>
		<skos:definition xml:lang="en">A measurement of the melatonin hormone in a biological specimen. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0441683"/>
		<OntoAD:has_method rdf:resource="&OntoAD;C0242485"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1527137">
		<skos:prefLabel xml:lang="en">Recombinant melatonin</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">RecombinantMelatonin</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Therapeutic Melatonin</skos:altLabel>
		<skos:definition xml:lang="en">A therapeutic chemically synthesized form of the pineal indole melatonin with antioxidant properties. The pineal synthesis and secretion of melatonin, a serotonin-derived neurohormone, is dependent on beta-adrenergic receptor function. Melatonin is involved in numerous biological functions including circadian rhythm, sleep, the stress response, aging, and immunity. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003402"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0019932"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2240391"/>
		<OntoAD:is_related_to_endogenous_product rdf:resource="&OntoAD;C0025219"/>
	</owl:Class>

