		<skos:hiddenLabel xml:lang="en">AminoAcids,Essential</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Acides aminés essentiels</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AcidesAminésEssentiels</skos:hiddenLabel>
