	<owl:Class rdf:about="&OntoAD;C0007681">
		<skos:prefLabel xml:lang="en">Central Nervous System Depressants</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CentralNervousSystemDepressants</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Dépresseurs du système nerveux central</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">DépresseursDuSystèmeNerveuxCentral</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">CNS Depressants</skos:altLabel>
		<skos:altLabel xml:lang="en">CNS DEPRESS</skos:altLabel>
		<skos:altLabel xml:lang="en">Central Nervous System Depressant</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments dépresseurs du SNC</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents dépresseurs du SNC</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments dépresseurs du système nerveux central</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents dépresseurs du système nerveux central</skos:altLabel>
		<skos:altLabel xml:lang="fr">Dépresseurs du SNC</skos:altLabel>
		<skos:definition xml:lang="en">A very loosely defined group of drugs that tend to reduce the activity of the central nervous system. The major groups included here are ethyl alcohol, anesthetics, hypnotics and sedatives, narcotics, and tranquilizing agents (antipsychotics and antianxiety agents). (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2064865"/>
	</owl:Class>

