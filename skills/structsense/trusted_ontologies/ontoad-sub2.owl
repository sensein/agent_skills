		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1333402"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1334064"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1335528"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0007807">
		<skos:prefLabel xml:lang="en">In Cerebrospinal Fluid</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">InCerebrospinalFluid</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">liquide céphalorachidien</skos:prefLabel>
