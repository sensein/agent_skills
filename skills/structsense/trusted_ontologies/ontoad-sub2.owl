	<owl:Class rdf:about="&OntoAD;C0085378">
		<skos:prefLabel xml:lang="en">Housing for the Elderly</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">HousingForTheElderly</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Résidences pour personnes âgées</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">RésidencesPourPersonnesÂgées</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Retirement home</skos:altLabel>
		<skos:altLabel xml:lang="en">nursing homes</skos:altLabel>
		<skos:altLabel xml:lang="fr">maison de retraite</skos:altLabel>
		<skos:altLabel xml:lang="fr">maisons de retraite</skos:altLabel>
		<skos:altLabel xml:lang="fr">Résidences pour le 3e âge</skos:altLabel>
		<skos:altLabel xml:lang="fr">Résidences pour le troisième âge</skos:altLabel>
		<skos:altLabel xml:lang="fr">Maisons d'accueil pour personnes âgées</skos:altLabel>
		<skos:altLabel xml:lang="fr">Habitations pour personnes agées</skos:altLabel>
		<skos:altLabel xml:lang="fr">Résidences pour le 3ème âge</skos:altLabel>
		<skos:definition xml:lang="en">Housing arrangements for the elderly or aged, intended to foster independent living. The housing may take the form of group homes or small apartments. It is available to the economically self-supporting but the concept includes housing for the elderly with some physical limitations. The concept should be differentiated from HOMES FOR THE AGED which is restricted to long-term geriatric facilities providing supervised medical and nursing services. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;ManufacturedObject"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0872078">
		<skos:prefLabel xml:lang="en">Presenilins</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Presenilins</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Présénilines</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Présénilines</skos:hiddenLabel>
		<skos:altLabel xml:lang="fr">préséniline</skos:altLabel>
		<skos:definition xml:lang="en">Integral membrane proteins and essential components of the gamma-secretase complex that catalyzes the cleavage of membrane proteins such as NOTCH RECEPTORS and AMYLOID BETA-PEPTIDES precursors. Mutations of presenilins lead to presenile ALZHEIMER DISEASE with onset before age 65 years. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">protéines membraneuses intégrantes et les composantes essentielles du complexe de gamma-secretase qui catalyse la segmentation de protéines membraneuses comme les RÉCEPTEURS D'ENTAILLE et les précurseurs de PROTÉINE DE BÉTA AMYLOÏDE. Les mutations de presenilines causent la MALADIE ALZHEIMER présénile avec le commencement avant l'âge 65 ans. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0025252"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C2936349">
		<skos:prefLabel xml:lang="en">Plaque, Amyloid</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Plaque,Amyloid</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Plaque amyloïde</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">PlaqueAmyloïde</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">amyloid plaques</skos:altLabel>
		<skos:altLabel xml:lang="en">amyloid plaque</skos:altLabel>
		<skos:altLabel xml:lang="en">amyloid deposition</skos:altLabel>
		<skos:altLabel xml:lang="en">beta-Amyloid Deposition</skos:altLabel>
		<skos:altLabel xml:lang="en">Amyloid Deposits</skos:altLabel>
		<skos:altLabel xml:lang="fr">dépôts amyloïdes</skos:altLabel>
		<skos:altLabel xml:lang="fr">plaques amyloïdes</skos:altLabel>
		<skos:altLabel xml:lang="fr">Dépot amyloïde</skos:altLabel>
		<skos:definition xml:lang="en">Accumulations of extracellularly deposited AMYLOID FIBRILS within tissues. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0927232"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0037420">
		<skos:prefLabel xml:lang="en">Social Interaction</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">SocialInteraction</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Interaction sociale</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">InteractionSociale</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Interaction with others</skos:altLabel>
		<skos:altLabel xml:lang="fr">interactions sociales</skos:altLabel>
		<skos:definition xml:lang="en">Reciprocal action or influence among people including parent-child, parent-teacher, and nurse-client. (source : OMS)</skos:definition>
		<skos:definition xml:lang="fr">L'action réciproque réciproque d'au moins deux personnes. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;Finding"/>
		<OntoAD:is_interpreted_by rdf:resource="&OntoAD;C0037421"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0078939">
		<skos:prefLabel xml:lang="en">Amyloid beta-Peptides</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AmyloidBeta-Peptides</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Peptides bêta-amyloïdes</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">PeptidesBêta-amyloïdes</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">beta-amyloid peptide</skos:altLabel>
		<skos:altLabel xml:lang="en">amyloid-beta peptide</skos:altLabel>
		<skos:altLabel xml:lang="en">amyloid protein</skos:altLabel>
		<skos:altLabel xml:lang="en">amyloid beta</skos:altLabel>
		<skos:altLabel xml:lang="en">Alzheimer beta-Protein</skos:altLabel>
		<skos:altLabel xml:lang="en">Amyloid AD-AP</skos:altLabel>
		<skos:altLabel xml:lang="en">Amyloid beta-Protein</skos:altLabel>
		<skos:altLabel xml:lang="en">Amyloid Protein A4</skos:altLabel>
		<skos:altLabel xml:lang="en">Alzheimers ABP</skos:altLabel>
		<skos:altLabel xml:lang="en">AMYLOID PROTEIN A 04</skos:altLabel>
		<skos:altLabel xml:lang="en">Alzheimer's ABP</skos:altLabel>
		<skos:altLabel xml:lang="en">Alzheimer's Amyloid Fibril Protein</skos:altLabel>
		<skos:altLabel xml:lang="fr">protéine beta-amyloïde</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine amyloïde A4</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine amyloïde bêta</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine bêta (Alzheimer)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine bêta A4</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéines bêta-amyloïdes</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine amyloïde fibrillaire (Alzheimer)</skos:altLabel>
		<skos:definition xml:lang="en">Peptides generated from AMYLOID BETA-PEPTIDES PRECURSOR. An amyloid fibrillar form of these peptides is the major component of amyloid plaques found in individuals with Alzheimer's disease and in aged individuals with trisomy 21 (DOWN SYNDROME). The peptide is found predominantly in the nervous system, but there have been reports of its presence in non-neural tissue. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0002716"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1413514">
		<skos:prefLabel xml:lang="en">CLU gene</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CLUGene</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">gène CLU</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">GèneCLU</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">APOLIPOPROTEIN J</skos:altLabel>
		<skos:altLabel xml:lang="en">SGP-2</skos:altLabel>
		<skos:altLabel xml:lang="en">SULFATED GLYCOPROTEIN 2</skos:altLabel>
		<skos:altLabel xml:lang="en">TESTOSTERONE-REPRESSED PROSTATE MESSAGE 2</skos:altLabel>
		<skos:altLabel xml:lang="en">TRPM-2</skos:altLabel>
		<skos:altLabel xml:lang="en">COMPLEMENT LYSIS INHIBITOR</skos:altLabel>
		<skos:altLabel xml:lang="en">APOJ</skos:altLabel>
		<skos:altLabel xml:lang="en">CLU</skos:altLabel>
		<skos:altLabel xml:lang="en">SGP2</skos:altLabel>
		<skos:altLabel xml:lang="en">TRPM2</skos:altLabel>
		<skos:altLabel xml:lang="en">COMPLEMENT-ASSOCIATED PROTEIN SP-40,40</skos:altLabel>
		<skos:altLabel xml:lang="en">KUB1</skos:altLabel>
		<skos:altLabel xml:lang="en">SP-40</skos:altLabel>
		<skos:altLabel xml:lang="en">CLI</skos:altLabel>
