		<skos:altLabel xml:lang="en">refusal / inability to swallow (aphagia)</skos:altLabel>
		<skos:definition xml:lang="en">Not eating, the refusal to eat, or an inability to swallow foods or fluids. (source : PSY)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0426576"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
