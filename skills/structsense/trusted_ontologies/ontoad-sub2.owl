	<owl:Class rdf:about="&OntoAD;C0085281">
		<skos:prefLabel xml:lang="en">Addictive Behavior</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AddictiveBehavior</skos:hiddenLabel>
