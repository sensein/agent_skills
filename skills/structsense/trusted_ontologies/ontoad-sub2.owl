		<skos:altLabel xml:lang="fr">dosage de l'acide urique</skos:altLabel>
		<skos:altLabel xml:lang="fr">dosage de l'urate</skos:altLabel>
		<skos:definition xml:lang="en">A quantitative measurement of the amount of urate present in a sample. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2316799"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0201682"/>
		<OntoAD:has_method rdf:resource="&OntoAD;C0242485"/>
		<OntoAD:is_interpreted_by rdf:resource="&OntoAD;C0041981"/>
	</owl:Class>

