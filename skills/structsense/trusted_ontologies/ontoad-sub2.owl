		<rdfs:subClassOf rdf:resource="&OntoAD;C1519383"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1519384">
		<skos:prefLabel xml:lang="en">Smoking History</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">SmokingHistory</skos:hiddenLabel>
		<skos:definition xml:lang="en">A record of an individual's background in regard to smoking tobacco. This would include such factors as start date, end date (if applicable), number of cigarette smoked, attempts to quit, and others. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0262926"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1112669"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0021822">
		<skos:prefLabel xml:lang="en">Interview</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Interview</skos:hiddenLabel>
