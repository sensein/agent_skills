	<owl:Class rdf:about="&OntoAD;C0333463">
		<skos:prefLabel xml:lang="en">Senile Plaques</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">SenilePlaques</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Plaques séniles</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">PlaquesSéniles</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">neuritic plaque</skos:altLabel>
		<skos:altLabel xml:lang="en">neuritic plaques</skos:altLabel>
		<skos:altLabel xml:lang="en">senile plaque</skos:altLabel>
		<skos:altLabel xml:lang="fr">plaques neuritiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">plaque sénile</skos:altLabel>
		<skos:definition xml:lang="en">plaques consist of amyloid deposits surrounded by a web of astrocytic processes, swollen neurites, and neuron terminals; seen in the cerebral cortex in Alzheimer's disease. (source : CSP)</skos:definition>
		<skos:definition xml:lang="fr">masses sphériques se composant de l'amyloïde fibrilles et les processus de neuronal. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0332461"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0005767">
		<skos:prefLabel xml:lang="en">Blood</skos:prefLabel>
