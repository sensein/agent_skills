		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0018681"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0012833"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0011168"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0025289"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0015230"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0030312"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0005779"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0019158"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0032285"/>
