	<owl:Class rdf:about="&OntoAD;C0242393">
		<skos:prefLabel xml:lang="en">Immediate Recall</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">ImmediateRecall</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Rappel immédiat</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">RappelImmédiat</skos:hiddenLabel>
		<skos:definition xml:lang="fr">Fonctions mentales qui produisent une réserve mnémonique temporaire et pouvant être pertubée, d'une durée d'environ 30 secondes, d'où l'information est perdue si elle n'est pas consolidée dans la mémoire à long terme. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;MentalProcess"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0004930">
		<skos:prefLabel xml:lang="en">Behavior Disorders</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">BehaviorDisorders</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Troubles comportementaux</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">TroublesComportementaux</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">behavioural disturbances</skos:altLabel>
		<skos:altLabel xml:lang="en">Behavioural disorder</skos:altLabel>
		<skos:altLabel xml:lang="en">BEHAVIOR DIS</skos:altLabel>
		<skos:altLabel xml:lang="fr">troubles du comportement</skos:altLabel>
		<skos:altLabel xml:lang="fr">troubles psycho-comportementaux</skos:altLabel>
		<skos:altLabel xml:lang="fr">Trouble comportemental</skos:altLabel>
		<skos:altLabel xml:lang="fr">Trouble du comportement</skos:altLabel>
		<skos:definition xml:lang="en">any of various conditions characterized by impairment of an individual's normal behavioral functioning, and caused by social, psychological, biochemical, genetic, or other factors, such as infection or head trauma. (source : CSP)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1306597"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0025261">
		<skos:prefLabel xml:lang="en">Memory Disorders</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">MemoryDisorders</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Troubles de la mémoire</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">TroublesDeLaMémoire</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">memory deficits</skos:altLabel>
		<skos:altLabel xml:lang="en">memory loss</skos:altLabel>
		<skos:altLabel xml:lang="en">Retention Disorders, Cognitive</skos:altLabel>
		<skos:altLabel xml:lang="en">MEMORY DIS</skos:altLabel>
		<skos:altLabel xml:lang="fr">troubles mnésiques</skos:altLabel>
		<skos:definition xml:lang="en">Disturbances in registering an impression, in the retention of an acquired impression, or in the recall of an impression. Memory impairments are associated with DEMENTIA; CRANIOCEREBRAL TRAUMA; ENCEPHALITIS; ALCOHOLISM (see also ALCOHOL AMNESTIC DISORDER); SCHIZOPHRENIA; and other conditions. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">troubles dans le fait d'enregistrer une impression, dans la rétention d'une impression acquise, ou dans la mémoire d'une impression. Les affaiblissements de mémoire sont associés à la DÉMENCE; TRAUMA CRANIO-CÉRÉBRAL ; encéphalite ; l'ALCOOLISME (voir aussi de l'ALCOOL LE DÉSORDRE de l'¤slAMNESTIC¤sl ); SCHIZOPHRÉNIE; et d'autres affections. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0233632"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0020179">
		<skos:prefLabel xml:lang="en">Huntington Disease</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">HuntingtonDisease</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Maladie de Huntington</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">MaladieDeHuntington</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Chronic progressive hereditary chorea</skos:altLabel>
		<skos:altLabel xml:lang="en">Huntington Chorea</skos:altLabel>
		<skos:altLabel xml:lang="en">Chronic progressive chorea</skos:altLabel>
		<skos:altLabel xml:lang="en">HC  Huntington chorea</skos:altLabel>
		<skos:altLabel xml:lang="en">HD  Huntington chorea</skos:altLabel>
		<skos:altLabel xml:lang="en">Progressive Chorea, Hereditary, Chronic (Huntington)</skos:altLabel>
		<skos:altLabel xml:lang="en">Huntington's chorea</skos:altLabel>
		<skos:altLabel xml:lang="en">Huntington</skos:altLabel>
		<skos:altLabel xml:lang="en">HUNTINGTON DIS</skos:altLabel>
		<skos:altLabel xml:lang="en">Huntington's disease</skos:altLabel>
		<skos:altLabel xml:lang="fr">Chorée de Huntington</skos:altLabel>
		<skos:altLabel xml:lang="fr">Chorée chronique progressive de Huntington</skos:altLabel>
		<skos:altLabel xml:lang="fr">Chorée chronique progressive héréditaire de Huntington</skos:altLabel>
		<skos:altLabel xml:lang="fr">chorée héréditaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">chorée progressive héréditaire de Huntington</skos:altLabel>
		<skos:definition xml:lang="en">A familial disorder inherited as an autosomal dominant trait and characterized by the onset of progressive CHOREA and DEMENTIA in the fourth or fifth decade of life. Common initial manifestations include paranoia; poor impulse control; DEPRESSION; HALLUCINATIONS; and DELUSIONS. Eventually intellectual impairment; loss of fine motor control; ATHETOSIS; and diffuse chorea involving axial and limb musculature develops, leading to a vegetative state within 10-15 years of disease onset. The juvenile  (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0004782"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0393572"/>
		<OntoAD:has_manifestation rdf:resource="&OntoAD;C0497327"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:has_manifestation rdf:resource="&OntoAD;C0344315"/>
		<OntoAD:disease_has_associated_anatomic_site rdf:resource="&OntoAD;C0027763"/>
		<OntoAD:disease_has_associated_anatomic_site rdf:resource="&OntoAD;C0927232"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0004781"/>
		<OntoAD:has_manifestation rdf:resource="&OntoAD;C0233565"/>
		<OntoAD:has_manifestation rdf:resource="&OntoAD;C0008489"/>
		<OntoAD:associated_with_malfunction_of_gene_product rdf:resource="&OntoAD;C0252274"/>
		<OntoAD:disease_has_associated_gene rdf:resource="&OntoAD;C1415504"/>
		<OntoAD:has_manifestation rdf:resource="&OntoAD;C0240735"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0002736">
		<skos:prefLabel xml:lang="en">Amyotrophic Lateral Sclerosis</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AmyotrophicLateralSclerosis</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Sclérose latérale amyotrophique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ScléroseLatéraleAmyotrophique</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Amyotrophic sclerosis</skos:altLabel>
		<skos:altLabel xml:lang="en">Gehrig's Disease</skos:altLabel>
		<skos:altLabel xml:lang="en">Lou Gehrig Disease</skos:altLabel>
		<skos:altLabel xml:lang="en">Bulbar motor neuron disease</skos:altLabel>
		<skos:altLabel xml:lang="en">ALS  Amyotroph lat sclerosis</skos:altLabel>
		<skos:altLabel xml:lang="en">ALS (Amyotrophic Lateral Sclerosis)</skos:altLabel>
		<skos:altLabel xml:lang="en">Amyotrophic Lateral Sclerosis/Progressive Muscular Atrophy</skos:altLabel>
		<skos:altLabel xml:lang="en">Motor Neuron Disease, Amyotrophic Lateral Sclerosis</skos:altLabel>
		<skos:altLabel xml:lang="en">ALS</skos:altLabel>
		<skos:altLabel xml:lang="en">spinal; sclerosis, lateral (amyotrophic)</skos:altLabel>
		<skos:altLabel xml:lang="en">amyotrophy; lateral sclerosis</skos:altLabel>
		<skos:altLabel xml:lang="en">palsy; creeping</skos:altLabel>
		<skos:altLabel xml:lang="en">GEHRIGS DIS</skos:altLabel>
		<skos:altLabel xml:lang="en">LOU GEHRIG DIS</skos:altLabel>
		<skos:altLabel xml:lang="en">MOTOR NEURON DIS AMYOTROPHIC LATERAL SCLEROSIS</skos:altLabel>
		<skos:altLabel xml:lang="en">Lou Gehrig's disease (ALS)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Maladie de Charcot</skos:altLabel>
		<skos:altLabel xml:lang="fr">Maladie de Lou Gehrig</skos:altLabel>
		<skos:altLabel xml:lang="fr">SLA (Sclérose Latérale Amyotrophique)</skos:altLabel>
		<skos:altLabel xml:lang="fr">maladie du neurone moteur bulbaire</skos:altLabel>
		<skos:definition xml:lang="en">A degenerative disorder affecting upper MOTOR NEURONS in the brain and lower motor neurons in the brain stem and SPINAL CORD. Disease onset is usually after the age of 50 and the process is usually fatal within 3 to 6 years. Clinical manifestations include progressive weakness, atrophy, FASCICULATION, hyperreflexia, DYSARTHRIA, dysphagia, and eventual paralysis of respiratory function. Pathologic features include the replacement of motor neurons with fibrous ASTROCYTES and atrophy of anterior SP (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0085084"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0524851"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0027763"/>
		<OntoAD:manifestation_of rdf:resource="&OntoAD;C0338451"/>
		<OntoAD:disease_has_associated_anatomic_site rdf:resource="&OntoAD;C0927232"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0042024"/>
		<OntoAD:may_be_treated_by rdf:resource="&OntoAD;C0073379"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0027819">
		<skos:prefLabel xml:lang="en">Neuroblastoma</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Neuroblastoma</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Neuroblastome</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Neuroblastome</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">NB  Neuroblastoma</skos:altLabel>
		<skos:altLabel xml:lang="en">neuroblastoma; site</skos:altLabel>
		<skos:altLabel xml:lang="en">Neuroblastoma (Schwannian Stroma-Poor)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Sympathoblastome</skos:altLabel>
		<skos:altLabel xml:lang="fr">neuroblastome, SAI</skos:altLabel>
		<skos:altLabel xml:lang="fr">neuroblastome central</skos:altLabel>
		<skos:definition xml:lang="en">A common neoplasm of early childhood arising from neural crest cells in the sympathetic nervous system, and characterized by diverse clinical behavior, ranging from spontaneous remission to rapid metastatic progression and death. This tumor is the most common intraabdominal malignancy of childhood, but it may also arise from thorax, neck, or rarely occur in the central nervous system. Histologic features include uniform round cells with hyperchromatic nuclei arranged in nests and separated by fi (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2217837"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0206717"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0475820"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1334953"/>
		<OntoAD:may_be_treated_by rdf:resource="&OntoAD;C0010934"/>
		<OntoAD:disease_has_primary_anatomic_site rdf:resource="&OntoAD;C0027763"/>
		<OntoAD:may_be_treated_by rdf:resource="&OntoAD;C0042679"/>
		<OntoAD:disease_may_have_finding rdf:resource="&OntoAD;C0019080"/>
		<OntoAD:disease_has_normal_tissue_origin rdf:resource="&OntoAD;C1518250"/>
		<OntoAD:disease_has_normal_cell_origin rdf:resource="&OntoAD;C1518293"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0002726">
		<skos:prefLabel xml:lang="en">Amyloidosis</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Amyloidosis</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Amyloïdose</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Amyloïdose</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Amyloid disease</skos:altLabel>
		<skos:altLabel xml:lang="en">amyloid; disorder</skos:altLabel>
		<skos:altLabel xml:lang="fr">AMYLOSE</skos:altLabel>
		<skos:altLabel xml:lang="fr">Amyloïdoses</skos:altLabel>
		<skos:altLabel xml:lang="fr">Maladie amyloïde</skos:altLabel>
		<skos:altLabel xml:lang="fr">Amylose (maladie)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Amylose, sans précision</skos:altLabel>
		<skos:definition xml:lang="en">A group of sporadic, familial and/or inherited, degenerative, and infectious disease processes, linked by the common theme of abnormal protein folding and deposition of AMYLOID. As the amyloid deposits enlarge they displace normal tissue structures, causing disruption of function. Various signs and symptoms depend on the location and size of the deposits. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1285162"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0025517"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0280950"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:has_associated_morphology rdf:resource="&OntoAD;C0011560"/>
		<OntoAD:disease_has_finding rdf:resource="&OntoAD;C1705760"/>
		<OntoAD:associated_with_malfunction_of_gene_product rdf:resource="&OntoAD;C0071744"/>
		<OntoAD:associated_with_malfunction_of_gene_product rdf:resource="&OntoAD;C0032923"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0026769">
		<skos:prefLabel xml:lang="en">Multiple Sclerosis</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">MultipleSclerosis</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Sclérose en plaques</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ScléroseEnPlaques</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Sclerosis, Disseminated</skos:altLabel>
		<skos:altLabel xml:lang="en">sclerosis; insular</skos:altLabel>
		<skos:altLabel xml:lang="en">Generalized multiple sclerosis</skos:altLabel>
		<skos:altLabel xml:lang="en">DS  Disseminated sclerosis</skos:altLabel>
		<skos:altLabel xml:lang="en">MS (Multiple Sclerosis)</skos:altLabel>
		<skos:altLabel xml:lang="en">sclerosis; cerebrospinal</skos:altLabel>
		<skos:altLabel xml:lang="fr">SEP (Sclérose En Plaques)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Sclérose disséminée</skos:altLabel>
		<skos:altLabel xml:lang="fr">Sclérose multiple</skos:altLabel>
		<skos:altLabel xml:lang="fr">SEP</skos:altLabel>
		<skos:altLabel xml:lang="fr">sclérose multiloculaire</skos:altLabel>
		<skos:definition xml:lang="en">An autoimmune disorder mainly affecting young adults and characterized by destruction of myelin in the central nervous system. Pathologic findings include multiple sharply demarcated areas of demyelination throughout the white matter of the central nervous system. Clinical manifestations include visual loss, extra-ocular movement disorders, paresthesias, loss of sensation, weakness, dysarthria, spasticity, ataxia, and bladder dysfunction. The usual pattern is one of recurrent attacks followed by (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0004364"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0011302"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:may_be_treated_by rdf:resource="&OntoAD;C0042845"/>
		<OntoAD:disease_has_associated_anatomic_site rdf:resource="&OntoAD;C0027763"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0927232"/>
		<OntoAD:may_be_treated_by rdf:resource="&OntoAD;C0020316"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0751495"/>
