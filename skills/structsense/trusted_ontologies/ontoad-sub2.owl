		<skos:altLabel xml:lang="en">Lp(a)</skos:altLabel>
		<skos:altLabel xml:lang="en">Lipoprotein (little a)</skos:altLabel>
		<skos:altLabel xml:lang="en">Lipoprotein(a)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Lipoprotéine(a)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Lp(a)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Lipoprotéine Lp(a)</skos:altLabel>
		<skos:definition xml:lang="en">A lipoprotein that resembles the LOW-DENSITY LIPOPROTEINS but with an extra protein moiety, APOPROTEIN (A) also known as APOLIPOPROTEIN (A), linked to APOLIPOPROTEIN B-100 on the LDL by one or two disulfide bonds. High plasma level of lipoprotein (a) is associated with increased risk of atherosclerotic cardiovascular disease. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0023820"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0022116">
