		<skos:altLabel xml:lang="en">Malignant tumor of mediastinum</skos:altLabel>
		<skos:altLabel xml:lang="en">Mediastinum, partified</skos:altLabel>
		<skos:altLabel xml:lang="en">Malignant mediastinal neoplasm</skos:altLabel>
