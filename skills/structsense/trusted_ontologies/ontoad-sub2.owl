		<skos:altLabel xml:lang="en">Pharmaceuticals</skos:altLabel>
		<skos:altLabel xml:lang="en">Pharmaceutical Agent</skos:altLabel>
		<skos:altLabel xml:lang="en">Pharmacological Substance</skos:altLabel>
		<skos:altLabel xml:lang="en">Pharmacologic Agent</skos:altLabel>
		<skos:definition xml:lang="en">An article other than food intended for use in the diagnosis, cure, mitigation, treatment, or prevention of disease; or intended to affect the structure or any function of the body. EXAMPLE(S): aspirin (source : NCI)</skos:definition>
