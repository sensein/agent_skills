	<owl:Class rdf:about="&OntoAD;C0009782">
		<skos:prefLabel xml:lang="en">Connective Tissue Diseases</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">ConnectiveTissueDiseases</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Maladies du tissu conjonctif</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">MaladiesDuTissuConjonctif</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">connectivity</skos:altLabel>
		<skos:altLabel xml:lang="en">Disorder of connective tissue</skos:altLabel>
		<skos:altLabel xml:lang="en">disorders of connective tissue</skos:altLabel>
		<skos:altLabel xml:lang="en">Connective tissue disease or syndrome</skos:altLabel>
		<skos:altLabel xml:lang="en">Diseases and Syndromes of Connective Tissue</skos:altLabel>
		<skos:altLabel xml:lang="en">SECTION 1-1 DISEASES OF THE CONNECTIVE TISSUES</skos:altLabel>
		<skos:altLabel xml:lang="en">Other musculoskelet/connectiv</skos:altLabel>
		<skos:altLabel xml:lang="en">CONNECTIVE TISSUE DIS</skos:altLabel>
		<skos:altLabel xml:lang="en">Disease of connective tissues</skos:altLabel>
		<skos:altLabel xml:lang="fr">connectivité</skos:altLabel>
		<skos:altLabel xml:lang="fr">Anomalies du tissu conjonctif ou connectivites</skos:altLabel>
		<skos:altLabel xml:lang="fr">maladie du collagène</skos:altLabel>
		<skos:altLabel xml:lang="fr">maladie diffuse du tissu conjonctif</skos:altLabel>
		<skos:altLabel xml:lang="fr">atteinte systémique du tissu conjonctif</skos:altLabel>
		<skos:definition xml:lang="en">A heterogeneous group of disorders, some hereditary, others acquired, characterized by abnormal structure or function of one or more of the elements of connective tissue, i.e., collagen, elastin, or the mucopolysaccharides. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;DiseaseOrSyndrome"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:disease_has_associated_anatomic_site rdf:resource="&OntoAD;C1516798"/>
		<OntoAD:disease_has_associated_anatomic_site rdf:resource="&OntoAD;C0262950"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0009780"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0009326">
		<skos:prefLabel xml:lang="en">Collagen Diseases</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CollagenDiseases</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Maladies du collagène</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">MaladiesDuCollagène</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Collagen disorder</skos:altLabel>
		<skos:altLabel xml:lang="en">RHEUMATOLOGIC PROBLEM</skos:altLabel>
		<skos:altLabel xml:lang="en">Collagen disease</skos:altLabel>
		<skos:altLabel xml:lang="en">rheumatologic disorder</skos:altLabel>
		<skos:altLabel xml:lang="en">COLLAGEN DIS</skos:altLabel>
		<skos:altLabel xml:lang="fr">COLLAGENE</skos:altLabel>
		<skos:altLabel xml:lang="fr">Trouble du collagène</skos:altLabel>
		<skos:altLabel xml:lang="fr">Collagénoses</skos:altLabel>
		<skos:altLabel xml:lang="fr">Connectivites</skos:altLabel>
		<skos:altLabel xml:lang="fr">Collagénose</skos:altLabel>
		<skos:altLabel xml:lang="fr">maladie du collagène</skos:altLabel>
		<skos:altLabel xml:lang="fr">maladie diffuse du tissu conjonctif</skos:altLabel>
		<skos:altLabel xml:lang="fr">atteinte systémique du tissu conjonctif</skos:altLabel>
		<skos:definition xml:lang="en">Historically, a heterogeneous group of acute and chronic diseases, including rheumatoid arthritis, systemic lupus erythematosus, progressive systemic sclerosis, dermatomyositis, etc. This classification was based on the notion that 'collagen' was equivalent to 'connective tissue', but with the present recognition of the different types of collagen and the aggregates derived from them as distinct entities, the term 'collagen diseases' now pertains exclusively to those inherited conditions in whic (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;DiseaseOrSyndrome"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0009780"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1456454">
		<skos:prefLabel xml:lang="en">Amyloid Proteins</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AmyloidProteins</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Protéines amyloïdogènes</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ProtéinesAmyloïdogènes</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">amyloid protein</skos:altLabel>
		<skos:altLabel xml:lang="en">Amyloidogenic Proteins</skos:altLabel>
		<skos:altLabel xml:lang="fr">protéine amyloïde</skos:altLabel>
		<skos:altLabel xml:lang="fr">protéine bêta-amyloïde</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéines amyloïdes</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéines amyloïdogéniques</skos:altLabel>
		<skos:definition xml:lang="en">Proteins that form the core of amyloid fibrils. For example, the core of amyloid A is formed from amyloid A protein, also known as serum amyloid A protein or SAA protein. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0443871"/>
	</owl:Class>

