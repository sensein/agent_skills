		<skos:altLabel xml:lang="en">Smokings, Tobacco</skos:altLabel>
		<skos:altLabel xml:lang="fr">Utilisation du tabac</skos:altLabel>
		<skos:altLabel xml:lang="fr">Usage du tabac</skos:altLabel>
		<skos:definition xml:lang="en">The act of puffing and/or inhaling smoke from a lit cigarette, cigar, or pipe. (source : NCI)</skos:definition>
