		<OntoAD:gene_encodes_gene_product rdf:resource="&OntoAD;C0066563"/>
		<OntoAD:gene_encodes_gene_product rdf:resource="&OntoAD;C0166417"/>
		<OntoAD:gene_encodes_gene_product rdf:resource="&OntoAD;C0034804"/>
