	<owl:Class rdf:about="&OntoAD;C0023980">
		<skos:prefLabel xml:lang="en">Longevity</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Longevity</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Longévité</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Longévité</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">life span</skos:altLabel>
		<skos:altLabel xml:lang="en">Length of Life</skos:altLabel>
		<skos:altLabel xml:lang="en">Longevity, function</skos:altLabel>
		<skos:altLabel xml:lang="fr">durée de vie</skos:altLabel>
		<skos:definition xml:lang="en">The normal length of time of an organism's life. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0001811"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0032041">
		<skos:prefLabel xml:lang="en">Placebo Effect</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">PlaceboEffect</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Effet placebo</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">EffetPlacebo</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">PLACEBO EFF</skos:altLabel>
		<skos:definition xml:lang="en">An effect usually, but not necessarily, beneficial that is attributable to an expectation that the regimen will have an effect, i.e., the effect is due to the power of suggestion. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">effet en général, mais pas nécessairement, favorable qui est attribuable à une attente que le régime aura un effet, c'est-à-dire, l'effet est en raison du pouvoir de suggestion. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;IdeaOrConcept"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C2718024">
		<skos:prefLabel xml:lang="en">Stroop Test</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">StroopTest</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Test de Stroop</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">TestDeStroop</skos:hiddenLabel>
		<skos:altLabel xml:lang="fr">Stroop</skos:altLabel>
		<skos:definition xml:lang="en">Timed test in which the subject must read a list of words or identify colors presented with varying instructions and different degrees of distraction. (Campbell's Psychiatric Dictionary. 8th ed.) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0027902"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0034770">
		<skos:prefLabel xml:lang="en">Mental Recall</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">MentalRecall</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Rappel mnésique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">RappelMnésique</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">recall</skos:altLabel>
		<skos:altLabel xml:lang="fr">rappel</skos:altLabel>
		<skos:altLabel xml:lang="fr">rappels</skos:altLabel>
		<skos:altLabel xml:lang="fr">Rappel mental</skos:altLabel>
		<skos:definition xml:lang="en">The process whereby a representation of past experience is elicited. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Processus au cours duquel une représentation d'une expérience passée est obtenue. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;MentalProcess"/>
	</owl:Class>

