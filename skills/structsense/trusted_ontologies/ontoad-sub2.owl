		<skos:altLabel xml:lang="en">Disorder of language</skos:altLabel>
		<skos:altLabel xml:lang="en">LANGUAGE DIS</skos:altLabel>
		<skos:definition xml:lang="en">Conditions characterized by deficiencies of comprehension or expression of written and spoken forms of language. These include acquired and developmental disorders. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;MentalOrBehavioralDysfunction"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:manifestation_of rdf:resource="&OntoAD;C0236642"/>
