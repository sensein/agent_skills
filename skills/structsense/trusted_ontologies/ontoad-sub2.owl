		<skos:altLabel xml:lang="en">CDR</skos:altLabel>
		<skos:altLabel xml:lang="en">ETO</skos:altLabel>
		<skos:altLabel xml:lang="en">MTG8</skos:altLabel>
		<skos:altLabel xml:lang="en">ACUTE MYELOGENOUS LEUKEMIA 1 TRANSLOCATION 1, CYCLIN-D RELATED</skos:altLabel>
		<skos:altLabel xml:lang="en">CORE-BINDING FACTOR, ALPHA SUBUNIT 2, TRANSLOCATED TO, 1</skos:altLabel>
		<skos:altLabel xml:lang="en">ZINC FINGER MYND DOMAIN-CONTAINING PROTEIN 2</skos:altLabel>
		<skos:altLabel xml:lang="en">MYELOID TRANSLOCATION GENE ON 8q22</skos:altLabel>
		<skos:altLabel xml:lang="en">AML1T1</skos:altLabel>
		<skos:altLabel xml:lang="en">CBFA2T1</skos:altLabel>
		<skos:altLabel xml:lang="en">ZMYND2</skos:altLabel>
		<skos:altLabel xml:lang="en">runt-related transcription factor 1; translocated to, 1 (cyclin D-related)</skos:altLabel>
		<skos:altLabel xml:lang="en">Runt-Related Transcription Factor 1; Translocated to, 1 (Cyclin D-Related) Gene</skos:altLabel>
		<skos:altLabel xml:lang="en">RUNX1T1</skos:altLabel>
		<skos:altLabel xml:lang="en">ETO GENE</skos:altLabel>
