	<owl:Class rdf:about="&OntoAD;C0004382">
		<skos:prefLabel xml:lang="en">Autonomic Agents</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AutonomicAgents</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Agents du système nerveux autonome</skos:prefLabel>
