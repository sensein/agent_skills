	<owl:Class rdf:about="&OntoAD;C1185741">
		<skos:prefLabel xml:lang="en">Fascicle - nerve fibers</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Fascicle-NerveFibers</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Faisceau</skos:prefLabel>
