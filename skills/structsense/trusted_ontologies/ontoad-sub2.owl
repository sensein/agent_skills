	<owl:Class rdf:about="&OntoAD;C0042291">
		<skos:prefLabel xml:lang="en">Valproic Acid</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">ValproicAcid</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Acide valproïque</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AcideValproïque</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Divalproex</skos:altLabel>
		<skos:altLabel xml:lang="en">valproate sodium</skos:altLabel>
		<skos:altLabel xml:lang="en">Pentanoic acid, 2-propyl-</skos:altLabel>
		<skos:altLabel xml:lang="en">Dipropylacetic acid</skos:altLabel>
		<skos:altLabel xml:lang="en">DPA</skos:altLabel>
		<skos:altLabel xml:lang="en">divalproex sodium</skos:altLabel>
		<skos:altLabel xml:lang="en">Di-n-propylacetic Acid</skos:altLabel>
		<skos:altLabel xml:lang="en">Propylisopropylacetic Acid</skos:altLabel>
		<skos:altLabel xml:lang="en">dipropylacetic acid (DPA)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Acide 2-propyl-pentanoïque</skos:altLabel>
		<skos:altLabel xml:lang="fr">Acide 2-propylpentanoïque</skos:altLabel>
		<skos:altLabel xml:lang="fr">acide dipropylacétique</skos:altLabel>
		<skos:altLabel xml:lang="fr">DPA</skos:altLabel>
		<skos:altLabel xml:lang="fr">acide 2-propylvalérique</skos:altLabel>
		<skos:definition xml:lang="en">A fatty acid with anticonvulsant properties used in the treatment of epilepsy. The mechanisms of its therapeutic actions are not well understood. It may act by increasing GAMMA-AMINOBUTYRIC ACID levels in the brain or by altering the properties of voltage dependent sodium channels. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0023779"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003286"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0014432"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0242911"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1276998"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1533054"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0589471"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0002395"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0014553"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0005586"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013182"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0023895"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0017687">
		<skos:prefLabel xml:lang="en">Glucagon</skos:prefLabel>
