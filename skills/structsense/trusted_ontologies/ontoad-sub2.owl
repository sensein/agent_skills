	<owl:Class rdf:about="&OntoAD;C0001816">
		<skos:prefLabel xml:lang="en">Agnosia</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Agnosia</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Agnosie</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Agnosie</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Loss of perception of sensory stimuli</skos:altLabel>
		<skos:altLabel xml:lang="fr">perte de la perception des stimuli sensoriels</skos:altLabel>
		<skos:definition xml:lang="en">Loss of the ability to comprehend the meaning or recognize the importance of various forms of stimulation that cannot be attributed to impairment of a primary sensory modality. Tactile agnosia is characterized by an inability to perceive the shape and nature of an object by touch alone, despite unimpaired sensation to light touch, position, and other primary sensory modalities. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Perte de la capacité de comprendre le sens ou de reconnaître l'importance de différentes formes de stimulation, qui ne peut pas être attribuée á l'affaiblissement d'une modalité sensorielle primaire. L'agnosie tactile se caractérise par l'incapacité de percevoir la forme et la nature d'un objet par le toucher seul, malgré la sensation inaltérée au toucher léger, position ou autres modalités sensorielles primaires. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1709838"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0030975"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
	</owl:Class>

