	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0013621">
		<skos:prefLabel xml:lang="en">Knowledge acquisition</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">KnowledgeAcquisition</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Éducation</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Éducation</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">schooling</skos:altLabel>
		<skos:altLabel xml:lang="en">Educational Process</skos:altLabel>
		<skos:altLabel xml:lang="en">EDUC</skos:altLabel>
		<skos:altLabel xml:lang="fr">Sciences de l'éducation</skos:altLabel>
		<skos:altLabel xml:lang="fr">instruction</skos:altLabel>
		<skos:altLabel xml:lang="fr">scolarité</skos:altLabel>
		<skos:definition xml:lang="en">Acquisition of knowledge as a result of instruction in a formal course of study. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;EducationalActivity"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0338430">
		<skos:prefLabel xml:lang="en">Limbic Encephalitis</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">LimbicEncephalitis</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Encéphalite limbique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">EncéphaliteLimbique</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Limbic encephalopathy</skos:altLabel>
		<skos:altLabel xml:lang="en">paraneoplastic limbic; encephalopathy</skos:altLabel>
		<skos:altLabel xml:lang="en">Paraneoplastic Limbic Encephalitis</skos:altLabel>
		<skos:altLabel xml:lang="en">ENCEPH LIMBIC</skos:altLabel>
		<skos:altLabel xml:lang="en">PARANEOPL LIMBIC ENCEPH</skos:altLabel>
		<skos:altLabel xml:lang="fr">Encéphalite limbique paranéoplasique</skos:altLabel>
		<skos:definition xml:lang="en">A paraneoplastic syndrome marked by degeneration of neurons in the LIMBIC SYSTEM. Clinical features include HALLUCINATIONS, loss of EPISODIC MEMORY; ANOSMIA; AGEUSIA; TEMPORAL LOBE EPILEPSY; DEMENTIA; and affective disturbance (depression). Circulating anti-neuronal antibodies (e.g., anti-Hu; anti-Yo; anti-Ri; and anti-Ma2) and small cell lung carcinomas or testicular carcinoma are frequently associated with this syndrome. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1828448"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:has_associated_morphology rdf:resource="&OntoAD;C0021368"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0023715"/>
		<OntoAD:due_to rdf:resource="&OntoAD;C1882062"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0014261">
		<skos:prefLabel xml:lang="en">Endothelium, Vascular</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Endothelium,Vascular</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Endothélium vasculaire</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">EndothéliumVasculaire</skos:hiddenLabel>
		<skos:definition xml:lang="en">Single pavement layer of cells which line the luminal surface of the entire vascular system and regulate the transport of macromolecules and blood components from interstitium to lumen; this function has been most intensively studied in the blood capillaries. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0014257"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0037747">
		<skos:prefLabel xml:lang="en">Spain</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Spain</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Espagne</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Espagne</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">ESP</skos:altLabel>
		<skos:definition xml:lang="en">Parliamentary democracy located between France on the northeast and Portugual on the west and bordered by the Atlantic Ocean and the Mediterranean Sea. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0454664"/>
		<OntoAD:conceptual_part_of rdf:resource="&OntoAD;C0015176"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1096775">
		<skos:prefLabel xml:lang="en">Clinical Trial [Publication Type]</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">ClinicalTrial[PublicationType]</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Essai clinique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">EssaiClinique</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">clinical trial</skos:altLabel>
		<skos:altLabel xml:lang="en">clinical trials</skos:altLabel>
		<skos:altLabel xml:lang="fr">essais cliniques</skos:altLabel>
		<skos:altLabel xml:lang="fr">essais thérapeutiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Essai thérapeutique</skos:altLabel>
		<skos:definition xml:lang="en">Work that is the report of a pre-planned clinical study of the safety, efficacy, or optimum dosage schedule of one or more diagnostic, therapeutic, or prophylactic drugs, devices, or techniques in humans selected according to predetermined criteria of eligibility and observed for predefined evidence of favorable and unfavorable effects. While most clinical trials concern humans, this publication type may be used for clinical veterinary articles meeting the requisites for humans. Specific heading (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">travail qui est le rapport d'une étude clinique pré-planifiée de la sécurité, l'effet, ou le programme de dosage optimal d'un ou les médicaments plus diagnostiques, thérapeutiques, ou prophylactiques, les dispositifs, ou les techniques chez les humains choisis selon les critères prédéterminés de droit et observé pour l'évidence prédéterminée d'effets favorables et défavorables. Pendant que la plupart des essais cliniques concernent des humains, ce type de publication peut être utilisé pour les a (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;IntellectualProduct"/>
	</owl:Class>

