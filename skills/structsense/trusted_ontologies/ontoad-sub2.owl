	<owl:Class rdf:about="&OntoAD;C1366509">
		<skos:prefLabel xml:lang="en">DLC1 gene</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">DLC1Gene</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Deleted in Liver Cancer 1 Gene</skos:altLabel>
		<skos:altLabel xml:lang="en">DLC-1</skos:altLabel>
		<skos:altLabel xml:lang="en">RHO GTPase-ACTIVATING PROTEIN 7</skos:altLabel>
		<skos:altLabel xml:lang="en">ARHGAP7</skos:altLabel>
		<skos:altLabel xml:lang="en">DLC1</skos:altLabel>
		<skos:altLabel xml:lang="en">STARD12</skos:altLabel>
		<skos:altLabel xml:lang="en">DELETED IN LIVER CANCER 1</skos:altLabel>
		<skos:altLabel xml:lang="en">p122-RhoGAP</skos:altLabel>
		<skos:altLabel xml:lang="en">StAR-related lipid transfer (START) domain containing 12</skos:altLabel>
		<skos:definition xml:lang="en">This gene plays a role in cytoskeletal organization and regulation of cell growth. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0935996"/>
		<OntoAD:gene_plays_role_in_process rdf:resource="&OntoAD;C0037083"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1415692">
		<skos:prefLabel xml:lang="en">HP gene</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">HPGene</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">HAPTOGLOBIN</skos:altLabel>
		<skos:altLabel xml:lang="en">Haptoglobin Gene</skos:altLabel>
		<skos:definition xml:lang="en">This gene plays a role in hemoglobin interactions and in the prevention of oxidative tissue damage. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1334396"/>
		<OntoAD:gene_encodes_gene_product rdf:resource="&OntoAD;C1505203"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1505203">
		<skos:prefLabel xml:lang="en">HP protein, human</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">HPProtein,Human</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Haptoglobin</skos:altLabel>
		<skos:altLabel xml:lang="en">haptoglobin, human</skos:altLabel>
		<skos:altLabel xml:lang="en">Ainp2 protein, human</skos:altLabel>
		<skos:altLabel xml:lang="en">ARNT-interacting protein 2, human</skos:altLabel>
		<skos:definition xml:lang="en">Haptoglobin protein (406 aa, 45 kD) is a cell defense response protein that is encoded by the human HP gene and has a role in cellular defense response and may have a role in cellular iron ion homeostasis. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0242210"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1415692"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1334396"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1704665">
		<skos:prefLabel xml:lang="en">DLC1 wt Allele</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">DLC1WtAllele</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">ARHGAP7</skos:altLabel>
		<skos:altLabel xml:lang="en">STARD12</skos:altLabel>
		<skos:altLabel xml:lang="en">Deleted in Liver Cancer 1 wt Allele</skos:altLabel>
		<skos:definition xml:lang="en">Human DLC1 wild-type allele is located within 8p22 and is approximately 432 kb in length. This allele, which encodes rho-GTPase-activating protein 7 protein, is involved in cytoskeletal remodeling and negative regulation of cell growth. Loss of DLC1 gene expression due to deletion and/or hypermethylation is associated with certain types of cancer including breast cancer, hepatocellular carcinoma, gastric cancer and non-small cell lung carcinoma. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1366509"/>
		<OntoAD:gene_plays_role_in_process rdf:resource="&OntoAD;C0037083"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1705568">
		<skos:prefLabel xml:lang="en">HPR wt Allele</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">HPRWtAllele</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Haptoglobin-Related Protein wt Allele</skos:altLabel>
		<skos:definition xml:lang="en">Human HPR wild-type allele is located in the vicinity of 16q22.1 and is approximately 3 kb in length. This allele, which encodes haptoglobin-related protein, plays a role in the binding of antibodies produced in response to Trypanosome brucei. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1337105"/>
		<OntoAD:gene_found_in_organism rdf:resource="&OntoAD;C0086418"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C2698884">
		<skos:prefLabel xml:lang="en">Professional Occupation</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">ProfessionalOccupation</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Professional</skos:altLabel>
		<skos:definition xml:lang="en">An occupation requiring special education, especially in the liberal arts or sciences. (source : NCI)</skos:definition>
