		<skos:hiddenLabel xml:lang="fr">VitesseDeCirculationSanguine</skos:hiddenLabel>
		<skos:altLabel xml:lang="fr">Vitesse circulatoire</skos:altLabel>
		<skos:definition xml:lang="en">A value equal to the total volume flow divided by the cross-sectional area of the vascular bed. (source : MSH)</skos:definition>
