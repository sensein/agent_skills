		<skos:altLabel xml:lang="en">retinoids bexarotene</skos:altLabel>
		<skos:definition xml:lang="en">A drug used to treat skin problems caused by cutaneous T-cell lymphoma that have not gotten better after other treatment. It is also being studied in the treatment of other types of cancer. Targretin is a type of retinoid. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0035339"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013182"/>
	</owl:Class>

