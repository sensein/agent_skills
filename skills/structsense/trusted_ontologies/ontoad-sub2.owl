		<skos:altLabel xml:lang="en">susceptibility genes</skos:altLabel>
		<skos:altLabel xml:lang="en">Cancer Susceptibility Gene</skos:altLabel>
		<skos:altLabel xml:lang="en">Susceptibility Gene</skos:altLabel>
		<skos:altLabel xml:lang="en">predisposing mutation</skos:altLabel>
		<skos:definition xml:lang="en">A germline mutation that increases an individual's susceptibility or predisposition to a certain disease or disorder. When such a mutation is inherited, development of symptoms is more likely, but not certain. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0919542"/>
		<OntoAD:gene_found_in_organism rdf:resource="&OntoAD;C0086418"/>
