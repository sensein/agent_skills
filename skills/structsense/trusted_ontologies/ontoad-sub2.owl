	<owl:Class rdf:about="&OntoAD;C0005064">
		<skos:prefLabel xml:lang="en">Benzodiazepines</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Benzodiazepines</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Benzodiazépines</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Benzodiazépines</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Benzodiazepine</skos:altLabel>
		<skos:altLabel xml:lang="en">Benzodiazepine Compounds</skos:altLabel>
		<skos:altLabel xml:lang="en">BENZODIAZEPINE CPDS</skos:altLabel>
		<skos:altLabel xml:lang="en">Benzodiazepine-class Agent</skos:altLabel>
		<skos:altLabel xml:lang="fr">Composés de benzodiazépine</skos:altLabel>
		<skos:altLabel xml:lang="fr">Benzodiazépine</skos:altLabel>
		<skos:definition xml:lang="en">A group of two-ring heterocyclic compounds consisting of a benzene ring fused to a diazepine ring. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr"> Famille de médicaments aux effets tranquillisants, sédatifs et anticonvulsivants. Ils favorisent la relaxation musculaire et l'endormissement. Pris à forte dose ou pendant une durée trop longue, ils entraînent une dépendance. Leur arrêt brutal expose à un syndrome de sevrage. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0040616"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0020591"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003286"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0020592"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0036557"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0005034"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0085762"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0027552">
		<skos:prefLabel xml:lang="en">Needs</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Needs</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Besoins</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Besoins</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Needed</skos:altLabel>
		<skos:definition xml:lang="en">Anything that is necessary but lacking; the psychological feature that arouses an organism to action toward a desired goal; the reason for the action; that which gives purpose and direction to behavior. (source : NCI)</skos:definition>
		<skos:definition xml:lang="fr">services de la santé exigés par une population ou une communauté aussi bien que les services de la santé pour lesquels la population ou la communauté sont capables et disposés à payer. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;QualitativeConcept"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0302830">
		<skos:prefLabel xml:lang="en">Multilingualism</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Multilingualism</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Plurilinguisme</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Plurilinguisme</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">multilingual</skos:altLabel>
		<skos:altLabel xml:lang="fr">Bilinguisme</skos:altLabel>
		<skos:definition xml:lang="en">The ability to speak, read, or write several languages or many languages with some facility. Bilingualism is the most common form. (From Random House Unabridged Dictionary, 2d ed) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0023008"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0026376">
		<skos:prefLabel xml:lang="en">Molecular Biology</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">MolecularBiology</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Biologie moléculaire</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">BiologieMoléculaire</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">DNA Molecular Biology</skos:altLabel>
		<skos:altLabel xml:lang="en">MOL BIOL</skos:altLabel>
		<skos:definition xml:lang="en">A discipline concerned with studying biological phenomena in terms of the chemical and physical interactions of molecules. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;BiomedicalOccupationOrDiscipline"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0751587">
		<skos:prefLabel xml:lang="en">CADASIL Syndrome</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CADASILSyndrome</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">CADASIL</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">CADASIL</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">CADASIL</skos:altLabel>
		<skos:altLabel xml:lang="en">Cerebral autosomal dominant arteriopathy with subcortical infarcts and leukoencephalopathy</skos:altLabel>
		<skos:altLabel xml:lang="en">CASIL</skos:altLabel>
		<skos:altLabel xml:lang="en">Dementia, Hereditary Multi-Infarct Type</skos:altLabel>
		<skos:altLabel xml:lang="en">Cerebral Arteriopathy with Subcortical Infarcts and Leukoencephalopathy</skos:altLabel>
		<skos:altLabel xml:lang="fr">Artériopathie cérébrale autosomale dominante avec infarctus subcorticaux et leucoencéphalopathie</skos:altLabel>
		<skos:altLabel xml:lang="fr">ACADISL</skos:altLabel>
		<skos:altLabel xml:lang="fr">Démence-infarctus cérébraux multiples héréditaires</skos:altLabel>
		<skos:definition xml:lang="en">A familial, cerebral arteriopathy mapped to chromosome 19q12, and characterized by the presence of granular deposits in small CEREBRAL ARTERIES producing ischemic STROKE; PSEUDOBULBAR PALSY; and multiple subcortical infarcts (CEREBRAL INFARCTION). CADASIL is an acronym for Cerebral Autosomal Dominant Arteriopathy with Subcortical Infarcts and Leukoencephalopathy. CADASIL differs from BINSWANGER DISEASE by the presence of MIGRAINE WITH AURA and usually by the lack of history of arterial HYPERTENS (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">CADASIL est l'acronyme anglophone de l'Artériopathie cérébrale autosomique dominante avec infarctus sous-corticaux et leucoencéphalopathie. (source : MSHFRE)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0039082"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0007820"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1709838"/>
