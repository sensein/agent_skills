	<owl:Class rdf:about="&OntoAD;C0034840">
		<skos:prefLabel xml:lang="en">Receptors, Steroid</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Receptors,Steroid</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Récepteurs aux stéroïdes</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">RécepteursAuxStéroïdes</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Steroid receptor site,</skos:altLabel>
		<skos:altLabel xml:lang="en">Steroid receptor</skos:altLabel>
		<skos:altLabel xml:lang="en">RECEPT STEROID</skos:altLabel>
		<skos:altLabel xml:lang="fr">Récepteurs des stéroïdes</skos:altLabel>
		<skos:altLabel xml:lang="fr">récepteur des stéroïdes</skos:altLabel>
		<skos:definition xml:lang="en">Proteins found usually in the cytoplasm or nucleus that specifically bind steroid hormones and trigger changes influencing the behavior of cells. The steroid receptor-steroid hormone complex regulates the transcription of specific genes. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0597357"/>
	</owl:Class>

