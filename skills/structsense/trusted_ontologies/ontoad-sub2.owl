	<owl:Class rdf:about="&OntoAD;C0002716">
		<skos:prefLabel xml:lang="en">Amyloid</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Amyloid</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Amyloïde</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Amyloïde</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">beta-Amyloid</skos:altLabel>
		<skos:altLabel xml:lang="en">amyloid-beta</skos:altLabel>
		<skos:altLabel xml:lang="en">Amyloid Substance</skos:altLabel>
		<skos:altLabel xml:lang="fr">amyloïdes</skos:altLabel>
		<skos:altLabel xml:lang="fr">beta-amyloïde</skos:altLabel>
		<skos:altLabel xml:lang="fr">Substance amyloïde</skos:altLabel>
		<skos:altLabel xml:lang="fr">dépôt d'amyloïde</skos:altLabel>
		<skos:altLabel xml:lang="fr">dégénérescence cireuse</skos:altLabel>
		<skos:altLabel xml:lang="fr">dégénérescence amyloïde</skos:altLabel>
		<skos:altLabel xml:lang="fr">dégénérescence hyaloïde</skos:altLabel>
		<skos:altLabel xml:lang="fr">dégénérescence lardacée</skos:altLabel>
		<skos:definition xml:lang="en">A fibrous protein complex that consists of proteins folded into a specific cross beta-pleated sheet structure. This fibrillar structure has been found as an alternative folding pattern for a variety of functional proteins. Deposits of amyloid in the form of AMYLOID PLAQUES are associated with a variety of degenerative diseases. The amyloid structure has also been found in a number of functional proteins that are unrelated to disease. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0033684"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0004368">
		<skos:prefLabel xml:lang="en">Autoimmunity</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Autoimmunity</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Auto-immunité</skos:prefLabel>
