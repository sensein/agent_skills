	<owl:Class rdf:about="&OntoAD;C0036150">
		<skos:prefLabel xml:lang="en">Sampling Studies</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">SamplingStudies</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Études par échantillonnage</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ÉtudesParÉchantillonnage</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">study sample</skos:altLabel>
		<skos:altLabel xml:lang="fr">échantillon d'étude</skos:altLabel>
		<skos:altLabel xml:lang="fr">Études d'échantillon</skos:altLabel>
		<skos:definition xml:lang="en">Studies in which a number of subjects are selected from all subjects in a defined population. Conclusions based on sample results may be attributed only to the population sampled. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Etudes dans lesquelles un certain nombre de sujets sont choisis parmi tous les sujets d'une population définie. Les conclusions basées sur les résultats de l'échantillon peuvent être attribués seulement à la la population étudiée. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;ResearchActivity"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;IntellectualProduct"/>
	</owl:Class>

