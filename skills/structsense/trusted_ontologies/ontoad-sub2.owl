	<owl:Class rdf:about="&OntoAD;C0004259">
		<skos:prefLabel xml:lang="en">Atropine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Atropine</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Atropine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Atropine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Dl-hyoscyamine</skos:altLabel>
		<skos:altLabel xml:lang="en">Benzeneacetic acid, alpha-(hydroxymethyl)- 8-methyl-8-azabicyclo(3.2.1)oct-3-yl ester endo-(+-)-</skos:altLabel>
		<skos:altLabel xml:lang="en">Daturine</skos:altLabel>
		<skos:altLabel xml:lang="en">dl-Tropyl Tropate</skos:altLabel>
		<skos:altLabel xml:lang="fr">daturine</skos:altLabel>
		<skos:altLabel xml:lang="fr">dl-hyoscyamine</skos:altLabel>
		<skos:definition xml:lang="en">An alkaloid, originally from Atropa belladonna, but found in other plants, mainly SOLANACEAE. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003385"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003195"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0006280"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0026964"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1444689"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0026896"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0001511"/>
