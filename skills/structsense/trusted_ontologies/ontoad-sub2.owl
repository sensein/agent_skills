	<owl:Class rdf:about="&OntoAD;C0765273">
		<skos:prefLabel xml:lang="en">bexarotene</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Bexarotene</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Bexarotène</skos:prefLabel>
