	<owl:Class rdf:about="&OntoAD;C1267092">
		<skos:prefLabel xml:lang="en">Smooth muscle (tissue)</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">SmoothMuscle(tissue)</skos:hiddenLabel>
