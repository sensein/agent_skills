		<OntoAD:cell_connecting_part_of rdf:resource="&OntoAD;C0027882"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1704338">
		<skos:prefLabel xml:lang="en">diagnosis aspect</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">DiagnosisAspect</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">diagnostic</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Diagnostic</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">diagnosis</skos:altLabel>
		<skos:altLabel xml:lang="en">diagnoses</skos:altLabel>
		<skos:altLabel xml:lang="en">DIAG</skos:altLabel>
		<skos:definition xml:lang="en">Used with diseases for all aspects of diagnosis, including examination, differential diagnosis and prognosis; excludes mass screening for which 'prevention and control' is used. Excludes radiographic diagnosis for which 'radiography' is used; excludes scintigraphic diagnosis for which 'radionuclide imaging' is used; excludes ultrasonic diagnosis for which 'ultrasonography' is used. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr"> (C, F3) /diagnosis /diag ou /DI s'applique aux maladies pour désigner tous les aspects du diagnostic, y compris l'examen, le diagnostic différentiel et le pronostic. Il exclut le dépistage de masse pour lequel le qualificatif 'prevention et contrôle' est employé. Il exclut les diagnostics radiographique, scintigraphique, échographique pour lesquels les qualificatifs 'radiographie', 'scintigraphie' et 'echographie' sont respectivement employés. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;QualitativeConcept"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0013363">
		<skos:prefLabel xml:lang="en">Dysautonomia</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Dysautonomia</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Dysautonomies primitives</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">DysautonomiesPrimitives</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Primary Dysautonomias</skos:altLabel>
		<skos:altLabel xml:lang="fr">Dysautonomie</skos:altLabel>
		<skos:altLabel xml:lang="fr">Dystonie neurovégétative</skos:altLabel>
		<skos:altLabel xml:lang="fr">Dysautonomies primaires</skos:altLabel>
		<skos:altLabel xml:lang="fr">affection du système nerveux autonome</skos:altLabel>
		<skos:altLabel xml:lang="fr">affection du système nerveux autonome périphérique</skos:altLabel>
		<skos:altLabel xml:lang="fr">affection du système neurovégétatif</skos:altLabel>
		<skos:definition xml:lang="en">Disorders of the AUTONOMIC NERVOUS SYSTEM occurring as a primary condition. Manifestations can involve any or all body systems but commonly affect the BLOOD PRESSURE and HEART RATE. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1335029"/>
		<OntoAD:disease_has_associated_anatomic_site rdf:resource="&OntoAD;C0027763"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0011168">
		<skos:prefLabel xml:lang="en">Deglutition Disorders</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">DeglutitionDisorders</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Troubles de la déglutition</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">TroublesDeLaDéglutition</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">dysphagia</skos:altLabel>
		<skos:altLabel xml:lang="en">Swallowing difficult</skos:altLabel>
		<skos:altLabel xml:lang="en">Difficulty swallowing</skos:altLabel>
		<skos:altLabel xml:lang="en">Can't get food down</skos:altLabel>
		<skos:altLabel xml:lang="en">Difficulty in swallowing</skos:altLabel>
		<skos:altLabel xml:lang="en">Swallowing Disorders</skos:altLabel>
		<skos:altLabel xml:lang="en">Cannot get food down</skos:altLabel>
		<skos:altLabel xml:lang="en">Swallowing difficulties (dysphagia)</skos:altLabel>
		<skos:altLabel xml:lang="en">DEGLUTITION DIS</skos:altLabel>
		<skos:altLabel xml:lang="en">SWALLOWING DIS</skos:altLabel>
		<skos:altLabel xml:lang="fr">DIFFICULTE DE DEGLUTITION</skos:altLabel>
		<skos:altLabel xml:lang="fr">DYSPHAGIE</skos:altLabel>
		<skos:altLabel xml:lang="fr">TROUBLE DE LA DEGLUTITION</skos:altLabel>
		<skos:altLabel xml:lang="fr">difficulté de la déglutition</skos:altLabel>
		<skos:definition xml:lang="en">Difficulty in SWALLOWING which may result from neuromuscular disorder or mechanical obstruction. Dysphagia is classified into two distinct types: oropharyngeal dysphagia due to malfunction of the PHARYNX and UPPER ESOPHAGEAL SPHINCTER; and esophageal dysphagia due to malfunction of the ESOPHAGUS. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0426576"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0037089"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0014852"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0392678"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0162429"/>
		<OntoAD:manifestation_of rdf:resource="&OntoAD;C0026896"/>
		<OntoAD:manifestation_of rdf:resource="&OntoAD;C0038868"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0018802"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0043096"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0019682"/>
