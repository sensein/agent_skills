		<skos:hiddenLabel xml:lang="fr">SpectrométrieDeMasse</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Spectroscopy, Mass</skos:altLabel>
		<skos:altLabel xml:lang="en">Spectrum Analysis, Mass</skos:altLabel>
		<skos:altLabel xml:lang="en">Mass spectrometry measurement</skos:altLabel>
		<skos:altLabel xml:lang="en">Mass spectroscopy measurement</skos:altLabel>
		<skos:altLabel xml:lang="en">mass spectrography</skos:altLabel>
		<skos:altLabel xml:lang="en">Photometry/Spectrum Analysis, Mass</skos:altLabel>
		<skos:altLabel xml:lang="en">Mass Spectrum</skos:altLabel>
		<skos:altLabel xml:lang="en">Mass Spec</skos:altLabel>
		<skos:altLabel xml:lang="en">ANAL MASS SPECTRUM</skos:altLabel>
		<skos:altLabel xml:lang="fr">SM (Spectrométrie de Masse)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Analyse de spectre de masse</skos:altLabel>
		<skos:altLabel xml:lang="fr">Analyse spectrale de masse</skos:altLabel>
		<skos:altLabel xml:lang="fr">Spectroscopie de masse</skos:altLabel>
		<skos:altLabel xml:lang="fr">analyse par spectrométrie de masse</skos:altLabel>
		<skos:altLabel xml:lang="fr">analyse par spectroscopie de masse</skos:altLabel>
		<skos:definition xml:lang="en">An analytical method used in determining the identity of a chemical based on its mass using mass analyzers/mass spectrometers. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Analyse de la masse d'un objet par des moyens de détermination des longueurs d'ondes auxquelles l'énergie électromagnétique est absorbée par cet objet. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0436196"/>
		<OntoAD:has_method rdf:resource="&OntoAD;C0242485"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0301532">
		<skos:prefLabel xml:lang="en">Multivitamin preparation</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">MultivitaminPreparation</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">vitamin supplements</skos:altLabel>
		<skos:altLabel xml:lang="en">multiple vitamins</skos:altLabel>
		<skos:altLabel xml:lang="en">MULTIVITAMINS</skos:altLabel>
		<skos:altLabel xml:lang="en">Multivitamin preparations</skos:altLabel>
		<skos:altLabel xml:lang="en">MULTIVIT</skos:altLabel>
		<skos:altLabel xml:lang="en">vitamins multivitamins</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation de multivitamines</skos:altLabel>
		<skos:definition xml:lang="en">A dietary supplement containing all or most of the vitamins that may not be readily available in the diet. Vitamins may be classified according to their solubility either in lipids (vitamins A, D, E, K, F) or in water (vitamins C, B-complex). Present in minute amounts in various foods, vitamins are essential to maintaining normal metabolism and biochemical functions. Check for 'http://www.cancer.gov/Search/ClinicalTrialsLink.aspx?id=43255andidtype=1' active clinical trials or 'http://www.cancer.go (source : )</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0042890"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0242295"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0006111">
		<skos:prefLabel xml:lang="en">Brain Diseases</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">BrainDiseases</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Encéphalopathies</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Encéphalopathies</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">encephalopathy</skos:altLabel>
		<skos:altLabel xml:lang="en">Brain Disorders</skos:altLabel>
		<skos:altLabel xml:lang="en">Disorder of brain</skos:altLabel>
		<skos:altLabel xml:lang="en">Intracranial Central Nervous System Disorders</skos:altLabel>
		<skos:altLabel xml:lang="en">Intracranial CNS Disorders</skos:altLabel>
		<skos:altLabel xml:lang="en">Encephalon Diseases</skos:altLabel>
		<skos:altLabel xml:lang="en">Disease of brain</skos:altLabel>
		<skos:altLabel xml:lang="en">disease; brain</skos:altLabel>
		<skos:altLabel xml:lang="en">BRAIN DIS</skos:altLabel>
		<skos:altLabel xml:lang="en">CNS DIS INTRACRANIAL</skos:altLabel>
		<skos:altLabel xml:lang="en">ENCEPHALON DIS</skos:altLabel>
		<skos:altLabel xml:lang="fr">Encephalopathie</skos:altLabel>
		<skos:altLabel xml:lang="fr">Affections de l'encéphale</skos:altLabel>
		<skos:altLabel xml:lang="fr">Maladies de l'encéphale</skos:altLabel>
		<skos:altLabel xml:lang="fr">Troubles encéphaliques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Troubles intracrâniens du SNC</skos:altLabel>
		<skos:altLabel xml:lang="fr">Troubles intracrâniens du système nerveux central</skos:altLabel>
		<skos:altLabel xml:lang="fr">Troubles cérébraux</skos:altLabel>
		<skos:altLabel xml:lang="fr">Trouble du cerveau</skos:altLabel>
		<skos:altLabel xml:lang="fr">Affection du cerveau, sans précision</skos:altLabel>
		<skos:definition xml:lang="en">Pathologic conditions affecting the BRAIN, which is composed of the intracranial components of the CENTRAL NERVOUS SYSTEM. This includes (but is not limited to) the CEREBRAL CORTEX; intracranial white matter; BASAL GANGLIA; THALAMUS; HYPOTHALAMUS; BRAIN STEM; and CEREBELLUM. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">http://www.orpha.net/gor/cgi-bin//OGmain.php?Lng=FRetTyp=IdentetVal=116.0 (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0007682"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1302710"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0006104"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0020258">
		<skos:prefLabel xml:lang="en">Hydrocephalus, Normal Pressure</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Hydrocephalus,NormalPressure</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Hydrocéphalie à pression normale</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">HydrocéphalieÀPressionNormale</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">normal pressure hydrocephalus</skos:altLabel>
		<skos:altLabel xml:lang="en">Low pressure hydrocephalus</skos:altLabel>
		<skos:altLabel xml:lang="en">Nph</skos:altLabel>
		<skos:altLabel xml:lang="en">NPH  Normal press hydrocephal</skos:altLabel>
		<skos:altLabel xml:lang="en">NPH (Normal Pressure Hydrocephalus)</skos:altLabel>
		<skos:altLabel xml:lang="en">Normal pressure hydrocephalus syndrome</skos:altLabel>
		<skos:altLabel xml:lang="en">Normal pressure hydrocephaly</skos:altLabel>
		<skos:altLabel xml:lang="en">Hakim Syndrome</skos:altLabel>
		<skos:altLabel xml:lang="fr">Syndrome d'Adams et Hakim</skos:altLabel>
		<skos:altLabel xml:lang="fr">Syndrome d'Adams-Hakim</skos:altLabel>
		<skos:altLabel xml:lang="fr">hydrocéphalie chronique de l'adulte</skos:altLabel>
		<skos:altLabel xml:lang="fr">hydrocéphalie à basse pression</skos:altLabel>
		<skos:definition xml:lang="en">A form of compensated hydrocephalus characterized clinically by a slowly progressive gait disorder (see GAIT DISORDERS, NEUROLOGIC), progressive intellectual decline, and URINARY INCONTINENCE. Spinal fluid pressure tends to be in the high normal range. This condition may result from processes which interfere with the absorption of CSF including SUBARACHNOID HEMORRHAGE, chronic MENINGITIS, and other conditions. (From Adams et al., Principles of Neurology, 6th ed, pp631-3) (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">forme de hydrocéphalie compensé caractérisé cliniquement par un désordre de démarche lentement progressif (voir des troubles DE DÉMARCHE, NEUROLOGIQUES), le déclin intellectuel progressif et l'INCONTINENCE URINAIRE. La pression liquide spinale a tendance à être dans la haute gamme normale. Cette affection peut provenir des processus qui se mêlent de l'absorption de CSF en incluant l'HÉMORRAGIE de SOUS-ARACHNOÏDIEN, la MÉNINGITE chronique et d'autres affections. (traduit de 'From Adams et al., Pr (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0009451"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0270716"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0027765"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0459387"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0559546">
		<skos:prefLabel xml:lang="en">Adverse reactions</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AdverseReactions</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Réaction indésirable</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">RéactionIndésirable</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Adverse Effect</skos:altLabel>
		<skos:altLabel xml:lang="en">ADR</skos:altLabel>
		<skos:altLabel xml:lang="en">Adverse reaction</skos:altLabel>
		<skos:definition xml:lang="en">An unexpected medical problem that happens during treatment with a drug or other therapy. Adverse effects do not have to be caused by the drug or therapy, and they may be mild, moderate, or severe. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0009566"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0877248"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0018427">
		<skos:prefLabel xml:lang="en">Structure of cingulate gyrus</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">StructureOfCingulateGyrus</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Gyrus du cingulum</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">GyrusDuCingulum</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">cingulate gyrus</skos:altLabel>
		<skos:altLabel xml:lang="en">Gyrus Cinguli</skos:altLabel>
		<skos:altLabel xml:lang="en">Callosal gyrus</skos:altLabel>
		<skos:altLabel xml:lang="en">cingulate area</skos:altLabel>
		<skos:altLabel xml:lang="en">cingular gyrus</skos:altLabel>
		<skos:altLabel xml:lang="en">cingulate region</skos:altLabel>
		<skos:altLabel xml:lang="en">Gyrus cingulatus</skos:altLabel>
		<skos:altLabel xml:lang="en">falciform lobe</skos:altLabel>
		<skos:altLabel xml:lang="en">upper limbic gyrus</skos:altLabel>
		<skos:altLabel xml:lang="fr">Circonvolution cingulaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">Circonvolution du cingulum</skos:altLabel>
		<skos:altLabel xml:lang="fr">Circonvolution du corps calleux</skos:altLabel>
		<skos:altLabel xml:lang="fr">Lobe falciforme</skos:altLabel>
		<skos:definition xml:lang="en">One of the convolutions on the medial surface of the cerebral hemisphere. It surrounds the rostral part of the brain and interhemispheric commissure and forms part of the LIMBIC SYSTEM. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Une des circonvolutions de la face médiane de l'hémisphère cérébral. Entoure la partie rostrale du cerveau et la commissure inter-hémisphérique, faisant partie du système limbique. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0458325"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0228184"/>
		<OntoAD:regional_part_of rdf:resource="&OntoAD;C0023715"/>
		<OntoAD:has_regional_part rdf:resource="&OntoAD;C0175190"/>
		<OntoAD:attributed_continuous_with rdf:resource="&OntoAD;C0152306"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0587906">
		<skos:prefLabel xml:lang="en">Hospital clinic</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">HospitalClinic</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Clinics or Hospitals</skos:altLabel>
		<skos:definition xml:lang="en">Institutions with an organized medical staff for the medical care, treatment, and cure of the sick and wounded, for the study of disease, and for the training of physicians, nurses, and allied health personnel. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0018704"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0557822"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0023746">
		<skos:prefLabel xml:lang="en">Linkage Disequilibrium</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">LinkageDisequilibrium</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Déséquilibre de liaison</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">DéséquilibreDeLiaison</skos:hiddenLabel>
		<skos:definition xml:lang="en">Nonrandom association of linked genes. This is the tendency of the alleles of two separate but already linked loci to be found together more frequently than would be expected by chance alone. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Association non aléatoire de gènes liés dans une population. Situation dans laquelle deux allèles sur deux gènes distincts sont retrouvés plus fréquemment associés dans une population avec une fréquence qui s’écarte de la valeur attendue. (source : MSHFRE)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;QuantitativeConcept"/>
	</owl:Class>

