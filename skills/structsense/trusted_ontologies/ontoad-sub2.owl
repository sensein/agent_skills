	<owl:Class rdf:about="&OntoAD;C0003289">
		<skos:prefLabel xml:lang="en">Antidepressive Agents</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AntidepressiveAgents</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Antidépresseurs</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Antidépresseurs</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">antidepressants</skos:altLabel>
		<skos:altLabel xml:lang="en">Antidepressant Drugs</skos:altLabel>
		<skos:altLabel xml:lang="en">Antidepressant</skos:altLabel>
		<skos:altLabel xml:lang="en">Antidepressant Agent</skos:altLabel>
		<skos:altLabel xml:lang="en">Antidepressant drug</skos:altLabel>
		<skos:altLabel xml:lang="en">Antidepressive Agent</skos:altLabel>
		<skos:altLabel xml:lang="en">Antidepressive</skos:altLabel>
		<skos:altLabel xml:lang="fr">anti-dépresseur</skos:altLabel>
		<skos:altLabel xml:lang="fr">Antidépresseur</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents antidépresseurs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Anti-dépresseurs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments antidépresseurs</skos:altLabel>
		<skos:definition xml:lang="en">Mood-stimulating drugs used primarily in the treatment of affective disorders and related conditions. Several MONOAMINE OXIDASE INHIBITORS are useful as antidepressants apparently as a long-term consequence of their modulation of catecholamine levels. The tricyclic compounds useful as antidepressive agents (ANTIDEPRESSIVE AGENTS, TRICYCLIC) also appear to act through brain catecholamine systems. A third group (ANTIDEPRESSIVE AGENTS, SECOND-GENERATION) is a diverse group of drugs including some t (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">http://www.fnclcc.fr/fr/patients/dico/definition.php?id_definition=114 (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0033978"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2697973"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0026516">
		<skos:prefLabel xml:lang="en">Mood (psychological function)</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Mood(psychologicalFunction)</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Humeur</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Humeur</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">mood</skos:altLabel>
		<skos:altLabel xml:lang="en">Moody</skos:altLabel>
		<skos:altLabel xml:lang="en">Mood, function</skos:altLabel>
		<skos:altLabel xml:lang="fr">Thymie</skos:altLabel>
		<skos:definition xml:lang="en">A relatively temporary state of feeling. (source : NCI)</skos:definition>
		<skos:definition xml:lang="fr">'Ressenti-tonalité' accompagnant une idée ou une représentation mentale. C'est le dérivé psychique le plus direct de l'instinct et la représentation psychique des différents changements dans le corps par lesquels les instincts se manifestent. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;MentalProcess"/>
		<OntoAD:biological_process_has_associated_location rdf:resource="&OntoAD;C0006104"/>
		<OntoAD:biological_process_has_associated_location rdf:resource="&OntoAD;C0027763"/>
	</owl:Class>

