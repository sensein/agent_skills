		<skos:hiddenLabel xml:lang="fr">Strabisme</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">crossed eye</skos:altLabel>
		<skos:altLabel xml:lang="en">Phorias</skos:altLabel>
		<skos:altLabel xml:lang="en">Squint</skos:altLabel>
		<skos:altLabel xml:lang="en">Heterophoria,</skos:altLabel>
		<skos:altLabel xml:lang="en">Heterotropia</skos:altLabel>
		<skos:altLabel xml:lang="en">Disord binoc eye movem</skos:altLabel>
		<skos:altLabel xml:lang="en">Disorder of binocular eye movements</skos:altLabel>
		<skos:altLabel xml:lang="en">heterophoria</skos:altLabel>
		<skos:altLabel xml:lang="en">Ocular dissociation</skos:altLabel>
		<skos:altLabel xml:lang="en">squinting</skos:altLabel>
		<skos:altLabel xml:lang="fr">DEFAUT CONVERGENCE AXES VISUELS</skos:altLabel>
		<skos:altLabel xml:lang="fr">Anomalie des mouvements conjugués des yeux</skos:altLabel>
		<skos:altLabel xml:lang="fr">Hétérophorie</skos:altLabel>
		<skos:altLabel xml:lang="fr">Phories</skos:altLabel>
		<skos:altLabel xml:lang="fr">Hétérotropie</skos:altLabel>
		<skos:altLabel xml:lang="fr">Anomalie des mouvements binoculaires</skos:altLabel>
		<skos:altLabel xml:lang="fr">strabisme latent</skos:altLabel>
		<skos:altLabel xml:lang="fr">Strabisme, sans précision</skos:altLabel>
		<skos:definition xml:lang="en">Misalignment of the visual axes of the eyes. In comitant strabismus the degree of ocular misalignment does not vary with the direction of gaze. In noncomitant strabismus the degree of misalignment varies depending on direction of gaze or which eye is fixating on the target. (Miller, Walsh and Hoyt's Clinical Neuro-Ophthalmology, 4th ed, p641) (source : MSH)</skos:definition>
