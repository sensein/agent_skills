	<owl:Class rdf:about="&OntoAD;C0033978">
		<skos:prefLabel xml:lang="en">Psychotropic Drugs</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">PsychotropicDrugs</skos:hiddenLabel>
