	<owl:Class rdf:about="&OntoAD;C1333200">
		<skos:prefLabel xml:lang="en">Cytoskeletal Gene</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CytoskeletalGene</skos:hiddenLabel>
		<skos:definition xml:lang="en">Cytoskeletal Genes encode Cytoskeletal Proteins, diverse structural proteins including polymerizable globular subunits (actin, tubulin), 'motor ATPases' (myosin, dynein), membrane-supporting linkers (spectrin, clathrin), fibrous proteins (keratin, vimentin), and many more. As constituents of the cytoskeleton, Cytoskeletal Proteins form a flexible cellular framework that provides attachment points for organelles and formed bodies and makes communication between cell parts possible. (NCI) (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0017366"/>
		<OntoAD:gene_encodes_gene_product rdf:resource="&OntoAD;C2700455"/>
