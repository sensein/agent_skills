		<skos:altLabel xml:lang="fr">étude prospective</skos:altLabel>
		<skos:definition xml:lang="en">Studies in which variables relating to an individual or group of individuals are assessed over a period of time. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">études dans lesquelles les variables se rapportant à un individu ou à un groupe d'individus sont évaluées pour la durée du temps. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2347799"/>
