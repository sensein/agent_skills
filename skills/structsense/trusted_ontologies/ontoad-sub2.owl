	<owl:Class rdf:about="&OntoAD;C0740394">
		<skos:prefLabel xml:lang="en">Hyperuricemia</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Hyperuricemia</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Hyperuricémie</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Hyperuricémie</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">URIC ACID ELEVATED</skos:altLabel>
		<skos:altLabel xml:lang="en">Uric acid retention</skos:altLabel>
		<skos:altLabel xml:lang="en">Uricacidemia</skos:altLabel>
		<skos:altLabel xml:lang="en">Hyperuricaemic</skos:altLabel>
		<skos:altLabel xml:lang="en">Hyperuricaemia</skos:altLabel>
		<skos:altLabel xml:lang="en">Uricacidaemia</skos:altLabel>
		<skos:altLabel xml:lang="en">uricemia</skos:altLabel>
		<skos:altLabel xml:lang="fr">RETENTION D'ACIDE URIQUE</skos:altLabel>
		<skos:altLabel xml:lang="fr">Hyperuricémique</skos:altLabel>
		<skos:definition xml:lang="en">Excessive URIC ACID or urate in blood as defined by its solubility in plasma at 37 degrees C; greater than 0.42mmol per liter (7.0mg/dL) in men or 0.36mmol per liter (6.0mg/dL) in women. This condition is caused by overproduction of uric acid or impaired renal clearance. Hyperuricemia can be acquired, drug-induced or genetically determined (LESCH-NYHAN SYNDROME). It is associated with HYPERTENSION and GOUT. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0041981"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1332129"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
