	<owl:Class rdf:about="&OntoAD;C1707283">
		<skos:prefLabel xml:lang="en">Carcinogenic Metal</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CarcinogenicMetal</skos:hiddenLabel>
		<skos:definition xml:lang="en">An electropositive element that can increase the risk of human cancer and is characterized by ductility, malleability, luster, the ability to conduct heat and electricity and the tendency to lose rather than gain electrons in chemicals. (NCI05) (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1711335"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0013879">
