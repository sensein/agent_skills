	<owl:Class rdf:about="&OntoAD;C0021576">
		<skos:prefLabel xml:lang="en">Insecticides</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Insecticides</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Insecticides</skos:prefLabel>
