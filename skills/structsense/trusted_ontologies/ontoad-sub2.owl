		<skos:definition xml:lang="en">vitamin D dependent calcium binding protein; may act as an intracellular calcium buffer. (source : CSP)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1335532"/>
	</owl:Class>

