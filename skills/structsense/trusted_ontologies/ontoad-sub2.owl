	<owl:Class rdf:about="&OntoAD;C0345905">
		<skos:prefLabel xml:lang="en">Intrahepatic Cholangiocarcinoma</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">IntrahepaticCholangiocarcinoma</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Carcinome intrahépatique des voies biliaires</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">CarcinomeIntrahépatiqueDesVoiesBiliaires</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Intrahep bile duct carcinoma</skos:altLabel>
		<skos:altLabel xml:lang="en">Intrahepatic bile duct carcinoma</skos:altLabel>
		<skos:altLabel xml:lang="en">carcinoma; bile duct, liver</skos:altLabel>
		<skos:altLabel xml:lang="en">cholangiocarcinoma of liver</skos:altLabel>
		<skos:altLabel xml:lang="en">ICC</skos:altLabel>
		<skos:altLabel xml:lang="en">Intrahepatic Cholangiocellular Carcinoma</skos:altLabel>
		<skos:altLabel xml:lang="en">Peripheral Cholangiocarcinoma</skos:altLabel>
		<skos:altLabel xml:lang="en">liver neoplasm malignant adenocarcinoma cholangiocarcinoma</skos:altLabel>
		<skos:altLabel xml:lang="en">cholangiocarcinoma of intrahepatic bile duct</skos:altLabel>
		<skos:altLabel xml:lang="en">carcinoma of intrahepatic bile duct</skos:altLabel>
		<skos:altLabel xml:lang="fr">Carcinome du canal biliaire intrahépatique</skos:altLabel>
		<skos:definition xml:lang="en">An malignant tumor composed of cells resembling those of bile ducts. Cholangiocarcinoma is a relatively rare tumor in most populations. It can arise from any portion of the intrahepatic bile duct epithelium or the hepatic ducts. Grossly, the lesions are nodular, grayish-white firm and solid. Microscopically, the vast majority of cholangiocarcinomas are adenocarcinomas showing tubular and/or papillary structures. Early detection of cholangiocarcinomas is difficult, and the overall prognosis after (source : )</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0206698"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0948680"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0023895"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2960369"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0279000"/>
		<OntoAD:disease_may_have_finding rdf:resource="&OntoAD;C0043096"/>
		<OntoAD:disease_has_normal_tissue_origin rdf:resource="&OntoAD;C0014609"/>
		<OntoAD:has_associated_morphology rdf:resource="&OntoAD;C0007097"/>
		<OntoAD:disease_may_have_finding rdf:resource="&OntoAD;C0231218"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0023870">
		<skos:prefLabel xml:lang="en">Lithium</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Lithium</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Lithium</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Lithium</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Li+</skos:altLabel>
		<skos:altLabel xml:lang="en">Li  Lithium</skos:altLabel>
		<skos:altLabel xml:lang="en">Li+ element</skos:altLabel>
		<skos:altLabel xml:lang="en">Lithium product</skos:altLabel>
		<skos:altLabel xml:lang="en">Lithium Ion</skos:altLabel>
		<skos:altLabel xml:lang="en">Lithium Cation</skos:altLabel>
		<skos:altLabel xml:lang="en">Lithium Metallicum</skos:altLabel>
		<skos:definition xml:lang="en">An element in the alkali metals family. It has the atomic symbol Li, atomic number 3, and atomic weight [6.938; 6.997]. Salts of lithium are used in treating BIPOLAR DISORDER. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Élément minéral proche du sodium, utilisé soit sous forme de traces (oligoéléments) pour traiter les troubles légers du sommeil et la nervosité, soit à forte dose pour traiter les troubles graves de l'humeur. A dose élevée, il peut donner lieu à des interactions médicamenteuses. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0040615"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0242911"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1276998"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0303506"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1533054"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1254347"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0011581"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0005586"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0010068"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0020625"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0038436"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013182"/>
