	<owl:Class rdf:about="&OntoAD;C0032743">
		<skos:prefLabel xml:lang="en">Positron-Emission Tomography</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Positron-EmissionTomography</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Tomographie par émission de positons</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">TomographieParÉmissionDePositons</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">PET imaging</skos:altLabel>
		<skos:altLabel xml:lang="en">PET scan</skos:altLabel>
		<skos:altLabel xml:lang="en">positron emission tomography</skos:altLabel>
		<skos:altLabel xml:lang="en">PET</skos:altLabel>
		<skos:altLabel xml:lang="en">PET Positron emission tomog</skos:altLabel>
		<skos:altLabel xml:lang="en">PET  Positron emission tomography</skos:altLabel>
		<skos:altLabel xml:lang="en">PETT</skos:altLabel>
		<skos:altLabel xml:lang="en">Positron emission tomogram</skos:altLabel>
		<skos:altLabel xml:lang="en">Positron Emission Tomography Scan</skos:altLabel>
		<skos:altLabel xml:lang="en">FDG-PET</skos:altLabel>
		<skos:altLabel xml:lang="en">proton magnetic resonance spectroscopic imaging</skos:altLabel>
		<skos:altLabel xml:lang="en">Positron emission tomographic imaging  action</skos:altLabel>
		<skos:altLabel xml:lang="en">Positron emission tomographic imaging</skos:altLabel>
		<skos:altLabel xml:lang="en">Medical Imaging, Positron Emission Tomography</skos:altLabel>
		<skos:altLabel xml:lang="en">POSITRON EMISS TOMOGR</skos:altLabel>
		<skos:altLabel xml:lang="fr">PET-FDG</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tomographie par émission de positrons</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tomographie à positrons</skos:altLabel>
		<skos:altLabel xml:lang="fr">TEP-Scan</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tomographie à émission de positons</skos:altLabel>
		<skos:altLabel xml:lang="fr">PET-scan</skos:altLabel>
		<skos:altLabel xml:lang="fr">TPE</skos:altLabel>
		<skos:altLabel xml:lang="fr">TEP (Tomographie par Émission de Positons)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tomographie à positons</skos:altLabel>
		<skos:altLabel xml:lang="fr">TEP</skos:altLabel>
		<skos:definition xml:lang="en">An imaging technique using compounds labelled with short-lived positron-emitting radionuclides (such as carbon-11, nitrogen-13, oxygen-15 and fluorine-18) to measure cell metabolism. It has been useful in study of soft tissues such as CANCER; CARDIOVASCULAR SYSTEM; and brain. SINGLE-PHOTON EMISSION-COMPUTED TOMOGRAPHY is closely related to positron emission tomography, but uses isotopes with longer half-lives and resolution is lower. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">http://info.cancer.ca/f/glossary/T/Tomographie_par__mission_de_positrons_(TEP).htm (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0040405"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2368359"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0021469">
		<skos:prefLabel xml:lang="en">Metabolic Inhibition</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">MetabolicInhibition</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Inhibiting</skos:altLabel>
		<skos:altLabel xml:lang="en">physical inhibition</skos:altLabel>
		<skos:altLabel xml:lang="en">Inhibition, function</skos:altLabel>
		<skos:altLabel xml:lang="en">Inhibitory</skos:altLabel>
		<skos:altLabel xml:lang="fr">inhibition</skos:altLabel>
		<skos:altLabel xml:lang="fr">inhibé</skos:altLabel>
		<skos:definition xml:lang="en">The interference with or prevention of an action or response even though the stimulus for that action or response is present. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C3266814"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0006560">
		<skos:prefLabel xml:lang="en">C-reactive protein</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">C-reactiveProtein</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Protéine C-réactive</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ProtéineC-réactive</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Proteins, specific or class, C-reactive</skos:altLabel>
		<skos:altLabel xml:lang="en">CRP  C-reactive protein</skos:altLabel>
		<skos:altLabel xml:lang="en">C reactive protein</skos:altLabel>
		<skos:altLabel xml:lang="en">CRP</skos:altLabel>
		<skos:altLabel xml:lang="fr">Proteine C reactive</skos:altLabel>
		<skos:altLabel xml:lang="fr">protéine CRP</skos:altLabel>
		<skos:definition xml:lang="en">A plasma protein that circulates in increased amounts during inflammation and after tissue damage. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003320"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0001347"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0017649"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0021072"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1413716"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1334166"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0201657">
		<skos:prefLabel xml:lang="en">C-reactive protein measurement</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">C-reactiveProteinMeasurement</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Protéine C-réactive</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ProtéineC-réactive</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">C-reactive protein level</skos:altLabel>
		<skos:altLabel xml:lang="en">C-reactive protein, quantitative</skos:altLabel>
		<skos:altLabel xml:lang="en">CRP  C-reactive protein level</skos:altLabel>
		<skos:altLabel xml:lang="en">CRP</skos:altLabel>
		<skos:altLabel xml:lang="en">c-reactive protein (CRP) test</skos:altLabel>
		<skos:altLabel xml:lang="fr">mesure de la protéine C-réactive</skos:altLabel>
		<skos:definition xml:lang="en">A quantitative measurement of the amount of C-reactive protein present in a sample. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0877347"/>
		<OntoAD:has_method rdf:resource="&OntoAD;C0242485"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1879974">
		<skos:prefLabel xml:lang="en">CRP wt Allele</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CRPWtAllele</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">PTX1</skos:altLabel>
		<skos:altLabel xml:lang="en">CRP</skos:altLabel>
		<skos:altLabel xml:lang="en">MGC88244</skos:altLabel>
		<skos:altLabel xml:lang="en">C-Reactive Protein, Pentraxin-Related wt Allele</skos:altLabel>
		<skos:altLabel xml:lang="en">C-Reactive Protein Gene</skos:altLabel>
		<skos:definition xml:lang="en">Human CRP wild-type allele is located within 1q21-q23 and is approximately 2 kb in length. This allele, which encodes c-reactive protein, is involved in acute inflammatory processes and in immune recognition and effector function. The gene also plays a role in the clinical evaluation of cardiovascular disease. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1413716"/>
		<OntoAD:gene_is_biomarker_of rdf:resource="&OntoAD;C0007222"/>
		<OntoAD:gene_plays_role_in_process rdf:resource="&OntoAD;C1155266"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0042874">
		<skos:prefLabel xml:lang="en">Vitamin E</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">VitaminE</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Vitamine E</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">VitamineE</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Vitamin E preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">Vitamin E product</skos:altLabel>
		<skos:altLabel xml:lang="en">VIT E</skos:altLabel>
		<skos:altLabel xml:lang="en">Vitamin E Compound</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation de vitamine E</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation d'alpha-tocophérol</skos:altLabel>
		<skos:altLabel xml:lang="fr">d-alpha-tocophérol</skos:altLabel>
		<skos:definition xml:lang="en">A generic descriptor for all TOCOPHEROLS and TOCOTRIENOLS that exhibit ALPHA-TOCOPHEROL activity. By virtue of the phenolic hydrogen on the 2H-1-benzopyran-6-ol nucleus, these compounds exhibit varying degree of antioxidant activity, depending on the site and number of methyl groups and the type of ISOPRENOIDS. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Un descripteur générique pour tous les tocophérols et les tocotrienols ayant une activité alpha-tocophérol. En vertu de l'hydrogène phenolique sur le noyau (2H-1- benzopyran-6-ol), ces composés ont un degré variable d'activité anti-oxydante, selon l'emplacement et le nombre des radicaux méthyl et du type d'isoprénoïde. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003402"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0259753"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0005078"/>
		<OntoAD:may_prevent rdf:resource="&OntoAD;C0002395"/>
		<OntoAD:replaces rdf:resource="&OntoAD;C0087096"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013182"/>
		<OntoAD:may_prevent rdf:resource="&OntoAD;C0002878"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1142098">
		<skos:prefLabel xml:lang="en">Vitamin E Assay</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">VitaminEAssay</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Vitamine E</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">VitamineE</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Tocopherol</skos:altLabel>
		<skos:altLabel xml:lang="en">Vitamin E measurement</skos:altLabel>
