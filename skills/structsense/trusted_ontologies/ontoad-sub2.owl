	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0751072">
		<skos:prefLabel xml:lang="en">Frontotemporal Lobar Degeneration</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">FrontotemporalLobarDegeneration</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Dégénérescence lobaire frontotemporale</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">DégénérescenceLobaireFrontotemporale</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">FTLD</skos:altLabel>
		<skos:altLabel xml:lang="fr">Dégénérescence lobaire fronto-temporale</skos:altLabel>
		<skos:altLabel xml:lang="fr">DLFT</skos:altLabel>
		<skos:altLabel xml:lang="fr">dégénérescences lobaires frontotemporales</skos:altLabel>
		<skos:altLabel xml:lang="fr">dégénérescence frontotemporale</skos:altLabel>
		<skos:altLabel xml:lang="fr">dégénérescences lobaires</skos:altLabel>
		<skos:definition xml:lang="en">Heterogeneous group of neurodegenerative disorders characterized by frontal and temporal lobe atrophy associated with neuronal loss, gliosis, and dementia. Patients exhibit progressive changes in social, behavioral, and/or language function. Multiple subtypes or forms are recognized based on presence or absence of TAU PROTEIN inclusions. FTLD includes three clinical syndromes: FRONTOTEMPORAL DEMENTIA, semantic dementia, and PRIMARY PROGRESSIVE NONFLUENT APHASIA. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0497327"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0870252">
		<skos:prefLabel xml:lang="en">Caregiver Burden</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CaregiverBurden</skos:hiddenLabel>
		<skos:definition xml:lang="en">Used primarily for family or nonprofessional caregivers and the stress or associated emotional responses experienced when caring for the mentally or physically disabled. Consider OCCUPATIONAL STRESS for professional caregivers, e.g., health care personnel. (source : PSY)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;QualitativeConcept"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0681925">
		<skos:prefLabel xml:lang="en">logistic regression analysis</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">LogisticRegressionAnalysis</skos:hiddenLabel>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0034980"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0026777">
		<skos:prefLabel xml:lang="en">Multivariate Analysis</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">MultivariateAnalysis</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Analyse multivariée</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AnalyseMultivariée</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">multivariate analyses</skos:altLabel>
		<skos:altLabel xml:lang="en">MULTIVARIATE ANAL</skos:altLabel>
		<skos:altLabel xml:lang="fr">analyses multivariées</skos:altLabel>
		<skos:altLabel xml:lang="fr">Analyse multifactorielle</skos:altLabel>
		<skos:definition xml:lang="en">A set of techniques used when variation in several variables has to be studied simultaneously. In statistics, multivariate analysis is interpreted as any analytic method that allows simultaneous study of two or more dependent variables. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">ensemble de techniques a utilisé quand la variation dans plusieurs variables doit être étudiée simultanément. Dans la statistique, ¤slmultivariate¤sl l'analyse est interprété comme toute méthode analytique qui permet l'étude simultanée d'au moins deux variables dépendantes. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0002780"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0525041">
		<skos:prefLabel xml:lang="en">Neurobehavioral Manifestations</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">NeurobehavioralManifestations</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Manifestations neurocomportementales</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ManifestationsNeurocomportementales</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">cognitive symptoms</skos:altLabel>
		<skos:altLabel xml:lang="en">Cognitive Manifestations</skos:altLabel>
		<skos:altLabel xml:lang="en">Signs and Symptoms, Neurobehavioral</skos:altLabel>
		<skos:altLabel xml:lang="fr">symptômes cognitifs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Manifestations neuro-comportementales</skos:altLabel>
		<skos:altLabel xml:lang="fr">Manifestations cognitives</skos:altLabel>
		<skos:altLabel xml:lang="fr">Manifestations neuro-cognitives</skos:altLabel>
		<skos:altLabel xml:lang="fr">Manifestations neurocognitives</skos:altLabel>
		<skos:altLabel xml:lang="fr">Signes et symptômes neurocomportementaux</skos:altLabel>
		<skos:definition xml:lang="en">Signs and symptoms of higher cortical dysfunction caused by organic conditions. These include certain behavioral alterations and impairments of skills involved in the acquisition, processing, and utilization of knowledge or information. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">signes et les symptômes de plus haut cortical le dysfonctionnement provoqué par les affections organiques. Ceux-ci incluent de certaines modifications de comportement et des affaiblissements d'adresses impliquées dans l'acquisition, le traitement et l'utilisation de connaissance ou de renseignements. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;SignOrSymptom"/>
	</owl:Class>

