	<owl:Class rdf:about="&OntoAD;C0017263">
		<skos:prefLabel xml:lang="en">Gene Expression Regulation</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">GeneExpressionRegulation</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Régulation de l'expression des gènes</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">RégulationDeL'expressionDesGènes</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">gene regulation</skos:altLabel>
		<skos:altLabel xml:lang="en">Gene Action Regulation</skos:altLabel>
		<skos:altLabel xml:lang="en">genetic regulation</skos:altLabel>
		<skos:altLabel xml:lang="en">genetic control</skos:altLabel>
		<skos:altLabel xml:lang="en">Gene Expression Alteration</skos:altLabel>
		<skos:altLabel xml:lang="en">Gene Regulation Process</skos:altLabel>
		<skos:altLabel xml:lang="en">EXPRESSION REG GENE</skos:altLabel>
		<skos:altLabel xml:lang="en">GENE ACTION REG</skos:altLabel>
		<skos:altLabel xml:lang="en">genetics regulations</skos:altLabel>
		<skos:altLabel xml:lang="fr">Régulation de l'expression génique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Régulation de l'activité des gènes</skos:altLabel>
		<skos:altLabel xml:lang="fr">Régulation de l'activité génique</skos:altLabel>
		<skos:definition xml:lang="en">Any of the processes by which nuclear, cytoplasmic, or intercellular factors influence the differential control (induction or repression) of gene action at the level of transcription or translation. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1517486"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0017398"/>
