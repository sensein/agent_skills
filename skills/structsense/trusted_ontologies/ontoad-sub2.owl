		<skos:hiddenLabel xml:lang="en">ParathyroidHormone</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Hormone parathyroïdienne</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">HormoneParathyroïdienne</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Parathormone</skos:altLabel>
		<skos:altLabel xml:lang="en">Parathyrin</skos:altLabel>
		<skos:altLabel xml:lang="en">PTH</skos:altLabel>
		<skos:altLabel xml:lang="en">PARATHYROID</skos:altLabel>
		<skos:altLabel xml:lang="en">Parathyroid extract</skos:altLabel>
		<skos:altLabel xml:lang="en">Parathyroid hormone preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">PTH  Parathyroid hormone</skos:altLabel>
		<skos:altLabel xml:lang="en">Parathormone preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">B34 PARATHYROID HORMONES</skos:altLabel>
		<skos:altLabel xml:lang="en">Parathyroid hormone agent</skos:altLabel>
		<skos:altLabel xml:lang="en">Intact parathyroid hormone</skos:altLabel>
		<skos:altLabel xml:lang="en">Parathyroid-class Hormone</skos:altLabel>
		<skos:altLabel xml:lang="fr">Parathormone</skos:altLabel>
		<skos:altLabel xml:lang="fr">Parathyrine</skos:altLabel>
		<skos:altLabel xml:lang="fr">PTH (Parathyroid hormone)</skos:altLabel>
		<skos:altLabel xml:lang="fr">PTH</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation d'hormone parathyroïdienne</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation de parathormone</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation d'extrait parathyroïdien</skos:altLabel>
		<skos:definition xml:lang="en">A polypeptide hormone (84 amino acid residues) secreted by the PARATHYROID GLANDS which performs the essential role of maintaining intracellular CALCIUM levels in the body. Parathyroid hormone increases intracellular calcium by promoting the release of CALCIUM from BONE, increases the intestinal absorption of calcium, increases the renal tubular reabsorption of calcium, and increases the renal excretion of phosphates. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0360589"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0582246"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0019928"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1254349"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1419072">
		<skos:prefLabel xml:lang="en">PTH gene</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">PTHGene</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">PARATHORMONE</skos:altLabel>
		<skos:altLabel xml:lang="en">PARATHYRIN</skos:altLabel>
		<skos:altLabel xml:lang="en">PARATHYROID HORMONE</skos:altLabel>
		<skos:altLabel xml:lang="en">PTH</skos:altLabel>
		<skos:altLabel xml:lang="en">Parathyroid Hormone Gene</skos:altLabel>
		<skos:altLabel xml:lang="en">PTH1</skos:altLabel>
		<skos:altLabel xml:lang="en">parathyroid hormone 1</skos:altLabel>
		<skos:definition xml:lang="en">This gene plays a role in blood calcium regulation. Defects in the gene are associated with familial isolated hypoparathyroidism. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1335375"/>
		<OntoAD:gene_encodes_gene_product rdf:resource="&OntoAD;C0020063"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1705340">
		<skos:prefLabel xml:lang="en">PTH wt Allele</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">PTHWtAllele</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">PTH</skos:altLabel>
		<skos:altLabel xml:lang="en">Parathyroid Hormone wt Allele</skos:altLabel>
		<skos:definition xml:lang="en">Human PTH wild-type allele is located within 11p15.3-p15.1 and is approximately 4 kb in length. This allele, which encodes parathyroid hormone protein, plays a role in calcium homeostasis. Mutation or aberrant expression of this gene can result in hypoparathyroidism. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1419072"/>
	</owl:Class>

