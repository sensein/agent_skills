	<owl:Class rdf:about="&OntoAD;C0027021">
		<skos:prefLabel xml:lang="en">Peroxidase</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Peroxidase</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Myeloperoxidase</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Myeloperoxidase</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Hemi-Myeloperoxidase</skos:altLabel>
		<skos:altLabel xml:lang="en">Myeloperoxidase</skos:altLabel>
		<skos:altLabel xml:lang="en">Donor:hydrogen-peroxide oxidoreductase</skos:altLabel>
		<skos:altLabel xml:lang="en">MPO</skos:altLabel>
		<skos:altLabel xml:lang="en">Mpx  Myeloperoxidase</skos:altLabel>
		<skos:altLabel xml:lang="en">EC 1.11.1.7</skos:altLabel>
		<skos:altLabel xml:lang="fr">peroxydase</skos:altLabel>
		<skos:definition xml:lang="en">A hemeprotein from leukocytes. Deficiency of this enzyme leads to a hereditary disorder coupled with disseminated moniliasis. It catalyzes the conversion of a donor and peroxide to an oxidized donor and water. EC 1.11.1.7. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0031179"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0443782"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0443871"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1333402"/>
		<OntoAD:gene_product_has_organism_source rdf:resource="&OntoAD;C0086418"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1335186"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0015540">
		<skos:prefLabel xml:lang="en">Flavin-Adenine Dinucleotide</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Flavin-AdenineDinucleotide</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Flavine adénine dinucléotide</skos:prefLabel>
