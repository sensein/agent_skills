		<skos:hiddenLabel xml:lang="en">CareActivity</skos:hiddenLabel>
		<skos:definition xml:lang="en">The work of attending to someone or something. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C3266814"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0687744">
		<skos:prefLabel xml:lang="en">Social group</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">SocialGroup</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">groups</skos:altLabel>
		<skos:definition xml:lang="en">group of individuals, assembled or dispersed, who are united by a common social interest, characteristics or attachment and whose actions are interrelated; for a small group of individuals use SMALL SOCIAL GROUP. (source : CSP)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1257890"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1257890">
		<skos:prefLabel xml:lang="en">Population Group</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">PopulationGroup</skos:hiddenLabel>
