		<skos:altLabel xml:lang="en">Anesthesia</skos:altLabel>
		<skos:altLabel xml:lang="en">Administration of anesthesia</skos:altLabel>
		<skos:altLabel xml:lang="en">GENERIC ANESTHESIA PROCEDURES</skos:altLabel>
		<skos:altLabel xml:lang="en">SECTION 1-C ANESTHESIA PROCEDURES</skos:altLabel>
		<skos:altLabel xml:lang="en">Generic anesthesia procedure</skos:altLabel>
		<skos:altLabel xml:lang="en">Anesthesia procedure</skos:altLabel>
		<skos:altLabel xml:lang="en">anesthesia for procedures</skos:altLabel>
		<skos:altLabel xml:lang="fr">anesthésies</skos:altLabel>
		<skos:altLabel xml:lang="fr">Procédure d'anesthésie</skos:altLabel>
		<skos:altLabel xml:lang="fr">intervention anesthésique</skos:altLabel>
		<skos:definition xml:lang="en">A state characterized by loss of feeling or sensation. This depression of nerve function is usually the result of pharmacologic action and is induced to allow performance of surgery or other painful procedures. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0150270"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2347661"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1444186"/>
		<OntoAD:has_active_ingredient rdf:resource="&OntoAD;C0002932"/>
	</owl:Class>

