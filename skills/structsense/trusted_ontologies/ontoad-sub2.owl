		<skos:altLabel xml:lang="fr">vitamine B12a</skos:altLabel>
		<skos:altLabel xml:lang="fr">vitamine B12b</skos:altLabel>
		<skos:altLabel xml:lang="fr">hydroxycobalamine</skos:altLabel>
		<skos:definition xml:lang="en">Injectable form of VITAMIN B 12 that has been used therapeutically to treat VITAMIN B 12 DEFICIENCY. (source : MSH)</skos:definition>
