		<skos:altLabel xml:lang="en">ASSESS SELF</skos:altLabel>
		<skos:altLabel xml:lang="fr">Auto-évaluation</skos:altLabel>
		<skos:definition xml:lang="en">Appraisal of one's own personal qualities or traits. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Évaluation de ses propres qualités ou traits personnels. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0036594"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0220825"/>
