	<owl:Class rdf:about="&OntoAD;C0028798">
		<skos:prefLabel xml:lang="en">Occupational Exposure</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">OccupationalExposure</skos:hiddenLabel>
