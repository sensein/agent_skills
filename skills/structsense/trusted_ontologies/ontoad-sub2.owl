		<skos:altLabel xml:lang="fr">Quatrième âge</skos:altLabel>
		<skos:definition xml:lang="en">A person 80 years of age and older. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0001792"/>
	</owl:Class>

