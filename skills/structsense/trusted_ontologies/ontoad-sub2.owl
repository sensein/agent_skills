		<skos:altLabel xml:lang="en">Autism, Early Infantile</skos:altLabel>
		<skos:altLabel xml:lang="en">Autism, Infantile</skos:altLabel>
		<skos:altLabel xml:lang="en">Childhood autism</skos:altLabel>
		<skos:altLabel xml:lang="en">Kanner's Syndrome</skos:altLabel>
		<skos:altLabel xml:lang="en">AUTISTIC</skos:altLabel>
		<skos:altLabel xml:lang="en">Autistic disorder of childhood onset</skos:altLabel>
		<skos:altLabel xml:lang="en">child autism</skos:altLabel>
		<skos:altLabel xml:lang="en">Infantile autism</skos:altLabel>
		<skos:altLabel xml:lang="en">Kanner</skos:altLabel>
		<skos:altLabel xml:lang="en">Autism (209850)</skos:altLabel>
		<skos:altLabel xml:lang="en">autistic disorder (infantile autism, full syndrome present)</skos:altLabel>
		<skos:altLabel xml:lang="en">autistic disorder infantile, full syndrome present</skos:altLabel>
		<skos:altLabel xml:lang="en">childhood autistic disorder</skos:altLabel>
		<skos:altLabel xml:lang="en">Autistic spectrum disorder (ASD)</skos:altLabel>
		<skos:altLabel xml:lang="fr">AUTISME INFANTILE</skos:altLabel>
		<skos:altLabel xml:lang="fr">Autisme</skos:altLabel>
		<skos:altLabel xml:lang="fr">Autisme de Kanner</skos:altLabel>
		<skos:altLabel xml:lang="fr">Autisme infantile précoce</skos:altLabel>
		<skos:altLabel xml:lang="fr">Syndrome de Kanner</skos:altLabel>
		<skos:altLabel xml:lang="fr">Autisme de la petite enfance</skos:altLabel>
		<skos:altLabel xml:lang="fr">trouble autistique commençant dans l'enfance</skos:altLabel>
		<skos:altLabel xml:lang="fr">autisme de l'enfant</skos:altLabel>
		<skos:altLabel xml:lang="fr">pensée autiste</skos:altLabel>
		<skos:altLabel xml:lang="fr">pensée autistique</skos:altLabel>
		<skos:definition xml:lang="en">A disorder beginning in childhood. It is marked by the presence of markedly abnormal or impaired development in social interaction and communication and a markedly restricted repertoire of activity and interest. Manifestations of the disorder vary greatly depending on the developmental level and chronological age of the individual. (DSM-IV) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1306597"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0524528"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:may_be_treated_by rdf:resource="&OntoAD;C0123091"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0036457">
		<skos:prefLabel xml:lang="en">Scrapie</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Scrapie</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Tremblante</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Tremblante</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Rida</skos:altLabel>
		<skos:altLabel xml:lang="fr">Scrapie</skos:altLabel>
		<skos:altLabel xml:lang="fr">Encéphalopathie spongiforme ovine</skos:altLabel>
		<skos:altLabel xml:lang="fr">tremblante du mouton</skos:altLabel>
		<skos:definition xml:lang="en">A fatal disease of the nervous system in sheep and goats, characterized by pruritus, debility, and locomotor incoordination. It is caused by proteinaceous infectious particles called PRIONS. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0276641"/>
