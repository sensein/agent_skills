	<owl:Class rdf:about="&OntoAD;C0242422">
		<skos:prefLabel xml:lang="en">Parkinsonian Disorders</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">ParkinsonianDisorders</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Syndromes parkinsoniens</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">SyndromesParkinsoniens</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">parkinsonism</skos:altLabel>
		<skos:altLabel xml:lang="en">Parkinsonian Syndrome</skos:altLabel>
		<skos:altLabel xml:lang="en">SYNDROME PARKINSONISM</skos:altLabel>
		<skos:altLabel xml:lang="en">Parkinsonian Diseases</skos:altLabel>
		<skos:altLabel xml:lang="en">PARKINSONIAN DIS</skos:altLabel>
		<skos:altLabel xml:lang="fr">syndrome parkinsonien</skos:altLabel>
		<skos:altLabel xml:lang="fr">PARKINSONISME</skos:altLabel>
		<skos:altLabel xml:lang="fr">Troubles parkinsoniens</skos:altLabel>
		<skos:definition xml:lang="en">A group of disorders which feature impaired motor control characterized by bradykinesia, MUSCLE RIGIDITY; TREMOR; and postural instability. Parkinsonian diseases are generally divided into primary parkinsonism (see PARKINSON DISEASE), secondary parkinsonism (see PARKINSON DISEASE, SECONDARY) and inherited forms. These conditions are associated with dysfunction of dopaminergic or closely related motor integration neuronal pathways in the BASAL GANGLIA. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0004782"/>
		<OntoAD:manifestation_of rdf:resource="&OntoAD;C0002395"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:manifestation_of rdf:resource="&OntoAD;C0338451"/>
		<OntoAD:manifestation_of rdf:resource="&OntoAD;C0038868"/>
		<OntoAD:manifestation_of rdf:resource="&OntoAD;C0752347"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0004781"/>
	</owl:Class>

