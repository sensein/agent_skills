	<owl:Class rdf:about="&OntoAD;C0019046">
		<skos:prefLabel xml:lang="en">Hemoglobin</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Hemoglobin</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Hémoglobines</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Hémoglobines</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Hb  Hemoglobin</skos:altLabel>
		<skos:altLabel xml:lang="en">HGB  Hemoglobin</skos:altLabel>
		<skos:altLabel xml:lang="en">D5-D6 HEMOGLOBINS</skos:altLabel>
		<skos:altLabel xml:lang="en">Hemoglobins</skos:altLabel>
		<skos:altLabel xml:lang="fr">hémoglobine</skos:altLabel>
		<skos:definition xml:lang="en">The oxygen-carrying proteins of ERYTHROCYTES. They are found in all vertebrates and some invertebrates. The number of globin subunits in the hemoglobin quaternary structure differs between species. Structures range from monomeric to a variety of multimeric arrangements. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0242210"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0018974"/>
		<OntoAD:gene_product_expressed_in_tissue rdf:resource="&OntoAD;C0014792"/>
	</owl:Class>

