		<skos:hiddenLabel xml:lang="en">PlasmaMembranePart</skos:hiddenLabel>
		<skos:definition xml:lang="en">Any constituent part of the plasma membrane, the membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins. [GOC:jl] (source : GO)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1513111"/>
		<OntoAD:part_of rdf:resource="&OntoAD;C0007603"/>
