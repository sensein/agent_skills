		<rdfs:subClassOf rdf:resource="&OntoAD;C2095770"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1268904"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0360167"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0020538"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0017601"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C1263846"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0040517"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0011991"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0037036"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0020517"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0010715">
		<skos:prefLabel xml:lang="en">Cytidine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Cytidine</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Cytidine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Cytidine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Cytosine Ribonucleoside</skos:altLabel>
		<skos:altLabel xml:lang="en">Cytosine Riboside</skos:altLabel>
		<skos:altLabel xml:lang="en">cytodine</skos:altLabel>
		<skos:definition xml:lang="en">A pyrimidine nucleoside that is composed of the base CYTOSINE linked to the five-carbon sugar D-RIBOSE. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0028621"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0033640">
		<skos:prefLabel xml:lang="en">PROTEIN KINASE</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">PROTEINKINASE</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Protein kinases</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ProteinKinases</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">ATP-protein phosphotransferase</skos:altLabel>
		<skos:altLabel xml:lang="en">Glycogen synthase a kinase</skos:altLabel>
		<skos:altLabel xml:lang="en">Phosphorylase b kinase kinase</skos:altLabel>
		<skos:altLabel xml:lang="en">Hydroxyalkyl-protein kinase</skos:altLabel>
		<skos:altLabel xml:lang="en">Protein Kinases</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine-kinase</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéine-kinases</skos:altLabel>
		<skos:altLabel xml:lang="fr">Protéines-kinases</skos:altLabel>
		<skos:altLabel xml:lang="fr">protéine kinase</skos:altLabel>
		<skos:altLabel xml:lang="fr">phosphorylase b kinase kinase</skos:altLabel>
		<skos:altLabel xml:lang="fr">glycogène synthase a kinase</skos:altLabel>
		<skos:altLabel xml:lang="fr">hydroxyalkyl-protéine kinase</skos:altLabel>
		<skos:altLabel xml:lang="fr">sérine(thréonine)protéine kinase</skos:altLabel>
		<skos:definition xml:lang="en">A family of enzymes that catalyze the conversion of ATP and a protein to ADP and a phosphoprotein. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0031727"/>
		<OntoAD:gene_product_has_biochemical_function rdf:resource="&OntoAD;C0014442"/>
		<OntoAD:is_biochemical_function_of_gene_product rdf:resource="&OntoAD;C0297981"/>
		<OntoAD:is_biochemical_function_of_gene_product rdf:resource="&OntoAD;C0752312"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1333402"/>
		<OntoAD:gene_product_encoded_by_gene rdf:resource="&OntoAD;C1336799"/>
	</owl:Class>

