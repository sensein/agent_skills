	<owl:Class rdf:about="&OntoAD;C0206717">
		<skos:prefLabel xml:lang="en">Olfactory Neuroblastoma</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">OlfactoryNeuroblastoma</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Esthésioneuroblastome olfactif</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">EsthésioneuroblastomeOlfactif</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Paranasal Sinus-Nasal Cavity Esthesioneuroblastoma</skos:altLabel>
		<skos:altLabel xml:lang="en">Asthesioneuroblastoma</skos:altLabel>
		<skos:altLabel xml:lang="en">Esthesioneuroepithelioma</skos:altLabel>
		<skos:altLabel xml:lang="en">Olfactory neuroepithelioma</skos:altLabel>
