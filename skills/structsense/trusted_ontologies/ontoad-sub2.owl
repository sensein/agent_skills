	<owl:Class rdf:about="&OntoAD;C0030512">
		<skos:prefLabel xml:lang="en">Parasympathomimetic Agents</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">ParasympathomimeticAgents</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Parasympathomimétiques</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Parasympathomimétiques</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Parasympathomimetics</skos:altLabel>
		<skos:altLabel xml:lang="en">Parasympathomimetic Drugs</skos:altLabel>
		<skos:altLabel xml:lang="en">Parasympathomimetic agent</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents parasympathomimétiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments parasympathomimétiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">agent parasympathomimétique</skos:altLabel>
		<skos:altLabel xml:lang="fr">agent cholinergique</skos:altLabel>
		<skos:definition xml:lang="en">Drugs that mimic the effects of parasympathetic nervous system activity. Included here are drugs that directly stimulate muscarinic receptors and drugs that potentiate cholinergic activity, usually by slowing the breakdown of acetylcholine (CHOLINESTERASE INHIBITORS). Drugs that stimulate both sympathetic and parasympathetic postganglionic neurons (GANGLIONIC STIMULANTS) are not included here. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2064865"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1720711"/>
	</owl:Class>

