		<skos:altLabel xml:lang="en">TNF</skos:altLabel>
		<skos:altLabel xml:lang="en">tumor necrosis factor</skos:altLabel>
		<skos:altLabel xml:lang="en">tnfa</skos:altLabel>
		<skos:altLabel xml:lang="en">Tumor Necrosis Factor Family Protein</skos:altLabel>
		<skos:altLabel xml:lang="en">TNF Receptor Ligands</skos:altLabel>
		<skos:altLabel xml:lang="en">TNF RECEPT LIGANDS</skos:altLabel>
		<skos:altLabel xml:lang="en">tumor necrosis factor (TNF)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Ligands des récepteurs du TNF</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteurs TNF</skos:altLabel>
		<skos:altLabel xml:lang="fr">Ligands des récepteurs au TNF</skos:altLabel>
		<skos:altLabel xml:lang="fr">Ligands des récepteurs TNF</skos:altLabel>
		<skos:altLabel xml:lang="fr">TNF (Tumor Necrosis Factor)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Facteurs nécrosants des tumeurs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Ligands-récepteurs TNF</skos:altLabel>
		<skos:definition xml:lang="en">A family of proteins that were originally identified by their ability to cause NECROSIS of NEOPLASMS. Their necrotic effect on cells is mediated through TUMOR NECROSIS FACTOR RECEPTORS which induce APOPTOSIS. (source : MSH)</skos:definition>
