	<owl:Class rdf:about="&OntoAD;C0003550">
		<skos:prefLabel xml:lang="en">Aphasia, Broca</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Aphasia,Broca</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Aphasie de Broca</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AphasieDeBroca</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">nonfluent aphasia</skos:altLabel>
		<skos:altLabel xml:lang="en">Aphasia, Motor</skos:altLabel>
		<skos:altLabel xml:lang="en">Aphasia syndrome, motor</skos:altLabel>
		<skos:altLabel xml:lang="en">Aphasia, Nonfluent</skos:altLabel>
		<skos:altLabel xml:lang="en">Verbal Aphasia Syndrome</skos:altLabel>
		<skos:altLabel xml:lang="en">Aphasia, Frontocortical</skos:altLabel>
		<skos:altLabel xml:lang="en">Dysphasia, Broca</skos:altLabel>
		<skos:altLabel xml:lang="en">Motor aphasia</skos:altLabel>
		<skos:altLabel xml:lang="en">Broca's dysphasia</skos:altLabel>
		<skos:altLabel xml:lang="fr">APHASIE MOTRICE</skos:altLabel>
		<skos:altLabel xml:lang="fr">Aphasie non-fluente</skos:altLabel>
		<skos:altLabel xml:lang="fr">Aphasie transcorticale motrice</skos:altLabel>
		<skos:altLabel xml:lang="fr">aphasie frontocorticale</skos:altLabel>
		<skos:definition xml:lang="en">An aphasia characterized by impairment of expressive language (speech, writing, signs) and relative preservation of receptive language abilities (i.e., comprehension). This condition is caused by lesions of the motor association cortex in the frontal lobe (Broca's area and adjacent cortical and white matter regions). The deficits range from almost complete muteness to a reduction in the fluency and rate of speech. CEREBROVASCULAR ACCIDENTS (in particular INFARCTION, MIDDLE CEREBRAL ARTERY) are a (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Aphasie caractérisée par l'altération du langage expressif (parler, écrire, signes) et la relative conservation des capacités de langage réceptif (i.e. compréhension). L'affection a pour cause des lésions du cortex moteur du lobe frontal (zone de Broca, régions corticales adjacentes et substance blanche). Les défauts vont d'un mutisme presque total à une diminution de l'aisance et du rythme de la parole. Les ACCIDENTS CEREBROVASCULAIRES (notamment l'INFARCTUS DE L'ARTERE CEREBRALE MOYENNE) sont  (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003537"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0917814"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0031437">
		<skos:prefLabel xml:lang="en">Phenotype</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Phenotype</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Phénotype</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Phénotype</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Phenotypic expression</skos:altLabel>
		<skos:altLabel xml:lang="en">Phenotype finding</skos:altLabel>
		<skos:altLabel xml:lang="fr">expression phénotypique</skos:altLabel>
		<skos:definition xml:lang="en">The outward appearance of the individual. It is the product of interactions between genes, and between the GENOTYPE and the environment. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Apparence visible d'un individu. C'est le reflet des intéractions entre les gènes et entre un génotype avec son environnement. (source : MSHFRE)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0017398"/>
		<OntoAD:interprets rdf:resource="&OntoAD;C0679560"/>
	</owl:Class>

