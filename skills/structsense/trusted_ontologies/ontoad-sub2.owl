		<skos:altLabel xml:lang="en">disease; nervous system</skos:altLabel>
		<skos:altLabel xml:lang="en">NERVOUS SYSTEM DIS</skos:altLabel>
		<skos:altLabel xml:lang="en">NEUROLOG DIS</skos:altLabel>
		<skos:altLabel xml:lang="en">NEUROLOGICAL DIS</skos:altLabel>
		<skos:altLabel xml:lang="en">Nerv</skos:altLabel>
