		<skos:altLabel xml:lang="en">ASCVD</skos:altLabel>
		<skos:altLabel xml:lang="en">Cardiovascular arteriosclerosis</skos:altLabel>
		<skos:altLabel xml:lang="en">Cardiovascular degeneration with arteriosclerosis</skos:altLabel>
		<skos:altLabel xml:lang="en">Cardiovascular disease with arteriosclerosis</skos:altLabel>
