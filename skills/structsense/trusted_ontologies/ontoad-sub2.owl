	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0023122">
		<skos:prefLabel xml:lang="en">Latin America</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">LatinAmerica</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Amérique latine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AmériqueLatine</skos:hiddenLabel>
		<skos:definition xml:lang="en">The geographic area of Latin America in general and when the specific country or countries are not indicated. It usually includes Central America, South America, Mexico, and the islands of the Caribbean. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;GeographicArea"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0003114">
		<skos:prefLabel xml:lang="en">Anomie</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Anomie</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Anomie (comportement social)</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Anomie(comportementSocial)</skos:hiddenLabel>
		<skos:altLabel xml:lang="fr">Anomie sociale</skos:altLabel>
		<skos:definition xml:lang="en">A state of social disorganization and demoralization in society which is largely the result of disharmony between cultural goals and the means for attaining them. This may be reflected in the behavior of the individual in many ways - non-conformity, social withdrawal, deviant behavior, etc. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0037397"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0085971">
		<skos:prefLabel xml:lang="en">Case management (procedure)</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CaseManagement(procedure)</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Prise en charge personnalisée du patient</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">PriseEnChargePersonnaliséeDuPatient</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Case management</skos:altLabel>
		<skos:altLabel xml:lang="en">client management</skos:altLabel>
		<skos:altLabel xml:lang="en">individual service coordination</skos:altLabel>
		<skos:altLabel xml:lang="en">case mgmt</skos:altLabel>
		<skos:altLabel xml:lang="fr">prise en charge thérapeutique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Gestion de cas</skos:altLabel>
		<skos:altLabel xml:lang="fr">Plan de soins coordonnés pour un patient</skos:altLabel>
		<skos:altLabel xml:lang="fr">Prise en charge des cas individuels</skos:altLabel>
		<skos:altLabel xml:lang="fr">Prise en charge d'un patient</skos:altLabel>
		<skos:definition xml:lang="en">A traditional term for all the activities which a physician or other health care professional normally performs to insure the coordination of the medical services required by a patient. It also, when used in connection with managed care, covers all the activities of evaluating the patient, planning treatment, referral, and follow-up so that care is continuous and comprehensive and payment for the care is obtained. (From Slee and Slee, Health Care Terms, 2nd ed) (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">sert à gérer au mieux le parcours médical d'un patient en fonction de ses caractéristiques personnelles et des contraintes financières. Il doit permettre d'assurer la continuité des soins et une bonne accessibilité, de diminuer les prestations de services fragmentées et la mauvaise utilisation des ressources. Principes d’évaluation des réseaux de santé Anaes 1999 (source : MSHFRE)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0557974"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0007667">
		<skos:prefLabel xml:lang="en">Centenarians</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Centenarians</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Centenaires</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Centenaires</skos:hiddenLabel>
