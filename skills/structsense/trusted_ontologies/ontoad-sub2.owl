	<owl:Class rdf:about="&OntoAD;C0034800">
		<skos:prefLabel xml:lang="en">Receptors, Cell Surface</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Receptors,CellSurface</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Récepteurs de surface cellulaire</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">RécepteursDeSurfaceCellulaire</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">RECEPT CELL SURFACE</skos:altLabel>
		<skos:definition xml:lang="en">Cell surface proteins that bind signalling molecules external to the cell with high affinity and convert this extracellular event into one or more intracellular signals that alter the behavior of the target cell (From Alberts, Molecular Biology of the Cell, 2nd ed, pp693-5). Cell surface receptors, unlike enzymes, do not chemically alter their ligands. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0597357"/>
		<OntoAD:gene_product_has_associated_anatomy rdf:resource="&OntoAD;C0007603"/>
