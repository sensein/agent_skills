		<skos:altLabel xml:lang="fr">prothèse de la hanche</skos:altLabel>
		<skos:definition xml:lang="en">Replacement for a hip joint. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1282214"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0027127">
		<skos:prefLabel xml:lang="en">Myotonia Congenita</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">MyotoniaCongenita</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Myotonie congénitale</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">MyotonieCongénitale</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Myotonia congenital</skos:altLabel>
		<skos:altLabel xml:lang="en">Myotonia, Generalized</skos:altLabel>
		<skos:altLabel xml:lang="en">MYOTONIA CONGEN</skos:altLabel>
		<skos:altLabel xml:lang="en">Batten Turner Congenital Myopathy</skos:altLabel>
		<skos:altLabel xml:lang="en">congenital myotonia</skos:altLabel>
		<skos:altLabel xml:lang="fr">Maladie de Thomsen</skos:altLabel>
		<skos:altLabel xml:lang="fr">Myotonie congénitale de Thomsen</skos:altLabel>
		<skos:definition xml:lang="en">Inherited myotonic disorders with early childhood onset MYOTONIA. Muscular hypertrophy is common and myotonia may impair ambulation and other movements. It is classified as Thomsen (autosomal dominant) or Becker (autosomal recessive) generalized myotonia mainly based on the inheritance pattern. Becker type is also clinically more severe. An autosomal dominant variant with milder symptoms and later onset is known as myotonia levior. Mutations in the voltage-dependent skeletal muscle chloride chan (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0027125"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0553604"/>
		<OntoAD:disease_has_associated_anatomic_site rdf:resource="&OntoAD;C1516798"/>
		<OntoAD:disease_has_normal_tissue_origin rdf:resource="&OntoAD;C0225317"/>
		<OntoAD:disease_excludes_primary_anatomic_site rdf:resource="&OntoAD;C0262950"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0206193">
		<skos:prefLabel xml:lang="en">Long-Term Survivors</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Long-TermSurvivors</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Survivants à long terme</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">SurvivantsÀLongTerme</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">LTS</skos:altLabel>
		<skos:definition xml:lang="en">person surviving past expected longevity for a particular disease. (source : CSP)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0206194"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1450054">
		<skos:prefLabel xml:lang="en">Artificial nanoparticles</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">ArtificialNanoparticles</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Nanoparticules</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Nanoparticules</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Nanoparticles</skos:altLabel>
		<skos:altLabel xml:lang="fr">Nano-particules</skos:altLabel>
		<skos:altLabel xml:lang="fr">Particules nanométriques</skos:altLabel>
		<skos:definition xml:lang="en">Nanometer-sized particles that are nanoscale in three dimensions. They include nanocrystaline materials; NANOCAPSULES; METAL NANOPARTICLES; DENDRIMERS, and QUANTUM DOTS. The uses of nanoparticles include DRUG DELIVERY SYSTEMS and cancer targeting and imaging. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;ManufacturedObject"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0036572">
		<skos:prefLabel xml:lang="en">Seizures</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Seizures</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Crises épileptiques</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">CrisesÉpileptiques</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Convulsion</skos:altLabel>
		<skos:altLabel xml:lang="en">Fit</skos:altLabel>
		<skos:altLabel xml:lang="en">Seizure</skos:altLabel>
		<skos:altLabel xml:lang="fr">Attaque</skos:altLabel>
		<skos:altLabel xml:lang="fr">Crises d'épilepsie</skos:altLabel>
		<skos:altLabel xml:lang="fr">Attaques</skos:altLabel>
		<skos:altLabel xml:lang="fr">crise (neurologique)</skos:altLabel>
		<skos:definition xml:lang="en">Clinical or subclinical disturbances of cortical function due to a sudden, abnormal, excessive, and disorganized discharge of brain cells. Clinical manifestations include abnormal motor, sensory and psychic phenomena. Recurrent seizures are usually referred to as EPILEPSY or 'seizure disorder.' (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0427086"/>
