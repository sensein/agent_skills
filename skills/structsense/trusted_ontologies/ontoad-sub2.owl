		<skos:altLabel xml:lang="en">Sensitivity</skos:altLabel>
		<skos:definition xml:lang="en">The ability to respond to physical stimuli or to register small physical amounts or differences. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;QualitativeConcept"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C2349185">
