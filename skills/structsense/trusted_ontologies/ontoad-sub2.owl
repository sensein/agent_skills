	<owl:Class rdf:about="&OntoAD;C0002622">
		<skos:prefLabel xml:lang="en">Amnesia</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Amnesia</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Amnésie</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Amnésie</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">memory loss</skos:altLabel>
		<skos:altLabel xml:lang="en">memory disorders</skos:altLabel>
		<skos:altLabel xml:lang="en">memory deficits</skos:altLabel>
		<skos:altLabel xml:lang="en">Loss of memory</skos:altLabel>
		<skos:altLabel xml:lang="en">Dysmnesia</skos:altLabel>
		<skos:altLabel xml:lang="en">Amnesia-Memory Loss</skos:altLabel>
		<skos:altLabel xml:lang="en">Memory gone</skos:altLabel>
		<skos:altLabel xml:lang="en">LOM  Loss of memory</skos:altLabel>
		<skos:altLabel xml:lang="en">Amnesia symptom</skos:altLabel>
		<skos:altLabel xml:lang="fr">Perte de mémoire</skos:altLabel>
		<skos:altLabel xml:lang="fr">troubles mnésiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">trouble de la mémoire</skos:altLabel>
		<skos:altLabel xml:lang="fr">trouble de la fixation mnémonique</skos:altLabel>
		<skos:altLabel xml:lang="fr">dysmnésie</skos:altLabel>
		<skos:altLabel xml:lang="fr">altération de la mémoire</skos:altLabel>
		<skos:definition xml:lang="en">Pathologic partial or complete loss of the ability to recall past experiences (AMNESIA, RETROGRADE) or to form new memories (AMNESIA, ANTEROGRADE). This condition may be of organic or psychologic origin. Organic forms of amnesia are usually associated with dysfunction of the DIENCEPHALON or HIPPOCAMPUS. (From Adams et al., Principles of Neurology, 6th ed, pp426-7) (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Perte pathologique partielle ou totale de la capacité de se souvenir des expériences passées (AMNESIE RETROGRADE), ou de former de nouveaux souvenirs (AMNESIE ANTEROGRADE). L'origine de la maladie est organique ou psychologique. Les formes organiques de l'amnésie sont généralement associées à une dysfonction du DIENCEPHALE ou de l'HIPPOCAMPE. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0009792"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0233794"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0237088"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0751295"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:interprets rdf:resource="&OntoAD;C0392335"/>
		<OntoAD:interprets rdf:resource="&OntoAD;C1285654"/>
		<OntoAD:induced_by rdf:resource="&OntoAD;C0036442"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0032285"/>
	</owl:Class>

