		<skos:hiddenLabel xml:lang="fr">Retraite</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Retired</skos:altLabel>
		<skos:altLabel xml:lang="en">RT  Retired</skos:altLabel>
		<skos:altLabel xml:lang="en">retiring from a job</skos:altLabel>
		<skos:altLabel xml:lang="en">Retired, life event</skos:altLabel>
		<skos:definition xml:lang="en">The state of being retired from one's position or occupation. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">L'état d'être mis à la retraite de sa position ou d'occupation. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0740697"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C3266814"/>
