		<skos:hiddenLabel xml:lang="en">MyastheniaGravis</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Myasthénie</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Myasthénie</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Erb-Goldflam disease</skos:altLabel>
		<skos:altLabel xml:lang="en">Erb-Goldflam syndrome</skos:altLabel>
		<skos:altLabel xml:lang="en">MG  Myasthenia gravis</skos:altLabel>
		<skos:altLabel xml:lang="en">Myasthenia gravis paralytica</skos:altLabel>
		<skos:altLabel xml:lang="en">Goldflam-Erb</skos:altLabel>
		<skos:altLabel xml:lang="fr">Myasthénie grave</skos:altLabel>
		<skos:altLabel xml:lang="fr">Myasthénie auto-immune</skos:altLabel>
		<skos:altLabel xml:lang="fr">Myasthénie autoimmune</skos:altLabel>
		<skos:altLabel xml:lang="fr">Myasthénie grave pseudo-paralytique</skos:altLabel>
		<skos:altLabel xml:lang="fr">paralysie bulbaire asthénique</skos:altLabel>
		<skos:altLabel xml:lang="fr">syndrome d'Erb-Goldflam</skos:altLabel>
		<skos:definition xml:lang="en">A disorder of neuromuscular transmission characterized by weakness of cranial and skeletal muscles. Autoantibodies directed against acetylcholine receptors damage the motor endplate portion of the NEUROMUSCULAR JUNCTION, impairing the transmission of impulses to skeletal muscles. Clinical manifestations may include diplopia, ptosis, and weakness of facial, bulbar, respiratory, and proximal limb muscles. The disease may remain limited to the ocular muscles. THYMOMA is commonly associated with thi (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0004364"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2102996"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1533847"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0026897"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1285168"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:has_manifestation rdf:resource="&OntoAD;C0013362"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0036442"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0004259"/>
		<OntoAD:has_manifestation rdf:resource="&OntoAD;C0011168"/>
		<OntoAD:due_to rdf:resource="&OntoAD;C0020517"/>
	</owl:Class>

