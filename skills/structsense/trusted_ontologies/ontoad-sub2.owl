	<owl:Class rdf:about="&OntoAD;C1337112">
		<skos:prefLabel xml:lang="en">INS gene</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">INSGene</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">PROINSULIN</skos:altLabel>
		<skos:altLabel xml:lang="en">INS</skos:altLabel>
		<skos:altLabel xml:lang="en">Insulin Gene</skos:altLabel>
		<skos:definition xml:lang="en">This gene plays a role in insulin and glucose regulation. (source : NCI)</skos:definition>
