		<skos:altLabel xml:lang="en">Adenylic Acid</skos:altLabel>
		<skos:altLabel xml:lang="en">AMP</skos:altLabel>
		<skos:altLabel xml:lang="en">Adenosine-5-monophosphate</skos:altLabel>
		<skos:altLabel xml:lang="en">Muscle adenylic acid</skos:altLabel>
		<skos:altLabel xml:lang="fr">Adénosine monophosphate</skos:altLabel>
		<skos:altLabel xml:lang="fr">phosphate d'adénosine</skos:altLabel>
		<skos:altLabel xml:lang="fr">adénosine-5-monophosphate</skos:altLabel>
		<skos:altLabel xml:lang="fr">acide adénylique</skos:altLabel>
		<skos:altLabel xml:lang="fr">adénosine-monophosphate</skos:altLabel>
		<skos:definition xml:lang="en">Adenylic acid. Adenine nucleotide containing one phosphate group esterified to the sugar moiety in the 2'-, 3'-, or 5'-position. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0035548"/>
