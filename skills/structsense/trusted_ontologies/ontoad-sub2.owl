	<owl:Class rdf:about="&OntoAD;C0001578">
		<skos:prefLabel xml:lang="en">Adolescence</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Adolescence</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Adolescence</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Adolescence</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Teen-age</skos:altLabel>
		<skos:altLabel xml:lang="en">youth</skos:altLabel>
		<skos:altLabel xml:lang="en">adolescence (12-20)</skos:altLabel>
		<skos:altLabel xml:lang="en">Adolescence, function</skos:altLabel>
		<skos:altLabel xml:lang="en">Adolescence period</skos:altLabel>
		<skos:altLabel xml:lang="en">teenage</skos:altLabel>
		<skos:altLabel xml:lang="fr">jeunesse</skos:altLabel>
		<skos:altLabel xml:lang="fr">adolescent</skos:altLabel>
		<skos:definition xml:lang="en">The period of life beginning with the appearance of secondary sex characteristics and terminating with the cessation of somatic growth. The years usually referred to as adolescence lie between 13 and 18 years of age. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0008059"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0001721">
		<skos:prefLabel xml:lang="en">Affect (mental function)</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Affect(mentalFunction)</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Affect</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Affect</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Affect</skos:altLabel>
		<skos:altLabel xml:lang="en">Affect, function</skos:altLabel>
		<skos:altLabel xml:lang="en">emotional affect</skos:altLabel>
		<skos:definition xml:lang="en">The feeling-tone accompaniment of an idea or mental representation. It is the most direct psychic derivative of instinct and the psychic representative of the various bodily changes by means of which instincts manifest themselves. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0013987"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0001737">
		<skos:prefLabel xml:lang="en">Africa</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Africa</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Afrique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Afrique</skos:hiddenLabel>
		<skos:definition xml:lang="en">second largest continent, after Asia, covering about one-fifth of the total land surface of the Earth; the continent is bounded on the west by the Atlantic Ocean, on the north by the Mediterranean Sea, on the east by the Red Sea and the Indian Ocean, and on the south by the mingling waters of the Atlantic and Indian oceans. (source : CSP)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0454690"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0016118">
		<skos:prefLabel xml:lang="en">Financial Support</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">FinancialSupport</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Soutien financier</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">SoutienFinancier</skos:hiddenLabel>
		<skos:altLabel xml:lang="fr">Aide financière</skos:altLabel>
		<skos:altLabel xml:lang="fr">Appui financier</skos:altLabel>
		<skos:definition xml:lang="en">The provision of monetary resources including money or capital and credit; obtaining or furnishing money or capital for a purchase or enterprise and the funds so obtained. (From Random House Unabridged Dictionary, 2d ed.) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;IdeaOrConcept"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0003211">
		<skos:prefLabel xml:lang="en">Anti-Inflammatory Agents, Non-Steroidal</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Anti-InflammatoryAgents,Non-Steroidal</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Anti-inflammatoires non stéroïdiens</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Anti-inflammatoiresNonStéroïdiens</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">NSAIDs</skos:altLabel>
		<skos:altLabel xml:lang="en">Non-steroid anti-inflam. drug</skos:altLabel>
		<skos:altLabel xml:lang="en">NSAID  Non-steroidal anti-inflammatory drug</skos:altLabel>
		<skos:altLabel xml:lang="en">Non-steroidal anti-inflammatory drug</skos:altLabel>
		<skos:altLabel xml:lang="en">Non-steroidal anti-inflammatory agent</skos:altLabel>
		<skos:altLabel xml:lang="en">Non-steroidal anti-inflammatory product</skos:altLabel>
		<skos:altLabel xml:lang="en">Anti Inflammatory Agents, Nonsteroidal</skos:altLabel>
		<skos:altLabel xml:lang="en">Antiinflammatory Agents, Non Steroidal</skos:altLabel>
		<skos:altLabel xml:lang="en">Antiinflammatory Agents, Nonsteroidal</skos:altLabel>
		<skos:altLabel xml:lang="en">Nonsteroidal Anti-inflammatory Drugs</skos:altLabel>
		<skos:altLabel xml:lang="en">Nonsteroidal Antiinflammatory Drug</skos:altLabel>
		<skos:altLabel xml:lang="en">ANTI INFLAMM AGENTS NONSTEROIDAL</skos:altLabel>
		<skos:altLabel xml:lang="en">NSAIA</skos:altLabel>
		<skos:altLabel xml:lang="en">ANTIINFLAMM AGENTS NON STEROIDAL</skos:altLabel>
		<skos:altLabel xml:lang="en">NON STEROIDAL ANTI INFLAMM AGENTS</skos:altLabel>
		<skos:altLabel xml:lang="en">AIANS</skos:altLabel>
		<skos:altLabel xml:lang="en">Non-steroidal Antiinflammatory Drug</skos:altLabel>
		<skos:altLabel xml:lang="en">Nonsteroidal Anti-inflammatory Drug</skos:altLabel>
		<skos:altLabel xml:lang="en">nonsteroidal anti-inflammatory drugs (NSAIDs)</skos:altLabel>
		<skos:altLabel xml:lang="fr">AINS</skos:altLabel>
		<skos:altLabel xml:lang="fr">Antiinflammatoires non stéroïdiens</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents antiinflammmatoires non stéroïdiens</skos:altLabel>
		<skos:altLabel xml:lang="fr">Agents anti-inflammatoires non stéroïdiens</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments antiinflammatoires non stéroïdiens</skos:altLabel>
		<skos:altLabel xml:lang="fr">agent anti-inflammatoire non stéroïdien</skos:altLabel>
		<skos:definition xml:lang="en">Anti-inflammatory agents that are not steroids. In addition to anti-inflammatory actions, they have analgesic, antipyretic, and platelet-inhibitory actions. They are used primarily in the treatment of chronic arthritic conditions and certain soft tissue disorders associated with pain and inflammation. They act by blocking the synthesis of prostaglandins by inhibiting cyclooxygenase, which converts arachidonic acid to cyclic endoperoxides, precursors of prostaglandins. Inhibition of prostaglandin (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003209"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0280004"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0017480">
		<skos:prefLabel xml:lang="en">Germany</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Germany</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Allemagne</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Allemagne</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">DEU</skos:altLabel>
		<skos:definition xml:lang="en">central European country bordering on the North and Baltic Seas, capital Berlin. (source : CSP)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0454664"/>
		<OntoAD:conceptual_part_of rdf:resource="&OntoAD;C0015176"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0002403">
		<skos:prefLabel xml:lang="en">Amantadine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Amantadine</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Amantadine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Amantadine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Adamantylamine</skos:altLabel>
		<skos:altLabel xml:lang="en">Tricyclo(3.3.1.13,7)decan-1-amine</skos:altLabel>
		<skos:altLabel xml:lang="en">Amatadine</skos:altLabel>
		<skos:definition xml:lang="en">An antiviral that is used in the prophylactic or symptomatic treatment of influenza A. It is also used as an antiparkinsonian agent, to treat extrapyramidal reactions, and for postherpetic neuralgia. The mechanisms of its effects in movement disorders are not well understood but probably reflect an increase in synthesis and release of dopamine, with perhaps some inhibition of dopamine uptake. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2985407"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0178601"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003451"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0242937"/>
		<OntoAD:may_treat rdf:resource="&OntoAD;C0030567"/>
		<OntoAD:contraindicated_drug rdf:resource="&OntoAD;C0013182"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0040421">
		<skos:prefLabel xml:lang="en">Palatine Tonsil</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">PalatineTonsil</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Tonsille palatine</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">TonsillePalatine</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Faucial tonsil</skos:altLabel>
		<skos:altLabel xml:lang="en">Tonsil</skos:altLabel>
		<skos:altLabel xml:lang="en">Tonsillar</skos:altLabel>
		<skos:altLabel xml:lang="en">Tonsilla palatina</skos:altLabel>
		<skos:altLabel xml:lang="en">Tonsillar structure</skos:altLabel>
		<skos:altLabel xml:lang="en">Tonsillar structure (palatine)</skos:altLabel>
		<skos:altLabel xml:lang="fr">amygdale</skos:altLabel>
		<skos:altLabel xml:lang="fr">Amygdale palatine</skos:altLabel>
		<skos:altLabel xml:lang="fr">amygdale, SAI</skos:altLabel>
		<skos:altLabel xml:lang="fr">amygdalo-</skos:altLabel>
		<skos:altLabel xml:lang="fr">amygdalien</skos:altLabel>
		<skos:definition xml:lang="en">A round-to-oval mass of lymphoid tissue embedded in the lateral wall of the PHARYNX. There is one on each side of the oropharynx in the fauces between the anterior and posterior pillars of the SOFT PALATE. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Une masse ronde à ovale de tissu lymphoïde incluse dans la paroi latérale du PHARYNX située de chaque côté des fosses, entre les piliers antérieurs et postérieurs du palais mou (PALAIS, MOU). (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0580788"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0836921"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0227156"/>
		<OntoAD:anatomic_structure_is_physical_part_of rdf:resource="&OntoAD;C0020962"/>
		<OntoAD:systemic_part_of rdf:resource="&OntoAD;C0031354"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0002871">
		<skos:prefLabel xml:lang="en">Anemia</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Anemia</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Anémie</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Anémie</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">anaemia</skos:altLabel>
		<skos:altLabel xml:lang="en">Anemiaified</skos:altLabel>
		<skos:altLabel xml:lang="en">essential anemia</skos:altLabel>
		<skos:altLabel xml:lang="fr">Anémie, sans précision</skos:altLabel>
		<skos:definition xml:lang="en">A reduction in the number of circulating erythrocytes or in the quantity of hemoglobin. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr"> Baisse du taux d'hémoglobine dans le sang, qui se traduit le plus souvent par une baisse du nombre des globules rouges. Le fer est indispensable à la synthèse de l'hémoglobine. Une carence en fer lors d'une grossesse, d'un régime végétarien, d'hémorragies abondantes ou répétées (règles) est une cause fréquente d'anémie. D'autres causes, plus rares, sont liées à des carences en vitamines du groupe B. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0018939"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0221016"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1518374"/>
