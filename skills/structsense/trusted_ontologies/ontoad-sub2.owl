	<owl:Class rdf:about="&OntoAD;C0002934">
		<skos:prefLabel xml:lang="en">Local Anesthetics</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">LocalAnesthetics</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Anesthésiques locaux</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AnesthésiquesLocaux</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Local anesthesia</skos:altLabel>
		<skos:altLabel xml:lang="en">Conduction-Blocking Anesthetics</skos:altLabel>
		<skos:altLabel xml:lang="en">Local anesthetic drugs</skos:altLabel>
		<skos:altLabel xml:lang="en">LA  Local anesthetic drug</skos:altLabel>
		<skos:altLabel xml:lang="en">Local anesthesia product</skos:altLabel>
		<skos:altLabel xml:lang="en">Local anesthetic</skos:altLabel>
		<skos:altLabel xml:lang="en">Local anaesthetic drugs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Anesthésique local</skos:altLabel>
		<skos:altLabel xml:lang="fr">Anesthésiques bloquant la conduction nerveuse</skos:altLabel>
		<skos:definition xml:lang="en">Drugs that block nerve conduction when applied locally to nerve tissue in appropriate concentrations. They act on any part of the nervous system and on every type of nerve fiber. In contact with a nerve trunk, these anesthetics can cause both sensory and motor paralysis in the innervated area. Their action is completely reversible. (From Gilman AG, et. al., Goodman and Gilman's The Pharmacological Basis of Therapeutics, 8th ed) Nearly all local anesthetics act by reducing the tendency of voltage (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0002932"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0360098">
		<skos:prefLabel xml:lang="en">Ester type local anesthetic</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">EsterTypeLocalAnesthetic</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Ester-type anesthetic</skos:altLabel>
		<skos:altLabel xml:lang="fr">anesthésique local du type ester</skos:altLabel>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0002934"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0007220">
		<skos:prefLabel xml:lang="en">Cardiovascular Agents</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CardiovascularAgents</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Agents cardiovasculaires</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AgentsCardiovasculaires</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Cardiovascular Drugs</skos:altLabel>
		<skos:altLabel xml:lang="en">CARDIOVASCULAR MEDICATIONS</skos:altLabel>
		<skos:altLabel xml:lang="en">Cardiovascular agent</skos:altLabel>
		<skos:altLabel xml:lang="en">Cardiovascular drug</skos:altLabel>
		<skos:altLabel xml:lang="en">cardio-vascular agents</skos:altLabel>
		<skos:altLabel xml:lang="en">CV agents</skos:altLabel>
		<skos:altLabel xml:lang="fr">Médicaments cardiovasculaires</skos:altLabel>
		<skos:altLabel xml:lang="fr">médicament cardiovasculaire</skos:altLabel>
