		<skos:hiddenLabel xml:lang="en">Australia</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Australie</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Australie</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">AUS</skos:altLabel>
		<skos:definition xml:lang="en">The smallest continent and an independent country, comprising six states and two territories. Its capital is Canberra. (source : MSH)</skos:definition>
