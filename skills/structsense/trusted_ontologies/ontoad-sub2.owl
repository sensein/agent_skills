		<skos:hiddenLabel xml:lang="en">MononuclearPhagocyte</skos:hiddenLabel>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2340284"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0342552">
		<skos:prefLabel xml:lang="en">Autoimmune endocrine disease</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AutoimmuneEndocrineDisease</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Affections auto-immunes endocriniennes</skos:prefLabel>
