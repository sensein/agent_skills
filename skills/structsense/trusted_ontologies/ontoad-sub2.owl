	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0021083">
		<skos:prefLabel xml:lang="en">Immunotherapy</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Immunotherapy</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Immunothérapie</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Immunothérapie</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Biological response modifier therapy</skos:altLabel>
		<skos:altLabel xml:lang="en">Immunological therapy</skos:altLabel>
		<skos:altLabel xml:lang="en">Immunological care</skos:altLabel>
		<skos:altLabel xml:lang="en">Immunologically Directed Therapy</skos:altLabel>
		<skos:altLabel xml:lang="en">IMMUNOTHER</skos:altLabel>
		<skos:altLabel xml:lang="fr">thérapie par modificateur de la réponse biologique</skos:altLabel>
		<skos:definition xml:lang="en">Manipulation of the host's immune system in treatment of disease. It includes both active and passive immunization as well as immunosuppressive therapy to prevent graft rejection. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0418981"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0005527"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0021201">
		<skos:prefLabel xml:lang="en">India</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">India</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Inde</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Inde</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">IND</skos:altLabel>
		<skos:definition xml:lang="en">western Asian republic comprising the major part of the Indian subcontinent; capital New Delhi. (source : CSP)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0454664"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0005893">
		<skos:prefLabel xml:lang="en">Body mass index procedure</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">BodyMassIndexProcedure</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Indice de masse corporelle</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">IndiceDeMasseCorporelle</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">body mass index</skos:altLabel>
		<skos:altLabel xml:lang="en">Quetelet Index</skos:altLabel>
		<skos:altLabel xml:lang="en">body mass index (BMI)</skos:altLabel>
		<skos:altLabel xml:lang="en">BMI</skos:altLabel>
		<skos:altLabel xml:lang="fr">index de masse corporelle</skos:altLabel>
		<skos:altLabel xml:lang="fr">masse corporelle</skos:altLabel>
		<skos:altLabel xml:lang="fr">Indice de Quetelet</skos:altLabel>
		<skos:altLabel xml:lang="fr">IMC (Indice de Masse Corporelle)</skos:altLabel>
		<skos:altLabel xml:lang="fr">Index de Quetelet</skos:altLabel>
		<skos:definition xml:lang="en">An indicator of body density as determined by the relationship of BODY WEIGHT to BODY HEIGHT. BMI=weight (kg)/height squared (m2). BMI correlates with body fat (ADIPOSE TISSUE). Their relationship varies with age and gender. For adults, BMI falls into these categories: below 18.5 (underweight); 18.5-24.9 (normal); 25.0-29.9 (overweight); 30.0 and above (obese). (National Center for Health Statistics, Centers for Disease Control and Prevention) (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Formule permettant d'évaluer l'obésité : Poids (kg) ÷ (Taille x Taille (m)). Par exemple, pour une personne pesant 82 kg et mesurant 1,60 m, l'indice de masse corporelle est égal à 82 ÷ (1,60 x 1,60) = 32. L'obésité est définie par un indice supérieur à 30. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;DiagnosticProcedure"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0022277">
		<skos:prefLabel xml:lang="en">Italy</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Italy</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Italie</skos:prefLabel>
