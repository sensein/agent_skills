		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0454578"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0242781">
		<skos:prefLabel xml:lang="en">disease transmission</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">DiseaseTransmission</skos:hiddenLabel>
