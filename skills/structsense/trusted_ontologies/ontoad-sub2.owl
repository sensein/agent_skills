	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0002783">
		<skos:prefLabel xml:lang="en">Epidemiologic Studies</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">EpidemiologicStudies</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Études épidémiologiques</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ÉtudesÉpidémiologiques</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">epidemiological studies</skos:altLabel>
		<skos:altLabel xml:lang="en">Epidemiologic Research</skos:altLabel>
		<skos:altLabel xml:lang="en">Epidemiology Research</skos:altLabel>
		<skos:altLabel xml:lang="en">EPIDEMIOL STUDIES</skos:altLabel>
		<skos:altLabel xml:lang="en">Epidemiologic Trial</skos:altLabel>
		<skos:altLabel xml:lang="fr">étude épidémiologique</skos:altLabel>
		<skos:definition xml:lang="en">Studies designed to examine associations, commonly, hypothesized causal relations. They are usually concerned with identifying or measuring the effects of risk factors or exposures. The common types of analytic study are CASE-CONTROL STUDIES; COHORT STUDIES; and CROSS-SECTIONAL STUDIES. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">études conçues pour examiner les associations, communément, ont émis une hypothèse des relations causales. Ils sont en général concernés avec le fait d'identifier ou le fait de mesurer les effets de facteurs de risque ou d'expositions. Les types communs d'étude analytique sont des ÉTUDES DE CONTRÔLE DE CAS; ÉTUDES DE COHORTE; et ÉTUDES TRANS-À ÉLÉMENTS. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0242481"/>
	</owl:Class>

