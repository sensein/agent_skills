		<skos:altLabel xml:lang="en">Unspecif vir infect/CNS</skos:altLabel>
		<skos:altLabel xml:lang="en">Infections, Viral CNS</skos:altLabel>
		<skos:altLabel xml:lang="en">virus; infection, central nervous system</skos:altLabel>
		<skos:altLabel xml:lang="en">CNS VIRAL INFECT</skos:altLabel>
		<skos:altLabel xml:lang="en">CNS VIRAL DIS</skos:altLabel>
		<skos:altLabel xml:lang="fr">Infections virales du système nerveux central</skos:altLabel>
		<skos:altLabel xml:lang="fr">Infection virale du système nerveux central</skos:altLabel>
		<skos:altLabel xml:lang="fr">Infections virales du SNC</skos:altLabel>
		<skos:altLabel xml:lang="fr">Maladies virales du SNC</skos:altLabel>
		<skos:altLabel xml:lang="fr">Viroses du SNC</skos:altLabel>
		<skos:altLabel xml:lang="fr">Viroses du système nerveux central</skos:altLabel>
		<skos:altLabel xml:lang="fr">Infection virale du système nerveux central, sans précision</skos:altLabel>
		<skos:definition xml:lang="en">Viral infections of the brain, spinal cord, meninges, or perimeningeal spaces. (source : MSH)</skos:definition>
