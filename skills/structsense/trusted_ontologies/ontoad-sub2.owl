		<skos:altLabel xml:lang="fr">Tissu membraneux</skos:altLabel>
		<skos:definition xml:lang="en">Thin layers of tissue which cover parts of the body, separate adjacent cavities, or connect adjacent structures. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">couches fines de tissu qui couvrent des parties du corps, séparez des cavités adjacentes, ou raccordez des structures adjacentes. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0040300"/>
	</owl:Class>

