		<skos:altLabel xml:lang="en">practitioners</skos:altLabel>
		<skos:definition xml:lang="en">A person engaged in the work of a profession or occupation. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0035173"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0034121">
