	<owl:Class rdf:about="&OntoAD;C0044602">
		<skos:prefLabel xml:lang="en">1-Phosphatidylinositol 3-Kinase</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">1-Phosphatidylinositol3-Kinase</skos:hiddenLabel>
