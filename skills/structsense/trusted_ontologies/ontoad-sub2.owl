		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:has_associated_morphology rdf:resource="&OntoAD;C0000768"/>
		<OntoAD:has_manifestation rdf:resource="&OntoAD;C0025362"/>
		<OntoAD:clinically_associated_with rdf:resource="&OntoAD;C0011991"/>
	</owl:Class>

