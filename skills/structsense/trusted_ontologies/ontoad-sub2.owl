	<owl:Class rdf:about="&OntoAD;C0039338">
		<skos:prefLabel xml:lang="en">Taste Disorders</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">TasteDisorders</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Troubles du goût</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">TroublesDuGoût</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Disorder of taste</skos:altLabel>
		<skos:altLabel xml:lang="en">TASTE DIS</skos:altLabel>
		<skos:altLabel xml:lang="fr">Troubles gustatifs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Troubles de la sensibilité aux saveurs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Dysgueusies</skos:altLabel>
		<skos:altLabel xml:lang="fr">Troubles de la gustation</skos:altLabel>
		<skos:definition xml:lang="en">Conditions characterized by an alteration in gustatory function or perception. Taste disorders are frequently associated with OLFACTION DISORDERS. Additional potential etiologies include METABOLIC DISEASES; DRUG TOXICITY; and taste pathway disorders (e.g., TASTE BUD diseases; FACIAL NERVE DISEASES; GLOSSOPHARYNGEAL NERVE DISEASES; and BRAIN STEM diseases). (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1285159"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
	</owl:Class>

