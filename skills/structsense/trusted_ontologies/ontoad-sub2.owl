		<rdfs:subClassOf rdf:resource="&OntoAD;BiologicallyActiveSubstance"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0699919">
		<skos:prefLabel xml:lang="en">Cathepsins B</skos:prefLabel>
