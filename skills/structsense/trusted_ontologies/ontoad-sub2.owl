	<owl:Class rdf:about="&OntoAD;C0037083">
		<skos:prefLabel xml:lang="en">Signal Transduction</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">SignalTransduction</skos:hiddenLabel>
