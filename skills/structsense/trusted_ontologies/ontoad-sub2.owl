	<owl:Class rdf:about="&OntoAD;C0206754">
		<skos:prefLabel xml:lang="en">Neuroendocrine Tumors</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">NeuroendocrineTumors</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Tumeurs neuroendocrines</skos:prefLabel>
