		<skos:altLabel xml:lang="en">Dyskenesic</skos:altLabel>
		<skos:altLabel xml:lang="en">Abnormal Movements</skos:altLabel>
		<skos:altLabel xml:lang="en">Dyskinesia #09</skos:altLabel>
		<skos:altLabel xml:lang="en">Dyskinesis</skos:altLabel>
		<skos:altLabel xml:lang="fr">mouvements anormaux</skos:altLabel>
		<skos:altLabel xml:lang="fr">DYSKINESIE</skos:altLabel>
		<skos:altLabel xml:lang="fr">SYNDROME DE DYSKINESIE</skos:altLabel>
		<skos:altLabel xml:lang="fr">Syndrome dyskinétique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Dyscinésies</skos:altLabel>
		<skos:altLabel xml:lang="fr">Mouvement anormal</skos:altLabel>
		<skos:altLabel xml:lang="fr">dyskinétique</skos:altLabel>
		<skos:definition xml:lang="en">Abnormal involuntary movements which primarily affect the extremities, trunk, or jaw that occur as a manifestation of an underlying disease process. Conditions which feature recurrent or persistent episodes of dyskinesia as a primary manifestation of disease may be referred to as dyskinesia syndromes (see MOVEMENT DISORDERS). Dyskinesias are also a relatively common manifestation of BASAL GANGLIA DISEASES. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr"> Trouble de la coordination des mouvements. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0549469"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0027763"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0242444">
		<skos:prefLabel xml:lang="en">Population at Risk</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">PopulationAtRisk</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Population à risque</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">PopulationÀRisque</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Risk Populations</skos:altLabel>
		<skos:altLabel xml:lang="fr">Population exposée</skos:altLabel>
		<skos:altLabel xml:lang="fr">Population à haut risque</skos:altLabel>
		<skos:definition xml:lang="en">Groups or individuals considered in danger of developing a physical, mental, emotional, behavioral, or other disorder due to adverse internal or external factors. (source : PSY)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1257890"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0007587">
		<skos:prefLabel xml:lang="en">Cell Death</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CellDeath</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Mort cellulaire</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">MortCellulaire</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">necrocytosis</skos:altLabel>
		<skos:altLabel xml:lang="en">Cell Death Process</skos:altLabel>
		<skos:altLabel xml:lang="fr">Mort de la cellule</skos:altLabel>
		<skos:definition xml:lang="en">The termination of the cell's ability to carry out vital functions such as metabolism, growth, reproduction, responsiveness, and adaptability. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">résiliation de la capacité de la cellule de réaliser les fonctions essentielles comme le métabolisme, la croissance, la reproduction, la sensibilité et l'adaptabilité. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0011065"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0007613"/>
		<OntoAD:biological_process_has_associated_location rdf:resource="&OntoAD;C0007634"/>
		<OntoAD:biological_process_involves_gene_product rdf:resource="&OntoAD;C0041368"/>
		<OntoAD:process_involves_gene rdf:resource="&OntoAD;C0812246"/>
		<OntoAD:biological_process_involves_gene_product rdf:resource="&OntoAD;C1456820"/>
		<OntoAD:biological_process_involves_gene_product rdf:resource="&OntoAD;C0385242"/>
		<OntoAD:process_involves_gene rdf:resource="&OntoAD;C1336646"/>
		<OntoAD:process_involves_gene rdf:resource="&OntoAD;C1705952"/>
		<OntoAD:process_involves_gene rdf:resource="&OntoAD;C1336836"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0037414">
		<skos:prefLabel xml:lang="en">Social Environment</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">SocialEnvironment</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Environnement social</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">EnvironnementSocial</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">socioenvironment</skos:altLabel>
		<skos:altLabel xml:lang="en">Social context</skos:altLabel>
		<skos:altLabel xml:lang="en">social climate</skos:altLabel>
		<skos:altLabel xml:lang="en">ENVIR SOCIAL</skos:altLabel>
		<skos:altLabel xml:lang="fr">Milieu social</skos:altLabel>
		<skos:altLabel xml:lang="fr">Contexte social</skos:altLabel>
		<skos:definition xml:lang="en">The aggregate of social and cultural institutions, forms, patterns, and processes that influence the life of an individual or community. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">L'ensemble d'institutions sociales et culturelles, formes, dessins et processus qui influencent la vie d'un individu ou d'une communauté. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;IdeaOrConcept"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0023715">
		<skos:prefLabel xml:lang="en">Limbic System</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">LimbicSystem</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Système limbique</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">SystèmeLimbique</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Limbic system structure</skos:altLabel>
		<skos:definition xml:lang="en">A set of forebrain structures common to all mammals that is defined functionally and anatomically. It is implicated in the higher integration of visceral, olfactory, and somatic information as well as homeostatic responses including fundamental survival behaviors (feeding, mating, emotion). For most authors, it includes the AMYGDALA; EPITHALAMUS; GYRUS CINGULI; hippocampal formation (see HIPPOCAMPUS); HYPOTHALAMUS; PARAHIPPOCAMPAL GYRUS; SEPTAL NUCLEI; anterior nuclear group of thalamus, and por (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">ensemble de structures de cerveau antérieur commun à tous les mammifères qui est défini fonctionnellement et anatomiquement. Il est impliqué dans la plus haute intégration de renseignements viscéraux, olfactifs et somatiques aussi bien que réponses ¤slhomeostatic¤sl en incluant des conduites de survivance fondamentales (l'alimentation, le fait d'accoupler, l'émotion). Pour la plupart des auteurs, il inclut l'¤slAMYGDALA¤sl ; EPITHALAMUS ; GYRUS ¤slCINGULI¤sl ; la formation de hippocampique (voir (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0459385"/>
		<OntoAD:has_regional_part rdf:resource="&OntoAD;C0019564"/>
		<OntoAD:has_regional_part rdf:resource="&OntoAD;C0018427"/>
		<OntoAD:part_of rdf:resource="&OntoAD;C1269537"/>
		<OntoAD:has_regional_part rdf:resource="&OntoAD;C2331062"/>
		<OntoAD:finding_site_of rdf:resource="&OntoAD;C0338430"/>
		<OntoAD:has_regional_part rdf:resource="&OntoAD;C0228249"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0001527">
		<skos:prefLabel xml:lang="en">Adipose tissue</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AdiposeTissue</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Tissu adipeux</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">TissuAdipeux</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Fatty Tissue</skos:altLabel>
		<skos:altLabel xml:lang="en">adipose fat body</skos:altLabel>
		<skos:altLabel xml:lang="en">Yellow fat</skos:altLabel>
		<skos:altLabel xml:lang="en">fat tissue</skos:altLabel>
		<skos:altLabel xml:lang="en">Textus adiposus albus</skos:altLabel>
		<skos:altLabel xml:lang="en">Unilocular adipose tissue</skos:altLabel>
		<skos:altLabel xml:lang="en">Adipocytus unigutturalis</skos:altLabel>
		<skos:altLabel xml:lang="en">yellow adipose tissue</skos:altLabel>
		<skos:altLabel xml:lang="en">Tiss fat</skos:altLabel>
		<skos:altLabel xml:lang="fr">Tissu graisseux</skos:altLabel>
		<skos:altLabel xml:lang="fr">graisse jaune</skos:altLabel>
		<skos:definition xml:lang="en">Specialized connective tissue composed of fat cells (ADIPOCYTES). It is the site of stored FATS, usually in the form of TRIGLYCERIDES. In mammals, there are two types of adipose tissue, the WHITE FAT and the BROWN FAT. Their relative distributions vary in different species with most adipose tissue being white. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0009780"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0225317"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0738366"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0007102">
