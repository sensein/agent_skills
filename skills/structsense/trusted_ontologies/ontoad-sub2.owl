		<skos:hiddenLabel xml:lang="en">LongtermFollow-up</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">long-term follow-up</skos:altLabel>
		<skos:definition xml:lang="en">Follow-up activities that continue beyond the active intervention period. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1522577"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0037397">
		<skos:prefLabel xml:lang="en">Social Behavior</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">SocialBehavior</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Comportement social</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ComportementSocial</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">social behaviour</skos:altLabel>
		<skos:definition xml:lang="en">Any behavior caused by or affecting another individual, usually of the same species. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">Tout comportement provoqué par ou affectant un autre individu, généralement de la même espèce. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1659446"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0562434"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1156530">
		<skos:prefLabel xml:lang="en">cholesterol metabolic process</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CholesterolMetabolicProcess</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">cholesterol metabolism</skos:altLabel>
		<skos:definition xml:lang="en">The chemical reactions and pathways involving cholesterol, cholest-5-en-3 beta-ol, the principal sterol of vertebrates and the precursor of many steroids, including bile acids and steroid hormones. It is a component of the plasma membrane lipid bilayer and of plasma lipoproteins and can be found in all animal tissues. [ISBN:0198506732 'Oxford Dictionary of Biochemistry and Molecular Biology'] (source : GO)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1156529"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0311277">
		<skos:prefLabel xml:lang="en">Obesity, Abdominal</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Obesity,Abdominal</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Obésité abdominale</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">ObésitéAbdominale</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">central obesity</skos:altLabel>
		<skos:altLabel xml:lang="en">TRUNK OBESITY</skos:altLabel>
		<skos:altLabel xml:lang="en">Truncal obesity</skos:altLabel>
		<skos:altLabel xml:lang="en">Android fat distribution</skos:altLabel>
		<skos:altLabel xml:lang="en">Fat body with thin limbs</skos:altLabel>
		<skos:altLabel xml:lang="en">Centripetal obesity</skos:altLabel>
		<skos:altLabel xml:lang="en">Obese face+trunk sparing limbs</skos:altLabel>
		<skos:altLabel xml:lang="en">Obesity of face and trunk, sparing limbs</skos:altLabel>
		<skos:altLabel xml:lang="en">centripetal obesity (truncal)</skos:altLabel>
		<skos:altLabel xml:lang="fr">obésité centrale</skos:altLabel>
		<skos:altLabel xml:lang="fr">Obésité du tronc</skos:altLabel>
		<skos:altLabel xml:lang="fr">Obésité viscérale</skos:altLabel>
		<skos:altLabel xml:lang="fr">Obésité androïde</skos:altLabel>
		<skos:altLabel xml:lang="fr">obésité faciotrunculaire</skos:altLabel>
		<skos:altLabel xml:lang="fr">obésité tronculaire</skos:altLabel>
		<skos:definition xml:lang="en">A condition of having excess fat in the abdomen. Abdominal obesity is typically defined as waist circumferences of 40 inches or more in men and 35 inches or more in women. Abdominal obesity raises the risk of developing disorders, such as diabetes, hypertension and METABOLIC SYNDROME X. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1532612"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2230143"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:clinically_similar rdf:resource="&OntoAD;C0028754"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1522133">
		<skos:prefLabel xml:lang="en">Hypercholesterolemia result</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">HypercholesterolemiaResult</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Cholestérol total augmenté</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">CholestérolTotalAugmenté</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">high cholesterol</skos:altLabel>
		<skos:altLabel xml:lang="en">Cholesterol total increased</skos:altLabel>
		<skos:altLabel xml:lang="en">Cholesterol levels raised</skos:altLabel>
		<skos:altLabel xml:lang="en">Hypercholesterolemia (elevated plasma cholesterol)</skos:altLabel>
		<skos:altLabel xml:lang="en">high cholesterol level</skos:altLabel>
		<skos:altLabel xml:lang="fr">taux de cholestérol élevés</skos:altLabel>
		<skos:altLabel xml:lang="fr">Cholestérol élevé</skos:altLabel>
		<skos:definition xml:lang="en">A finding based on laboratory test results that indicate higher than normal levels of cholesterol in a blood specimen. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1332129"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0037421">
		<skos:prefLabel xml:lang="en">Social isolation</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">SocialIsolation</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Isolement social</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">IsolementSocial</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">family; isolation</skos:altLabel>
		<skos:altLabel xml:lang="en">ISOL SOCIAL</skos:altLabel>
		<skos:altLabel xml:lang="en">rndx social isolation</skos:altLabel>
		<skos:definition xml:lang="en">The separation of individuals or groups resulting in the lack of or minimizing of social contact and/or communication. This separation may be accomplished by physical separation, by social barriers and by psychological mechanisms. In the latter, there may be interaction but no real communication. (source : MSH)</skos:definition>
		<skos:definition xml:lang="fr">séparation d'individus ou de groupes ce qui entraîne le manque d'ou minimisant du contact social et/ou la communication. Cette séparation peut être accomplie par la séparation physique, par les barrières sociales et par les mécanismes psychologiques. Dans le dernier, il peut y avoir l'action réciproque, mais aucune communication réelle. (source : CISMeF)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0740697"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2188220"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0184553"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:interprets rdf:resource="&OntoAD;C0037420"/>
	</owl:Class>

