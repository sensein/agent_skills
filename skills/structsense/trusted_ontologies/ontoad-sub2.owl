	<owl:Class rdf:about="&OntoAD;C0017494">
		<skos:prefLabel xml:lang="en">Gerstmann Syndrome</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">GerstmannSyndrome</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Syndrome de Gerstmann</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">SyndromeDeGerstmann</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Aphasia-angular gyrus syndrome</skos:altLabel>
		<skos:altLabel xml:lang="en">ANGULAR GYRUS SYNDROME</skos:altLabel>
		<skos:altLabel xml:lang="en">Finger-Agnosia-Left-Right-Confusion-Acalculia-Agraphia</skos:altLabel>
		<skos:altLabel xml:lang="en">Gerstmann</skos:altLabel>
		<skos:altLabel xml:lang="en">Syndrome de Gerstmann</skos:altLabel>
		<skos:altLabel xml:lang="en">Gerstmann-Badal Syndrome</skos:altLabel>
		<skos:altLabel xml:lang="fr">asomatognosie bilatérale</skos:altLabel>
		<skos:definition xml:lang="en">A disorder of cognition characterized by the tetrad of finger agnosia, dysgraphia, DYSCALCULIA, and right-left disorientation. The syndrome may be developmental or acquired. Acquired Gerstmann syndrome is associated with lesions in the dominant (usually left) PARIETAL LOBE which involve the angular gyrus or subjacent white matter. (From Adams et al., Principles of Neurology, 6th ed, p457) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1263847"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1446648"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
		<OntoAD:has_finding_site rdf:resource="&OntoAD;C0152305"/>
	</owl:Class>

