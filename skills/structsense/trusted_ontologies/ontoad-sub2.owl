		<skos:definition xml:lang="en">A group of CORTICOSTEROIDS that affect carbohydrate metabolism (GLUCONEOGENESIS, liver glycogen deposition, elevation of BLOOD SUGAR), inhibit ADRENOCORTICOTROPIC HORMONE secretion, and possess pronounced anti-inflammatory activity. They also play a role in fat and protein metabolism, maintenance of arterial blood pressure, alteration of the connective tissue response to injury, reduction in the number of circulating lymphocytes, and functioning of the central nervous system. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0001617"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0026160">
		<skos:prefLabel xml:lang="en">Mineralocorticoids</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Mineralocorticoids</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Minéralocorticoïdes</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Minéralocorticoïdes</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Mineralocorticoid hormone</skos:altLabel>
		<skos:altLabel xml:lang="en">Mineralocorticoid preparation</skos:altLabel>
		<skos:altLabel xml:lang="en">mineralocorticosteroids</skos:altLabel>
		<skos:altLabel xml:lang="fr">préparation minéralocorticoïde</skos:altLabel>
		<skos:altLabel xml:lang="fr">hormones minéralotropes</skos:altLabel>
		<skos:altLabel xml:lang="fr">minéralocorticostéroïdes</skos:altLabel>
		<skos:altLabel xml:lang="fr">hormones minéralocorticoïdes</skos:altLabel>
		<skos:definition xml:lang="en">A group of CORTICOSTEROIDS primarily associated with the water and electrolyte balance. This is accomplished through the effect on ION TRANSPORT in renal tubules, resulting in retention of sodium and loss of potassium. Mineralocorticoid secretion is itself regulated by PLASMA VOLUME, serum potassium, and ANGIOTENSIN II. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0001617"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0301818"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0301818">
		<skos:prefLabel xml:lang="en">Steroid hormone</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">SteroidHormone</skos:hiddenLabel>
		<skos:altLabel xml:lang="fr">hormone stéroïde</skos:altLabel>
		<skos:altLabel xml:lang="fr">stéroïde</skos:altLabel>
		<skos:definition xml:lang="en">hormone characterized by the presence of a cyclopentanoperhydrophenanthrene ring, includes the estrogens, androgens, mineralocorticoids, progestogens, and glucocorticoids. (source : CSP)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0019932"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0038317"/>
	</owl:Class>

