	<owl:Class rdf:about="&OntoAD;C0029219">
		<skos:prefLabel xml:lang="en">Organelles</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Organelles</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Organites</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Organites</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">cell organelle</skos:altLabel>
		<skos:altLabel xml:lang="en">Organelle structure</skos:altLabel>
		<skos:altLabel xml:lang="en">Organelle</skos:altLabel>
		<skos:altLabel xml:lang="fr">Organites cytoplasmiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Organelles</skos:altLabel>
		<skos:altLabel xml:lang="fr">Organites cellulaires</skos:altLabel>
		<skos:definition xml:lang="en">Specific particles of membrane-bound organized living substances present in eukaryotic cells, such as the MITOCHONDRIA; the GOLGI APPARATUS; ENDOPLASMIC RETICULUM; LYSOSOMES; PLASTIDS; and VACUOLES. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0729605"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0919437">
		<skos:prefLabel xml:lang="en">Cancer Promoting Genes</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CancerPromotingGenes</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Gènes de cancer</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">GènesDeCancer</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Cancer Genes</skos:altLabel>
		<skos:altLabel xml:lang="fr">Gène de cancer</skos:altLabel>
		<skos:definition xml:lang="en">Normal genes, that when altered or inappropriately expressed, contribute to malignant transformation, tumor progression, or metastasis. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0017337"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0919542">
		<skos:prefLabel xml:lang="en">Susceptibility/Resistance Gene</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Susceptibility/ResistanceGene</skos:hiddenLabel>
		<skos:definition xml:lang="en">Genes that make a person more or less resistant to a disease. These genes respond in special ways to certain extrinsic stimuli and thus tend to make the individual more than usually susceptible to certain diseases. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0919437"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0038205">
		<skos:prefLabel xml:lang="en">Statistical Distributions</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">StatisticalDistributions</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Lois statistiques</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">LoisStatistiques</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Statistics Distributions</skos:altLabel>
		<skos:altLabel xml:lang="en">STATIST DISTRIBUTIONS</skos:altLabel>
		<skos:altLabel xml:lang="fr">Distributions statistiques</skos:altLabel>
		<skos:altLabel xml:lang="fr">Répartitions statistiques</skos:altLabel>
		<skos:definition xml:lang="en">The complete summaries of the frequencies of the values or categories of a measurement made on a group of items, a population, or other collection of data. The distribution tells either how many or what proportion of the group was found to have each value (or each range of values) out of all the possible values that the quantitative measure can have. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1710191"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1707763">
