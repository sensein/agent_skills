	<owl:Class rdf:about="&OntoAD;C0007158">
		<skos:prefLabel xml:lang="en">Cardiac Glycosides</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">CardiacGlycosides</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Glucosides cardiotoniques</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">GlucosidesCardiotoniques</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Cardiotonic Steroids</skos:altLabel>
		<skos:altLabel xml:lang="en">Glycoside</skos:altLabel>
		<skos:altLabel xml:lang="en">Cardiac Glycoside</skos:altLabel>
		<skos:altLabel xml:lang="fr">Hétérosides cardiotoniques</skos:altLabel>
		<skos:altLabel xml:lang="fr">glucoside</skos:altLabel>
		<skos:altLabel xml:lang="fr">glucoside cardiaque</skos:altLabel>
		<skos:definition xml:lang="en">Cyclopentanophenanthrenes with a 5- or 6-membered lactone ring attached at the 17-position and SUGARS attached at the 3-position. Plants they come from have long been used in congestive heart failure. They increase the force of cardiac contraction without significantly affecting other parameters, but are very toxic at larger doses. Their mechanism of action usually involves inhibition of the NA(+)-K(+)-EXCHANGING ATPASE and they are often used in cell biological studies for that purpose. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0014432"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0003195"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0007004"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0007209"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1320237"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C0003195">
		<skos:prefLabel xml:lang="en">Anti-Arrhythmia Agents</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Anti-ArrhythmiaAgents</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Antiarythmiques</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">Antiarythmiques</skos:hiddenLabel>
