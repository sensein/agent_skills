	<owl:Class rdf:about="&OntoAD;C1510456">
		<skos:prefLabel xml:lang="en">Wernicke Aphasia</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">WernickeAphasia</skos:hiddenLabel>
		<skos:prefLabel xml:lang="fr">Aphasie de Wernicke</skos:prefLabel>
		<skos:hiddenLabel xml:lang="fr">AphasieDeWernicke</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Fluent Aphasia, Wernicke's</skos:altLabel>
		<skos:altLabel xml:lang="en">Wernicke's receptive aphasia</skos:altLabel>
		<skos:altLabel xml:lang="en">Temporoparietal aphasia</skos:altLabel>
		<skos:altLabel xml:lang="en">Dysphasia, Wernicke</skos:altLabel>
		<skos:altLabel xml:lang="en">Wernicke's dysphasia</skos:altLabel>
		<skos:altLabel xml:lang="en">Aphasia, Wernicke</skos:altLabel>
		<skos:altLabel xml:lang="fr">Aphasie fluente de type Wernicke</skos:altLabel>
		<skos:altLabel xml:lang="fr">aphasie fluente de Wernicke</skos:altLabel>
		<skos:altLabel xml:lang="fr">aphasie réceptive de Wernicke</skos:altLabel>
		<skos:altLabel xml:lang="fr">aphasie temporopariérale</skos:altLabel>
		<skos:definition xml:lang="en">Impairment in the comprehension of speech and meaning of words, both spoken and written, and of the meanings conveyed by their grammatical relationships in sentences. It is caused by lesions that primarily affect Wernicke's area, which lies in the posterior perisylvian region of the temporal lobe of the dominant hemisphere. (From Brain and Bannister, Clinical Neurology, 7th ed, p141; Kandel et al., Principles of Neural Science, 3d ed, p846) (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0454578"/>
		<OntoAD:has_severity rdf:resource="&OntoAD;C0439793"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1512173">
		<skos:prefLabel xml:lang="en">Effectiveness of Interventions</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">EffectivenessOfInterventions</skos:hiddenLabel>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1516634"/>
	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1521736">
		<skos:prefLabel xml:lang="en">Parkinson's Disease Pathway</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">Parkinson'sDiseasePathway</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Parkinson's Disease Pathway KEGG</skos:altLabel>
		<skos:definition xml:lang="en">Parkinson's disease (PD) is a progressive neurodegenerative movement disorder that results primarily from the death of dopaminergic neurons in the substantia nigra. Mutations in alpha-synuclein, UCHL1 (ubiquitin carboxy-terminal hydrolase L1), parkin, DJ1 (a parkin-associated protein involved with oxidative stress), and PINK1 (a putative serine threonine kinase) are known to cause early-onset PD. Mutations or altered expression of these proteins contributes to PD pathogenesis through common mech (source : )</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1522560"/>
		<OntoAD:has_gene_product_element rdf:resource="&OntoAD;C0021641"/>
		<OntoAD:has_gene_product_element rdf:resource="&OntoAD;C0285890"/>
		<OntoAD:has_gene_product_element rdf:resource="&OntoAD;C0291573"/>
	</owl:Class>

