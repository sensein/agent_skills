		<skos:hiddenLabel xml:lang="en">Non-SteroidalAromataseInhibitor</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Non-Steroidal Androstenedione Aromatase Inhibitor</skos:altLabel>
		<skos:altLabel xml:lang="en">Non-Steroidal Estrogen Synthase Inhibitor</skos:altLabel>
		<skos:altLabel xml:lang="en">Non-Steroidal Estrogen Synthetase Inhibitor</skos:altLabel>
		<skos:altLabel xml:lang="en">nonsteroidal aromatase inhibitor</skos:altLabel>
		<skos:definition xml:lang="en">A family of drugs that decrease the production of sex hormones (estrogen or testosterone) and slow the growth of tumors that need sex hormones to grow. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0593802"/>
	</owl:Class>

