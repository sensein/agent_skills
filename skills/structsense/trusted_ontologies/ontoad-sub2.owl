		<skos:altLabel xml:lang="fr">Vessie neurogène</skos:altLabel>
		<skos:altLabel xml:lang="fr">Vessie neurogène, non classée ailleurs</skos:altLabel>
		<skos:altLabel xml:lang="fr">Vessie neuropathique</skos:altLabel>
		<skos:altLabel xml:lang="fr">Vessie neurogénique</skos:altLabel>
		<skos:altLabel xml:lang="fr">dysfonction neurogène de la vessie</skos:altLabel>
		<skos:altLabel xml:lang="fr">dysfonctionnement neurologique de la vessie</skos:altLabel>
		<skos:altLabel xml:lang="fr">neurovessie</skos:altLabel>
		<skos:definition xml:lang="en">Dysfunction of the URINARY BLADDER due to disease of the central or peripheral nervous system pathways involved in the control of URINATION. This is often associated with SPINAL CORD DISEASES, but may also be caused by BRAIN DISEASES or PERIPHERAL NERVE DISEASES. (source : MSH)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0005686"/>
