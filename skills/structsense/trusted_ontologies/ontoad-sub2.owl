	</owl:Class>

	<owl:Class rdf:about="&OntoAD;C1515995">
		<skos:prefLabel xml:lang="en">Anti glaucoma agent</skos:prefLabel>
		<skos:hiddenLabel xml:lang="en">AntiGlaucomaAgent</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">antiglaucoma agents</skos:altLabel>
		<skos:altLabel xml:lang="en">ophthalmologicals antiglaucoma agents</skos:altLabel>
		<skos:definition xml:lang="en">Natural or synthetic Anti-glaucoma Agents relieve or prevent glaucoma, a condition characterized by increased intraocular pressure, excavation, and optic nerve damage. Such an agent may decrease ocular pressure and improve glaucoma as a beta-adrenergic blocker, a parasympathomimetic, an alpha-adrenergic agonist, a prostaglandin synthesis agonist, or by other mechanisms. (NCI04) (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C2697975"/>
		<rdfs:subClassOf rdf:resource="&OntoAD;C0973585"/>
	</owl:Class>

