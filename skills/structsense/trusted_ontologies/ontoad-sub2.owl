		<skos:hiddenLabel xml:lang="fr">Celecoxib</skos:hiddenLabel>
		<skos:altLabel xml:lang="en">Celecoxib product</skos:altLabel>
		<skos:definition xml:lang="en">A drug that reduces pain. Celecoxib belongs to the family of drugs called nonsteroidal anti-inflammatory agents. It is being studied in the prevention of cancer. (source : NCI)</skos:definition>
		<rdfs:subClassOf rdf:resource="&OntoAD;C1257954"/>
