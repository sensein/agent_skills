     xmlns:uo="http://purl.obolibrary.org/obo/uo/2012-08-30/uo.owl#"
     xmlns:BFO="http://www.ifomis.org/bfo/1.1#"
     xmlns:OPB="http://bhi.washington.edu/OPB#"
     xmlns:cbo="http://cbo.biocomplexity.indiana.edu/svn/cbo/trunk/CBO_1_0#"
