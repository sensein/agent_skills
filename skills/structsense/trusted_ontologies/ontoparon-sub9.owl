        <ontoparonnoy:UMLS_id>C0523807</ontoparonnoy:UMLS_id>
        <skos:altLabel xml:lang="fr">oxy</skos:altLabel>
        <skos:definition xml:lang="fr">détermination de la saturation en oxygène de l&apos;hémoglobine du sang par extrait d&apos;un prélèvement et mesure par oxymètre photo-électrique classique ou par des électrodes liées à une partie translucide du corps comme le doigt, le lobe de l&apos;oreille, ou les plis de la peau. (mesh)</skos:definition>
        <skos:prefLabel xml:lang="en">oximetry</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">oxymétrie</skos:prefLabel>
    </owl:Class>
    


