    <!-- http://www.limics.fr/ontologies/ontoparonsoc#SeLaver -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#SeLaver">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#EntretienPersonnel"/>
        <ontoparonnoy:NCIt_id rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10017846</ontoparonnoy:NCIt_id>
        <ontoparonnoy:UMLS_id>C2371453</ontoparonnoy:UMLS_id>
        <skos:altLabel xml:lang="en">Self Washing</skos:altLabel>
        <skos:definition xml:lang="fr">d510 Se laver
Laver et sécher son corps tout entier, ou des parties du corps, en utilisant de l&apos;eau et les produits ou les méthodes appropriées, comme prendre son bain, le prendre une douche, se laver les mains et les pieds, se laver le visage et les cheveux, et se sécher avec une serviette.
Inclusions: se laver des parties du corps; se laver le corps tout entier; se sécher
Exclusions: prendre soin de parties de son corps (d520); aller aux toilettes (d530)</skos:definition>
        <skos:prefLabel xml:lang="fr">se laver</skos:prefLabel>
        <skos:prefLabel xml:lang="en">washing oneself</skos:prefLabel>
    </owl:Class>
    


