    <!-- http://www.limics.fr/ontologies/ontoparonmed#Hemigoxine -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonmed#Hemigoxine">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonmed#Medicament"/>
        <skos:altLabel xml:lang="fr">digoxine</skos:altLabel>
        <skos:definition xml:lang="fr">Ce médicament aux propriétés multiples appartient à la famille des digitaliques : il agit sur le cœur en permettant essentiellement d&apos;en renforcer les contractions et de ralentir son rythme lorsqu&apos;il est excessif.

Il est utilisé dans le traitement de l&apos;insuffisance cardiaque et de certaines tachycardies.</skos:definition>
        <skos:prefLabel xml:lang="en">digoxin</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">hemigoxine</skos:prefLabel>
    </owl:Class>
    


