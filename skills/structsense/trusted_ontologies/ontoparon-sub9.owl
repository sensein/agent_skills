    </owl:Class>
    


    <!-- http://www.limics.fr/ontologies/ontoparonsoc#FauteuilConfort -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#FauteuilConfort">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#FauteuilRoulantPropulsionManuel"/>
        <rdfs:comment xml:lang="fr">fauteuil roulant manuel mais avec coussin spécifique de confort niverau de remboursement différent du FRM</rdfs:comment>
        <rdfs:comment xml:lang="en">trad manuelle car pas d&apos;équivalent anglais</rdfs:comment>
        <skos:altLabel xml:lang="fr">F R CONFORT</skos:altLabel>
        <skos:altLabel xml:lang="fr">FRM confort</skos:altLabel>
        <skos:altLabel xml:lang="en">comfort armchair</skos:altLabel>
