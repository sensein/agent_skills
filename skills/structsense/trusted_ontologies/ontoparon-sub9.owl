        <ontoparonnoy:UMLS_id>C0085537</ontoparonnoy:UMLS_id>
        <skos:altLabel xml:lang="fr">aidants familiaux</skos:altLabel>
        <skos:prefLabel xml:lang="fr">aidant familial</skos:prefLabel>
