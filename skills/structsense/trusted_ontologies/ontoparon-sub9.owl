                <owl:someValuesFrom rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#Patient"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="fr">pris de l&apos;ontologie des urgences</rdfs:comment>
        <skos:definition xml:lang="fr">Action de regarder minutieusement, d&apos;observer avec attention. Ensemble d&apos;observations faites par divers moyens (auscultation, palpation, radiographie, analyses etc...) qui fournissent des indications sur l&apos;état de santé d&apos;une personne.</skos:definition>
