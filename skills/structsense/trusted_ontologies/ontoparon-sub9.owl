    <!-- http://www.limics.fr/ontologies/ontoparonsoc#Tutelle -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#Tutelle">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#MesureJudiciaire"/>
        <rdfs:comment xml:lang="fr">définition grand dictionaire</rdfs:comment>
        <skos:altLabel xml:lang="fr">mettre sous tutelle</skos:altLabel>
        <skos:altLabel xml:lang="fr">mise sous tutelle</skos:altLabel>
        <skos:altLabel xml:lang="en">wardship</skos:altLabel>
        <skos:definition xml:lang="fr">La tutelle est une mesure judiciaire destinée à protéger une personne majeure et/ou tout ou partie de son patrimoine si elle n&apos;est plus en état de veiller sur ses propres intérêts. Un tuteur la représente dans les actes de la vie civile. Le juge peut énumérer, à tout moment, les actes que la personne peut faire seule ou non, au cas par cas (https://www.service-public.fr/particuliers/vosdroits/F2120)</skos:definition>
        <skos:prefLabel xml:lang="fr">tutelle</skos:prefLabel>
        <skos:prefLabel xml:lang="en">tutorship</skos:prefLabel>
    </owl:Class>
    


