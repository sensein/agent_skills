    <!-- http://www.limics.fr/ontologies/ontoparonsoc#HabitudesDeVie -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#HabitudesDeVie">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#Action"/>
        <ontoparonnoy:MeSH_id>D000203</ontoparonnoy:MeSH_id>
        <ontoparonnoy:UMLS_id>C0001288</ontoparonnoy:UMLS_id>
        <skos:altLabel xml:lang="fr">AVQ</skos:altLabel>
        <skos:altLabel xml:lang="fr">acte de la vie quotidienne</skos:altLabel>
        <skos:altLabel xml:lang="fr">actes quotidiens</skos:altLabel>
        <skos:altLabel xml:lang="fr">activité de la vie quotidienne</skos:altLabel>
        <skos:altLabel xml:lang="fr">activité de vie quotidienne</skos:altLabel>
        <skos:altLabel xml:lang="fr">activité journalière</skos:altLabel>
        <skos:altLabel xml:lang="fr">geste de la vie quotidienne</skos:altLabel>
        <skos:altLabel xml:lang="fr">geste quotidien</skos:altLabel>
        <skos:definition xml:lang="fr">Activité et participation
Dans l&apos;ICF les habitudes de vie peuvent être à mon sens reliées à activité et participation de la personne</skos:definition>
        <skos:definition xml:lang="fr">exécution des activités de base du soin de l&apos;individu, telles que s&apos;habiller, se déplacer, manger, etc.,en rééducation. [Traduction effectuée avant 2008] mesh</skos:definition>
        <skos:definition xml:lang="fr">une habitude de vie est une activité courante ou un rôle social valorisé par la personne ou son contexte socioculturel selon ses caractériqtiques (l&apos;âge, le sexe, l&apos;identité socioculturelle, etc..) Elle assure la survie et l&apos;épanouissement d&apos;une personne dans sa société tout au long de son existence.</skos:definition>
        <skos:prefLabel xml:lang="en">activities of daily living</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">habitudes de vie</skos:prefLabel>
    </owl:Class>
    


