        <skos:prefLabel xml:lang="fr">professionnel libéral non médical</skos:prefLabel>
        <skos:prefLabel xml:lang="ru">Частный специалист</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.limics.fr/ontologies/ontoparonsoc#ProfessionnelSocial -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#ProfessionnelSocial">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#AgentSocial"/>
