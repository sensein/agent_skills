    <!-- http://www.limics.fr/ontologies/ontoparonnoy#ApourNiveauDeQualite -->

    <owl:ObjectProperty rdf:about="http://www.limics.fr/ontologies/ontoparonnoy#ApourNiveauDeQualite">
        <rdfs:subPropertyOf rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#aPourModalite"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.limics.fr/ontologies/menelastop#ModaliteDeQualite"/>
        <rdfs:comment xml:lang="fr">permet de caractériser le niveau de qualité d&apos;un objet d&apos;n processus ou d&apos;un état</rdfs:comment>
        <skos:prefLabel xml:lang="en">a for quality level</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">a pour niveau de qualité</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.limics.fr/ontologies/ontoparonnoy#aPourAllocation -->

    <owl:ObjectProperty rdf:about="http://www.limics.fr/ontologies/ontoparonnoy#aPourAllocation">
        <rdfs:range rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#PrestationSociale"/>
        <rdfs:comment xml:lang="fr">utiliser pour identifier le type d&apos;allocation perçue</rdfs:comment>
        <skos:prefLabel xml:lang="fr">a pour allocation</skos:prefLabel>
        <skos:prefLabel xml:lang="en">has for allocation</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.limics.fr/ontologies/ontoparonnoy#aPourAttribut -->

    <owl:ObjectProperty rdf:about="http://www.limics.fr/ontologies/ontoparonnoy#aPourAttribut">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.limics.fr/ontologies/menelastop#Attribut"/>
        <skos:prefLabel xml:lang="fr">a pour attribut</skos:prefLabel>
        <skos:prefLabel xml:lang="en">has for attribute</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.limics.fr/ontologies/ontoparonnoy#aPourIntensite -->

    <owl:ObjectProperty rdf:about="http://www.limics.fr/ontologies/ontoparonnoy#aPourIntensite">
        <rdfs:subPropertyOf rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#aPourQualitatif"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.limics.fr/ontologies/menelastop#Intensite"/>
        <skos:prefLabel xml:lang="fr">a pour intensité</skos:prefLabel>
        <skos:prefLabel xml:lang="en">has for intensity</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.limics.fr/ontologies/ontoparonnoy#aPourLateralite -->

    <owl:ObjectProperty rdf:about="http://www.limics.fr/ontologies/ontoparonnoy#aPourLateralite">
        <rdfs:subPropertyOf rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#aPourAttribut"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <skos:definition xml:lang="fr">est utilisée pour spécifiée la latéralité d&apos;une personne ou bien la latéralité d&apos;un membre</skos:definition>
        <skos:prefLabel xml:lang="fr">a pour latéralité</skos:prefLabel>
        <skos:prefLabel xml:lang="en">has for laterality</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.limics.fr/ontologies/ontoparonnoy#aPourLieu -->

    <owl:ObjectProperty rdf:about="http://www.limics.fr/ontologies/ontoparonnoy#aPourLieu">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#ConceptLieu"/>
        <skos:prefLabel xml:lang="fr">a pour lieu</skos:prefLabel>
        <skos:prefLabel xml:lang="en">has for place</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.limics.fr/ontologies/ontoparonnoy#aPourModalite -->

    <owl:ObjectProperty rdf:about="http://www.limics.fr/ontologies/ontoparonnoy#aPourModalite">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.limics.fr/ontologies/menelastop#ModaliteThetique"/>
        <skos:prefLabel xml:lang="fr">a pour modalité</skos:prefLabel>
        <skos:prefLabel xml:lang="en">has for modality</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.limics.fr/ontologies/ontoparonnoy#aPourNiveauDeDependance -->

    <owl:ObjectProperty rdf:about="http://www.limics.fr/ontologies/ontoparonnoy#aPourNiveauDeDependance">
        <rdfs:subPropertyOf rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#aPourModalite"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.limics.fr/ontologies/menelastop#ModaliteDeDependance"/>
        <rdfs:comment xml:lang="fr">permet de connaitre le niveau gir de la personne</rdfs:comment>
        <skos:prefLabel xml:lang="fr">a pour niveau de dépendance</skos:prefLabel>
        <skos:prefLabel xml:lang="en">has for level of dependence</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.limics.fr/ontologies/ontoparonnoy#aPourNiveauDeGravite -->

    <owl:ObjectProperty rdf:about="http://www.limics.fr/ontologies/ontoparonnoy#aPourNiveauDeGravite">
        <rdfs:subPropertyOf rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#aPourModalite"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.limics.fr/ontologies/menelastop#ModaliteDeGravite"/>
        <rdfs:comment xml:lang="fr">permet d&apos;attribuer un niveau de gravité à un processus, un état ou tout autre</rdfs:comment>
        <skos:prefLabel xml:lang="en">a for severity level</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">a pour niveau de gravité</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.limics.fr/ontologies/ontoparonnoy#aPourNormalite -->

    <owl:ObjectProperty rdf:about="http://www.limics.fr/ontologies/ontoparonnoy#aPourNormalite">
        <rdfs:subPropertyOf rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#aPourQualitatif"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.limics.fr/ontologies/menelastop#Normalité"/>
        <skos:prefLabel xml:lang="fr">a pour normalité</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.limics.fr/ontologies/ontoparonnoy#aPourProjetDeVie -->

    <owl:ObjectProperty rdf:about="http://www.limics.fr/ontologies/ontoparonnoy#aPourProjetDeVie">
        <rdfs:domain rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#Agent"/>
        <rdfs:range rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#ProjetDeVie"/>
        <skos:prefLabel xml:lang="fr">a pour projet de vie</skos:prefLabel>
        <skos:prefLabel xml:lang="en">has for project of life</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.limics.fr/ontologies/ontoparonnoy#aPourQualitatif -->

    <owl:ObjectProperty rdf:about="http://www.limics.fr/ontologies/ontoparonnoy#aPourQualitatif">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#QualitatifObjetMetaFonctionnel"/>
        <skos:prefLabel xml:lang="fr">a pour qualitatif</skos:prefLabel>
        <skos:prefLabel xml:lang="en">has for qualitative</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.limics.fr/ontologies/ontoparonnoy#aPourSigne -->

    <owl:ObjectProperty rdf:about="http://www.limics.fr/ontologies/ontoparonnoy#aPourSigne">
        <owl:inverseOf rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#estSigneDe"/>
        <rdfs:domain rdf:resource="http://www.limics.fr/ontologies/ontoparonmed#Pathologie"/>
        <rdfs:range rdf:resource="http://www.limics.fr/ontologies/ontoparonmed#SigneEtSymptome"/>
        <skos:prefLabel xml:lang="fr">a pour signe</skos:prefLabel>
        <skos:prefLabel xml:lang="en">has for sign</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.limics.fr/ontologies/ontoparonnoy#aPourSituationProfessionnelle -->

    <owl:ObjectProperty rdf:about="http://www.limics.fr/ontologies/ontoparonnoy#aPourSituationProfessionnelle">
        <rdfs:subPropertyOf rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#aPourStaut"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.limics.fr/OntoPsychia_VieSociale#Situation_Professionnelle"/>
    </owl:ObjectProperty>
    


    <!-- http://www.limics.fr/ontologies/ontoparonnoy#aPourStatutCivil -->

    <owl:ObjectProperty rdf:about="http://www.limics.fr/ontologies/ontoparonnoy#aPourStatutCivil">
        <rdfs:subPropertyOf rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#aPourStaut"/>
        <rdfs:domain rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#Personne"/>
        <rdfs:range rdf:resource="http://www.limics.fr/OntoPsychia_VieSociale#Situation_Civile"/>
        <rdfs:comment xml:lang="fr">permet de définir le satut social de la personne</rdfs:comment>
        <skos:prefLabel xml:lang="fr">a pour statut social</skos:prefLabel>
        <skos:prefLabel xml:lang="en">has for civil status</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.limics.fr/ontologies/ontoparonnoy#aPourStaut -->

    <owl:ObjectProperty rdf:about="http://www.limics.fr/ontologies/ontoparonnoy#aPourStaut">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <skos:prefLabel xml:lang="fr">a pour statut</skos:prefLabel>
        <skos:prefLabel xml:lang="en">has for status</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.limics.fr/ontologies/ontoparonnoy#aPourTexture -->

    <owl:ObjectProperty rdf:about="http://www.limics.fr/ontologies/ontoparonnoy#aPourTexture">
        <rdfs:domain rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#Aliment"/>
        <rdfs:range rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#TextureAlimentation"/>
        <skos:prefLabel xml:lang="fr">a pour texture</skos:prefLabel>
        <skos:prefLabel xml:lang="en">has for texture</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.limics.fr/ontologies/ontoparonnoy#aPourThematique -->

    <owl:ObjectProperty rdf:about="http://www.limics.fr/ontologies/ontoparonnoy#aPourThematique">
        <rdfs:range rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#NotionThematique"/>
        <skos:prefLabel xml:lang="fr">a pour thématique</skos:prefLabel>
        <skos:prefLabel xml:lang="en">has a thematic</skos:prefLabel>
        <skos:prefLabel xml:lang="en">has thematic</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.limics.fr/ontologies/ontoparonnoy#aPourTypicalite -->

    <owl:ObjectProperty rdf:about="http://www.limics.fr/ontologies/ontoparonnoy#aPourTypicalite">
        <rdfs:subPropertyOf rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#aPourQualitatif"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.limics.fr/ontologies/menelastop#Typicalite"/>
        <skos:prefLabel xml:lang="fr">a pour typicalité</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.limics.fr/ontologies/ontoparonnoy#constitue -->

    <owl:ObjectProperty rdf:about="http://www.limics.fr/ontologies/ontoparonnoy#constitue">
        <owl:inverseOf rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#estConstituéDe"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="fr">lie deux classes qui permet de crée un tout ex les documet constitue un dossier</rdfs:comment>
        <skos:prefLabel xml:lang="fr">constitue</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.limics.fr/ontologies/ontoparonnoy#contains -->

    <owl:ObjectProperty rdf:about="http://www.limics.fr/ontologies/ontoparonnoy#contains">
        <rdfs:comment xml:lang="fr">utilisé pour onbasam</rdfs:comment>
        <skos:prefLabel xml:lang="en">contains</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.limics.fr/ontologies/ontoparonnoy#estConstituéDe -->

    <owl:ObjectProperty rdf:about="http://www.limics.fr/ontologies/ontoparonnoy#estConstituéDe">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <skos:prefLabel xml:lang="fr">est constitué de</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.limics.fr/ontologies/ontoparonnoy#estLeLieuExercice -->

    <owl:ObjectProperty rdf:about="http://www.limics.fr/ontologies/ontoparonnoy#estLeLieuExercice">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#exerceA"/>
        <skos:definition xml:lang="fr">pour indiquer le lieu où travaillent certains professionnels</skos:definition>
        <skos:prefLabel xml:lang="fr">est le lieu d&apos;exercice de</skos:prefLabel>
        <skos:prefLabel xml:lang="en">is the exercise place of</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.limics.fr/ontologies/ontoparonnoy#estPartieDe -->

    <owl:ObjectProperty rdf:about="http://www.limics.fr/ontologies/ontoparonnoy#estPartieDe">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <skos:prefLabel xml:lang="fr">est partie de</skos:prefLabel>
        <skos:prefLabel xml:lang="en">is part of</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.limics.fr/ontologies/ontoparonnoy#estRealisePar -->

    <owl:ObjectProperty rdf:about="http://www.limics.fr/ontologies/ontoparonnoy#estRealisePar">
        <owl:inverseOf rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#realise"/>
        <rdfs:domain rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#Action"/>
        <rdfs:range rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#Agent"/>
        <rdfs:comment xml:lang="en">une action est réalisé par un agent</rdfs:comment>
        <skos:prefLabel xml:lang="fr">est réalisé par</skos:prefLabel>
        <skos:prefLabel xml:lang="en">is realized by</skos:prefLabel>
