        <skos:altLabel xml:lang="fr">repli au domicile</skos:altLabel>
        <skos:altLabel xml:lang="fr">repli à domicile</skos:altLabel>
        <skos:prefLabel xml:lang="en">isolation at home</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">isolement au domicile</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.limics.fr/ontologies/ontoparonsoc#Isolement_Familial -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#Isolement_Familial">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#Isolement_Social"/>
        <skos:prefLabel xml:lang="en">family isolation</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">isolement familial</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.limics.fr/ontologies/ontoparonsoc#Isolement_Social -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#Isolement_Social">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#ConceptLieAuComportement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#aPourThematique"/>
                <owl:someValuesFrom rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#ThematiqueProblemeSocial"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ontoparonnoy:MeSH_id>D012934</ontoparonnoy:MeSH_id>
        <ontoparonnoy:NCIt_id>C21100</ontoparonnoy:NCIt_id>
        <ontoparonnoy:UMLS_id>C0037421</ontoparonnoy:UMLS_id>
        <skos:altLabel xml:lang="fr">isolement</skos:altLabel>
        <skos:altLabel xml:lang="fr">repli social</skos:altLabel>
        <skos:definition xml:lang="en">The separation of individuals or groups resulting in the lack of or minimizing of social contact and/or communication. This separation may be accomplished by physical separation, by social barriers and by psychological mechanisms. In the latter, there may be interaction but no real communication (définition descripteur MeSH)</skos:definition>
        <skos:prefLabel xml:lang="fr">isolement social</skos:prefLabel>
        <skos:prefLabel xml:lang="en">social isolation</skos:prefLabel>
    </owl:Class>
    


