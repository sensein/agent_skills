    </owl:Class>
    


    <!-- http://www.limics.fr/ontologies/ontoparonmed#EchoDoppler -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonmed#EchoDoppler">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonmed#Echographie"/>
        <ontoparonnoy:UMLS_id>C0162481</ontoparonnoy:UMLS_id>
        <skos:altLabel xml:lang="fr">doppler</skos:altLabel>
        <skos:altLabel xml:lang="fr">echo-doppler</skos:altLabel>
        <skos:altLabel xml:lang="fr">échodoppler</skos:altLabel>
        <skos:definition xml:lang="fr">Examen proche de l&apos;échographie permettant d&apos;étudier les flux sanguins dans le cur et les vaisseaux. À l&apos;aide d&apos;ultrasons, le doppler enregistre la vitesse et la direction du sang. On l&apos;utilise pour rechercher des anomalies du flux sanguin : par exemple des plaques d&apos;athérome dans les carotides ou dans les artères des jambes, un défaut des valvules du cur, etc. Cet examen est indolore. vidal</skos:definition>
        <skos:prefLabel xml:lang="en">ultrasonography, doppler</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">échographie-doppler</skos:prefLabel>
    </owl:Class>
    


