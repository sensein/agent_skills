        <skos:altLabel xml:lang="fr">distributeur de matériel médical</skos:altLabel>
        <skos:altLabel xml:lang="fr">prestataire matériel</skos:altLabel>
        <skos:altLabel xml:lang="fr">revendeur</skos:altLabel>
        <skos:prefLabel xml:lang="en">Supplier</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">prestataire matériel médical</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.limics.fr/ontologies/ontoparonsoc#PrestationDeCompensationDuHandicap -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#PrestationDeCompensationDuHandicap">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#Allocation"/>
        <rdfs:comment xml:lang="fr">La prestation de compensation du handicap (PCH) est une aide financière versée par le département. Elle est destinée à rembourser les dépenses liées à votre perte d&apos;autonomie. Son attribution dépend de votre degré d&apos;autonomie, de votre âge, de vos ressources et de votre résidence.
https://www.service-public.fr/particuliers/vosdroits/F14202</rdfs:comment>
        <rdfs:comment xml:lang="fr">dispositif de loi du 11 février 2005 ArticleL.114-1-1, délivré par la MDPH</rdfs:comment>
        <rdfs:comment xml:lang="en">trad manuelle car pas d&apos;équivalent anglais</rdfs:comment>
        <skos:altLabel xml:lang="fr">PCH</skos:altLabel>
        <skos:altLabel xml:lang="fr">PCH aide humaine</skos:altLabel>
        <skos:altLabel xml:lang="fr">pch</skos:altLabel>
        <skos:prefLabel xml:lang="en">handicap compensation benefit</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">prestation de compensation du handicap</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.limics.fr/ontologies/ontoparonsoc#PrestationSociale -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#PrestationSociale">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#ConceptLieAuFinancement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#aPourThematique"/>
                <owl:someValuesFrom rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#ThematiqueSociale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ontoparonnoy:UMLS_id>C0034017</ontoparonnoy:UMLS_id>
        <ontoparonnoy:UMLS_id>C0557717</ontoparonnoy:UMLS_id>
        <rdfs:isDefinedBy xml:lang="fr">Les prestations sociales (ou transfert sociaux) sont des transferts versés (en espèce ou en nature) à des individus ou à des familles afin de réduire la charge fnanciére que représente la protection contre divers risques. 
Elles sont associées à six grandes catégories de risques :
-La veillesse et la survie (pension de retraite, pensions de réversion, prise en charge de la dépendance).
- La santé (prise en charge totale ou partielle des frais liées à la maladie, à l&apos;invalidité, aux accidents du travail at aux maladies professionnelles).
- La maternité-famille
-La perte d&apos;emploi
-Les difficultés de logement
-La pauvreté et l&apos;exclusion sociale
(définition INSEE)</rdfs:isDefinedBy>
        <skos:altLabel xml:lang="fr">aide financière</skos:altLabel>
        <skos:altLabel xml:lang="fr">aide publique</skos:altLabel>
        <skos:altLabel xml:lang="fr">aide sociale</skos:altLabel>
        <skos:altLabel xml:lang="en">public assistance</skos:altLabel>
        <skos:prefLabel xml:lang="fr">prestation sociale</skos:prefLabel>
        <skos:prefLabel xml:lang="en">social security benefits</skos:prefLabel>
    </owl:Class>
    


