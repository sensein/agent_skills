        <skos:altLabel xml:lang="fr">aide pour la toilette</skos:altLabel>
        <skos:altLabel xml:lang="fr">aide toilette</skos:altLabel>
        <skos:altLabel xml:lang="fr">aide à la douche</skos:altLabel>
        <skos:altLabel xml:lang="fr">aider pour la toilette</skos:altLabel>
        <skos:altLabel xml:lang="fr">aider à la douche</skos:altLabel>
        <skos:altLabel xml:lang="fr">aider à la toilette</skos:altLabel>
        <skos:prefLabel xml:lang="fr">aide à la toilette</skos:prefLabel>
        <skos:prefLabel xml:lang="en">grooming assistance</skos:prefLabel>
    </owl:Class>
    


