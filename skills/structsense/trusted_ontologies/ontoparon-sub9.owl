        <skos:prefLabel xml:lang="en">soft food</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.limics.fr/ontologies/ontoparonsoc#Alimentation -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#Alimentation">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#Aliment"/>
        <ontoparonnoy:UMLS_id>C3853577</ontoparonnoy:UMLS_id>
        <rdfs:comment xml:lang="fr">l&apos;alimentation est n processus il revient fréquement dans le corpus pour désigne le type alimentation orale parentérale...
Mais aussi le fait de s&apos;alimenter : qui serait proche des avq repas à revoir</rdfs:comment>
        <skos:altLabel xml:lang="fr">prise alimentaire</skos:altLabel>
        <skos:prefLabel xml:lang="fr">alimentation</skos:prefLabel>
        <skos:prefLabel xml:lang="en">feed</skos:prefLabel>
