        <skos:altLabel xml:lang="fr">aide H</skos:altLabel>
        <skos:altLabel xml:lang="fr">aide d&apos;une tierce personne</skos:altLabel>
        <skos:altLabel xml:lang="fr">aider d&apos;une tierce personne</skos:altLabel>
        <skos:prefLabel xml:lang="fr">aide humaine</skos:prefLabel>
        <skos:prefLabel xml:lang="en">human support</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.limics.fr/ontologies/ontoparonsoc#AideHumaineSpecifiee -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#AideHumaineSpecifiee">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#Etat"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#aPourThematique"/>
                <owl:someValuesFrom rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#ThematiqueAideHumaine"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#aPourThematique"/>
                <owl:someValuesFrom rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#ThematiqueSociale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="fr">concerne l&apos;ensemble du niveau de gradation de l&apos;aide qui est apportée à la personne, en géneral dans le corpus cela fait réference à l&apos;apport en aide humaine</rdfs:comment>
        <rdfs:comment xml:lang="en">traduction manuelle car pas d&apos;équivalent anglais</rdfs:comment>
        <skos:prefLabel xml:lang="fr">aide spécifiée</skos:prefLabel>
        <skos:prefLabel xml:lang="en">specified assistance</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.limics.fr/ontologies/ontoparonsoc#AideImportante -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#AideImportante">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#AidePermanente"/>
        <skos:altLabel xml:lang="fr">aide ++</skos:altLabel>
        <skos:altLabel xml:lang="fr">aide +++</skos:altLabel>
        <skos:prefLabel xml:lang="fr">aide importante</skos:prefLabel>
        <skos:prefLabel xml:lang="en">important help</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.limics.fr/ontologies/ontoparonsoc#AideMedicaleDEtat -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#AideMedicaleDEtat">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#PrestationSociale"/>
        <skos:altLabel xml:lang="fr">AME</skos:altLabel>
        <skos:definition xml:lang="fr">L&apos;aide médicale de l&apos;État (AME) est un dispositif permettant aux étrangers en situation irrégulière de bénéficier d&apos;un accès aux soins. Elle est attribuée sous conditions de résidence stable et de ressources. Pour la demander, un dossier est à constituer (formulaires et justificatifs). Une fois attribuée, l&apos;AME est accordée pour 1 an. Le renouvellement doit être demandé chaque année. (cf gouv.fr)</skos:definition>
        <skos:prefLabel xml:lang="fr">aide médicale d&apos;état</skos:prefLabel>
        <skos:prefLabel xml:lang="en">state medical help</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.limics.fr/ontologies/ontoparonsoc#AideMedicoSociale -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#AideMedicoSociale">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#Action"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#aPourThematique"/>
                <owl:someValuesFrom rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#ThematiqueAideHumaine"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#aPourThematique"/>
                <owl:someValuesFrom rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#ThematiqueSociale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:prefLabel xml:lang="en">Social assisstance</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">aide médico-sociale</skos:prefLabel>
        <skos:prefLabel xml:lang="ru">Социальная помощь</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.limics.fr/ontologies/ontoparonsoc#AideMenagere -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#AideMenagere">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#PrestataireDeService"/>
        <skos:altLabel xml:lang="fr">aide-ménagère</skos:altLabel>
        <skos:definition xml:lang="fr">Vous pouvez bénéficier d&apos;une aide ménagère si vous avez des difficultés à faire certains gestes du quotidien et que vous remplissez des conditions d&apos;âge et de ressources. Cette aide financière sert à rémunérer une aide à domicile, c&apos;est-à-dire la personne qui effectue pour vous certaines tâches (aide à la toilette, ménage, ...). Elle peut être accordée par votre département ou, à défaut, par votre caisse de retraite..
La nature des tâches prises en charge dépend de vos besoins. Il s&apos;agit de services ménagers effectués par un service d&apos;aide autorisé, comme par exemple :
le ménage de votre logement,
l&apos;entretien du linge,
une aide pour effectuer votre toilette,
la préparation des repas sur place. (service public .fr)</skos:definition>
        <skos:prefLabel xml:lang="fr">aide ménagère</skos:prefLabel>
        <skos:prefLabel xml:lang="en">domestic home help</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.limics.fr/ontologies/ontoparonsoc#AideMinimale -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#AideMinimale">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#AidePartielle"/>
        <skos:altLabel xml:lang="fr">aide minime</skos:altLabel>
        <skos:prefLabel xml:lang="fr">aide minimale</skos:prefLabel>
        <skos:prefLabel xml:lang="en">minimal help</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.limics.fr/ontologies/ontoparonsoc#AideNocturne -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#AideNocturne">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#AideHumaineSpecifiee"/>
        <skos:prefLabel xml:lang="fr">aide nocturne</skos:prefLabel>
        <skos:prefLabel xml:lang="en">night help</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.limics.fr/ontologies/ontoparonsoc#AidePartielle -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#AidePartielle">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#AideHumaineSpecifiee"/>
        <skos:prefLabel xml:lang="fr">aide partielle</skos:prefLabel>
        <skos:prefLabel xml:lang="en">partial help</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.limics.fr/ontologies/ontoparonsoc#AidePermanente -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#AidePermanente">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#AideHumaineSpecifiee"/>
        <skos:prefLabel xml:lang="fr">aide permanente</skos:prefLabel>
        <skos:prefLabel xml:lang="en">permanente help</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.limics.fr/ontologies/ontoparonsoc#AidePonctuelle -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#AidePonctuelle">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#AidePartielle"/>
        <skos:prefLabel xml:lang="fr">aide ponctuelle</skos:prefLabel>
        <skos:prefLabel xml:lang="en">punctual help</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.limics.fr/ontologies/ontoparonsoc#AidePreparationRepas -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#AidePreparationRepas">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#AideAuRepas"/>
        <rdfs:comment xml:lang="en">traduction manuelle car pas d&apos;équivalent anglais</rdfs:comment>
        <skos:altLabel xml:lang="fr">aide pour la préparation</skos:altLabel>
        <skos:altLabel xml:lang="fr">aider pour la préparation</skos:altLabel>
        <skos:altLabel xml:lang="fr">aider à la préparation</skos:altLabel>
        <skos:altLabel xml:lang="fr">préparation de repas</skos:altLabel>
        <skos:prefLabel xml:lang="fr">aide à la préparation des repas</skos:prefLabel>
        <skos:prefLabel xml:lang="en">assistance in meal preparation</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.limics.fr/ontologies/ontoparonsoc#AideProfessionnelle -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#AideProfessionnelle">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#AideHumaine"/>
        <rdfs:comment xml:lang="en">traduction manuelle car pas d&apos;équivalent anglais</rdfs:comment>
        <skos:prefLabel xml:lang="fr">aide professionnelle</skos:prefLabel>
        <skos:prefLabel xml:lang="en">professionnal assistance</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.limics.fr/ontologies/ontoparonsoc#AideQuotidienne -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#AideQuotidienne">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#AidePermanente"/>
        <skos:prefLabel xml:lang="fr">aide quotidienne</skos:prefLabel>
        <skos:prefLabel xml:lang="en">daily help</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.limics.fr/ontologies/ontoparonsoc#AideSocialeAHebergement -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#AideSocialeAHebergement">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#PrestationSociale"/>
        <rdfs:comment xml:lang="fr">Pour percevoir l&apos;ASH, il faut remplir toutes les conditions suivantes :

Avoir plus de 65 ans (ou plus de 60 ans si l&apos;on est reconnu inapte au travail)
Vivre en France de façon stable et régulière, c&apos;est-à-dire de manière ininterrompue depuis plus de 3 mois
(si la personne âgée est étrangère, elle doit avoir un titre de séjour valide)
Avoir des ressources inférieures au montant des frais d&apos;hébergement,
Résider en établissement d&apos;hébergement pour personnes âgées dépendantes (Éhpad), ou en unité de soins de longue durée (USLD), ou résidence autonomie (ex logement-foyer), habilité à recevoir des bénéficiaires de l&apos;ASH.</rdfs:comment>
        <rdfs:comment xml:lang="en">traduction manuelle car pas d&apos;équivalent anglais</rdfs:comment>
        <skos:altLabel xml:lang="fr">ASH</skos:altLabel>
        <skos:prefLabel xml:lang="fr">aide sociale à l&apos;hébergement</skos:prefLabel>
        <skos:prefLabel xml:lang="en">housing social assistance</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.limics.fr/ontologies/ontoparonsoc#AideTechnique -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#AideTechnique">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#Equipement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#aPourThematique"/>
                <owl:someValuesFrom rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#ThematiqueAideTechnique"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ontoparonnoy:CIF_id>C2371621</ontoparonnoy:CIF_id>
        <rdfs:comment xml:lang="en">traduction manuelle</rdfs:comment>
        <rdfs:comment xml:lang="fr">utilisation de la classification d&apos;handicat sur l&apos;organisation des aides techniques. ils se basent sur la norme AFNOR ISO 9999 mais pas accés donc dans un souhait de pouvoir posiitionner l&apos;ensemble des aides à venir il me semble judicieux d&apos;utiliser leur classification 
Communication et informatique
Equipe du domicile
Loisirs
Medical
Mobilité
Vie quotidienne</rdfs:comment>
        <skos:altLabel xml:lang="fr">AT</skos:altLabel>
        <skos:altLabel xml:lang="fr">aide T</skos:altLabel>
        <skos:altLabel xml:lang="fr">aide matérielle</skos:altLabel>
        <skos:altLabel xml:lang="fr">aide tech</skos:altLabel>
        <skos:altLabel xml:lang="fr">aide techn</skos:altLabel>
        <skos:altLabel xml:lang="fr">aide-technique</skos:altLabel>
        <skos:altLabel xml:lang="fr">produits d&apos;assistance</skos:altLabel>
        <skos:definition xml:lang="fr">Equipement aide technique définit : l&apos;ensemble des aides techniques répondant à la définition de la norme Iso 9999
Tout produit, instrument ou équipement ou systéme technique utilisé par une personne handicapée, fabriqué spécialement ou existant sur le marché, destiné à prevenir, compenser, soulager ou neutraliser la déficience, l&apos;incapacité ou le handicap (définition OMS)</skos:definition>
        <skos:definition xml:lang="fr">Les aides techniques sont désignées dans cette norme par l’appellation « produits d’assistance ». Un produit d’assistance est défini comme « tout produit (y compris tout dispositif, équipement, instrument, technologie et logiciel) fabriqué spécialement ou généralement sur le marché, destiné à prévenir, à compenser, à contrôler, à soulager ou à neutraliser les déficiences, les limitations d’activité et les restrictions de la participation ».</skos:definition>
        <skos:prefLabel xml:lang="fr">aide technique</skos:prefLabel>
        <skos:prefLabel xml:lang="en">technical assistance</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.limics.fr/ontologies/ontoparonsoc#AideTechniqueDeTransfert -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#AideTechniqueDeTransfert">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#EquipementDuDomicile"/>
        <rdfs:comment xml:lang="fr">Ensemble du matériel pour aider aux transferts
hors dispositif ou materiel intervenant dans le logement (plate forme élevatrice)</rdfs:comment>
        <rdfs:comment xml:lang="fr">sous section 8 de la section 2 du chapitre  2</rdfs:comment>
        <rdfs:comment xml:lang="en">traduction manuelle car pas d&apos;équivalent</rdfs:comment>
        <skos:altLabel xml:lang="fr">Appareils destinés au soulevement du malade</skos:altLabel>
        <skos:prefLabel xml:lang="fr">aide technique de transfert</skos:prefLabel>
        <skos:prefLabel xml:lang="en">technical transfer aid</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.limics.fr/ontologies/ontoparonsoc#AideTechniqueMarche -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#AideTechniqueMarche">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#AideALaMobilité"/>
        <rdfs:comment xml:lang="fr">Fait partie de la section 2 du LLPR du cahpitre 2 : Dispositif médicaux maintien à domicile et d&apos;aide à la vie pour malades et handicapés</rdfs:comment>
        <rdfs:comment xml:lang="fr">ensemble des aides techniques permettant la marche</rdfs:comment>
        <rdfs:comment xml:lang="en">traduction manuelle car pas d&apos;équivalent anglais</rdfs:comment>
        <skos:altLabel xml:lang="fr">aide à la marche</skos:altLabel>
        <skos:prefLabel xml:lang="fr">aide technique de marche</skos:prefLabel>
        <skos:prefLabel xml:lang="en">technical walking assistance</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.limics.fr/ontologies/ontoparonsoc#AideTechniquePositionnementEtConfort -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#AideTechniquePositionnementEtConfort">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#AideTechnique"/>
        <rdfs:comment xml:lang="fr">ensemble des aides techniques de positionnement qui ne sont pas de maniere specifique crées pour la prevention d&apos;escarre</rdfs:comment>
        <rdfs:comment xml:lang="en">traduction manuelle car pas d&apos;équivalent anglais</rdfs:comment>
        <skos:prefLabel xml:lang="fr">aide technique de positionnement et de confort</skos:prefLabel>
        <skos:prefLabel xml:lang="en">technical assistance for positioning and comfort</skos:prefLabel>
    </owl:Class>
    


