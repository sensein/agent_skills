        <ontoparonnoy:MeSH_id>D006282</ontoparonnoy:MeSH_id>
        <ontoparonnoy:NCIt_id>C53287</ontoparonnoy:NCIt_id>
        <ontoparonnoy:UMLS_id>C0018724</ontoparonnoy:UMLS_id>
        <rdfs:comment xml:lang="fr">C1704312 code umls dans Ncit différent du code UMLS dans MeSH</rdfs:comment>
        <rdfs:comment xml:lang="fr">Les professionnels de santé vont réaliser les activités de soins</rdfs:comment>
        <skos:altLabel xml:lang="fr">soignant</skos:altLabel>
        <skos:definition xml:lang="fr">hommes et femmes travaillant dans les services de santé, en tant que praticiens individuels ou employés d&apos;établissements et de programmes de santé, formés ou non, et assujettis ou non à la règlementation publique.</skos:definition>
        <skos:prefLabel xml:lang="en">health professional</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">professionnel de santé</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.limics.fr/ontologies/ontoparonmed#ProfessionnelAssociationDePatient -->

