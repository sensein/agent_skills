    <!-- http://www.limics.fr/ontologies/ontoparonnoy#EtatAutonomie -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonnoy#EtatAutonomie">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#Etat"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#aPourThematique"/>
                <owl:someValuesFrom rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#ThematiqueSociale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#porteSur"/>
                <owl:someValuesFrom rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#Personne"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="fr">état d&apos;autonomie de la personne qui peut avoir une autonomie totale, partielle ou une perte d&apos;autonomie, l&apos;état d&apos;autonomie de la perte évolue au cours de la pathologie. Si initalement l&apos;autonomie désigne le fait de faire ces propres choix, et l&apos;indépendance la capacité à réaiser des taches, dans le corpus les deux concepts sont mélangés.</skos:definition>
        <skos:prefLabel xml:lang="en">state of autonomy</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">état d&apos;autonomie</skos:prefLabel>
    </owl:Class>
    


