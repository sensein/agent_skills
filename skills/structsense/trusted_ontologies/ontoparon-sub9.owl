        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonmed#ServiceExterneDUnHopital"/>
        <ontoparonnoy:MeSH_id>D018575</ontoparonnoy:MeSH_id>
        <ontoparonnoy:UMLS_id>C0242796</ontoparonnoy:UMLS_id>
        <skos:altLabel xml:lang="fr">HAD</skos:altLabel>
        <skos:definition xml:lang="fr">service dépendant de l&apos;hôpital et concernant les soins, les traitements, l&apos;aide et les services sociaux à domicile (MeSH)</skos:definition>
        <skos:prefLabel xml:lang="en">Home care</skos:prefLabel>
        <skos:prefLabel xml:lang="en">home hospitalization</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">hospitalisation à domicile</skos:prefLabel>
        <skos:prefLabel xml:lang="ru">Стационар на дому</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.limics.fr/ontologies/ontoparonmed#HospitalisationADomicileReadaptation -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonmed#HospitalisationADomicileReadaptation">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonmed#ServiceExterneDUnHopital"/>
        <skos:altLabel xml:lang="fr">HAD-R</skos:altLabel>
        <skos:altLabel xml:lang="fr">had r</skos:altLabel>
        <skos:definition xml:lang="fr">L’HAD de réadaptation (HAD-R) s’adresse à des patients présentant une ou plusieurs déficiences ou incapacités (quelle que soit la pathologie) nécessitant une rééducation/réadaptation pluridisciplinaire coordonnée par un médecin de médecine physique et de réadaptation (MPR), avec un programme soutenu et limité dans le temps, dans un but de gain ou de maintien fonctionnel et de meilleure qualité de vie. Elle est proposée au cours d’un parcours composé de différentes modalités de prise en charge intégrées dans un projet thérapeutique.</skos:definition>
        <skos:prefLabel xml:lang="fr">hospitalisation à domicile réadaptation</skos:prefLabel>
    </owl:Class>
    


