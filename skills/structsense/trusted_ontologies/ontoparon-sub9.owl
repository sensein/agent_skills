        <rdfs:comment xml:lang="en">trad manuelle car pas d&apos;équivalent anglais</rdfs:comment>
        <skos:altLabel xml:lang="fr">scala</skos:altLabel>
        <skos:definition xml:lang="fr">prix à partir de 6114 euros
systéme qui se fixe sur l chassis du fauteuil roulant et permet de monter les marches</skos:definition>
        <skos:prefLabel xml:lang="en">scalamobil</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">scalamobil</skos:prefLabel>
    </owl:Class>
    


