            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#aPourThematique"/>
                <owl:someValuesFrom rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#ThematiqueCutane"/>
