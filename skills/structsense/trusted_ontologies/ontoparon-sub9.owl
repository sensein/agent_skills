    <!-- http://www.limics.fr/ontologies/ontoparonsoc#AlimentTendre -->

    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#AlimentTendre">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#Aliment"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.limics.fr/ontologies/ontoparonnoy#aPourTexture"/>
