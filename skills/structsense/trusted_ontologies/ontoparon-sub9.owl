    <owl:Class rdf:about="http://www.limics.fr/ontologies/ontoparonsoc#AideTechniqueRepas">
        <rdfs:subClassOf rdf:resource="http://www.limics.fr/ontologies/ontoparonsoc#EquipementVieQuotidienne"/>
