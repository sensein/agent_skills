        <ontoparonnoy:UMLS_id>C0031206</ontoparonnoy:UMLS_id>
        <skos:altLabel xml:lang="fr">satisfaction</skos:altLabel>
        <skos:altLabel xml:lang="fr">satisfaction personnelle</skos:altLabel>
        <skos:definition xml:lang="en">The individual&apos;s experience of a sense of fulfillment of a need or want and the quality or state of being satisfied Hetop</skos:definition>
