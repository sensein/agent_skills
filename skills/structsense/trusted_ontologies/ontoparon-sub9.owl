        <skos:altLabel xml:lang="fr">PFNT</skos:altLabel>
        <skos:prefLabel xml:lang="en">new technology platform</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">plateforme nouvelle technologie</skos:prefLabel>
    </owl:Class>
    


