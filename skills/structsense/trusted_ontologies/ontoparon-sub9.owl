        <skos:altLabel xml:lang="en">Alveolar hypoventilation</skos:altLabel>
        <skos:altLabel xml:lang="fr">hypoventilation alvéolaire</skos:altLabel>
        <skos:definition xml:lang="fr">Réduction de la quantité d&apos;air entrant dans les alvéoles pulmonaires. [Traduction effectuée avant 2008]</skos:definition>
        <skos:prefLabel xml:lang="en">hypoventilation</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">hypoventilation</skos:prefLabel>
    </owl:Class>
    


