        <ontoparonnoy:MeSH_id>M0020064</ontoparonnoy:MeSH_id>
        <ontoparonnoy:NCIt_id>C28190</ontoparonnoy:NCIt_id>
        <ontoparonnoy:UMLS_id>C0037444</ontoparonnoy:UMLS_id>
        <rdfs:comment xml:lang="fr">professionnel du domaine social</rdfs:comment>
        <skos:altLabel xml:lang="fr">travailleur social</skos:altLabel>
        <skos:altLabel xml:lang="ru">Специалисты в области здравоохранения</skos:altLabel>
        <skos:definition xml:lang="en">Professionals who work with persons affected by social disadvantages such as POVERTY; mental and physical illness or disability, and social injustice. Their focus is on both the individual and his or her environment, including violations of their civil liberties and human rights</skos:definition>
        <skos:prefLabel xml:lang="en">Social Workers</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Social professionnel</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">professionnel social</skos:prefLabel>
        <skos:prefLabel xml:lang="ru">Субъект</skos:prefLabel>
    </owl:Class>
    


