        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the rate at which agitation occurs over a particular period of time.</rdfs:comment>
        <rdfs:label xml:lang="en">Frequency</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Friends -->

