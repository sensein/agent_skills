        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/FriendOfPersonWithDementia"/>
