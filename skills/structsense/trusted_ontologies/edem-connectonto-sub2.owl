        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It represents the individual&apos;s capacity and assistance needed to maintain a level of regular movements despite the impairments caused by dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Needs help with movement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Negative_communication_between_PwD_and_FC -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Negative_communication_between_PwD_and_FC">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Poor_relationship_quality"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Negative_communication_between_PwD_and_FC</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the lack of appropriate or positive communication between the people with dementia and the caregiver</rdfs:comment>
        <rdfs:label xml:lang="en">Negative communications between people with dementia (PwD) and family carer</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Negativism -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Negativism">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Verbal_nonagressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Negativism</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/Negativism"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the verbally nonagressive behavior that include bad attitude, doesn’t like anything, nothing is right.</rdfs:comment>
        <rdfs:label xml:lang="en">Negativism</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Neighbours -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Neighbours">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Caregiver"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Neighbours</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the neighbours, taking care of people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Neighbours</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Noise_level -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Noise_level">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Environmental_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Noise_level</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/Noise"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">NDB</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refered to the fact that too much noise can cause agitation.</rdfs:comment>
        <rdfs:label xml:lang="en">Noise level</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Nursing_service -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Nursing_service">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Attendees"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Nursing_service</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the nursing service as attendees who are with the people with dementia when agitation occurs.</rdfs:comment>
        <rdfs:label xml:lang="en">Nursing service</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Odors -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Odors">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Environmental_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Odors</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/Smell"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the fact that offensive smell can cause agitation.</rdfs:comment>
        <rdfs:label xml:lang="en">Odors</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Overstimulation -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Overstimulation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Environmental_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Overstimulation</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/OverStimulationOfSocialEnvironment"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the fact that over-stimulation from the social environment can cause agitation.</rdfs:comment>
        <rdfs:label xml:lang="en">Overstimulation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Pacing -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Pacing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_nonaggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Pacing</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/Pacing"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to certain types of behaviour that includes walking with regular slow or fast paces, especially without a particular destination.</rdfs:comment>
        <rdfs:label xml:lang="en">Pacing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Pain_of_the_person_with_dementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Pain_of_the_person_with_dementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Factors_related_to_the_person_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Pain_of_the_person_with_dementia</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/Pain"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015,
TREA</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the highly unpleasant physical sensation caused by illness or injury.</rdfs:comment>
        <rdfs:label xml:lang="en">Pain of the person with dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#People_with_dementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#People_with_dementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Person"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#People_with_dementia</untitled-ontology-20:ID>
        <untitled-ontology-20:abbreviation xml:lang="en">PwD</untitled-ontology-20:abbreviation>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/PersonWithDementia"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the person who is diagnosed with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">People with dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Performing_repetitive_mannerism -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Performing_repetitive_mannerism">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_nonaggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Performing_repetitious_mannerism</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/RepetitivePhysicalMannerism"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the physically nonaggressive behavior that includes repetitive physical actions.</rdfs:comment>
        <rdfs:label xml:lang="en">Performing repetitive mannerism</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Permit_to_show_agitation -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Permit_to_show_agitation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Acceptance"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Permit_to_show_agitation</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">Family carer should have permit / allow person with dementia to show agitation.</rdfs:comment>
        <rdfs:label xml:lang="en">Permit to show agitation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Person -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Person">
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Person</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/Person"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-08-15</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to all people diagnosed / suspected with dementia and also informal care givers / family-carer of people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Person</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Person-centeredness -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Person-centeredness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Prevention"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Person-centeredness</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the intervention focused on the comfort and preferences of person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Person-centeredness</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Personal_hygiene -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Personal_hygiene">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Situation"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Personal_hygiene</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to personal hygiene activities such as washing, showering, brushing teeth, etc.</rdfs:comment>
        <rdfs:label xml:lang="en">Personal hygiene</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Personality -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Personality">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Profile_of_people_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Personality</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/Personality"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-11</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to individual differences in characteristic patterns of thinking, feeling and behaving.</rdfs:comment>
        <rdfs:label xml:lang="en">Personality</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Phone_call_frequency -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Phone_call_frequency">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Environmental_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Phone_call_frequency</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/PhoneCallFrequency"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-08-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">(Rhodes-Kropf J et al. 2011)</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">Too frequent phone calls to the people with dementia can cause agitation.</rdfs:comment>
        <rdfs:label xml:lang="en">Phone call frequency</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_aggressive -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_aggressive">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Agitation"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_aggressive</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/PhysicallyAggressiveBehaviour"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the physically-aggressive hehaviors of the people with dementia. For example: biting, kicking, hurting and others.</rdfs:comment>
        <rdfs:label xml:lang="en">Physical_aggressive</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_discomfort -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_discomfort">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Factors_related_to_the_person_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_discomfort</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/PhysicalRestraint"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the situation that is not comfortable for person with dementia. For example, sitting all day in an uncomfortable position.</rdfs:comment>
        <rdfs:label xml:lang="en">Physical discomfort</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_nonaggressive -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_nonaggressive">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Agitation"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_nonaggressive</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/PhysicallyNonaggressiveBehaviour"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to  physically-nonaggressive behaviour. For example: hiding things, intentional falling and others.</rdfs:comment>
        <rdfs:label xml:lang="en">Physical non_aggressive</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Places -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Places">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Topography"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Places</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the places where agitation occurs over a particular period of time.</rdfs:comment>
        <rdfs:label xml:lang="en">Places</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Pleasant_life_events -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Pleasant_life_events">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lifestyle_before_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Pleasant_life_events</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-11</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the pleasant life event of the people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Pleasant life events</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Poor_caregiver_outcomes -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Poor_caregiver_outcomes">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Consequences"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Poor_caregiver_outcomes</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the concept that the dementia-related agitation can cause poor caregiver outcomes such as reduced quality of life, worse health, depression or distress.</rdfs:comment>
        <rdfs:label xml:lang="en">Poor caregiver outcomes</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Poor_premorbid_relationship_quality -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Poor_premorbid_relationship_quality">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Poor_relationship_quality"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Poor_premorbid_relationship_quality</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the poor quality of the relationship between the person with dementia and the caregiver before the onset of the disease</rdfs:comment>
        <rdfs:label xml:lang="en">Poor premorbid relationship quality</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Poor_relationship_quality -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Poor_relationship_quality">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Relationship_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Poor_relationship_quality</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the poor quality of the relationship between the person with dementia and the caregiver.</rdfs:comment>
        <rdfs:label xml:lang="en">Poor relationship quality</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Pre_existing_personality -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Pre_existing_personality">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Factors_related_to_the_person_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Pre_existing_personality</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the personality of the person with dementia before the onset of the disease.</rdfs:comment>
        <rdfs:label xml:lang="en">Pre existing personality</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Preferences -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Preferences">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Profile_of_people_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Preferences</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/Preference"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-11</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the greater liking for one alternative over another or others. For example, preference for a bath or shower, preferences regarding time of day for bathing, the use of products or items familiar to the individual.</rdfs:comment>
        <rdfs:label xml:lang="en">Preferences</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Prevention -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Prevention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Interventions"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Prevention</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the  actions that are taken  to prevent the agitation symtoms of the person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Prevention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Problem_solving -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Problem_solving">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Interventions"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Problem_solving</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the problem solving tasks that could be used to adress the underlying causes of agitation.</rdfs:comment>
        <rdfs:label xml:lang="en">Problem solving</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Problems_with_eating -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Problems_with_eating">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Impairment_in_performing_activities_in_daily_living"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Problems_with_eating</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the physical limitations which restricts freedom of eating</rdfs:comment>
        <rdfs:label xml:lang="en">Problems with eating</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Profile -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Profile">
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Profile</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-08-15</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the collection of general factors that characterize an individual and also describe long term conditions of the person along with the typical behavioural patterns and abilities.</rdfs:comment>
        <rdfs:label xml:lang="en">Profile</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Profile_of_caregiver -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Profile_of_caregiver">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Profile"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Profile_of_caregiver</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-08-15</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the collection of general attributes that characterize the unprofessional caregivers staying / taking care of the people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Profile_of_caregiver</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Profile_of_people_with_dementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Profile_of_people_with_dementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Profile"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Profile_of_people_with_dementia</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-08-15</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the collection of general attributes that characterize an individual diagnosed with dementia, encompassing demographic, clinical, functional, and social information relevant to their identity.</rdfs:comment>
        <rdfs:label xml:lang="en">Profile_of_people_with_dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Promote_well-being -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Promote_well-being">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Prevention"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Promote_well-being</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to action of the family-carer that ensures to improve the quality of life of the person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Promote well-being</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Provide_for_employment -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Provide_for_employment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Prevention"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Provide_for_employment</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the action of the family carer which helps to provide more employment opportunities to the person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Provide for employment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Provide_for_social_contacts -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Provide_for_social_contacts">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Prevention"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Provide_for_social_contacts</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the actions of the family carer that engages people with dementia in social interaction with other people.</rdfs:comment>
        <rdfs:label xml:lang="en">Provide for social contacts</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Psychiatric_illness -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Psychiatric_illness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Factors_related_to_the_person_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Psychiatric_illness</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/PsychiatricSyndrome"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the mental illness that greatly disturbs the thinking, moods, and/or behaviour and seriously increases the risk of disability, pain, death, or loss of freedom.</rdfs:comment>
        <rdfs:label xml:lang="en">Psychiatric illness</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Pulling_at_clothes -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Pulling_at_clothes">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_nonaggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Pulling_at_clothes</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to a behavior where individuals with dementia repeatedly tug, fiddle with, or manipulate their clothing.</rdfs:comment>
        <rdfs:label xml:lang="en">Pulling at clothes</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Pushing -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Pushing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_aggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Pushing</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/Pushing"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the physically aggressive behavior that includes forcefully thrusting,  putting pressure against another.</rdfs:comment>
        <rdfs:label xml:lang="en">Pushing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Recognize_and_avoid_triggers -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Recognize_and_avoid_triggers">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Prevention"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Recognize_and_avoid_triggers</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the actions of the health care professionals to recognize and manage the triggers of agitated behaviours in people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Recognize and avoid triggers</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Reduction_of_negative_consequences -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Reduction_of_negative_consequences">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Interventions"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Reduction_of_negative_consequences</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the  actions that are taken  to reduce the negative consequences of  the agitation symtoms of the person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Reduction of negative consequences</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Reduction_of_stress -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Reduction_of_stress">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Prevention"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Reduction_of_stress</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the activity of reducing the stress of the family caregiver.</rdfs:comment>
        <rdfs:label xml:lang="en">Reduction of stress</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Relationship_factors -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Relationship_factors">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Interpersonal_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Relationship_factors</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It defines the relationship factors between the person with dementia and the caregiver.</rdfs:comment>
        <rdfs:label xml:lang="en">Relationship factors</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Relative -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Relative">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Attendees"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Relative</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the relattives as attendees who are with the people with dementia when agitation occurs.</rdfs:comment>
        <rdfs:label xml:lang="en">Relative</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Relatives_training -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Relatives_training">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Prevention"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Relatives_training</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the intervention of teaching relatives to cope with the needs and challenging behaviors of the person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Relatives training</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Repetitive_sentences_or_questions -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Repetitive_sentences_or_questions">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Verbal_nonagressive"/>
        <untitled-ontology-20:ID>http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Repetitive_sentences_or_questions</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/ConstantRepetitionOfWord"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the verbally nonaggressive behaviour that include repeating the same sentence or question one right after the other.</rdfs:comment>
        <rdfs:label xml:lang="en">Repetitive_sentences_or_questions</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Resisting_care -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Resisting_care">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_nonaggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Resisting_care</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to unwillingness to be taken care of even when the person with dementia requires care.</rdfs:comment>
        <rdfs:label xml:lang="en">Resisting care</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Resources -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Resources">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Profile_of_people_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Resources</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-11</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the resources for people with dementia to assist individuals in managing their condition and enhancing their quality of life (e.g., support systems, services, and tools available to assist the people with dementia ).</rdfs:comment>
        <rdfs:label xml:lang="en">Resources</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Restraint -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Restraint">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Factors_related_to_the_person_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Restraint</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to physical or medical restriction of mobility with straps or sedatives.</rdfs:comment>
        <rdfs:label xml:lang="en">Restraint</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Restricted_daily_activitiy_and_social_life -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Restricted_daily_activitiy_and_social_life">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Consequences"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Restricted_daily_activitiy_and_social_life</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the reduced social contacts and active life of the person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Restricted daily activity and social life</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Sadness -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Sadness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Strong_emotion"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Sadness</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Alexopoulos et al. 2007</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the condition or quality of being sad.</rdfs:comment>
        <rdfs:label xml:lang="en">Sadness</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Safety_issues -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Safety_issues">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Environmental_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Safety_issues</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the fact that safety issues for person with dementia can cause agitation.</rdfs:comment>
        <rdfs:label xml:lang="en">Safety issues</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Scratching -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Scratching">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_aggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Scratching</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/Scratching"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the physically aggressive behavior that includes clawing, scraping with fingernails either other people or self.</rdfs:comment>
        <rdfs:label xml:lang="en">Scratching</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Screaming -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Screaming">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Verbal_aggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Screaming</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/Screaming"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to speak  loudly / shouting, high-pitched vocalisations.</rdfs:comment>
        <rdfs:label xml:lang="en">Screaming</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Sense_of_loss -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Sense_of_loss">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Strong_emotion"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Sense_of_loss</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Alexopoulos et al. 2007</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the feeling of grief after losing something or someone of value.</rdfs:comment>
        <rdfs:label xml:lang="en">Sense of loss</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Sensory_changes -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Sensory_changes">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Factors_related_to_the_person_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Sensory_changes</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to alterations in their sensory perception, which can contribute to increased restlessness, irritability, or emotional distress.</rdfs:comment>
        <rdfs:label xml:lang="en">Sensory changes</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Severity_of_cognitive_impairment -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Severity_of_cognitive_impairment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Factors_related_to_the_person_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Severity_of_cognitive_impairment</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/CognitiveImpairment"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the fact that the degree of severity of cognitive impairment  can contribute to agitation.</rdfs:comment>
        <rdfs:label xml:lang="en">Severity of cognitive impairment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Shopping -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Shopping">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Situation"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Shopping</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the activity of buying goods from shops.</rdfs:comment>
        <rdfs:label xml:lang="en">Shopping</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Short_term -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Short_term">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Duration"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Short_term</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the length during when agitation continues in a short term basis.</rdfs:comment>
        <rdfs:label xml:lang="en">Short term</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Since_long_time -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Since_long_time">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Duration"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Since_long_time</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the time period when agitation continues for a long time.</rdfs:comment>
        <rdfs:label xml:lang="en">Since long time</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Since_recently -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Since_recently">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Duration"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Since_recently</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the time period when agitation start continueing recently.</rdfs:comment>
        <rdfs:label xml:lang="en">Since recently</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Situation -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Situation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Topography"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Situation</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the different circumstances where agitation occurs over a period of time.</rdfs:comment>
        <rdfs:label xml:lang="en">Situation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Situation_independent -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Situation_independent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Situation"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Situation-independent</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to a condition that is independent of the current sitution.</rdfs:comment>
        <rdfs:label xml:lang="en">Situation independent</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Sleep_disorder -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Sleep_disorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Factors_related_to_the_person_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Sleep_disorder</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/SleepDisorder"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">TREA</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the problems relating to sleep, such as changes in sleeping patterns or habits, that can negatively affect health.</rdfs:comment>
        <rdfs:label xml:lang="en">Sleep disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Social_activities -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Social_activities">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lifestyle_before_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Social_activities</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-08-21</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">SinDeM Ontology</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the long term intrinsic factor describing preferred social activities.</rdfs:comment>
        <rdfs:label xml:lang="en">Social activities</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Social_functioning -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Social_functioning">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Disability"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Social_functioning</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/ImpairmentInSocialFunctioning"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the concept that agitation could cause the impairment of a person with dementia in social functioning.</rdfs:comment>
        <rdfs:label xml:lang="en">Social fuctioning</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Spitting -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Spitting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_aggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Spitting</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/SpittingOnPeople"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the physically aggressive behavior that includes spitting things onto floor / other people while feeding / eating food.</rdfs:comment>
        <rdfs:label xml:lang="en">Spitting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Strange_noises -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Strange_noises">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Verbal_nonagressive"/>
        <untitled-ontology-20:ID>http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Strange_noises</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/MakingBizarreNoise"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the verbally nonaggressibe behaviour that includes crying, weeping, moaning, weird laughter, grinding teeth, does not include intelligible words.</rdfs:comment>
        <rdfs:label xml:lang="en">Strange noises</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Strangers -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Strangers">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Attendees"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Strangers</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the strangers as attendees who are with the people with dementia when agitation occurs.</rdfs:comment>
        <rdfs:label xml:lang="en">Strangers</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Stress -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Stress">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Caregiver_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Stress</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Kales et al. 2105</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the fact that caregivers who are overwhelmed, stressed, anxious themselves may inadvertently transmit their stress and negative emotions to the person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Stress</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Strong_emotion -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Strong_emotion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Agitation"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Strong_emotion</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/EmotionalDistress"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Alexopoulos et al. 2007</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the types of emotions that people with dementia experience associated with agitation.</rdfs:comment>
        <rdfs:label xml:lang="en">Strong_emotion</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Suspicion -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Suspicion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Personality"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Suspicion</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It is characterized by a  sense of doubt or mistrust towards others. It involves a tendency to ask question about the motives or intentions of others without having any concrete evidence or rational basis.</rdfs:comment>
        <rdfs:label xml:lang="en">Suspicion</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Tearing_things_or_destroying_property -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Tearing_things_or_destroying_property">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_aggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Tearing_things_or_destroying_property</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/Tearing"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the physically aggressive behavior that includes shredding, ripping, breaking things.</rdfs:comment>
        <rdfs:label xml:lang="en">Tearing things or destroying things</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Technical_affinity -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Technical_affinity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Profile"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Technical_affinity</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-08-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">SiNDeM ontology</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the long term intrinsic factor describing the ability of the person to use technology.</rdfs:comment>
        <rdfs:label xml:lang="en">Technical_affinity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Temperature -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Temperature">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Environmental_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Temperature</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/Temperature"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">NDB</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the fact that staying in inappropriate temperature of the environment, such as too hot or too cold, can cause agitation.</rdfs:comment>
        <rdfs:label xml:lang="en">Temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#The_person_before_the_disease -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#The_person_before_the_disease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Personality"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#The_person_before_the_disease</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the personality of the person before he or she was diagnosed with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">The person before the disease</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Therapist -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Therapist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Attendees"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Therapist</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the therapist as attendees who are with the people with dementia when agitation occurs.</rdfs:comment>
        <rdfs:label xml:lang="en">Therapist</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Thirst -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Thirst">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Unmet_needs"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Thirst</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the situation when the individuals with dementia feel thirsty, which could cause agitation / a sensation of dryness in the mouth and throat associated with a desire for liquid.</rdfs:comment>
        <rdfs:comment xml:lang="en">“Thirst” is a sensation of dryness in the mouth and throat associated with a desire for liquid.</rdfs:comment>
        <rdfs:label xml:lang="en">Thirst</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Throwing_things -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Throwing_things">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_aggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Throwing_things</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/ThrowingObject"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the physically aggressive behaviour that includes hurling objects, violently tossing objects up in air, tipping off surfaces, flinging, dumping food.</rdfs:comment>
        <rdfs:label xml:lang="en">Throwing things</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Tolerate_and_accept -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Tolerate_and_accept">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#De-escalation"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Tolerate_and_accept</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">The family carer should tolerarte and accept the agitated behavior of the person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Tolerate and accept</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Topography -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Topography">
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Topography</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the  detailed description of the natural and artificial features of the surroundings when agitation occurs over a particular period of time to the people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Topography</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Translocation -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Translocation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Environmental_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Translocation</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the fact that moving the person with dementia to another place could cause agitation.</rdfs:comment>
        <rdfs:label xml:lang="en">Translocation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Trauma_reactivation -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Trauma_reactivation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Factors_related_to_the_person_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Trauma_reactivation</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the recurrence or resurfacing of past traumatic experiences or memories.</rdfs:comment>
        <rdfs:label xml:lang="en">Trauma reactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Trying_to_get_to_a_different_place -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Trying_to_get_to_a_different_place">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_nonaggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Trying_to_get_to_a_different_place</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the physically nonaggressive behavior that includes inappropriately entering or leaving a place, such as trying to get out of the building,sneaking out of room, trying to get into locked areas, trespassing within unit, offices, or other resident’s room or closet.</rdfs:comment>
        <rdfs:label xml:lang="en">Trying to get to a different place</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Type_1_user -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Type_1_user">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Technical_affinity"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Type_1_user</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-08-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">SiNDeM ontology</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the people that have technical understanding and interest in technology based on their professional experience.</rdfs:comment>
        <rdfs:label xml:lang="en">Type_1_user</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Type_2_user -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Type_2_user">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Technical_affinity"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Type_2_user</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-08-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">SiNDeM ontology</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the people that have technical understanding and interest in technology based on their personal interests and hobbies.</rdfs:comment>
        <rdfs:label xml:lang="en">Type_2_user</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Type_3_user -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Type_3_user">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Technical_affinity"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Type_3_user</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-08-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">SiNDeM ontology</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the people that have none or small interest in modern technology.</rdfs:comment>
        <rdfs:label xml:lang="en">Type_3_user</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Understand_agitation_as_part_of_dementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Understand_agitation_as_part_of_dementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Acceptance"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Understand_agitation_as_part_of_dementia</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">Family carer should understand the types of behavior of agitation in the domain of people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Understand agitation as part of dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Understimulation -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Understimulation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Environmental_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Understimulation</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/UnderStimulationOfSocialEnvironment"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the fact that under-stimulation of the social environment can cause agitation.</rdfs:comment>
        <rdfs:label xml:lang="en">Understimulation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Unfavourable_coping_style -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Unfavourable_coping_style">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Low_mental_capabilities"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Unfavourable_coping_style</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the fact that inexperience of the caregiver can cause them to choose inaproapriate intervention strategies.</rdfs:comment>
        <rdfs:label xml:lang="en">Unfavourable coping style</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Unmet_needs -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Unmet_needs">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Factors_related_to_the_person_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Unmet_needs</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/UnmetNeed"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the requirement that is not achieved or fulfilled, which could cause agitation.</rdfs:comment>
        <rdfs:label xml:lang="en">Unmet needs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Verbal_aggressive -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Verbal_aggressive">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Agitation"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Verbal_aggressive</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/VerballyAggressiveBehaviour"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the vocally agitated behavior, for example: screaming, cursing and others.</rdfs:comment>
        <rdfs:label xml:lang="en">Verbal_aggressive</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Verbal_interaction -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Verbal_interaction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Caregiver_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Verbal_interaction</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the verbally interaction technique of interpreting confused communication with the people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Verbal interaction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Verbal_nonagressive -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Verbal_nonagressive">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Agitation"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Verbal_nonagressive</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/VerballyNonaggressiveBehaviour"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to vocally-nonaggressive behavior. For example: complaining, repeating sentences of questions.</rdfs:comment>
        <rdfs:label xml:lang="en">Verbal_nonaggressive</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Vision_and_hearing_deficits -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Vision_and_hearing_deficits">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Impaired_communication_skills"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Vision_and_hearing_deficits</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the damaged ability to see clearly with eyes and to hear properly.</rdfs:comment>
        <rdfs:label xml:lang="en">Vision and hearing deficits</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Visiting -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Visiting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Situation"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Visiting</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the act of going to see a person or a place as a guest or tourist.</rdfs:comment>
        <rdfs:label xml:lang="en">Visiting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Visitor_visit_frequency -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Visitor_visit_frequency">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Environmental_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Visitor_visit_frequency</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/VisitorVisitFrequency"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">(Rhodes-Kropf J et al. 2011)</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">The frequency of people visiting to the person with dementia can cause agitation.</rdfs:comment>
        <rdfs:label xml:lang="en">Visitor visit frequency</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Weekly -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Weekly">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Frequency"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Weekly</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the rate at which agitation occurs weekly.</rdfs:comment>
        <rdfs:label xml:lang="en">Weekly</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Wringing_of_hands -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Wringing_of_hands">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_nonaggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Wringing_of_hands</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/HandWringing"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to a repetitive motion where individuals with dementia rub their hands together, twist or wring their hands in a continuous manner.</rdfs:comment>
        <rdfs:label xml:lang="en">Wringing of hands</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#kicking -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#kicking">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_aggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#kicking</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/Kicking"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the physically aggressive behavior that includes striking forcefully with feet at people or objects.</rdfs:comment>
        <rdfs:label xml:lang="en">Kicking</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Abilities_/_skills -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Abilities_/_skills">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Profile_of_people_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Abilities_/_skills</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/Skill"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-11</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the ability to do something well.</rdfs:comment>
        <rdfs:label xml:lang="en">Abilities / skills</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Affected_intimacy/sexuality -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Affected_intimacy/sexuality">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Poor_relationship_quality"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Affected_intimacy/sexuality</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">Intimate relationship between the person with dementia and the caregiver is affected by the disease when the caregiver is a spouse</rdfs:comment>
        <rdfs:label xml:lang="en">Affected intimacy/sexuality</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Communication:_controlling_the_emotional_tone_of_your_own_language -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Communication:_controlling_the_emotional_tone_of_your_own_language">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#De-escalation"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Communication:_controlling_the_emotional_tone_of_your_own_language</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the action of the family carers which is to  control their emotional tone of their language while talking to the person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Communication: controlling the emotional tone of your own language</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Eating/drinking_inappropriate_substances -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Eating/drinking_inappropriate_substances">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_nonaggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Eating/drinking_inappropriate_substances</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the physically nonaggressive behavior that includes eating / drinking inappropriate substances.</rdfs:comment>
        <rdfs:label xml:lang="en">Eating/drinking inappropriate substances</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Health_/_illness -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Health_/_illness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Profile_of_people_with_dementia"/>
        <untitled-ontology-20:ID>http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Health_/_illness</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/HealthCondition"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-11</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield &amp; Parpura-Gill 2007 (TREA)</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the health state of people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Health / illness</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Job/employment -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Job/employment">
