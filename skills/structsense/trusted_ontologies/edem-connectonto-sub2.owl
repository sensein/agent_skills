        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-08-25</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">Agitation occurs_in Situation (e.g, Dressing, Food_intake)</rdfs:comment>
        <rdfs:label xml:lang="en">occurs_in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#prevents -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#prevents">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Prevention"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Agitation"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">Prevention (e.g., Maintain routines) prevents Agitation</rdfs:comment>
        <rdfs:label xml:lang="en">prevents</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#reduces -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#reduces">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Acceptance"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#De-escalation"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Reduction_of_negative_consequences"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Consequences"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">Acceptance reduces Consequences</rdfs:comment>
        <rdfs:comment xml:lang="en">De-escalation reduces Consequences</rdfs:comment>
        <rdfs:comment xml:lang="en">Reduction of negative consequences (e.g., Looking for distraction) reduces Consequences</rdfs:comment>
        <rdfs:label xml:lang="en">reduces</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#resolves -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#resolves">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Problem_solving"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Consequences"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">Problem_solving (e.g., Screening for medical causes) resolves Consequences (e.g., Disability, Higher incidence of falling)</rdfs:comment>
        <rdfs:label xml:lang="en">resolves</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#triggers -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#triggers">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Causes"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Agitation"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">Causes triggers Agitation</rdfs:comment>
        <rdfs:label xml:lang="en">triggers</rdfs:label>
    </owl:ObjectProperty>
    


