    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Safety_for_PwD:_provide_safe_environment,_assess_risks -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Safety_for_PwD:_provide_safe_environment,_assess_risks">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Reduction_of_negative_consequences"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Safety_for_PwD:_provide_safe_environment,_assess_risks</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the family carer that they should look and monitor the environment of the person with dementia if it is safe.</rdfs:comment>
        <rdfs:label xml:lang="en">Safety for PwD: provide safe environment, assess risks</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Safety_for_relatives:_leave_the_room,_leave_PwD_alone -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Safety_for_relatives:_leave_the_room,_leave_PwD_alone">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Reduction_of_negative_consequences"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Safety_for_relatives:_leave_the_room,_leave_PwD_alone</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the family carer that they should leave the room if person with dementia is being very agitated for the family carer&apos;s own safety.</rdfs:comment>
        <rdfs:label xml:lang="en">Safety for relatives: leave the room, leave the PwD alone</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Screening_for_physical/medical_causes -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Screening_for_physical/medical_causes">
