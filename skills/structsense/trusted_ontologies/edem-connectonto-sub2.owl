        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the friends, taking care of people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Friends</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Frustration -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Frustration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Strong_emotion"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Frustration</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/Frustration"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Alexopoulos et al. 2007</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the feeling of being upset or annoyed.</rdfs:comment>
        <rdfs:label xml:lang="en">Frustration</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Functional_limitations -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Functional_limitations">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Factors_related_to_the_person_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Functional_limitations</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the physical limitations to perform a task.</rdfs:comment>
        <rdfs:label xml:lang="en">Functional limitations</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Further_family_carer -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Further_family_carer">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Caregiver"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Further_family_carer</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Ablitt et al. 2009, Wadham et al. 2016, Conway et al. 2018</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the further family members, taking care of people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Further family carer</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Gender -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Gender">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Profile_of_caregiver"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Gender</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-11</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Braun et al. 2009</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the gender of the family carer.</rdfs:comment>
        <rdfs:label xml:lang="en">Gender</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#General_restlessness -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#General_restlessness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_nonaggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#General_restlessness</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/Restlessness"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to physcially nonaggressive behavior that includes fidgeting, always moving around in seat, getting up and sitting down inability to sit still.</rdfs:comment>
        <rdfs:label xml:lang="en">General restlessness</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Going_to_the_toilet -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Going_to_the_toilet">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Situation"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Going_to_the_toilet</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to use the toilet.</rdfs:comment>
        <rdfs:label xml:lang="en">Going to the toilet</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Grabbing_onto_people -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Grabbing_onto_people">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_aggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Grabbing_onto_people</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/Grabbing"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the physically aggressive behavior that includes snatching, seizing roughly, taking firmly, or yanking.</rdfs:comment>
        <rdfs:label xml:lang="en">Grabbing onto people</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hallway -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hallway">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Places"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hallway</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the places if agitation occurs while staying in the hallway.</rdfs:comment>
        <rdfs:label xml:lang="en">Hallway</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Handling_things_inappropriatly -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Handling_things_inappropriatly">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_nonaggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Handling_things_inappropriatly</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/InappropriatelyHandlingObject"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the physically nonaggressive behavior that includes picking up things that don’t belong to them, rummaging through drawers, moving furniture.</rdfs:comment>
        <rdfs:label xml:lang="en">Handling things inappropriately</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hiding_things -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hiding_things">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_nonaggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hiding_things</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on>Sumaiya Suravee</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the physically nonaggressive behavior that includes putting objects out of sight, under or behind something.</rdfs:comment>
        <rdfs:label xml:lang="en">Hiding things</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Higher_incidence_of_falling -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Higher_incidence_of_falling">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Consequences"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Higher_incidence_of_falling</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the concept that the presence of agitation in a person with dementia increases the tendency of falling.</rdfs:comment>
        <rdfs:label xml:lang="en">Higher incidence of falling</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hitting -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hitting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_aggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hitting</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/Hitting"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the physically aggressive behaviour that includes physical abuse, striking others, pinching others, banging self/furniture.</rdfs:comment>
        <rdfs:label xml:lang="en">Hitting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hoarding_things -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hoarding_things">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_nonaggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hoarding_things</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the physically nonaggressive behavior that includes putting many or inappropriate objects in purse, pockets, or drawers, keeping too many of an item.</rdfs:comment>
        <rdfs:label xml:lang="en">Hoarding things</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hobbies -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hobbies">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Profile_of_caregiver"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hobbies</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-11</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the different types of hobbies of the family carer.</rdfs:comment>
        <rdfs:label xml:lang="en">Hobbies</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hospital_admission -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hospital_admission">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Consequences"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hospital_admission</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the concept that the dementia-related agitation can lead to hospital admission.</rdfs:comment>
        <rdfs:label xml:lang="en">Hospital admission</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hospitalization -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hospitalization">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Environmental_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hospitalization</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the fact that admission of the person with dementia to hospital could cause aggitation.</rdfs:comment>
        <rdfs:label xml:lang="en">Hospitalization</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hourly -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hourly">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Frequency"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hourly</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the rate at which agitation occurs hourly.</rdfs:comment>
        <rdfs:label xml:lang="en">Hourly</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hunger -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hunger">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Unmet_needs"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hunger</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the situation when the individuals with dementia feel hungry, which could cause agitation / an uneasy sensation occasioned by the lack of food.</rdfs:comment>
        <rdfs:comment xml:lang="en">“Hunger” is an uneasy sensationoccasioned by the lack of food.</rdfs:comment>
        <rdfs:label xml:lang="en">Hunger</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hurting_self_or_other -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hurting_self_or_other">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_aggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hurting_self_or_other</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/HurtingSomeone"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to certain type of physical aggressive behavior that includes  hurting or others.</rdfs:comment>
        <rdfs:label xml:lang="en">Hurting self or other</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hyperactivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hyperactivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_nonaggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Hyperactivity</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the condition of being overly physically active.</rdfs:comment>
        <rdfs:label xml:lang="en">Hyperactivity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Identify_unmet_needs_and_meet_them_when_possibles -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Identify_unmet_needs_and_meet_them_when_possibles">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Problem_solving"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Identify_unmet_needs_and_meet_them_when_possibles</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to actions of the family carer , trying to identify umnet needs of the PWD and meet the needs when possible.</rdfs:comment>
        <rdfs:label xml:lang="en">Identify unmet needs and meet them when possibles</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Impact_on_daily_living_activities -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Impact_on_daily_living_activities">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Disability"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Impact_on_daily_living_activities</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/ImpairmentInAbilityToPerformDailyLivingActivity"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the concept that agitation could cause impairment in the ability to perform the activities of daily living to person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Impact on daily living activities</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Impaired_communication_skills -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Impaired_communication_skills">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Factors_related_to_the_person_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Impaired_communication_skills</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/CommunicationProblem"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the difficulties to communicate with others, such as difficulty to express feeling and difficulty in finding words to communicate.</rdfs:comment>
        <rdfs:label xml:lang="en">Impaired communication skills</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Impairment_in_performing_activities_in_daily_living -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Impairment_in_performing_activities_in_daily_living">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Functional_limitations"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Impairment_in_performing_activities_in_daily_living</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the inability of person with dementia to perform the activities of daily living, which causes agitation.</rdfs:comment>
        <rdfs:label xml:lang="en">Impairment in performing activities in daily living</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Improve_the_quality_of_relationships_of_PwD_residents -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Improve_the_quality_of_relationships_of_PwD_residents">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Prevention"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Improve_the_quality_of_relationships_of_PwD_residents</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the family carer who will try to improve the quality of relationship between the person with dementia and him or herself.</rdfs:comment>
        <rdfs:label xml:lang="en">Improve the quality of relationships of people with dementia (PwD) residents</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Inappropriate_dress_or_disrobing -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Inappropriate_dress_or_disrobing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_nonaggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Inappropriate_dress_or_disrobing</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/InappropriateDressing"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the physically nonaggressive behavior that includes putting on too many clothes, putting on clothing in a strange manner (e.g., putting pants on head), taking off clothing in public.</rdfs:comment>
        <rdfs:label xml:lang="en">Inappropriate dress or disrobing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Independence_in_activities_of_daily_living -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Independence_in_activities_of_daily_living">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Profile_of_people_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Independence_in_activities_of_daily_living</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-11</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the ability to perform essential self-care tasks and daily activities independently without significant assistance.</rdfs:comment>
        <rdfs:label xml:lang="en">Independence in activities of daily living</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Inner_tension -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Inner_tension">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Strong_emotion"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Inner_tension</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Alexopoulos et al. 2007</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the mental strain of the people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Inner_tension</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Insensibility -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Insensibility">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Caregiver_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Insensibility</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the insensible behavior of the caregiver that induce agitation on the people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Insensibility</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Institutionalization -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Institutionalization">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Consequences"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Institutionalization</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/LikelihoodOfInstitutionalisation"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Kong 2005, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the concept that dementia-related agitation can cause the likelihood of being placed in a residential institution.</rdfs:comment>
        <rdfs:label xml:lang="en">Institutionalization</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Intentional_falling -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Intentional_falling">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_nonaggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Intentional_falling</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the physically nonaggressive behavior that includes purposefully falling onto floor, include from wheelchair, chair, or bed.</rdfs:comment>
        <rdfs:label xml:lang="en">Intentional falling</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Interpersonal_factors -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Interpersonal_factors">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Causes"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Interpersonal_factors</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/InterpersonalCausativeFactor"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the communication between person with dementia and other people, which could cause agitation.</rdfs:comment>
        <rdfs:label xml:lang="en">Interpersonal factors</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Interpersonal_relationship -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Interpersonal_relationship">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Disability"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Interpersonal_relationship</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/ImpairmentInInterpersonalRelationship"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the concept that the agitation could cause the impairment in interpersonal relationships to person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Interpersonal relationships</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Interventions -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Interventions">
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Interventions</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/Intervention"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the  actions that need to be taken to improve the agitation symtoms of the person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Interventions</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Isolation -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Isolation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Mood_and_emotion"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Isolation</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the objective state of being physically separated or disconnected from others. It can occur when an individual with dementia has limited or no contact with family, friends, or the community.</rdfs:comment>
        <rdfs:label xml:lang="en">Isolation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Kinship -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Kinship">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Profile_of_caregiver"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#kinship_relation_to_the__person_with_dementia</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-11</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the social bonds and connections formed between the patient with dementia and the family carers based on their family ties, ancestry, and blood relations. It encompasses the various relationships that exist within a family.</rdfs:comment>
        <rdfs:label xml:lang="en">Kinship</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Kitchen -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Kitchen">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Places"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Kitchen</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the places if agitation occurs while staying in the kitchen.</rdfs:comment>
        <rdfs:label xml:lang="en">Kitchen</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_activity -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_activity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Environmental_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_activity</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/LackOfAppropriateEngagingActivity"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the fact that lack of appropriate engaging activities for person with dementia can cause agitation.</rdfs:comment>
        <rdfs:label xml:lang="en">Lack of activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_caring_skills -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_caring_skills">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Caregiver_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_caring_skills</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the lack of caring skills of the caregives to deal with people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Lack of caring skills</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_communication_skills -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_communication_skills">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Caregiver_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_communication_skills</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2105</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the lack  of communication skills of the caregiver who deals with people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Lack of communication skills</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_education_about_dementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_education_about_dementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Caregiver_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_education_about_dementia</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2105</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the care giver having  lack of adequate knowledge about dementia, which causes agitation to the people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Lack of education about dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_empathy -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_empathy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Mood_and_emotion"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_empathy</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to a decreased ability to comprehend, share, or respond empathetically to the emotions, feelings, and experiences of others.</rdfs:comment>
        <rdfs:label xml:lang="en">Lack of empathy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_employments -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_employments">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Mood_and_emotion"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_employments</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the employment status of the person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Lack of employments</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_established_routines -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_established_routines">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Environmental_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_established_routines</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/InappropriateRoutine"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the routine that is not suitable for the person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Lack of established routines</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_reciprocity -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_reciprocity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Poor_relationship_quality"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_reciprocity</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the lack of mutual benefitting for the person of dementia and the caregiver</rdfs:comment>
        <rdfs:label xml:lang="en">Lack of reciprocity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_resilience -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_resilience">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Low_mental_capabilities"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_resilience</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the inability to withstand or recover from difficulties with respect to the caretaking of a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Lack of resilience</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_security -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_security">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Factors_related_to_the_person_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_security</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the insecurity that the individual with dementia might feel.</rdfs:comment>
        <rdfs:label xml:lang="en">Lack of security</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Language_of_caregiver -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Language_of_caregiver">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Caregiver_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Language_of_caregiver</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">People with dementia could have faced communication problem that induces agitation if the language of the caregiver is not understandable.</rdfs:comment>
        <rdfs:label xml:lang="en">Language of caregiver</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Leisure_activities -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Leisure_activities">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lifestyle_before_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Leisure_activities</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-11</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the leisure activities of the people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Leisure activities</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Life_history -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Life_history">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Factors_related_to_the_person_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Life_history</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the life events, knowledge, and feelings that make up one&apos;s life.</rdfs:comment>
        <rdfs:label xml:lang="en">Life history</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lifestyle_before_dementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lifestyle_before_dementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Profile_of_people_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lifestyle_before_dementia</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-11</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to information about the  previous lifestyle of person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Lifestyle before dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Light_level -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Light_level">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Environmental_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Light_level</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/Light"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">NDB</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the inappropriate light which can cause agitation.</rdfs:comment>
        <rdfs:label xml:lang="en">Light level</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Limited_sensory_capabilities -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Limited_sensory_capabilities">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Factors_related_to_the_person_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Limited_sensory_capabilities</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the damaged physical senses.</rdfs:comment>
        <rdfs:label xml:lang="en">Limited sensory capabilities</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Living_room -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Living_room">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Places"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Living_room</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the places if agitation occurs while staying in the living room.</rdfs:comment>
        <rdfs:label xml:lang="en">Living room</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Living_situation -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Living_situation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Profile_of_caregiver"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Living_situation</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-11</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the living situation of the family carer such as the place and people, with which the caregiver lives.</rdfs:comment>
        <rdfs:label xml:lang="en">Living situation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Loneliness -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Loneliness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Mood_and_emotion"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Loneliness</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the subjective emotional state that arises from the perception of being alone, lacking companionship, or feeling socially disconnected.</rdfs:comment>
        <rdfs:label xml:lang="en">Loneliness</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Looking_for_distractions -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Looking_for_distractions">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Reduction_of_negative_consequences"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Looking_for_distractions</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the family carer that they should look for distraction for their well being.</rdfs:comment>
        <rdfs:label xml:lang="en">Looking for distractions</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Low_mental_capabilities -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Low_mental_capabilities">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Caregiver_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Low_mental_capabilities</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the poor mental abilities of the caregivers.</rdfs:comment>
        <rdfs:label xml:lang="en">Low mental capabilities</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Low_sense_of_competence -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Low_sense_of_competence">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Low_mental_capabilities"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Low_sense_of_competence</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the perseption of inability to adequately take care of the person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Low sense of competence</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Maintain_routines -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Maintain_routines">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Prevention"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Maintain_routines</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the action of the family carer that maintains the care routine of person with dementia according to his/her needs.</rdfs:comment>
        <rdfs:label xml:lang="en">Maintain routines</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Making_physical_sexual_advances -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Making_physical_sexual_advances">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_aggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Making_physical_sexual_advances</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the physically aggressive behavior that includes touching a person in an inappropriate sexual way, rubbing genital area, inappropriate masturbation (when not alone in own room or bathroom), unwanted fondling or kissing.</rdfs:comment>
        <rdfs:label xml:lang="en">Making physical sexual advances</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Making_verbal_sexual_advances -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Making_verbal_sexual_advances">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Verbal_aggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Making_verbal_sexual_advances</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the sexual propositions, sexual innuendo, or “dirty” talk.</rdfs:comment>
        <rdfs:label xml:lang="en">Making verbal sexual advances</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Medical_history -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Medical_history">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Health_/_illness"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Medical_history</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-07-11</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">SinDeM ontology</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the long term intrinsic factor describing the medical history of the people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Medical history</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Medication -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Medication">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Profile_of_people_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Medication</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-11</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the information about the medication, taken by person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Medication</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Medication_side_effects -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Medication_side_effects">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Factors_related_to_the_person_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Medication_side_effects</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/MedicationEffect"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to any unwanted or unexpected effects of a medicine.</rdfs:comment>
        <rdfs:label xml:lang="en">Medication side effects</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Meeting_basic_needs -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Meeting_basic_needs">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Prevention"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Meeting_basic_needs</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the action of the family carer that aims  to identify the fundamental needs of the person with dementia and ensure they are being met.</rdfs:comment>
        <rdfs:label xml:lang="en">Meeting basic needs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Memories -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Memories">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Factors_related_to_the_person_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Memories</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the fact that getting back to past memories of the individuals with dementia can cause agitation.</rdfs:comment>
        <rdfs:label xml:lang="en">Memories</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Minutes -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Minutes">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Duration"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Minutes</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the length during when agitation continues for a few minutes.</rdfs:comment>
        <rdfs:label xml:lang="en">Minutes</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Mismatch_of_expectations_and_dementia_severity -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Mismatch_of_expectations_and_dementia_severity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Caregiver_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Mismatch_of_expectations_and_dementia_severity</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the difference between the expectations of the caregiver and the reality of taking care of a person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Mismatch of expectations and dementia severity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Mobility_impairment -->

