        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the damaged ability to move physically.</rdfs:comment>
        <rdfs:label xml:lang="en">Mobility impairmemt</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Mood_and_emotion -->

