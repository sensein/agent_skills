    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Accept_the_perspective_of_the_PwD -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Accept_the_perspective_of_the_PwD">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#De-escalation"/>
        <untitled-ontology-20:ID>http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Accept_the_perspective_of_the_PwD</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source>Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It referes to action of the family carer that is to accept the perspective of people with dementia (PwD).</rdfs:comment>
        <rdfs:label xml:lang="en">Accept the perspective of the PwD</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Acceptance -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Acceptance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Interventions"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Acceptance</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">Family-caregiver should accept and understand the symptoms of agitation of the person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Acceptance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Acute_medical_illness -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Acute_medical_illness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Factors_related_to_the_person_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Acute_medical_illness</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/MedicalIllness"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the disease which can cause agitation in dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Acute medical illness</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Age -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Age">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Profile_of_caregiver"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Age</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the age of the family carer.</rdfs:comment>
        <rdfs:label xml:lang="en">Age</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Age_of_the_people_with_dementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Age_of_the_people_with_dementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Profile_of_people_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Age_of_the_people_with_dementia</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-11</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the age of people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Age of the people with dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Agitation -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Agitation">
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Agitation</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/AgitationInDementia"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the agitated behavior of the people with dementia. The behavior has been persistent or frequently recurrent for a minimum of two weeks’ and represents a change from the patient’s usual behavior. Behaviors are severe enough to produce excess disability, which in the clinician’s opinion is beyond that due to the cognitive impairment and including at least one of the following:
1. Significant impairment in interpersonal relationships. 
2. Significant impairment in other aspects of social functioning. 
3. Significant impairment in ability to perform or participate in daily living activities.</rdfs:comment>
        <rdfs:label xml:lang="en">Agitation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Aimless_wandering -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Aimless_wandering">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_nonaggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Aimless_wandering</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/Wandering"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to centain type of physical non-aggressive behaviour that includes walking aimlessly from place to place.</rdfs:comment>
        <rdfs:label xml:lang="en">Aimless wandering</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Anger -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Anger">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Strong_emotion"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Anger</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/Anger"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Alexopoulos et al. 2007</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to a strong feeling of annoyance, displeasure or hostility.</rdfs:comment>
        <rdfs:label xml:lang="en">Anger</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Anorexia_weight_loss -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Anorexia_weight_loss">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Consequences"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Anorexia_weight_loss</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Kales et at. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the concept that the agitation could lead to lack of appetite which causes food and weight loss.</rdfs:comment>
        <rdfs:label xml:lang="en">Anorexia weight loss</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Anticipate -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Anticipate">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#De-escalation"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Anticipate</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">The family carer should anticipate the agitated bahavior of the person with dementia and the degree of severity of their aggression.</rdfs:comment>
        <rdfs:label xml:lang="en">Anticipate</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Anxiety -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Anxiety">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Mood_and_emotion"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Anxiety</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-11</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the feeling of being anxious or scared.</rdfs:comment>
        <rdfs:label xml:lang="en">Anxiety</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#At_night -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#At_night">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Duration"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#At_night</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the time period if agitation continues at night.</rdfs:comment>
        <rdfs:label xml:lang="en">At night</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Attendees -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Attendees">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Topography"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Attendees</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the attendees who are with the people with dementia when agitation occurs.</rdfs:comment>
        <rdfs:label xml:lang="en">Attendees</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Attic -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Attic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Places"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Attic</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the places if agitation occurs while staying in the attic.</rdfs:comment>
        <rdfs:label xml:lang="en">Attic</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Awareness_of_own_deficits -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Awareness_of_own_deficits">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Factors_related_to_the_person_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Awareness_of_own_deficits</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the perception of the person with dementia that he/she had lost abilities and skills.</rdfs:comment>
        <rdfs:label xml:lang="en">Awareness of own deficits</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Bad_health_status -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Bad_health_status">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Caregiver_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Bad_health_status</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the poor health status of the caregivers.</rdfs:comment>
        <rdfs:label xml:lang="en">Bad health status</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Basement -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Basement">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Places"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Basement</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the places if agitation occurs while staying in the basement.</rdfs:comment>
        <rdfs:label xml:lang="en">Basement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Bathroom -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Bathroom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Places"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Bathroom</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the places if agitation occurs while staying in the bathroom.</rdfs:comment>
        <rdfs:label xml:lang="en">Bathroom</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Bedroom -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Bedroom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Places"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Bedroom</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the places if agitation occurs while staying in the bedroom.</rdfs:comment>
        <rdfs:label xml:lang="en">Bedroom</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Biographical_experiences -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Biographical_experiences">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Factors_related_to_the_person_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Biographical_experiences</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to memories and events from the individual&apos;s personal history that can lead to agitation.</rdfs:comment>
        <rdfs:label xml:lang="en">Biographical experiences</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Biting -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Biting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Physical_aggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Biting</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/Biting"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the physically aggressive behavior that includes chomping, gnashing, gnawing, either other people or self.</rdfs:comment>
        <rdfs:label xml:lang="en">Biting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Boredom -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Boredom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lack_of_employments"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Boredom</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the state of feeling bored as a result of being unproductive.</rdfs:comment>
        <rdfs:label xml:lang="en">Boredom</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Burden -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Burden">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Caregiver_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Burden</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Kales et al. 2105</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the fact that caregivers with mental and financial burdens may inadvertently transmit their stress and negative emotions to the person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Burden</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Caregiver -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Caregiver">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Person"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Caregiver</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-07-17</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to all people involved in taking care people with dementia in the long term care facilities.</rdfs:comment>
        <rdfs:label xml:lang="en">Caregiver</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Caregiver_factors -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Caregiver_factors">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Interpersonal_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Caregiver_factors</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the caregiver factiors that can induce agitation on the people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Caregiver factors</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Caregiver_frustration -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Caregiver_frustration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Caregiver_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Caregiver_frustration</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the fact that caregiver&apos;s frustration might induce agitation to the people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Caregiver frustration</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Causes -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Causes">
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Causes</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/AgitationCausativeFactor"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-16</untitled-ontology-20:created_on>
        <untitled-ontology-20:source>NDB</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the resasons, which trigger agitated behavior in the people with dementia/suspected with dementia. For instance, isolated location, lack of communication with the family-carers.</rdfs:comment>
        <rdfs:label xml:lang="en">Causes</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Change_in_routines -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Change_in_routines">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Environmental_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Change_in_routines</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/ChangeInRoutine"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">(Lawlor BA &amp; Sunderland T 1994)</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to changes in the routine that can cause agitation.</rdfs:comment>
        <rdfs:label xml:lang="en">Change in routines</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Communication -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Communication">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Prevention"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Communication</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the training provided to family caregivers about how to communicate with a person who has dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Communication</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Complaining -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Complaining">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Verbal_nonagressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Complaining</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/Complaining"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the verbal non-aggressive behaviour that includes whining, complaining about self, somatic complaints, personal gripes or complaining about physical environment or other people.</rdfs:comment>
        <rdfs:label xml:lang="en">Complaining</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Conflict -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Conflict">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Poor_relationship_quality"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Conflict</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the communication that tends to create unnecessary conflict, such as arguing with the person with dementia</rdfs:comment>
        <rdfs:label xml:lang="en">Conflict</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Consequences -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Consequences">
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Consequences</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Kong 2005, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the consequences that  people with dementa might face because of being agitated ( for example: agitated behavior could lead to early placement in a nursing home).</rdfs:comment>
        <rdfs:label xml:lang="en">Consequences</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Continuous -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Continuous">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Duration"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Continuous</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the length during when agitation occurs continuously.</rdfs:comment>
        <rdfs:label xml:lang="en">Continuous</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Coping_with_stress -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Coping_with_stress">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lifestyle_before_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Coping_with_stress</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-11</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the typical manner of confronting a stressful situation and dealing with it.</rdfs:comment>
        <rdfs:label xml:lang="en">Coping with stress</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Critical_life_event -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Critical_life_event">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Lifestyle_before_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Critical_life_event</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-11</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the critical life event of the people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Critical life event</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Cursing -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Cursing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Verbal_aggressive"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Cursing</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/Cursing"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Cohen-Mansfield, 1997</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the type of  verbal aggressive behaviour such as using words; swearing, use of obscenity, profanity, unkind speech or criticism, verbal anger, verbal combativeness.</rdfs:comment>
        <rdfs:label xml:lang="en">Cursing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Daily -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Daily">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Frequency"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Daily</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the rate at which agitation occurs daily.</rdfs:comment>
        <rdfs:label xml:lang="en">Daily</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#De-escalation -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#De-escalation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Interventions"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#De-escalation</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the actions taken by the family carers which reduce the intensity of a conflict or potentially violent situation.</rdfs:comment>
        <rdfs:label xml:lang="en">De-escalation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Decreased_quality_of_life -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Decreased_quality_of_life">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Consequences"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Decreased_quality_of_life</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/PoorQualityOfLife"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the concept that the agitation has an effect on the individual&apos;s wellbeing and the ability to enjoy life. Thefore, it decreases the quality of individual&apos;s life.</rdfs:comment>
        <rdfs:label xml:lang="en">Decreased quality of life</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Dehydration -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Dehydration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Consequences"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Dehydration</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the concept that the agitation could cause suffering from dehydration to the person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Dehydration</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Denial -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Denial">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Caregiver_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Denial</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">Person with dementia may refuse to do something. Health care professionals should be able to accept that.</rdfs:comment>
        <rdfs:label xml:lang="en">Denial</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Depression -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Depression">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Caregiver_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Depression</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/Depression"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Kales et al. 2105</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">Caregivers who are suffering with depression may inadvertently transmit their stress and negative emotions to the person with dementia</rdfs:comment>
        <rdfs:label xml:lang="en">Depression</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Diagnostics -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Diagnostics">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Environmental_factors"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Diagnostics</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the diagnostic procedures that can be stressful or confusing for people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Diagnostics</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Dining_room -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Dining_room">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Places"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Dining_room</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the places if agitation occurs while staying in the dining room.</rdfs:comment>
        <rdfs:label xml:lang="en">Dining room</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Disability -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Disability">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Consequences"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Disability</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to the concept that the agitation could cause to bring disability to person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Disability</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Distract -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Distract">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#De-escalation"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Distract</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the intervention taken by the family carer which is to distract the person with dementia from problematic situations to another task, such as, to offer a snack or put on some familiar music to interrupt behaviours that are becoming difficult.</rdfs:comment>
        <rdfs:label xml:lang="en">Distract</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Do_not_get_upset -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Do_not_get_upset">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#De-escalation"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Do_not_get_upset</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">The family cares should not get upset from the person with dementia because of the agitated behavior of the person with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Do not get upset</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Dressing -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Dressing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Situation"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Dressing</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the process of putting on cloths.</rdfs:comment>
        <rdfs:label xml:lang="en">Dressing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Duration -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Duration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Topography"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Duration</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/DurationOfAgitation"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the time during which agitation continues.</rdfs:comment>
        <rdfs:label xml:lang="en">Duration</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#During_the_day -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#During_the_day">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Duration"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#During_the_day</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the time period if agitation continues during the day.</rdfs:comment>
        <rdfs:label xml:lang="en">During the day</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Environmental_design -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Environmental_design">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Prevention"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Environmental_design</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the action taken by the family carer which is to modify environment designs of the people with dementia. For example: reducing the the background noise.</rdfs:comment>
        <rdfs:label xml:lang="en">Environmental design</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Environmental_factors -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Environmental_factors">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Causes"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Environmental_factors</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/EnvironmentalCausativeFactor"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the environmental factors that can cause agitation.</rdfs:comment>
        <rdfs:label xml:lang="en">Environmental factors</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Factors_related_to_the_person_with_dementia -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Factors_related_to_the_person_with_dementia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Causes"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Factors_related_to_the_person_with_dementia</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/IntrapersonalCausativeFactor"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the things that can cause agitation exclusively related to himself/herself.</rdfs:comment>
        <rdfs:label xml:lang="en">Factors related to the person with dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Failed_attempt_to_do_something_meaningful -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Failed_attempt_to_do_something_meaningful">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Factors_related_to_the_person_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Failed_attempt_to_do_something_meaningful</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the failed attempt to do something. This could cause agitation.</rdfs:comment>
        <rdfs:label xml:lang="en">Failed attempt to do something meaningful</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Family_carer -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Family_carer">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Caregiver"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Family_carer</untitled-ontology-20:ID>
        <untitled-ontology-20:abbreviation xml:lang="en">FC</untitled-ontology-20:abbreviation>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/FamilyMemberOfPersonWithDementia"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Ward-Griffin et al. 2007</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the family-caregiver who takes care of the person suspected/diagnosed with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Family carer</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Fatigue -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Fatigue">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Mood_and_emotion"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Fatigue</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the state of physical and mental exhaustion that occurs as a result of the cognitive impairments and other challenges associated with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Fatigue</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Fear -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Fear">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Factors_related_to_the_person_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Fear</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the feeling of anxiety concerning the outcome of something or the safety of someone.</rdfs:comment>
        <rdfs:label xml:lang="en">Fear</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Feeling_undermined -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Feeling_undermined">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Factors_related_to_the_person_with_dementia"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Feeling_undermined</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to a sense of being devalued, disrespected, or disregarded, which can contribute to agitation.</rdfs:comment>
        <rdfs:label xml:lang="en">Feeling undermined</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Food_intake -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Food_intake">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Situation"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Food_intake</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-15</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the process of feeding.</rdfs:comment>
        <rdfs:label xml:lang="en">Food intake</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Frequency -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Frequency">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Topography"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Frequency</untitled-ontology-20:ID>
        <untitled-ontology-20:class_mapping rdf:resource="http://www.semanticweb.org/zhenyuzhang/ontologies/2019/8/nonpharmacological-intervention-for-agitation-in-dementia-ontology/FrequencyOfAgitation"/>
