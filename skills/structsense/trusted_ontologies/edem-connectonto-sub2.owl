    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#occurs_in -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#occurs_in">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Agitation"/>
