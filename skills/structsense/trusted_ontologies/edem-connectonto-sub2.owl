        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Screening_for_physical/medical_causes</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <untitled-ontology-20:source xml:lang="en">Marque Study (Laybourne, Anne (2019))</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to the actions of the family carer  which is to screen and monitor the physical/medical causes of being agitated for the people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Screening for physical/medical causes</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Self_care:_taking_time_for_yourself -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Self_care:_taking_time_for_yourself">
