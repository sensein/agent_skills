        <untitled-ontology-20:source xml:lang="en">DICE, Kales et al. 2015</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to rapid change in mood.</rdfs:comment>
        <rdfs:label xml:lang="en">Mood swings</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Motivation_to_take_care_out_of_financial_reasons -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Motivation_to_take_care_out_of_financial_reasons">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Poor_relationship_quality"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Motivation_to_take_care_out_of_financial_reasons</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to negegative coative commitment of the caregiver as they take care of the person with dementia because of finacial reasons</rdfs:comment>
        <rdfs:label xml:lang="en">Motivation to take care out of financial reasons</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Motivation_to_take_over_care_out_of_obligation -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Motivation_to_take_over_care_out_of_obligation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Poor_relationship_quality"/>
        <untitled-ontology-20:ID rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Motivation_to_take_over_care_out_of_obligation</untitled-ontology-20:ID>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya Suravee</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-23</untitled-ontology-20:created_on>
        <rdfs:comment xml:lang="en">It refers to negative commitment of the caregiver as they are forced to take care of the person with dementia out of obligation</rdfs:comment>
        <rdfs:label xml:lang="en">Motivation to take over care out of obligations</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Needs_help_going_to_the_toilet -->

