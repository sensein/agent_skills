        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It refers to emotional condition of the people with dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Mood and emotion</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Mood_swings -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Mood_swings">
