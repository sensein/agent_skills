        <untitled-ontology-20:source xml:lang="en">Innovative dementia-orientated Assessment system (IdA), 2017</untitled-ontology-20:source>
        <rdfs:comment xml:lang="en">It represents the individual&apos;s capacity and assistance needed to maintain a level of hygiene despite the impairments caused by dementia.</rdfs:comment>
        <rdfs:label xml:lang="en">Needs help with hygiene</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Needs_help_with_movement -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#Needs_help_with_movement">
