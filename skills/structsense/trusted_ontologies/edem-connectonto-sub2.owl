    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#hasSynonym -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#hasSynonym">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <rdfs:label xml:lang="en">hasSynonym</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#hasTranslation -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sumaiyasuravee/ontologies/2023/5/untitled-ontology-20#hasTranslation">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <untitled-ontology-20:created_by xml:lang="en">Sumaiya</untitled-ontology-20:created_by>
        <untitled-ontology-20:created_on rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-17</untitled-ontology-20:created_on>
        <rdfs:comment>English concepts are having german translation as instance with the Data property as &quot;hasTranslation&quot;.</rdfs:comment>
        <rdfs:label xml:lang="en">hasTranslation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
