    <!-- http://purl.obolibrary.org/obo/UBERON_0002916 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002916">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0013118"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002176"/>
