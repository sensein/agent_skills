        <oboInOwl:hasDbXref>MA:0000200</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:1073</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C32726</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:362411002</oboInOwl:hasDbXref>
