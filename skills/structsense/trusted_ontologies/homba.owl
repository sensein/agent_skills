        <oboInOwl:hasDbXref>BAMS:AHY</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BAMS:AL</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BAMS:APit</oboInOwl:hasDbXref>
