        <oboInOwl:hasDbXref>ZFA:0001136</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>hypoderm</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vertebrate hypodermis</oboInOwl:hasExactSynonym>
        <rdfs:label>hypodermis</rdfs:label>
        <skos:prefLabel>hypodermis</skos:prefLabel>
    </owl:Class>
