        <oboInOwl:hasDbXref>Wikipedia:Viscus</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0003034</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>visceral organ</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>visceral organ system</oboInOwl:hasExactSynonym>
        <rdfs:label>viscus</rdfs:label>
