        <oboInOwl:hasDbXref>HBA:4523</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000832</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:483</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Habenular_nuclei</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>medial habenula</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>nucleus habenulae medialis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>nucleus habenularis medialis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>nucleus habenularis medialis (Hassler)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>nucleus habenularis medialis epithalami</oboInOwl:hasExactSynonym>
        <rdfs:label>medial habenular nucleus</rdfs:label>
        <skos:prefLabel>medial habenular nucleus</skos:prefLabel>
    </owl:Class>
