    <!-- http://purl.obolibrary.org/obo/UBERON_0034734 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0034734">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0013199"/>
        <obo:IAO_0000115>The medial olfactory stria turns medialward behind the parolfactory area and ends in the subcallosal gyrus; in some cases a small intermediate stria is seen running backward to the anterior perforated substance.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>DHBA:12076</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DMBA:17779</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:77627</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:265505518</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:369105009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Medial_olfactory_stria</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:2278</oboInOwl:hasDbXref>
        <rdfs:label>medial olfactory stria</rdfs:label>
        <skos:prefLabel>medial olfactory stria</skos:prefLabel>
    </owl:Class>
