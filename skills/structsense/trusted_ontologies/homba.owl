    <!-- http://purl.obolibrary.org/obo/UBERON_0006087 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0006087">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000122"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011215"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0014649"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Internal arcuate fibers are the axons of second-order neurons contained within the gracile and cuneate nuclei of the medulla oblongata. These fibers cross from one side of the medulla to the other to form the medial lemniscus. Part of the dorsal column-medial lemniscus system (second neuron), the internal arcuate fibers are important for relaying the sensation of fine touch and proprioception to the thalamus and ultimately to the cerebral cortex.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BAMS:ia</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BAMS:iaf</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BIRNLEX:1091</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DHBA:12756</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:72629</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:265505610</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:396</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Internal_arcuate_fibers</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>arcuate fibers medial lemniscus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>internal arcuate fibers</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>internal arcuate fibres</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>internal arcuate tract</oboInOwl:hasExactSynonym>
        <rdfs:label>internal arcuate fiber bundle</rdfs:label>
        <skos:prefLabel>internal arcuate fiber bundle</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006087"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Internal arcuate fibers are the axons of second-order neurons contained within the gracile and cuneate nuclei of the medulla oblongata. These fibers cross from one side of the medulla to the other to form the medial lemniscus. Part of the dorsal column-medial lemniscus system (second neuron), the internal arcuate fibers are important for relaying the sensation of fine touch and proprioception to the thalamus and ultimately to the cerebral cortex.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Internal_arcuate_fibers</oboInOwl:hasDbXref>
    </owl:Axiom>
