    <!-- http://purl.obolibrary.org/obo/UBERON_0022424 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0022424">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006331"/>
