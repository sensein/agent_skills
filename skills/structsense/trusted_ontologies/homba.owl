        <oboInOwl:hasDbXref>Wikipedia:Parasympathetic_nervous_system</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0001575</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>PNS - parasympathetic</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>parasympathetic part of autonomic division of nervous system</oboInOwl:hasExactSynonym>
