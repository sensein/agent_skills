    <!-- http://purl.obolibrary.org/obo/UBERON_0000432 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000432">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0015234"/>
        <rdfs:subClassOf>
