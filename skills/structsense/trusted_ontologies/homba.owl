        <oboInOwl:hasDbXref>HBA:9145</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:881</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Lateral_parabrachial_nucleus</oboInOwl:hasDbXref>
