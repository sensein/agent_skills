        <oboInOwl:hasDbXref>MA:0000853</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:557</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:369122006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Tuberomammillary_nucleus</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>caudal magnocellular nucleus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mammilloinfundibular nucleus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mammiloinfundibular nucleus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tuberomammillary hypothalamic nucleus</oboInOwl:hasExactSynonym>
