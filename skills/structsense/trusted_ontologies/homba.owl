    <!-- http://purl.obolibrary.org/obo/UBERON_0034754 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0034754">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0022248"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011299"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0022247"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The occipitofrontal fasciculus passes backward from the frontal lobe, along the lateral border of the caudate nucleus, and on the medial aspect of the corona radiata; its fibers radiate in a fan-like manner and pass into the occipital and temporal lobes lateral to the posterior and inferior cornua.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>DHBA:10588</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:9269</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Occipitofrontal_fasciculus</oboInOwl:hasDbXref>
        <rdfs:label>occipitofrontal fasciculus</rdfs:label>
        <skos:prefLabel>occipitofrontal fasciculus</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0034754"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The occipitofrontal fasciculus passes backward from the frontal lobe, along the lateral border of the caudate nucleus, and on the medial aspect of the corona radiata; its fibers radiate in a fan-like manner and pass into the occipital and temporal lobes lateral to the posterior and inferior cornua.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Occipitofrontal_fasciculus</oboInOwl:hasDbXref>
    </owl:Axiom>
    


