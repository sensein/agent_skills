        <oboInOwl:hasDbXref>HBA:9360</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C33222</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:314143008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Orbital_sulcus</oboInOwl:hasDbXref>
