        <oboInOwl:hasDbXref>GAID:651</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:4665</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D007034</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Mammillary_process</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>mammillary level of hypothalamus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mammillary region</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>posterior hypothalamus</oboInOwl:hasExactSynonym>
        <rdfs:label>posterior hypothalamic region</rdfs:label>
        <skos:prefLabel>posterior hypothalamic region</skos:prefLabel>
    </owl:Class>
