        <oboInOwl:hasDbXref>neuronames:1214</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cerebellar hemisphere</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cerebellum hemisphere</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>hemisphere of cerebellum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>hemisphere of cerebellum [H II - H X]</oboInOwl:hasExactSynonym>
        <rdfs:label>cerebellar hemisphere</rdfs:label>
        <skos:prefLabel>cerebellar hemisphere</skos:prefLabel>
    </owl:Class>
