    <!-- http://purl.obolibrary.org/obo/UBERON_0034773 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0034773">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002616"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002973"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The anterior extremity of the Parahippocampal gyrus is recurved in the form of a hook, the uncus, which is separated from the apex of the temporal lobe by a slight fissure, the incisura temporalis. Although superficially continuous with the hippocampal gyrus, the uncus forms morphologically a part of the rhinencephalon. The term uncus was coined by Felix Vicq dbAzyr (1748b1794).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>DHBA:12165</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:74884</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C33831</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:279213004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Uncus</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:40</oboInOwl:hasDbXref>
        <rdfs:label>uncus of parahippocampal gyrus</rdfs:label>
        <skos:prefLabel>uncus of parahippocampal gyrus</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0034773"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The anterior extremity of the Parahippocampal gyrus is recurved in the form of a hook, the uncus, which is separated from the apex of the temporal lobe by a slight fissure, the incisura temporalis. Although superficially continuous with the hippocampal gyrus, the uncus forms morphologically a part of the rhinencephalon. The term uncus was coined by Felix Vicq dbAzyr (1748b1794).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Uncus</oboInOwl:hasDbXref>
    </owl:Axiom>
    


