    <!-- http://purl.obolibrary.org/obo/UBERON_0004545 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004545">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002437"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002437"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any of the series of white matter fiber tracts in the brain that run between the most lateral segment of the lentiform nucleus and the claustrum; the white matter of the external capsule contains fibers known as corticocortical association fibers which are responsible for connecting the cerebral cortex to another cortical area; the capsule appears as a thin white sheet of white matter and provides a route for cholinergic fibers from the basal forebrain to the cerebral cortex; it eventually joins the internal capsule around the lentiform nucleus.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BAMS:EC</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BAMS:ec</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DHBA:10573</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DMBA:17765</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:35331</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:61959</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:9243</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0002896</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:579</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C32550</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NLXANAT:1010013</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:279300007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:External_capsule</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:253</oboInOwl:hasDbXref>
        <rdfs:label>external capsule of telencephalon</rdfs:label>
        <skos:prefLabel>external capsule of telencephalon</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004545"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any of the series of white matter fiber tracts in the brain that run between the most lateral segment of the lentiform nucleus and the claustrum; the white matter of the external capsule contains fibers known as corticocortical association fibers which are responsible for connecting the cerebral cortex to another cortical area; the capsule appears as a thin white sheet of white matter and provides a route for cholinergic fibers from the basal forebrain to the cerebral cortex; it eventually joins the internal capsule around the lentiform nucleus.</owl:annotatedTarget>
