    <!-- http://purl.obolibrary.org/obo/UBERON_0002884 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002884">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009663"/>
