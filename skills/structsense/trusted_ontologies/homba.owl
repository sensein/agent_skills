    <!-- http://purl.obolibrary.org/obo/UBERON_0022256 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0022256">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005838"/>
