    <!-- http://purl.obolibrary.org/obo/UBERON_0001699 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001699">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004674"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
