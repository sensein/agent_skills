                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://purl.brain-bican.org/ontology/HOMBA_10610"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000956"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002176"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001870"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002176"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001872"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The central sulcus is a fold in the cerebral cortex of brains in vertebrates. Also called the central fissure, it was originally called the fissure of Rolando or the Rolandic fissure, after Luigi Rolando. The central sulcus is a prominent landmark of the brain, separating the parietal lobe from the frontal lobe and the primary motor cortex from the primary somatosensory cortex. [WP,unvetted].</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BAMS:cs</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BIRNLEX:4035</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BM:Tel-Cx-CS</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DHBA:10614</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:83752</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:9403</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C32280</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:279340001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Central_sulcus</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>central cerebral sulcus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>central fissure</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>central sulcus of Rolando</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>fissure of Rolando</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>rolandic fissure</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sulcus centralis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sulcus centralis (rolandi)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sulcus of Rolando</oboInOwl:hasExactSynonym>
        <rdfs:label>central sulcus</rdfs:label>
        <skos:prefLabel>central sulcus</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002916"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The central sulcus is a fold in the cerebral cortex of brains in vertebrates. Also called the central fissure, it was originally called the fissure of Rolando or the Rolandic fissure, after Luigi Rolando. The central sulcus is a prominent landmark of the brain, separating the parietal lobe from the frontal lobe and the primary motor cortex from the primary somatosensory cortex. [WP,unvetted].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Central_sulcus</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002916"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>central cerebral sulcus</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FMA:83752</oboInOwl:hasDbXref>
    </owl:Axiom>
