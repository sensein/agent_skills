            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002202"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003051"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>One of three half-circular, interconnected tubes located inside each ear[WP].</obo:IAO_0000115>
        <oboInOwl:hasDbXref>AAO:0011098</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BTO:0003383</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CALOHA:TS-2164</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:32832</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EV:0100365</oboInOwl:hasDbXref>
