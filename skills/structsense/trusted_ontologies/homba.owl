        <oboInOwl:hasDbXref>FMA:313607</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:361412007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000380</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Buccopharyngeal_membrane</oboInOwl:hasDbXref>
        <rdfs:label>buccopharyngeal membrane</rdfs:label>
        <skos:prefLabel>buccopharyngeal membrane</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006211"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The thin bilaminar membrane derived from the prechordal plate that is devoid of mesoderm and formed by the apposition of the stomodeal ectoderm with the foregut endoderm; after the embryonic head fold has evolved it lies at the caudal limit of the stomodeum, forming a septum between the primitive mouth and pharynx; the membrane eventually disappears, and thus a communication is established between the mouth and the future pharynx.</owl:annotatedTarget>
