        <oboInOwl:hasDbXref>FMA:62165</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C32284</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:279162007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Centromedian_nucleus</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>central magnocellular nucleus of thalamus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>central nucleus-1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>centre median nucleus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>centromedian nucleus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>centromedian nucleus of thalamus</oboInOwl:hasExactSynonym>
