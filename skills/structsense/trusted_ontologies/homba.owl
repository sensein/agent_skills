        <oboInOwl:hasDbXref>RETIRED_EHDAA2:0001487</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:181314001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0005001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Posterior_communicating_artery</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0005001</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>caudal communicating segment</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>posterior communicating segment of the basilar artery</oboInOwl:hasExactSynonym>
        <rdfs:label>posterior communicating artery</rdfs:label>
        <skos:prefLabel>posterior communicating artery</skos:prefLabel>
    </owl:Class>
