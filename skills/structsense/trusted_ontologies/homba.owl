        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>cerebral arterial circle</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GAID:486</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0003711 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003711">
