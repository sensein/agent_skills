        <oboInOwl:hasDbXref>GO:0040016</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Cleavage_(embryo)</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0000108 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000108">
