                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009122"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A pouch of ectoderm that grows out from the upper surface of the embryonic stomodeum and gives rise to the anterior and intermediate lobes of the pituitary gland[MP]. In embryogenesis, Rathke&apos;s pouch is a depression in the roof of the developing mouth in front of the buccopharyngeal membrane. It gives rise to the anterior pituitary (adenohypophysis), a part of the endocrine system[WP].</obo:IAO_0000115>
        <oboInOwl:hasDbXref>AAO:0011094</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EHDAA2:0001588</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:16725</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:302929</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C34281</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C54098</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:362583008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:61127000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000674</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Rathke&apos;s_pouch</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000430</oboInOwl:hasDbXref>
