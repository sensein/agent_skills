        <oboInOwl:hasDbXref>TAO:0000320</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Posterior_commissure</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000320</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>caudal commissure</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>epithalamic commissure</oboInOwl:hasExactSynonym>
        <rdfs:label>posterior commissure</rdfs:label>
        <skos:prefLabel>posterior commissure</skos:prefLabel>
    </owl:Class>
