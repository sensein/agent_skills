        <oboInOwl:hasDbXref>DMBA:17805</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:72642</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:866</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:369285001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Ventral_spinocerebellar_tract</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Gower&apos;s tract</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Gowers&apos; tract</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ventral spinocerebellar tract</oboInOwl:hasExactSynonym>
        <rdfs:label>anterior spinocerebellar tract</rdfs:label>
        <skos:prefLabel>anterior spinocerebellar tract</skos:prefLabel>
    </owl:Class>
