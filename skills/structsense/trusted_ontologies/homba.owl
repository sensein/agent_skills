        <oboInOwl:hasDbXref>MBA:153</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:369283008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Lateral_recess</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:642</oboInOwl:hasDbXref>
        <rdfs:label>lateral recess of fourth ventricle</rdfs:label>
        <skos:prefLabel>lateral recess of fourth ventricle</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007656"/>
