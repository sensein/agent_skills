            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The dilated structure that is lined by endothelial cells and located at the arterial pole of the heart just above (distal to) the truncus arteriosus in mammalian embryos; it is the primordial vascular channel from which the aortic arches (and eventually the dorsal aortae) arise; the aortic sac is homologous to the ventral aorta of gill-bearing vertebrates.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EHDAA2:0004145</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EHDAA:9826</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:36461</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:71008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>RETIRED_EHDAA2:0000133</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:361527005</oboInOwl:hasDbXref>
        <rdfs:label>aortic sac</rdfs:label>
        <skos:prefLabel>aortic sac</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005432"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The dilated structure that is lined by endothelial cells and located at the arterial pole of the heart just above (distal to) the truncus arteriosus in mammalian embryos; it is the primordial vascular channel from which the aortic arches (and eventually the dorsal aortae) arise; the aortic sac is homologous to the ventral aorta of gill-bearing vertebrates.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MP:0012510</oboInOwl:hasDbXref>
    </owl:Axiom>
    


