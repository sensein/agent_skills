        <oboInOwl:hasDbXref>VHOG:0001129</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Lateral_rectus_muscle</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000383</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>M. rectus lateralis</oboInOwl:hasExactSynonym>
