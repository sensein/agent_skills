        <oboInOwl:hasExactSynonym>Rathke pouch</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pouch of Rathke</oboInOwl:hasExactSynonym>
        <rdfs:label>Rathke&apos;s pouch</rdfs:label>
        <skos:prefLabel>Rathke&apos;s pouch</skos:prefLabel>
