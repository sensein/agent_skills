    <!-- http://purl.obolibrary.org/obo/UBERON_0002142 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002142">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007415"/>
        <obo:IAO_0000115>The pedunculopontine nucleus (PPN) (or pedunculopontine tegmental nucleus, PPTN) is located in the brainstem, caudal to the substantia nigra and adjacent to the superior cerebellar peduncle. It is composed by a wide variety of neurochemical cell types, including cholinergic, glutamatergic and GABAergic cells. In the classical sense, the PPN is considered to be one of the main components of the reticular activating system. [WP,unvetted].</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BAMS:PPN</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BAMS:PPTg</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BIRNLEX:1437</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BM:Pons-PPT</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DHBA:12413</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DMBA:16965</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:35672</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:72429</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:9021</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0001020</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:1052</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Pedunculopontine_tegmental_nucleus</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>peduncular pontine nucleus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pedunculopontine nucleus</oboInOwl:hasExactSynonym>
        <rdfs:label>pedunculopontine tegmental nucleus</rdfs:label>
        <skos:prefLabel>pedunculopontine tegmental nucleus</skos:prefLabel>
