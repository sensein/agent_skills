        <oboInOwl:hasDbXref>NCIT:C32793</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:279346007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Inferior_temporal_sulcus</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>inferior temporal sulcus-1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>middle temporal sulcus (szikla)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>second temporal sulcus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sulcus t2</oboInOwl:hasExactSynonym>
