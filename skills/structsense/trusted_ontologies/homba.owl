    <!-- http://purl.obolibrary.org/obo/UBERON_0005287 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005287">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0005283"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
