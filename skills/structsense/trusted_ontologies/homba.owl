        <oboInOwl:hasDbXref>OGES:000015</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>OGES:000020</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PdumDv:0000200</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Cleavage_(embryo)</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:1000004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFS:0000046</oboInOwl:hasDbXref>
        <rdfs:label>cleavage stage</rdfs:label>
        <skos:prefLabel>cleavage stage</skos:prefLabel>
    </owl:Class>
