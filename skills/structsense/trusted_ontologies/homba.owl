        <oboInOwl:hasDbXref>FMA:75700</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:83851</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:265505650</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:794</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:1589</oboInOwl:hasDbXref>
        <rdfs:label>spinal trigeminal tract</rdfs:label>
        <skos:prefLabel>spinal trigeminal tract</skos:prefLabel>
