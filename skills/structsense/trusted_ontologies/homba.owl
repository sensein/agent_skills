    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005356"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A pouch of ectoderm that grows out from the upper surface of the embryonic stomodeum and gives rise to the anterior and intermediate lobes of the pituitary gland[MP]. In embryogenesis, Rathke&apos;s pouch is a depression in the roof of the developing mouth in front of the buccopharyngeal membrane. It gives rise to the anterior pituitary (adenohypophysis), a part of the endocrine system[WP].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MP:0003817</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Rathke&apos;s_pouch</oboInOwl:hasDbXref>
    </owl:Axiom>
    


