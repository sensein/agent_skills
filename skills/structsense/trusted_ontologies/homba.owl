        <oboInOwl:hasExactSynonym>reticular nucleus of the thalamus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>reticular nucleus-2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>reticular thalamic nucleus</oboInOwl:hasExactSynonym>
