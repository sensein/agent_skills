        <oboInOwl:hasDbXref>EMAPA:17802</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:53431</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:723</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0001110</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:948</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D003056</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C12697</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:280286001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001182</oboInOwl:hasDbXref>
