    <!-- http://purl.obolibrary.org/obo/UBERON_0008933 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0008933">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008930"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0016530"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>(Chapin &amp; Lin, 1984, rat): the region considered as the SI cortex is not a cytoarchitecturally homogeneous structure but consists instead of a patchwork array of areas containing dense aggregations of layer IV granule cells, surrounded by granule-cell-sparse regions. As was shown by Welker (b71,b76), and in our own mapping studies (see Fig. 3), this discontinuous pattern of granular, or koniocortical, zones contains within itself a map of the ratbs cutaneous periphery. There are clear subtypes within this cytoarchitectural subregion, notably including the bgranular aggregateb type of cytoarchitecture characteristic of the paw, limb, and mystacial vibrissae areas, and the bbarrel-fieldb type (originally described by Woolsey and Van der Loos, b70) seen in the nose and perioral regions. In the mouse, but not the rat, such barrels also cover the whole whisker representation (Welker and Woolsey, b74).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BAMS:S1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BAMS:SSp</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DHBA:10209</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:35706</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000908</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:322</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NLX:143551</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:1350</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>primary somatosensory cortex (area S1, areas 3,1,2)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>somatosensory area 1</oboInOwl:hasExactSynonym>
        <rdfs:label>primary somatosensory cortex</rdfs:label>
        <skos:prefLabel>primary somatosensory cortex</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008933"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>(Chapin &amp; Lin, 1984, rat): the region considered as the SI cortex is not a cytoarchitecturally homogeneous structure but consists instead of a patchwork array of areas containing dense aggregations of layer IV granule cells, surrounded by granule-cell-sparse regions. As was shown by Welker (b71,b76), and in our own mapping studies (see Fig. 3), this discontinuous pattern of granular, or koniocortical, zones contains within itself a map of the ratbs cutaneous periphery. There are clear subtypes within this cytoarchitectural subregion, notably including the bgranular aggregateb type of cytoarchitecture characteristic of the paw, limb, and mystacial vibrissae areas, and the bbarrel-fieldb type (originally described by Woolsey and Van der Loos, b70) seen in the nose and perioral regions. In the mouse, but not the rat, such barrels also cover the whole whisker representation (Welker and Woolsey, b74).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NLX:143551</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008933"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>primary somatosensory cortex (area S1, areas 3,1,2)</owl:annotatedTarget>
        <oboInOwl:hasDbXref>DHBA:10209</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008933"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>somatosensory area 1</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Sensory_system</oboInOwl:hasDbXref>
    </owl:Axiom>
    


