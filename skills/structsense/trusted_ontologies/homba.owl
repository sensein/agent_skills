        <oboInOwl:hasDbXref>HBA:9530</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:96</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C32471</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:280179000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Dorsal_cochlear_nucleus</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>dorsal cochlear nucleus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>dorsal division of cochlear nucleus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>posterior cochlear nucleus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tuberculum acousticum</oboInOwl:hasExactSynonym>
        <rdfs:label>dorsal cochlear nucleus</rdfs:label>
        <skos:prefLabel>dorsal cochlear nucleus</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002829"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
