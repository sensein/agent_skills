        <obo:IAO_0000115>A transverse unitary subdivision of the neural tube that shares a common dorsoventral structure (floor, basal, alar, and roof plates), but each having differential molecular identities and fates; they comprise the secondary prosencephalon, diencephalon (prosomeres), the midbrain (mesomeres), and the hindbrain (rhombomeres).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>NLX:147842</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0001328</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Neuromere</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0001328</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>neural tube metameric segment</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>neural tube segment</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>neuromere</oboInOwl:hasExactSynonym>
        <rdfs:label>neuromere</rdfs:label>
        <skos:prefLabel>neuromere</skos:prefLabel>
