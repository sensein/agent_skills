        <oboInOwl:hasDbXref>EHDAA:181</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:295532</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0000060</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000086</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Prechordal_plate</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000079</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000060</oboInOwl:hasDbXref>
        <rdfs:label>prechordal plate</rdfs:label>
