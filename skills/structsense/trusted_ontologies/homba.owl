    <!-- http://purl.obolibrary.org/obo/UBERON_0022262 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0022262">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0022260"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0022247"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The acoustic radiations or auditory radiations are structures found in the brain, in the ventral cochlear pathway, a part of the auditory system. Lesions to the auditory radiations could be a cause of cortical deafness.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>DHBA:266441583</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:62413</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:265504974</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Acoustic_radiation</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:2084</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>acoustic radiation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>geniculotemporal radiation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>geniculotemporal tract</oboInOwl:hasExactSynonym>
        <rdfs:label>auditory radiation</rdfs:label>
        <skos:prefLabel>auditory radiation</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0022262"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The acoustic radiations or auditory radiations are structures found in the brain, in the ventral cochlear pathway, a part of the auditory system. Lesions to the auditory radiations could be a cause of cortical deafness.</owl:annotatedTarget>
