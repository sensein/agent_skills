        <oboInOwl:hasDbXref>BM:STr</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BTO:0004616</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DHBA:10591</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:61974</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:9278</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:301</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Stria_terminalis</oboInOwl:hasDbXref>
