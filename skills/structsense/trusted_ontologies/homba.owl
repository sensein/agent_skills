        <oboInOwl:hasDbXref>XAO:0004226</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ventral tegmental area of tsai</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ventral tegmental nucleus (tsai)</oboInOwl:hasExactSynonym>
