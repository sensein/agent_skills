    <!-- http://purl.obolibrary.org/obo/UBERON_0001903 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001903">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0015234"/>
        <obo:IAO_0000115>The thalamic reticular nucleus is part of the ventral thalamus that forms a capsule around the thalamus laterally. It is separated from the thalamus by the external medullary lamina. Reticular cells are GABAergic, and have discoid dendritic arbors in the plane of the nucleus. Thalamic Reticular Nucleus is variously abbreviated TRN, RTN, NRT, and RT. [WP,unvetted].</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BAMS:RT</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BAMS:Rt</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BIRNLEX:1721</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BM:Die-VTh-R</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DHBA:10464</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:35737</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EV:0100214</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:62026</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:4506</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000876</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:262</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:279164008</oboInOwl:hasDbXref>
