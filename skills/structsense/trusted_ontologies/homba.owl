                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000107"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An early stage of embryonic development in animals. It is produced by cleavage of a fertilized ovum and consists of a spherical layer of around 128 cells surrounding a central fluid-filled cavity called the blastocoel. The blastula follows the morula and precedes the gastrula in the developmental sequence.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BILS:0000108</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BilaDO:0000007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EFO:0001282</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>OGES:000003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>OGES:000016</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>OGES:000021</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WBls:0000005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Blastula</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:1000003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFS:0000045</oboInOwl:hasDbXref>
        <rdfs:label>blastula stage</rdfs:label>
        <skos:prefLabel>blastula stage</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000108"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An early stage of embryonic development in animals. It is produced by cleavage of a fertilized ovum and consists of a spherical layer of around 128 cells surrounding a central fluid-filled cavity called the blastocoel. The blastula follows the morula and precedes the gastrula in the developmental sequence.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Blastula</oboInOwl:hasDbXref>
    </owl:Axiom>
    


