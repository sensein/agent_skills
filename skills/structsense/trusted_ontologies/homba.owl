        <oboInOwl:hasDbXref>Wikipedia:Postcentral_sulcus</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>postcentral fissure of cerebral hemisphere</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>postcentral fissure-1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>postcentral sulcus</oboInOwl:hasExactSynonym>
