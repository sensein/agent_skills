            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The solitary tract is a compact fiber bundle that extends longitudinally through the posterolateral region of the medulla. The solitary tract is surrounded by the nucleus of the solitary tract, and descends to the upper cervical segments of the spinal cord. [WP,unvetted].</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BAMS:sol</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BAMS:ts</oboInOwl:hasDbXref>
