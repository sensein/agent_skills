        <oboInOwl:hasDbXref>BTO:0004673</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EHDAA:402</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:18606</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:338637006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0000014</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000264</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Dorsal_aorta</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000051</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000014</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>DA</oboInOwl:hasExactSynonym>
        <rdfs:label>dorsal aorta</rdfs:label>
        <skos:prefLabel>dorsal aorta</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005805"/>
