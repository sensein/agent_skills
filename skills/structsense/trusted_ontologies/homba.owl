        <oboInOwl:hasDbXref>MA:0001101</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D008340</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C32779</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:280212008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001345</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Mandibular_nerve</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>inferior maxillary nerve</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mandibular division [V3]</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mandibular division [Vc]</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mandibular division of fifth cranial nerve</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mandibular division of trigeminal nerve [Vc; V3]</oboInOwl:hasExactSynonym>
