        <oboInOwl:hasDbXref>neuronames:1389</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>vestibular root of acoustic nerve</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vestibular root of eighth cranial nerve</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vestibulocochlear VIII nerve vestibular component</oboInOwl:hasExactSynonym>
        <rdfs:label>vestibular nerve</rdfs:label>
        <skos:prefLabel>vestibular nerve</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
