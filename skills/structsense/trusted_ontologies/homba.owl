        <oboInOwl:hasDbXref>neuronames:1406</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>auditory nerve</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cochlear root of acoustic nerve</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cochlear root of eighth cranial nerve</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vestibulocochlear VIII nerve cochlear component</oboInOwl:hasExactSynonym>
        <rdfs:label>cochlear nerve</rdfs:label>
        <skos:prefLabel>cochlear nerve</skos:prefLabel>
    </owl:Class>
