    <!-- http://purl.obolibrary.org/obo/UBERON_0002028 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002616"/>
