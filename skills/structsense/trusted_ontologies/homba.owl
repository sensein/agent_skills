                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011825"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A thin layer of loose connective tissue which lies beneath the epithelium and together with the epithelium constitutes the mucosa[WP]. The lamina propria contains capillaries and a central lacteal (lymph vessel) in the small intestine, as well as lymphoid tissue. Lamina propria also contains glands with the ducts opening on to the mucosal epithelium, that secrete mucus and serous secretions.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0002330</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:62517</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C32918</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:298225002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Lamina_propria</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>lamina propria mucosa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lamina propria mucosae</oboInOwl:hasExactSynonym>
        <rdfs:label>lamina propria</rdfs:label>
        <skos:prefLabel>lamina propria</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000030"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A thin layer of loose connective tissue which lies beneath the epithelium and together with the epithelium constitutes the mucosa[WP]. The lamina propria contains capillaries and a central lacteal (lymph vessel) in the small intestine, as well as lymphoid tissue. Lamina propria also contains glands with the ducts opening on to the mucosal epithelium, that secrete mucus and serous secretions.</owl:annotatedTarget>
