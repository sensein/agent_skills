                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002433"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001515"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The ascending aorta is the portion of the aorta in a two-pass circulatory system that lies between the heart and the arch of aorta[GO]. A portion of the aorta commencing at the upper part of the base of the left ventricle, on a level with the lower border of the third costal cartilage behind the left half of the sternum; it passes obliquely upward, forward, and to the right, in the direction of the heart&apos;s axis, as high as the upper border of the second right costal cartilage, describing a slight curve in its course, and being situated, about 6 cm behind the posterior surface of the sternum. The total length is about 5 cm in length [Wikipedia].</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EHDAA2:0000147</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EHDAA:9828</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:17014</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:3736</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0002570</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C32150</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:181299009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Ascending_aorta</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ascending thoracic aorta</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pars ascendens aortae</oboInOwl:hasExactSynonym>
        <rdfs:label>ascending aorta</rdfs:label>
        <skos:prefLabel>ascending aorta</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001496"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The ascending aorta is the portion of the aorta in a two-pass circulatory system that lies between the heart and the arch of aorta[GO]. A portion of the aorta commencing at the upper part of the base of the left ventricle, on a level with the lower border of the third costal cartilage behind the left half of the sternum; it passes obliquely upward, forward, and to the right, in the direction of the heart&apos;s axis, as high as the upper border of the second right costal cartilage, describing a slight curve in its course, and being situated, about 6 cm behind the posterior surface of the sternum. The total length is about 5 cm in length [Wikipedia].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GO:0035905</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Ascending_aorta</oboInOwl:hasDbXref>
