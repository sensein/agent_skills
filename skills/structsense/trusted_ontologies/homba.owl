            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>In the floor of the fourth ventricle, the sulcus limitans separates the cranial nerve motor nuclei (medial) from the sensory nuclei (lateral). In the superior part of the rhomboid fossa, it corresponds with the lateral limit of the fossa and presents a bluish-gray area, the locus ceruleus (which owes its color to an underlying patch of deeply pigmented nerve cells, termed the substantia ferruginea). [WP].</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BAMS:slim</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BAMS:slm</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DHBA:12823</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:78496</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C33656</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Sulcus_limitans</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:629</oboInOwl:hasDbXref>
        <rdfs:label>sulcus limitans of fourth ventricle</rdfs:label>
        <skos:prefLabel>sulcus limitans of fourth ventricle</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009573"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>In the floor of the fourth ventricle, the sulcus limitans separates the cranial nerve motor nuclei (medial) from the sensory nuclei (lateral). In the superior part of the rhomboid fossa, it corresponds with the lateral limit of the fossa and presents a bluish-gray area, the locus ceruleus (which owes its color to an underlying patch of deeply pigmented nerve cells, termed the substantia ferruginea). [WP].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Sulcus_limitans</oboInOwl:hasDbXref>
    </owl:Axiom>
    


