        <oboInOwl:hasDbXref>FMA:75383</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C34245</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:245445008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Pectinate_line</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>pectinate line of anal canal</oboInOwl:hasExactSynonym>
