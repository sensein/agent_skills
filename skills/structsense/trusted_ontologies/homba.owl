        <oboInOwl:hasDbXref>Wikipedia:Nucleus_ambiguus</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ambiguus nucleus</oboInOwl:hasExactSynonym>
        <rdfs:label>nucleus ambiguus</rdfs:label>
        <skos:prefLabel>nucleus ambiguus</skos:prefLabel>
    </owl:Class>
