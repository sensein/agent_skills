    <!-- http://purl.obolibrary.org/obo/UBERON_0007375 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0007375">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000481"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A multi-tissue structure consisting of bone and soft tissue that forms a part of the roof of the oral cavity. In mammals this is the combination of the primary palate (premaxilla) and the secondary palate. In early tetrapods it consists of the vomer, pterygoid, parasphenoid, palatine and ectopterygoid bones.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CALOHA:TS-2212</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Palate</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>roof of buccal cavity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>roof of oral cavity</oboInOwl:hasExactSynonym>
        <rdfs:label>roof of mouth</rdfs:label>
        <skos:prefLabel>roof of mouth</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007375"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multi-tissue structure consisting of bone and soft tissue that forms a part of the roof of the oral cavity. In mammals this is the combination of the primary palate (premaxilla) and the secondary palate. In early tetrapods it consists of the vomer, pterygoid, parasphenoid, palatine and ectopterygoid bones.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-6601-2165</oboInOwl:hasDbXref>
    </owl:Axiom>
    


