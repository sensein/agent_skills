        <oboInOwl:hasDbXref>MA:0000993</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:1143</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C49138</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cerebellar granular layer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cerebellar granule cell layer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cerebellar granule layer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cerebellum granule cell layer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cerebellum granule layer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>granule cell layer of cerebellar cortex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>stratum granulosum cerebelli</oboInOwl:hasExactSynonym>
        <rdfs:label>granular layer of cerebellar cortex</rdfs:label>
        <skos:prefLabel>granular layer of cerebellar cortex</skos:prefLabel>
    </owl:Class>
