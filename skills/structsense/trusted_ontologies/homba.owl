        <oboInOwl:hasDbXref>FMA:13363</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000361</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C32965</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:362183003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0005172</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001423</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Left_lobe_of_liver</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0005172</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>left liver lobe</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>liver left lobe</oboInOwl:hasExactSynonym>
        <rdfs:label>left lobe of liver</rdfs:label>
        <skos:prefLabel>left lobe of liver</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001115"/>
