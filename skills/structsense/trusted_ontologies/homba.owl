            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A fiber pathway that originates from neurons in the posterior hypothalamic region and projects to various nuclei of the anterior nuclear group of the thalamus. It is a composite structure that consists of the mammillothalamic tract of the hypothalamus and the mammillothalamic tract of the thalamus (Carpenter-1983). (from Brain Info.org).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BAMS:mt</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BAMS:mtt</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DHBA:10586</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DMBA:17782</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:83849</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:9266</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NLXANAT:1010016</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Mammillothalamic_fasciculus</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:2438</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>mammillothalamic fasciculus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mammillothalamic tract</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vicq d&apos;azyr&apos;s bundle</oboInOwl:hasExactSynonym>
