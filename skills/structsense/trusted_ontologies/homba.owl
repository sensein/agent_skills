        <oboInOwl:hasDbXref>SCTID:279199007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Cuneus</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cuneate lobule</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cuneus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cuneus cortex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cuneus gyrus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cuneus of hemisphere</oboInOwl:hasExactSynonym>
        <rdfs:label>cuneus cortex</rdfs:label>
        <skos:prefLabel>cuneus cortex</skos:prefLabel>
    </owl:Class>
