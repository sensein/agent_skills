    <owl:Class rdf:about="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass7eae3bab_c9f2_46ec_8bd5_6a46e540d6bd">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org//Childbearing-ageWomenwithEpilepsyOntology#OWLClass7aa094f9_1233_480b_b8b2_466e1c3e8d44"/>
        <untitled-ontology-34:Chinese>矫形术</untitled-ontology-34:Chinese>
        <untitled-ontology-34:MESH_Definition>A specialty which utilizes medical, surgical, and physical methods to treat and correct deformities, diseases, and injuries to the skeletal system, its articulations, and associated structures.</untitled-ontology-34:MESH_Definition>
        <untitled-ontology-34:NCIt_Definition>The branch of surgery broadly concerned with the skeletal system (bones and joints).</untitled-ontology-34:NCIt_Definition>
