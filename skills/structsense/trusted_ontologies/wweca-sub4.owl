    <!-- http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassa6582fd4_32d8_490a_8ee7_10ec3ce845a3 -->

    <owl:Class rdf:about="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassa6582fd4_32d8_490a_8ee7_10ec3ce845a3">
