    <!-- http://www.semanticweb.org//Childbearing-ageWomenwithEpilepsyOntology#Bipolar_disorder -->

    <owl:Class rdf:about="http://www.semanticweb.org//Childbearing-ageWomenwithEpilepsyOntology#Bipolar_disorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass7d9f4570_b814_4c4b_9d22_de131530c392"/>
        <Literature>Knott S, Forty L, Craddock N, Thomas RH. Epilepsy and bipolar disorder. Epilepsy Behav. 2015;52(Pt A):267-274. doi:10.1016/j.yebeh.2015.07.003

Bakken IJ, Revdal E, Nesvåg R, et al. Substance use disorders and psychotic disorders in epilepsy: a population-based registry study. Epilepsy Res. 2014;108(8):1435-1443. doi:10.1016/j.eplepsyres.2014.06.021</Literature>
        <untitled-ontology-34:Chinese>双相情感障碍</untitled-ontology-34:Chinese>
        <untitled-ontology-34:MESH_Definition>A major affective disorder marked by severe mood swings (manic or major depressive episodes) and a tendency to remission and recurrence.</untitled-ontology-34:MESH_Definition>
        <untitled-ontology-34:NCIt_Definition>A disorder of the brain that causes unusual shifts in mood, energy, activity levels and the ability to carry out day-to-day tasks. Often these moods range and shift from periods of elation and energized behavior to those of hopelessness and depression.</untitled-ontology-34:NCIt_Definition>
