    </owl:Class>
    


    <!-- http://www.semanticweb.org//Childbearing-ageWomenwithEpilepsyOntology#Coffee -->

    <owl:Class rdf:about="http://www.semanticweb.org//Childbearing-ageWomenwithEpilepsyOntology#Coffee">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org//Childbearing-ageWomenwithEpilepsyOntology#Caffeinated_drinks"/>
        <untitled-ontology-34:Chinese>咖啡</untitled-ontology-34:Chinese>
        <untitled-ontology-34:MESH_Definition>A beverage made from ground COFFEA beans (SEEDS) infused in hot water. It generally contains CAFFEINE and THEOPHYLLINE unless it is decaffeinated.</untitled-ontology-34:MESH_Definition>
