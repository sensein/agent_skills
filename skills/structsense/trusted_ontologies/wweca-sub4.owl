        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass107402b8_7f79_440b_8dbe_568dd7f93659"/>
        <untitled-ontology-34:Chinese>决奈达隆</untitled-ontology-34:Chinese>
        <untitled-ontology-34:MESH_Definition>A non-iodinated derivative of amiodarone that is used for the treatment of ARRHYTHMIA.</untitled-ontology-34:MESH_Definition>
