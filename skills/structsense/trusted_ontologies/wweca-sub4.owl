    <!-- http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass3256c19a_3b6a_434a_858d_822607a46acb -->

    <owl:Class rdf:about="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass3256c19a_3b6a_434a_858d_822607a46acb">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org//Childbearing-ageWomenwithEpilepsyOntology#OWLClass0db655e6_fcdc_45ba_a5c9_4508ac0dd74b"/>
        <untitled-ontology-34:Chinese>透皮贴片</untitled-ontology-34:Chinese>
        <untitled-ontology-34:ROCG_Guidance>[GRADES OF RECOMMENDATION:C] Women should be counselled that the efficacy of oral contraceptives (combined hormonal contraception, progestogen-only pills), transdermal patches, vaginal ring and progestogen-only implants may be affected if they are taking enzyme-inducing AEDs (e.g. carbamazepine, phenytoin, phenobarbital, primidone, oxcarbazepine and eslicarbazepine).
【推荐等级：C】如果WWE正在服用酶诱导AEDs，应告知患者口服避孕药（联合激素类避孕药、仅含孕激素的药片）、透皮贴片（transdermal patches）、阴道环和仅含孕激素皮下埋植（progestogen-only implants）的疗效会受到影响。
https://www.rcog.org.uk/guidance/browse-all-guidance/green-top-guidelines/epilepsy-in-pregnancy-green-top-guideline-no-68/</untitled-ontology-34:ROCG_Guidance>
        <untitled-ontology-34:Synonyms>Patches Transdermal Medication</untitled-ontology-34:Synonyms>
        <rdfs:label xml:lang="zh">Transdermal patches</rdfs:label>
    </owl:Class>
    


