    <!-- http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassa99bfd9f_db00_4f0f_8b81_6f519e381a34 -->

    <owl:Class rdf:about="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassa99bfd9f_db00_4f0f_8b81_6f519e381a34">
