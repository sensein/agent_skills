    <!-- http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass35b5517b_8544_4296_83c1_83b3a815eb3f -->

    <owl:Class rdf:about="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass35b5517b_8544_4296_83c1_83b3a815eb3f">
