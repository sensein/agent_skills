    </owl:Class>
    


    <!-- http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass69b1142f_ca10_411c_b3dd_3588eea4b2c9 -->

    <owl:Class rdf:about="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass69b1142f_ca10_411c_b3dd_3588eea4b2c9">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass0a53ae95_4680_46fd_8b90_cfa9a297c368"/>
        <untitled-ontology-34:Chinese>动机访谈</untitled-ontology-34:Chinese>
        <untitled-ontology-34:MESH_Definition>It is a client-centered, directive method for eliciting intrinsic motivation to change using open-ended questions, reflective listening, and decisional balancing. This nonjudgmental, nonconfrontational interviewing style is designed to minimize a patient&apos;s resistance to change by creating an interaction that supports open discussion of risky or problem behavior.</untitled-ontology-34:MESH_Definition>
        <untitled-ontology-34:NCIt_Definition>A directive, client-centered counseling style that helps people resolve ambivalent feelings and insecurities in order to find internal motivation and elicit behavior changes.</untitled-ontology-34:NCIt_Definition>
        <untitled-ontology-34:Synonyms>MI
Motivational interviewing
Motivational Interviewing Intervention
Interviewing Motivational
motivational interviewing
Motivational Interviewing
motivational enhancement therapy
motivational interview
Motivational interviewing (qualifier value)
motivational counseling</untitled-ontology-34:Synonyms>
        <rdfs:label xml:lang="zh">Motivational Interview</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass69d07498_f3b0_486b_90d4_fc4305312314 -->

    <owl:Class rdf:about="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass69d07498_f3b0_486b_90d4_fc4305312314">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassfb4b43da_f97a_4b21_98e3_c1ad4ae4495f"/>
        <untitled-ontology-34:Chinese>发作年龄</untitled-ontology-34:Chinese>
        <untitled-ontology-34:MESH_Definition>The age, developmental stage, or period of life at which a disease or the initial symptoms or manifestations of a disease appear in an individual.</untitled-ontology-34:MESH_Definition>
