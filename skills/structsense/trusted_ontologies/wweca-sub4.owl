        <rdfs:label xml:lang="zh">Vagus nerve stimulation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassa6cdca56_ad43_408d_831d_3f52b112e94e -->

    <owl:Class rdf:about="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassa6cdca56_ad43_408d_831d_3f52b112e94e">
