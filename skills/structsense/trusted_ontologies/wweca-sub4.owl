        <rdfs:label xml:lang="zh">Moricizine</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass3b37d557_e2cc_4212_8c37_e614fa8ecdea -->

    <owl:Class rdf:about="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass3b37d557_e2cc_4212_8c37_e614fa8ecdea">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass4bf80c27_e742_4666_aae1_b64e413c20f6"/>
        <untitled-ontology-34:Chinese>噻加宾</untitled-ontology-34:Chinese>
        <untitled-ontology-34:MESH_Definition>A nipecotic acid derivative that acts as a GABA uptake inhibitor and anticonvulsant agent. It is used in the treatment of EPILEPSY, for refractory PARTIAL SEIZURES.</untitled-ontology-34:MESH_Definition>
