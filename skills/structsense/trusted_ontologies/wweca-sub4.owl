    <!-- http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass9613f7e0_ea93_41ae_a5c2_f376eb1b748f -->

    <owl:Class rdf:about="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass9613f7e0_ea93_41ae_a5c2_f376eb1b748f">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassa99bfd9f_db00_4f0f_8b81_6f519e381a34"/>
