    <!-- http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassf3daa5a0_d952_42ed_a151_87db3d10d879 -->

    <owl:Class rdf:about="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassf3daa5a0_d952_42ed_a151_87db3d10d879">
