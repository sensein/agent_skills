    <!-- http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass58abebbe_95ff_4d7b_82da_ed217794919b -->

    <owl:Class rdf:about="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass58abebbe_95ff_4d7b_82da_ed217794919b">
