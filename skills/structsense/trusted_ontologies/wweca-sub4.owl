    <!-- http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassb32ae96b_9337_441f_a45b_8e7efc039775 -->

    <owl:Class rdf:about="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassb32ae96b_9337_441f_a45b_8e7efc039775">
