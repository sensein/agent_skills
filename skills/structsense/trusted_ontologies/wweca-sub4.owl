    <!-- http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass96fff5b0_d5c3_496f_9110_ea2384244899 -->

    <owl:Class rdf:about="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass96fff5b0_d5c3_496f_9110_ea2384244899">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClasse960ff73_fe24_4579_8dc3_352104db3bd9"/>
        <untitled-ontology-34:Chinese>羊膜穿刺术</untitled-ontology-34:Chinese>
        <untitled-ontology-34:MESH_Definition>Percutaneous transabdominal puncture of the uterus during pregnancy to obtain amniotic fluid. It is commonly used for fetal karyotype determination in order to diagnose abnormal fetal conditions.</untitled-ontology-34:MESH_Definition>
        <untitled-ontology-34:NCIt_Definition>A prenatal diagnostic procedure in which a small sample of amniotic fluid is removed from the uterus by a needle inserted into the abdomen. This procedure is used to detect various genetic abnormalities in the fetus and/or the sex of the fetus.</untitled-ontology-34:NCIt_Definition>
        <untitled-ontology-34:Synonyms>Amniocentesis
Diagnostic amniocentesis
amniocentesis
Amniocenteses
AC - Amniocentesis
Incision and drainage of amnion
Diagnostic amniocentesis (procedure)
Amniocentesis (procedure)</untitled-ontology-34:Synonyms>
        <rdfs:label xml:lang="zh">Amniocentesis</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass973b8f2e_2da7_43f1_82a1_7f5b7e6a86c5 -->

