    <!-- http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass2d15249b_b60e_4226_8754_52ff1f1b46af -->

    <owl:Class rdf:about="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass2d15249b_b60e_4226_8754_52ff1f1b46af">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassb5313e9d_0836_44f6_ae6b_224bf17a6349"/>
        <untitled-ontology-34:Chinese>舒必利</untitled-ontology-34:Chinese>
        <untitled-ontology-34:MESH_Definition>A dopamine D2-receptor antagonist. It has been used therapeutically as an antidepressant, antipsychotic, and as a digestive aid. (From Merck Index, 11th ed)</untitled-ontology-34:MESH_Definition>
