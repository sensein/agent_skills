    <!-- http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassf6dcec75_9a49_4e16_b0f1_a9b1e1dbdd27 -->

    <owl:Class rdf:about="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassf6dcec75_9a49_4e16_b0f1_a9b1e1dbdd27">
