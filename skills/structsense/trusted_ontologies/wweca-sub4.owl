    <!-- http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassabf35410_8cbd_42c7_afb8_07a4954fa3f5 -->

    <owl:Class rdf:about="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassabf35410_8cbd_42c7_afb8_07a4954fa3f5">
