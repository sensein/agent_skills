    <!-- http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClasse80b07d8_c77b_4183_a86f_608625c49716 -->

    <owl:Class rdf:about="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClasse80b07d8_c77b_4183_a86f_608625c49716">
