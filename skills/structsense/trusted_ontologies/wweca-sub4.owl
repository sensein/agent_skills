    <!-- http://www.semanticweb.org//Childbearing-ageWomenwithEpilepsyOntology#Biofeedback_therapy -->

    <owl:Class rdf:about="http://www.semanticweb.org//Childbearing-ageWomenwithEpilepsyOntology#Biofeedback_therapy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org//Childbearing-ageWomenwithEpilepsyOntology#OWLClass7aa094f9_1233_480b_b8b2_466e1c3e8d44"/>
        <Literature>Alqahtani F, Imran I, Pervaiz H, et al. Non-pharmacological Interventions for Intractable Epilepsy. Saudi Pharm J. 2020;28(8):951-962. doi:10.1016/j.jsps.2020.06.016</Literature>
        <untitled-ontology-34:Chinese>生物反馈治疗</untitled-ontology-34:Chinese>
        <untitled-ontology-34:MESH_Definition>The therapy technique of providing the status of one&apos;s own AUTONOMIC NERVOUS SYSTEM function (e.g., skin temperature, heartbeats, brain waves) as visual or auditory feedback in order to self-control related conditions (e.g., hypertension, migraine headaches).</untitled-ontology-34:MESH_Definition>
        <untitled-ontology-34:NCIt_Definition>A training technique in which various bodily functions, such as heart rate, skin temperature, muscle tension, and brain activity are monitored so that people can learn to control them voluntarily so as to improve their health and physical performance.</untitled-ontology-34:NCIt_Definition>
        <untitled-ontology-34:Synonyms>biofeedback (psychology)
