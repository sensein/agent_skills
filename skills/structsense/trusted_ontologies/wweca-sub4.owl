        <rdfs:label xml:lang="zh">Sodium valproate</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClasseb5a0597_2b94_4904_97e2_38d3c63f572d -->

