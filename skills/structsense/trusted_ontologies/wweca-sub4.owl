        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org//Childbearing-ageWomenwithEpilepsyOntology#OWLClass833b1ac6_9bc8_4025_8bc7_4d267961ec74"/>
        <untitled-ontology-34:Chinese>诊断方法</untitled-ontology-34:Chinese>
        <untitled-ontology-34:NCIt_Definition>A question about the method to obtain the initial pathologic diagnosis.</untitled-ontology-34:NCIt_Definition>
