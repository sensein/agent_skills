    <!-- http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassa7abf64c_3cf3_490f_9b4d_52835aa5f4a7 -->

    <owl:Class rdf:about="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassa7abf64c_3cf3_490f_9b4d_52835aa5f4a7">
