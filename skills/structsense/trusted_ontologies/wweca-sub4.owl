    <!-- http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassd4b7caf3_416c_42be_9d32_a32b1291d860 -->

    <owl:Class rdf:about="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassd4b7caf3_416c_42be_9d32_a32b1291d860">
