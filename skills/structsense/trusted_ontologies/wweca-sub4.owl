    <!-- http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassa22ec95f_c719_44b6_ae5d_5c12f08cc5f9 -->

    <owl:Class rdf:about="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassa22ec95f_c719_44b6_ae5d_5c12f08cc5f9">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass3193642d_95d0_4615_9db1_d3f37ebf09b6"/>
