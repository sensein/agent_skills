        <rdfs:label xml:lang="zh">Lorcaserin</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass6e75133c_257f_4f30_a5db_3e666e7d5f18 -->

    <owl:Class rdf:about="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass6e75133c_257f_4f30_a5db_3e666e7d5f18">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org//Childbearing-ageWomenwithEpilepsyOntology#OWLClass7aa094f9_1233_480b_b8b2_466e1c3e8d44"/>
        <untitled-ontology-34:Chinese>体位治疗</untitled-ontology-34:Chinese>
