    <!-- http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassf832e5f8_825d_4536_b29b_baca02c894ee -->

    <owl:Class rdf:about="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassf832e5f8_825d_4536_b29b_baca02c894ee">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org//Childbearing-ageWomenwithEpilepsyOntology#OWLClassa08bc63f_763f_4752_bdfb_b7bd5e7175e4"/>
        <untitled-ontology-34:Chinese>体外受精</untitled-ontology-34:Chinese>
        <untitled-ontology-34:MESH_Definition>An assisted reproductive technique that includes the direct handling and manipulation of oocytes and sperm to achieve fertilization in vitro.</untitled-ontology-34:MESH_Definition>
