immunotherapy
Biological response modifier therapy</untitled-ontology-34:Synonyms>
        <rdfs:label xml:lang="zh">Immunotherapy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassc9d85efc_5099_495f_b318_874c9f7b2667 -->

    <owl:Class rdf:about="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassc9d85efc_5099_495f_b318_874c9f7b2667">
