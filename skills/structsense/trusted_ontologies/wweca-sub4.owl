    <!-- http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassb575f325_2f33_4af1_a79c_19a61c5d4f5b -->

    <owl:Class rdf:about="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassb575f325_2f33_4af1_a79c_19a61c5d4f5b">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClassdd746922_f5f4_45b7_9f02_91092fa08d45"/>
