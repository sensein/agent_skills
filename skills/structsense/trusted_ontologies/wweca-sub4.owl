    <owl:Class rdf:about="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass42a57360_c2c2_4af7_9259_522604864b48">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/administrator/ontologies/2022/0/untitled-ontology-34#OWLClass6ab90554_6107_4c7c_9c2c_cb7aae95fd96"/>
        <untitled-ontology-34:Chinese>选择性5-HT再摄取抑制剂</untitled-ontology-34:Chinese>
        <untitled-ontology-34:MESH_Definition>Compounds that specifically inhibit the reuptake of serotonin in the brain.</untitled-ontology-34:MESH_Definition>
