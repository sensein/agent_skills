        <oboInOwl:hasOBONamespace>behavior_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:xref>HP:0000722</oboInOwl:xref>
        <rdfs:label>obsessive-compulsive disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000249 -->

