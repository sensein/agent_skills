                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000118"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002433"/>
