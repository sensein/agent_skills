            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A molecular entity containing one or more atoms from any of groups 1, 2, 13, 14, 15, 16, 17, and 18 of the periodic table.</obo:IAO_0000115>
        <rdfs:label>main group molecular entity</rdfs:label>
    </owl:Class>
    


