                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002216"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0007586"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
