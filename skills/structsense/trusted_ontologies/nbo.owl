        <oboInOwl:hasExactSynonym>swallowing reflex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>behavior_ontology</oboInOwl:hasOBONamespace>
        <rdfs:label>pharyngeal reflex</rdfs:label>
    </owl:Class>
    


