        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000034"/>
        <obo:IAO_0000115 xml:lang="en">Deposition of eggs either into the medium, or onto a substrate.</obo:IAO_0000115>
        <oboInOwl:created_by>Luke Slater</oboInOwl:created_by>
