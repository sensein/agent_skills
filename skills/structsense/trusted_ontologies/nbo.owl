            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A type of associative learning that allows organisms to acquire affective responses, such as fear, in situations where a particular context or stimulus is predictably elicits fear via an aversive context.</obo:IAO_0000115>
        <dc:date>2011-04-03T08:58:27Z</dc:date>
        <oboInOwl:created_by>George Gkoutos</oboInOwl:created_by>
        <oboInOwl:hasOBONamespace>behavior_ontology</oboInOwl:hasOBONamespace>
