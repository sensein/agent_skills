            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An s-block molecular entity is a molecular entity containing one or more atoms of an s-block element.</obo:IAO_0000115>
        <rdfs:label>s-block molecular entity</rdfs:label>
    </owl:Class>
    


