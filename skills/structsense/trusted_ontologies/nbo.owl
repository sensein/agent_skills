            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000007>epidermal</obo:UBPROP_0000007>
        <obo:UBPROP_0000008>Zebrafish epidermis consists only of living cells unlike terrestrial vertebrates in which dead, keratinized cells are present. In terrestrial vertebrates the epidermis often forms an outer keratinized or cornified layer, the stratum corneum. Interaction between the epideris and dermis gives rise to feathers (birds), hair and mammary glands (mammals), teeth and scales (placoid: chondrichthyans; cosmoids, ganoid, cycloid in bony fishes).</obo:UBPROP_0000008>
        <rdfs:label>skin epidermis</rdfs:label>
    </owl:Class>
    


