        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A reflex that involves cranial nerves.</owl:annotatedTarget>
        <oboInOwl:source>wikipedia:Reflex</oboInOwl:source>
