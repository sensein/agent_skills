            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#is_conjugate_acid_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_29067"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A carbon oxoacid acid carrying at least one -C(=O)OH group and having the structure RC(=O)OH, where R is any any monovalent functional group. Carboxylic acids are the most common type of organic acid.</obo:IAO_0000115>
        <chebi:charge>0</chebi:charge>
        <chebi:formula>CHO2R</chebi:formula>
        <chebi:mass>45.01740</chebi:mass>
        <chebi:monoisotopicmass>44.99765</chebi:monoisotopicmass>
        <chebi:smiles>OC([*])=O</chebi:smiles>
        <rdfs:label>carboxylic acid</rdfs:label>
    </owl:Class>
    


