    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0004874 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004874">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002050"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003081"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002131"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000924"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:UBPROP_0000011>Gives rise to the paired appendages in jawed vertebrates. a persistent somatopleure through the redistribution and expansion of the lateral plate mesoderm is a synapomorphy for gnathostomes and a critical step in generating a novel developmental module with dramatic evolutionary potentia (Tulenko et al. 2012) http://burkelab.research.wesleyan.edu/current-projects/lamprey/</obo:UBPROP_0000011>
        <obo:UBPROP_0000012>sources differ as to whether this is part-of or develops-from the LPM</obo:UBPROP_0000012>
        <rdfs:label>somatopleure</rdfs:label>
        <foaf:depicted_by rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/2/28/Gray16.png</foaf:depicted_by>
    </owl:Class>
    


