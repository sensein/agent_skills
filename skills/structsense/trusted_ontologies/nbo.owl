        <oboInOwl:created_by>Luke Slater</oboInOwl:created_by>
        <rdfs:label xml:lang="en">caching behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0020295 -->

