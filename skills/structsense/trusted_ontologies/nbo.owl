    <!-- http://purl.obolibrary.org/obo/CHEBI_16336 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_16336">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_37395"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_72813"/>
