    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NBO_0050002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000013"/>
        <obo:IAO_0000115>Behavior related to the repeating or looping movement of the whole organism along a circular or round path.</obo:IAO_0000115>
        <dc:contributor>http://orcid.org/0000-0002-3528-5267</dc:contributor>
