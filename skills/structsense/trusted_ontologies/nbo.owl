    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/nbo.owl">
        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/nbo/releases/2023-07-04/nbo.owl"/>
        <terms:description>An ontology of human and animal behaviours.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/3.0/"/>
        <terms:title>Neuro Behaviour Ontology</terms:title>
        <oboInOwl:treat-xrefs-as-equivalent>GO</oboInOwl:treat-xrefs-as-equivalent>
        <owl:versionInfo>2023-07-04</owl:versionInfo>
    </owl:Ontology>
    


