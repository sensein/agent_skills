        <foaf:depicted_by rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://upload.wikimedia.org/wikipedia/commons/d/d6/Illu_spleen.jpg</foaf:depicted_by>
    </owl:Class>
    


