    <!-- http://purl.obolibrary.org/obo/UBERON_0001137 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001137">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000475"/>
