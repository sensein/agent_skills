        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000475"/>
        <obo:IAO_0000115>Inability to fall asleep and/or remain asleep for a reasonable amount of time.</obo:IAO_0000115>
