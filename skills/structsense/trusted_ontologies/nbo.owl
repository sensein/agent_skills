    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_50267 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_50267">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23888"/>
        <obo:IAO_0000115>Synthetic or natural substance which is given to prevent a disease or disorder or are used in the process of treating a disease or injury due to a poisonous agent.</obo:IAO_0000115>
        <rdfs:label>protective agent</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_50312 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_50312">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_37577"/>
        <rdfs:label>onium compound</rdfs:label>
    </owl:Class>
    


