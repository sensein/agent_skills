        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000008"/>
        <obo:IAO_0000115>Rhythmic behavior that involves cue-initiated, persistent, direct, focused movement between habitats.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-4277-2151"/>
