        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/NBO_0000500"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A NREM parasomnia characterised by the risef rom the slow wave sleep stage in a state of low consciousness and perform activities that are usually performed during a state of full consciousness.</owl:annotatedTarget>
        <oboInOwl:source>wikipedia:Sleepwalking</oboInOwl:source>
    </owl:Axiom>
    


