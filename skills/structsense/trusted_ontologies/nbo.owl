        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000258"/>
        <obo:IAO_0000115>A bipolar disorder characterised by recurrent hypomanic and dysthymic episodes, but no full manic episodes or full major depressive episodes.</obo:IAO_0000115>
