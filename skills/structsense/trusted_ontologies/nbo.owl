    <!-- http://purl.obolibrary.org/obo/UBERON_0006660 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0006660">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0018260"/>
