        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NBO_0000079"/>
        <obo:IAO_0000115>A feeding behavior during which an animal ingests biomass produced by a plant or other primary producer</obo:IAO_0000115>
