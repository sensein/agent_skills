  <owl:Class rdf:about="#trm_510059e54b2cf">
    <skos:altLabel>Attention bias</skos:altLabel>
    <skos:prefLabel>attentional bias</skos:prefLabel>
    <dc:Title>attentional bias</dc:Title>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660640441</dc:Date>
    <dc:Contributor>usr_49a467bf4e0db</dc:Contributor>
    <skos:definition>Attentional bias refers to the tendency for a particular class of stimuli to capture attention. The term is most typically used to refer to biases related to emotional content in bottom-up-capture attention tasks. </skos:definition>
  </owl:Class>
  <owl:Class rdf:about="#trm_4a3fd79d0b1f7">
    <skos:hasTopConcept rdf:resource="#ctp_C6"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Ne67864ff40664c2087b1158b3786b5ca">
        <owl:onProperty rdf:resource="https://raw.githubusercontent.com/oborel/obo-relations/master/ro.owlkind_of"/>
