  <owl:Class rdf:about="#tsk_PNUOMlNOAajsT">
    <dc:Title>letter matching task</dc:Title>
    <skos:definition>Subjects must compare pairs of letters regarding exact physical identity, name identity, or categorical identity by pressing one of two response keys. These three different instructions require increasing depth of processing stimulus information which is reflected by differences in response latency. </skos:definition>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1528250759316</dc:date>
