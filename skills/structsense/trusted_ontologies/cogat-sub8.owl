    <dc:Title>anchoring</dc:Title>
    <dc:Contributor>usr_49a467bf4e0db</dc:Contributor>
    <skos:definition>a cognitive bias that describes the common human tendency to rely too heavily, or &amp;#34;anchor,&amp;#34; on one trait or piece of information when making decisions.</skos:definition>
    <skos:prefLabel>anchoring</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="#trm_5090b32d6b376">
    <dc:Title>facial recognition task</dc:Title>
    <rdfs:label>facial recognition task</rdfs:label>
