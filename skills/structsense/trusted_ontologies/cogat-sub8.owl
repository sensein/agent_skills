  <owl:Class rdf:about="#trm_52602e2e0c43b">
    <skos:prefLabel>Expressive Vocabulary Test</skos:prefLabel>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660594854</dc:date>
