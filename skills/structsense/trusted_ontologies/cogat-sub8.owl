  <owl:Class rdf:about="#trm_553e77887abc7">
    <skos:definition>This is an economics-derived task that broadly measures willingness to pay (WTP).  Implementations generally involve the participant formulating a bid, and comparing the bid to a randomly generated price.  If bid &gt; price, the participant pays the price and receives the item. If bid </skos:definition>
    <rdfs:label>Becker-Degroot-Marschak (BDM) procedure</rdfs:label>
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
    <skos:prefLabel>Becker-Degroot-Marschak (BDM) procedure</skos:prefLabel>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660597828</dc:date>
    <dc:identifier>trm_553e77887abc7</dc:identifier>
    <dc:Title>Becker-Degroot-Marschak (BDM) procedure</dc:Title>
  </owl:Class>
