  <owl:Class rdf:about="#trm_55a6a52537c2b">
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660598569</dc:date>
    <skos:altLabel>BPRS</skos:altLabel>
    <dc:Title>Brief Psychiatric Rating Scale</dc:Title>
    <skos:definition>The Brief Psychiatric Rating Scale (BPRS) is rating scale which a clinician or researcher may use to measure psychiatric symptoms such as depression, anxiety, hallucinations and unusual behaviour.[1] Each symptom is rated 1-7 and depending on the version between a total of 18-24 symptoms are scored. The scale is the one of the oldest, widely used scales to measure psychotic symptoms and was first published in 1962.&#13;
&#13;
https://en.wikipedia.org/wiki/Brief_Psychiatric_Rating_Scale</skos:definition>
    <rdfs:label>Brief Psychiatric Rating Scale</rdfs:label>
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
    <skos:prefLabel>Brief Psychiatric Rating Scale</skos:prefLabel>
    <dc:identifier>trm_55a6a52537c2b</dc:identifier>
  </owl:Class>
