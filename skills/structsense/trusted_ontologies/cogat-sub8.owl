  <owl:Class rdf:about="#trm_4a3fd79d0b636">
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660636953</dc:Date>
    <skos:prefLabel>framing</skos:prefLabel>
    <dc:Title>framing</dc:Title>
    <dc:Contributor>usr_4abeb2310354e</dc:Contributor>
    <skos:definition><![CDATA[Framing is a method of biasing opinions- a framing effect occurs when the description of information, such as a speaker presenting an issue, has an emphasis on a subset of potentially <br />
relevant considerations and causes individuals to focus on these considerations when constructing their opinions.]]></skos:definition>
    <skos:hasTopConcept rdf:resource="#ctp_C3"/>
  </owl:Class>
