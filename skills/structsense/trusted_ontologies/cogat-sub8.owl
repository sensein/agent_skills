  <owl:Class rdf:about="#trm_4da6304c9aa23">
    <dc:Contributor>usr_523ef0e181acb</dc:Contributor>
    <dc:identifier>trm_4da6304c9aa23</dc:identifier>
    <skos:prefLabel>attention networks test</skos:prefLabel>
    <dc:Title>attention networks test</dc:Title>
    <rdfs:label>attention networks test</rdfs:label>
    <skos:definition>a combination of the Posner cueing paradigm and the Eriksen flanker test, the ANT presents participants with a target item (&gt;) surrounded by congruent (&gt; &gt; &gt; &gt; &gt;), neutral (- - &gt; - -), or incongruent flanker stimuli. Stimulus presentation is preceded by different cue conditions and the participant is instructed to identify the target stimulus.</skos:definition>
    <skos:altLabel>ANT, Attentional Network Task</skos:altLabel>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660586989</dc:date>
  </owl:Class>
