  <owl:Class rdf:about="#trm_4f241c8d4a75c">
    <skos:definition>participant is shown series of photos either of people in portraits or in scenes and asked to determine their gender</skos:definition>
    <dc:identifier>trm_4f241c8d4a75c</dc:identifier>
