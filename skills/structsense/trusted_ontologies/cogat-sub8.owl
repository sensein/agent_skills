  <owl:Class rdf:about="#trm_4da86cb034ff6">
    <skos:definition>This test measures speed of processing by asking participants to discern whether two sideby-side pictures are the same or not. The items are presented one pair at a time on the computer screen, and the participant is given 90 seconds to respond to as many items as possible (up to a maximum of 130). The items are designed to be simple so as to most purely measure processing speed.</skos:definition>
    <skos:prefLabel>pattern comparison task</skos:prefLabel>
    <dc:Title>pattern comparison task</dc:Title>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660587466</dc:date>
    <rdfs:label>pattern comparison task</rdfs:label>
    <dc:identifier>trm_4da86cb034ff6</dc:identifier>
    <dc:Contributor>usr_4de5345b3b6a8</dc:Contributor>
    <skos:altLabel>NIH Toolbox Pattern Comparison Processing Speed Test</skos:altLabel>
  </owl:Class>
  <owl:Class rdf:about="#trm_4a3fd79d09f36">
    <skos:prefLabel>creative problem solving</skos:prefLabel>
    <dc:Title>creative problem solving</dc:Title>
    <skos:definition>the mental process of independently creating a solution to a problem without learned assistance.</skos:definition>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660629031</dc:Date>
