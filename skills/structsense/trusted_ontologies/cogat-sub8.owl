  <owl:Class rdf:about="#trm_5023ef8eab626">
    <dc:Title>delay conditioning</dc:Title>
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
    <rdfs:label>delay conditioning</rdfs:label>
    <dc:identifier>trm_5023ef8eab626</dc:identifier>
    <skos:definition>a subtype of classical conditioning in which the conditional stimulus (CS) is presented and, during this presentation, a biologically relevant unconditional stimulus (US) is also presented. Afterward the subject is tested for its reaction to the CS in isolation.</skos:definition>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660592133</dc:date>
    <skos:prefLabel>delay conditioning</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="#trm_5521a7a1376ed">
    <dc:Contributor>usr_4e42a3196fbcd</dc:Contributor>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660642084</dc:Date>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nee2dbceb2136420cad4d14b17e43a0a2">
        <owl:onProperty rdf:resource="https://raw.githubusercontent.com/oborel/obo-relations/master/ro.owlkind_of"/>
        <owl:someValuesFrom rdf:resource="trm_4e89aebaa311d"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <skos:definition>is a kind of priming in which the speed of processing is slower than unprimed levels. It is caused by experiencing the stimulus and then ignoring it</skos:definition>
    <skos:prefLabel>negative priming</skos:prefLabel>
    <dc:Title>negative priming</dc:Title>
  </owl:Class>
