  <owl:Class rdf:about="#trm_5208fe678c652">
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
    <rdfs:label>Social Responsiveness Scale</rdfs:label>
    <dc:identifier>trm_5208fe678c652</dc:identifier>
    <dc:Title>Social Responsiveness Scale</dc:Title>
    <skos:prefLabel>Social Responsiveness Scale</skos:prefLabel>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660594127</dc:date>
    <skos:definition>The social responsiveness scale (SRS) is a 65 item rating scale used to assess social awareness, social information processing, capacity for reciprocal social communication, social anxiety/avoidance, and autistic preoccupations and traits.  The original SRS is completed by a parent or teacher for children from 4 to 18 years of age. The second version of the SRS is extended to 2.5 years into adulthood, validated on a larger sample, and allowing for self-report.&#13;
&#13;
Subscales Include:&#13;
1. Social Awareness&#13;
2. Social Cognition&#13;
3. Social Communication&#13;
4. Social Motivation&#13;
5. Restricted Interests and Repetitive Behavior&#13;
&#13;
Additionally, the Total Score reflects overall severity of social deficits.</skos:definition>
    <skos:altLabel>SRS, SRS-2</skos:altLabel>
  </owl:Class>
  <owl:Restriction rdf:nodeID="Nc0fc91fb061145b38e4e74ce81ae9d93">
    <owl:someValuesFrom rdf:resource="#cnt_4ebcaa463d20e"/>
    <owl:onProperty rdf:resource="http://www.cogpo.org/ontologies/CogPOver1.owlhas_contrast"/>
  </owl:Restriction>
