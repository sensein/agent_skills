  </owl:Restriction>
  <owl:Class rdf:about="#tsk_4a57abb949f12">
    <skos:altLabel>WAIS</skos:altLabel>
    <dc:identifier>tsk_4a57abb949f12</dc:identifier>
    <skos:prefLabel>Wechsler Adult Intelligence Scale - Revised</skos:prefLabel>
    <dc:Title>Wechsler Adult Intelligence Scale - Revised</dc:Title>
    <dc:Contributor>usr_4b9003ea0be96</dc:Contributor>
    <skos:definition>used with adults ages 16 to 90 and measures cognitive ability using a core battery of 10 unique subtests that focus on four specific domains of intelligence: verbal comprehension, perceptual reasoning, working memory, and processing speed. </skos:definition>
    <rdfs:label>Wechsler Adult Intelligence Scale - Revised</rdfs:label>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660586585</dc:date>
  </owl:Class>
  <owl:Restriction rdf:nodeID="Nc4dfcf555c134306b79f04c595bc5928">
    <owl:someValuesFrom rdf:resource="#con_4dfa891db4ac6"/>
    <owl:onProperty rdf:resource="https://raw.githubusercontent.com/oborel/obo-relations/master/ro.owlhas_part"/>
  </owl:Restriction>
  <owl:Class rdf:about="#trm_4a3fd79d09a55">
    <dc:Contributor>usr_4cf5de07654c8</dc:Contributor>
    <skos:definition>is provided by auditory stimulation in response to specific behavior. The feedback may be used to amend subsequent behavior, cognition, perception or performance.&#13;
</skos:definition>
    <skos:prefLabel>auditory feedback</skos:prefLabel>
