  <owl:Class rdf:about="#tsk_4a57abb949d4e">
    <skos:definition>&amp;#34;Reversal learning involves the adaptation of behavior according to changes in stimulusâreward contingencies [...] [Reversal learning]is exemplified by visual discrimination tasks where subjects must learn to respond according to the opposite, previously irrelevant, stimulusâreward pairing.&amp;#34; - (Clark, Cools, &amp; Robbins 2004)</skos:definition>
    <dc:Title>reversal learning task</dc:Title>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660585536</dc:date>
    <rdfs:label>reversal learning task</rdfs:label>
