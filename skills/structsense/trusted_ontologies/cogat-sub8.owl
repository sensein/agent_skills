    <dc:Contributor>usr_4d7fd2c7d9e4d</dc:Contributor>
    <skos:hasTopConcept rdf:resource="#ctp_C3"/>
    <skos:definition>Generic knowledge is knowledge that is applicable not just to a single entity but to a class of entities. </skos:definition>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660630595</dc:Date>
    <skos:prefLabel>generic knowledge</skos:prefLabel>
