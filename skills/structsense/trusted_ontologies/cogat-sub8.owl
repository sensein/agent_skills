  <owl:Class rdf:about="#trm_4c89924414c69">
    <skos:prefLabel>pitch/monitor discrimination</skos:prefLabel>
    <dc:Title>pitch/monitor discrimination</dc:Title>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660582476</dc:date>
    <rdfs:label>pitch/monitor discrimination</rdfs:label>
    <skos:altLabel>pitch discrimination task</skos:altLabel>
    <skos:definition>Subjects are presented with various stimuli (human speech and non-speech vocalizations, animal vocalization, mechanical noise, etc.) and are instructed to listen to them passively (also co-coded with Passive Listening), or discriminate based on pitch (pleasant/unpleasant, same/different, duration, familiar/unfamiliar, male/female).</skos:definition>
    <dc:identifier>trm_4c89924414c69</dc:identifier>
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
  </owl:Class>
