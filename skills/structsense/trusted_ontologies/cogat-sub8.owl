  <owl:Class rdf:about="#trm_4c8a82ba8a538">
    <dc:Title>reading (covert)</dc:Title>
    <rdfs:label>reading (covert)</rdfs:label>
    <dc:Contributor>usr_49a467bf4e0db</dc:Contributor>
    <skos:prefLabel>reading (covert)</skos:prefLabel>
    <dc:identifier>trm_4c8a82ba8a538</dc:identifier>
    <skos:definition>Subjects view words, pseudo-words,  Asian characters, phrases, or sentences and read them silently.</skos:definition>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660582546</dc:date>
    <skos:altLabel>covert reading task, silent reading task, silent production task</skos:altLabel>
  </owl:Class>
