  <owl:Class rdf:about="#trm_4f244d2a54e27">
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660591432</dc:date>
    <skos:definition>in a semi-structured interview a participant is asked to recall recent events (within one week, within one month) in his or her own life, and this recollection is compared with report(s) from a &amp;#34;collateral source,&amp;#34; a person close to the participant</skos:definition>
    <dc:Title>autobiographical memory task</dc:Title>
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
    <dc:identifier>trm_4f244d2a54e27</dc:identifier>
