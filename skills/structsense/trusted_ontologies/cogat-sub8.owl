  <owl:Class rdf:about="#tsk_4a57abb949a33">
    <rdfs:label>doors and people test</rdfs:label>
    <skos:definition>Doors and People is a test of long-term memory. It yields a single age-scaled overall score which can be âunpackedâ to give separate measures of visual and verbal memory, recall and recognition, and forgetting.</skos:definition>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660584254</dc:date>
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
    <dc:identifier>tsk_4a57abb949a33</dc:identifier>
