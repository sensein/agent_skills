  <owl:Class rdf:about="#tsk_4a57abb949ea5">
    <rdfs:label>Test of Word Reading Efficiency</rdfs:label>
    <dc:Title>Test of Word Reading Efficiency</dc:Title>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660586293</dc:date>
    <skos:definition>a nationally normed measure of word reading accuracy and fluency that provides an efficient means of monitoring the growth of two kinds of word reading skills that are critical in the development of overall reading ability: the ability to accurately recognize familiar words as whole units or âsight wordsâ and the ability to âsound outâ words quickly. </skos:definition>
    <dc:identifier>tsk_4a57abb949ea5</dc:identifier>
    <skos:prefLabel>Test of Word Reading Efficiency</skos:prefLabel>
    <dc:Contributor>usr_4b9003ea0be96</dc:Contributor>
    <skos:altLabel>TOWRE</skos:altLabel>
  </owl:Class>
