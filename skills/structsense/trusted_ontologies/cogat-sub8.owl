  <owl:Class rdf:about="#tsk_4a57abb949d32">
    <dc:Title>pyramids and palm trees task</dc:Title>
    <dc:Contributor>usr_49a467bf4e0db</dc:Contributor>
    <rdfs:label>pyramids and palm trees task</rdfs:label>
    <dc:identifier>tsk_4a57abb949d32</dc:identifier>
    <skos:definition>a semantic memory test that presents one word or picture above two others. The participant is then asked to identify which of the bottom items best matches the top item. Semantic memory is necessary for the identification of the analogies, which link conceptually two perceptually, and functionally distinct entities.</skos:definition>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660585479</dc:date>
    <skos:prefLabel>pyramids and palm trees task</skos:prefLabel>
    <skos:altLabel>palmtrees and pyramids task</skos:altLabel>
  </owl:Class>
  <owl:Class rdf:about="#tsk_4a57abb949a78">
    <dc:Contributor>usr_4b9003ea0be96</dc:Contributor>
    <skos:definition>a standard instrument for assessing the intensity of physical addiction to nicotine.</skos:definition>
    <dc:identifier>tsk_4a57abb949a78</dc:identifier>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660584428</dc:date>
