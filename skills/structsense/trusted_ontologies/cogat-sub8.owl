    <dc:identifier>trm_54f93101b2fd8</dc:identifier>
    <rdfs:label>think/no-think task</rdfs:label>
    <skos:prefLabel>think/no-think task</skos:prefLabel>
    <skos:definition>A task in which subjects are cued to either remember or suppress the memory for a specific association that was previously learned.</skos:definition>
  </owl:Class>
  <owl:Restriction rdf:nodeID="N854d23771dbd4e98ba7ce3d49467b10d">
    <owl:someValuesFrom rdf:resource="#cnt_58a5d349d8618"/>
    <owl:onProperty rdf:resource="http://www.cogpo.org/ontologies/CogPOver1.owlhas_contrast"/>
  </owl:Restriction>
  <owl:Class rdf:about="#trm_50b65ef129e23">
    <skos:definition>Participants are given several sets of characters or stimuli to respond to. In Sperling&amp;#39;s version of the task, participants are cued to recall just one subset. Due to the fact that participants did not know which row would be cued for recall, performance in the partial report condition can be regarded as a random sample of an observer&amp;#39;s memory for the entire display. Another version involves participants responding by pressing a button when they see only a certain stimulus out of a set appear.</skos:definition>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660592036</dc:date>
    <dc:identifier>trm_50b65ef129e23</dc:identifier>
    <dc:Contributor>usr_4de5345b3b6a8</dc:Contributor>
    <rdfs:label>Partial Report Procedure</rdfs:label>
    <skos:prefLabel>Partial Report Procedure</skos:prefLabel>
    <dc:Title>Partial Report Procedure</dc:Title>
  </owl:Class>
