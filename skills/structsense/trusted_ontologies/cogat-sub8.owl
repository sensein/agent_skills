    <rdfs:label>clock drawing task</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#trm_4c8a840d6f969">
    <skos:definition>Subjects view pictures and are instructed to respond to emotional pictures, to indicate which pictures are pleasant/unpleasant or funny/not funny, or rate the valence of emotional pictures.</skos:definition>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660582831</dc:date>
