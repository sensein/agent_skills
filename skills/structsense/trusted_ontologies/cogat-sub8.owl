  <owl:Class rdf:about="#tsk_GdteOhkqZJLYg">
    <skos:prefLabel>Pursuit Tracking Task</skos:prefLabel>
    <dc:Title>Pursuit Tracking Task</dc:Title>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1528260430186</dc:date>
    <dc:identifier>tsk_GdteOhkqZJLYg</dc:identifier>
    <skos:definition>A pursuit tracking task is a task that assesses eye–hand coordination, in which a user is operating a display that has an indicator controlled by a computer mouse, trackball, or other controlling device. The user must try to keep the indicator on a moving trail or road with or without preview. </skos:definition>
    <rdfs:label>Pursuit Tracking Task</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#trm_4a3fd79d0b0bd">
    <skos:prefLabel>serial processing</skos:prefLabel>
    <dc:Title>serial processing</dc:Title>
    <skos:altLabel>intermittent processing, sequential processing</skos:altLabel>
