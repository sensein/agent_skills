  <owl:Class rdf:about="#trm_5550e5011ce10">
    <dc:identifier>trm_5550e5011ce10</dc:identifier>
    <skos:prefLabel>audio narrative</skos:prefLabel>
    <dc:Title>audio narrative</dc:Title>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660598276</dc:date>
    <rdfs:label>audio narrative</rdfs:label>
    <dc:Contributor>usr_5550e439ddade</dc:Contributor>
    <skos:definition>Audio narratives tell stories through sound alone: narration, interviews, live and archival sound recordings, environmental soundscapes, sound effects, found sounds, etc. Audio narratives use storytelling along with other audio means to create intimate experiences through characters, plot, and setting.</skos:definition>
  </owl:Class>
