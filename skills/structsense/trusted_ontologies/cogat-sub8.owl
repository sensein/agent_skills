  <owl:Class rdf:about="#trm_4a3fd79d0a92b">
    <skos:definition>a learners&amp;#39; automatic awareness of their own knowledge and their ability to understand, control, and manipulate their own cognitive processes.&#13;
</skos:definition>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660632619</dc:Date>
    <skos:prefLabel>metacognitive skill</skos:prefLabel>
    <dc:Title>metacognitive skill</dc:Title>
    <skos:hasTopConcept rdf:resource="#ctp_C5"/>
    <dc:Contributor>usr_4cf5de07654c8</dc:Contributor>
  </owl:Class>
  <owl:Class rdf:about="#trm_4a3fd79d0b61f">
    <skos:prefLabel>decision</skos:prefLabel>
    <dc:Title>decision</dc:Title>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660636931</dc:Date>
    <skos:hasTopConcept rdf:resource="#ctp_C3"/>
    <dc:Contributor>usr_4ac2cdeede9e6</dc:Contributor>
    <skos:definition>The outcome of a process during which a choice is made, usually between several possible options</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="#trm_4f24479b0db8f">
    <rdfs:label>phoneme detection task</rdfs:label>
