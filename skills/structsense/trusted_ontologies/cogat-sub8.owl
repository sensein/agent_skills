    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660600779</dc:date>
    <dc:Contributor>usr_579611e01221d</dc:Contributor>
    <skos:prefLabel>orientation test</skos:prefLabel>
    <dc:Title>orientation test</dc:Title>
    <skos:definition>The participant is asked questions to test their orientation in time and place. These include questions about the date, day of the week, season, name of current hospital and name of city.</skos:definition>
    <rdfs:label>orientation test</rdfs:label>
  </owl:Class>
