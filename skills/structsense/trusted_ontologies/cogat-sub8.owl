  <owl:Class rdf:about="#trm_52405de6b7a63">
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660641296</dc:Date>
    <skos:definition>A kind of disordered thinking for which thought and emotions are so impaired that contact is lost with external reality.</skos:definition>
