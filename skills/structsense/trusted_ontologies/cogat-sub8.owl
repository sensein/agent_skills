  <owl:Class rdf:about="#tsk_4a57abb949bb1">
    <skos:altLabel>MMSE, Folstein test</skos:altLabel>
    <skos:definition>The mini-mental state examination (MMSE) or Folstein test is a brief 30-point questionnaire test that is used to screen for cognitive impairment. It is commonly used in medicine to screen for dementia. It is also used to estimate the severity of cognitive impairment at a given point in time and to follow the course of cognitive changes in an individual over time, thus making it an effective way to document an individual&amp;#39;s response to treatment.</skos:definition>
    <dc:Title>Mini Mental State Examination</dc:Title>
    <dc:Contributor>usr_4ffbda803dbd6</dc:Contributor>
    <rdfs:label>Mini Mental State Examination</rdfs:label>
    <dc:identifier>tsk_4a57abb949bb1</dc:identifier>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660585013</dc:date>
    <skos:prefLabel>Mini Mental State Examination</skos:prefLabel>
  </owl:Class>
