  <owl:Class rdf:about="#trm_4b86c473a7166">
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
    <skos:prefLabel>underlining test</skos:prefLabel>
    <skos:definition>This test involves finding and underlining stimuli among other stimuli.  There are four conditions of the test: finding and underlining letters among other letters, drawings among other drawings, real words among nonsense letter strings, and then specific nonsense words among others.  </skos:definition>
    <dc:Title>underlining test</dc:Title>
