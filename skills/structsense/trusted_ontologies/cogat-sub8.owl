  <owl:Class rdf:about="#trm_523df616da8a6">
    <rdfs:label>adolescent symptom inventory</rdfs:label>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660594271</dc:date>
    <dc:identifier>trm_523df616da8a6</dc:identifier>
    <skos:prefLabel>adolescent symptom inventory</skos:prefLabel>
    <skos:altLabel>ASI, ASI-4</skos:altLabel>
    <skos:definition>The Adolescent Symptom Inventory (4th version) is a 120 question rating scale that screens for 18 DSM-IV emotional and behavioral disorders in youths between 12 and 18 years old.  These scores have shown a high correspondence with psychiatric diagnoses.</skos:definition>
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
    <dc:Title>adolescent symptom inventory</dc:Title>
  </owl:Class>
  <owl:Class rdf:about="#trm_526027c99b726">
