      </owl:Restriction>
    </rdfs:subClassOf>
    <skos:definition>The effortful control of behaviors, thoughts, or emotions with the aim of increasing the likelihood of attaining long-term over short-term outcomes.</skos:definition>
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
  </owl:Class>
  <owl:Class rdf:about="#trm_4a3fd79d0a36a">
    <skos:prefLabel>fixed action patterns</skos:prefLabel>
    <skos:definition>an instinctive  behavioral  sequence that is indivisible and runs to completion.</skos:definition>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660630400</dc:Date>
    <dc:Contributor>usr_4b9003ea0be96</dc:Contributor>
