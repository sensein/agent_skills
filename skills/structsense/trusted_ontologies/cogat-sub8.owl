  <owl:Class rdf:about="#trm_4a3fd79d0a556">
    <skos:definition>Learning without explicit knowledge of doing so, but occurring through interaction with the environment (e.g., by observation/copying of behavior or response to reinforcement).</skos:definition>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660631272</dc:Date>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N56e998ddd37140368de165a1814eac50">
        <owl:onProperty rdf:resource="https://raw.githubusercontent.com/oborel/obo-relations/master/ro.owlkind_of"/>
        <owl:someValuesFrom rdf:resource="trm_565bce2791089"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc:Title>incidental learning</dc:Title>
    <skos:prefLabel>incidental learning</skos:prefLabel>
    <dc:Contributor>usr_4a5bc4a2a8aba</dc:Contributor>
    <skos:hasTopConcept rdf:resource="#ctp_C5"/>
  </owl:Class>
  <owl:Restriction rdf:nodeID="N4a8039cb23ac431fb5ead1fbcd9bc4bb">
    <owl:onProperty rdf:resource="https://raw.githubusercontent.com/oborel/obo-relations/master/ro.owlhas_part"/>
    <owl:someValuesFrom rdf:resource="#con_4ebd5a0be306a"/>
  </owl:Restriction>
  <owl:Class rdf:about="#trm_553e85265f51e">
    <rdfs:label>functional localizer fMRI tasks</rdfs:label>
    <skos:prefLabel>functional localizer fMRI tasks</skos:prefLabel>
    <dc:Title>functional localizer fMRI tasks</dc:Title>
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
    <skos:definition>This is a simple and fast acquisition procedure based on a 5-minute functional magnetic resonance imaging (fMRI) sequence that can be run as easily and as systematically as an anatomical scan. This protocol captures the cerebral bases of auditory and visual perception, motor actions, reading, language comprehension and mental calculation at an individual level. Individual functional maps are reliable and quite precise. This description, and full details are available at: http://www.unicog.org/pm/pmwiki.php/Site/FunctionalLocalizer</skos:definition>
    <dc:identifier>trm_553e85265f51e</dc:identifier>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660597886</dc:date>
  </owl:Class>
  <owl:Class rdf:about="#trm_5696bcf1b5c64">
    <dc:identifier>trm_5696bcf1b5c64</dc:identifier>
    <dc:Title>Tower of London Imagine</dc:Title>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660599417</dc:date>
    <skos:definition>participants must mentally rearrange a set of three colored balls arranged on pegs, in the fewest possible moves, to match a specified configuration.</skos:definition>
    <rdfs:label>Tower of London Imagine</rdfs:label>
    <skos:prefLabel>Tower of London Imagine</skos:prefLabel>
    <dc:Contributor>usr_566738e285cfc</dc:Contributor>
  </owl:Class>
  <owl:Class rdf:about="#trm_50eb54d78841b">
    <dc:Title>NIH Toolbox Standing Balance Test</dc:Title>
    <rdfs:label>NIH Toolbox Standing Balance Test</rdfs:label>
    <skos:prefLabel>NIH Toolbox Standing Balance Test</skos:prefLabel>
    <skos:definition>The Standing Balance Test is a measure developed to assess static standing balance. It involves the participant assuming and maintaining up to five poses for 50 seconds each. The sequence of poses is: eyes open on a solid surface, eyes closed on a solid surface, eyes open on a 18 foam surface, eyes closed on a foam surface, eyes open in tandem stance on a solid surface. Detailed stopping rules are in place to ensure participant safety with these progressively demanding poses. Postural sway is recorded for each pose using an accelerometer that the participant wears at waist level.</skos:definition>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660592844</dc:date>
    <dc:Contributor>usr_4de5345b3b6a8</dc:Contributor>
    <dc:identifier>trm_50eb54d78841b</dc:identifier>
  </owl:Class>
  <owl:Restriction rdf:nodeID="Nfa1a9f23dda548078dc62d2a96b67f61">
    <owl:someValuesFrom rdf:resource="#cnt_501702188843e"/>
    <owl:onProperty rdf:resource="http://www.cogpo.org/ontologies/CogPOver1.owlhas_contrast"/>
  </owl:Restriction>
  <owl:Restriction rdf:nodeID="N134fd0babab24048b09b5924f783fd41">
    <owl:onProperty rdf:resource="http://www.cogpo.org/ontologies/CogPOver1.owlhas_contrast"/>
    <owl:someValuesFrom rdf:resource="#cnt_553151dd37b0d"/>
  </owl:Restriction>
  <owl:Class rdf:about="#trm_553e77e53497d">
    <rdfs:label>cue approach task</rdfs:label>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660597856</dc:date>
    <skos:definition>This task is a type of cue-approach training in which participants observe images of individual food items presented for 1 s  and are instructed to press a button as fast as possible (before the image disappears) only when they hear a tone (i.e., Go trials). There is no feedback to the participants regarding the success of the button press in the allotted time window. Full details can be read about: http://www.nature.com/neuro/journal/v17/n4/full/nn.3673.html</skos:definition>
    <skos:prefLabel>cue approach task</skos:prefLabel>
    <dc:identifier>trm_553e77e53497d</dc:identifier>
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
    <dc:Title>cue approach task</dc:Title>
  </owl:Class>
  <owl:Class rdf:about="#trm_4a3fd79d0adc3">
    <skos:definition>Knowledge exercised in the performance of a task/activity. Its acquisition or structure is often unavailable to the actor.</skos:definition>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660633941</dc:Date>
    <skos:prefLabel>procedural knowledge</skos:prefLabel>
    <dc:Title>procedural knowledge</dc:Title>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nbf1d5b627cc742b394ecf86a0040a07e">
        <owl:onProperty rdf:resource="https://raw.githubusercontent.com/oborel/obo-relations/master/ro.owlkind_of"/>
        <owl:someValuesFrom rdf:resource="trm_4a3fd79d0a746"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc:Contributor>usr_49a467bf4e0db</dc:Contributor>
    <skos:hasTopConcept rdf:resource="#ctp_C5"/>
  </owl:Class>
  <owl:Class rdf:about="#trm_4a3fd79d0ba30">
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660638331</dc:Date>
    <dc:Contributor>usr_4a5bc4a2a8aba</dc:Contributor>
    <skos:prefLabel>maintenance</skos:prefLabel>
    <dc:Title>maintenance</dc:Title>
    <skos:definition>The process of keeping information in active and immediately accessible state.</skos:definition>
    <skos:hasTopConcept rdf:resource="#ctp_C4"/>
  </owl:Class>
