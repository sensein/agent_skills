    <dc:Title>adult attachment interview</dc:Title>
    <skos:definition>Standardized interview used to assess developmental and attachment history.  </skos:definition>
    <rdfs:label>adult attachment interview</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#tsk_4a57abb949f4a">
    <skos:definition>is the process of determining the pronunciation and some degree of meaning of an unknown word. Note: Word- identification skills commonly taught are phonic analysis, structural analysis, context clues, configuration clues, dictionary skills, and sometimes picture clues.&#13;
</skos:definition>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660586702</dc:date>
    <rdfs:label>word identification</rdfs:label>
