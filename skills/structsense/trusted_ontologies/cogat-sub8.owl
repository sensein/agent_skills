  <owl:Class rdf:about="#trm_4ee8facd77dfc">
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660639279</dc:Date>
    <skos:prefLabel>self control</skos:prefLabel>
    <dc:Title>self control</dc:Title>
    <skos:altLabel>Self-regulation, willpower, ego strength, self-discipline</skos:altLabel>
    <skos:hasTopConcept rdf:resource="#ctp_C4"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N446cd7dbe70545feb71c513a7fabf1ab">
        <owl:someValuesFrom rdf:resource="trm_4aae62e4ad209"/>
        <owl:someValuesFrom rdf:resource="cnt_527186d95c3cb"/>
