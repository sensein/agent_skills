  <owl:Class rdf:about="#trm_4f24226fa2903">
    <skos:altLabel>Fitts&amp;#39; task, Fitts tapping task</skos:altLabel>
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
    <dc:identifier>trm_4f24226fa2903</dc:identifier>
    <dc:Title>Fitts task</dc:Title>
    <skos:definition>any task requiring a rapid, aimed movement to acquire a target, the time of which is measured and, according to Fitts&amp;#39; law, is generally inversely proportionate to distance required and target size</skos:definition>
