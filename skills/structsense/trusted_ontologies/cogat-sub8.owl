  <owl:Class rdf:about="#trm_4a3fd79d0b826">
    <skos:prefLabel>lexical processing</skos:prefLabel>
    <skos:definition>A general term referring to the processing of single words, typically in the context of visual or auditory word recognition.</skos:definition>
