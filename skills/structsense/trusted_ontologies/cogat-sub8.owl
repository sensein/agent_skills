    <skos:definition>a phenomenon in which people fail to see an unexpected stimulus</skos:definition>
    <skos:altLabel>perceptual blindness</skos:altLabel>
  </owl:Class>
  <owl:Class rdf:about="#trm_5154a9f45903f">
    <skos:definition>The capacity to perceive someoneâs emotional state non-verbally based on facial expressions. Examples include affect recognition, facial recognition and characterization.</skos:definition>
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
