  <owl:Class rdf:about="#trm_4a3fd79d0a1a2">
    <dc:Title>emotional intelligence</dc:Title>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660629872</dc:Date>
    <skos:hasTopConcept rdf:resource="#ctp_C8"/>
    <dc:Contributor>usr_49a467bf4e0db</dc:Contributor>
    <skos:definition>the capacity, skill or ability to identify, assess, and manage the emotions of one&amp;#39;s self, of others, and of groups.</skos:definition>
