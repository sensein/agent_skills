  <owl:Class rdf:about="#trm_557b4817db34d">
    <skos:definition>the process of comparing, at an idiosyncratic level, the economic value of two or more options.</skos:definition>
    <skos:prefLabel>economic value processing</skos:prefLabel>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660642327</dc:Date>
