  <owl:Class rdf:about="#trm_4c898cb4ada49">
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660581553</dc:date>
    <dc:Title>face monitor/discrimination</dc:Title>
    <skos:prefLabel>face monitor/discrimination</skos:prefLabel>
    <skos:definition>Subjects are presented with human faces and are instructed to view them passively or discriminate according to their order, gender, location, emotion, or appearance.  If the subjects view the faces passively, then the experiment is NOT co-coded with Passive Viewing.</skos:definition>
    <rdfs:label>face monitor/discrimination</rdfs:label>
    <dc:identifier>trm_4c898cb4ada49</dc:identifier>
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
  </owl:Class>
  <owl:Class rdf:about="#trm_5159c971bf444">
    <dc:Title>effort valuation</dc:Title>
    <skos:definition>Processes by which the cost(s) of obtaining an outcome is computed; tendency to overcome response costs to obtain a reinforcer.</skos:definition>
    <dc:Contributor>usr_4de5345b3b6a8</dc:Contributor>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660640807</dc:Date>
