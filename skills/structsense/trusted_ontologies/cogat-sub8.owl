  <owl:Class rdf:about="#trm_4a3fd79d0b5e3">
    <dc:Contributor>usr_4a5bc4a2a8aba</dc:Contributor>
    <skos:prefLabel>attention span</skos:prefLabel>
    <dc:Title>attention span</dc:Title>
    <skos:hasTopConcept rdf:resource="#ctp_C2"/>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660636823</dc:Date>
    <skos:definition>Amount of time or space that an individual can dedicate to particular task or content without becoming distracted.</skos:definition>
  </owl:Class>
