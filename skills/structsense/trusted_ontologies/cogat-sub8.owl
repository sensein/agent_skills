    </rdfs:subClassOf>
    <dc:Contributor>usr_4e42a3196fbcd</dc:Contributor>
    <skos:definition>is a specific form of priming that occurs when a subject experiences an act of kindness and subsequently experiences a lower threshold of activation when subsequently encountering positive stimuli.</skos:definition>
    <skos:prefLabel>kindness priming</skos:prefLabel>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N09a39cc020974e50bb4874173b9d45c6">
        <owl:onProperty rdf:resource="https://raw.githubusercontent.com/oborel/obo-relations/master/ro.owlkind_of"/>
        <owl:someValuesFrom rdf:resource="trm_4e89aebaa311d"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660642062</dc:Date>
  </owl:Class>
