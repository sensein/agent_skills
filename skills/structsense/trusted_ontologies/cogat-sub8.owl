  <owl:Class rdf:about="#trm_586fd45d1bd21">
    <skos:prefLabel>vertical checkerboard</skos:prefLabel>
    <dc:Title>vertical checkerboard</dc:Title>
    <dc:Contributor>usr_583366685f18a</dc:Contributor>
    <rdfs:label>vertical checkerboard</rdfs:label>
    <skos:definition>The subject views a flashing checkerboard with a vertical elongated shape. As a simplified retinotopic mapping procedure., this provides a rough definition of the boundary between some visual areas, e.g. V1 and V2. This is often contrasted with horizontal checkerboards.</skos:definition>
    <dc:identifier>trm_586fd45d1bd21</dc:identifier>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660601216</dc:date>
  </owl:Class>
