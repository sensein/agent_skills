  </owl:Class>
  <owl:Class rdf:about="#trm_4c40d4054f38b">
    <skos:definition>A task in which subjects are first shown a set of categories to keep track of for a particular trial (e.g., animals, colors, and countries).  They are then presented with words (including words from each category), and must remember the last word that was presented from each of the categories and recall those words at the end of the trial.  </skos:definition>
    <dc:Title>keep-track task</dc:Title>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660580987</dc:date>
    <dc:Contributor>usr_49a467bf4e0db</dc:Contributor>
    <rdfs:label>keep-track task</rdfs:label>
    <skos:prefLabel>keep-track task</skos:prefLabel>
    <dc:identifier>trm_4c40d4054f38b</dc:identifier>
  </owl:Class>
