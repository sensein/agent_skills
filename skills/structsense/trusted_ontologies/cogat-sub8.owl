    <dc:Title>narrative</dc:Title>
    <skos:hasTopConcept rdf:resource="#ctp_C6"/>
    <skos:definition>a story that is created in a constructive format (as a work of writing, speech, poetry, prose, pictures, song, motion pictures, video games, theater or dance) that describes a sequence of fictional or non-fictional events.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="#trm_558c35979a284">
    <skos:definition>A task in which strings of stimuli (either sentences or strings of nonwords) are presented, followed by a probe on which the subject responds whether the probe item was present in the string of stimuli.</skos:definition>
