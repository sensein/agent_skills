        <owl:someValuesFrom rdf:resource="cnt_50f37f45b00e2"/>
        <owl:onProperty rdf:resource="https://raw.githubusercontent.com/oborel/obo-relations/master/ro.owlkind_of"/>
        <owl:someValuesFrom rdf:resource="cnt_5024229cb9cef"/>
        <owl:someValuesFrom rdf:resource="cnt_524b4bc9ee0a0"/>
      </owl:Restriction>
    </rdfs:subClassOf>
