  <owl:Class rdf:about="#trm_4da88bff0507c">
    <rdfs:label>CatBat task</rdfs:label>
    <dc:identifier>trm_4da88bff0507c</dc:identifier>
    <dc:Title>CatBat task</dc:Title>
    <skos:prefLabel>CatBat task</skos:prefLabel>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660588178</dc:date>
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
    <skos:definition>participants are asked to fill in missing letters in a written short story; the first half describes contexts for which &amp;#34;c&amp;#34; would most appropriately complete &amp;#34;_at,&amp;#34; while the second half describes contexts for which &amp;#34;b&amp;#34; would most appropriately complete &amp;#34;_at.&amp;#34; </skos:definition>
  </owl:Class>
