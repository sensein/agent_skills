  <owl:Class rdf:about="#tsk_4a57abb9499ff">
    <dc:Title>delayed recall test</dc:Title>
    <dc:Contributor>usr_4a5bc4a2a8aba</dc:Contributor>
    <rdfs:label>delayed recall test</rdfs:label>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660584135</dc:date>
    <skos:prefLabel>delayed recall test</skos:prefLabel>
    <skos:definition>A task in which participants are given information to remember (list of words or paragraph) and which they are asked to reproduce after some span of time.</skos:definition>
    <dc:identifier>tsk_4a57abb9499ff</dc:identifier>
  </owl:Class>
