  <owl:Class rdf:about="#trm_4a3fd79d0a6c5">
    <dc:Contributor>usr_4cf5de07654c8</dc:Contributor>
    <skos:prefLabel>internal speech</skos:prefLabel>
    <dc:Title>internal speech</dc:Title>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660631721</dc:Date>
    <skos:definition>also known as inner voice, internal speech, or verbal stream of consciousness is thinking in words. It also refers to the semi-constant internal monologue one has with oneself at a conscious or semi-conscious level.&#13;
&#13;
</skos:definition>
    <skos:hasTopConcept rdf:resource="#ctp_C6"/>
  </owl:Class>
