  <owl:Class rdf:about="#trm_4a3fd79d0a746">
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660631943</dc:Date>
    <skos:definition>information acquired and represented by a person through experience or education</skos:definition>
    <dc:Title>knowledge</dc:Title>
    <skos:prefLabel>knowledge</skos:prefLabel>
    <skos:hasTopConcept rdf:resource="#ctp_C5"/>
  </owl:Class>
  <owl:Class rdf:about="#trm_4a3fd79d0a53f">
    <skos:definition>a rapid learning process that takes place early in the life of a social animal and establishes a behavior pattern (as recognition of and attraction to its own kind or a substitute).</skos:definition>
    <dc:Contributor>usr_4b9003ea0be96</dc:Contributor>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660631230</dc:Date>
    <skos:prefLabel>imprinting</skos:prefLabel>
    <dc:Title>imprinting</dc:Title>
  </owl:Class>
  <owl:Class rdf:about="#trm_551b17b190582">
    <dc:Title>intensity for somatosensory stimulation</dc:Title>
    <rdfs:label>intensity for somatosensory stimulation</rdfs:label>
    <dc:identifier>trm_551b17b190582</dc:identifier>
    <skos:definition>None</skos:definition>
    <dc:Contributor>usr_4e42a3196fbcd</dc:Contributor>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660596770</dc:date>
    <skos:prefLabel>intensity for somatosensory stimulation</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="#tsk_4a57abb9499d5">
    <skos:prefLabel>cups task</skos:prefLabel>
    <dc:Title>cups task</dc:Title>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660584021</dc:date>
    <rdfs:label>cups task</rdfs:label>
    <dc:identifier>tsk_4a57abb9499d5</dc:identifier>
    <dc:Contributor>usr_49a467bf4e0db</dc:Contributor>
    <skos:definition>On each trial, participants choose between a risky and safe option. Each trial involves either gains or losses. The options are presented as a choice of cups. The risky option involves two to five cups, one containing a gain (loss) of $2, $3 or $5, and the others containing $0. If the latter option is selected, the payoff from one cup is selected at random. The safe cup offers a sure gain (loss) $1.</skos:definition>
  </owl:Class>
  <owl:Restriction rdf:nodeID="N44d346368e964f5bae386f7bb8aeb3a0">
    <owl:onProperty rdf:resource="http://www.cogpo.org/ontologies/CogPOver1.owlhas_contrast"/>
    <owl:someValuesFrom rdf:resource="#cnt_502a9a529d5d1"/>
  </owl:Restriction>
