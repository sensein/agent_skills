  <owl:Class rdf:about="#trm_4f24247912761">
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
    <dc:Title>face matching task</dc:Title>
    <rdfs:label>face matching task</rdfs:label>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660590960</dc:date>
    <dc:identifier>trm_4f24247912761</dc:identifier>
    <skos:definition>subjects view a reference face and must either simply compare two faces or select one of two differently-oriented comparison faces (e.g. reference face looks straight ahead while comparison face is a three-quarter view) that match it</skos:definition>
    <skos:prefLabel>face matching task</skos:prefLabel>
  </owl:Class>
  <owl:Restriction rdf:nodeID="N3a64d129f9234cb4b13674ab16abc18d">
    <owl:someValuesFrom rdf:resource="#con_500edb831bf11"/>
    <owl:onProperty rdf:resource="https://raw.githubusercontent.com/oborel/obo-relations/master/ro.owlhas_part"/>
