  <owl:Class rdf:about="#trm_4a3fd79d09827">
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N85d29c4a559b4cdd9bc00a7204d58d76">
        <owl:someValuesFrom rdf:resource="trm_4a3fd79d0a5ed"/>
