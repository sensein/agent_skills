  <owl:Class rdf:about="#trm_5696b316c220a">
    <dc:identifier>trm_5696b316c220a</dc:identifier>
    <dc:Contributor>usr_566738e285cfc</dc:Contributor>
    <dc:Title>Plus-minus</dc:Title>
    <rdfs:label>Plus-minus</rdfs:label>
    <skos:prefLabel>Plus-minus</skos:prefLabel>
    <skos:definition>A task where subjects are told to add by a number and are subsequently instructed to subtract by that number.</skos:definition>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660599348</dc:date>
  </owl:Class>
  <owl:Class rdf:about="#trm_4a3fd79d0b13d">
    <dc:Title>social cognition</dc:Title>
    <dc:Contributor>usr_49a467bf4e0db</dc:Contributor>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660635444</dc:Date>
    <skos:definition>the encoding, storage, retrieval, and processing, in the brain, of information relating to conspecifics, or members of the same species.</skos:definition>
    <skos:prefLabel>social cognition</skos:prefLabel>
    <skos:hasTopConcept rdf:resource="#ctp_C9"/>
  </owl:Class>
  <owl:Class rdf:about="#trm_4a3fd79d09efb">
    <skos:prefLabel>conversational structure</skos:prefLabel>
    <skos:hasTopConcept rdf:resource="#ctp_C6"/>
    <dc:Title>conversational structure</dc:Title>
    <dc:Contributor>usr_4cf5de07654c8</dc:Contributor>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660628917</dc:Date>
    <skos:definition>is the organization of interactive, more-or-less spontaneous, communication between two or more conversants.&#13;
</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="#tsk_4a57abb949dad">
    <rdfs:label>set-shifting task</rdfs:label>
    <skos:prefLabel>set-shifting task</skos:prefLabel>
    <dc:Title>set-shifting task</dc:Title>
    <skos:definition>A task in which participants alternate between two or more judgments typically regarding the same set of stimuli. Accuracy and reaction time are measured for each judgment.</skos:definition>
    <dc:identifier>tsk_4a57abb949dad</dc:identifier>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660585749</dc:date>
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
  </owl:Class>
  <owl:Class rdf:about="#trm_50eb461d446e1">
    <skos:prefLabel>NIH Toolbox Oral Symbol Digit Test</skos:prefLabel>
    <dc:Title>NIH Toolbox Oral Symbol Digit Test</dc:Title>
    <dc:Contributor>usr_4de5345b3b6a8</dc:Contributor>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660592767</dc:date>
    <dc:identifier>trm_50eb461d446e1</dc:identifier>
    <rdfs:label>NIH Toolbox Oral Symbol Digit Test</rdfs:label>
    <skos:definition>In this test, a coding key with nine abstract symbols is presented â each paired with a number between 1 and 9. Participants are asked to orally indicate which numbers go with symbols that are presented in a long string on the computer screen. The participant is given 120 seconds to call out as many numbers that go with the corresponding symbols as he/she can â without skipping any. This test is administered to ages 8-85 and takes approximately three minutes. The Oral Symbol Digit Test is a measure of processing speed. It can be administered as an accommodation in place of the Pattern Comparison processing Speed Test for those with significant motor limitations in the upper extremities.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="#trm_4e31ced566649">
    <dc:Title>multisensory integration</dc:Title>
    <dc:Contributor>usr_49a467bf4e0db</dc:Contributor>
    <skos:prefLabel>multisensory integration</skos:prefLabel>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660638987</dc:Date>
    <skos:definition>The process by which unisensory signals are combined to form a new product. It is operationally defined as a multisensory response (neural or behavioral) that is significantly different from the responses evoked by the modality-specific component stimuli</skos:definition>
    <skos:hasTopConcept rdf:resource="#ctp_C1"/>
  </owl:Class>
  <owl:Class rdf:about="#trm_5521a45a397a6">
    <skos:prefLabel>repetition priming</skos:prefLabel>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N20c0a2a7755342b5992332dac9f50f49">
        <owl:onProperty rdf:resource="https://raw.githubusercontent.com/oborel/obo-relations/master/ro.owlkind_of"/>
