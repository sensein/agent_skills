    <rdfs:label>picture-word Stroop test</rdfs:label>
    <skos:prefLabel>picture-word Stroop test</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="#trm_4a3fd79d0986c">
    <dc:Contributor>usr_4b9003ea0be96</dc:Contributor>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660626686</dc:Date>
    <skos:prefLabel>apperception</skos:prefLabel>
    <skos:definition>the process by which new experience is assimilated to and transformed by the residuum of past experience of an individual to form a new whole.</skos:definition>
    <dc:Title>apperception</dc:Title>
  </owl:Class>
