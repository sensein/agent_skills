  <owl:Class rdf:about="#trm_5696b61ff253e">
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660599370</dc:date>
    <skos:prefLabel>multi-source interference task</skos:prefLabel>
    <skos:definition>Subjects are presented with a 3 digit number and are asked to respond which of the digits differ from the other two.</skos:definition>
    <rdfs:label>multi-source interference task</rdfs:label>
    <dc:identifier>trm_5696b61ff253e</dc:identifier>
    <dc:Contributor>usr_566738e285cfc</dc:Contributor>
    <dc:Title>multi-source interference task</dc:Title>
  </owl:Class>
  <owl:Class rdf:about="#trm_4a3fd79d0ba60">
    <skos:definition>or phonological loop, also called the phonetic loop or the articulatory loop, is the part of working memory that rehearses verbal information. It consists of two parts: a short-term phonological store with auditory memory traces that are subject to rapid decay and an articulatory rehearsal component that can revive the memory traces.The first component is a phonological memory store which can hold traces of acoustic or speech based material. Material in this short term store lasts about two seconds unless it is maintained through the use of the second subcomponent, articulatory subvocal rehearsal. Prevention of articulatory rehearsal results in very rapid forgetting (a process known as decay). </skos:definition>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660638421</dc:Date>
    <dc:Contributor>usr_4cf5de07654c8</dc:Contributor>
    <dc:Title>rehearsal loop</dc:Title>
    <skos:hasTopConcept rdf:resource="#ctp_C5"/>
    <skos:prefLabel>rehearsal loop</skos:prefLabel>
  </owl:Class>
