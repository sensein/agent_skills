  <owl:Class rdf:about="#trm_4a3fd79d0a666">
    <dc:Title>intelligence</dc:Title>
    <skos:hasTopConcept rdf:resource="#ctp_C3"/>
    <dc:Contributor>usr_49a467bf4e0db</dc:Contributor>
