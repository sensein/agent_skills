  </owl:Restriction>
  <owl:Class rdf:about="#trm_4e89aebaa311d">
    <skos:definition>Priming is the effect of prior exposure to a somehow (e.g. perceptually or semantically) related stimulus on the response to a subsequent stimulus. This effect may be positive and facilitatory (e.g. naming of an object is typically faster when that object has already been recently named) or negative and detrimental (e.g. slower response to a previously ignored stimulus).</skos:definition>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N3c83dcab8c7e4a19af6b044a7542c438">
        <owl:onProperty rdf:resource="https://raw.githubusercontent.com/oborel/obo-relations/master/ro.owlkind_of"/>
        <owl:someValuesFrom rdf:resource="trm_4a3fd79d0a533"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <skos:hasTopConcept rdf:resource="#ctp_C5"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N7f632b61441e46e3bd090abdcced0583">
        <owl:onProperty rdf:resource="https://raw.githubusercontent.com/oborel/obo-relations/master/ro.owlkind_of"/>
        <owl:someValuesFrom rdf:resource="trm_565bce2791089"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660639234</dc:Date>
    <dc:Contributor>usr_49a467bf4e0db</dc:Contributor>
    <skos:prefLabel>priming</skos:prefLabel>
    <dc:Title>priming</dc:Title>
  </owl:Class>
