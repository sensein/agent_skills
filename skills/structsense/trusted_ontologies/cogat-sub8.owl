  <owl:Class rdf:about="#trm_4f2414059baa8">
    <rdfs:label>instrumental learning task</rdfs:label>
    <skos:prefLabel>instrumental learning task</skos:prefLabel>
    <dc:Title>instrumental learning task</dc:Title>
    <skos:definition>A task in which a subject learns to respond through rewards.</skos:definition>
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
    <dc:identifier>trm_4f2414059baa8</dc:identifier>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660590053</dc:date>
