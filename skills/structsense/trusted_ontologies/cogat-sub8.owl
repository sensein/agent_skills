  </owl:Restriction>
  <owl:Class rdf:about="#tsk_4a57abb949dfe">
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660585947</dc:date>
    <dc:identifier>tsk_4a57abb949dfe</dc:identifier>
    <rdfs:label>Spielberger's State-Trait Anxiety Questionnaire</rdfs:label>
    <skos:prefLabel>Spielberger's State-Trait Anxiety Questionnaire</skos:prefLabel>
    <dc:Title>Spielberger's State-Trait Anxiety Questionnaire</dc:Title>
    <skos:definition>instrument used to measure trait (chronic) anxiety, a general propensity to be anxious, and state (temporary) anxiety, a temporary state varying in intensity, in adults.</skos:definition>
    <dc:Contributor>usr_4b9003ea0be96</dc:Contributor>
  </owl:Class>
  <owl:Restriction rdf:nodeID="N6c545996a14047cd986a2526d87ccba8">
