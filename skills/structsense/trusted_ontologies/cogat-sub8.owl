  <owl:Class rdf:about="#trm_4a3fd79d09e58">
    <skos:prefLabel>constancy</skos:prefLabel>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660628641</dc:Date>
    <skos:definition>steadfastness of mind under duress; a state of being constant or unchanging.</skos:definition>
