  <owl:Class rdf:about="#trm_56a2a4dbdf127">
    <dc:Contributor>usr_569fc42c3002f</dc:Contributor>
    <skos:definition>A measure of sensorimotor ability. Also, it was designed to familiarize the participant with the computer mouse used during most of the WebCNP tasks. During the MPraxis, the participant needs to move the computer mouse cursor over an ever-shrinking green box and click on it once each time it appears on a different location on the test-page. If participants canât complete the MPraxis, it is likely they wonât be able to complete any other WebCNP task.</skos:definition>
    <skos:prefLabel>Motor Praxis</skos:prefLabel>
    <skos:altLabel>Mpraxis, Mouse Practice</skos:altLabel>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660644573</dc:Date>
    <dc:Title>Motor Praxis</dc:Title>
  </owl:Class>
