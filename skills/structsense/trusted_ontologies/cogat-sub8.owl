    <skos:prefLabel>expectancy</skos:prefLabel>
    <dc:Contributor>usr_4de5345b3b6a8</dc:Contributor>
    <dc:Title>expectancy</dc:Title>
    <skos:definition>A belief about something in the future. Sometimes requires explicit, conscious awareness, distinct from unconscious, conditioning-based learning.</skos:definition>
