  </owl:Restriction>
  <owl:Class rdf:about="#trm_4e5506161998c">
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660639119</dc:Date>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nb76fb5097ed248dcb08ba4ecf64ee815">
        <owl:onProperty rdf:resource="https://raw.githubusercontent.com/oborel/obo-relations/master/ro.owlkind_of"/>
        <owl:someValuesFrom rdf:resource="trm_4e5505361f160"/>
      </owl:Restriction>
    </rdfs:subClassOf>
