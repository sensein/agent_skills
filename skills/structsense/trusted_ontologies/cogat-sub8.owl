  <owl:Class rdf:about="#trm_4a3fd79d0a51c">
    <dc:Title>implicit knowledge</dc:Title>
    <skos:definition>knowledge that is kept in a personâs mind without necessarily being expressed in words and is often acted on instinctively.</skos:definition>
