  <owl:Class rdf:about="#trm_5696a599bfcb6">
    <dc:Title>Bickel Titrator</dc:Title>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660598861</dc:date>
    <rdfs:label>Bickel Titrator</rdfs:label>
    <dc:identifier>trm_5696a599bfcb6</dc:identifier>
    <skos:definition>A task that adjusts delay across a series of delay discounting trials, while holding the later amounts constant. This determines the Effective Delay 50(ED50), a delay period that results in the smaller immediate reward having the same value as a larger later reward.</skos:definition>
    <skos:prefLabel>Bickel Titrator</skos:prefLabel>
    <dc:Contributor>usr_566738e285cfc</dc:Contributor>
  </owl:Class>
  <owl:Class rdf:about="#trm_4a3fd79d0a891">
    <skos:prefLabel>memory</skos:prefLabel>
    <dc:Title>memory</dc:Title>
    <dc:Contributor>usr_49a467bf4e0db</dc:Contributor>
    <skos:definition>The ability of an organism to use past events to inform/influence current actions&#13;
</skos:definition>
    <skos:hasTopConcept rdf:resource="#ctp_C5"/>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660632481</dc:Date>
