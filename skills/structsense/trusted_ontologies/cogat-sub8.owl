  <owl:Class rdf:about="#trm_5154aa9735134">
    <skos:prefLabel>productive facial communication</skos:prefLabel>
    <skos:definition>The capacity to convey oneâs emotional state non-verbally via facial expressions, including eye contact, expressive reciprocation, and gaze following.</skos:definition>
    <dc:Title>productive facial communication</dc:Title>
