    <owl:someValuesFrom rdf:resource="#cnt_4de963f853b03"/>
  </owl:Restriction>
  <owl:Class rdf:about="#trm_50f382d7abdff">
    <dc:Title>vestibular control</dc:Title>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660640384</dc:Date>
    <skos:definition>The vestibular system transduces and processes angular and linear acceleration and deceleration of the head, enabling postural balance, locomotor control, and gaze stabilization, particularly during head movement. The vestibular system is an integral component of our sensory experience and sensory-motor function. Healthy peripheral and central vestibular anatomy is essential for functionally relevant gaze stability during head motion and postural control.</skos:definition>
    <dc:Contributor>usr_4de5345b3b6a8</dc:Contributor>
    <skos:prefLabel>vestibular control</skos:prefLabel>
  </owl:Class>
  <owl:Restriction rdf:nodeID="N68193b35e32143cfb0a542c08c56fd0d">
    <owl:onProperty rdf:resource="https://raw.githubusercontent.com/oborel/obo-relations/master/ro.owlhas_part"/>
    <owl:someValuesFrom rdf:resource="#con_4ebd419090a49"/>
  </owl:Restriction>
  <owl:Class rdf:about="#trm_4a3fd79d09a61">
    <dc:Contributor>usr_49a467bf4e0db</dc:Contributor>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660627218</dc:Date>
    <dc:Title>auditory grouping</dc:Title>
    <skos:hasTopConcept rdf:resource="#ctp_C1"/>
    <skos:definition>joining disparate sounds together into one percept; assessing which acoustic streams belong together</skos:definition>
    <skos:prefLabel>auditory grouping</skos:prefLabel>
  </owl:Class>
  <owl:Restriction rdf:nodeID="N8fd385f7e8664b429e2f2905c1f5901a">
    <owl:someValuesFrom rdf:resource="#cnt_4de6d45dd9ceb"/>
    <owl:onProperty rdf:resource="http://www.cogpo.org/ontologies/CogPOver1.owlhas_contrast"/>
  </owl:Restriction>
  <owl:Class rdf:about="#trm_525d847e2bd0b">
    <dc:Title>autism diagnostic interview - revised</dc:Title>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660594773</dc:date>
    <rdfs:label>autism diagnostic interview - revised</rdfs:label>
    <skos:definition>the ADI-R is a comprehensive interview that provides a thorough assessment of individuals suspected of having autism or other autism spectrum disorders. It has proven highly useful for formal diagnosis as well as treatment and educational planning.</skos:definition>
    <skos:altLabel>ADI-R</skos:altLabel>
    <skos:prefLabel>autism diagnostic interview - revised</skos:prefLabel>
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
    <dc:identifier>trm_525d847e2bd0b</dc:identifier>
  </owl:Class>
  <owl:Restriction rdf:nodeID="N31643b35d0af41cfa7dccd7865bd7d87">
    <owl:someValuesFrom rdf:resource="#cnt_4dfa71f0c9d32"/>
    <owl:onProperty rdf:resource="http://www.cogpo.org/ontologies/CogPOver1.owlhas_contrast"/>
  </owl:Restriction>
  <owl:Class rdf:about="#trm_4fbd2ac1cd035">
    <dc:Title>delayed memory task 2</dc:Title>
    <rdfs:label>delayed memory task 2</rdfs:label>
    <skos:definition>patients/participants copy pictures or geometric objects</skos:definition>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660590362</dc:date>
    <skos:prefLabel>delayed memory task 2</skos:prefLabel>
    <dc:identifier>trm_4fbd2ac1cd035</dc:identifier>
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
  </owl:Class>
  <owl:Restriction rdf:nodeID="N15818878e1d94629ac2128a413807fdb">
    <owl:onProperty rdf:resource="http://www.cogpo.org/ontologies/CogPOver1.owlhas_contrast"/>
    <owl:someValuesFrom rdf:resource="#cnt_4e02302350f17"/>
  </owl:Restriction>
  <owl:Class rdf:about="#tsk_4a57abb949d9f">
    <dc:Title>sentence completion test</dc:Title>
    <rdfs:label>sentence completion test</rdfs:label>
    <dc:identifier>tsk_4a57abb949d9f</dc:identifier>
    <skos:prefLabel>sentence completion test</skos:prefLabel>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660585714</dc:date>
    <skos:definition>a test that provides respondents with beginnings of sentences, referred to as âstems,â and respondents then complete the sentences in ways that are meaningful to them. The responses are believed to provide indications of attitudes, beliefs, motivations, or other mental states. In a common version of this test, the Hayling Sentence Completion Test, a second condition is added, in which participants must complete the sentence with a word that makes no sense, requiring them to inhibit the semantically activated information.</skos:definition>
    <dc:Contributor>usr_4de5345b3b6a8</dc:Contributor>
  </owl:Class>
  <owl:Restriction rdf:nodeID="Nf1b4793e50e248b689ab02e4686b0190">
    <owl:someValuesFrom rdf:resource="#con_4e4170453dfb1"/>
    <owl:onProperty rdf:resource="https://raw.githubusercontent.com/oborel/obo-relations/master/ro.owlhas_part"/>
  </owl:Restriction>
  <owl:Class rdf:about="#trm_4f242172aea5d">
    <dc:Title>updating task</dc:Title>
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
    <skos:prefLabel>updating task</skos:prefLabel>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660590812</dc:date>
    <skos:definition>participants are presented with lists of X items and be required to recall the N most recent; this means that the participant must hold in memory the first N items and, if X &gt; N, update the contents of memory by dropping initial for most recent items</skos:definition>
    <rdfs:label>updating task</rdfs:label>
    <dc:identifier>trm_4f242172aea5d</dc:identifier>
  </owl:Class>
  <owl:Class rdf:about="#trm_4a3fd79d0ab7c">
    <dc:Contributor>usr_4abeb2310354e</dc:Contributor>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660633355</dc:Date>
    <skos:definition>the conscious experience or mental registration of a sensory stimulus</skos:definition>
    <skos:hasTopConcept rdf:resource="#ctp_C1"/>
    <skos:prefLabel>perception</skos:prefLabel>
    <dc:Title>perception</dc:Title>
  </owl:Class>
  <owl:Restriction rdf:nodeID="N415ee55d88e14e05b1255d16a1fdbd56">
    <owl:onProperty rdf:resource="https://raw.githubusercontent.com/oborel/obo-relations/master/ro.owlhas_part"/>
    <owl:someValuesFrom rdf:resource="#con_5176d02ddd1b0"/>
  </owl:Restriction>
  <owl:Class rdf:about="#trm_4a3fd79d0ad4c">
    <skos:hasTopConcept rdf:resource="#ctp_C1"/>
    <skos:definition>is the subthreshold process of visual perception. &#13;
&#13;
</skos:definition>
    <skos:prefLabel>preconscious perception</skos:prefLabel>
    <dc:Title>preconscious perception</dc:Title>
    <dc:Contributor>usr_4cf5de07654c8</dc:Contributor>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660633825</dc:Date>
  </owl:Class>
  <owl:Restriction rdf:nodeID="Ne1b22602c0544f588849957756486111">
    <owl:someValuesFrom rdf:resource="#cnt_553e860cb6e0a"/>
    <owl:onProperty rdf:resource="http://www.cogpo.org/ontologies/CogPOver1.owlhas_contrast"/>
  </owl:Restriction>
  <owl:Class rdf:about="#trm_5159c94667677">
    <dc:Title>reward valuation</dc:Title>
    <skos:prefLabel>reward valuation</skos:prefLabel>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660640785</dc:Date>
    <dc:Contributor>usr_4de5345b3b6a8</dc:Contributor>
    <skos:definition>Processes by which the probability and benefits of a prospective outcome are computed and calibrated by reference to external information, social context (e.g., group input, counterfactual comparisons), and/or prior experience. This calibration is influenced by pre-existing biases, learning, memory, stimulus characteristics, and deprivation states. Reward valuation may involve the assignment of incentive salience to stimuli.</skos:definition>
  </owl:Class>
  <owl:Restriction rdf:nodeID="Nd630949f45ab4b10a7a45b8ebee455f0">
    <owl:someValuesFrom rdf:resource="#cnt_4de6a334313b1"/>
    <owl:onProperty rdf:resource="http://www.cogpo.org/ontologies/CogPOver1.owlhas_contrast"/>
  </owl:Restriction>
  <owl:Class rdf:about="#trm_4da891a546d8c">
    <dc:identifier>trm_4da891a546d8c</dc:identifier>
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
    <skos:definition>Series of structured and semi-structured tasks that involve social interaction between the examiner and the subject.  Subject is given opportunities to exhibit social and communication behaviors relevant to autism.</skos:definition>
    <skos:altLabel>ADOS</skos:altLabel>
    <skos:prefLabel>autism diagnostic observation schedule</skos:prefLabel>
    <dc:Title>autism diagnostic observation schedule</dc:Title>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660588655</dc:date>
    <rdfs:label>autism diagnostic observation schedule</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#trm_5519c2645167e">
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660596094</dc:date>
    <skos:definition>The tone matching task is designed to measure pitch perception. Subjects are presented with pairs of tones and are asked to indicate whether they sounded the same or different.&#13;
&#13;
Source: http://davidileitman.com/tone-matching-task/</skos:definition>
    <skos:prefLabel>Tone Matching</skos:prefLabel>
    <dc:Title>Tone Matching</dc:Title>
    <dc:identifier>trm_5519c2645167e</dc:identifier>
    <rdfs:label>Tone Matching</rdfs:label>
    <dc:Contributor>usr_4e42a3196fbcd</dc:Contributor>
  </owl:Class>
  <owl:Restriction rdf:nodeID="N0a465e20f8b64cf686f00ef76853deb8">
    <owl:someValuesFrom rdf:resource="#cnt_4de6d2747197f"/>
    <owl:onProperty rdf:resource="http://www.cogpo.org/ontologies/CogPOver1.owlhas_contrast"/>
  </owl:Restriction>
