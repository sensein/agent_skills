    <dc:Contributor>usr_4aef33d37b963</dc:Contributor>
    <dc:Title>chimeric animal Stroop task</dc:Title>
    <dc:identifier>trm_4b843655d5d75</dc:identifier>
    <rdfs:label>chimeric animal Stroop task</rdfs:label>
    <skos:altLabel>chimerical animal Stroop test</skos:altLabel>
    <skos:definition>A task in which participants are shown pictures of chimeric animals (such as a duck&amp;#39;s head attached to a cow&amp;#39;s body) and asked to name animal that the head belongs to while ignoring the identity of the body, or vice versa.  </skos:definition>
    <skos:prefLabel>chimeric animal Stroop task</skos:prefLabel>
  </owl:Class>
