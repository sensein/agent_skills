    <owl:someValuesFrom rdf:resource="#cnt_50f99e5dc7aff"/>
    <owl:onProperty rdf:resource="http://www.cogpo.org/ontologies/CogPOver1.owlhas_contrast"/>
  </owl:Restriction>
  <owl:Class rdf:about="#trm_4f241fe40a950">
    <rdfs:label>fame judgment task</rdfs:label>
    <skos:definition>participants are exposed to a list composed of famous and nonfamous names and then tested for recollection of which names are famous</skos:definition>
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
    <skos:prefLabel>fame judgment task</skos:prefLabel>
