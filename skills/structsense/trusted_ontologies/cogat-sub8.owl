  </owl:Restriction>
  <owl:Class rdf:about="#trm_4d7fc763cf777">
    <skos:prefLabel>metacomprehension</skos:prefLabel>
    <dc:Title>metacomprehension</dc:Title>
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
    <skos:definition>refers to the learners&amp;#39; ability to monitor the degree to which they understand information being communicated to them, to recognize failures to comprehend, and to employ repair strategies when failures are identified.&#13;
</skos:definition>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660638854</dc:Date>
  </owl:Class>
  <owl:Class rdf:about="#trm_500d8aef38f2c">
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660639887</dc:Date>
    <skos:definition>the illusion of movement in a stationary person caused by moving visual cues</skos:definition>
