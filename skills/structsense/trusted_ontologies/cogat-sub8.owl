  <owl:Class rdf:about="#trm_4da890f978492">
    <skos:definition>is a neurological scale that aims to give a reliable, objective way of recording the conscious state of a person for initial as well as subsequent assessment. A patient is assessed against the criteria of the scale, and the resulting points give a patient score between 3 (indicating deep unconsciousness) and either 14 (original scale) or 15 (the more widely used modified or revised scale).</skos:definition>
    <skos:prefLabel>Glasgow Coma Scale</skos:prefLabel>
    <dc:Contributor>usr_4cf5de07654c8</dc:Contributor>
    <dc:identifier>trm_4da890f978492</dc:identifier>
    <dc:Title>Glasgow Coma Scale</dc:Title>
    <rdfs:label>Glasgow Coma Scale</rdfs:label>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660588539</dc:date>
  </owl:Class>
