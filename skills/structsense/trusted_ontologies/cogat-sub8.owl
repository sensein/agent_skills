  <owl:Class rdf:about="#trm_4a3fd79d09bb3">
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660627762</dc:Date>
    <dc:Contributor>usr_4b9003ea0be96</dc:Contributor>
    <skos:definition>the difference in image location of an object seen by the left and right eyes, resulting from the eyes&amp;#39; horizontal separation. The brain uses binocular disparity to extract depth information from the two-dimensional retinal images  in stereopsis.</skos:definition>
    <skos:prefLabel>binocular disparity</skos:prefLabel>
    <dc:Title>binocular disparity</dc:Title>
    <skos:hasTopConcept rdf:resource="#ctp_C1"/>
  </owl:Class>
