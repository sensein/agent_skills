  <owl:Class rdf:about="#trm_5873d0be34b8f">
    <skos:prefLabel>emotional localizer fMRI task paradigm</skos:prefLabel>
    <dc:Contributor>usr_583366685f18a</dc:Contributor>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660601396</dc:date>
    <rdfs:label>emotional localizer fMRI task paradigm</rdfs:label>
    <dc:Title>emotional localizer fMRI task paradigm</dc:Title>
    <skos:definition>This is an emotional paradigm that include facial judgements of gender, trustworthiness and expression based on face photographs or photographs reduced to the eyes. More precisely, the following conditions were presented:&#13;
1 face gender: gender evaluation of the presented human faces;&#13;
2 face control: mental assessment on the slope of a gray-scale grid image that may be tilted or not;&#13;
3 face trusty: trustworthy evaluation of the presented human faces;&#13;
4 expression intention: trustworthy evaluation of the presented human eye images;&#13;
5 expression gender: gender evaluation of the presented human eye images;&#13;
6 expression control: mental assessment on the slope of a gray-scale grid image that may be tilted or not.</skos:definition>
    <dc:identifier>trm_5873d0be34b8f</dc:identifier>
  </owl:Class>
  <owl:Class rdf:about="#trm_4da891d43240c">
    <dc:Title>modified Erickson Scale of Communication Attitudes</dc:Title>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660588680</dc:date>
