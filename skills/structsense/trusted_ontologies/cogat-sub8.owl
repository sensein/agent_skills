  <owl:Class rdf:about="#trm_4e31d69b7f422">
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660588866</dc:date>
    <dc:Contributor>usr_4e31cbdaeab0d</dc:Contributor>
    <rdfs:label>temporal order judgment task</rdfs:label>
    <skos:prefLabel>temporal order judgment task</skos:prefLabel>
    <dc:Title>temporal order judgment task</dc:Title>
    <dc:identifier>trm_4e31d69b7f422</dc:identifier>
    <skos:definition>Participants decide which of two (or more) unimodal cues (e.g. audio or video) was presented first (or sometimes second) in a crossmodal stimulus. Alternatively, unimodal (auditory, visual or tactile) temporal order judgments generally involve deciding which of two spatial locations was presented first.</skos:definition>
    <skos:altLabel>TOJ</skos:altLabel>
  </owl:Class>
