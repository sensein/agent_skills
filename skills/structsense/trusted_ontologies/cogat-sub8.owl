    <skos:prefLabel>social motivation</skos:prefLabel>
    <dc:Title>social motivation</dc:Title>
    <skos:definition>An individual&amp;#39;s tendency to seek out direct contact with another person or a group of people.</skos:definition>
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660640956</dc:Date>
