  <owl:Class rdf:about="#tsk_4a57abb949a5d">
    <skos:prefLabel>extradimensional shift task</skos:prefLabel>
    <dc:Title>extradimensional shift task</dc:Title>
    <rdfs:label>extradimensional shift task</rdfs:label>
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660584361</dc:date>
    <skos:definition>A task in which multiple (typically two) stimuli are presented simultaneously and the subject must select the stimulus that matches the currently relevant rule. The relevant rule alternates or &amp;#34;shifts&amp;#34; among multiple (typically two) rules. The rule represents the relevant task &amp;#34;dimension&amp;#34;. The stimulus-response mappings are unique and constant within each possible rule dimension.</skos:definition>
    <dc:identifier>tsk_4a57abb949a5d</dc:identifier>
  </owl:Class>
