    <skos:prefLabel>Symptom Checklist-90-Revised </skos:prefLabel>
    <dc:Contributor>usr_4b9003ea0be96</dc:Contributor>
  </owl:Class>
  <owl:Class rdf:about="#trm_534692ef3b5df">
    <skos:prefLabel>Tapping task</skos:prefLabel>
    <dc:Title>Tapping task</dc:Title>
    <dc:identifier>trm_534692ef3b5df</dc:identifier>
    <rdfs:label>Tapping task</rdfs:label>
    <skos:definition>Subjects are instructed to move a body part corresponding to a picture. The following instructions were issued: âYou have to tap your index finger when you see a picture of a finger, flex your foot when you see a picture of a foot, and purse your lips when you see a picture of lipsâ. </skos:definition>
    <dc:Contributor>usr_49a467bf4e0db</dc:Contributor>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660595709</dc:date>
  </owl:Class>
  <owl:Restriction rdf:nodeID="N591a30310d6c4055bdd7fcc30411055d">
    <owl:someValuesFrom rdf:resource="#cnt_5022e4e75d375"/>
    <owl:onProperty rdf:resource="http://www.cogpo.org/ontologies/CogPOver1.owlhas_contrast"/>
  </owl:Restriction>
  <owl:Restriction rdf:nodeID="N3cf7836988934d578b4d7494059b20a1">
    <owl:onProperty rdf:resource="https://raw.githubusercontent.com/oborel/obo-relations/master/ro.owlhas_part"/>
    <owl:someValuesFrom rdf:resource="#con_50df0f64eaf31"/>
  </owl:Restriction>
  <owl:Class rdf:about="#trm_4d54b61a14a14">
    <skos:prefLabel>Probabilistic gambling task</skos:prefLabel>
    <dc:Title>Probabilistic gambling task</dc:Title>
    <rdfs:label>Probabilistic gambling task</rdfs:label>
    <skos:definition>Two cards are drawn without replacement from a deck containing cards numbered from one to ten (one of each). After the first card is presented, participants bet whether the next card will be higher or lower than the first card. Thus there is maximal risk when the first card is five or six, zero risk when it is ten or one. &#13;
&#13;
In later version of the task participants bet on whether the second card will be higher or lower before seeing the first card.</skos:definition>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660586752</dc:date>
    <dc:identifier>trm_4d54b61a14a14</dc:identifier>
    <dc:Contributor>usr_4ac2cdeede9e6</dc:Contributor>
  </owl:Class>
  <owl:Class rdf:about="#trm_57ebe6583f52d">
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660600492</dc:date>
    <dc:identifier>trm_57ebe6583f52d</dc:identifier>
    <dc:Contributor>usr_49a467bf4e0db</dc:Contributor>
    <rdfs:label>Moral Dilemma Task</rdfs:label>
    <dc:Title>Moral Dilemma Task</dc:Title>
    <skos:definition>Subjects are presented with vignettes describing either moral dilemmas or non-moral (control) situations.  Each vignette is associated with a question requiring a yes/no answer, and the subject responds with a button press.</skos:definition>
    <skos:prefLabel>Moral Dilemma Task</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="#trm_59cd0184eb2bf">
    <skos:definition>Chronesthesia is defined as a hypothetical ability that allows humans to be constantly aware of the past and the future.</skos:definition>
    <dc:Contributor>usr_583366685f18a</dc:Contributor>
    <skos:prefLabel>Chronesthesia</skos:prefLabel>
    <dc:Title>Chronesthesia</dc:Title>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660644686</dc:Date>
    <skos:altLabel>Mental time travel</skos:altLabel>
  </owl:Class>
