  <owl:Class rdf:about="#tsk_4a57abb949dbb">
    <skos:prefLabel>Simon task</skos:prefLabel>
    <dc:identifier>tsk_4a57abb949dbb</dc:identifier>
    <dc:Contributor>usr_4b9003ea0be96</dc:Contributor>
    <rdfs:label>Simon task</rdfs:label>
    <skos:definition>Subjects view arrows presented in the right or left visual field that were pointing to the left or right.  Subjects respond via button press as to the direction of the arrow.  In incongruent stimuli, left-pointing arrows are seen on the right side, and vice versa. </skos:definition>
    <dc:Title>Simon task</dc:Title>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660585779</dc:date>
  </owl:Class>
