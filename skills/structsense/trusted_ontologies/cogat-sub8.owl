  <owl:Class rdf:about="#trm_558c36935a0e9">
    <dc:identifier>trm_558c36935a0e9</dc:identifier>
    <dc:Contributor>usr_49a467bf4e0db</dc:Contributor>
    <skos:definition>A task in which targets are presented on a spatial grid,  followed by a probe in which the subject must choose between two spatial layouts, one of which matches the locations presented in the initial set.</skos:definition>
    <dc:Title>spatial working memory localizer task</dc:Title>
    <rdfs:label>spatial working memory localizer task</rdfs:label>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660598469</dc:date>
    <skos:prefLabel>spatial working memory localizer task</skos:prefLabel>
  </owl:Class>
