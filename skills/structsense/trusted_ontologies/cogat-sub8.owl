  <owl:Class rdf:about="#trm_5696c3fa0061a">
    <dc:Contributor>usr_566738e285cfc</dc:Contributor>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660599464</dc:date>
    <skos:prefLabel>Shift Task</skos:prefLabel>
    <dc:Title>Shift Task</dc:Title>
    <dc:identifier>trm_5696c3fa0061a</dc:identifier>
    <skos:definition>Subjects are presented with three objects that differ along three dimensions (color, shape, texture).  At any trial, the relevant dimension gives a higher probability of reward than the other two.  This dimension may shift from trial to trial.</skos:definition>
    <rdfs:label>Shift Task</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#trm_502985b4baaed">
    <skos:definition>stimuli within and/or across modalities are presented to participants, who are then to detect and/or estimate their presence or magnitude</skos:definition>
    <dc:identifier>trm_502985b4baaed</dc:identifier>
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
