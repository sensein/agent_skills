  <owl:Class rdf:about="#trm_553ebfc390256">
    <dc:Title>perceptual discrimination task</dc:Title>
    <skos:definition>Participants are asked to distinguish a gabor display that is &amp;#34;popping out&amp;#34; from one that is not, and rate their confidence on the decision on a scale of 1 (low confidence) to 6 (high confidence).  Full details are available: http://www.jneurosci.org/content/33/42/16657.full#F1</skos:definition>
    <rdfs:label>perceptual discrimination task</rdfs:label>
    <skos:prefLabel>perceptual discrimination task</skos:prefLabel>
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
    <dc:identifier>trm_553ebfc390256</dc:identifier>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660597999</dc:date>
  </owl:Class>
  <owl:Class rdf:about="#trm_4a3fd79d09c74">
    <skos:definition>the tendency to focus on one aspect of a situation and neglect others.</skos:definition>
