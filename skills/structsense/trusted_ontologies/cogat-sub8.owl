  <owl:Class rdf:about="#trm_5258346e72223">
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
    <rdfs:label>Center for Epidemiologic Studies Depression Scale</rdfs:label>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660594588</dc:date>
    <dc:Title>Center for Epidemiologic Studies Depression Scale</dc:Title>
    <skos:prefLabel>Center for Epidemiologic Studies Depression Scale</skos:prefLabel>
    <dc:identifier>trm_5258346e72223</dc:identifier>
    <skos:definition>The CES-D scale is a short self-report scale designed to measure depressive symptomatology in the general population, and is composed of items from longer scales that have been previously validated.</skos:definition>
    <skos:altLabel>CES-D</skos:altLabel>
  </owl:Class>
  <owl:Restriction rdf:nodeID="Nfda5abc9d35e48d7accd14b1a7a3cb14">
    <owl:onProperty rdf:resource="http://www.cogpo.org/ontologies/CogPOver1.owlhas_contrast"/>
