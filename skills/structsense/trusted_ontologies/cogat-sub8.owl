  <owl:Class rdf:about="#trm_57c0c1af018a5">
    <dc:Contributor>usr_49a467bf4e0db</dc:Contributor>
    <skos:prefLabel>Chapman Physical Anhedonia Scale</skos:prefLabel>
    <dc:identifier>trm_57c0c1af018a5</dc:identifier>
    <rdfs:label>Chapman Physical Anhedonia Scale</rdfs:label>
    <skos:definition>assesses a self-reported deficit in the ability to experience pleasure from typically pleasurable physical stimuli such as food, sex, and settings e.g., âBeautiful scenery has been a great delight to me.â). (from http://www.columbia.edu/cu/ssw/projects/pmap/docs/chmielewski_chapman.pdf)</skos:definition>
    <dc:Title>Chapman Physical Anhedonia Scale</dc:Title>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660601123</dc:date>
  </owl:Class>
