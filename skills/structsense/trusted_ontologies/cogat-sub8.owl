  <owl:Class rdf:about="#trm_4fba857ad04ac">
    <dc:identifier>trm_4fba857ad04ac</dc:identifier>
    <skos:definition>a number between 2 and 7 digits is displayed for a brief period and is followed briefly by a blank screen, then another number to which participants respond only if it is identical to the first.</skos:definition>
    <dc:Title>immediate memory task</dc:Title>
    <skos:prefLabel>immediate memory task</skos:prefLabel>
    <rdfs:label>immediate memory task</rdfs:label>
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660588892</dc:date>
