    <dc:Title>balance</dc:Title>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nc2e7463d8f4147d686c454d40ef6358b">
        <owl:someValuesFrom rdf:resource="trm_4a3fd79d0a972"/>
        <owl:someValuesFrom rdf:resource="cnt_50eb55fe03a71"/>
