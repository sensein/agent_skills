  <owl:Class rdf:about="#trm_551f151f7347e">
    <rdfs:label>acquired equivalence</rdfs:label>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660597303</dc:date>
    <skos:prefLabel>acquired equivalence</skos:prefLabel>
    <dc:Contributor>usr_595048b29ebdf</dc:Contributor>
    <dc:identifier>trm_551f151f7347e</dc:identifier>
    <skos:definition>Acquired equivalence is a paradigm in which generalization is increased between two superficially dissimilar stimuli (or antecedents) that have previously been associated with similar outcomes (or consequents).</skos:definition>
    <dc:Title>acquired equivalence</dc:Title>
  </owl:Class>
