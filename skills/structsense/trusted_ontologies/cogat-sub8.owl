  <owl:Class rdf:about="#trm_5798d2693915d">
    <skos:prefLabel>clock drawing task</skos:prefLabel>
    <dc:identifier>trm_5798d2693915d</dc:identifier>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660600755</dc:date>
    <dc:Contributor>usr_579611e01221d</dc:Contributor>
    <skos:definition>The participant is asked to draw a clock showing a specific time. The task is scored based on the number of features correctly drawn.</skos:definition>
