  <owl:Class rdf:about="#trm_5521a5f310604">
    <skos:prefLabel>associative priming</skos:prefLabel>
    <dc:Title>associative priming</dc:Title>
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660642018</dc:Date>
