    <dc:Contributor>usr_4e4a7f57b30e6</dc:Contributor>
    <dc:Title>capsaicin-evoked pain</dc:Title>
    <skos:definition>Capsaicin, the active ingredient of chili peppers, is injected intradermally into the skin and participants rate the experienced sensation on a rating scale.</skos:definition>
    <rdfs:label>capsaicin-evoked pain</rdfs:label>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660589224</dc:date>
    <skos:prefLabel>capsaicin-evoked pain</skos:prefLabel>
  </owl:Class>
