  <owl:Class rdf:about="#trm_523c7ba79c2f1">
    <skos:altLabel>slow, socially withdrawn</skos:altLabel>
    <dc:Title>lethargy</dc:Title>
    <skos:prefLabel>lethargy</skos:prefLabel>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660641001</dc:Date>
