    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
    <dc:Title>chewing/swallowing</dc:Title>
    <skos:definition>Subjects chew an oral stimulus that is not food (e.g., gum) or swallow their own saliva.  If the oral stimulus is food or liquid that is swallowed, then the correct paradigm class is eating/drinking</skos:definition>
    <dc:identifier>trm_4c898a8fd3afb</dc:identifier>
    <rdfs:label>chewing/swallowing</rdfs:label>
    <skos:prefLabel>chewing/swallowing</skos:prefLabel>
  </owl:Class>
