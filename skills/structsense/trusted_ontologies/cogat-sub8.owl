  <owl:Class rdf:about="#trm_4a3fd79d0b84a">
    <skos:hasTopConcept rdf:resource="#ctp_C6"/>
    <skos:prefLabel>orthography</skos:prefLabel>
    <dc:Contributor>usr_49a467bf4e0db</dc:Contributor>
    <dc:Title>orthography</dc:Title>
    <skos:definition>the representation of the sounds of a language by written or printed symbols; a part of language study that deals with letters and spelling.&#13;
</skos:definition>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660637574</dc:Date>
  </owl:Class>
  <owl:Class rdf:about="#trm_4a3fd79d0b2b4">
    <skos:prefLabel>sublexical route</skos:prefLabel>
    <dc:Contributor>usr_4b64af5545a03</dc:Contributor>
    <skos:definition>is a theoretical component of Coltheart&amp;#39;s dual-route reading model that refers to using spelling-to-sound correspondences to convert a written word (i.e. orthography) into a spoken word (i.e. phonology).  In other words, it is the route by which letters are linked to their sounds and the sounds are assembled into a whole word pronunciation.  It complements the lexical route where the whole word is recognized and linked to its sound.</skos:definition>
    <dc:Title>sublexical route</dc:Title>
    <skos:hasTopConcept rdf:resource="#ctp_C6"/>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660635861</dc:Date>
  </owl:Class>
  <owl:Restriction rdf:nodeID="N23ebf951d47e4abeb0456853fa48404a">
    <owl:onProperty rdf:resource="http://www.cogpo.org/ontologies/CogPOver1.owlhas_contrast"/>
    <owl:someValuesFrom rdf:resource="#cnt_58c80ca085301"/>
  </owl:Restriction>
