    <owl:someValuesFrom rdf:resource="#cnt_50071af2372d9"/>
    <owl:onProperty rdf:resource="http://www.cogpo.org/ontologies/CogPOver1.owlhas_contrast"/>
  </owl:Restriction>
  <owl:Class rdf:about="#tsk_4a57abb9498df">
    <rdfs:label>block tapping test</rdfs:label>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660583717</dc:date>
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
    <skos:definition>tool used for assessment of visual short-term memory and implicit visual-spatial learning. An examiner taps a series of blocks and the subject must repeat in the correct sequential order. If the sequence is correct, the examiner adds another tap to the next sequence.</skos:definition>
    <skos:prefLabel>block tapping test</skos:prefLabel>
    <dc:Title>block tapping test</dc:Title>
