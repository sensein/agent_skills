  <owl:Class rdf:about="#trm_4a3fd79d09b10">
    <dc:Title>autobiographical memory</dc:Title>
    <skos:prefLabel>autobiographical memory</skos:prefLabel>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660627551</dc:Date>
