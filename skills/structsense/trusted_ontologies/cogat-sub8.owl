  <owl:Class rdf:about="#trm_4f33e65d0daac">
    <dc:Title>embodied cognition</dc:Title>
    <skos:definition>a theory emphasizing the essentiality of the body&amp;#39;s interaction with the environment to cognition</skos:definition>
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
    <skos:prefLabel>embodied cognition</skos:prefLabel>
