  </owl:Class>
  <owl:Class rdf:about="#trm_4a3fd79d0ad64">
    <skos:definition>preconceived judgment or opinion; an adverse opinion or leaning formed without just grounds or before sufficient knowledge; an irrational attitude of hostility directed against an individual, a group, a race, or their supposed characteristics.</skos:definition>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660633854</dc:Date>
    <dc:Title>prejudice</dc:Title>
    <skos:prefLabel>prejudice</skos:prefLabel>
    <dc:Contributor>usr_4b9003ea0be96</dc:Contributor>
