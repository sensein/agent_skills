  <owl:Class rdf:about="#trm_KcaEi0Mc9grrz">
    <skos:definition>subjective experience, or sense, of time, which is measured by someone's own perception of the duration of the indefinite and unfolding of events.</skos:definition>
    <skos:hasTopConcept rdf:resource="#ctp_C1"/>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1558297168947</dc:Date>
    <skos:prefLabel>time perception</skos:prefLabel>
    <dc:Title>time perception</dc:Title>
  </owl:Class>
  <owl:Class rdf:about="#trm_50f385a8269ce">
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660593151</dc:date>
    <dc:Contributor>usr_4de5345b3b6a8</dc:Contributor>
    <skos:definition>This measure consists of a single item measuring immediate (i.e., acute) pain in adults. It asks a participant to rate level of pain experienced âover the last seven days.â The single item is simply scored on a 0-10 scale, with 0 representing no pain, and 10 representing the âworst imaginable pain.â</skos:definition>
    <skos:prefLabel>NIH Toolbox Pain Intensity Survey</skos:prefLabel>
    <dc:Title>NIH Toolbox Pain Intensity Survey</dc:Title>
    <dc:identifier>trm_50f385a8269ce</dc:identifier>
    <rdfs:label>NIH Toolbox Pain Intensity Survey</rdfs:label>
  </owl:Class>
  <owl:Restriction rdf:nodeID="N6456dd0ecaf5440d96c1cc8ddaafa075">
    <owl:onProperty rdf:resource="http://www.cogpo.org/ontologies/CogPOver1.owlhas_contrast"/>
    <owl:someValuesFrom rdf:resource="#cnt_4df8e24a62cc8"/>
  </owl:Restriction>
