  <owl:Class rdf:about="#trm_529911569b592">
    <skos:prefLabel>Halstead-Reitan Battery</skos:prefLabel>
    <dc:Title>Halstead-Reitan Battery</dc:Title>
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
    <skos:definition>The Halstead-Reitan Neuropsychological Battery is a combination of neuropsychological tests used to assess the possible physical aspects and localization of neurological damage. &#13;
&#13;
Trails A and B&#13;
Verbal Fluency&#13;
Halstead Category Test&#13;
Spatial Positional Reasoning&#13;
Tactual Performance Test&#13;
Rhythm Test&#13;
Speech Sounds Perception Test&#13;
Finger Oscillation Test&#13;
&#13;
and several ancillary tests.  See: http://www.minddisorders.com/Flu-Inv/Halstead-Reitan-Battery.html for details.&#13;
</skos:definition>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660595448</dc:date>
    <dc:identifier>trm_529911569b592</dc:identifier>
    <rdfs:label>Halstead-Reitan Battery</rdfs:label>
  </owl:Class>
