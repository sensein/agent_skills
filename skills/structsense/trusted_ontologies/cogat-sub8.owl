    <dc:Title>subjective food value</dc:Title>
    <skos:prefLabel>subjective food value</skos:prefLabel>
    <skos:hasTopConcept rdf:resource="#ctp_C3"/>
    <skos:altLabel>self-reported food pleasantness, self-reported food liking</skos:altLabel>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660643922</dc:Date>
    <skos:definition>Subjective food value is used as term to indicate a food&amp;#39;s worth, based on an individuals&amp;#39; current desires and needs (e.g., hunger). Subjective food value assessment is an intermediate  step during food decision making. </skos:definition>
    <dc:Contributor>usr_55b972918e005</dc:Contributor>
  </owl:Class>
