  <owl:Class rdf:about="#trm_4a3fd79d09e35">
    <skos:altLabel>awareness</skos:altLabel>
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
    <skos:prefLabel>consciousness</skos:prefLabel>
    <dc:Title>consciousness</dc:Title>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660628619</dc:Date>
    <skos:definition>the quality or state of being aware especially of something within oneself; the state or fact of being conscious of an external object, state, or fact; the state of being characterized by sensation, emotion, volition, and thought; the totality of conscious states of an individual; the normal state of conscious life,(regained consciousness); the upper level of mental life of which the person is aware as contrasted with unconscious processes.&#13;
</skos:definition>
  </owl:Class>
