  <owl:Class rdf:about="#trm_5798fa39b4315">
    <dc:Contributor>usr_595048b29ebdf</dc:Contributor>
    <dc:Title>American National Adult Reading Test</dc:Title>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660600996</dc:date>
    <rdfs:label>American National Adult Reading Test</rdfs:label>
    <skos:definition>The NART was specifically designed to provide a means of estimating the premorbid intelligence levels of adult patients suspected of suffering from intellectual deterioration.&#13;
The AMNART was developed for use in the USA. Words particular to British English were replaced and predicted IQ was re-standardised.</skos:definition>
    <skos:prefLabel>American National Adult Reading Test</skos:prefLabel>
    <skos:altLabel>AMNART</skos:altLabel>
    <dc:identifier>trm_5798fa39b4315</dc:identifier>
  </owl:Class>
