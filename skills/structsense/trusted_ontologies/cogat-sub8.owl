  <owl:Class rdf:about="#trm_4a3fd79d0addc">
    <dc:Contributor>usr_4b9003ea0be96</dc:Contributor>
    <skos:prefLabel>procedural memory</skos:prefLabel>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660633985</dc:Date>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N5620c95ffbc846399ac296d8c781b141">
