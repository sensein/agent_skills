  <owl:Class rdf:about="#trm_4a3fd79d097d6">
    <skos:definition>The way the brain codes multiple inputs such as words and pictures to integrate and create a larger conceptual idea; independent of a particular modality</skos:definition>
    <rdfs:subClassOf>
