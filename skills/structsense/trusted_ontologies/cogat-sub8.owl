    <dc:Title>transduction</dc:Title>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660640115</dc:Date>
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
    <skos:definition>in which information from stimuli is transduced into signals to the brain</skos:definition>
  </owl:Class>
