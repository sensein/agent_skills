  <owl:Class rdf:about="#trm_5106f4dfe08b1">
    <dc:Contributor>usr_4de5345b3b6a8</dc:Contributor>
    <skos:prefLabel>WAIS Arithmetic</skos:prefLabel>
    <dc:identifier>trm_5106f4dfe08b1</dc:identifier>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660593628</dc:date>
    <skos:definition>Working within a specified time limit, the examinee mentally solves a series of 14  arithmetic story type problems. This subtest measures mental manipulation, concentration, attention, short- and long-term memory, numerical reasoning ability, and mental alertness. Tests distractibility as well as numerical reasoning.</skos:definition>
    <dc:Title>WAIS Arithmetic</dc:Title>
    <rdfs:label>WAIS Arithmetic</rdfs:label>
  </owl:Class>
