  <owl:Class rdf:about="#trm_4b86c2e871b14">
    <skos:definition>&amp;#34;Participants are required to name, as rapidly as possible, items presented visually on a chart. Each chart contains five rows of 10 stimuli from a category of five items. Categories include colors, lowercase letters, digits, and common objects. The tests are scored for total number of errors and time in seconds taken to complete each chart.&amp;#34; - (Meyer, Wood, Hart, &amp; Felton 1998)</skos:definition>
    <skos:prefLabel>rapid automatized naming test</skos:prefLabel>
    <dc:identifier>trm_4b86c2e871b14</dc:identifier>
    <dc:Contributor>usr_49a467bf4e0db</dc:Contributor>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660580383</dc:date>
    <skos:altLabel>RAN</skos:altLabel>
    <dc:Title>rapid automatized naming test</dc:Title>
    <rdfs:label>rapid automatized naming test</rdfs:label>
  </owl:Class>
