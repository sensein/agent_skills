  <owl:Class rdf:about="#trm_4e68e08950157">
    <skos:prefLabel>electric stimulation</skos:prefLabel>
    <dc:identifier>trm_4e68e08950157</dc:identifier>
    <dc:Contributor>usr_4e4a7f57b30e6</dc:Contributor>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660589200</dc:date>
    <skos:definition>An electric stimulus is applied to the skin and the participant rates the perceived pain on a visual analogue scale.</skos:definition>
    <dc:Title>electric stimulation</dc:Title>
    <rdfs:label>electric stimulation</rdfs:label>
  </owl:Class>
