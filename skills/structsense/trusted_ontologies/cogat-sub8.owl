        <owl:someValuesFrom rdf:resource="trm_4a3fd79d0a6ad"/>
        <owl:someValuesFrom rdf:resource="cnt_55399f8675b23"/>
        <owl:someValuesFrom rdf:resource="cnt_4ded2a911252c"/>
        <owl:someValuesFrom rdf:resource="cnt_4de6a2be90526"/>
        <owl:onProperty rdf:resource="https://raw.githubusercontent.com/oborel/obo-relations/master/ro.owlkind_of"/>
      </owl:Restriction>
    </rdfs:subClassOf>
