  <owl:Class rdf:about="#trm_50f3bc06cae36">
    <dc:Title>NIH Toolbox Positive Affect Survey</dc:Title>
    <skos:definition>This self-report measure assesses both activated (i.e., happiness, joy) as well as unactivated (i.e., serenity, peace) aspects of positive affect. Affect is defined as &amp;#34;feelings that reflect a level of pleasurable engagement with the &#13;
environment, such as happiness, joy, excitement, enthusiasm and contentment.&amp;#34; Each item administered has a 5-point scale with options ranging from ânot at allâ to âvery much.â Each survey is scored using IRT methods.</skos:definition>
    <dc:identifier>trm_50f3bc06cae36</dc:identifier>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660593199</dc:date>
    <rdfs:label>NIH Toolbox Positive Affect Survey</rdfs:label>
    <dc:Contributor>usr_4de5345b3b6a8</dc:Contributor>
    <skos:prefLabel>NIH Toolbox Positive Affect Survey</skos:prefLabel>
  </owl:Class>
