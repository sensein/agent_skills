    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660635104</dc:Date>
    <skos:definition>refers to one&amp;#39;s conceptual knowledge and includes the meanings of words, factual information about the world, and other information not related to specific events or episodes</skos:definition>
