  <owl:Class rdf:about="#trm_50f9daf1c3834">
    <rdfs:label>Visual Object Learning Test </rdfs:label>
    <dc:Title>Visual Object Learning Test </dc:Title>
    <dc:identifier>trm_50f9daf1c3834</dc:identifier>
    <skos:definition>uses Euclidean shapes as stimuli with the same paradigm as the CNB word and face tests. The participantâs score reflects the number of correctly recognized targets and correctly rejected foils, and again median response times for correct responses serves as a measure of speed. The procedure is repeated at 20 min delay. Two forms are available for each test.</skos:definition>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660593514</dc:date>
    <skos:prefLabel>Visual Object Learning Test </skos:prefLabel>
    <skos:altLabel>(VOLT)</skos:altLabel>
    <dc:Contributor>usr_4de5345b3b6a8</dc:Contributor>
  </owl:Class>
