  <owl:Class rdf:about="#trm_524b563fb87c8">
    <dc:Title>Conners Comprehensive Behavior Rating Scales</dc:Title>
    <dc:identifier>trm_524b563fb87c8</dc:identifier>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660594516</dc:date>
    <rdfs:label>Conners Comprehensive Behavior Rating Scales</rdfs:label>
    <skos:definition>The Conners Comprehensive Behavior Rating Scale(s) is an instrument designed to provide a complete overview of child and adolescent behaviors, emotions, academic, and social problems.  These scales include the DSM-IV symptom scales.&#13;
</skos:definition>
    <skos:prefLabel>Conners Comprehensive Behavior Rating Scales</skos:prefLabel>
    <skos:altLabel>CBRS</skos:altLabel>
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
  </owl:Class>
  <owl:Restriction rdf:nodeID="N36ef551e051942efb50ad3fdde8c977f">
    <owl:onProperty rdf:resource="http://www.cogpo.org/ontologies/CogPOver1.owlhas_contrast"/>
    <owl:someValuesFrom rdf:resource="#cnt_55a30725ee445"/>
  </owl:Restriction>
  <owl:Class rdf:about="#trm_4d559bcd67c18">
    <skos:definition>On each trial, participants pump a simulated balloon without knowing when it will explode. Each pump increases the potential reward to be gained but also the probability of explosion, which wipes out all potential gains for that trial. In most studies, balloon explosion probabilities are drawn from a uniform distribution, and participants must learn explosion probabilities through trial-and-error.</skos:definition>
    <dc:Contributor>usr_595048b29ebdf</dc:Contributor>
    <skos:prefLabel>balloon analogue risk task</skos:prefLabel>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660586840</dc:date>
    <dc:Title>balloon analogue risk task</dc:Title>
    <dc:identifier>trm_4d559bcd67c18</dc:identifier>
    <rdfs:label>balloon analogue risk task</rdfs:label>
    <skos:altLabel>BART</skos:altLabel>
  </owl:Class>
  <owl:Class rdf:about="#trm_4a3fd79d0a0a1">
    <dc:Contributor>usr_4a5bc4a2a8aba</dc:Contributor>
    <skos:prefLabel>depth perception</skos:prefLabel>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660629483</dc:Date>
