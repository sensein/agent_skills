    <owl:onProperty rdf:resource="http://www.cogpo.org/ontologies/CogPOver1.owlhas_contrast"/>
  </owl:Restriction>
  <owl:Class rdf:about="#trm_4a3fd79d09b6d">
    <dc:Title>backward masking</dc:Title>
    <dc:identifier>trm_4a3fd79d09b6d</dc:identifier>
    <rdfs:label>backward masking</rdfs:label>
    <dc:Contributor>usr_4b9003ea0be96</dc:Contributor>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660579368</dc:date>
    <skos:definition>a phenomenon wherein presenting one stimulus (a &amp;#34;mask&amp;#34; or &amp;#34;masking stimulus&amp;#34;) immediately after another brief (â¤ 50 ms) &amp;#34;target&amp;#34; stimulus leads to a failure to consciously perceive the first stimulus.</skos:definition>
    <skos:prefLabel>backward masking</skos:prefLabel>
  </owl:Class>
  <owl:Restriction rdf:nodeID="N6e9a7aaa816e43d9a6702a9212546a9d">
