  <owl:Class rdf:about="#trm_52713c85c0bd2">
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
    <skos:altLabel>TOAL</skos:altLabel>
    <skos:prefLabel>Test of Adolescent and Adult Language</skos:prefLabel>
    <dc:Title>Test of Adolescent and Adult Language</dc:Title>
    <skos:definition>The Test of Adolescent and Adult Language (TOAL) measures spoken and written language abilities of adolescents and young adults with varying degrees of knowledge of the English language. It includes the following six subtests: Word opposites, word deviations, spoken analogies, word similarities, sentence combining, and orthographic usage.&#13;
&#13;
Composite scores include spoken language, written language, and general language.</skos:definition>
    <rdfs:label>Test of Adolescent and Adult Language</rdfs:label>
    <dc:identifier>trm_52713c85c0bd2</dc:identifier>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660595154</dc:date>
  </owl:Class>
