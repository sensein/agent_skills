  <owl:Class rdf:about="#tsk_Ncknr0soiM4IV">
    <rdfs:label>social decision-making task</rdfs:label>
    <skos:prefLabel>social decision-making task</skos:prefLabel>
    <dc:Title>social decision-making task</dc:Title>
    <dc:identifier>tsk_Ncknr0soiM4IV</dc:identifier>
    <skos:definition>Social decision-making tasks comprise alternative forced choice tasks in which participants make decisions that are relevant for themselves as well as at least one other person. These decisions can be of any nature (most commonly monetary or dietary).</skos:definition>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1568194563443</dc:date>
  </owl:Class>
  <owl:Class rdf:about="#trm_4a3fd79d0ad29">
    <rdfs:subClassOf>
