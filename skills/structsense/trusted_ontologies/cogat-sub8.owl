    <skos:prefLabel>Surface properties of object paradigms</skos:prefLabel>
    <dc:identifier>trm_552184243d7ab</dc:identifier>
    <skos:definition>For intermediate vision, nonlocal properties of images, transformations beyond retinotopic representations (e.g., surface properties of the object independent of light, head position)</skos:definition>
    <dc:Contributor>usr_4e42a3196fbcd</dc:Contributor>
    <dc:Title>Surface properties of object paradigms</dc:Title>
  </owl:Class>
