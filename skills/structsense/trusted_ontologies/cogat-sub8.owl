  </owl:Restriction>
  <owl:Class rdf:about="#trm_4a3fd79d09770">
    <skos:prefLabel>affect perception</skos:prefLabel>
    <dc:Title>affect perception</dc:Title>
    <skos:definition>The ability to understand a facial, vocal, or gestural behavior that serves as an indicator of emotion.</skos:definition>
    <skos:hasTopConcept rdf:resource="#ctp_C1"/>
    <dc:Contributor>usr_4cf5de07654c8</dc:Contributor>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660626330</dc:Date>
  </owl:Class>
  <owl:Restriction rdf:nodeID="N098bdeafb9e14edea7ab0ec6e3bef31e">
    <owl:someValuesFrom rdf:resource="#con_4b4a2f46e10c3"/>
    <owl:onProperty rdf:resource="https://raw.githubusercontent.com/oborel/obo-relations/master/ro.owlhas_part"/>
  </owl:Restriction>
  <owl:Class rdf:about="#trm_4a3fd79d0ad12">
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N9b5540be5ba148cd9b0eec1c36743131">
        <owl:someValuesFrom rdf:resource="trm_4a3fd79d0a5ed"/>
        <owl:onProperty rdf:resource="https://raw.githubusercontent.com/oborel/obo-relations/master/ro.owlkind_of"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc:Contributor>usr_4cf5de07654c8</dc:Contributor>
    <skos:hasTopConcept rdf:resource="#ctp_C3"/>
    <skos:prefLabel>pragmatic inference</skos:prefLabel>
    <dc:Title>pragmatic inference</dc:Title>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660633731</dc:Date>
    <skos:definition>Inferences are made when a person (or machine) goes beyond available evidence to form a conclusion. A pragmatic inference (also known as an inductive inference) is one which is likely to be true because of the state of the world. Unlike deductive inferences, pragmatic (inductive) inferences do yield conclusions that increase the semantic information over and above that found in the initial premises. </skos:definition>
  </owl:Class>
  <owl:Class rdf:about="#trm_5206bf053acf4">
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660594091</dc:date>
    <rdfs:label>Piaget's Water Jar Task</rdfs:label>
    <dc:identifier>trm_5206bf053acf4</dc:identifier>
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
    <skos:altLabel>water jug task, water jug problem</skos:altLabel>
    <skos:definition>This task tests whether children understand the principle of conservation, or the idea that two objects are still equivalent after a transformation of one of them.  Specifically, the &amp;#34;Water Jar Task&amp;#34; tests if children have attained &amp;#34;conservation of liquid quantity.&amp;#34; The child is asked to assess if the same amount of water in different glasses is in fact equal.  </skos:definition>
    <skos:prefLabel>Piaget's Water Jar Task</skos:prefLabel>
    <dc:Title>Piaget's Water Jar Task</dc:Title>
  </owl:Class>
  <owl:Class rdf:about="#trm_4da89089ce0af">
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660588457</dc:date>
    <dc:Title>zoo map test</dc:Title>
    <skos:definition> a planning subtask derived from the Behavioural Assessment of the Dysexecutive Syndrome test battery in which participants must plan in advance a route for visiting particular sites in a zoo</skos:definition>
    <rdfs:label>zoo map test</rdfs:label>
    <skos:prefLabel>zoo map test</skos:prefLabel>
    <dc:identifier>trm_4da89089ce0af</dc:identifier>
  </owl:Class>
  <owl:Restriction rdf:nodeID="Ne6b8e0280a74460abf3ccc923e851c34">
    <owl:onProperty rdf:resource="http://www.cogpo.org/ontologies/CogPOver1.owlhas_contrast"/>
    <owl:someValuesFrom rdf:resource="#cnt_4de7d0972591c"/>
  </owl:Restriction>
