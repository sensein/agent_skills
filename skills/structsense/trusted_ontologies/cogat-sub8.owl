    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660638616</dc:Date>
    <dc:Title>behavioral inhibition (cognitive)</dc:Title>
    <skos:prefLabel>behavioral inhibition (cognitive)</skos:prefLabel>
    <skos:definition>Often used as a synonym of &amp;#34;response inhibition&amp;#34; to describe the inhibition of actions.&#13;
</skos:definition>
    <dc:Contributor>usr_0000000000</dc:Contributor>
  </owl:Class>
  <owl:Class rdf:about="#trm_4a3fd79d0b06b">
    <skos:definition>is a grouping of vocabulary within a language, organizing words which are interrelated and define each other in various ways. Also referred to as a semantic field.&#13;
&#13;
</skos:definition>
    <skos:prefLabel>semantic category</skos:prefLabel>
