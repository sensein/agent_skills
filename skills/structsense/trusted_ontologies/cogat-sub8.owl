  <owl:Class rdf:about="#trm_4a3fd79d0a833">
    <skos:prefLabel>long-term memory</skos:prefLabel>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660632320</dc:Date>
    <skos:hasTopConcept rdf:resource="#ctp_C5"/>
    <dc:Contributor>usr_595048b29ebdf</dc:Contributor>
    <skos:definition>a system for permanently storing, managing, and retrieving information for later use, items of information stored as long-term memory may be available for a lifetime.</skos:definition>
    <skos:altLabel>LTM</skos:altLabel>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N8df8e2b7850d4f09a7dec25e737681a0">
