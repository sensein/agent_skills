      </owl:Restriction>
    </rdfs:subClassOf>
    <dc:Contributor>usr_595048b29ebdf</dc:Contributor>
    <dc:Title>repetition priming</dc:Title>
    <skos:definition>refers to the finding that an initial presentation of a stimulus influences the way in which an individual will respond to that stimulus when it is presented at a later time.</skos:definition>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660641970</dc:Date>
  </owl:Class>
