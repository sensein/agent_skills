  <owl:Class rdf:about="#tsk_4a57abb9499e3">
    <skos:prefLabel>delayed match to sample task</skos:prefLabel>
    <dc:Title>delayed match to sample task</dc:Title>
    <skos:altLabel>dms task, delayed matching to sample task</skos:altLabel>
    <rdfs:label>delayed match to sample task</rdfs:label>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660584063</dc:date>
    <dc:Contributor>usr_49a467bf4e0db</dc:Contributor>
    <dc:identifier>tsk_4a57abb9499e3</dc:identifier>
    <skos:definition>Subjects view an item(s). After a brief delay a probe item is presented and subjects are asked to recall if the probe item was presented before the delay (during encoding). Stimuli can be words, pictures, or abstract patterns. </skos:definition>
  </owl:Class>
