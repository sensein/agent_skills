  <owl:Class rdf:about="#tsk_4a57abb949912">
    <dc:Title>Cambridge Face Memory Test</dc:Title>
    <dc:identifier>tsk_4a57abb949912</dc:identifier>
    <rdfs:label>Cambridge Face Memory Test</rdfs:label>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660583803</dc:date>
