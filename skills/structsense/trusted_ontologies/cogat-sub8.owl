  <owl:Class rdf:about="#trm_55a6a8e81b7f4">
    <skos:altLabel>BIS</skos:altLabel>
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660598642</dc:date>
    <dc:Title>Barratt Impulsiveness Scale</dc:Title>
    <rdfs:label>Barratt Impulsiveness Scale</rdfs:label>
    <skos:definition>The Barratt Impulsiveness Scale (BIS) is a widely used measure of impulsiveness. It includes 30 items that are scored to yield six first-order factors (attention, motor, self-control, cognitive complexity, perseverance, and cognitive instability impulsiveness) and three second-order factors (attentional, motor, and non-planning impulsiveness).&#13;
&#13;
https://en.wikipedia.org/wiki/Barratt_Impulsiveness_Scale</skos:definition>
    <skos:prefLabel>Barratt Impulsiveness Scale</skos:prefLabel>
    <dc:identifier>trm_55a6a8e81b7f4</dc:identifier>
  </owl:Class>
