  <owl:Class rdf:about="#trm_50b40bca8cf83">
    <rdfs:label>Hungry Donkey Task</rdfs:label>
    <dc:identifier>trm_50b40bca8cf83</dc:identifier>
    <skos:prefLabel>Hungry Donkey Task</skos:prefLabel>
    <dc:Contributor>usr_4de5345b3b6a8</dc:Contributor>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660579744</dc:date>
    <skos:definition>The Hungry Donkey Task is a version of Bechera&amp;#39;s Iowa Gambling Task for children; it is a test in the areas of cognition &amp; emotion that was originally developed to assist in detecting decision-making impairment in patients with prefrontal cortex damage. The experiment is often computerized and is carried out in real time and resembles real-world contingencies. A donkey chooses from four doors, each with a cost or reward in apples. The objective is to give the donkey the most apples possible. </skos:definition>
    <dc:Title>Hungry Donkey Task</dc:Title>
  </owl:Class>
