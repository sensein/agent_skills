  <owl:Class rdf:about="#trm_55217d7fbfdba">
    <dc:Title>Manipulation of predictability and acceptability</dc:Title>
    <dc:Contributor>usr_4e42a3196fbcd</dc:Contributor>
    <rdfs:label>Manipulation of predictability and acceptability</rdfs:label>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660597548</dc:date>
    <skos:definition>Manipulations of predictability and acceptability, at different levels of representation, in a linguistic input.</skos:definition>
    <dc:identifier>trm_55217d7fbfdba</dc:identifier>
