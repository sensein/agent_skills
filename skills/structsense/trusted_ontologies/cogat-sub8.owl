  <owl:Class rdf:about="#trm_569989ef8cff4">
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660599563</dc:date>
    <dc:identifier>trm_569989ef8cff4</dc:identifier>
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
    <skos:definition>A task that asks participants to repeatedly decided how long to keep waiting for future monetary rewards (See Fig. 1a in paper link below). On each trial, the participant views a token that has no initial value but matures to a value of $0.30 after a random delay, and the participant can sell the token at any time to start a new trial and (possibly) maximize earnings. &#13;
&#13;
http://www.nature.com/neuro/journal/v18/n5/full/nn.3994.html</skos:definition>
    <dc:Title>willingness to wait task</dc:Title>
    <rdfs:label>willingness to wait task</rdfs:label>
    <skos:prefLabel>willingness to wait task</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="#trm_4a3fd79d0971e">
    <dc:Contributor>usr_49a467bf4e0db</dc:Contributor>
    <skos:hasTopConcept rdf:resource="#ctp_C1"/>
    <skos:prefLabel>acoustic processing</skos:prefLabel>
    <skos:definition>the extraction of information from signals propagated undersea, in the atmosphere, or in the solid earth in the presence of acoustic noise.</skos:definition>
    <dc:Title>acoustic processing</dc:Title>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660626200</dc:Date>
  </owl:Class>
