  <owl:Class rdf:about="#trm_4a3fd79d09abe">
    <dc:Title>auditory scene</dc:Title>
    <dc:Contributor>usr_4cf5de07654c8</dc:Contributor>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660627397</dc:Date>
    <skos:prefLabel>auditory scene</skos:prefLabel>
    <skos:hasTopConcept rdf:resource="#ctp_C1"/>
    <skos:definition>auditory scene analysis is the process by which the human auditory system organizes sound into perceptually meaningful elements.</skos:definition>
  </owl:Class>
