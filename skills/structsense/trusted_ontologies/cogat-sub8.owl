  <owl:Class rdf:about="#tsk_4a57abb949ce9">
    <skos:prefLabel>Parrott Scale</skos:prefLabel>
    <skos:definition>a scale created for self-reporting of subjective states like stress, arousal, and pleasure in nicotine studies</skos:definition>
