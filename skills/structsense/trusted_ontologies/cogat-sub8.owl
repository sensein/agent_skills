  <owl:Class rdf:about="#tsk_4a57abb949934">
    <dc:Contributor>usr_4cf5de07654c8</dc:Contributor>
    <skos:definition>Choice reaction time tasks require distinct responses for each possible class of stimulus. For example, the subject might be asked to press one button if a red light appears and a different button if a yellow light appears.</skos:definition>
    <skos:prefLabel>choice reaction time task</skos:prefLabel>
    <dc:Title>choice reaction time task</dc:Title>
