  <owl:Class rdf:about="#trm_52717a95a3b03">
    <dc:Title>Vineland Adaptive Behavior Scales</dc:Title>
    <rdfs:label>Vineland Adaptive Behavior Scales</rdfs:label>
    <skos:prefLabel>Vineland Adaptive Behavior Scales</skos:prefLabel>
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660595207</dc:date>
    <dc:identifier>trm_52717a95a3b03</dc:identifier>
    <skos:definition>The Vineland Adaptive Behavior Scales are the leading instrument for supporting the diagnosis of intellectual and developmental disabilities.  It assesses an individual in the domains of communication, daily living skills, socialization, motor skills, and a maladaptive behavior index.</skos:definition>
    <skos:altLabel>Vineland</skos:altLabel>
  </owl:Class>
  <owl:Class rdf:about="#trm_55a6c80b2c1d6">
    <skos:definition>The Minnesota Multiphasic Personality Inventory (MMPI) is the most widely used and researched standardized psychometric test of adult personality and psychopathology. Psychologists and other mental health professionals use various versions of the MMPI to develop treatment plans; assist with differential diagnosis; help answer legal questions (forensic psychology); screen job candidates during the personnel selection process; or as part of a therapeutic assessment procedure.&#13;
&#13;
https://en.wikipedia.org/wiki/Minnesota_Multiphasic_Personality_Inventory</skos:definition>
    <skos:altLabel>MMPI</skos:altLabel>
    <dc:Title>Minnesota Multiphasic Personality Inventory</dc:Title>
    <rdfs:label>Minnesota Multiphasic Personality Inventory</rdfs:label>
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
    <dc:identifier>trm_55a6c80b2c1d6</dc:identifier>
    <skos:prefLabel>Minnesota Multiphasic Personality Inventory</skos:prefLabel>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660598735</dc:date>
  </owl:Class>
