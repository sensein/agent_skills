  <owl:Class rdf:about="#tsk_4a57abb9499f1">
    <skos:prefLabel>delayed nonmatch to sample task</skos:prefLabel>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660584096</dc:date>
    <skos:definition>A task in which an target is presented and then removed from view. This target must be maintained in working memory for a delay, after which it is presented with non-target(s). The participant&amp;#39;s task is to identify the non-target.</skos:definition>
