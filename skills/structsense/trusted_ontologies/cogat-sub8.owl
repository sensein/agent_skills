  <owl:Class rdf:about="#trm_4f244d64e45bc">
    <dc:Title>negative priming task</dc:Title>
    <skos:definition>The participant selects a target in the presence of one or more distractors; the negative priming arises between consecutive trials, in which the participant must respond to a target on the current trial that had appeared as a distractor on the previous trial.</skos:definition>
    <rdfs:label>negative priming task</rdfs:label>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660591454</dc:date>
    <dc:identifier>trm_4f244d64e45bc</dc:identifier>
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
    <skos:prefLabel>negative priming task</skos:prefLabel>
  </owl:Class>
