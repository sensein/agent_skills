        <owl:someValuesFrom rdf:resource="cnt_5106ec3ec9e23"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="#trm_4a3fd79d0a689">
    <skos:prefLabel>intentional forgetting</skos:prefLabel>
    <dc:Title>intentional forgetting</dc:Title>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660631613</dc:Date>
