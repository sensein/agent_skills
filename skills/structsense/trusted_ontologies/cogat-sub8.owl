    <owl:someValuesFrom rdf:resource="#cnt_4df8e1f29b788"/>
  </owl:Restriction>
  <owl:Class rdf:about="#trm_502ad907e3299">
    <dc:Title>apparent verticality judgment</dc:Title>
    <skos:definition>participants make judgments of their verticality after holding specific body orientations for some duration</skos:definition>
    <rdfs:label>apparent verticality judgment</rdfs:label>
    <dc:identifier>trm_502ad907e3299</dc:identifier>
