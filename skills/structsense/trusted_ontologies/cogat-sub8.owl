    <dc:Contributor>usr_49a467bf4e0db</dc:Contributor>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660633773</dc:Date>
    <dc:Title>pragmatic reasoning</dc:Title>
    <skos:prefLabel>pragmatic reasoning</skos:prefLabel>
    <skos:hasTopConcept rdf:resource="#ctp_C3"/>
    <skos:definition>Pragmatic reasoning is defined as the process of finding the intended meaning(s) of the given, and it is suggested that this amounts to the process of inferring the appropriate context(s) in which to interpret the given.</skos:definition>
  </owl:Class>
