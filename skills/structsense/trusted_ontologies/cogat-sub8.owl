    <skos:definition>write definition here</skos:definition>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660643545</dc:Date>
  </owl:Class>
  <owl:Class rdf:about="#trm_4c8990b07a037">
    <dc:Title>music comprehension/production</dc:Title>
    <rdfs:label>music comprehension/production</rdfs:label>
    <skos:definition>Subjects listen to music passively or are asked to sing overtly.</skos:definition>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660582056</dc:date>
    <dc:identifier>trm_4c8990b07a037</dc:identifier>
    <skos:prefLabel>music comprehension/production</skos:prefLabel>
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
  </owl:Class>
  <owl:Class rdf:about="#trm_523e10cad0ce6">
    <skos:prefLabel>battelle developmental inventory</skos:prefLabel>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660594317</dc:date>
    <skos:altLabel>BDI</skos:altLabel>
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
    <dc:identifier>trm_523e10cad0ce6</dc:identifier>
    <dc:Title>battelle developmental inventory</dc:Title>
    <skos:definition>The Battelle Developmental Inventory (BDI) is an assessment for children (newborn to 7 years 11 months) that assesses early childhood developmental milestones in the domains of personal-social, adaptive, motor, communication, and cognitive ability.</skos:definition>
    <rdfs:label>battelle developmental inventory</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#trm_4f244f997615c">
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660591532</dc:date>
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
    <skos:definition>participants are instructed to move their arms and/or hands according to a novel spatiotemporal relationship</skos:definition>
    <dc:identifier>trm_4f244f997615c</dc:identifier>
    <rdfs:label>bimanual coordination task</rdfs:label>
    <dc:Title>bimanual coordination task</dc:Title>
    <skos:prefLabel>bimanual coordination task</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="#trm_4b1968619b00b">
    <rdfs:label>color-word stroop task</rdfs:label>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660580050</dc:date>
    <skos:altLabel>Stroop color-word task, Stroop color-word interference task, Stroop color naming task</skos:altLabel>
    <skos:prefLabel>color-word stroop task</skos:prefLabel>
    <dc:identifier>trm_4b1968619b00b</dc:identifier>
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
    <skos:definition>A task in which single words (including names of colors) are presented in colored ink, and the subject is asked to name the color of the ink as quickly as possible. The ink color may either match or conflict with the color name. Accuracy and response time are measured.</skos:definition>
    <dc:Title>color-word stroop task</dc:Title>
  </owl:Class>
  <owl:Restriction rdf:nodeID="N1a3c420c24f54e1ea42d465db38f8d40">
    <owl:onProperty rdf:resource="http://www.cogpo.org/ontologies/CogPOver1.owlhas_contrast"/>
    <owl:someValuesFrom rdf:resource="#cnt_4de95f0aa8476"/>
  </owl:Restriction>
  <owl:Class rdf:about="#trm_5106eee90937a">
    <dc:identifier>trm_5106eee90937a</dc:identifier>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660593577</dc:date>
    <skos:definition>For Digit Span Forward, the examinee is read a sequence of numbers and recalls the numbers in the same order. For Digit Span Backward, the examinee is read a sequence of numbers and recalls the numbers in reverse order. For Digit Span Sequencing, the examinee is read a sequence of numbers and recalls the numbers in ascending order. This subtest measures working memory, mental manipulation, cognitive flexibility, rote memory and learning, attention, and encoding. </skos:definition>
    <skos:prefLabel>WAIS Digit Span</skos:prefLabel>
    <dc:Title>WAIS Digit Span</dc:Title>
    <dc:Contributor>usr_58e556654fea9</dc:Contributor>
    <rdfs:label>WAIS Digit Span</rdfs:label>
  </owl:Class>
  <owl:Restriction rdf:nodeID="Nba76b31723264708b3fee8955b098527">
    <owl:onProperty rdf:resource="http://www.cogpo.org/ontologies/CogPOver1.owlhas_contrast"/>
    <owl:someValuesFrom rdf:resource="#cnt_55a301cd38de4"/>
  </owl:Restriction>
  <owl:Class rdf:about="#trm_4fbd2b964d3ec">
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
    <dc:identifier>trm_4fbd2b964d3ec</dc:identifier>
    <skos:prefLabel>overlapping figures task</skos:prefLabel>
    <dc:Title>overlapping figures task</dc:Title>
    <rdfs:label>overlapping figures task</rdfs:label>
    <skos:definition>participants are asked to identify all the objects in pictures containing overlapping figures</skos:definition>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660579578</dc:date>
  </owl:Class>
  <owl:Class rdf:about="#trm_51c453f64d2a6">
    <dc:Title>psychological refractory period (PRP) paradigm</dc:Title>
    <dc:Contributor>usr_51c4514d84e36</dc:Contributor>
    <dc:identifier>trm_51c453f64d2a6</dc:identifier>
    <skos:definition>In this task, participants are required to select responses for two stimuli. The intervals between the two stimuli vary, but are  usually so brief that the second stimulus often appears before the response to the first one is finished.</skos:definition>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660594021</dc:date>
    <rdfs:label>psychological refractory period (PRP) paradigm</rdfs:label>
    <skos:prefLabel>psychological refractory period (PRP) paradigm</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="#trm_4c40d1d16071e">
    <rdfs:label>listening span task</rdfs:label>
    <dc:Title>listening span task</dc:Title>
    <dc:Contributor>usr_49a467bf4e0db</dc:Contributor>
    <skos:prefLabel>listening span task</skos:prefLabel>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660580876</dc:date>
    <dc:identifier>trm_4c40d1d16071e</dc:identifier>
    <skos:definition>A task in which subjects must listen to a set of sentences and remember the last word in the sentence.  The number of words that can be recalled is the &amp;#34;listening span.&amp;#34; </skos:definition>
  </owl:Class>
  <owl:Restriction rdf:nodeID="N5d59399d075543119e545efc1d6548c3">
    <owl:onProperty rdf:resource="http://www.cogpo.org/ontologies/CogPOver1.owlhas_contrast"/>
    <owl:someValuesFrom rdf:resource="#cnt_524b4db24ad5e"/>
  </owl:Restriction>
  <owl:Class rdf:about="#trm_4e6a44ee854f8">
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660589251</dc:date>
    <skos:definition>The hand or foot is immersed into a bowl of iced water and participants report their sensation from first clear pain to unbearable pain on a scale.</skos:definition>
    <skos:prefLabel>cold pressor test</skos:prefLabel>
    <dc:Title>cold pressor test</dc:Title>
    <dc:identifier>trm_4e6a44ee854f8</dc:identifier>
    <rdfs:label>cold pressor test</rdfs:label>
  </owl:Class>
  <owl:Restriction rdf:nodeID="N1ce2fa665aa54ffb8ba2b16610f38d71">
    <owl:onProperty rdf:resource="http://www.cogpo.org/ontologies/CogPOver1.owlhas_contrast"/>
    <owl:someValuesFrom rdf:resource="#cnt_5531518f600cf"/>
  </owl:Restriction>
  <owl:Class rdf:about="#trm_4a3fd79d09ca3">
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660628130</dc:Date>
    <dc:Contributor>usr_4a5bc4a2a8aba</dc:Contributor>
    <skos:hasTopConcept rdf:resource="#ctp_C5"/>
    <skos:definition>Structure in memory that is used as a unit of knowledge representation. Also refers to the process of learning by which these units are acquired.</skos:definition>
    <skos:prefLabel>chunk</skos:prefLabel>
    <dc:Title>chunk</dc:Title>
  </owl:Class>
  <owl:Restriction rdf:nodeID="Need8243571544222b181a97e2f6381f2">
