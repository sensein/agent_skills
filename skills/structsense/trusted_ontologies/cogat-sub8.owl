  <owl:Class rdf:about="#trm_5154b2f947fe9">
    <skos:prefLabel>agency</skos:prefLabel>
    <dc:Title>agency</dc:Title>
    <skos:definition>The ability to recognize oneâs self as the agent of oneâs actions and thoughts, including the recognition of oneâs own body/body parts.</skos:definition>
    <dc:Contributor>usr_4de5345b3b6a8</dc:Contributor>
