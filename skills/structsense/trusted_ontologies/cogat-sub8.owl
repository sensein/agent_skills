  <owl:Class rdf:about="#trm_4a3fd79d0a4b2">
    <skos:definition>a school which argues that pleasure is the only intrinsic good, often used as a justification for evaluating actions in terms of how much pleasure and how little pain (i.e. suffering) they produce.</skos:definition>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660630916</dc:Date>
    <skos:prefLabel>hedonism</skos:prefLabel>
    <dc:Title>hedonism</dc:Title>
    <dc:Contributor>usr_4b9003ea0be96</dc:Contributor>
  </owl:Class>
  <owl:Class rdf:about="#trm_559f09a5cdca9">
