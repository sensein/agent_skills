  <owl:Class rdf:about="#trm_4cacf3fbc503b">
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660583369</dc:date>
    <skos:prefLabel>conditional stop signal task</skos:prefLabel>
    <dc:identifier>trm_4cacf3fbc503b</dc:identifier>
    <skos:definition>A task in which an external stimulus signals the participant to interrupt an already-initiated motor response, but only for a subset of possible responses.  </skos:definition>
    <dc:Title>conditional stop signal task</dc:Title>
    <rdfs:label>conditional stop signal task</rdfs:label>
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
  </owl:Class>
