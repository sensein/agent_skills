    <dc:identifier>trm_4c8a85a4564b2</dc:identifier>
    <dc:Title>word stem completion (overt)</dc:Title>
    <skos:definition>Subjects view word stems and overtly generate a word that completes the stem.</skos:definition>
    <dc:Contributor>usr_49a467bf4e0db</dc:Contributor>
    <rdfs:label>word stem completion (overt)</rdfs:label>
    <skos:altLabel>word stem completion task, WSC</skos:altLabel>
    <skos:prefLabel>word stem completion (overt)</skos:prefLabel>
  </owl:Class>
