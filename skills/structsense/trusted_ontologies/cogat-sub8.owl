  <owl:Class rdf:about="#tsk_4a57abb949ad7">
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660584663</dc:date>
    <dc:identifier>tsk_4a57abb949ad7</dc:identifier>
    <skos:prefLabel>intradimensional shift task</skos:prefLabel>
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
    <dc:Title>intradimensional shift task</dc:Title>
    <rdfs:label>intradimensional shift task</rdfs:label>
    <skos:definition>A task in which multiple (typically two) stimuli are presented simultaneously and the subject must select the stimulus that matches the currently relevant rule. The rule represents the relevant task &amp;#34;dimension&amp;#34;. The stimulus-response mappings within this dimension alternate or &amp;#34;shift&amp;#34; among multiple (typically two) alternatives. </skos:definition>
  </owl:Class>
  <owl:Restriction rdf:nodeID="Nf3f7594c08e54e53b96ffce3d91b1d2e">
    <owl:onProperty rdf:resource="http://www.cogpo.org/ontologies/CogPOver1.owlhas_contrast"/>
    <owl:someValuesFrom rdf:resource="#cnt_5798c78bcea27"/>
  </owl:Restriction>
  <owl:Class rdf:about="#trm_4a3fd79d0ae58">
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660634217</dc:Date>
    <skos:hasTopConcept rdf:resource="#ctp_C6"/>
    <skos:definition>the stress and intonation patterns of an utterance. </skos:definition>
    <skos:prefLabel>prosodic stress</skos:prefLabel>
    <dc:Contributor>usr_4cf5de07654c8</dc:Contributor>
    <dc:Title>prosodic stress</dc:Title>
  </owl:Class>
  <owl:Class rdf:about="#trm_500d8626d0770">
    <skos:prefLabel>binocular rivalry</skos:prefLabel>
    <dc:Title>binocular rivalry</dc:Title>
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
    <skos:definition>competition between the eyes for control of perception, particularly evident when different stimuli are presented to each eye</skos:definition>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660639844</dc:Date>
  </owl:Class>
  <owl:Class rdf:about="#trm_4a3fd79d0aecd">
    <skos:definition>an emotional response to remembrance of a past state, condition, or experience that one wishes had been different</skos:definition>
    <skos:prefLabel>regret</skos:prefLabel>
    <dc:Title>regret</dc:Title>
    <skos:hasTopConcept rdf:resource="#ctp_C8"/>
    <dc:Contributor>usr_4e429d2c8a0e5</dc:Contributor>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660634412</dc:Date>
  </owl:Class>
