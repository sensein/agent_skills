  <owl:Class rdf:about="#trm_EibcrcPYJ86gd">
    <skos:prefLabel>Naturalistic Scenes</skos:prefLabel>
    <dc:Title>Naturalistic Scenes</dc:Title>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1531197312053</dc:Date>
    <skos:definition>Passive viewing of naturalistic scenes (i.e. movies of landscapes and nature, cartoons, etc)</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="#trm_50f998dcbfcc8">
    <skos:definition>The Penn Word Memory Test presents 20 target words that are then mixed with 20 distractors equated for frequency, length, concreteness and low imageability. The participantâs score reflects the number of correctly recognized targets and correctly rejected foils. Median response times for correct responses serves as a measure of speed. A 20 min delayed recall procedure is also administered.</skos:definition>
    <dc:Contributor>usr_4de5345b3b6a8</dc:Contributor>
    <skos:altLabel>(PWMT)</skos:altLabel>
    <dc:identifier>trm_50f998dcbfcc8</dc:identifier>
    <dc:Title>Penn Word Memory Test</dc:Title>
    <rdfs:label>Penn Word Memory Test</rdfs:label>
    <skos:prefLabel>Penn Word Memory Test</skos:prefLabel>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660593464</dc:date>
  </owl:Class>
  <owl:Class rdf:about="#trm_4a3fd79d0b8fc">
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660637845</dc:Date>
    <skos:hasTopConcept rdf:resource="#ctp_C5"/>
    <skos:definition>A quality of memory that is associated with a feeling of knowing that an event has previously occurred, but often not including enough contextual or episodic details sufficient for claiming actual remembering of the event.</skos:definition>
    <skos:prefLabel>familiarity</skos:prefLabel>
    <dc:Contributor>usr_4e42bd78e66cc</dc:Contributor>
    <dc:Title>familiarity</dc:Title>
  </owl:Class>
  <owl:Class rdf:about="#trm_502abeab4e1d8">
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N4beac4eda0554b338cbb265f732f40a6">
        <owl:someValuesFrom rdf:resource="trm_4a3fd79d09ab2"/>
        <owl:onProperty rdf:resource="https://raw.githubusercontent.com/oborel/obo-relations/master/ro.owlkind_of"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <skos:definition>conflicting sensory input results in spontaneous, sometimes controllable, experiences thereof</skos:definition>
    <skos:prefLabel>multistable perception</skos:prefLabel>
    <dc:Title>multistable perception</dc:Title>
