        <owl:someValuesFrom rdf:resource="trm_4e89aebaa311d"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <skos:definition>In associative priming, the target is a word that has a high probability of appearing with the prime, and is &amp;#34;associated&amp;#34; with it but not necessarily related in semantic features. </skos:definition>
  </owl:Class>
