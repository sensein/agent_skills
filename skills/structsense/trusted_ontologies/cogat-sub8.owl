    <owl:someValuesFrom rdf:resource="#cnt_4df928c85f523"/>
    <owl:onProperty rdf:resource="http://www.cogpo.org/ontologies/CogPOver1.owlhas_contrast"/>
  </owl:Restriction>
  <owl:Class rdf:about="#trm_56674133b666c">
    <skos:definition>A variant of the n-back task, each trial consists of letters (b,d,g,t,v) presented in successive order.  Subjects must press a button if the current letter matches the letter that occurred n trials ago (regardless of capitalization).  N varies according to a staircase tracking method that increases as subjects accurately respond and decrease as subjects make errors. </skos:definition>
    <dc:Contributor>usr_566738e285cfc</dc:Contributor>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660579451</dc:date>
    <dc:Title>adaptive n-back task</dc:Title>
    <skos:prefLabel>adaptive n-back task</skos:prefLabel>
    <rdfs:label>adaptive n-back task</rdfs:label>
    <dc:identifier>trm_56674133b666c</dc:identifier>
  </owl:Class>
