  <owl:Class rdf:about="#trm_4da86c6808ddd">
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660587411</dc:date>
    <dc:identifier>trm_4da86c6808ddd</dc:identifier>
    <rdfs:label>Cattell's Culture Fair Intelligence Test</rdfs:label>
    <skos:prefLabel>Cattell's Culture Fair Intelligence Test</skos:prefLabel>
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
    <skos:definition>a test of intelligence which Raymond Cattell subdivided into &amp;#34;fluid,&amp;#34; or inherited, and &amp;#34;crystallized,&amp;#34; or learned, designed to minimize the influence of cultural experiences</skos:definition>
    <skos:altLabel>CCFIT, CFIT</skos:altLabel>
    <dc:Title>Cattell's Culture Fair Intelligence Test</dc:Title>
  </owl:Class>
  <owl:Class rdf:about="#trm_4f241fb95918f">
    <dc:identifier>trm_4f241fb95918f</dc:identifier>
    <dc:Title>recency judgment task</dc:Title>
    <rdfs:label>recency judgment task</rdfs:label>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660590640</dc:date>
    <skos:prefLabel>recency judgment task</skos:prefLabel>
    <dc:Contributor>usr_4f177506dde77</dc:Contributor>
    <skos:definition>participants are presented with two lists of words, then (after a brief reasoning test) tested to recall whether a given word had appeared on the first or the second list presented</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="#trm_527143a263937">
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660595179</dc:date>
    <dc:Title>Test of Language Development</dc:Title>
    <rdfs:label>Test of Language Development</rdfs:label>
    <skos:altLabel>TOLD</skos:altLabel>
    <dc:identifier>trm_527143a263937</dc:identifier>
    <skos:prefLabel>Test of Language Development</skos:prefLabel>
    <skos:definition>The Test of Language Development (TOLD) provides six subtests that measure components of spoken language, including 1) Sentence Combining, 2) Picture Vocabulary, 3) Word Ordering, 4) Relational Vocabulary, 5) Morphological Comprehension, and 6) Multiple Meanings.</skos:definition>
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
  </owl:Class>
  <owl:Class rdf:about="#trm_4a3fd79d0a3f6">
