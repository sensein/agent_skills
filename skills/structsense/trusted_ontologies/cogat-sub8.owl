  <owl:Class rdf:about="#trm_hsrxov4azQ6nM">
    <skos:prefLabel>music syntax</skos:prefLabel>
    <dc:Title>music syntax</dc:Title>
    <skos:definition>the combined processing of both low-level sound descriptors (such as loudness, timbre, pitch) and mid- plus high-level ones (like rythm, harmony, melody and genre).</skos:definition>
    <dc:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1571077145138</dc:Date>
