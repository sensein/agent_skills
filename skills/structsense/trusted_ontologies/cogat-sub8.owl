  <owl:Class rdf:about="#tsk_4a57abb949aa1">
    <dc:identifier>tsk_4a57abb949aa1</dc:identifier>
    <skos:altLabel>GORT-4</skos:altLabel>
    <skos:prefLabel>Gray Oral Reading Test - 4</skos:prefLabel>
    <dc:Title>Gray Oral Reading Test - 4</dc:Title>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660584523</dc:date>
    <rdfs:label>Gray Oral Reading Test - 4</rdfs:label>
    <dc:Contributor>usr_4fea0f8780899</dc:Contributor>
    <skos:definition>Measures growth in oral reading and aids in the diagnosis of oral reading difficulties. Five scores provide information on oral reading skills in terms of: Rate, accuracy, fluency, comprehension, overall reading ability, and comprehension. The test consists of two parallel forms, each containing 14 developmentally sequenced reading passages with five comprehension questions following each passage.</skos:definition>
  </owl:Class>
