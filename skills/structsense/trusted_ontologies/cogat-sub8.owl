  <owl:Class rdf:about="#trm_551f06a08dcc4">
    <dc:Contributor>usr_51bc76ae9636c</dc:Contributor>
    <skos:prefLabel>attentional blink paradigm</skos:prefLabel>
    <dc:Title>attentional blink paradigm</dc:Title>
    <skos:definition>Attentional blink is a phenomenon observed in rapid serial visual presentation. When presented with a sequence of visual stimuli in rapid succession at the same spatial location on a screen, a participant will often fail to detect a second salient target occurring in succession if it is presented between 180-450 ms after the first one. </skos:definition>
    <dc:identifier>trm_551f06a08dcc4</dc:identifier>
    <rdfs:label>attentional blink paradigm</rdfs:label>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512660596996</dc:date>
  </owl:Class>
  <owl:Restriction rdf:nodeID="Nd37fb79c6c464b58a19ab92d6940ae4c">
