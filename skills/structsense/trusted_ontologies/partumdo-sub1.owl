    <!-- http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#Postpartum_Psychosis -->

    <owl:Class rdf:about="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#Postpartum_Psychosis">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#Psychotic_Disorder"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#is_during"/>
                        <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#Postnatal_Period"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#Postpartum_Mental_Disorder"/>
        <rdfs:comment>Source for postpartum psychosis definition: https://dsm.psychiatryonline.org/doi/10.1176/appi.books.9780890425596.dsm02</rdfs:comment>
        <rdfs:isDefinedBy>A diagnosis of brief psychotic disorder up to one year after giving birth that lasts for weeks to months.

Presence of 1+ symptoms including delusions, hallucinations, or disorganized speech; may also have &quot;grossly disorganized or catatonic behavior.&quot;</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#Postpartum_Psychosis_Descriptor -->

    <owl:Class rdf:about="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#Postpartum_Psychosis_Descriptor">
