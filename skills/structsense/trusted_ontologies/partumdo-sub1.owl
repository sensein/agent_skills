                <owl:onProperty rdf:resource="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#is_during"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#37_Weeks_Gestation"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#38_Weeks_Gestation"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#39_Weeks_Gestation"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#40_Weeks_Gestation"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#41_Weeks_Gestation"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
