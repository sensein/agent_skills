        <owl:disjointWith rdf:resource="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#Prepregnancy"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#Postpregnancy_Body_Expectations_Unmet -->

    <owl:Class rdf:about="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#Postpregnancy_Body_Expectations_Unmet">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#Expectations_and_Outcomes_Mismatch"/>
        <rdfs:subClassOf>
