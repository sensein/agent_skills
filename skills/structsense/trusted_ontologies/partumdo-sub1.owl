        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#is_during"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#22_Weeks_Gestation"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#23_Weeks_Gestation"/>
