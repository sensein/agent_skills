    <!-- http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#Major_Depressive_Disorder -->

    <owl:Class rdf:about="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#Major_Depressive_Disorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#Depression"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#has_PPD_risk_factor_status"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#Confirmed_PPD_Risk_Factor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#has_PPD_risk_type"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#Mental_Condition_Related_PPD_Risk_Type"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Source for major depressive disorder definition: https://dsm.psychiatryonline.org/doi/10.1176/appi.books.9780890425596.dsm04</rdfs:comment>
        <rdfs:isDefinedBy>According to the Diagnositc and Statistical Manual of Mental Disorders - Fifth Edition (DSM-5), major depressive disorder requires 5+ of the following symptoms within a 2-week period on most days:

Depressed mood, diminished pleasure in most activities, significant weight loss or gain, sleep difficulties, restlessness or lethargy, difficulty concentrating, or thoughts of death.</rdfs:isDefinedBy>
    </owl:Class>
    


