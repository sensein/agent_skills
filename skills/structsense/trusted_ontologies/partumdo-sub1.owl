    <!-- http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#Very_Preterm -->

    <owl:Class rdf:about="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#Very_Preterm">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#Preterm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#has_PPD_risk_factor_status"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#Potential_PPD_Risk_Factor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#has_PPD_risk_type"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#Pregnancy_or_Birth_Related_PPD_Risk_Type"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#is_during"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#28_Weeks_Gestation"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#29_Weeks_Gestation"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#30_Weeks_Gestation"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/rbmor/ontologies/2021/1/1/untitled-ontology-133#31_Weeks_Gestation"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Definition source: https://www.who.int/news-room/fact-sheets/detail/preterm-birth</rdfs:comment>
        <rdfs:isDefinedBy>Delivery between 28-32 weeks gestation.</rdfs:isDefinedBy>
    </owl:Class>
    


