        <Ontology1325521724189:Synonyms>millilitre</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The unit of volume equal to one thousandth of a liter, one cubic centimeter, 10E-6 cubic meter, or approximately to 0.061 023 7 cubic inch.(NCI)</rdfs:isDefinedBy>
        <rdfs:label>mL</rdfs:label>
    </Class>
    


