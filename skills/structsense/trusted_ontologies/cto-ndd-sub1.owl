<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.w3.org/2002/07/owl#"
     xml:base="http://www.w3.org/2002/07/owl"
     xmlns:N="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#18-N/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:mg="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#mg/"
     xmlns:ng="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#ng/"
     xmlns:ont="http://www.co-ode.org/ontologies/ont.owl#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:Phase_I="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Phase_I/"
     xmlns:owl2xml="http://www.w3.org/2006/12/owl2-xml#"
     xmlns:Alzheimer="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Alzheimer&apos;"
     xmlns:Behavioral="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Behavioral/"
     xmlns:Friedreich="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Friedreich&apos;"
     xmlns:Huntington="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Huntington&apos;"
     xmlns:Ontology1325521724189="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#"
     xmlns:Ontology13255217241892="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#12-"
     xmlns:Ontology13255217241893="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#18-69"
     xmlns:Ontology13255217241894="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#50-80">
    <Ontology/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/elements/1.1/title -->

    <AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#CDISC_Code -->

    <AnnotationProperty rdf:about="http://www.co-ode.org/ontologies/ont.owl#CDISC_Code">
        <rdfs:label>CDISC Code</rdfs:label>
    </AnnotationProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Reference -->

    <AnnotationProperty rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Reference"/>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Synonyms -->

    <AnnotationProperty rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Synonyms"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Active_comparator -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Active_comparator">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Comparator"/>
        <Ontology1325521724189:Reference>http://www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A group of participants that receives an intervention that is considered to be effective.</rdfs:isDefinedBy>
        <rdfs:label>Active comparator</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Active_control_trial -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Active_control_trial">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_type"/>
        <Ontology1325521724189:Reference>Chow, S. C., &amp; Liu, J. P. (2013). Design and analysis of clinical trials: concepts and methodologies (Vol. 979). John Wiley &amp; Sons.</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>An active control trial is necessarily conducted to establish the efficacy of a new drug when the patients under study are very ill.</rdfs:isDefinedBy>
        <rdfs:label>Active control trial</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Adaptive_design -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Adaptive_design">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_design"/>
        <Ontology1325521724189:Reference>D. Harrington. designs for clinical trials: perspectives on current issues. Springer, 2011.</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Adaptive design combines prospective development of a gene expression-based classifier to select sensitive patients with a properly powered test for overall effect.</rdfs:isDefinedBy>
        <rdfs:label>Adaptive design</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Age_unit -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Age_unit">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_Trial_measurement_Units"/>
        <ont:CDISC_Code>C66781</ont:CDISC_Code>
        <Ontology1325521724189:Reference>Standard for the Exchange of Nonclinical Data (SEND), http://evs.nci.nih.gov/ftp1/CDISC/SEND/SEND%20Terminology.xls</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Those units of time that are routinely used to express the age of a subject.</rdfs:isDefinedBy>
        <rdfs:label>Age unit</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Amyloidosis -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Amyloidosis">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Disease_presentation"/>
        <ont:CDISC_Code>C2868</ont:CDISC_Code>
        <Ontology1325521724189:Reference>CDISC Glossary</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A disorder characterized by the localized or diffuse accumulation of amyloid protein in various anatomic sites. It may be primary, due to clonal plasma cell proliferations; secondary, due to long standing infections, chronic inflammatory disorders, or malignancies; or familial. It may affect the nerves, skin, tongue, joints, heart, liver, spleen, kidneys and adrenal glands.</rdfs:isDefinedBy>
        <rdfs:label>Amyloidosis</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Analytical_study -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Analytical_study">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Study_type"/>
        <Ontology1325521724189:Reference>http://scientific-european-federation-osteopaths.org/en/different-types-of-clinical-trials</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Study designed to examine associations, with the final object usually of identifying or measuring the effects of risk factors or specific interventions on health.</rdfs:isDefinedBy>
        <rdfs:label>Analytical study</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Approved_for_marketing -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Approved_for_marketing">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Closed_study"/>
        <Ontology1325521724189:Reference>http://www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Applies to an Expanded Access program. The intervention has been approved for sale to the public.</rdfs:isDefinedBy>
        <rdfs:label>Approved for marketing</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Available_for_expanded_access -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Available_for_expanded_access">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Open_study"/>
        <Ontology1325521724189:Reference>http://www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>An Expanded Access program is currently available for this study intervention. </rdfs:isDefinedBy>
        <rdfs:label>Available for expanded access</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Average_Body_Weight_Gain -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Average_Body_Weight_Gain">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Body_weight_gain"/>
        <ont:CDISC_Code>C90363</ont:CDISC_Code>
        <Ontology1325521724189:Reference>Standard for the Exchange of Nonclinical Data (SEND), http://evs.nci.nih.gov/ftp1/CDISC/SEND/SEND%20Terminology.xls</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>The mean value of the amount of weight change over a period of time, relative to the beginning of the collection period.</rdfs:isDefinedBy>
        <rdfs:label>Average body weight gain</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Baseline_characteristics -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Baseline_characteristics">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_Conduct_Sub-Domain"/>
        <Ontology1325521724189:Reference>http://www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Data collected at the beginning of a clinical study for all participants and for each arm or comparison group.</rdfs:isDefinedBy>
        <rdfs:label>Baseline characteristics</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Blinded -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Blinded">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Masking"/>
        <ont:CDISC_Code>C49068</ont:CDISC_Code>
        <Ontology1325521724189:Reference>CDISC&apos;s Clinical Data Element Glossary, http://evs.nci.nih.gov/ftp1/CDISC/Clinical_Data_Element_Glossary/Clinical%20Data%20Element%20Glossary.xls.</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A characteristic of experimental design in which one or more groups involved (receiving, administering, or evaluating intervention) are unaware of which intervention any particular subject is receiving.</rdfs:isDefinedBy>
        <rdfs:label>Blinded</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Blindness -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Blindness">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_design"/>
        <Ontology1325521724189:Reference>Everitt, B., &amp; George, S. (2004). Textbook of clinical trials. D. Machin, S. Day, &amp; S. B. Green (Eds.). Wiley.</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>In clinical trials, blindness usually refers to two aspects of trials. The first relates to the allocation of participants to the diferent treatment limbs independently. The second relates to the concealment of which treatment the participant received.   </rdfs:isDefinedBy>
        <rdfs:label>Blindness</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Body_weight_gain -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Body_weight_gain">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Body_weight"/>
        <ont:CDISC_Code>C62754</ont:CDISC_Code>
        <Ontology1325521724189:Reference>Standard for the Exchange of Nonclinical Data (SEND), http://evs.nci.nih.gov/ftp1/CDISC/SEND/SEND%20Terminology.xls</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A change in overall body weight, relative to the beginning of the collection period.</rdfs:isDefinedBy>
        <rdfs:label>Body weight gain</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Case-control -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Case-control">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Retrospective_study"/>
        <Ontology1325521724189:Synonyms>case referent</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>retrospective study</Ontology1325521724189:Synonyms>
        <rdfs:label>Case-control</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Clinical_outcome_measure -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Clinical_outcome_measure">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Statistical_concept"/>
        <Ontology1325521724189:Reference>www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A planned measurement described in the protocol that is used to determine the effect of interventions on participants in a clinical trial. For observational studies, a measurement or observation that is used to describe patterns of diseases or traits, or associations with exposures, risk factors, or treatment.</rdfs:isDefinedBy>
        <rdfs:label>Outcome measure</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Clinical_trial -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Prospective_study"/>
        <rdfs:label>Clinical trial</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_design -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_design">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Structure_of_clinical_trial"/>
        <Ontology1325521724189:Synonyms>trial design</Ontology1325521724189:Synonyms>
        <rdfs:label>Clinical trial design</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_ethics -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_ethics">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_trial_methods"/>
        <rdfs:label>Clinical trial ethics</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_operation -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_operation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_trial_methods"/>
        <rdfs:label>Clinical trial operation</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_type -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_type">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial"/>
        <rdfs:label>Clinical trial type</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Closed_study -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Closed_study">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Recruitment_status"/>
        <Ontology1325521724189:Reference>http://www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Clinical studies that are no longer recruiting participants because they have enough participants already, because they are completed, or because they have been stopped for some reason. </rdfs:isDefinedBy>
        <rdfs:label>Closed study</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Combination_trial -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Combination_trial">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_type"/>
        <Ontology1325521724189:Reference>Chow, S. C., &amp; Liu, J. P. (2013). Design and analysis of clinical trials: concepts and methodologies (Vol. 979). John Wiley &amp; Sons.</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A trial to assess the treatment effect by taking into account the potential for drug-to-drug interaction.</rdfs:isDefinedBy>
        <rdfs:label>Combination trial</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Community_trial -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Community_trial">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_type"/>
        <Ontology1325521724189:Reference>http://scientific-european-federation-osteopaths.org/en/different-types-of-clinical-trials</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Clinical trial in which the elements allocated randomly are communities or populations, instead of individuals.</rdfs:isDefinedBy>
        <rdfs:label>Community trial</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Composite_outcome_measure -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Composite_outcome_measure">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_outcome_measure"/>
        <Ontology1325521724189:Reference>Meinert, C. L. (2012). ClinicalTrials: Design, Conduct and Analysis. Oxford University Press.</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>An outcome comprised of two or more outcome measures.</rdfs:isDefinedBy>
        <rdfs:label>Composite outcome measure</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Controlled_trial -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Controlled_trial">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Experimental_study"/>
        <Ontology1325521724189:Reference>http://www.cancer.gov/dictionary?cdrid=44014</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A clinical study that includes a comparison (control) group. The comparison group receives a placebo, another treatment, or no treatment at all. </rdfs:isDefinedBy>
        <rdfs:label>Controlled trial</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Cross-over_design -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Cross-over_design">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_design"/>
        <Ontology1325521724189:Reference>Senn, S. (2002). Cross-over trials in clinical research (Vol. 5). John Wiley &amp; Sons.</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>cross-over trial</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Cross-over trials are experiments in which subjects are each given a number of treatments with the object of studying differences between these treatments.</rdfs:isDefinedBy>
        <rdfs:label>Cross-over design</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Day -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Day">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Age_unit"/>
        <ont:CDISC_Code>C25301</ont:CDISC_Code>
        <Ontology1325521724189:Reference>Standard for the Exchange of Nonclinical Data (SEND), http://evs.nci.nih.gov/ftp1/CDISC/SEND/SEND%20Terminology.xls</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>The time for Earth to make a complete rotation on its axis; ordinarily divided into twenty-four hours. This also refers to a specific day. (NCI)</rdfs:isDefinedBy>
        <rdfs:label>Day</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Depression -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Depression">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Disease_presentation"/>
        <ont:CDISC_Code>C2982</ont:CDISC_Code>
        <rdfs:isDefinedBy>A melancholy feeling of sadness and despair.</rdfs:isDefinedBy>
        <rdfs:label>Depression</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Descriptive_study -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Descriptive_study">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Study_type"/>
        <Ontology1325521724189:Reference>http://scientific-european-federation-osteopaths.org/en/different-types-of-clinical-trials</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Study designed solely for describing the distribution of certain variables, but which is not concerned about the associations between them.</rdfs:isDefinedBy>
        <rdfs:label>Descriptive study</rdfs:label>
        <rdfs:label>descriptive design</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Disease_outcome -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Disease_outcome">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_Trial_Readouts"/>
        <ont:CDISC_Code>C18226</ont:CDISC_Code>
        <Ontology1325521724189:Reference>CDISC&apos;s Clinical Data Element Glossary, http://evs.nci.nih.gov/ftp1/CDISC/Clinical_Data_Element_Glossary/Clinical%20Data%20Element%20Glossary.xls.</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A measurable result or effect of treatment on a disease. Examples of outcomes include decreased pain, reduced tumor size, or worsening of disease.</rdfs:isDefinedBy>
        <rdfs:label>Disease outcome</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Disease_presentation -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Disease_presentation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Phase_VI"/>
        <ont:CDISC_Code>C99554</ont:CDISC_Code>
        <Ontology1325521724189:Reference>CDISC Glossary</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>disease condition</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The compilation of symptoms and/or clinical manifestation of any abnormal condition of the body or mind that causes discomfort, dysfunction, or distress to the person affected or those in contact with the person. The term is often used broadly to include injuries, disabilities, syndromes, symptoms, deviant behaviors, and atypical variations of structure and function.</rdfs:isDefinedBy>
        <rdfs:label>Disease presentation</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Dose-response_trial -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Dose-response_trial">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_type"/>
        <Ontology1325521724189:Reference>Chow, S. C., &amp; Liu, J. P. (2013). Design and analysis of clinical trials: concepts and methodologies (Vol. 979). John Wiley &amp; Sons.</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Trials that are usually conducted to determine the therapeutic window of the test drug and the relationship between the efficacy/safety and doses within the therapeutic window. </rdfs:isDefinedBy>
        <rdfs:label>Dose-response trial</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Enrolling_by_invitation -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Enrolling_by_invitation">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Closed_study"/>
        <Ontology1325521724189:Reference>http://www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A study that selects its participants from a population, or group of people, decided on in advance by the researchers. These studies are not open to everyone who meets the eligibility criteria, but only to people in that particular population, who are specifically invited to participate. </rdfs:isDefinedBy>
        <rdfs:label>Enrolling by invitation</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Expanded_access -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Expanded_access">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Quantitative_study_design"/>
        <Ontology1325521724189:Reference>http://www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A process regulated by the Food and Drug Administration (FDA) that allows manufacturers to provide investigational new drugs to patients with serious diseases or conditions who cannot participate in a clinical trial. </rdfs:isDefinedBy>
        <rdfs:label>Expanded access</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Experimental_study -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Experimental_study">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Quantitative_study_design"/>
        <Ontology1325521724189:Reference>http://scientific-european-federation-osteopaths.org/en/different-types-of-clinical-trials</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>In epidemiology, controlled clinical trial or community trial with random distribution. The researcher manipulates the research conditions and randomly distributes the groups. The objective of experimental studies is to estimate the efficacy of a preventive, curative or rehabilitative intervention.</rdfs:isDefinedBy>
        <rdfs:label>Experimental study</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Explanatory_trial -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Explanatory_trial">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_type"/>
        <Ontology1325521724189:Reference>http://scientific-european-federation-osteopaths.org/en/different-types-of-clinical-trials</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>explanatory clinical trial</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The trial whose aim is fundamentally to acquire scientific knowledge and biological explanations about efficacy.</rdfs:isDefinedBy>
        <rdfs:label>Explanatory trial</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Factorial_design -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Factorial_design">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_design"/>
        <Ontology1325521724189:Reference>Chin, R., &amp; Lee, B. Y. (2008). Principles and practice of clinical trial medicine. Elsevier.</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Testing two or more different interventions on the same group at the same time.</rdfs:isDefinedBy>
        <rdfs:label>Factorial design</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Feasibility_study -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Feasibility_study">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_design"/>
        <Ontology1325521724189:Reference>http://scientific-european-federation-osteopaths.org/en/different-types-of-clinical-trials</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Preliminary study with the objective of determining whether a programme, procedure or study protocol is practicable, as well as finding out data to help in determining the sample size for a definitive study.</rdfs:isDefinedBy>
        <rdfs:label>Feasibility study</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Group_allocation_design -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Group_allocation_design">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_design"/>
        <Ontology1325521724189:Reference>Friedman, L. M., Furberg, C., &amp; DeMets, D. L. (1998). Fundamentals of clinical trials (Vol. 3). New York: Springer.</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>cluster allocation design</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A group of individuals, a clinic or a community are randomized to  a particular intervention or control. </rdfs:isDefinedBy>
        <rdfs:label>Group allocation design</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Historical_observational_cohort -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Historical_observational_cohort">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Retrospective_study"/>
        <Ontology1325521724189:Synonyms>retrospective cohort study</Ontology1325521724189:Synonyms>
        <rdfs:label>Historical observational cohort</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Hour -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Hour">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Age_unit"/>
        <ont:CDISC_Code>C25529</ont:CDISC_Code>
        <Ontology1325521724189:Reference>Standard for the Exchange of Nonclinical Data (SEND), http://evs.nci.nih.gov/ftp1/CDISC/SEND/SEND%20Terminology.xls</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A unit measure of time equal to 3,600 seconds or 60 minutes. It is approximately 1/24 of a median day. (NCI)</rdfs:isDefinedBy>
        <rdfs:label>Hour</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Hybrid_design -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Hybrid_design">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Longitudinal_study"/>
        <Ontology1325521724189:Reference>D. Harrington. designs for clinical trials: perspectives on current issues. Springer, 2011.</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A design powered to detect differences in outcomes only in the marker subgroup that is randomized to treatment choices based on marker status.</rdfs:isDefinedBy>
        <rdfs:label>Hybrid design</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Identifier -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Identifier">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Informations_of_study"/>
        <Ontology1325521724189:Reference>http://www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A unique identification code given to each clinical study registered on ClinicalTrials.gov. The format is the letters &quot;NCT&quot; followed by an 8-digit number (for example, NCT00000419). </rdfs:isDefinedBy>
        <rdfs:label>Identifier</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Instantaneous_study -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Instantaneous_study">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Descriptive_study"/>
        <Ontology1325521724189:Reference>R. Chappell. Classification and bias of clinical research. Department of Biostatistics and Medical Informatics, University of Wisconsin Medical School. [Course slides]</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Two or more populations are instantaneeously compared through the prevalences of both exposure and disease.</rdfs:isDefinedBy>
        <rdfs:label>Instantaneous study</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#International_site -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#International_site">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Site_selection"/>
        <Ontology1325521724189:Reference>Chin, R., &amp; Lee, B. Y. (2008). Principles and practice of clinical trial medicine. Elsevier.</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Clinical trials frequently employ sites from different countries.</rdfs:isDefinedBy>
        <rdfs:label>International site</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Last_verified_date -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Last_verified_date">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Multicentered_Trials"/>
        <Ontology1325521724189:Reference>http://www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>The last verified date is the most recent date that all of a clinical study&apos;s information on ClinicalTrials.gov was confirmed as accurate and up to date. This date may be different from the last updated date.</rdfs:isDefinedBy>
        <rdfs:label>Last verified date</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Longitudinal_study -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Longitudinal_study">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Study_type"/>
        <Ontology1325521724189:Reference>R. Chappell. Classification and bias of clinical research. Department of Biostatistics and Medical Informatics, University of Wisconsin Medical School. [Course slides]</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A longitudinal study observes exposures and events for individuals over a period of time.</rdfs:isDefinedBy>
        <rdfs:label>Longitudinal study</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Month -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Month">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Age_unit"/>
        <ont:CDISC_Code>C29846</ont:CDISC_Code>
        <Ontology1325521724189:Reference>Standard for the Exchange of Nonclinical Data (SEND), http://evs.nci.nih.gov/ftp1/CDISC/SEND/SEND%20Terminology.xls</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>One of the 12 divisions of a year as determined by a calendar. It corresponds to the unit of time of approximately to one cycle of the moon&apos;s phases, about 30 days or 4 weeks. (NCI)</rdfs:isDefinedBy>
        <rdfs:label>Month</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Multiple_site -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Multiple_site">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Site_selection"/>
        <Ontology1325521724189:Reference>Chin, R., &amp; Lee, B. Y. (2008). Principles and practice of clinical trial medicine. Elsevier.</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Trials including many different locations increasing the number and diversity of patients.</rdfs:isDefinedBy>
        <rdfs:label>Multiple site</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#N-of-1_clinical_trial -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#N-of-1_clinical_trial">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_type"/>
        <Ontology1325521724189:Reference>http://scientific-european-federation-osteopaths.org/en/different-types-of-clinical-trials</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Trial in which the total population is a single patient and in which the order of administration of the treatments compared is determined in a random way.</rdfs:isDefinedBy>
        <rdfs:label>N-of-1 clinical trial</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#No_intervention_arm -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#No_intervention_arm">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_arms"/>
        <Ontology1325521724189:Reference>http://www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A group of participants that does not receive any interventions during a clinical study.</rdfs:isDefinedBy>
        <rdfs:label>No intervention arm</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#No_longer_available_for_expanded_access -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#No_longer_available_for_expanded_access">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Closed_study"/>
        <Ontology1325521724189:Reference>http://www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>An Expanded Access program was available for this study intervention previously but is not currently available and will not be available in the future. </rdfs:isDefinedBy>
        <rdfs:label>No longer available for expanded access</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Non-randomized_concurrent_control_study -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Non-randomized_concurrent_control_study">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Controlled_trial"/>
        <Ontology1325521724189:Reference>E.M. Antman. cardiovascuar therapeutics: a companion to Braunwald&apos;s heart disease. Elsevier, 2013.</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Non-randomized</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Trials in which the investigator selects the subjects to be allocated to the control and treatment groups.</rdfs:isDefinedBy>
        <rdfs:label>Non-randomized concurrent control study</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Not_yet_recruiting -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Not_yet_recruiting">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Open_study"/>
        <Ontology1325521724189:Reference>http://www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>The study has not started recruiting participants. </rdfs:isDefinedBy>
        <rdfs:label>Not yet recruiting</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Observational_study -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Observational_study">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Quantitative_study_design"/>
        <Ontology1325521724189:Reference>http://scientific-european-federation-osteopaths.org/en/different-types-of-clinical-trials</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Analytical epidemiological study in which the researcher does not determine the allocation of the subjects to each group, but simply records (observes) what actually happens.</rdfs:isDefinedBy>
        <rdfs:label>Observational study design</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Open_study -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Open_study">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Recruitment_status"/>
        <Ontology1325521724189:Reference>http://www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Studies that are currently recruiting participants, will be recruiting participants in the future, or involve drugs that are available for expanded access. Recruitment statuses for open studies appear in green text in ClinicalTrials.gov search results and study records. </rdfs:isDefinedBy>
        <rdfs:label>Open study</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#PK_parameter_units_of_measure -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#PK_parameter_units_of_measure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_Trial_measurement_Units"/>
        <ont:CDISC_Code>C85494</ont:CDISC_Code>
        <Ontology1325521724189:Reference>Standard for the Exchange of Nonclinical Data (SEND), http://evs.nci.nih.gov/ftp1/CDISC/SEND/SEND%20Terminology.xls</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Units of measure needed for pharmacokinetic parameters.</rdfs:isDefinedBy>
        <rdfs:label>PK parameter units of measure</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Parallel_trial -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Parallel_trial">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_type"/>
        <Ontology1325521724189:Reference>http://scientific-european-federation-osteopaths.org/en/different-types-of-clinical-trials</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Clinical trial in which each group of patients receives a single treatment simultaneously.</rdfs:isDefinedBy>
        <rdfs:label>Parallel trial</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Percentage_body_weight_gain -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Percentage_body_weight_gain">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Body_weight_gain"/>
        <ont:CDISC_Code>C90434</ont:CDISC_Code>
        <Ontology1325521724189:Reference>Standard for the Exchange of Nonclinical Data (SEND), http://evs.nci.nih.gov/ftp1/CDISC/SEND/SEND%20Terminology.xls</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>The amount of weight change over a period of time in relation to the total weight, relative to the beginning of the collection period.</rdfs:isDefinedBy>
        <rdfs:label>Percentage body weight gain</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Peripheral_nerve_injury -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Peripheral_nerve_injury">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Disease_presentation"/>
        <ont:CDISC_Code>C101250</ont:CDISC_Code>
        <Ontology1325521724189:Reference>CDISC&apos;s Clinical Data Element Glossary, http://evs.nci.nih.gov/ftp1/CDISC/Clinical_Data_Element_Glossary/Clinical%20Data%20Element%20Glossary.xls.</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Sensory or motor loss of peripheral nerve function due to a traumatic event.</rdfs:isDefinedBy>
        <rdfs:label>Peripheral nerve injury</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Pivotal_trial -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Pivotal_trial">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_design"/>
        <Ontology1325521724189:Reference>Wikipedia</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A pivotal trial can refer to a clinical trial or study intended to provide evidence for a drug marketing approval. </rdfs:isDefinedBy>
        <rdfs:label>Pivotal trial</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Prospective_observational_cohort -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Prospective_observational_cohort">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Prospective_study"/>
        <Ontology1325521724189:Reference>Wikipedia</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A prospective cohort study is a cohort study that follows over time a group of similar individuals who differ with respect to certain factors under study, to determine how these factors affect rates of a certain outcome.</rdfs:isDefinedBy>
        <rdfs:label>Prospective observational cohort</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Prospective_study -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Prospective_study">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Longitudinal_study"/>
        <Ontology1325521724189:Reference>Glossary of Methodologic Terms. Elsevier. www.elsevier.com/__data/promis_misc/apmrglossary.pdf‎</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>cohort analytic study</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy> Prospective investigation of the factors that may cause a disorder by comparing a cohort of individuals who do not have evidence of an outcome of interest but who are exposed to the putative cause with a concurrent cohort who are also free of the outcome but not exposed to the putative cause.</rdfs:isDefinedBy>
        <rdfs:label>Prospective study</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Randomized_blinded_block -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Randomized_blinded_block">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#The_Randomized_Blinded_Trial"/>
        <Ontology1325521724189:Reference>Dobkin, B. H. (2003). The clinical science of neurologic rehabilitation. Oxford University Press, USA.</Ontology1325521724189:Reference>
        <rdfs:label>Randomized blinded block</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Randomized_blinded_cross-over -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Randomized_blinded_cross-over">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#The_Randomized_Blinded_Trial"/>
        <Ontology1325521724189:Reference>Dobkin, B. H. (2003). The clinical science of neurologic rehabilitation. Oxford University Press, USA.</Ontology1325521724189:Reference>
        <rdfs:label>Randomized blinded cross-over</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Randomized_blinded_factorial -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Randomized_blinded_factorial">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#The_Randomized_Blinded_Trial"/>
        <Ontology1325521724189:Reference>Dobkin, B. H. (2003). The clinical science of neurologic rehabilitation. Oxford University Press, USA.</Ontology1325521724189:Reference>
        <rdfs:label>Randomized blinded factorial</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Randomized_blinded_matched_pairs -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Randomized_blinded_matched_pairs">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#The_Randomized_Blinded_Trial"/>
        <Ontology1325521724189:Reference>Dobkin, B. H. (2003). The clinical science of neurologic rehabilitation. Oxford University Press, USA.</Ontology1325521724189:Reference>
        <rdfs:label>Randomized blinded matched pairs</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Randomized_blinded_withdrawal_design -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Randomized_blinded_withdrawal_design">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#The_Randomized_Blinded_Trial"/>
        <Ontology1325521724189:Reference>Dobkin, B. H. (2003). The clinical science of neurologic rehabilitation. Oxford University Press, USA.</Ontology1325521724189:Reference>
        <rdfs:label>Randomized blinded withdrawal</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Randomized_control_trial -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Randomized_control_trial">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Controlled_trial"/>
        <Ontology1325521724189:Reference>P. Solomon, M. Cavanaugh, E. Draine. Randomized Controlled Trials: Design and Implementation for Community-Based Psychosocial Interventions. Oxford University Press, 2009.</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>RCT</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>randomised controlled trial</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>randomized control trial</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The primary objection raised about a RCT is related to its central feature: the randomness of the decision regarding an individual&apos;s treatment regimen. </rdfs:isDefinedBy>
        <rdfs:label>Randomized controlled trial</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Reason_for_treatment -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Reason_for_treatment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Treatment"/>
        <ont:CDISC_Code>C102702</ont:CDISC_Code>
        <Ontology1325521724189:Reference>CDISC&apos;s Clinical Data Element Glossary, http://evs.nci.nih.gov/ftp1/CDISC/Clinical_Data_Element_Glossary/Clinical%20Data%20Element%20Glossary.xls.</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>The reason the treatment was administered.</rdfs:isDefinedBy>
        <rdfs:label>Reason for treatment</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Reason_for_treatment_interruption -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Reason_for_treatment_interruption">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Treatment"/>
        <ont:CDISC_Code>C102703</ont:CDISC_Code>
        <Ontology1325521724189:Reference>CDISC&apos;s Clinical Data Element Glossary, http://evs.nci.nih.gov/ftp1/CDISC/Clinical_Data_Element_Glossary/Clinical%20Data%20Element%20Glossary.xls.</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>The reason the drug or therapy was temporarily ceased.</rdfs:isDefinedBy>
        <rdfs:label>Reason for treatment interruption</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Reason_treatment_not_administered -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Reason_treatment_not_administered">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Treatment"/>
        <ont:CDISC_Code>C102704</ont:CDISC_Code>
        <Ontology1325521724189:Reference>CDISC&apos;s Clinical Data Element Glossary, http://evs.nci.nih.gov/ftp1/CDISC/Clinical_Data_Element_Glossary/Clinical%20Data%20Element%20Glossary.xls.</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>The reason the treatment was not administered.</rdfs:isDefinedBy>
        <rdfs:label>Reason treatment not administered</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Recruiting -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Recruiting">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Open_study"/>
        <Ontology1325521724189:Reference>http://www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>The study is currently recruiting participants. </rdfs:isDefinedBy>
        <rdfs:label>Recruiting</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Recruitment_of_patients -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Recruitment_of_patients">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_Conduct_Sub-Domain"/>
        <Ontology1325521724189:Reference>Chin, R., &amp; Lee, B. Y. (2008). Principles and practice of clinical trial medicine. Elsevier.</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>It involves identifying patients eligible for your study and convincing them to participate.</rdfs:isDefinedBy>
        <rdfs:label>Patient recruitment</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Registration -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Registration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Protocol_Representation_Sub-Domain"/>
        <Ontology1325521724189:Reference>www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>The process of submitting and updating summary information about a clinical study protocol from its beginning to end, to a structured, Web-based registry that is accessible to the public, such as ClinicalTrials.gov. </rdfs:isDefinedBy>
        <rdfs:label>Registration</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Retrospective_study -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Retrospective_study">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Longitudinal_study"/>
        <Ontology1325521724189:Synonyms>Case-comparison study</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>case-control study</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>case-referent study</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Study generally used to test possible causes of a disease or disorder, in
which individuals who have a designated disorder are compared with individuals who do not with respect to previous current exposure to a putative causal factor. </rdfs:isDefinedBy>
        <rdfs:label>Retrospective study</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Safety_measure -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Safety_measure">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_outcome_measure"/>
        <Ontology1325521724189:Reference>Meinert, C. L. (2012). ClinicalTrials: Design, Conduct and Analysis. Oxford University Press.</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Any measure made on persons during a trial for use in deciding whether it is safe to continue treatment. </rdfs:isDefinedBy>
        <rdfs:label>Safety measure</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Sample_size -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Sample_size">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Statistical_concept"/>
        <Ontology1325521724189:Reference>Chow, S. C., Wang, H., &amp; Shao, J. (2007). Sample size calculations in clinical research. CRC press.</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>In clinical research, a statistical evaluation for sample size calculation is often performed based on some statistical inference of the primary study endpoint with certain assurance. </rdfs:isDefinedBy>
        <rdfs:label>Sample size</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Sequential_trial -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Sequential_trial">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_type"/>
        <Ontology1325521724189:Reference>http://scientific-european-federation-osteopaths.org/en/different-types-of-clinical-trials</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>sequential clinical trial</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Clinical trial in which the observations are assessed as they are produced and the total number of participants is not predetermined, but depends on the accumulated results.

</rdfs:isDefinedBy>
        <rdfs:label>Sequential trial</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Sham_comparator -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Sham_comparator">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Comparator"/>
        <Ontology1325521724189:Reference>http://www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A group of participants that receives a procedure or device that is made to be indistinguishable from the actual procedure or device being studied but does not contain active processes or components.</rdfs:isDefinedBy>
        <rdfs:label>Sham comparator</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Single_site -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Single_site">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Site_selection"/>
        <Ontology1325521724189:Reference>Chin, R., &amp; Lee, B. Y. (2008). Principles and practice of clinical trial medicine. Elsevier.</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Clinical studies that take place at only one location.</rdfs:isDefinedBy>
        <rdfs:label>Single site</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Site_selection -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Site_selection">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_Conduct_Sub-Domain"/>
        <rdfs:label>Site selection</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Statistical_concept -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Statistical_concept">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Structure_of_clinical_trial"/>
        <Ontology1325521724189:Synonyms>concepts in biostatistics</Ontology1325521724189:Synonyms>
        <rdfs:label>Statistical concept</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Structure_of_clinical_trial -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Structure_of_clinical_trial">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial"/>
        <rdfs:label>Structure of clinical trial</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Study_type -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Study_type">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_Trial_Study"/>
        <Ontology1325521724189:Reference>http://www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Describes the nature of a clinical study. </rdfs:isDefinedBy>
        <rdfs:label>Study type</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Superiority_trial -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Superiority_trial">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_type"/>
        <Ontology1325521724189:Reference>Chow, S. C., &amp; Liu, J. P. (2013). Design and analysis of clinical trials: concepts and methodologies (Vol. 979). John Wiley &amp; Sons.</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A trial whose objective is to show that the test treatment is better than a concurrent control in terms of its primary clinical endpoints.</rdfs:isDefinedBy>
        <rdfs:label>Superiority trial</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Surrogate_outcome_measure -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Surrogate_outcome_measure">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_outcome_measure"/>
        <Ontology1325521724189:Reference>Meinert, C. L. (2012). ClinicalTrials: Design, Conduct and Analysis. Oxford University Press.</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>An outcome measure used as substitute for some other outcome. </rdfs:isDefinedBy>
        <rdfs:label>Surrogate outcome measure</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Survey -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Survey">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Instantaneous_study"/>
        <Ontology1325521724189:Synonyms>ecological study</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>population-correlation study</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>survey</Ontology1325521724189:Synonyms>
        <rdfs:label>Population-based study</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Temporarily_not_available_for_expanded_access -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Temporarily_not_available_for_expanded_access">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Closed_study"/>
        <Ontology1325521724189:Reference>http://www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>An Expanded Access program is not currently available for this intervention but is expected to be available in the future. </rdfs:isDefinedBy>
        <rdfs:label>Temporarily not available for expanded access</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Terminal_body_weight -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Terminal_body_weight">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Body_weight"/>
        <ont:CDISC_Code>C90464</ont:CDISC_Code>
        <rdfs:isDefinedBy>The weight of a subject at a specified end point. (NCI)</rdfs:isDefinedBy>
        <rdfs:label>Terminal body weight</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Treatment_episode -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Treatment_episode">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Treatment"/>
        <ont:CDISC_Code>C102720</ont:CDISC_Code>
        <Ontology1325521724189:Reference>CDISC&apos;s Clinical Data Element Glossary, http://evs.nci.nih.gov/ftp1/CDISC/Clinical_Data_Element_Glossary/Clinical%20Data%20Element%20Glossary.xls.</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>An indication of whether this is the individual&apos;s first time being treated for a disease or that they are receiving a subsequent treatment.</rdfs:isDefinedBy>
        <rdfs:label>Treatment episode</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Treatment_failure_reason -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Treatment_failure_reason">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Treatment"/>
        <ont:CDISC_Code>C102721</ont:CDISC_Code>
        <Ontology1325521724189:Reference>CDISC&apos;s Clinical Data Element Glossary, http://evs.nci.nih.gov/ftp1/CDISC/Clinical_Data_Element_Glossary/Clinical%20Data%20Element%20Glossary.xls.</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>The reason the drug or therapy was unsuccessful in treating the condition.</rdfs:isDefinedBy>
        <rdfs:label>Treatment failure reason</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Triple_blind -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Triple_blind">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Blindness"/>
        <Ontology1325521724189:Reference>Wang, D., &amp; Bakhai, A. (Eds.). (2006). Clinical trials: A practical guide to design, analysis, and reporting. Remedica.</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>In triple-blinded studies, all members of the sponsor&apos;s project team are blinded. This makes evaluations of the results more objective.</rdfs:isDefinedBy>
        <rdfs:label>Triple blind</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Unblinded -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Unblinded">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Blindness"/>
        <Ontology1325521724189:Reference>Wang, D., &amp; Bakhai, A. (Eds.). (2006). Clinical trials: A practical guide to design, analysis, and reporting. Remedica.</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>open study</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>On some occasions it might not be possible to use blinding. For example, if the new intervention is a surgical treatment and being compared with tablets then the difference between the two is difficult to hide.</rdfs:isDefinedBy>
        <rdfs:label>Unblinded</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Uncontrolled_trial -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Uncontrolled_trial">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Experimental_study"/>
        <Ontology1325521724189:Reference>Song, J. W., &amp; Chung, K. C. (2010). Observational studies: cohort and case-control studies. Plastic and reconstructive surgery, 126(6), 2234.</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Trials without a control group for comparison.</rdfs:isDefinedBy>
        <rdfs:label>Uncontrolled trial</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Undetermined_stroke -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Undetermined_stroke">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Stroke"/>
        <Ontology1325521724189:Reference>CDISC&apos;s Clinical Data Element Glossary, http://evs.nci.nih.gov/ftp1/CDISC/Clinical_Data_Element_Glossary/Clinical%20Data%20Element%20Glossary.xls.</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Cerebrovascular Accident</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>An acute episode of focal or global neurological dysfunction caused by presumed brain, spinal cord, or retinal vascular injury as a result of hemorrhage or infarction but with insufficient information to allow categorization as ischemic or hemorrhagic.</rdfs:isDefinedBy>
        <rdfs:label>Undetermined stroke</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Unicenter_trial -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Unicenter_trial">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_type"/>
        <Ontology1325521724189:Reference>http://scientific-european-federation-osteopaths.org/en/different-types-of-clinical-trials</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A trial carried out by a single researcher or research team in one hospital or another type of centre.
</rdfs:isDefinedBy>
        <rdfs:label>Unicenter trial</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Water_consumption -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Water_consumption">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Primary_endpoint_measure"/>
        <ont:CDISC_Code>C90484</ont:CDISC_Code>
        <Ontology1325521724189:Reference>Standard for the Exchange of Nonclinical Data (SEND), http://evs.nci.nih.gov/ftp1/CDISC/SEND/SEND%20Terminology.xls</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A measurement of a subject&apos;s water intake. (NCI)</rdfs:isDefinedBy>
        <rdfs:label>Water consumption</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Week -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Week">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Age_unit"/>
        <ont:CDISC_Code>C29844</ont:CDISC_Code>
        <Ontology1325521724189:Reference>Standard for the Exchange of Nonclinical Data (SEND), http://evs.nci.nih.gov/ftp1/CDISC/SEND/SEND%20Terminology.xls</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Any period of seven consecutive days. (NCI)</rdfs:isDefinedBy>
        <rdfs:label>Week</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Year -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Year">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Age_unit"/>
        <ont:CDISC_Code>C29848</ont:CDISC_Code>
        <Ontology1325521724189:Reference>Standard for the Exchange of Nonclinical Data (SEND), http://evs.nci.nih.gov/ftp1/CDISC/SEND/SEND%20Terminology.xls</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>The period of time that it takes for Earth to make a complete revolution around the sun, approximately 365 days; a specific one year period. (NCI)</rdfs:isDefinedBy>
        <rdfs:label>Year</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#/h -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#/h">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#PK_parameter_units_of_measure"/>
        <ont:CDISC_Code>C66966</ont:CDISC_Code>
        <Ontology1325521724189:Reference>Standard for the Exchange of Nonclinical Data (SEND), http://evs.nci.nih.gov/ftp1/CDISC/SEND/SEND%20Terminology.xls</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>per hour</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A rate of occurrences of something within a period of time equal to sixty minutes.</rdfs:isDefinedBy>
        <rdfs:label>/h</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#fg/mL -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#fg/mL">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#PK_parameter_units_of_measure"/>
        <Ontology1325521724189:Reference>Standard for the Exchange of Nonclinical Data (SEND), http://evs.nci.nih.gov/ftp1/CDISC/SEND/SEND%20Terminology.xls</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Femtograms per milliliter.</rdfs:isDefinedBy>
        <rdfs:label>fg/mL</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#g/day -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#g/day">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#PK_parameter_units_of_measure"/>
        <ont:CDISC_Code>C67372</ont:CDISC_Code>
        <Ontology1325521724189:Reference>Standard for the Exchange of Nonclinical Data (SEND), http://evs.nci.nih.gov/ftp1/CDISC/SEND/SEND%20Terminology.xls</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A dose calculation unit expressed in gram(s) per period of time equal to twenty-four hours.</rdfs:isDefinedBy>
        <rdfs:label>g/day</rdfs:label>
    </Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#g/ml -->

    <Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#g/ml">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#PK_parameter_units_of_measure"/>
        <Ontology1325521724189:Reference>Standard for the Exchange of Nonclinical Data (SEND), http://evs.nci.nih.gov/ftp1/CDISC/SEND/SEND%20Terminology.xls</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Gram per Milliliter</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A unit of mass concentration defined as the concentration of one kilogram of a substance in unit volume of the mixture equal to one liter. The concept also refers to the unit of mass density (volumic mass) defined as the density of substance which mass equal to one kilogram occupies the volume one liter.(NCI)</rdfs:isDefinedBy>
        <rdfs:label>g/mL</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#ADAS-Cog -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#ADAS-Cog">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Cognitive_tests"/>
        <Ontology1325521724189:Reference>clinicaltrials.gov/ct2/show/NCT00777608</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>ADAS-Cog (Alzheimer Disease Assessment Scale-Cognitive</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>Alzheimer&apos;s Disease Assessment Scale-Cognitive Subscale (ADAS-Cog)</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The ADAS-Cog is a psychometric instrument that evaluates memory, attention, reasoning, language, orientation and praxis using an 11-point AD assessment Scale.</rdfs:isDefinedBy>
        <rdfs:label>ADAS-Cog</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Abnormal_behavior -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Abnormal_behavior">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Psychiatric_symptoms"/>
        <Ontology1325521724189:Reference>medical-dictionary.thefreedictionary.com/abnormal+behavior

www.ask.com/question-about/Causes-of-Abnormal-Behavior</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Includes any activity judged to be outside the normal behavior for animals of that particular class and age, including the vices, the fixed patterns of abnormality.

It is behavior which is not normal. Abnormal behavior may be observed in patients, kid and animals too. It is caused due to various state of mind and body.</rdfs:isDefinedBy>
        <rdfs:label>Abnormal behavior</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Active_control -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Active_control">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Control"/>
        <Ontology1325521724189:Reference>Michael Stein, M.D, Guy Taylor. M.D &quot; The Encyclopedia of Arthritis&quot; 2004</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>active control group</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>To decide if a treatment is effective, it is best to compare it with another treatment, and this is called a controlled trial. Controlled studies usually compare the new treatment against an inactive substance, like a dummy sugar pill, called a placebo control, or else against some treatment that is known to be effective, called an active control. Comparing the results of the new treatment with the results of the new treatment makes it much easier to determine if the new treatment is effective.</rdfs:isDefinedBy>
        <rdfs:label>Active control</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Adverse_Event_Action-Taken -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Adverse_Event_Action-Taken">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Adverse_Event_Sub-Domain"/>
        <Ontology1325521724189:Reference>www.who.int/patientsafety/events/05/Reporting_Guidelines.pdf</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Adverse event and actions taken</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>It is the action we take to determine the adverse outcome that occurs during or after the use of a drug or other interventions.</rdfs:isDefinedBy>
        <rdfs:label>Adverse event action</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Adverse_Event_Outcome_Assessment -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Adverse_Event_Outcome_Assessment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Adverse_Event_Sub-Domain"/>
        <Ontology1325521724189:Reference>de.dict.md/definition/Outcome</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Adverse Event Outcome Measures</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>Assessment of Adverse Events</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>This is the assessment of the adverse outcomes that occurs during or after the use of a drug or other interventions.</rdfs:isDefinedBy>
        <rdfs:label>Adverse event outcome assessment</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Adverse_Event_Sub-Domain -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Adverse_Event_Sub-Domain">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/45400/?p=terms&amp;conceptid=Adverse_Event_Sub-Domain</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>adverse event</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The Adverse Event sub-domain is intended for those involved in safety related activities; such as detection, evaluation, follow-up and reporting. This includes safety issues involving people or products. It also includes activities during or after a research protocol.</rdfs:isDefinedBy>
        <rdfs:label>Adverse event</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Adverse_events -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Adverse_events">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Secondary_endpoint_measure"/>
        <Ontology1325521724189:Reference>www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>An unfavorable change in the health of a participant, including abnormal laboratory findings, that happens during a clinical study or within a certain time period after the study is over. This may or may not be caused by the intervention being studied.</rdfs:isDefinedBy>
        <rdfs:label>Adverse event</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Age_group -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Age_group">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Inclusion_criteria"/>
        <Ontology1325521724189:Reference>dictionary.reference.com/browse/age+group</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Age groups</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Persons of approximately the same age and often of the same sex, nationality, educational or social background.</rdfs:isDefinedBy>
        <rdfs:label>Age group</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Agitation_test -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Agitation_test">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Physical_Readouts"/>
        <Ontology1325521724189:Reference>medical-dictionary.thefreedictionary.com/agitation</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Restlessness</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Test extreme restlessness as manifested in depression and other mental disorders.</rdfs:isDefinedBy>
        <rdfs:label>Agitation test</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Agreement_to_perform -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Agreement_to_perform">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_administrative_relation"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100077</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>&quot;Agreement to perform study activity&quot; is a study administrative relation. It doesn,t mean performance of a specific study activity (e.g., administration of a drug) itself, but agreement to do so.</rdfs:isDefinedBy>
        <rdfs:label>Agreement to perform</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Agreement_to_perform_oversight -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Agreement_to_perform_oversight">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Agreement_to_perform"/>
        <Ontology1325521724189:Reference>bioportal.bioontologies.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100077</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Oversight Performance</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>&quot;Agreement to perform oversight&quot; is a study administrative relation that entails agreement tpoperform some study activity&quot;. It doesn&apos;t mean performance of oversight per se (e.g., data safety monitoring), but agreement to do so.</rdfs:isDefinedBy>
        <rdfs:label>Agreement to perform oversight</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Agreement_to_perform_study_laboratory_processing -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Agreement_to_perform_study_laboratory_processing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Agreement_to_perform"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=termsconceptid=study_design%3AOCRE100077</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Study Laboratory process</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>&quot;Agreement to perform study laboratory processing&quot; is a study administrative relation that entails to perform some some study activity. It doesn&apos;t mean performance of study laboratory processing per se (e.g., blood or urine tests), but agreement to do so.</rdfs:isDefinedBy>
        <rdfs:label>Agreement to perform study laboratory processing</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Agreement_to_perform_study_subject_assessment_or_intervent -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Agreement_to_perform_study_subject_assessment_or_intervent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Agreement_to_perform"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100077</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>SUBJECT ASSESSMENT</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>&quot;Agreement to perform study subject assessment&quot; is a study administrative relation that entails agreement to perform some study subject assessment. It doesn&apos;t mean performance of study subject assessment per se (e.g., neorologic evaluation), but agreement to do so.</rdfs:isDefinedBy>
        <rdfs:label>Agreement to perform study subject assessment</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Alcohol_addiction -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Alcohol_addiction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Psychiatric_symptoms"/>
        <Ontology1325521724189:Reference>www.stopaddiction.com/index.php/Rehab/Addiction/Alcohol-Addiction.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Addicted to alcohol
</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Alcohol addiction is defined as prolonged and excessive intake of alcoholic drinks leading to a breakdown in health and an addiction to alcohol such that abrupt deprivation leads to severe withdrawal symptoms.</rdfs:isDefinedBy>
        <rdfs:label>Alcohol addiction</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Allocation_group_cardinality -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Allocation_group_cardinality">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Assignment_characteristics"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100002</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Group cardinality</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>In the context of the study where the main comparison is within experimental units, investigator assigns regimen of interventions to an allocation group made up of one (single) or of more than (multiple) experimental unit.</rdfs:isDefinedBy>
        <rdfs:label>Allocation group cardinality</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Allocation_scheme -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Allocation_scheme">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_characteristics"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100021</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Allocation scheme describes the way in which each experimental unit in an interventional trial is allocated to a treatment group.</rdfs:isDefinedBy>
        <rdfs:label>Allocation scheme</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Amyotrophic_Lateral_Scherosis -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Amyotrophic_Lateral_Scherosis">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Disease_presentation"/>
        <Ontology1325521724189:Reference>www.nlm.nih.gov/medlineplus/amyotrophiclateralsclerosis.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>ALS</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Amyotrophic lateral sclerosis is a nervous system disease that attacks nerve cells called neurons in your brain and spinal cord. These neurons transmit messages from your brain and spinal cord to your voluntary muscles- the ones you can control like in your arms and legs.</rdfs:isDefinedBy>
        <rdfs:label>Amyotrophic lateral sclerosis</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Anxiety -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Anxiety">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Secondary_endpoint_measure"/>
        <Ontology1325521724189:Reference>www.medicalnewstoday.com/info/anxiety/</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Anxiety is a general term for several disorders that cause nervousness, fear, apprehension, and worrying. These disorders affect how we feel and behave, and they can manifest real physical symptoms.</rdfs:isDefinedBy>
        <rdfs:label>Anxiety</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Anxiety_test -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Anxiety_test">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Physical_Readouts"/>
        <Ontology1325521724189:Reference>medical-dictionary.thefreedictionary.com/anxiety</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Anxious</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Anxiety is a  multisystem response to a perceived threat or danger. It reflects a combination of biomedical changes in the body, the patient&apos;s personal history and memory, and the social situation.</rdfs:isDefinedBy>
        <rdfs:label>Anxiety test</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Apathy_Evaluation_Scale -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Apathy_Evaluation_Scale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_trial_methods"/>
        <Ontology1325521724189:Reference>www.tbims.org/combi/aes/index.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>AES</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Apathy Evaluation Scale is a method for measuring apathy resulting from brain-related pathology. Apathy is the &quot;lack of motivation not attributable to diminished level of consciousness, cognitive impairment, or emotional distress.
</rdfs:isDefinedBy>
        <rdfs:label>Apathy evaluation scale</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Apathy_test -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Apathy_test">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Physical_Readouts"/>
        <Ontology1325521724189:Reference>medical-dictionary.thefreedictionary.com/apathy</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>test apathy
</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Apathy test is a test that measures  lack of interest, concern, or emotion; indifference in patients or individuals.</rdfs:isDefinedBy>
        <rdfs:label>Apathy test</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Apparent_dose -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Apparent_dose">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Primary_endpoint_measure"/>
        <Ontology1325521724189:Reference>clinicaltrials.gov/ct2/show/NCT01059903</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>evident dose</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>manifest dose</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>plain dose</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Apparent dose is the area under the plasma concentration-time curve from zero up to the last analytically quantifiable concentration normalized by apparent dose.</rdfs:isDefinedBy>
        <rdfs:label>Apparent dose</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Assessment_Scale-cognitive_subscale -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Assessment_Scale-cognitive_subscale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_trial_methods"/>
        <Ontology1325521724189:Reference>www.ncbi.nlm.nih.gov/pubmed/15592137</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>ADAS-cog</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>The alzheimer&apos;s Disease Assessment Scale-Cognitive subsclae (ADAS-Cog) is commonly used to assess cognitive dysfunction in individuals with Alzheimer&apos;s disease and other dementias.</Ontology1325521724189:Synonyms>
        <rdfs:label>Assessment scale-cognitive subscale</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Assessment_method_specification -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Assessment_method_specification">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Informations_of_study"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study%3AOCRE100077</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Method for assessing an outcome, such as a questionaire or laboratory test.</rdfs:isDefinedBy>
        <rdfs:label>Assessment method specification</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Assignment_characteristics -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Assignment_characteristics">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_characteristics"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100048</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Characteristics of assignment</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Characteristics of the assignment experiment experimental units (e.g., participant, eye) to a regimen of interventions.</rdfs:isDefinedBy>
        <rdfs:label>Assignment characteristics</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Attention_test -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Attention_test">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Physical_Readouts"/>
        <Ontology1325521724189:Reference>medical-dictionary.thefreedictionary.com/attention</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Vigilance

tracking</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Attention is the element of cognitive functioning in which the mental focus is patients is maintained on a specific issue, object, or activity. Attention test measures the mental focus of patients.
There are numerous tasks that measure attention, but the most widely used are Trail Making and Digit Span. Other span tests, using letters, words and blocks are also available, as are continuous performance measures. In addition, cancellation tasks, using letters, numbers and shapes, are employed as measures of attention.</rdfs:isDefinedBy>
        <rdfs:label>Attention test</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Basic_science -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Basic_science">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Primary_purpose"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Science</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Protocol designed to examine the basic mechanism of action (e.g.., physiology, biomechanics) of an intervention.</rdfs:isDefinedBy>
        <rdfs:label>Basic science</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Bio-alvailability_study -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Bio-alvailability_study">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_type"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>bio-alvailability</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Scientific basis for comparing generic and brand name drugs</rdfs:isDefinedBy>
        <rdfs:label>Bioavailability trial</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Bio-equivalence_study -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Bio-equivalence_study">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_type"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>bio-equivalence</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Rate and extent to which a drug is absorbed or otherwise available to the treatment site in the body.</rdfs:isDefinedBy>
        <rdfs:label>Bioequivalence trial</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Biochemical_biomarkers_identified_in_cerebrospinal_fluid_and_serum -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Biochemical_biomarkers_identified_in_cerebrospinal_fluid_and_serum">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Biomarkers_in_Neurology"/>
        <Ontology1325521724189:Reference>Gisele Silva, Karen Furie. &quot; Biomarkers in Neurology&quot;. Front Neurol Neurosci. Basel ,karger, 2009, vol 25, pp 55-61</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Biomedical markers
</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Decrease in the A42 peptide in AD. Increase in total protein in AD and decrease in FTD. Reduction in orexin in CSF of HD.</rdfs:isDefinedBy>
        <rdfs:label>Biochemical biomarker</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Biological_Laboratory_variables -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Biological_Laboratory_variables">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Primary_endpoint_measure"/>
        <Ontology1325521724189:Reference>medind.nic.in/iab/t10/iabt10i1p40.pdf</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Biological variables</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>laboratory variables
</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Biological variables such as blood and urine that are being analyzed in the laboratory.</rdfs:isDefinedBy>
        <rdfs:label>Biological laboratory variable</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Biological_Readouts -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Biological_Readouts">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_Trial_Readouts"/>
        <Ontology1325521724189:Reference>www.greenfacts.org/glossary/def/endpoint.htm</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>biological endpoint</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>biological outcome</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>biological readout</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A biological endpoint is a direct marker of disease progression. e.g disease symptoms or death- used to describe a health effect (or a probability of that health effect) resulting from exposure to a chemical.</rdfs:isDefinedBy>
        <rdfs:label>Biological outcome</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Biological_Specimen -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Biological_Specimen">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Protocol_Representation_Sub-Domain"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.oeg/ontologies/45400?p=terms&amp;conceptid=Biospecimen</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Biospecimen

Bio-Specimen

Sample

BiologicSpecimen

BiologicalSecimen

Specimen</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Any material sample taken from a biological entity for testing, diagnostic, propagation, treatment or research purposes, including a sample obtained from a living organism or taken from the biological object after halting of all its life functions. Biospecimen can contain one or more components including but not limited to cellular molecules, cells, tissues, organs, body fluids, embryos, and body excretory products.</rdfs:isDefinedBy>
        <rdfs:label>Specimen</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Biomarkers_in_Neurology -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Biomarkers_in_Neurology">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Pilot_Trials"/>
        <Ontology1325521724189:Reference>Gisele silva, Karen Furie. &quot; Biomarkers in Neurology&quot;. Front Neurol Neurosci. Basel,karger,2009,vol 25, pp 55-61</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Biomarkers in Neurodegenerative Diseases</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A biomarkers Definitions Working Group that included members from the FDA, NIH, universities and industries recently refined definitions for surrogate outcomes, biomarkers, pharmacodynamic markers and clinical endpoints. A biological marker (Biomarker) can be defined as a characteristics that is objectively measured and evaluated as an indicator of normal biologic processes, pathogenic process or pharmacologic responses to a therapeutic intervention.</rdfs:isDefinedBy>
        <rdfs:label>Biomarkers in neurology</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Block_randomization -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Block_randomization">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Restricted_randomization"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100077</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>randomized block</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Blocking randomization is used to ensure close balance of the numbers in each group at any time during the study. After every block the number of participants in each group would be eual. Of course blocking tends to reduce the unpredictability of randomization. Therefore it is recommended to use random block sizes when using block randomization.</rdfs:isDefinedBy>
        <rdfs:label>Block randomization</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Blood -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Blood">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Biological_Laboratory_variables"/>
        <Ontology1325521724189:Reference>www.thefreedictionary.com/blood</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>The fluid consisting of plasma, blood cells, and platelets that is circulated by the heart through the vertebrate vascular system, carrying oxygen and nutrients to and waste materials away from all body tissues.</rdfs:isDefinedBy>
        <rdfs:label>Blood</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Body_Fluids -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Body_Fluids">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Molecular_Readouts"/>
        <Ontology1325521724189:Reference>www.thefreedictionary.com/body+fluid</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>biofluids</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>bodily fluids</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A natural bodily fluid or secretion of fluid such as blood, semen, or saliva. Total body water, contained principally in blood plasma and in intracellular and interstitial fluids.</rdfs:isDefinedBy>
        <rdfs:label>Body fluid</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Body_weight -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Body_weight">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Primary_endpoint_measure"/>
        <ont:CDISC_Code>C81328</ont:CDISC_Code>
        <Ontology1325521724189:Reference>Standard for the Exchange of Nonclinical Data (SEND), http://evs.nci.nih.gov/ftp1/CDISC/SEND/SEND%20Terminology.xls</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Bodyweight</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The weight of a subject. (NCI)</rdfs:isDefinedBy>
        <rdfs:label>Body weight</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Brief_summary -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Brief_summary">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Informations_of_study"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Summary</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Short description of the protocol intended for the lay public. Include a brief statement of the study hypothsis.</rdfs:isDefinedBy>
        <rdfs:label>Brief summary</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#CSF -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#CSF">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Body_Fluids"/>
        <Ontology1325521724189:Reference>www.medterms.com/script/main/art.asp?articlekey=7530</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Cerebrospinal fluid</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A watery fluid, continuously produced and absorbed, which flows in the ventricles (cavities) within the brain and around the surface of the brain and spinal cord.</rdfs:isDefinedBy>
        <rdfs:label>CSF</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#CSF_Alpha_beta_42_level -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#CSF_Alpha_beta_42_level">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#CSF_markers"/>
        <Ontology1325521724189:Reference>www.ncbi.nlm.gov/pubmed/20157306</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>CSF level of alpha/beta</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>The levels of cerebrospinal fluid (CSF) beta-amyloid 42</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>beta-amyloid42 in CSF</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The level of 42 amino acids form of amyloid  beta as a cerebrospinal fluid biomarkers for predicting future cognitive decline in healthy individuals and the progression to dementia in patients who are cognitively impaired.</rdfs:isDefinedBy>
        <rdfs:label>CSF Alpha beta 42 level</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#CSF_concentrations -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#CSF_concentrations">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Primary_endpoint_measure"/>
        <Ontology1325521724189:Reference>backandneck.about.com/od/c/g/cerebrospinalfl.htm</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>concentration of cerebrospinal fluid</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The concentration of a fluid that circulates throughut the central nervous system. The cerebrospinal fluid is located between the brain and the skull.</rdfs:isDefinedBy>
        <rdfs:label>CSF concentration</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#CSF_markers -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#CSF_markers">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Biological_Readouts"/>
        <Ontology1325521724189:Reference>www.ncbi.nlm.nih.gov/pubmed/20157306</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>cerebrospinal fluid marker</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A marker for the prediction of cognitive decline in healthy individuals and the progression to dementia in patients who are cognitively declined.</rdfs:isDefinedBy>
        <rdfs:label>CSF marker</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#CSF_total_tau_level -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#CSF_total_tau_level">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#CSF_markers"/>
        <Ontology1325521724189:Reference>www.ncbi.nlm.nih.gov/pubmed/20157306</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>CSF total tau concentrations</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>Cerebrospinal fluid levels of total-tau</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The level of total and  phosphorylated tau as a cerebrospinal fluids for the prediction of cognitive declinne in healthy individuals and the progression of dementia in patients who are cognitive impaired.</rdfs:isDefinedBy>
        <rdfs:label>CSF total tau level</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Cardiac -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Cardiac">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Physical_symptoms"/>
        <Ontology1325521724189:Reference>www.thefreedictionary.com/cardiac</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>cardiac</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>heart disease

Cardiac arrest</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A person suffering from heart disease or disorder</rdfs:isDefinedBy>
        <rdfs:label>Cardiac symptom</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Case-control -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Case-control">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Intervention_model"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>case referent study</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Single group of individuals with specific characteristics (e.g.., conditions or exposures).</rdfs:isDefinedBy>
        <rdfs:label>Case-control</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Case-crossover_study_design -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Case-crossover_study_design">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Observational_study"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100015</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Case-Crossover Study</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A case-crossover study is an observational study that aims to answer the question, &quot;was this event trggered by something unusual that happened just before?&quot; The key feature of the design is that each case serves as its own control. the method is analogous to a crossover experiment viewed retrospectively, except that the investigator does not control when an experimental unit starts and stops being exposed to the potential trigger. Also, the exposure frequency unit was at risk of the injury or disease onset. thus it usually resembles a case-control study more than a retrospective cohort study.</rdfs:isDefinedBy>
        <rdfs:label>Case-control study design</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Causal_Assessment -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Causal_Assessment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Adverse_Event_Sub-Domain"/>
        <Ontology1325521724189:Reference>www.cochrane.org/glossary</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Causality Assessment</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>An adverse event for which the causal relation between the drug/intervention and the event is assess and is at least a reasonable possibility.</rdfs:isDefinedBy>
        <rdfs:label>Causal assessment</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Change_from_baseline -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Change_from_baseline">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Secondary_endpoint_measure"/>
        <Ontology1325521724189:Reference>www.ata-divisions.org/GLD/docs/48_konferenz/Glossary_clinical_trials_EN-GE.pdf</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Change from values, findings etc. before treatment.</rdfs:isDefinedBy>
        <rdfs:label>Change from baseline</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_Dementia_Rating_Scale-sum_of_boxes -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_Dementia_Rating_Scale-sum_of_boxes">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_trial_methods"/>
        <Ontology1325521724189:Reference>Roberto R., Emiliano A. &quot; Cholinesterase Inhibitors in Mild Cognitive Impairement: A systematic Review of Randomised Trials. &quot; PLoS Medicine 2007</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>CDR-SB</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Clinical Dementia Rating-Sum of the boxes; Its variant, the CDR sum of the boxes (CDR-SB), is a more quantitative numerical rating (it merely sums up the scores of the six individual domains of the CDR)</rdfs:isDefinedBy>
        <rdfs:label>Clinical dementia rating scale-sum of the boxes</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_Global_Impression_of_Change -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_Global_Impression_of_Change">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_trial_methods"/>
        <Ontology1325521724189:Reference>Roberto Raschetti, Emiliano Albanese, Nicola Vanacore, Marina Maggini &quot; Cholinesterase Inhibitora in Mild Cognitive Impairement: A systematic Review of Randomised Trials&quot;. PLoS Medicine. 2007</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>CGIC</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Clinical global impression of change scale is a clinical measures that are use for patients with aMCL, based on semistructured interviews from both the subject and the informant.</rdfs:isDefinedBy>
        <rdfs:label>Cinical global impression of change</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_Global_Impressions_scale -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_Global_Impressions_scale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_trial_methods"/>
        <Ontology1325521724189:Reference>www.personal.kent.edu/~dFresco_papers/Zaider_et_al_CGI.pdf</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>CGI</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Clinical Global Impression scale is a set of ratings made by a clinician in order to assess the overall severity of an individual&apos;s symptoms as well as changes in his or her functioning over time. It is commonly used as primary outcomes measure in studies evaluating the efficacy of treatments for anxiety disorders.</rdfs:isDefinedBy>
        <rdfs:label>Clinical global impression scale</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_Trial_Readouts -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_Trial_Readouts">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial"/>
        <Ontology1325521724189:Reference>clinicaltrials.gov/ct2/info/glossary</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>clinical endpoint

</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>clinical trial endpoint</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>clinical trial readout</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>readout in clinical trials</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Overall outcomes that the protocol is designed to evaluate. Common enpoints are severe toxicity, disease progression, or death.</rdfs:isDefinedBy>
        <rdfs:label>Clinical trial outcome</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_Trial_Study -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_Trial_Study">
        <Ontology1325521724189:Reference>http://www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A research study using human subjects to evaluate the effect of interventions or exposures on biomedical or health-related outcomes. </rdfs:isDefinedBy>
        <rdfs:label>Clinical trial study</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_Trial_measurement_Units -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_Trial_measurement_Units">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Structure_of_clinical_trial"/>
        <Ontology1325521724189:Synonyms>Measurement units</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>These are units use for the measurement of clinical trial study.</rdfs:isDefinedBy>
        <rdfs:label>Clinical trial measurement unit</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_biomarkers -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_biomarkers">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Biomarkers_in_Neurology"/>
        <Ontology1325521724189:Reference>Gisele Silva, Karen Furie. &quot;biomarkers in Neurology&quot; Front Neurol, Neurosci, Basels, karger, 2009, vol 25, pp 55-61</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Cognitive dysfunction evaluation in PD. Attention and executive function testing for disease progression in HD. Visual and verbal memory span acores to identify the earliest cognitive deficits in elderly patients at genetic risk of AD.</rdfs:isDefinedBy>
        <rdfs:label>Clinical biomarker</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_event -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_event">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Events"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100077</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A clinical event is an event during which an assyssment of, or intervention on a study subject occures.</rdfs:isDefinedBy>
        <rdfs:label>Clinical event</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_imagings -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_imagings">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_trial_methods"/>
        <Ontology1325521724189:Reference>www.elsevier.com/wps/find/journaldescription.cws_home/505753/description#description</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Imagings</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Clinical imaging is a neuroimaging measures. It provides comprehensive coverage of new technology, new application, and important issues concerning all diagnostic imaging methods.</rdfs:isDefinedBy>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_trial_methods -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_trial_methods">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial"/>
        <Ontology1325521724189:Reference>Peace, K. E., &amp; Chen, D. G. D. (2010). Clinical Trial Methodology. CRC Press.</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Clinical trial method</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Clinical trial methodology comprises all methods required for the protection of participants in a clinical trial and all methods necessary to provide a valid inference.</rdfs:isDefinedBy>
        <rdfs:label>Clinical trial methodology</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#CogState -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#CogState">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Cognitive_tests"/>
        <Ontology1325521724189:Reference>clinicaltrials.gov/ct2/show/NCT00777608</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>CogState ClinicalTrials</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>CogState is a simple , brief computerized neuropsychological battery to evaluate cognitive impairments characterizing mild-to-moderate Alzheimer&apos;s disease.</rdfs:isDefinedBy>
        <rdfs:label>CogState</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Cognitive_Readouts -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Cognitive_Readouts">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_Trial_Readouts"/>
        <Ontology1325521724189:Reference>medical-dictionary.thefreedictionary.com/cognition</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Cognitive endpoint</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>Cognitive readout</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Overall outcome measures of the mental faculty of knowing, which  includes perceiving, recognizing, conceiving, judging, reasoning and imagining.</rdfs:isDefinedBy>
        <rdfs:label>Cognitive outcome</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Cognitive_tests -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Cognitive_tests">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Cognitive_Readouts"/>
        <Ontology1325521724189:Reference>encyclopedia.thefreedictionary.com/cognitive+tests</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Cognitive ability tests</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Cognitive tests are assessments of the cognitive capabilities of humans and animals. Tests administered to humans include various forms of IQ tests.</rdfs:isDefinedBy>
        <rdfs:label>Cognitive test</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Cohort -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Cohort">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Intervention_model"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Group of individuals, initially defined and composed, with common characteristics (e.g.., condition, birth year), who are examined or traced over a given period.</rdfs:isDefinedBy>
        <rdfs:label>Cohort</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Cohort_study_design -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Cohort_study_design">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Observational_study"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>follow-up study design</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Group of individuals, initially and composed, with common characteristics (e.g.., condition, birth year), who are examined or traced over a given time period.</rdfs:isDefinedBy>
        <rdfs:label>Cohort study design</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Committees_for_Multicenter_Clinical_Trials -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Committees_for_Multicenter_Clinical_Trials">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Multicentered_Trials"/>
        <Ontology1325521724189:Reference>Harold P. Adams Jr. &quot; Committees for Multicenter Clinical Trials&quot;.  Woodburg-Harris KM, Coull BM(eds): Clinical Trials in the Neurosciences. Front Neurol Neurosci. Basel, Karger, 2009, Vol 25, pp 124-126.</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>executive committee</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Most large clinical trials also have a committee structure that provides advice to the principal investigator, help in the overall conduct of the study, performs some components of the research, organizes and supervises publications, and executes independent safety monitoring.</rdfs:isDefinedBy>
        <rdfs:label>Committee for multicenter clinical trial</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Comparator -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Comparator">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_arms"/>
        <Ontology1325521724189:Reference>www.cochrane.org/glossary/5#term116</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>comparator group</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The arm that acts as a comparator for one or more experimental interventions.</rdfs:isDefinedBy>
        <rdfs:label>Comparator arm</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Completed -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Completed">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Closed_study"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>completed</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The study has concluded normally; participants are no longer examined or treated.</rdfs:isDefinedBy>
        <rdfs:label>Recruitment completed</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Completion_Date -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Completion_Date">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Informations_of_study"/>
        <Ontology1325521724189:Reference>grants.nih.gov/clinicaltrials_fdaaa/definitions.htm</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>date of completion</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Final date on which data were (or are expected to be) collected. </rdfs:isDefinedBy>
        <rdfs:label>Completion date</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Computed_tomography -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Computed_tomography">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_imagings"/>
        <Ontology1325521724189:Reference>www.ndt-ed.org/EducationResources/CommunityCollege/Radiography/AdvancedTechniues/computedtomography.htm</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>(CT)</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>This is a powerful nondestructive evaluation (NDE) techniue for producing 2-D and 3-D cross sectional images of an object from flat X-ray images.</rdfs:isDefinedBy>
        <rdfs:label>Computed tomography</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Concomitant_Agent -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Concomitant_Agent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_Conduct_Sub-Domain"/>
        <Ontology1325521724189:Reference>www.medaphile.com/medical-dictionary/concomitant-agent</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>CONTRT</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>Concomitant therapy</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>concomitant agent</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A pharmaceutical agent other than agent(s) tested in a given protocol that is administered to or used by a subject either prior to or during the study.</rdfs:isDefinedBy>
        <rdfs:label>Concomitant medication</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Concomitant_medication -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Concomitant_medication">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Exclusion_criteria"/>
        <Ontology1325521724189:Reference>www.barkerstats.com/PDFs/concomitant.pdf</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Concomitant drugs</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Concomitant Medications are medications used by patients in a clinical trial, other than the investigational drug.</rdfs:isDefinedBy>
        <rdfs:label>Concomitant medication</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Confidence_interval -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Confidence_interval">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Statistical_significance"/>
        <Ontology1325521724189:Reference>www.cochrane.org/glossary/5#letterh</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A measure of the uncertainty around the main finding of a statistical analysis- Estimates of unknown quantities such as the odds ratio comparing an experimental intervention with a control, are usually presented as a point estimate and a 95% confidence interval. this means that if someone were to keep repeating a study in other samples from the same population, 95% of the confidence intervals from those studies would contain the true value of the unknown quantity.</rdfs:isDefinedBy>
        <rdfs:label>Confidence interval</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Confusion -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Confusion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Psychiatric_symptoms"/>
        <Ontology1325521724189:Reference>dictionary.reference.com/browse/confusion</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>distraction</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The state of being confused.</rdfs:isDefinedBy>
        <rdfs:label>Confusion</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Control -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Control">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_design"/>
        <Ontology1325521724189:Reference>www.sahealthinfo.org/evidence/c.htm</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>control group</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>In a clinical trial comparing two or more interventions, a control is a person in the comparison group that recieves a placebo, no intervention, usual care or another form of care.</rdfs:isDefinedBy>
        <rdfs:label>Control</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Cross-sectional_study_design -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Cross-sectional_study_design">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Observational_study"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Cross-sectional study
</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>prevalence study</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Observations or measurements made at a single point in time, usually at subject enrollment.</rdfs:isDefinedBy>
        <rdfs:label>Cross-sectional study design</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Crossover_assignment -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Crossover_assignment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Intervention_model"/>
        <Ontology1325521724189:Reference>www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Describes a clinical trial in which groups of participants receive two or more interventions in a particular order. For example, a two-by-two crossover design involves two groups of participants. One group receives drug A during the initial phase of the trial, followed by drug B during a later phase. The other group receives drug B during the initial phase, followed by drug A during a later phase. So during the study, participants &quot;cross over&quot; to the other drug. All participants receive drug A and drug B at some point during the study, but in a different order, depending on the group to which they are assigned.</rdfs:isDefinedBy>
        <rdfs:label>Crossover design</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Crossover_study_design -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Crossover_study_design">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Interventional_study_design"/>
        <Ontology1325521724189:Reference>www.sahealthinfo-org/evidence/c.htm</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>CROSSOVER TRIAL</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A type of clinical trial comparing two or more interventions in which the participants, upon completion of the course of one treatment are switched to another.</rdfs:isDefinedBy>
        <rdfs:label>Cross-over study</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Data_Management_and_Quality_Assurance -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Data_Management_and_Quality_Assurance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_Conduct_Sub-Domain"/>
        <Ontology1325521724189:Reference>Dejuran Richardson, Selma Kunitz. &quot; Data Management and Quality Assurance&quot;. Front Neurol Neurosci. Basel, karger, 2009, vol 25, pp 98-105</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>study data management activities</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Data management emcompasses the acquisition and maintenance of study data. Data management activites are important to any study because data are the medium by which the study results are processed, interpreted and reported. the conduct of any clinical study requires a substantial investment of financial and human capital. A comprehensive data management strategy represents thoughtful stewardship of these limited resources. The quality of any study rests heavily on the quality of its data management effort.
stdy data management activities should focus ensuring that: 
- data are of the highest quality
- participant safety and confidentiality are protected and 
- study staff has tools that facilitate efficient and effective conduct of the study.

Quality assurance, as applied to clinical trials, is any method or procedure for collecting, processing or analyzing data that is aimed at maintaining or enhancing their reliability or validity. Quality assurance encompasses internal quality control, study monitoring and external audits or assessments.</rdfs:isDefinedBy>
        <rdfs:label>Data management</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Data_analysis_within_experimental_units -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Data_analysis_within_experimental_units">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_characteristics"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100046</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>In the context of a study where the main comparison is within experimental units, whether data is analyzed within a single study experimental unit or within multiple experimental units.</rdfs:isDefinedBy>
        <rdfs:label>Data analysis within experimental units</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Data_analyzed_within_multiple_experimental_units -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Data_analyzed_within_multiple_experimental_units">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Data_analysis_within_experimental_units"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100063</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Many Experimental unit</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>data is analyzed within multiple study experimental units.</rdfs:isDefinedBy>
        <rdfs:label>Data analyzed within multiple experimental units</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Data_analyzed_within_single_experimental_units -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Data_analyzed_within_single_experimental_units">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Data_analysis_within_experimental_units"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100085</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>One experimental unit</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Data is analyzed within a single study experimental unit.</rdfs:isDefinedBy>
        <rdfs:label>Data analyzed within single experimental unit</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Date_of_registration -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Date_of_registration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Informations_of_study"/>
        <Ontology1325521724189:Reference>www.unmc.edu/irb/index.cfm?L1_ID=15&amp;CONREF=18</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Registration date</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Registration date is defined as the date the study was registered in ClinicalTrials.gov.</rdfs:isDefinedBy>
        <rdfs:label>Date of registration</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Delusion -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Delusion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Psychiatric_symptoms"/>
        <Ontology1325521724189:Reference>medical-dictionary.thefreedictionary.com/Delusion</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>deception</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A false belief strongly held in spite of invalidating evidence, especially as a symptom of mental illness.</rdfs:isDefinedBy>
        <rdfs:label>Delusion</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Diabetes -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Diabetes">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Exclusion_criteria"/>
        <Ontology1325521724189:Reference>www.medicalnewstoday.com/info/diabetes/</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>diabetes mellitus</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Diabetes is classed as a metabolism disorder. Metabolish refers to the way our bodies use digested food for energy and growth. Most of what we eat is broken down into glucose, a form of sugar.</rdfs:isDefinedBy>
        <rdfs:label>Diabetes</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Diagnostic -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Diagnostic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Primary_purpose"/>
        <Ontology1325521724189:Reference>pr.clinicaltrials.goy/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Diagnose</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Protocol designed to evaluate one or more interventions aimed at identifying a disease or health condition.</rdfs:isDefinedBy>
        <rdfs:label>Diagnostic</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Dizziness -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Dizziness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Symptomatic_postural_hypotension"/>
        <Ontology1325521724189:Reference>theraurus.com/browse/dizziness</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>dysequilibrium

faintness

giddiness

lightheadedness

unsteadiness

vertigo

 wooziness</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Dizziness refers to an impairment in spatial perception and stability.</rdfs:isDefinedBy>
        <rdfs:label>Dizziness</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Double_blind -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Double_blind">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Blindness"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>double-masked study</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Two or more parties are unware of the intervention assignment.</rdfs:isDefinedBy>
        <rdfs:label>Double blind</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Drug_addiction -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Drug_addiction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Psychiatric_symptoms"/>
        <Ontology1325521724189:Reference>www.ehow.com/facts_5127985_drug-addiction_.html?ref=Track2&amp;utm_source=ask</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>addicted  to drug</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>An addiction to drugs is a compulsion to take a substance, regardless of its physical or emotional harm to oneself or others.</rdfs:isDefinedBy>
        <rdfs:label>Drug addiction</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Drug_allergy -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Drug_allergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Exclusion_criteria"/>
        <Ontology1325521724189:Reference>www.nlm.gov/medlineplus/ency/article/000819.htm</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Allergic reaction

Drug allergies

Reactions to drugs</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Drug allergy are symptoms caused by an allergic reaction to a drug (medication).</rdfs:isDefinedBy>
        <rdfs:label>Drug allergy</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Efficacy_study -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Efficacy_study">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Phase_II"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Efficacy</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Efficacy: measure of an intervention&apos;s influence on a disease or health condition.</rdfs:isDefinedBy>
        <rdfs:label>Efficacy study</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Encephalitis -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Encephalitis">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Disease_presentation"/>
        <Ontology1325521724189:Reference>www.nlm.nih.gov/medlineplus/encephalitis.html</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Encephalitis is an inflammation of the brain. The usual cause is a vival infection, but bacteria can also cause it. Cases can range from mild to severe.</rdfs:isDefinedBy>
        <rdfs:label>Encephalitis</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Epilepsy -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Epilepsy">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Disease_presentation"/>
        <Ontology1325521724189:Reference>www.nlm.nih.gov/medlineplus/epilepsy.html</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Epilepsy is a brain disorder that causes people to have recurring seizures. The seizures happen when clusters  of nerve cells, or neurons, in the brain send out the wrong signals. People may have strange sensations and emotions or behave strangely. They may have violent muscles spasms orlose consciousness.</rdfs:isDefinedBy>
        <rdfs:label>Epilepsy</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Epworth_Sleepiness_Scale -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Epworth_Sleepiness_Scale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_trial_methods"/>
        <Ontology1325521724189:Reference>www.umm.edu/sleep/epworth_sleep.htm</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>ESS</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The Epworth Sleepiness Scale is a scale used to determine the level of daytime sleepiness. the score of 10 or more is considered sleepy. A score of 18 or more is very sleepy.</rdfs:isDefinedBy>
        <rdfs:label>Epworth sleepiness scale</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Estimated_Enrollment -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Estimated_Enrollment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Informations_of_study"/>
        <Ontology1325521724189:Reference>www.syncardia.com/Medical-professionals/clinicaltrials.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Enrollment estimates</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>This is the estimated number of participants that are being enrolled in a clinical trial studies.</rdfs:isDefinedBy>
        <rdfs:label>Estimated enrollment</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Ethics_approval_process -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Ethics_approval_process">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_administrative_relation"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100077</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Ethical approval</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The ethivs approval process is a study administrative relation whereby a study is submitted to a committee that is formally designated to approve, monitor, and review biomedical and behavioral research involving humans with the aim to protect the rights and welfare of the research subjects.</rdfs:isDefinedBy>
        <rdfs:label>Ethichs approval process</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Evaluated_Activity -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Evaluated_Activity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Adverse_Event_Sub-Domain"/>
        <Ontology1325521724189:Synonyms>Activity Evaluation</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Determining the efficacy of a particular activity.

</rdfs:isDefinedBy>
        <rdfs:label>Evaluated activity</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Evaluated_Result -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Evaluated_Result">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Adverse_Event_Sub-Domain"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46116/?p=terms&amp;conceptid=363109007</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Evaluation of test results</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Determining the efficacy of a particular result.</rdfs:isDefinedBy>
        <rdfs:label>Evaluated result</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Events -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Events">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Masking"/>
        <Ontology1325521724189:Reference>bioportal.bioontologies.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100077</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>An event is a processual entity that is a maximally connected spatiotemporal whole and has beginings and endings corresponding to real discontinuities. Example: the life of an organism, the porcess of sleeping, the process of cell-devision.</rdfs:isDefinedBy>
        <rdfs:label>Events</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Exclusion_criteria -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Exclusion_criteria">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Recruitment_criteria"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46317/?p=terms&amp;conceptid=Exclusion_Criteria</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>criterion for exclusion</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Elements of a personal medical history which would prevent an individual from participating in a specific clinical trial.</rdfs:isDefinedBy>
        <rdfs:label>Exclusion criteria</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Executive_Functions -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Executive_Functions">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Physical_Readouts"/>
        <Ontology1325521724189:Reference>Bonnie E. Levin. &quot;Behavioral/Neuropsychological outcomes and uality of life Endpoints&quot;. Front neurol neurosci. Basel karger, 2009, vol 25, pp 78-92</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>command and control function</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Executive functions refer to the complex of behaviors involved in antipating, planning and formulating goals, self-monitoring as well as using feedback to guide and modify behavior. This domain is considered to be an essential component of neuropsychological testing. Specific executive functions include verbal and conceptual reasoning, generating problem-solving strategies, planning and formulating abstractions, managing multiple tasks at the same time, set shifting and the ability to ignore competing stimuli while focusing on relevant task demands.</rdfs:isDefinedBy>
        <rdfs:label>Executive function</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Experimental -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Experimental">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_arms"/>
        <Ontology1325521724189:Reference>www.cancer.gov/clinicaltrials/conducting/ncictrp/resources/glossary</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Experimental Arm</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>An arm or group in which an experimental drug or regimen is being administered. This will be used when the trial specifies that one arm is a control arm and the other is experimental, or when the other arm is a placebo arm. In cases where patients are not randomized but assigned to groups according to certain characteristics (e.g., risk characteristics, age, diagnosis), use &quot;experimental&quot; for all group/strata because they are not being compared.</rdfs:isDefinedBy>
        <rdfs:label>Experimental arm</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Exploratory_Clinical_Trials -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Exploratory_Clinical_Trials">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_characteristics"/>
        <Ontology1325521724189:Reference>wiki.answers.com/Q/What_is_exploratory_clinical_trial</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Exploratory Clinical Trial is defined as those intended to be conducted early in phase I, involving limited human explosure, have no therapeutic intent, and not intended to examine clinical tolerability. Exploratory approaches for first in human studies have been developed in order to drive the selection of compounds or targeted drug approaches based on human data rather than sloely animal and in vitro data.</rdfs:isDefinedBy>
        <rdfs:label>Exploratory clinical trial</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Fasted_state -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Fasted_state">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Food_effect"/>
        <Ontology1325521724189:Reference>www.epidemic.org/theFacts/theLiver/fedAndFasting/</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>fasting state</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>This is the state where drugs or medications are administered by patients or participants without eating for a while.</rdfs:isDefinedBy>
        <rdfs:label>Fested state</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Feasibility_assessment -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Feasibility_assessment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Primary_endpoint_measure"/>
        <Ontology1325521724189:Reference>www.businessdictionary.com/definition/feasibility-analysis.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>feasibility analysis</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>feasibility study</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>An anylysis and evaluation of a proposed project to determine if it (1) is technically feasible, (2) is feasible within the estimated cost, and (3) will be profitable. Feasiblity studies are almost  always conducted where large sums are at stake.</rdfs:isDefinedBy>
        <rdfs:label>Feasibility assessment</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Fed_state -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Fed_state">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Food_effect"/>
        <Ontology1325521724189:Reference>www.epidemic.org/theFacts/theLiver/fedAndFasting/</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>This is the state where drugs or medications are administered by patients or individuals where the patients have been eating. A period following a meal and is characterized by high levels of nutrients in the blood.</rdfs:isDefinedBy>
        <rdfs:label>Fed state</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#First_recieved_Date -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#First_recieved_Date">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Multicentered_Trials"/>
        <Ontology1325521724189:Reference>http://www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>date received</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The first received date is the date that summary clinical study protocol information was first submitted to the ClinicalTrials.gov registry. </rdfs:isDefinedBy>
        <rdfs:label>First received date</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Fluctuations_in_attention -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Fluctuations_in_attention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Primary_endpoint_measure"/>
        <Ontology1325521724189:Reference>www.neurology.org/content/59/11/1714.abstract</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>fluctuations of attention</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Fluctuations in the way we actively process specific information present in our enviroment.</rdfs:isDefinedBy>
        <rdfs:label>Fluctuation in attention</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Food_effect -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Food_effect">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Primary_endpoint_measure"/>
        <ont:CDISC_Code>C90384</ont:CDISC_Code>
        <Ontology1325521724189:Reference>Standard for the Exchange of Nonclinical Data (SEND), http://evs.nci.nih.gov/ftp1/CDISC/SEND/SEND%20Terminology.xls</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>effects of food</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>food consumption</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A measurement of a subject&apos;s nutritional intake. (NCI)</rdfs:isDefinedBy>
        <rdfs:label>Food effect</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Freezing -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Freezing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Exclusion_criteria"/>
        <Ontology1325521724189:Reference>theraurus.com/browse/freezing</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>chill, shevery,frosty</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>very cold</rdfs:isDefinedBy>
        <rdfs:label>Freezing</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Frontotemporal_dementia -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Frontotemporal_dementia">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Disease_presentation"/>
        <Ontology1325521724189:Reference>www.mayoclinic.com/health/frontotemporal-dementia/DS00874</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Frontotemporal lobar degeneration</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Frontotemporal dementia is an umbrella term for a diverse group of uncommon disorders that primarily affect the frontal and temporal lobes of the brain- the areas generally associated with personality, behavior and language.</rdfs:isDefinedBy>
        <rdfs:label>Frontotemporal dementia</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Functional_imaging_fMRI -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Functional_imaging_fMRI">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Biomarkers_in_Neurology"/>
        <Ontology1325521724189:Reference>Gisele Silva, Karen Furie. &quot; Biomarkers in Neurology&quot; Front Neurol Neurosci. Basel, karger, 2009, vol 25, pp 55-61</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Functional Magnetic Resonance Imaging</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>fMRI</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>BOLD responses in presymptomatic gene carriers in HD. BOLD activation in the hippocampal and parahippocampal regions in MCI.</rdfs:isDefinedBy>
        <rdfs:label>Functional imaging</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Funding -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Funding">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_administrative_relation"/>
        <Ontology1325521724189:Reference>bioportal.bioontologies.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100077</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Financing</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Fiscal support for research from industry, government, or non-commercial. non-governmental organizations.

EXAMPLE(S): 
Funding from pharmaceutical, device or biotechnology companies, the US NIH or the Gates Foundation.</rdfs:isDefinedBy>
        <rdfs:label>Funding</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Gender -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Gender">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Inclusion_criteria"/>
        <Ontology1325521724189:Reference>www.who.int/gender/whatisgender/en/</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Sex</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Gender refers to the socially constructed roles, behaviors, activities, ans attribute that a given society considers appropriate for men and women.</rdfs:isDefinedBy>
        <rdfs:label>Gender</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Genetic_Brain_disorders -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Genetic_Brain_disorders">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Disease_presentation"/>
        <Ontology1325521724189:Reference>www.nlm.nih.gov/medlineplus/gentocbrainisorders.html</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A genetic disorder is a disease caused by a difficult form of a gene, called a variable, or a change in a gene, called a mutation. Genetic brain disorders specifically affect the development and function of the brain.</rdfs:isDefinedBy>
        <rdfs:label>Genetic brain disorder</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Haemopoietic -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Haemopoietic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Physical_symptoms"/>
        <Ontology1325521724189:Reference>medical-dictionary.thefreedictionary.com/hematopoietic</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>blood cell formation</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>haemopoietic</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>An agent that promotes the formation of blood cells</rdfs:isDefinedBy>
        <rdfs:label>Haemopoietic symptom</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Hallucination -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Hallucination">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Psychiatric_symptoms"/>
        <Ontology1325521724189:Reference>dictionary.reference.com/browse/hallucination</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>phantasm

aberration</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A perception of something with no external cause usually arising from a disorder of the nervous system or in response to drugs.

 It can also be define as false or distorted sensory experience that appear to be perceptions. These sensory impressions are generated by the mind rather than by any external stimuli and may be seen, heard,felt, and even smelled or tasted.</rdfs:isDefinedBy>
        <rdfs:label>Hallucination</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Hazard_ratio -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Hazard_ratio">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Statistical_significance"/>
        <Ontology1325521724189:Reference>www.cochrane.org/glossary/5#letterh</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A measure of effect produced by a survival analysis. this represents the increased risk with which one group is likely to experience the outcome of interest. For example, if the hazard ratio for death for a treatment is 0.5, less than we can say that treated patients are likely to die at half the rate of untreated patients.</rdfs:isDefinedBy>
        <rdfs:label>Hazard ratio</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Health_Services -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Health_Services">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Primary_purpose"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Protocol designed to evaluate the delivery, processes ,management, organization or financing of health care.</rdfs:isDefinedBy>
        <rdfs:label>Health services</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Hepatic -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Hepatic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Physical_symptoms"/>
        <Ontology1325521724189:Reference>dictionary.reference.com/browse/hepatic</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>hepatic</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Liver-colored; dark reddish-brown</rdfs:isDefinedBy>
        <rdfs:label>Hepatic symptom</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Hohen_and_Yahr_Scale -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Hohen_and_Yahr_Scale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_trial_methods"/>
        <Ontology1325521724189:Reference>parkinsonsdisease.myguideusa.com/answers-to-my-questions/what-is-the-hohn-and-yahr-scale?/</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Hohen and yahr scale is a common used system for describing the symptoms of parkinson&apos;s disease progression. The scale allocates stages from 0 to 5 to indicae the relative level of disability as follows:
- stage one: symptoms on one side of the body only.
- stage two: symptoms on both sides of the body. No impairment of balance.
- Stage three: Balance disability. Mild to moderate disease. Physically independent.
- Stage four: Severe disability, but still able to walk or stand unassisted.
- Stage five: wheelchair-bound or bedridden unless assisted.</rdfs:isDefinedBy>
        <rdfs:label>Hohen and Yahr scale</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Hydrocephalus -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Hydrocephalus">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Disease_presentation"/>
        <Ontology1325521724189:Reference>www.ninds.nih.gov/disorders/hydrocephalus/hydrocephalus.htm</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Hydrocephalus is a condition in which the primary characteristic is excessive accumulation of cerebrospinal (CSF) fluid in the brain.</rdfs:isDefinedBy>
        <rdfs:label>Hydrocephalus</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Inclusion_criteria -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Inclusion_criteria">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Recruitment_criteria"/>
        <Ontology1325521724189:Reference>www.cdisc.org/stuff/contentmgr/files/0/be650811feb46f381f0af41ca40ade2e/misc/cdisc_2009_glossary.pdf</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>The criteria in a protocol that prospective subjects must meet to be eligable for participation in a study.</rdfs:isDefinedBy>
        <rdfs:label>Inclusion criteria</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Informations_of_study -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Informations_of_study">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Structure_of_clinical_trial"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100077</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>study informations</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Informations of study is a structure whose purpose is to hold information. </rdfs:isDefinedBy>
        <rdfs:label>Study information</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Informed_consent -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Informed_consent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Inclusion_criteria"/>
        <Ontology1325521724189:Reference>http://www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A process in which researchers communicate with potential and enrolled participants about a clinical study. </rdfs:isDefinedBy>
        <rdfs:label>Informed consent</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Inpatient -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Inpatient">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Status"/>
        <Ontology1325521724189:Reference>dictionary.reference.com/browse/inpatient</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>In-patient</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A patient who stays in a hospital while recieving medical care or treatment.</rdfs:isDefinedBy>
        <rdfs:label>Inpatient</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Intervention_assignment_scheme -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Intervention_assignment_scheme">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Assignment_characteristics"/>
        <Ontology1325521724189:Reference>bioportal-bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100003</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Intervention assignment
</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The scheme used to assign regimens of interventions: single factor or factorial.</rdfs:isDefinedBy>
        <rdfs:label>Intervention assignment scheme</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Intervention_model -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Intervention_model">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_design"/>
        <Ontology1325521724189:Reference>http://www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Model of Intervention</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The general design describing the strategy in which interventions will be assigned to participants in a clinical study.</rdfs:isDefinedBy>
        <rdfs:label>Intervention model</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Interventional_study_design -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Interventional_study_design">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Quantitative_study_design"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms%conceptid=study_design%3AOCRE100007</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Intervention studies

</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>An interventional study is a quantitative study that prospectively assigns experimental units to one or more health-related interventions to evaluate the effects on health outcomes. Interventions include but are not restricted to drugs, cells and other biological products, surgical procedures, radiologic procedures, devices, behavioural treatments, process-of-care changes, preventive, etc.</rdfs:isDefinedBy>
        <rdfs:label>Interventional study</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Investigator_assignment_role -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Investigator_assignment_role">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Assignment_characteristics"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100058</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Investigator Assignment</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The role investigator plays in the assignment of study experimental units to one or more regimens of interventions (each including one or more interventions, or no intervention).</rdfs:isDefinedBy>
        <rdfs:label>Investigator assignment role</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Investigator_assigns_intervention -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Investigator_assigns_intervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Investigator_assignment_role"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100026</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Investigators assign the intervention</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The investigator actively assigns the study experimental units to one or more regimen of interventions (each including one or more interventions, or no intervention).</rdfs:isDefinedBy>
        <rdfs:label>Investigator assigns intervention</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Investigator_assigns_no_intervention -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Investigator_assigns_no_intervention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Investigator_assignment_role"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100009</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Investigator does not assign specific interventions</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The investigator does not actively assign study experimental units to regimens of interventions.</rdfs:isDefinedBy>
        <rdfs:label>Investigator assigns no intervention</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Irritability_test -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Irritability_test">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Physical_Readouts"/>
        <dc:title>crankiness test</dc:title>
        <Ontology1325521724189:Reference>medical-dictionary.thefreedictionary.com/irritability</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Irritability test measures the abnormal excitability or sensitivity of patients.</rdfs:isDefinedBy>
        <rdfs:label>Irritability test</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Last_updated_Date -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Last_updated_Date">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Multicentered_Trials"/>
        <Ontology1325521724189:Reference>http://www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Last Update Date</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The last updated date is the most recent date that changes to study information were submitted to ClinicalTrials.gov. There may be a delay of a few days to a few weeks before the updated study information is available on ClinicalTrials.gov.</rdfs:isDefinedBy>
        <rdfs:label>Last updated date</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Lewy_body_disease -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Lewy_body_disease">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Disease_presentation"/>
        <Ontology1325521724189:Reference>www.nlm.nih.gov/medlineplus/lewybodydisease.html</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Lewy body desiase is one of the most common causes of dementia in the elderly. Dementia is the loss of mental functions severe enough to affect normal activities and relationships.Lewy body disease happens when abnormal structures, called Lewy bodies, build in areas of the brain.</rdfs:isDefinedBy>
        <rdfs:label>Lewy body</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Magnetic_Resonance_imaging -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Magnetic_Resonance_imaging">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_imagings"/>
        <Ontology1325521724189:Reference>www.mritutor.org/mritutor/WhatisMR.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>(MRI)</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>MRI is a way of getting pictures of various parts of your body without the use of x-rays, unlike regular x-rays pictures and CAT scans</rdfs:isDefinedBy>
        <rdfs:label>Magnetic resonance imaging</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Magnetic_resonance_spectroscopy -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Magnetic_resonance_spectroscopy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Biomarkers_in_Neurology"/>
        <Ontology1325521724189:Reference>Gisele Silva, Karen Furie. &quot; Biomarkers in Neurology&quot;. Front neurol Neurosci, Basel, karger, 2009, vol 25, pp 55-61</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>MRS</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>N-acetyalaspartate to creating ratio in conversion from MCI to AD and in cognitive decline in PD.</rdfs:isDefinedBy>
        <rdfs:label>Magnetic resonance spectroscopy</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Masking -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Masking">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_design"/>
        <Ontology1325521724189:Reference>clinicaltrials.ifpma.org/clinicaltrials/en/tips/glossary/index.htm#b-link</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Masking is a orocedure in which one or more parties to the trial are kept unaware of the treatment assignment(s). Single blinding usually refers to the subject(s) being unaware , and double blinding usually refers to the subject(s), investigato(s), monitor, and, in some cases, data analyst(s) being unaware of the treatment assignment(s). In an open-label trial the identity of treatment is known to all.</rdfs:isDefinedBy>
        <rdfs:label>Masking</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Memory_and_learning -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Memory_and_learning">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Physical_Readouts"/>
        <Ontology1325521724189:Reference>Bonnie E. Levin. &quot;Behavioral/Neuropsychological Outcomes and Quality of Life Endpoints&quot;. Front Neurol Neurosci. Basel,karger, 2009, vol 25, pp 78-92</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Memory involves the ability to store, retain and retrieve information. It is not unitary skill; rather, memory is assessed on multiple levels, using a wide range of stimuli presented under different conditions. A mnemonic measure may utilize visual, auditory, tactile or other sensory stimili to assess one or more memory abilities, which are referred to in the literature as working memory, learning and learning efficiency, immefiate and delayed recall, remote memory, recognition memory, autobiographical memory and source memory.</rdfs:isDefinedBy>
        <rdfs:label>Memory</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Mini_Mental_State_Examination -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Mini_Mental_State_Examination">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_trial_methods"/>
        <Ontology1325521724189:Reference>Roberto R, Emiliano A. &quot; Cholinestinase Inhibitors in Mild Cognitive Impairement: A systemtic Review of Randomised Trials&quot;. PLoS Medical. 2007</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>MMSE</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Mini mental State Examination is a brief, uantitative measure of cognitive status in adults.</rdfs:isDefinedBy>
        <rdfs:label>Mini-mental state examination </rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Minimization -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Minimization">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Restricted_randomization"/>
        <Ontology1325521724189:Reference>bioporta.bioontology.org/ontologies/56378/?p=terms&amp;conceptid=study_design%3AOCRE100077</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Minimization is not a method of randomization. Indeed it is the only non-random method which is an acceptable alternative to randomization. Minmization ensures balance between intervention groupd for several patient factors. Randomization lists are not set up in advance. the first patient is truly randomly allocated; for each subsequent patient, the treatment allocation is identified, which minimizes the imbalance between groups at that time.</rdfs:isDefinedBy>
        <rdfs:label>Minimization</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Molecular_Readouts -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Molecular_Readouts">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_Trial_Readouts"/>
        <Ontology1325521724189:Reference>clinicaltrials.gov/ct2/show/NCT01216085</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>molecular clinical endpoint</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>molecular endpoint</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>molecular readout</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>overall outcomes measure of molecules in the body.</rdfs:isDefinedBy>
        <rdfs:label>Molecular outcome</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Mortality_rate -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Mortality_rate">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_outcome_measure"/>
        <Ontology1325521724189:Reference>www.cs.colunbia.edu/digigov/LEXING/CDCEPI/gloss.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Rate of mortality</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A measure of the freuency of occurence of death in a defined population during a specified interval of time.</rdfs:isDefinedBy>
        <rdfs:label>Mortality rate</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Multicentered_Trials -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Multicentered_Trials">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_type"/>
        <Ontology1325521724189:Reference>www.cdisc.org/stuff/contentmgr/files/0/be650811fed46f381f0af41ca40ade2e/misc/cdisc_2009_glossary.pdf</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Multicenter trial is defined as clinical trial conducted according to a single protocol but at more than one site and , therefore, carried out by more than one investigator.</rdfs:isDefinedBy>
        <rdfs:label>Multicenter trial </rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Multiple_Sclerosis -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Multiple_Sclerosis">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Disease_presentation"/>
        <Ontology1325521724189:Reference>ec.europa.eu/health/major_chronic_diseases/diseases/brain_neurological/index_en.htm</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>MS</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Multiple sclerosis is a disorder of the central nervous system (brain and spinal cord) caused by lesions in the white matter of the central nervous system that degeneate the myeli sheath , marked by lack of the muscle coordination, muscle weakness, speech problems, paresthesia and visual impairments.</rdfs:isDefinedBy>
        <rdfs:label>Multiple sclerosis</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Multiple_experimental_unit_allocation_group -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Multiple_experimental_unit_allocation_group">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Allocation_group_cardinality"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study%3AOCRE100029</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>In the context of a study where the main comparison is within experimental units, investigator assigns regimen of interventions to all allocation group made up of more than one experimental unit.</rdfs:isDefinedBy>
        <rdfs:label>Multiple experimental unit allocation group</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Multiple_regimen -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Multiple_regimen">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Regimen_cardinality"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100035</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Multiple regimens of intervention, each including one or more individual interventions (treatments) or no treatment, each assigned to one allocation group. This means the study has at least one contemporaneous comparison group.</rdfs:isDefinedBy>
        <rdfs:label>Multiple regimen</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#N_of_1_crossover_study_design -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#N_of_1_crossover_study_design">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Interventional_study_design"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%AOCRE100024</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>N-of-1 crossover study design

</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>An N-of-1 crossover study ia an interventional study where the population is a single human subject and in which at least two regimens of interventions are given alternatingly. Regimens are assigned to and data are analyzed within one participant at a time.</rdfs:isDefinedBy>
        <rdfs:label>N-of-1 crossover study</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Neuro-Psychiatric_Inventory -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Neuro-Psychiatric_Inventory">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_trial_methods"/>
        <Ontology1325521724189:Reference>Roberto R., Emiliano A., &quot; Cholinesterase Inhibitors in Mild Cognitive Impairement: A systematic Review of Randomised Trials&quot; PLoS Medicine. 2007</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>NPI</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A battery including a standardised assessment of neuropsychiatric symptoms.</rdfs:isDefinedBy>
        <rdfs:label>Neuro-psychiatric inventory</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Neuroimaging_Structural -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Neuroimaging_Structural">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Biomarkers_in_Neurology"/>
        <Ontology1325521724189:Reference>Gisele Silva, Karen Furie. &quot;Biomarkers in Neuology&quot;. Front neurol neurosci, Basel, karger, 2009, vol 25, pp 55-61</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>structural neuroimaging</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Medical temporal lobe measurement in Alzheimer&apos;s disease. Himispheric measurements in Alzheimer&apos;s disease. Ratio of the midbrain to pons areas. Rates of striatal atrophy in HD. Voxel-based morphometry for WMD measurement.</rdfs:isDefinedBy>
        <rdfs:label>Structural imaging</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Neuropsychiatric_Inventory -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Neuropsychiatric_Inventory">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Cognitive_Readouts"/>
        <Ontology1325521724189:Reference>clinicaltrials.gov/ct2/show/NCT01302340</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>NPI</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Improvement in behavior during long term treatment is measured with the NPI, which is the standard measured of Neuro Psychiatric Symptoms in most clinical trials.</rdfs:isDefinedBy>
        <rdfs:label>Neuropsychiatric inventory</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Neuropsychiatric_Test_Battery -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Neuropsychiatric_Test_Battery">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Cognitive_Readouts"/>
        <Ontology1325521724189:Reference>clinicaltrials.gov/ct2/show/NCT01265251</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>NTB</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Neuropsychological test battery is a test used as a standardised tool assessing the cognitive domains.</rdfs:isDefinedBy>
        <rdfs:label>Neuropsychiatric test battery</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Neuropsychiatric_symptoms -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Neuropsychiatric_symptoms">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Primary_endpoint_measure"/>
        <Ontology1325521724189:Reference>book.google.de/books?id=uXMMHDN1pzkC&amp;pg=definition+of+neuropsychiatric+synptoms+(NPS)&amp;source=bl&amp;ots=QOVSIP2sp-&amp;sig=9jqGhraENawpJqF5dw700upAukc&amp;hl=de&amp;sa=X&amp;ei=Q5QMT6_=CYfOswb02NyUBA&amp;ved=OCFoQ6AEwBQ#v=onepage&amp;q=definition of neuropsychiatric symptoms (NPS)&amp;f=false</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Neuropsychiatric symptoms</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Neuropsychiatric symptoms (NPS) are the manifest behavior changes resulting from brain dysfunction or pathology.</rdfs:isDefinedBy>
        <rdfs:label>Neuropsychiatric symptom</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Neuropsychological_Test_Battery -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Neuropsychological_Test_Battery">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_trial_methods"/>
        <Ontology1325521724189:Reference>www4.parinc.com/products/product.aspx?productID=NAB</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>NAB</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>Neuropsychological Assessment Battery</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Neuropsychological test battery is a comprehensive, integrated, modular battery of 33 neuropsychological tests developed to assess a wide array of neuropsychological skills and functions in adults (ages 18-97 years) who have known or suspected disorders of the central nervous system. The individual tests are grouped into six modules: Attention, Language, Memory, Spatial, Executive Functions, and screening.</rdfs:isDefinedBy>
        <rdfs:label>Neuropsychological test battery</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Non_random_allocation -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Non_random_allocation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Allocation_scheme"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100077</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Allocation, Non-random</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Non-random (or Deterministic) allocation is an allocation scheme that follows a non- random rule (e.g., sequential allocation)-</rdfs:isDefinedBy>
        <rdfs:label>Non-random allocation</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Number_of_responders -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Number_of_responders">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Secondary_endpoint_measure"/>
        <Ontology1325521724189:Reference>www.jpsmjournal.com/article/S0885-3924(06)00048-0/abstract</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Responders</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>This is the number of patients involved in a clinical studies that response to a treatment.</rdfs:isDefinedBy>
        <rdfs:label>Number of responders</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Observation -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Observation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_event"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100077</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>An observation is an activity whose intention is to obtain a result by observing, monitoring, measuring or otherwise qualitively or quantitatively gathering data or information about one or more aspects of a study subject&apos;s or experimental unit&apos;s physiologic or psychologic state.
Examples: blood chemistry panel, body mass index calculation, blood pressure measurement.</rdfs:isDefinedBy>
        <rdfs:label>Observation</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Official_title_of_trial_study -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Official_title_of_trial_study">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Informations_of_study"/>
        <Ontology1325521724189:Reference>prsinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Clinical trial title</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Official name of the protocol provided by the study principal investigator or sponsor.</rdfs:isDefinedBy>
        <rdfs:label>Official title of trial study</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Open_label -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Open_label">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Masking"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Open-label</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>No masking is used. All involved know the identity of the intervention assignment.</rdfs:isDefinedBy>
        <rdfs:label>Open label</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Outpatient -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Outpatient">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Status"/>
        <Ontology1325521724189:Reference>dictionary.reference.com/browse/outpatient</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Out-patient</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A patient who recieves treatment at a hospital, as in an emergency room or clinic, but is not hospitalized.</rdfs:isDefinedBy>
        <rdfs:label>Outpatient</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#P-Values -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#P-Values">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Statistical_significance"/>
        <Ontology1325521724189:Reference>www.disc.org/stuff/contentmgr/files/0/be650811feb46f381f0af41ca40ade2e/misc/cdisc_2009_glossary.pdf</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>p values</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Study findings can also be assessed in terms of their statistical significance. the p-values represents the probability that the observed data (or a more extreme result) could have arisen b chance when the interventions did not differ.</rdfs:isDefinedBy>
        <rdfs:label>P-value</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Parallel_Assignment -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Parallel_Assignment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Intervention_model"/>
        <Ontology1325521724189:Reference>www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Assignment, Parallel</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Describes a clinical trial in which two or more groups of participants receive different interventions. For example, a two-arm parallel design involves two groups of participants. One group receives drug A, and the other group receives drug B. So during the trial, participants in one group receive drug A &quot;in parallel&quot; to participants in the other group receiving drug B. </rdfs:isDefinedBy>
        <rdfs:label>Parallel design</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Parallel_group_study_design -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Parallel_group_study_design">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Interventional_study_design"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100027</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A parallel group study is an interventional study that compares across at least two allocation groups concurrently, each receiving a regimen of interventions (which can be &quot;no intervention&quot;).</rdfs:isDefinedBy>
        <rdfs:label>Parallel group study</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Parkinson_disease -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Parkinson_disease">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Disease_presentation"/>
        <Ontology1325521724189:Reference>www.nlm.gov/medlineplus/parkinsonsdisease.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>PD</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>Parkinson&apos;s disease</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Parkinson&apos;s disease is a disorder that affects nerve cells, or neurons, in a part of the brain that controls muscle movement. In Parkinson&apos;s neurons that make a chemical called dopamine die o do not work properly.</rdfs:isDefinedBy>
        <rdfs:label>Parkinson disease</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Pet_scan -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Pet_scan">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_imagings"/>
        <Ontology1325521724189:Reference>my.develandclinic.org/services/pet_scan/hic_pet_scan.aspx</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>PET</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>position emission tomography scan</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>PET scan is a unique type of imaging test that helps doctors see how the organs and tissues inside your body are actually functioning. </rdfs:isDefinedBy>
        <rdfs:label>Positron emission tomography</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Pharmacodynamic_study -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Pharmacodynamic_study">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Phase_I"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Pharmacodynamics</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Action of drugs in living systems</rdfs:isDefinedBy>
        <rdfs:label>Pharmacodynamic study</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Pharmacokinetic_study -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Pharmacokinetic_study">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Phase_I"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>pharmacokinetics</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The action of a drug in the body over a period of time including the process of absorption, distribution and localization in the tissue, biotransformation, and excretion of the compound.</rdfs:isDefinedBy>
        <rdfs:label>Pharmacokinetic study</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Phase_I -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Phase_I">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_phases"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Phase 1 trial</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>Phase I clinical trials</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>Phase I trial</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>phase I studies</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Includes initial studies to determine the metabolism and pharmacologic actions of drugs in humans, the side effects associated with increasing doses, and to gain early evidence of effectiveness; may include healthy participants and/ or patients.</rdfs:isDefinedBy>
        <rdfs:label>Phase I</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Phase_II -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Phase_II">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_phases"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Phase 2 trial</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>Phase II clinical trials</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>phase II trial</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Includes controlled clinical studies conducted to evaluate the effectiveness of the drug for a particular indication or indications in patients with the disease or condition under study and to determine the common short-term side effects and risks.</rdfs:isDefinedBy>
        <rdfs:label>Phase II</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Phase_III -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Phase_III">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_phases"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Phase 3 trial</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>Phase III clinical trials</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>phase III trial</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Includes expanded controlled and uncontrolled trials after preliminary evidence suggesting effectiveness of the drug has been obtained, and are intended to gather additional information to evaluate the overall benefit-risk relationship of the drug and provide an adeuate basis for physician labeling.</rdfs:isDefinedBy>
        <rdfs:label>Phase III</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Phase_O -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Phase_O">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_phases"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Phase 0 trial</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Exploratory trials,involving very limited human exposure, with no therapeutic or diagnostic intent (e.g screening studies, microdose studies).</rdfs:isDefinedBy>
        <rdfs:label>Phase 0</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Phase_VI -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Phase_VI">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_phases"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Phase 4 trial</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>Phase VI clincal trials</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>phase VI  trial</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Studies of FDA-approved drugs to delineate additional information including the drug&apos;s risks, benefits, and optimal use.</rdfs:isDefinedBy>
        <rdfs:label>Phase VI</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Phase_not_applicable -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Phase_not_applicable">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_phases"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>N/A</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>For trials without phases</rdfs:isDefinedBy>
        <rdfs:label>Phase not applicatble</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Physical_Readouts -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Physical_Readouts">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_Trial_Readouts"/>
        <Ontology1325521724189:Reference>www.bv.com.au/media/vanilla/file/Green exercise.pdf</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>physical endpoint</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>physical readout</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The overal outcome measured of the physical characteristics of an individual.</rdfs:isDefinedBy>
        <rdfs:label>Physical outcome</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Physical_examinations -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Physical_examinations">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Primary_endpoint_measure"/>
        <ont:CDISC_Code>C20989</ont:CDISC_Code>
        <Ontology1325521724189:Reference>Standard for the Exchange of Nonclinical Data (SEND), http://evs.nci.nih.gov/ftp1/CDISC/SEND/SEND%20Terminology.xls</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Medical examination</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>Physical Examination</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>check-up</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>clinical examination</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A systemic evaluation of the body and its functions using visual inspection, palpation, percussion and auscultation. The purpose is to determine the presence or absence of physical signs of disease or abnormality for an individual&apos;s health assessment.</rdfs:isDefinedBy>
        <rdfs:label>Physical exam</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Physical_symptoms -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Physical_symptoms">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Exclusion_criteria"/>
        <Ontology1325521724189:Reference>www.answers.com/topic/symptom</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>physical signs</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>symptoms that are observed and noticed by the patients.</rdfs:isDefinedBy>
        <rdfs:label>Physical symptom</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Pilot_Trials -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Pilot_Trials">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_design"/>
        <Ontology1325521724189:Reference>http:// www.cirem.org.uk/definations.html
www.biomedcentral.com/1471-2288/10/1</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>pilot study</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Pilot trial is defined as an experimental, exploratory,test,preliminary, trial or try out investigation.. It is a trial study carried out before a research design is finalised to assist in defining the research uestion or to test the feasibility,reiability and validity of the proposed study design.</rdfs:isDefinedBy>
        <rdfs:label>Pilot trial</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Placebo -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Placebo">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Control"/>
        <Ontology1325521724189:Reference>Michael Stein and Guy Taylor &quot; The Encyclopedia of Arthritis&quot; 2004</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Inactive drugs</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A placebo-controlled study is generally more efficient in finding out whether a new treatment is effective, but for ethical reasons this design is not always appropriate. Most medical ethicists agree that it is not ethical to treat a patient in a clinical trial with placebo if an effective treatment is available for that particular condition and if treatment with placebo could result in irreversible, preventable problems for a patient.</rdfs:isDefinedBy>
        <rdfs:label>Placebo</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Placebo_comparator -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Placebo_comparator">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Comparator"/>
        <Ontology1325521724189:Reference>www.cancer.gov/clinicaltrials/conducting/ncictrp/resources/glossary</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>PLACEBO COMPARATORS</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>An arm or group in which ONLY a placebo is given.</rdfs:isDefinedBy>
        <rdfs:label>Placebo comparator</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Plasma -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Plasma">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Body_Fluids"/>
        <Ontology1325521724189:Reference>www.wisegeek.com/what-is-blood-plasma.htm</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>blood plasma</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Blood plasma is a liquid component of blood, consisting of around half of the total blood volume. Plasma itself is around 90% water, with the 10% remainder including proteins, minerals, waste products, clotting factors, hormones, and immunoglobins.</rdfs:isDefinedBy>
        <rdfs:label>Plasma</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Plasma_concentration -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Plasma_concentration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Primary_endpoint_measure"/>
        <Ontology1325521724189:Reference>wiki-answers.com/QMax_plasma_concentration_definition</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Plasma concentration is how much of a drug is in your blood.</rdfs:isDefinedBy>
        <rdfs:label>Plasma concentration</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Plasma_markers -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Plasma_markers">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Biological_Readouts"/>
        <Ontology1325521724189:Reference>www.hindawi.com/journals/jbb/2010/927917/</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>plasma biomarkers</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>These are biomarkers in blood plasma</rdfs:isDefinedBy>
        <rdfs:label>Plasma marker</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Pregnancy -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Pregnancy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Exclusion_criteria"/>
        <Ontology1325521724189:Reference>www.healia.com/healthguides/pregnancy/what-is-pregnancy</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>pregnant</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Pregnancy is the state of carrying a growing embryo or fetus in the uterus.In mammals, pregnancy is defined as the period between implantation of a fertilized egg in wall of the uterus and delivery or other termination.</rdfs:isDefinedBy>
        <rdfs:label>Pregnancy</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Prevention -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Prevention">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Primary_purpose"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Protocol designed to assess one or more interventions aimed at preventing the development of a specific disease or health condition.</rdfs:isDefinedBy>
        <rdfs:label>Prevention</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Primary_completion_Date -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Primary_completion_Date">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Multicentered_Trials"/>
        <Ontology1325521724189:Reference>www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Completion Date</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The date that the last participant in a clinical study was examined or received an intervention and that data for the primary outcome measure were collected. Whether the clinical study ended according to the protocol or was terminated does not affect this date. The &quot;estimated primary completion date&quot; is the date that the researchers think will be the primary completion date for the study.</rdfs:isDefinedBy>
        <rdfs:label>Primary completion date</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Primary_endpoint_measure -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Primary_endpoint_measure">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_outcome_measure"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>primary outcome measure</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Specific key measurememt (s) or observation(s) used to measure the effect of experimental variables in a study, or for observational studies, to describe patterns of diseases or traits orassociations with exposures, risk factors or reatment.</rdfs:isDefinedBy>
        <rdfs:label>Primary endpoint measure</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Primary_purpose -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Primary_purpose">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_design"/>
        <Ontology1325521724189:Reference>www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>The one main reason for the clinical trial.</rdfs:isDefinedBy>
        <rdfs:label>Primary purpose</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Prion_diseases -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Prion_diseases">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Disease_presentation"/>
        <Ontology1325521724189:Reference>www.cdc.gov/ncidod/dvrd/prions/</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>transmissible spongiform encephalopathies (TSEs)</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Prion diseases are a family of rare progressive neurodegenerative disorders that affect both humans and animals. They are distinguished by long incubation periods, characteristic spongiform changes associated with neuronal loss, and a failure to include inflammatory response.</rdfs:isDefinedBy>
        <rdfs:label>Prion disease</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Protocol_Representation_Sub-Domain -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Protocol_Representation_Sub-Domain">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_Conduct_Sub-Domain"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/45400/?p=terms&amp;conceptid=protocol_Representation_sub-domain</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>protocol development</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The protocol Representation sub-domain is intended for those involved in the planning and design of a research protocol. the majority of bussiness requirements have come from those involved in clinical trial protocols. It focuses on the characteristics of a study and the definition and association of activities within the protocols, including &quot;arms&quot; and &quot;epochs&quot;. It also includes the definitions of the roles that participate in those activities.</rdfs:isDefinedBy>
        <rdfs:label>Protocol representation</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Psychiatric_symptoms -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Psychiatric_symptoms">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Exclusion_criteria"/>
        <Ontology1325521724189:Reference>www.merriam-webster.com/dictionary/psychiatry</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>symptoms of mental health disorders

Psychiatric disorders</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Psychiatric symptoms are symptoms such as mental , emotional, or behavioral disorders that occurs in a patient.</rdfs:isDefinedBy>
        <rdfs:label>Psychiatric symptom</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Qualitative_study_design -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Qualitative_study_design">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Descriptive_study"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/45378/?p=terms&amp;concetid=study_design%3AOCRE100072</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Designing the Qualitative Study</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>Qualitative design</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>Qualitative research design</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A qualitative study is an individual-human study whose primary mode of inquiry is qualitative.</rdfs:isDefinedBy>
        <rdfs:label>Qualitative study</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Quality_of_life -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Quality_of_life">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Secondary_endpoint_measure"/>
        <Ontology1325521724189:Reference>www.medicine.ox.ac.uk/bandolier/painres/download/whatis/WhatisQOL.pdf</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>&quot;QoL&quot;</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Quality of life is a ubiquitous concept that has different philophical, polotical and health-related definitions.</rdfs:isDefinedBy>
        <rdfs:label>Quality of life</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Quantitative_study_design -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Quantitative_study_design">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Analytical_study"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?=terms&amp;conceptid=study_design%3AOCRE100044</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Quantitative design



</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A quantitative study is an individual-human study whose primary mode of inquiry is quantitative.</rdfs:isDefinedBy>
        <rdfs:label>Quantitative study</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Quasi_random_allocation -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Quasi_random_allocation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Allocation_scheme"/>
        <Ontology1325521724189:Reference>www.sahealthinfo.org/evidence/q-rhtm#quasi-allocation</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Allocation, Quasi-random</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A method of allocating particpants to different forms of care that is not truly random; for example, allocation by date of birth, day of the week, medical record number, month of the year, or the order in which participants are included in the study (e.g. alternation).</rdfs:isDefinedBy>
        <rdfs:label>Quasi-random allocation</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Radiography -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Radiography">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_imagings"/>
        <Ontology1325521724189:Reference>www.etsu.edu/crhs/alliedhealth/radiography/whatis.aspx</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Radiography is the art science of using radiation to provide images of the tissues, organs, bones, and vessels that comprise the human body. These images may be recorded on film or as a computerized image.</rdfs:isDefinedBy>
        <rdfs:label>Radiography</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Random_allocation -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Random_allocation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Allocation_scheme"/>
        <Ontology1325521724189:Reference>www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Allocation, Random</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>Randomized allocation</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A strategy in which participants are assigned to arms of a clinical trial by chance.</rdfs:isDefinedBy>
        <rdfs:label>Random allocation</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Randomized_to_active_treatment -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Randomized_to_active_treatment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Experimental"/>
        <Ontology1325521724189:Reference>www.cancer.gov/clinicaltrials/conducting/ncictrp/resources/glossary</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>An arm or group in which active drugs are given. This will include arms that are mixing active drugs and placebos. This will be used when the term &quot;control arm&quot; is specified in the protocol and when another arm is designated as the experimental arm. There can be more than one active comparator arm.</rdfs:isDefinedBy>
        <rdfs:label>Randomized to active treatment</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Rate_of_institutionalization -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Rate_of_institutionalization">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_outcome_measure"/>
        <Ontology1325521724189:Reference>glossary.adoption.com/institutionalization.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Institutionalization Rate</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>Rates of institutionalization</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The measure of the short-term or long-term placment of children in institutions, such as hospitals, group homes. Placement in institutions during early critical development periods, and for lengthy periods of time, is often associated with developmental delays due to enviromental deprivation, poor staff to child ratios, or lack of early childhood stimulation.</rdfs:isDefinedBy>
        <rdfs:label>Rate of institutionalization</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Recruitment_active -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Recruitment_active">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Closed_study"/>
        <Ontology1325521724189:Reference>clinicaltrials.gov/ct2/info/glossary#recruitment</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Active recruitment</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Study is ongoing (i.e.., patients are being treated or examined), but enrolled as completed.</rdfs:isDefinedBy>
        <rdfs:label>Active, not recruiting</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Recruitment_criteria -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Recruitment_criteria">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Recruitment_of_patients"/>
        <Ontology1325521724189:Reference>www.cdisc.org/stuff/contentmgr/files/0/be650811fed46f381f0</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>selection criteria</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Criteria used by sposors to identify,select, and arrange for investigators to serve in a clinical study.</rdfs:isDefinedBy>
        <rdfs:label>Recruitment criteria</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Recruitment_status -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Recruitment_status">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Recruitment_of_patients"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Recruitment</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Overall accrual activity for the protocol or study.</rdfs:isDefinedBy>
        <rdfs:label>Recruitment status</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Regimen_cardinality -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Regimen_cardinality">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Assignment_characteristics"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100042</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>The number of regimens of interventions in a study. Each regimen includes one or more individual interventions (treatments) or no intervention.</rdfs:isDefinedBy>
        <rdfs:label>Regimen cardinality</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Regulatory_Application -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Regulatory_Application">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Regulatory_Sub-Domain"/>
        <Ontology1325521724189:Reference>stephan. A. Raymond. &quot;CDISC Clinical Research Glossary&quot;. 2009</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Application made to a health authority to investigate, market, or licence a new product or indication.</rdfs:isDefinedBy>
        <rdfs:label>Regulatory application</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Regulatory_Application_Sponsor -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Regulatory_Application_Sponsor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Regulatory_Sub-Domain"/>
        <Ontology1325521724189:Synonyms></Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The sponsor of the applcation made to a health authority to investigate, market, or licence a new product or indication.</rdfs:isDefinedBy>
        <rdfs:label>Regulatory application sponsor</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Regulatory_Assessment -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Regulatory_Assessment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Regulatory_Sub-Domain"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/45400/?p=terms&amp;conceptid=Regulatory_Assessment</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>RegulatoryAssessment</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A regulatory action or inaction undertaken by the regulatory authority as a result of a submission analysis and evaluation.</rdfs:isDefinedBy>
        <rdfs:label>Regulatory assessment</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Regulatory_Sub-Domain -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Regulatory_Sub-Domain">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_Conduct_Sub-Domain"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/45400/?p=terms&amp;conceptid=Regulatory_sub-Domain</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>The regulatory sub-domain is intended for those involved in the creation and review of submissions to regulatory authorities. The majority of bussiness requirements come from the regulatd product submission (RPS) message specification. It focuses on the documentation required for a product submission to the Food and Drug Administration (FDA).</rdfs:isDefinedBy>
        <rdfs:label>Regulatory aspect</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Regulatory_Submission -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Regulatory_Submission">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Regulatory_Sub-Domain"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/45400/?p=terms&amp;conceptid=Regulatory_Submission</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>RegulatorySubmission</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>An assembly of one or more regulatory submission units supporting a specific regulatory purpose or decision. In most cases, the compilation of the submission units is utilized in the assessment of a regulated medical product quality, safety and /or effectiveness.</rdfs:isDefinedBy>
        <rdfs:label>Regulatory submission</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Renal -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Renal">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Physical_symptoms"/>
        <Ontology1325521724189:Reference>dictionary.reference.com/browse/renal</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>renal</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Relating to, involving, affecting, or located in the region of the kidneys.</rdfs:isDefinedBy>
        <rdfs:label>Renal symptom</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Resting_state_functional_network_activity -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Resting_state_functional_network_activity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Neuropsychiatric_symptoms"/>
        <Ontology1325521724189:Reference>clinicaltrials.gov/show/NCT00988117?displayxml=true</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>&quot;resting-state&quot; functional networks</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>resting state activity</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>resting state network activity</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>resting-state networks</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Degree of fit in the dorsolateral frontal-parietal network.</rdfs:isDefinedBy>
        <rdfs:label>Resting state functional network activity</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Restricted_randomization -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Restricted_randomization">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Random_allocation"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100077</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Randomization

Restricted</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Restricted randomization is a random allocation scheme used to control the randomization to achieve balance between groups in size (or other characteristics).</rdfs:isDefinedBy>
        <rdfs:label>Restricted randomization</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Reviewable_Unit -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Reviewable_Unit">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Submission_Unit"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/45400/?p=terms&amp;conceptid=Reviewable_Unit</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>ReviewableUnit</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A predefined portion of an application that, by agreement between the application and the review division, can be submitted prior to submission of a complete application.</rdfs:isDefinedBy>
        <rdfs:label>Reviewable unit</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Safety_of_the_treatment -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Safety_of_the_treatment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Primary_endpoint_measure"/>
        <Ontology1325521724189:Reference>www.tpna.com/research_development/pdf/ClinicalTrialsGlossary.pdf</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>safety treatment</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>This is the process in which the safety of the treatment in the patient population is being evaluated in a clinical trial study.</rdfs:isDefinedBy>
        <rdfs:label>Safety of the treatment</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Safety_study -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Safety_study">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Phase_I"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Safety study is a study that show if the drug is safe under conditions of proposed use.</rdfs:isDefinedBy>
        <rdfs:label>Safety study</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Scale_for_Depression -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Scale_for_Depression">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Secondary_endpoint_measure"/>
        <Ontology1325521724189:Reference>en.wikipedia.org/wiki/Rating_scales_for_depression</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Depression rating scale</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A depression rating scale is a psychiatric measuring intrument having descriptive words and phrases that indicate the severity of depression symptoms for a time period.</rdfs:isDefinedBy>
        <rdfs:label>Scale for depression</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Screening -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Screening">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Primary_purpose"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Protocol designed to assess or examine methods of identifying a condition (or risk factors for a condition) in people who are yet known to have the condition (or risk factor).</rdfs:isDefinedBy>
        <rdfs:label>Screening</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Secondary_endpoint_measure -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Secondary_endpoint_measure">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_outcome_measure"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>secondary outcome measure</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Other key measures that will be used to evaluate the intervention(s) or, for observational studies, that are a focus of the study. 
</rdfs:isDefinedBy>
        <rdfs:label>Secondary endpoint measure</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Seizures -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Seizures">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Psychiatric_symptoms"/>
        <Ontology1325521724189:Reference>www.nlm.nih.gov/medlineplus/seizures.html</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Seizures are symptoms of a brain problem. They happen because of sudden, abnormal electrical activity in the brain. when people think of seizures, they often think of convulsions in which a person&apos;s body shakes repidly and uncontrollably.</rdfs:isDefinedBy>
        <rdfs:label>Seizure</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Sever_Impairment_Battery -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Sever_Impairment_Battery">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_trial_methods"/>
        <Ontology1325521724189:Reference>www.testzentrale.ch/de/tests/tests-a-z/alphabet/S/flexShow/testDetail/testUid/878/</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>SIB</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The Severe Impairement Battery (SIB) has been developed to assess a range of cognitive functioning in individuals who are too impaired to complete standard neuropsychological tests. It was designed with the severely demented patient in mind and takes into account the specific behavioural and cognitive deficits associated with severe dementia.</rdfs:isDefinedBy>
        <rdfs:label>Severe impairment battery</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Simple_randomization -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Simple_randomization">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Random_allocation"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100077</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Randomization</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Simple randomization is a random allocation scheme that has no restriction, i.e. a single sequence of random assignment. When the sample size is relatively large, simple randomization is produre equal sized treatment groups.</rdfs:isDefinedBy>
        <rdfs:label>Simple randomization</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Single_Group_Assignment -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Single_Group_Assignment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Intervention_model"/>
        <Ontology1325521724189:Reference>http://www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Single arm study</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Describes a clinical trial in which all participants receive the same intervention.</rdfs:isDefinedBy>
        <rdfs:label>Single-group design</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Single_blind -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Single_blind">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Blindness"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>single-masked study</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>One party, either the investigator or participant, is unaware of the intervention assignment.</rdfs:isDefinedBy>
        <rdfs:label>Single blind</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Single_experimental_unit_allocation_group -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Single_experimental_unit_allocation_group">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Allocation_group_cardinality"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100075</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>experimental units</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>In the context of a study where the main comparison is within experimental units, investigator assigns regimen of interventions to all allocation group made up of a single experimental unit.</rdfs:isDefinedBy>
        <rdfs:label>Single experimental unit allocation group</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Single_group_study_design -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Single_group_study_design">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Interventional_study_design"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100052</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Single group design

</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A single group study is an interventional study that has only a single allocation group and no contemporaneous comparison group.
A study in which an individual acts has his/her own comparison does not fall into this category, since an individual is not a group.</rdfs:isDefinedBy>
        <rdfs:label>Single group study</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Single_regimen -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Single_regimen">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Regimen_cardinality"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100037</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Regimen, Single

</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A single regimen of intervention, which includes one or more individual interventions (treatments), is assigned to one allocation group. This means the study has no contemporaneous comparison group.</rdfs:isDefinedBy>
        <rdfs:label>Single regimen</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Sleep_disturbance_test -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Sleep_disturbance_test">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Physical_Readouts"/>
        <Ontology1325521724189:Reference>medical-dictionary.thefreedictionary.com/Sleep+disturbance</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>sleep disorders

sleeping problems</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Sleep disturbance test, tests the disorder of sleep patterns which may be severe enough to interfere with a person&apos;s normal physical, mental and emtional functioning.</rdfs:isDefinedBy>
        <rdfs:label>Sleep disturbance</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Spinal_muscular_atrophy -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Spinal_muscular_atrophy">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Disease_presentation"/>
        <Ontology1325521724189:Reference>www.nlm.nih.gov/medlineplus/spinalmusculatrophy.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>SMA</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Spinal muscular atrophy is a genetic disease that attacks nerve cells, called motor neurons, in your spinal cord. These neurons communicate with your voluntary muscles- the ones you can control, like in your arms and legs. As you lose the neurons, your muscles weaken. This can affect walking, craling, breathing, swallowing and head and neck control.</rdfs:isDefinedBy>
        <rdfs:label>Spinal muscular atrophy</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Sponsoring -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Sponsoring">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_administrative_relation"/>
        <Ontology1325521724189:Reference>www.ata-divisions.org/GLD/docs/48_konferenz/Glossary_clinical_trials_EN-GE.pdf</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Sponsor</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>An individual, company, institution or organization talking responsibility for initiation, management, and financing of a clinical study.</rdfs:isDefinedBy>
        <rdfs:label>Sponsoring</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Standard_Deviation -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Standard_Deviation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Statistical_significance"/>
        <Ontology1325521724189:Reference>www.cochrane.org/glossary</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A measurement of the spread or dispersion of a set of observations, calculated as the average difference from the mean value in the sample.</rdfs:isDefinedBy>
        <rdfs:label>Standard deviation</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Start_Date -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Start_Date">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Multicentered_Trials"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Starting date</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Date that enrollment to the ptotocol begins</rdfs:isDefinedBy>
        <rdfs:label>Start date</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Statistical_significance -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Statistical_significance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_Trial_measurement_Units"/>
        <Ontology1325521724189:Reference>www.cdisc.org/stuff/contentmgr/files/0/be65811feb46f381foaf41ca40caade2e/misc/cdisc_2009_glossary.pdf</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>State that aoolies when a hypothesis ie rejected. Whether or not a given result is significant depends on the significance level adoped. 

It is the propability that an event or difference occurred by chance alone. In clinical trials, the level of statistical significance on the number of participants studied and the observations made, as well as the magnitude of differences observed.</rdfs:isDefinedBy>
        <rdfs:label>Statistical significance</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Status -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Status">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Inclusion_criteria"/>
        <Ontology1325521724189:Reference>www.reference.com/browse/status</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms></Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The position of an individual in relation to another or others.</rdfs:isDefinedBy>
        <rdfs:label>Status</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Stratified_randomization -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Stratified_randomization">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Restricted_randomization"/>
        <Ontology1325521724189:Reference>bioportal.bioontologies.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100077</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Randomization

Stratified</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Stratification ensures that the numbers of participants recieving each intervention are closely balanced within each stratum. Stratified randmization is achieved by performing a separate randomization procedure within each of two or more subsets of participants.</rdfs:isDefinedBy>
        <rdfs:label>Stratified randomization</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Stratum_Group -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Stratum_Group">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Protocol_Representation_Sub-Domain"/>
        <Ontology1325521724189:Reference></Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>This is the process in which the research representation protocols are grouped into layers.</rdfs:isDefinedBy>
        <rdfs:label>Stratum group</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Stroke -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Stroke">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Disease_presentation"/>
        <Ontology1325521724189:Reference>www.medicinet.com/stroke/article.htm#tocas</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Brain cell function requires a constant delivery of oxygen and glucose from the bloodstream. A stroke, or cerebrovascular accident, occurs when blood supply to part of the brain is disrupts.</rdfs:isDefinedBy>
        <rdfs:label>Stroke</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_Conduct_Sub-Domain -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_Conduct_Sub-Domain">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/45400/?p=terms&amp;conceptid=Study_Conduct_Sub-Domain</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Study Conduct</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The study Conducted sub-domain is intended for those involved in the execution of a research study. the majority of bussiness requirements have come form those involved in clinical trials. It focuses on the activities of conducting the study as well as the results from those activites.</rdfs:isDefinedBy>
        <rdfs:label>Conduct of the study</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_Investigator -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_Investigator">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Protocol_Representation_Sub-Domain"/>
        <Ontology1325521724189:Reference>www.wisegeek.com/what-does-a-clinical-trial-investigator-do.htm</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>clinical trial investigator

Investigator</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Study investigator is a physician in private  practice who participates in clinical trial studies.</rdfs:isDefinedBy>
        <rdfs:label>Study investigator</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_Legal_Sponsor -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_Legal_Sponsor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_Objective"/>
        <Ontology1325521724189:Reference>www.lifesciencelegalupdate.com/2011/07/articles/product-liability/the-legal-duties-of-clinical-trial-sponsors/</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>The Legal Studies of Clinical Trial Sponsors</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Study legal sponsor are individuals that addresses the risks involved in human clinical trials and the responsibilities between the clinical study investigator and the manufacturer/sponsor.</rdfs:isDefinedBy>
        <rdfs:label>Study legal sponsor</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_Objective -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_Objective">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Protocol_Representation_Sub-Domain"/>
        <Ontology1325521724189:Reference>www.sil.org/lingualinks/literacy/referencematerials/glossaryofliteracyterms/whatisobjective.htm</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>clinical trial objective

Objective of study</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A study objective is a subgoal that identifies a short-term, measurable step within a designated period of time that is moving toward achieving a long-term goal.</rdfs:isDefinedBy>
        <rdfs:label>Study objective</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_Protocol_Document -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_Protocol_Document">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Protocol_Representation_Sub-Domain"/>
        <Ontology1325521724189:Reference>https://crawb.crab.org/txwb/CRA_MANUAL/vol1/chapter 14_Study protocol.pdf</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>StudyProtocolDocument</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The study protocol is a written document detailing how a clinical trial is conducted. The elements of a protocol include:

- Trial design and organization;
- Study objectives;
- Background information;
- Patient population descriptions; and -
- Treatment to be studied.</rdfs:isDefinedBy>
        <rdfs:label>Study protocol document</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_Resource -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_Resource">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_contact"/>
        <Ontology1325521724189:Reference>www.roswellpark.edu/prevention/cancer-health-disparities/services-reach/research-study-resource</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Resource</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The research study resource offers services to those who are considering being a part of a research study. It also serves to remove barriers and obstacles that may make it difficult for you to participate in a research study.</rdfs:isDefinedBy>
        <rdfs:label>Study resource</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_Site -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_Site">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_Conduct_Sub-Domain"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/45400?p=terms&amp;conceptid=Study_Site</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Investigative Site</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A facility in which study/protocol activities are conducted.</rdfs:isDefinedBy>
        <rdfs:label>Study site</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_administrative_relation -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_administrative_relation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Events"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=study_design%3AOCRE100077</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Administrative Relations</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Study administrative relation is a kind of relationship that an entity enters into in the design, conduct, and analysis of a study. The relationship starts when the organization agrees to undertake the activity entailed by the relationship. &quot;Agreement to perform study activity&quot; doesn,t mean performance of a specific study activity (e.g., administration of a drug) itself, but agreement to do so. an organization becomes a &quot;participating site&quot; once it agrees to perform activities specified in the study protocol. It doesn,t have to perform any of activities yet.</rdfs:isDefinedBy>
        <rdfs:label>Study administrative relation</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_arms -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_arms">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Structure_of_clinical_trial"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=obi%3AOBI_000842</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>study group</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A process in ehich the subject is made aware of which study arm they are participating in, for example whether they are recieving a placebo or a treatment with an investigational compound.</rdfs:isDefinedBy>
        <rdfs:label>Study arm</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_characteristics -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_characteristics">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Structure_of_clinical_trial"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/46378/?p=terms&amp;conceptid=OCRe%3AOCRE400047</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>characteristics of a study</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A meta-level characterization of a study.</rdfs:isDefinedBy>
        <rdfs:label>Study characteristics</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_contact -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_contact">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Protocol_Representation_Sub-Domain"/>
        <Ontology1325521724189:Reference>www.bussinessdictionary.com/definition/contact.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Contact</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>An individual private or personal information by which another person, or a study participant can be use to reach the individual.</rdfs:isDefinedBy>
        <rdfs:label>Study contact</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_design -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_design">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial_design"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ontologies/1123/?p=terms&amp;conceptid=obo:OBI_0500000</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Experimental design</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A study design is a plan specification comprised of protocols (which may specify how and what kinds of data will be gathered) that are executed as part of an investigation and is realized during a study design execution.</rdfs:isDefinedBy>
        <rdfs:label>Basic study design</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_phases -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_phases">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Clinical_trial"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Phases</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>clinical trial phases</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Phase of investigation, for trials involving investigational new drugs.</rdfs:isDefinedBy>
        <rdfs:label>Phases of clinical trial</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Submission_Unit -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Submission_Unit">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Regulatory_Sub-Domain"/>
        <Ontology1325521724189:Reference>bioportal.bioontology.org/ajax_concepts/45400/?conceptid=Submission_Unit&amp;callback=children&amp;child_size=1</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>SubmissionUnit,

Regulatory Submission Unit</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A colection of documents pertaining to a particular clinical study protocol and /or medical product accompanied by the associated reference information officially provided to the regulatory authority. This is usually done to comply with a specific regulatory purpose or decision.</rdfs:isDefinedBy>
        <rdfs:label>Submission unit</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Supportive_Care -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Supportive_Care">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Primary_purpose"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Supportive Care Study

Supportive Care Trial</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Protocol designed to evaluate one or more interventions where the primary intent ia a maximize comfort, minimize side effects or mitigate against a decline in the subject&apos;s health or function. In general, supportive care interventions are not intended to cure a disease.</rdfs:isDefinedBy>
        <rdfs:label>Supportive care</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Suspended_study -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Suspended_study">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Closed_study"/>
        <Ontology1325521724189:Reference>prinfor.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Study suspended

Suspended,Study

Suspension of studies

Suspension of study

Recruitment suspended</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Recruiting or enrolling participants has halted prematurely but potentially will resume.</rdfs:isDefinedBy>
        <rdfs:label>Suspended</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Symptomatic_postural_hypotension -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Symptomatic_postural_hypotension">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Exclusion_criteria"/>
        <Ontology1325521724189:Reference>www.answers.com/topc/orthostatic-hypotension-1</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>postural hypotension

Orthostatic hypotension</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A fall in blood pressure that occurs on standing up after lying down.</rdfs:isDefinedBy>
        <rdfs:label>Symptomatic postural hypotension</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Syncope -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Syncope">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Symptomatic_postural_hypotension"/>
        <Ontology1325521724189:Reference>medical-dictionary.thefreedictionary.com/syncope</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>collapse

coma

faint

unconsciousness</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Syncope is define as a brief loss of consciousness caused by a sudden fall of blood pressure or failure of the cardiac systole, resulting in cerebral anemia.</rdfs:isDefinedBy>
        <rdfs:label>Syncope</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Terminated_study -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Terminated_study">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Closed_study"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Study terminated

Terminated,Study

Termination of studies

Termination of study

Recruitment terminated</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Recruiting or enrolling participants has halted prematurely and will not resume; participants are no longer being examined or treated.</rdfs:isDefinedBy>
        <rdfs:label>Terminated</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#The_Randomized_Blinded_Trial -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#The_Randomized_Blinded_Trial">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Randomized_control_trial"/>
        <Ontology1325521724189:Reference>clinicaltrials.org/ct2/info/glossary</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>A randomized trial is the study in which participants are randomly assigned to one of two or more treatment arms of aclinical trial. A randomized trial is blind if the participant is not told of the trial he is on. A clinical trial is blind if the participants  are unaware on whether they are in the experimental or control arm of the study.</rdfs:isDefinedBy>
        <rdfs:label>Randomized blinded trial</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Timing_of_outcome_measurement -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Timing_of_outcome_measurement">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Study_characteristics"/>
        <Ontology1325521724189:Reference>www.clinicaltrials.gov/ct2/about-studies/glossary</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Timing of Outcome Assessments</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The points in time at which the outcome measure is assessed. These are planned before the clinical study starts and listed in the protocol. </rdfs:isDefinedBy>
        <rdfs:label>Time frame for outcome measurement</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Toxicological_tests -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Toxicological_tests">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Secondary_endpoint_measure"/>
        <Ontology1325521724189:Reference>firstaid.webmd.com/toxicology-tests</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>toxicity testing</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>toxicological testing</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>toxicology tests</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Toxicology test checks blood or urine for the presence of drugs or chemicals. In rare cases, stomach contents, sweat, or saliva may also be checked.</rdfs:isDefinedBy>
        <rdfs:label>Toxicological test</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Treatment -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Treatment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Primary_purpose"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Therapy</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Protocol designed to evaluate one or more interventions for treating a disease, syndrome or condition.</rdfs:isDefinedBy>
        <rdfs:label>Treatment</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Ultrasound -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Ultrasound">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_imagings"/>
        <rdfs:isDefinedBy>Ultrasound is acoustic (sound) energy in the form of waves having a frequency above the human hearing range. The highest frequency that the human ear can detect is approximately 20 thousand cycles per second (20,000Hz).</rdfs:isDefinedBy>
        <rdfs:label>Ultrasound</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Uncontrolled -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Uncontrolled">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Control"/>
        <Ontology1325521724189:Reference>Michael Stein and Guy Taylor. &quot; The Encyclopedia of Arthritis&quot;. 2004</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Uncontrolled Group</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>If a new treatment is studied alone, with no comparison group, it is called an uncontrolled study. Uncontrolled studies, although they can provide useful preliminary information, are not strong evidence in favour of a new treatment,even if the results of the trial are positive.</rdfs:isDefinedBy>
        <rdfs:label>Uncontrolled</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Urine -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Urine">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Biological_Laboratory_variables"/>
        <Ontology1325521724189:Reference>www.thefreedictionary.com/urine</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>The pale yellow slightly acid fluid excreted by the kidneys, containing waste products removed from the blood. It is store in the urinary bladder and discharged through the urethra.</rdfs:isDefinedBy>
        <rdfs:label>Urine</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Video_movement_analysis -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Video_movement_analysis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Secondary_endpoint_measure"/>
        <Ontology1325521724189:Reference>en.wikipedia.org/wiki/video_motion_analysis</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>video motion analysis</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>This is a technique used to get information about moving objects from video.</rdfs:isDefinedBy>
        <rdfs:label>Video movement analysis</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Vital_signs -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Vital_signs">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Primary_endpoint_measure"/>
        <Ontology1325521724189:Reference>medicalcenter.osu.edu/patientcare/healthcare_services/emergency_services/non_traumatic_emergencies/vital_signs/pages/index.aspx</Ontology1325521724189:Reference>
        <rdfs:isDefinedBy>Vital signs are measurements in the body&apos;s most basic functions. the fourmain main vital signs routinely monitored by medical professionals and healthcare providers include the following:
- Body temperature
- Pulse rate
- respiration rate (rate of breathing)
- blood pressure (blood pressure is not considered a vital sign, but is often measured along with the vital signs.)</rdfs:isDefinedBy>
        <rdfs:label>Vital sign</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Walk_test -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Walk_test">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Physical_Readouts"/>
        <Ontology1325521724189:Reference>medical-dictionary.thefreedictionary.com/walk</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>walking test
</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>This is  test that pay attention to the characteristic ways in one walks.</rdfs:isDefinedBy>
        <rdfs:label>Walk test</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Withdrawn_study -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Withdrawn_study">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Closed_study"/>
        <Ontology1325521724189:Reference>prinfo.clinicaltrials.gov/definitions.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Withdrawal of study

Withdrawing from study

Study withdrawal</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Study halted prematurely, prior to enrollment of first participant.</rdfs:isDefinedBy>
        <rdfs:label>Withdrawn</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#_Pittsburgh_Agitation_Scale -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#_Pittsburgh_Agitation_Scale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Clinical_trial_methods"/>
        <Ontology1325521724189:Reference>&quot;Pittsburgh Agitation Scale (PAS)&quot;. UnitedHealthcare. Healinghealthcare Together</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>PAS</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>The PAS is used to assess agitation in people with dementia. There are four behavior areas measured on an intensity level of 0-4. The scale is administered by clinical staff who directly observe the patient&apos;s behavior.</rdfs:isDefinedBy>
        <rdfs:label>Pittsburgh agitation scale</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#ml -->

