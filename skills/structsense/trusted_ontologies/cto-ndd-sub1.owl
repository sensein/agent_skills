    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Alzheimer&apos;s_disease -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Alzheimer&apos;s_disease">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Disease_presentation"/>
        <Ontology1325521724189:Reference>alzheimers.org.uk/site/scripts/documents_info.php?documentID=100</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>AD</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>Alzheimer&apos;s disease</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Alzheimer&apos;s disease is a physical disease affecting the brain. During the course of the disease, protein plagues and tangles develop in the steucture of the brain, leading to the death of brain cells. Alzheimer&apos;s is a progressive disease, which means that gradually, over time, more parts of the brain are damaged. As this happens, the symptoms become more severe.</rdfs:isDefinedBy>
        <rdfs:label>Alzheimer disease</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Friedreich&apos;s_ataxia -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Friedreich&apos;s_ataxia">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Disease_presentation"/>
        <Ontology1325521724189:Reference>www.nlm.nih.gov/medilineplus/friedreichsataxia.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Friedrich&apos;s ataxia</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Friedreich&apos;s ataxia is an inherited disease that damages your nervous system. The damage affects your spinal cord and the nerves that control muscle movement in your arms and legs. Symptoms usually begin between the ages of 5 and 15.</rdfs:isDefinedBy>
        <rdfs:label>Friedrich ataxia</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Huntington&apos;s_disease -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#Huntington&apos;s_disease">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Disease_presentation"/>
        <Ontology1325521724189:Reference>www.nlm.gov/medlineplus/huntingtonsdisease.html</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>HD</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>Huntington&apos;s disease</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>Huntington&apos;s disease is an inherited disease that causes certain nerve cells in the brain to waste away. Prople are born with the defective gene, but symptoms usually don,t appear until middle age.</rdfs:isDefinedBy>
        <rdfs:label>Huntington disease</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#mg/dl -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#mg/dl">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#PK_parameter_units_of_measure"/>
        <ont:CDISC_Code>C42576</ont:CDISC_Code>
        <Ontology1325521724189:Reference>Standard for the Exchange of Nonclinical Data (SEND), http://evs.nci.nih.gov/ftp1/CDISC/SEND/SEND%20Terminology.xls</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>Milligram per Milliliter</Ontology1325521724189:Synonyms>
        <Ontology1325521724189:Synonyms>milligram per decillitre</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A unit of mass concentration defined as the concentration of one kilogram of a substance per unit volume of the mixture equal to one cubic meter, or the concentration of one milligram of a substance per unit volume of the mixture equal to one milliliter, or one gram of a substance per one liter of the mixture. It is also a unit of mass density (volumic mass) defined as the density of substance which mass equal to one milligram occupies the volume one milliliter.(NCI)</rdfs:isDefinedBy>
        <rdfs:label>mg/mL</rdfs:label>
    </Class>
    


    <!-- http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#ng/l -->

    <Class rdf:about="http://www.semanticweb.org/ontologies/2012/0/Ontology1325521724189.owl#ng/l">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#PK_parameter_units_of_measure"/>
        <ont:CDISC_Code>C67306</ont:CDISC_Code>
        <Ontology1325521724189:Reference>Standard for the Exchange of Nonclinical Data (SEND), http://evs.nci.nih.gov/ftp1/CDISC/SEND/SEND%20Terminology.xls</Ontology1325521724189:Reference>
        <Ontology1325521724189:Synonyms>nanogram per litre</Ontology1325521724189:Synonyms>
        <rdfs:isDefinedBy>A unit of mass concentration defined as the concentration of one microgram of a substance per unit volume of the mixture equal to one liter. The concept also refers to the unit of mass density (volumic mass) defined as the density of substance which mass equal to one microgram occupies the volume one liter.(NCI)</rdfs:isDefinedBy>
        <rdfs:label>ng/mL</rdfs:label>
    </Class>
</rdf:RDF>



