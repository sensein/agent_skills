        <rdfs:comment xml:lang="en">Total steps within the considered segment of data and between 6 AM and 12 PM</rdfs:comment>
        <rdfs:label xml:lang="en">steps6am12pm</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/stressDuration -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/stressDuration">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/StressLevel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Stress duration registered by the wearable device. [uom: seconds]</rdfs:comment>
        <rdfs:label xml:lang="en">stressDuration</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/stressQualifier -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/stressQualifier">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/StressLevel"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:comment xml:lang="en">Stress qualifier registered by the wearable device.</rdfs:comment>
        <rdfs:label xml:lang="en">stressQualifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/stroke -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/stroke">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/ALSBrainteaserComorbidities"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether a patient ever had a stroke.</rdfs:comment>
        <rdfs:label xml:lang="en">stroke</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/sunExposure -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/sunExposure">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Lifestyle"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C1456711</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">The exposure to incident light from the sun. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">sunExposure</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/symptomClinicalName -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/symptomClinicalName">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Symptom"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:comment xml:lang="en">The clinical name of the symptom.</rdfs:comment>
        <rdfs:label xml:lang="en">symptomClinicalName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/symptomEnd -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/symptomEnd">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Symptom"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">When the symptom ended.</rdfs:comment>
        <rdfs:label xml:lang="en">symptomEnd</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/symptomGrade -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/symptomGrade">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Symptom"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">Mild</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">Moderate</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">Severe</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The severity of the symptom.</rdfs:comment>
        <rdfs:label xml:lang="en">symptomGrade</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/symptomStart -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/symptomStart">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Symptom"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">When the symptom started.</rdfs:comment>
        <rdfs:label xml:lang="en">symptomStart</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/symptomType -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/symptomType">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Symptom"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:comment xml:lang="en">Defines the symptom&apos;s category.</rdfs:comment>
        <rdfs:label xml:lang="en">symptomType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/symptomValue -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/symptomValue">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Symptom"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The numerical value associated with the symptom, e.g., the temperature fever.</rdfs:comment>
        <rdfs:label xml:lang="en">symptomValue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/thoracicSpineSurgery -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/thoracicSpineSurgery">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/Last5YearsEvent"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/MoreThan5YearsEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether a patient had a thoracic spine surgery.</rdfs:comment>
        <rdfs:label xml:lang="en">thoracicSpineSurgery</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/thoracicSurgery -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/thoracicSurgery">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/Last5YearsEvent"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/MoreThan5YearsEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether a patient had a thoracic surgery.</rdfs:comment>
        <rdfs:label xml:lang="en">thoracicSurgery</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/thoracicTrauma -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/thoracicTrauma">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/Last5YearsEvent"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/MoreThan5YearsEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether a patient had a thoracic trauma.</rdfs:comment>
        <rdfs:label xml:lang="en">thoracicTrauma</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/thyroidDisorder -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/thyroidDisorder">
