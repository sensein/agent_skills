    <!-- https://w3id.org/brainteaser/ontology/schema/PFTs_FEV1_L -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/PFTs_FEV1_L">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PFTs"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0849974"/>
        <rdfs:comment xml:lang="en">A test of lung function, the FEV1 is the volume exhaled during the first second of a forced expiratory maneuver started from the level of total lung capacity. It is the most frequently used index for assessing bronchoconstriction or bronchodilatation. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">PFTs_FEV1_L</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/PFTs_FEV1_P -->

