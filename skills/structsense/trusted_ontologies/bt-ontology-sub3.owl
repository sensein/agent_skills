                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">Extremely</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">Moderately</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">Not at all</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">Quite a bit</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first xml:lang="en">Slightly</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C3828900"/>
        <rdfs:comment xml:lang="en">During the past 4 weeks, how much did pain interfere with your enjoyment of life?</rdfs:comment>
        <rdfs:label xml:lang="en">MSQOL54_Q52</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/MSQOL54_Q53 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/MSQOL54_Q53">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/MSQOL54"/>
