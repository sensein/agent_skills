        <rdfs:label xml:lang="en">Opioid Use Disorder</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C157959 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C157959">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0155862</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Pneumonia that is attributed to the bacteria Streptococcus pneumonia. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Pneumococcal Pneumonia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3333"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C171133 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C171133">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C5203670</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An acute infection of the respiratory tract that is caused by the severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2). Based on currently available information, SARS-CoV-2 is thought to mainly spread from person to person through respiratory droplets. Typically, there is a two- to 14-day incubation period and infected persons can present with no symptoms or mild to severe fever, dry cough, fatigue, and difficulty breathing. Dysgeusia, anosmia, and gastrointestinal and flu-like symptoms have also been reported. Older adults and persons of any age who have serious underlying medical conditions may be of higher risk for severe illness, including secondary infections, respiratory failure, and multi-organ dysfunction. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">COVID-19 Infection</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C171204 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C171204">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0039980</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Trauma to the chest. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Thoracic Trauma</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3671"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C171457 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C171457">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/TherapeuticProcedureType"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C2349740</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A type of mechanical ventilation procedure that uses a non-invasive means, such as a face mask or nasal mask, to deliver oxygenated air into the lungs. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Non-Invasive Mechanical Ventilation (NIV)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C180747 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C180747">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C3805092"/>
