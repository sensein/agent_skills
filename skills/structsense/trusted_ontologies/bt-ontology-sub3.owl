        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PSQI"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:comment xml:lang="en">Other reason(s), please describe:</rdfs:comment>
        <rdfs:label xml:lang="en">PSQI_Q5J_1</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/PSQI_Q5J_2 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/PSQI_Q5J_2">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PSQI"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">Less than once a week</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">Not during the past month</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">Once or twice a week</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">Three or more times a week</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">how often have you had trouble sleeping because of this?</rdfs:comment>
        <rdfs:label xml:lang="en">PSQI_Q5J_2</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/PSQI_Q6 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/PSQI_Q6">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PSQI"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">Less than once a week</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">Not during the past month</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">Once or twice a week</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">Three or more times a week</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">During the past month, how often have you taken medicine to help you sleep (prescribed or “over the counter”)?</rdfs:comment>
        <rdfs:label xml:lang="en">PSQI_Q6</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/PSQI_Q7 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/PSQI_Q7">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PSQI"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">Less than once a week</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">Not during the past month</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">Once or twice a week</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">Three or more times a week</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">During the past month, how often have you had trouble staying awake while driving, eating meals, or engaging in social activity?</rdfs:comment>
        <rdfs:label xml:lang="en">PSQI_Q7</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/PSQI_Q8 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/PSQI_Q8">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PSQI"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">A very big problem</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">No problem at all</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">Only a very slight problem</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">Somewhat of a problem</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">During the past month, how much of a problem has it been for you to keep up enough enthusiasm to get things done?</rdfs:comment>
        <rdfs:label xml:lang="en">PSQI_Q8</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/PSQI_Q9 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/PSQI_Q9">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PSQI"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">Fairly bad</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">Fairly good</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">Very bad</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">Very good</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">During the past month, how would you rate your sleep quality overall?</rdfs:comment>
        <rdfs:label xml:lang="en">PSQI_Q9</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/SLEEP_ALS_Q1 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/SLEEP_ALS_Q1">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SLEEP_ALS"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">10.0</xsd:maxInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C4054285"/>
        <rdfs:comment xml:lang="en">During the last 7 days, how would you rate your sleep quality overall? Choose a number from 1 to 10 that best describes your sleep quality</rdfs:comment>
        <rdfs:label xml:lang="en">SLEEP_ALS_Q1</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/VASQ1 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/VASQ1">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/VAS"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">10.0</xsd:maxInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0042815"/>
        <rdfs:comment xml:lang="en">Choose a number from 0 to 10 that best describes your pain</rdfs:comment>
        <rdfs:label xml:lang="en">VAS_Q1</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/WEIGHT_Q1 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/WEIGHT_Q1">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/WEIGHT"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Please, enter your weight</rdfs:comment>
        <rdfs:label xml:lang="en">WEIGHT_Q1</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/abdominalSurgery -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/abdominalSurgery">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/Last5YearsEvent"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/MoreThan5YearsEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether a patient had an abdominal surgery.</rdfs:comment>
        <rdfs:label xml:lang="en">abdominalSurgery</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/activeKilocalories -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/activeKilocalories">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PhysicalActivityData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Active kilocalories registered by the wearable device. [uom: kcal]</rdfs:comment>
        <rdfs:label xml:lang="en">activeKilocalories</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/activeTime -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/activeTime">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PhysicalActivityData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Active time registered by the wearable device. [uom: seconds]</rdfs:comment>
        <rdfs:label xml:lang="en">activeTime</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/activityDistance -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/activityDistance">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PhysicalActivityData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Activity distance registered by the wearable device. [uom: meters]</rdfs:comment>
        <rdfs:label xml:lang="en">activityDistance</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/activityEndYear -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/activityEndYear">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Activity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
        <rdfs:comment xml:lang="en">The year in which an activity ended.</rdfs:comment>
        <rdfs:label xml:lang="en">activityEndYear</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/activityIntensity -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/activityIntensity">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PhysicalActivity"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">Intense</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">Moderate</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">Professional</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">Soft</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The level of intensity with which the physical activity is carried out.</rdfs:comment>
        <rdfs:label xml:lang="en">activityIntensity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/activityStartYear -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/activityStartYear">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Activity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
        <rdfs:comment xml:lang="en">The year in which the activity started.</rdfs:comment>
        <rdfs:label xml:lang="en">activityStartYear</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/activitySteps -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/activitySteps">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PhysicalActivityData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Activity steps registered by the wearable device.</rdfs:comment>
        <rdfs:label xml:lang="en">activitySteps</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/activityStepsGoal -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/activityStepsGoal">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PhysicalActivityData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Activity steps goal registered by the wearable device.</rdfs:comment>
        <rdfs:label xml:lang="en">activityStepsGoal</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/activityStressDuration -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/activityStressDuration">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/StressLevel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Activity stress duration registered by the wearable device. [uom: seconds]</rdfs:comment>
        <rdfs:label xml:lang="en">activityStressDuration</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/activityType -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/activityType">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PhysicalActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:comment xml:lang="en">The type of physical activity carried out.</rdfs:comment>
        <rdfs:label xml:lang="en">activityType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/administrationFrequency -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/administrationFrequency">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Administration"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:comment xml:lang="en">The frequency of administration of the pharmacological substance.</rdfs:comment>
        <rdfs:label xml:lang="en">administrationFrequency</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/administrationRoute -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/administrationRoute">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Administration"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <dcterms:conformsTo xml:lang="en">https://uts.nlm.nih.gov/uts/umls/concept/C0013153</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Designation of the part of the body through which or into which, or the way in which, the medicinal product is intended to be introduced. In some cases a medicinal product can be intended for more than one route and/or method of administration. [Definition Source: NCI][attribution: ICH]</rdfs:comment>
        <rdfs:label xml:lang="en">administrationRoute</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/administrationUoM -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/administrationUoM">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Administration"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:comment xml:lang="en">The Unit of Measure (UoM) of the adminstration dose.</rdfs:comment>
        <rdfs:label xml:lang="en">administrationUoM</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/adminstrationDose -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/adminstrationDose">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Administration"/>
