        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/CSFAnalysis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">A quantitative measurement of Immunoglobulin G (IgG) present in a sample of CSF. Unit of measure : [mg/l].</rdfs:comment>
        <rdfs:label xml:lang="en">immunoglobulinGCSF</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/intensityDurationGoal -->

