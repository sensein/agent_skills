        <rdfs:comment xml:lang="en">Oral preparations containing dietary ingredient(s) intended to supplement the diet. Dietary ingredients include vitamins, minerals, herbs, amino acids, extracts and metabolites. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Dietary Supplement</rdfs:label>
        <skos:note xml:lang="en">Dietary supplements do not have an ATC but they belong to the GMP class 4AA2F30.</skos:note>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C15304 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C15304">
