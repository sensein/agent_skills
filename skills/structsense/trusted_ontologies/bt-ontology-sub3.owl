    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatC2a -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatC2a">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The contributions of heart rate acceleration in long-term Heart Rate Variability (HRV) (Piskorski, 2011).</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatC2a</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatC2d -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatC2d">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The contributions of heart rate deceleration in long-term HRV (Piskorski, 2011).</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatC2d</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatCSI -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatCSI">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The Cardiac Sympathetic Index (Toichi, 1997), calculated by dividing the longitudinal variability of the Poincaré plot by its transverse variability.</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatCSI</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatCSIModified -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatCSIModified">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The modified CSI (Jeppesen, 2014) obtained by dividing the square of the longitudinal variability by its transverse variability. </rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatCSIModified</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatCVI -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatCVI">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The Cardiac Sympathetic Index (Toichi, 1997), equal to the logarithm of the product of longitudinal variability of the Poincaré plot by its transverse variability.</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatCVI</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatCVSD -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatCVSD">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The root mean square of the sum of successive differences (RMSSD) divided by the mean of the RR intervals (MeanNN).</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatCVSD</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatCa -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatCa">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The total contributions of heart rate accelerations to HRV.</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatCa</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatCd -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatCd">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The total contributions of heart rate accelerations to HRV.</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatCd</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatGI -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatGI">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Guzik’s Index, defined as the distance of points above line of identity (LI) to LI divided by the distance of all points in Poincaré plot to LI except those that are located on LI.</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatGI</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatHTI -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatHTI">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The HRV triangular index, measuring the total number of RR intervals divided by the height of the RR intervals histogram.</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatHTI</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatHcvNN -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatHcvNN">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The median absolute deviation of the RR intervals (MadNN) divided by the median of the absolute differences of their successive differences (MedianNN).</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatHcvNN</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatIALS -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatIALS">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Inverse of the average length of the acceleration/deceleration segments. </rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatIALS</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatIqrNN -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatIqrNN">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The interquartile range (IQR) of the RR intervals. </rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatIqrNN</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatMadNN -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatMadNN">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The median absolute deviation of the RR intervals.</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatMadNN</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatMeanNN -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatMeanNN">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The mean of the RR intervals.</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatMeanNN</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatMedianNN -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatMedianNN">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The median of the absolute values of the successive differences between RR intervals.</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatMedianNN</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatPAS -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatPAS">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Percentage of NN intervals in alternation segments</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatPAS</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatPI -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatPI">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Porta’s Index, defined as the number of points below LI divided by the total number of points in Poincaré plot except those that are located on LI.</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatPI</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatPIP -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatPIP">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Percentage of inflection points of the RR intervals series.</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatPIP</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatPNN20 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatPNN20">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The proportion of RR intervals greater than 20ms, out of the total number of RR intervals.</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatPNN20</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatPNN50 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatPNN50">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The proportion of RR intervals greater than 50ms, out of the total number of RR intervals.</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatPNN50</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatPSS -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatPSS">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Percentage of short segments</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatPSS</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatRmssd -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatRmssd">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The square root of the mean of the sum of successive differences between adjacent RR intervals.</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatRmssd</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatSD1 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatSD1">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">SD1 is a measure of the spread of RR intervals on the Poincaré plot perpendicular to the line of identity. It is an index of short-term RR interval fluctuations, i.e., beat-to-beat variability. It is equivalent (although on another scale) to RMSSD, and therefore it is redundant to report correlations with both (Ciccone, 2017).</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatSD1</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatSD1SD2 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatSD1SD2">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The ratio between short- and long-term fluctuations of the RR intervals (SD1 divided by SD2).</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatSD1SD2</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatSD1a -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatSD1a">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Short-term variance of contributions of accelerations (shortenings of RR intervals) (Piskorski, 2011).</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatSD1a</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatSD1d -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatSD1d">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Short-term variance of contributions of decelerations (prolongations of RR intervals) (Piskorski, 2011).</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatSD1d</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatSD2 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatSD2">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Measure of the spread of RR intervals on the Poincaré plot along the line of identity. It is an index of long-term RR interval fluctuations. </rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatSD2</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatSDANN1 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatSDANN1">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The standard deviation of average RR intervals extracted from 1-minute segments of time series data.</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatSDANN1</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatSDANN2 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatSDANN2">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The standard deviation of average RR intervals extracted from 2-minutes segments of time series data.</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatSDANN2</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatSDANN5 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatSDANN5">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The standard deviation of average RR intervals extracted from 5-minutes segments of time series data.</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatSDANN5</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatSDNN -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatSDNN">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The standard deviation of the RR intervals.</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatSDNN</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatSDNNI -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatSDNNI">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The mean of the standard deviations of RR intervals extracted from 2-minutes segments of time series data.</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatSDNNI</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatSDNNI1 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatSDNNI1">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The mean of the standard deviations of RR intervals extracted from 1-minute segments of time series data.</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatSDNNI1</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatSDNNI5 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatSDNNI5">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The mean of the standard deviations of RR intervals extracted from 5-minutes segments of time series data.</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatSDNNI5</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatSDNNa -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatSDNNa">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Total variance of contributions of accelerations (shortenings of RR intervals) (Piskorski, 2011).</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatSDNNa</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatSDNNd -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatSDNNd">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Total variance of contributions of decelerations (prolongations of RR intervals) (Piskorski, 2011).</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatSDNNd</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatSDSD -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatSDSD">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The standard deviation of the successive differences between RR intervals.</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatSDSD</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/beatToBeatSI -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/beatToBeatSI">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeatToBeatData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Slope Index, defined as the phase angle of points above LI divided by the phase angle of all points in Poincaré plot except those that are located on LI.</rdfs:comment>
        <rdfs:label xml:lang="en">beatToBeatSI</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/before20Years -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/before20Years">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Smoking"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether a patient smoked before the age of 20.</rdfs:comment>
        <rdfs:label xml:lang="en">before20Years</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/birthYear -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/birthYear">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2000/10/swap/pim/contact#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C2826771</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">The year in which a person was born. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">birthYear</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/bmrKilocalories -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/bmrKilocalories">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PhysicalActivityData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">BMR kilocalories registered by the wearable device. [uom: kcal]</rdfs:comment>
        <rdfs:label xml:lang="en">bmrKilocalories</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/bmvtrTotal -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/bmvtrTotal">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BVMTR"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Brief Visuospatial Memory Test-Revised Total Score.</rdfs:comment>
        <rdfs:label xml:lang="en">bmvtrTotal</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/bodyMassIndex -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/bodyMassIndex">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/ClinicalEvaluation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Weight in kilograms divided by the square of the height in metres, used esp. as an indicator of obesity or general nutritional status; also called Quetelet index; abbreviated BMI. [Definition Source: Oxford English Dictionary]</rdfs:comment>
        <rdfs:label xml:lang="en">bodyMassIndex</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/bowelAndBladderEDSS -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/bowelAndBladderEDSS">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/EDSS"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Expanded Disability Status Score (EDSS) score for bowel and bladder functions.</rdfs:comment>
        <rdfs:label xml:lang="en">bowelAndBladderEDSS</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/bowelAndBladderRelapse -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/bowelAndBladderRelapse">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Relapse"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the relapse involved bowel and bladder functions.</rdfs:comment>
        <rdfs:label xml:lang="en">bowelAndBladderRelapse</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/brainAtrophyMRI -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/brainAtrophyMRI">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/MRI"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>high</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>mild</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>moderate</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>none</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The level of brain atrophy (cerebral atrophy) found in the brain of the patient shown by the MRI.</rdfs:comment>
        <rdfs:label xml:lang="en">brainAtrophyMRI</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/brainsetmRelapse -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/brainsetmRelapse">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Relapse"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the relapse involved the brainstem functions.</rdfs:comment>
        <rdfs:label xml:lang="en">brainstemRelapse</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/brainstemEDSS -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/brainstemEDSS">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/EDSS"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Expanded Disability Status Score (EDSS) score for brainstem functions.</rdfs:comment>
        <rdfs:label xml:lang="en">brainstemEDSS</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/bulbarOnset -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/bulbarOnset">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Onset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the patient experienced bulbar onset, which means he or she first notice speech or swallowing problems. [Definition Source: National Institute of Neurological Disorders and Stroke]</rdfs:comment>
        <rdfs:label xml:lang="en">bulbarOnset</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/bulbarSubscore -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/bulbarSubscore">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/ALSFRS"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Bulbar ALSFRS subscore. Sum of items: 1, 2 and 3.</rdfs:comment>
        <rdfs:label xml:lang="en">bulbarSubscore</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/burdenT1Lesions -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/burdenT1Lesions">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/MRI"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">High</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">Mild</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">Moderate</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The burden of T2 lesions showed in the MRI.</rdfs:comment>
        <rdfs:label xml:lang="en">burdenT1Lesions</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/burdenT2Lesions -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/burdenT2Lesions">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/MRI"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">High</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">Mild</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">Moderate</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The burden of T1 lesions showed in the MRI.</rdfs:comment>
        <rdfs:label xml:lang="en">burdenT2Lesions</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/bvmtrTrial1 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/bvmtrTrial1">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BVMTR"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Brief Visuospatial Memory Test-Revised Immediate Recall Trial 1 Score.</rdfs:comment>
        <rdfs:label xml:lang="en">bvmtrTrial1</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/bvmtrTrial2 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/bvmtrTrial2">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BVMTR"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Brief Visuospatial Memory Test-Revised Immediate Recall Trial 2 Score.</rdfs:comment>
        <rdfs:label xml:lang="en">bvmtrTrial2</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/bvmtrTrial3 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/bvmtrTrial3">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BVMTR"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Brief Visuospatial Memory Test-Revised Immediate Recall Trial 3 Score.</rdfs:comment>
        <rdfs:label xml:lang="en">bvmtrTrial3</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/cardiacDisease -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/cardiacDisease">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/ALSBrainteaserComorbidities"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether a patient ever had a cardiac disease.</rdfs:comment>
        <rdfs:label xml:lang="en">cardiacDisease</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/cerebellarEDSS -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/cerebellarEDSS">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/EDSS"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Expanded Disability Status Score (EDSS) score for cerebellar functions.</rdfs:comment>
        <rdfs:label xml:lang="en">cerebellarEDSS</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/cerebellarRelapse -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/cerebellarRelapse">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Relapse"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the relapse involved the celebellar functions.</rdfs:comment>
        <rdfs:label xml:lang="en">cerebellarRelapse</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/cerebralEDSS -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/cerebralEDSS">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/EDSS"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Expanded Disability Status Score (EDSS) score for cerebral functions.</rdfs:comment>
        <rdfs:label xml:lang="en">cerebralEDSS</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/cervicalSpineSurgery -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/cervicalSpineSurgery">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/Last5YearsEvent"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/MoreThan5YearsEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether a patient had a cervical spine surgery.</rdfs:comment>
        <rdfs:label xml:lang="en">cervicalSpineSurgery</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/cervicalTrauma -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/cervicalTrauma">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/Last5YearsEvent"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/MoreThan5YearsEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether a patient had a cervical trauma.</rdfs:comment>
        <rdfs:label xml:lang="en">cervicalTrauma</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/clinicalTrialDescription -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/clinicalTrialDescription">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/ClinicalTrial"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:comment xml:lang="en">The description of a clinical trial.</rdfs:comment>
        <rdfs:label xml:lang="en">clinicalTrialDescription</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/clinicallyEvaluatedEDSS -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/clinicallyEvaluatedEDSS">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/EDSS"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Expanded Disability Status Score (EDSS) evaluated by the physician.</rdfs:comment>
        <rdfs:label xml:lang="en">clinicallyEvaluatedEDSS</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/cognitivePhenotype -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/cognitivePhenotype">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Patient"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:comment xml:lang="en">Cognitive phenotype is defined as the broad set of measurable parameters associated with cognition, including not only behavioral symptoms and specific neurocognitive probes, but also physiological and structural indices which we can use to characterize cognitive function at the neural systems. [Source: doi.org/10.1007/978-1-4614-3846-5_4]</rdfs:comment>
        <rdfs:label xml:lang="en">cognitivePhenotype</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/cognitiveRelapse -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/cognitiveRelapse">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Relapse"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the relapse involved the mental functions.</rdfs:comment>
        <rdfs:label xml:lang="en">cognitiveRelapse</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/comorbiditySeverity -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/comorbiditySeverity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Comorbidity"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>life risk</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>moderate</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>serious</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>slight</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The severity of a comorbidity.</rdfs:comment>
        <rdfs:label xml:lang="en">comorbiditySeverity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/comorbidityTreatment -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/comorbidityTreatment">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Comorbidity"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:comment xml:lang="en">The treatment used for the comorbidity.</rdfs:comment>
        <rdfs:label xml:lang="en">comorbidityTreatment</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/componentName -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/componentName">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/LaboratoryTestResult"/>
