        <rdfs:label xml:lang="en">unitOfMeasure</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/unmeasurableSleepDuration -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/unmeasurableSleepDuration">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SleepData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Unmeasurable sleep duration registered by the wearable device. [uom: seconds]</rdfs:comment>
        <rdfs:label xml:lang="en">unmeasurableSleepDuration</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/upperLimbSurgery -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/upperLimbSurgery">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/Last5YearsEvent"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/MoreThan5YearsEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether a patient had an upper limb surgery.</rdfs:comment>
        <rdfs:label xml:lang="en">upperLimbSurgery</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/validMeasurements -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/validMeasurements">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/GCI/Environment/Pollution.owl#Air_pollution_concentration"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/WeatherData"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">For each recorded variable, number of valid measurements in that week, ranging from 0 to 7.</rdfs:comment>
        <rdfs:label xml:lang="en">validMeasurements</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/vigorousIntensityDuration -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/vigorousIntensityDuration">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PhysicalActivityData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Vigorous intensity duration registered by the wearable device. [uom: seconds]</rdfs:comment>
        <rdfs:label xml:lang="en">vigorousIntensityDuration</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/virusJCTestedCSF -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/virusJCTestedCSF">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/CSFAnalysis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the presence of JC virus was tested in the CSF specimen.</rdfs:comment>
        <rdfs:label xml:lang="en">virusJCTestedCSF</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/visualAcuityLeft -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/visualAcuityLeft">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/VisualAcuity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Visual Acuity Test on the left eye.</rdfs:comment>
        <rdfs:label xml:lang="en">visualAcuityLeft</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/visualAcuityRight -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/visualAcuityRight">
