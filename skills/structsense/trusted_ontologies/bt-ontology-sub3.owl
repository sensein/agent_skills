        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C12429"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C12767 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C12767">
