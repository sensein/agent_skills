        <rdfs:label xml:lang="en">Limb</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C12431 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C12431">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
