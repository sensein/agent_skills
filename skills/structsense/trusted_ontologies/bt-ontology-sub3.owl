    <!-- https://w3id.org/brainteaser/ontology/schema/averageMeasurement -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/averageMeasurement">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/GCI/Environment/Pollution.owl#Air_pollution_concentration"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/WeatherData"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Average of valid measurements in that week; if there are no valid measurements in that week, it is denoted as NA.</rdfs:comment>
        <rdfs:label xml:lang="en">averageMeasurement</rdfs:label>
    </owl:DatatypeProperty>
    


