    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C25205 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C25205">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/KinshipType"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0037683</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A male human offspring. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Son</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C21481"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C264 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C264">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/TherapeuticProcedureType"/>
        <rdfs:comment>Medicine to stop, prevent, or control seizures (convulsions). [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Anticonvulsant Agent</rdfs:label>
        <skos:broaderTransitive rdf:resource="https://w3id.org/brainteaser/ontology/schema/DrugsForOtherDiseases"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26682 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26682">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0000737</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Painful sensation in the abdominal region. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Abdominal Pain</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C4876"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26704 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26704">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0004626</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Acute infection of the lung parenchyma caused by bacteria (e.g., Streptococcus pneumoniae, Haemophilus influenzae, Chlamydia pneumoniae, Mycoplasma pneumoniae, and Legionella pneumophila). Signs and symptoms include productive cough, fever, chills, shortness of breath, and chest pain. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Bacterial Pneumonia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3333"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26714 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26714">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0007570</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An autoimmune genetic disorder with an unknown pattern of inheritance that primarily affects the digestive tract. It is caused by intolerance to dietary gluten. Consumption of gluten protein triggers an immune response which damages small intestinal villi and prevents adequate absorption of nutrients. Clinical signs include abdominal cramping, diarrhea or constipation and weight loss. If untreated, the clinical course may progress to malnutrition, anemia, osteoporosis and an increased risk of intestinal malignancies. However, the prognosis is favorable with successful avoidance of gluten in the diet. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Celiac Disease</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26717 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26717">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0007933</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An eyelid cyst caused by the blockage of a meibomian gland. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Chalazion</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26747 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26747">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0011860</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A type of diabetes mellitus that is characterized by insulin resistance or desensitization and increased blood glucose levels. This is a chronic disease that can develop gradually over the life of a patient and can be linked to both environmental factors and heredity. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Type 2 Diabetes Mellitus</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2985"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26769 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26769">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0015469</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Partial or complete paralysis of the facial muscles of one side of a person&apos;s face. It is caused by damage to the seventh cranial nerve. It is usually temporary but it may recur. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Cranial Nerve VII Palsy</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26774 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26774">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0015802</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A traumatic or pathologic injury to the femur in which the continuity of the femur is broken. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Femur Fracture</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3671"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26780 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26780">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0017152</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Inflammation of the stomach. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Gastritis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26781 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26781">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0017168"/>
        <rdfs:comment xml:lang="en">A chronic disorder characterized by reflux of the gastric and/or duodenal contents into the distal esophagus. It is usually caused by incompetence of the lower esophageal sphincter. Symptoms include heartburn and acid indigestion. It may cause injury to the esophageal mucosa. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Gastroesophageal Reflux Disease</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26782 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26782">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0017601</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Increased pressure in the eyeball due to obstruction of the outflow of aqueous humor. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Glaucoma</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26800 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26800">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0020676</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Abnormally low levels of thyroid hormone. [Definition Source: NCI][attribution: NICHD]</rdfs:comment>
        <rdfs:label xml:lang="en">Hypothyroidism</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C26893"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26805 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26805">
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0022568</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Inflammation of the cornea. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Keratitis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26806 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26806">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0022578</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A degenerative, structural disorder of the eye, characterized by a cone-shaped protrusion of the cornea. It may lead to visual disturbances. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Keratoconus</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26815 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26815">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0023524</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A progressive demyelination within the central nervous system associated with reactivation of a latent JC virus infection. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Progressive Multifocal Leukoencephalopathy</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26816 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26816">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0750394</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A laboratory test result indicating a decreased number of white blood cells in the peripheral blood. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Leukopenia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3367"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26823 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26823">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0853986</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An abnormally small number of lymphocytes in the circulating blood. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Lymphopenia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C26816"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26835 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26835">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0027765"/>
        <rdfs:comment xml:lang="en">A non-neoplastic or neoplastic disorder that affects the brain, spinal cord, or peripheral nerves. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Nervous System Disorder</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26845 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26845">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0030567</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A progressive degenerative disorder of the central nervous system characterized by loss of dopamine producing neurons in the substantia nigra and the presence of Lewy bodies in the substantia nigra and locus coeruleus. Signs and symptoms include tremor which is most pronounced during rest, muscle rigidity, slowing of the voluntary movements, a tendency to fall back, and a mask-like facial expression. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Parkinson&apos;s Disease</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C79593"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26855 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26855">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0032026"/>
        <rdfs:comment xml:lang="en">A mild, self-limited skin disorder that is most commonly seen in children and young adults. It is characterized by an initial large round spot on the chest, abdomen, or back, often referred to as a herald patch, that is usually followed within a week by a distinctive pattern of similar but smaller papules on the torso, arms, and legs. There may also be itching, especially when overheated. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Pityriasis Rosea</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26874 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26874">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0035305</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An eye emergency condition which may lead to blindness if left untreated. It is characterized by the separation of the inner retina layers from the underlying pigment epithelium. Causes include trauma, advanced diabetes mellitus, high myopia, and choroid tumors. Symptoms include sudden appearance of floaters, sudden light flushes, and blurred vision. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Retinal Detachment</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26883 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26883">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C1527336</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An autoimmune disorder affecting the salivary and lacrimal glands. Morphologically, it is characterized by the presence of lymphocytic and plasmacytic infiltrates which cause destruction of these glands. It results in dry mouth and dry eyes. It may be associated with the presence of other autoimmune disorders, including rheumatoid arthritis and lupus erythematosus. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Sjogren Syndrome</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2889"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26893 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26893">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0040128</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A non-neoplastic or neoplastic disorder that affects the thyroid gland. Representative examples include hyperthyroidism, hypothyroidism, thyroiditis, follicular adenoma, and carcinoma. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Thyroid Gland Disorder</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26894 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26894">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0040147</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Inflammation of the thyroid gland. This category includes Hashimoto thyroiditis, Riedel thyroiditis, acute thyroiditis, subacute thyroiditis, and radiation-induced thyroiditis. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Thyroiditis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C26893"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26905 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26905">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0042018"/>
        <rdfs:comment xml:lang="en">A concretion in the urinary tract. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Urinary Stone</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26915 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26915">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0042900</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Generalized well circumscribed patches of leukoderma that are generally distributed over symmetric body locations and is due to autoimmune destruction of melanocytes. [Definition Source: NCI][attribution: NICHD]</rdfs:comment>
        <rdfs:label xml:lang="en">Vitiligo</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26921 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26921">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0085594</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Shivering secondary to a febrile process. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Fever Chills</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C4876"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26934 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26934">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0149523</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An acute infection of the bladder. It is usually caused by bacteria. Signs and symptoms include increased frequency of urination, pain or burning during urination, fever, cloudy or bloody urine, and suprapubic pain. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Acute Cystitis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26948 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26948">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0151905</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An increase in the level of alanine aminotransferase in the blood. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Alanine Aminotransferase Increased</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3367"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26952 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26952">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0152177</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A non-neoplastic or neoplastic disorder affecting the trigeminal nerve (fifth cranial nerve). [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Trigeminal Nerve Disorder</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26989 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C26989">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0159877</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Traumatic or pathological injury to the ankle joint in which the continuity of an ankle bone is broken. Symptoms include pain, swelling, and difficulty moving the affected leg and foot. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Ankle Fracture</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3671"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C27006 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C27006">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0206061</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Inflammation of interstitial lung tissue, usually associated with infection. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Interstitial Pneumonia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3333"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C27020 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C27020">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0236100"/>
        <rdfs:comment xml:lang="en">A non-neoplastic or neoplastic disorder that affects the female genital system. Representative examples of non-neoplastic disorders include infection, endometriosis, and adenomyosis. Representative examples of neoplastic disorders include germ cell tumors, carcinoma, lymphoma, and sarcoma. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Female Reproductive System Disorder</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C27043 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C27043">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0264490</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Life-threatening respiratory failure that develops rapidly. Causes include injury, sepsis, drug overdose, and pancreatitis. It manifests with dyspnea and cyanosis and may lead to cardiovascular shock. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Acute Respiratory Failure</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C27168 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C27168">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0520679</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A disorder characterized by recurrent episodic disruptions of breathing during sleep. It is caused by the intermittent relaxation of pharyngeal muscles leading to the narrowing or complete blockage of the upper airway. This results in compensatory arousal from sleep to breathe again. An anatomically narrow airway from body habitus or enlarged pharyngeal structures may also predispose to obstruction. Clinical presentation usually includes snoring, daytime sleepiness, difficulty concentrating and fatigue. Clinical course may progress to chronic hypoxemia with cardiovascular and cerebrovascular sequelae. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Obstructive Sleep Apnea Syndrome</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C27191 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C27191">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0677607</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An autoimmune disorder caused by the production of autoantibodies against thyroid tissue. There is progressive destruction of the thyroid follicles leading to hypothyroidism. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Hashimoto Thyroiditis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C26894"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C27204 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C27204">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0035435"/>
        <rdfs:comment xml:lang="en">Inflammatory and degenerative diseases of connective tissue structures, such as arthritis. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Rheumatologic Disorder</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C27219 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C27219">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0877203"/>
        <rdfs:comment xml:lang="en">A respiratory tract infection caused by a virus. Viruses represent the most common causes of upper and lower respiratory tract infections and include rhinoviruses, influenza viruses, parainfluenza viruses, and respiratory syncytial virus. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Viral Respiratory Tract Infection</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C27586 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C27586">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C1335000</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Any disorder other than abnormal tissue growth resulting from uncontrolled cell proliferation affecting the nervous system.</rdfs:comment>
        <rdfs:label xml:lang="en">Non-Neoplastic Central Nervous System Disorder</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C26835"/>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C27996 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C27996">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0027051"/>
        <rdfs:comment xml:lang="en">Gross necrosis of the myocardium, as a result of interruption of the blood supply to the area, as in coronary thrombosis. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Myocardial Infarction</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C28195 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C28195">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0040038</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Occlusion of the lumen of a vessel by a thrombus that has migrated from a distal site via the blood stream. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Thromboembolism</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2931"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C28286 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C28286">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0917801"/>
        <rdfs:comment xml:lang="en">A sleep disorder characterized by difficulty in falling asleep and/or remaining asleep. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Insomnia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C28381 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C28381">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/AnatomicalSite"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C1409894</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A circular band of muscle that functions to regulate the size of an orifice in the body. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Sphincter</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C28397 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C28397">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0004096</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A chronic respiratory disease manifested as difficulty breathing due to the narrowing of bronchial passageways. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Asthma</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C98541"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C2851 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C2851">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0001175"/>
        <rdfs:comment xml:lang="en">A syndrome resulting from the acquired deficiency of cellular immunity caused by the human immunodeficiency virus (HIV). It is characterized by the reduction of the Helper T-lymphocytes in the peripheral blood and the lymph nodes. Symptoms include generalized lymphadenopathy, fever, weight loss, and chronic diarrhea. Patients with AIDS are especially susceptible to opportunistic infections, tuberculosis, candida infections, and cryptococcosis), and the development of malignant neoplasms (usually non-Hodgkin lymphoma and Kaposi sarcoma). The human immunodeficiency virus is transmitted through sexual contact, sharing of contaminated needles, or transfusion of contaminated blood. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Acquired Immunodeficiency Syndrome (AIDS)</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C2852 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C2852">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0001418</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A common cancer characterized by the presence of malignant glandular cells. Morphologically, adenocarcinomas are classified according to the growth pattern (e.g., papillary, alveolar) or according to the secreting product (e.g., mucinous, serous). Representative examples of adenocarcinoma are ductal and lobular breast carcinoma, lung adenocarcinoma, renal cell carcinoma, hepatocellular carcinoma (hepatoma), colon adenocarcinoma, and prostate adenocarcinoma. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Adenocarcinoma</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2916"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C28539 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C28539">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/Gene"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C1367578</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">This gene plays a role in the transcriptional activation of androgen responsive genes. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">AR Gene</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C2866 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C2866">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0002395</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A progressive, neurodegenerative disease characterized by loss of function and death of nerve cells in several areas of the brain leading to loss of cognitive function such as memory and language. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Alzheimer&apos;s Disease</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C4786"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C2869 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C2869">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0002871</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A reduction in the number of red blood cells, the amount of hemoglobin, and/or the volume of packed red blood cells. Clinically, anemia represents a reduction in the oxygen-transporting capacity of a designated volume of blood, resulting from an imbalance between blood loss (through hemorrhage or hemolysis) and blood production. Signs and symptoms of anemia may include pallor of the skin and mucous membranes, shortness of breath, palpitations of the heart, soft systolic murmurs, lethargy, and fatigability. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Anemia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C2875 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C2875">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <rdfs:comment xml:lang="en">Loss of appetite. [Definition Source: NCI]</rdfs:comment>
        <rdfs:comment>https://uts.nlm.nih.gov/uts/umls/concept/C1971624</rdfs:comment>
        <rdfs:label xml:lang="en">Anorexia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C2878 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C2878">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0003469</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A category of psychiatric disorders which are characterized by anxious feelings or fear often accompanied by physical symptoms associated with anxiety. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Anxiety Disorder</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2893"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C2881 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C2881">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0003811</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Any variation from the normal rate or rhythm (which may include the origin of the impulse and/or its subsequent propagation) in the heart. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Arrhythmia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2931"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C2883 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C2883">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0003864</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An inflammatory process affecting a joint. Causes include infection, autoimmune processes, degenerative processes, and trauma. Signs and symptoms may include swelling around the affected joint and pain. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Arthritis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C2884 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C2884">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0003873</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A chronic, systemic autoimmune disorder characterized by inflammation in the synovial membranes and articular surfaces. It manifests primarily as a symmetric, erosive polyarthritis that spares the axial skeleton and is typically associated with the presence in the serum of rheumatoid factor. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Rheumatoid Arthritis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2883"/>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2889"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C2889 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C2889">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0004364</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A disorder resulting from loss of function or tissue destruction of an organ or multiple organs, arising from humoral or cellular immune responses of the individual to his own tissue constituents. It may be systemic (e.g., systemic lupus erythematosus), or organ specific, (e.g., thyroiditis). [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Autoimmune Disease</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C2893 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C2893">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0004936</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A disorder characterized by behavioral and/or psychological abnormalities, often accompanied by physical symptoms. The symptoms may cause clinically significant distress or impairment in social and occupational areas of functioning. Representative examples include anxiety disorders, cognitive disorders, mood disorders and schizophrenia. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Psychiatric Disorder</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C2897 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C2897">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C1704272"/>
        <rdfs:comment xml:lang="en">A non-cancerous nodular enlargement of the prostate gland. It is characterized by the presence of epithelial cell nodules, and stromal nodules containing fibrous and smooth muscle elements. It is the most common urologic disorder in men, causing blockage of urine flow. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Benign Prostatic Hyperplasia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C2914 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C2914">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0006852</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Infection of the vulva and vagina with a fungus of the genus CANDIDA. It is a disease associated with HIV infection. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Vulvovaginal Candidiasis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C2916 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C2916">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0007097</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A malignant tumor arising from epithelial cells. Carcinomas that arise from glandular epithelium are called adenocarcinomas, those that arise from squamous epithelium are called squamous cell carcinomas, and those that arise from transitional epithelium are called transitional cell carcinomas. Morphologically, the malignant epithelial cells may display abnormal mitotic figures, anaplasia, and necrosis. Carcinomas are graded by the degree of cellular differentiation as well, moderately, or poorly differentiated. Carcinomas invade the surrounding tissues and tend to metastasize to other anatomic sites. Lung carcinoma, skin carcinoma, breast carcinoma, colon carcinoma, and prostate carcinoma are the most frequently seen carcinomas. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Carcinoma</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C9305"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C2920 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C2920">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0007114</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A primary or metastatic malignant neoplasm involving the skin. Primary malignant skin neoplasms most often are carcinomas (either basal cell or squamous cell carcinomas) or melanomas. Metastatic malignant neoplasms to the skin include carcinomas and lymphomas. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Malignant Skin Neoplasm</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C9305"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C2921 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C2921">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0007117</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">The most frequently seen skin cancer. It arises from basal cells of the epidermis and pilosebaceous units. Clinically it is divided into the following types: nodular, ulcerative, superficial, multicentric, erythematous, and sclerosing or morphea-like. More than 95% of these carcinomas occur in patients over 40. They develop on hair-bearing skin, most commonly on sun-exposed areas. Approximately 85% are found on the head and neck and the remaining 15% on the trunk and extremities. Basal cell carcinoma usually grows in a slow and indolent fashion. However, if untreated, the tumor may invade the subcutaneous fat, skeletal muscle and bone. Distant metastases are rare. Excision, curettage and irradiation cure most basal cell carcinomas. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Skin Basal Cell Carcinoma</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C156767"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C2922 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C2922">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0007118</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A basal cell carcinoma which displays squamous differentiation. The neoplastic cells have more abundant cytoplasm with more marked keratinization than typical basal cell carcinomas. It usually has a more aggressive clinical course compared to typical basal cell carcinoma, and it may produce regional or widespread metastases. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Skin Basosquamous Cell Carcinoma</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2921"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C2931 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C2931">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0007222</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A non-neoplastic or neoplastic disorder affecting the heart or the vessels (arteries, veins and lymph vessels). Representative examples of non-neoplastic cardiovascular disorders are endocarditis and hypertension. Representative examples of neoplastic cardiovascular disorders are endocardial myxoma and angiosarcoma. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Cardiovascular Disorder</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C2955 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C2955">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0009402"/>
        <rdfs:comment xml:lang="en">A malignant epithelial neoplasm that arises from the colon or rectum and invades through the muscularis mucosa into the submucosa. The vast majority are adenocarcinomas. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Colorectal Carcinoma</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3262"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C2978 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C2978">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0010709</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A sac-like closed membranous structure that may be empty or contain fluid or amorphous material. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Cyst</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3367"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C2982 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C2982">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0011570</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A melancholy feeling of sadness and despair. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Depression</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C92200"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C2985 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C2985">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0011849</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A metabolic disorder characterized by abnormally high blood sugar levels due to diminished production of insulin or insulin resistance/desensitization. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Diabetes Mellitus</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C2986 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C2986">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0011854</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A chronic condition characterized by minimal or absent production of insulin by the pancreas. [Definition Source: NCI][attribution: NICHD]</rdfs:comment>
        <rdfs:label xml:lang="en">Type 1 Diabtes Mellitus</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2889"/>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2985"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C29888 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C29888">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0026780</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A contagious viral infection caused by the mumps virus. Symptoms include swollen and tender parotid glands, fever, muscle aches and fatigue. Due to vaccination programs, mumps has become a rare disease. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Mumps</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C2991 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C2991">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0012634</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Any abnormal condition of the body or mind that causes discomfort, dysfunction, or distress to the person affected or those in contact with the person. The term is often used broadly to include injuries, disabilities, syndromes, symptoms, deviant behaviors, and atypical variations of structure and function. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Disease or Disorder</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3001 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3001">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0013595</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A form of dermatitis characterized by red, itchy, scaly, or crusty patches that can be chronic or intermittent. [Definition Source: NCI][attribution: NICHD]</rdfs:comment>
        <rdfs:label xml:lang="en">Eczema</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3014 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3014">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0014175</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">The growth of functional endometrial tissue in anatomic sites outside the uterine body. It most often occurs in the pelvic organs. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Endometriosis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3020 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3020">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0014544</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A brain disorder characterized by episodes of abnormally increased neuronal discharge resulting in transient episodes of sensory or motor neurological dysfunction, or psychic dysfunction. These episodes may or may not be associated with loss of consciousness or convulsions. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Seizure Disorder</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3021 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3021">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0014548</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A chronic condition characterised by recurrent generalised seizures. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Generalized Epilepsy</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3020"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3041 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3041">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0016045</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A non-metastasizing neoplasm arising from the fibrous tissue. It is characterized by the presence of spindle-shaped fibroblasts. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Fibroma</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3079 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3079">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0018799"/>
        <rdfs:comment xml:lang="en">A non-neoplastic or neoplastic disorder that affects the heart and/or the pericardium. Representative examples include endocarditis, pericarditis, atrial myxoma, cardiac myeloid sarcoma, and pericardial malignant mesothelioma. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Heart Disorder</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3086 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3086">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0018920</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A hemangioma characterized by the presence of cavernous vascular spaces. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Cavernous Hemangioma</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2931"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3095 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3095">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0019158</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Inflammation of the liver; usually from a viral infection, but sometimes from toxic agents. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Hepatitis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3096 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3096">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0019159</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Acute inflammation of the liver caused by the hepatitis A virus. It is highly contagious and usually contracted through close contact with an infected individual or their feces, contaminated food or water. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Hepatitis A Infection</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3098 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3098">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0019196"/>
        <rdfs:comment xml:lang="en">A viral infection caused by the hepatitis C virus. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Hepatitis C Infection</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3107 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3107">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0019621</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A neoplastic proliferation of Langerhans cells which contain Birbeck granules by ultrastructural examination. Three major overlapping syndromes are recognized: eosinophilic granuloma, Letterer-Siwe disease, and Hand-Schuller-Christian disease. The clinical course is generally related to the number of organs affected at presentation. (WHO, 2001) [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Langerhans Cell Histiocytosis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3114 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3114">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0020517</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An immune response that occurs following exposure to an innocuous antigen, but that does not require the presence of preformed antibodies to the antigen. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Hypersensitivity</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3117 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3117">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0020538</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Blood pressure that is abnormally high. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Hypertension</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3367"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3122 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3122">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0020546</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A severe, acute increase in blood pressure that may result in stroke or myocardial ischemia. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Hypertensive Crisis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2931"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3123 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3123">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0020550</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Overactivity of the thyroid gland resulting in overproduction of thyroid hormone and increased metabolic rate. Causes include diffuse hyperplasia of the thyroid gland (Graves&apos; disease), single nodule in the thyroid gland, and thyroiditis. The symptoms are related to the increased metabolic rate and include weight loss, fatigue, heat intolerance, excessive sweating, diarrhea, tachycardia, insomnia, muscle weakness, and tremor. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Hyperthyroidism</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C26893"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3124 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3124">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0020564"/>
        <rdfs:comment xml:lang="en">Abnormal enlargement of a body part or organ. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Hypertrophy</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3134 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3134">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0014511</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">The most common type of cutaneous cyst. It results from the proliferation of epidermal cells in a circumscribed space within the dermis. It is usually asymptomatic and presents as a firm, round nodule. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Epidermal Inclusion Cyst</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2978"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3171 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3171">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0023467"/>
        <rdfs:comment xml:lang="en">A clonal expansion of myeloid blasts in the bone marrow, blood or other tissues. The classification of acute myeloid leukemias (AMLs) encompasses four major categories: 1) AML with recurrent genetic abnormalities; 2) AML with multilineage dysplasia; 3) Therapy-related AML; 4) AML not otherwise specified. The required bone marrow or peripheral blood blast percentage for the diagnosis of AML is 20% (WHO classification). [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Acute Myeloid Leukemia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3199 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3199">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0024117"/>
        <rdfs:comment xml:lang="en">A chronic and progressive lung disorder characterized by the loss of elasticity of the bronchial tree and the air sacs, destruction of the air sacs wall, thickening of the bronchial wall, and mucous accumulation in the bronchial tree. The pathologic changes result in the disruption of the air flow in the bronchial airways. Signs and symptoms include shortness of breath, wheezing, productive cough, and chest tightness. The two main types of chronic obstructive pulmonary disease are chronic obstructive bronchitis and emphysema. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Chronic Obstructive Pulmonary Disease</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3211 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3211">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0024305"/>
        <rdfs:comment xml:lang="en">Distinct from Hodgkin lymphoma both morphologically and biologically, non-Hodgkin lymphoma (NHL) is characterized by the absence of Reed-Sternberg cells, can occur at any age, and usually presents as a localized or generalized lymphadenopathy associated with fever and weight loss. The clinical course varies according to the morphologic type. NHL is clinically classified as indolent, aggressive, or having a variable clinical course. NHL can be of B-or T-/NK-cell lineage. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Non-Hodgkin Lymphoma</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3243 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3243">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0026769</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A progressive autoimmune disorder affecting the central nervous system resulting in demyelination. Patients develop physical and cognitive impairments that correspond with the affected nerve fibers. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Multiple Sclerosis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C27586"/>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C99383"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3245 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3245">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0026946</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An infection caused by a fungus. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Fungal Infection</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3262 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3262">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0375111</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A benign or malignant tissue growth resulting from uncontrolled cell proliferation. Benign neoplastic cells resemble normal cells without exhibiting significant cytologic atypia, while malignant cells exhibit overt signs such as dysplastic features, atypical mitotic figures, necrosis, nuclear pleomorphism, and anaplasia. Representative examples of benign neoplasms include papillomas, cystadenomas, and lipomas; malignant neoplasms include carcinomas, sarcomas, lymphomas, and leukemias. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Neoplasm</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3283 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3283">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0028754</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Having a high amount of body fat (body mass index [BMI] of 30 or more). [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Obesity</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3367"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3298 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3298">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0029456</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A condition of reduced bone mass, with decreased cortical thickness and a decrease in the number and size of the trabeculae of cancellous bone (but normal chemical composition), resulting in increased fracture incidence. Osteoporosis is classified as primary (Type 1, postmenopausal osteoporosis; Type 2, age-associated osteoporosis; and idiopathic, which can affect juveniles, premenopausal women, and middle-aged men) and secondary osteoporosis (which results from an identifiable cause of bone mass loss). [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Osteoporosis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3329 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3329">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0032000</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A well-differentiated neuroendocrine neoplasm that arises from the adenohypophysial cells of the anterior lobe of the pituitary gland. The tumor can be hormonally functioning or not. It has a low frequency of metastatic spread. When metastatic, the term metastatic pituitary neuroendocrine tumor is endorsed instead of pituitary carcinoma. (WHO) [Definition Source: NCI] It has exact synonim: Pituitary Gland Adenoma.</rdfs:comment>
        <rdfs:label xml:lang="en">Pituitary Neuroendocrine Tumor</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3331 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3331">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0032227</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Increased amounts of fluid within the pleural cavity. Symptoms include shortness of breath, cough, and chest pain. It is usually caused by lung infections, congestive heart failure, pleural and lung tumors, connective tissue disorders, and trauma. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Pleural Effusion</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3367"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3333 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3333">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0032285</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An acute, acute and chronic, or chronic inflammation focally or diffusely affecting the lung parenchyma, due to infections (viruses, fungi, mycoplasma, or bacteria), treatment (e.g. radiation), or exposure (inhalation) to chemicals. Symptoms include cough, shortness of breath, fevers, chills, chest pain, headache, sweating, and weakness. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Pneumonia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3346 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3346">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0033860</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An autoimmune condition characterized by red, well-delineated plaques with silvery scales that are usually on the extensor surfaces and scalp. They can occasionally present with these manifestations: pustules; erythema and scaling in intertriginous areas, and erythroderma, that are often distributed on extensor surfaces and scalp. [Definition Source: NCI][attribution: NICHD]</rdfs:comment>
        <rdfs:label xml:lang="en">Psoriasis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3364 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3364">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0036690"/>
        <rdfs:comment xml:lang="en">The presence of pathogenic microorganisms in the blood stream causing a rapidly progressing systemic reaction that may lead to shock. Symptoms include fever, chills, tachycardia, and increased respiratory rate. It is a medical emergency that requires urgent medical attention. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Septicemia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3367 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3367">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C1285578</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Clinical, laboratory or molecular evidence, or absence of evidence of disease. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Finding</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3390 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3390">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0038454</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A sudden loss of neurological function secondary to hemorrhage or ischemia in the brain parenchyma due to a vascular event. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Stroke</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C27586"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3408 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3408">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0392386</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A laboratory test result indicating that there is an abnormally small number of platelets in the circulating blood. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Thrombocytopenia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3367"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3418 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3418">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0040558</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A parasitic disease contracted by the ingestion or fetal transmission of toxoplasma gondii. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Toxoplasmosis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3432 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3432">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0042109"/>
        <rdfs:comment xml:lang="en">A transient, itchy skin eruption characterized by wheals with pale interiors and red margins. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Urticaria</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3434 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3434">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0042133</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A benign smooth muscle neoplasm arising from the body of the uterus. It is characterized by the presence of spindle cells with cigar-shaped nuclei, interlacing fascicles, and a whorled pattern. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Uterine Corpus Leiomyoma</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C34360 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C34360">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0001627</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A genetic disorder characterized by defects in the synthesis of cortisol and/or aldosterone, resulting in hyperplasia of the adrenal cortical cells. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Congenital Adrenal Hyperplasia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C34373 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C34373">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0002736</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A neurodegenerative disorder characterized by progressive degeneration of the motor neurons of the central nervous system. It results in weakness and atrophy of the muscles which leads to an inability to initiate and control voluntary movements. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Amyotrophic Lateral Sclerosis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/37340000"/>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C4802"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C34379 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C34379">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0002881</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A congenital hemolytic anemia caused by defects of the erythrocyte membrane, enzyme deficiencies, or hemoglobinopathies. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Hereditary Hemolytic Anemia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2869"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C34423 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C34423">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0005586</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A disorder of the brain that causes unusual shifts in mood, energy, activity levels and the ability to carry out day-to-day tasks. Often these moods range and shift from periods of elation and energized behavior to those of hopelessness and depression. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Bipolar Disorder</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C92200"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C34486 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C34486">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0434579</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A closed dislocation of the shoulder [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Closed Dislocation of Shoulder</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C35020"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C34499 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C34499">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0009438</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">The presence of one or more stones in the common bile duct. They are composed either of cholesterol or, less commonly, calcium salts and bilirubin. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Common Bile Duct Stone</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3457 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3457">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0079731"/>
        <rdfs:comment xml:lang="en">The most common type of non-Hodgkin lymphoma. It includes the most frequently seen morphologic variants which are: diffuse large B-cell lymphoma, follicular lymphoma, small lymphocytic lymphoma and marginal zone B-cell lymphoma. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">B-Cell Non-Hodgkin Lymphoma</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3211"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C34607 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C34607">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0015702</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A condition associated with glucose-6-phosphate dehydrogenase deficiency, which is characterized by hemolysis. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Favism</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2869"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C34632 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C34632">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0017160</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An inflammatory disorder that affects the upper and lower gastrointestinal tract. Most commonly, this is attributed to viruses; however bacteria, parasites or adverse reactions can also be the culprit. Symptoms include acute diarrhea and vomiting. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Gastroenteritits</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C34660 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C34660">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0018674</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A traumatic injury to the head. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Head Trauma</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C36282"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C34661 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C34661">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0018681</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Pain in various parts of the head, not confined to the area of distribution of any nerve. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Headache</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3367"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C34685 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C34685">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0019270</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">The protrusion of part of an organ or fibroadipose tissue through an abnormal opening. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Hernia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3469 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3469">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0013312</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A superficial fibromatosis arising from the soft tissue of the palm. It is characterized by the presence of spindle-shaped fibroblasts, and an infiltrative growth pattern. It predominantly affects adult males. [Definition Source: NCI] It has exact synonim: Dupuytren Contracture; Palmar Fibromatosis; Dupuytren&apos;s Contracture.</rdfs:comment>
        <rdfs:label xml:lang="en">Palmar Fibromatosis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C34690 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C34690">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0019294</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">The protrusion of a sac-like structure containing fibroadipose tissue through an abnormal opening in the inguinal region. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Inguinal Hernia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C34685"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C34695 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C34695">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0019345</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A lesion caused by type 1 or type 2 herpes simplex virus, involving the oralfacial region. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Cold Sore</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C155871"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C34726 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C34726">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0021345</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A clinical syndrome of fever, sore throat, fatigue, and lymphadenopathy caused by infection with the Epstein-Barr virus. Subsequent physical findings may include hepatomegaly, palatal petechiae, jaundice, uvular edema, and splenomegaly. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Infectious Mononucleosis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C34733 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C34733">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0021847</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Ileus of the intestine in which there is no mechanical obstruction. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Intestinal Pseudo-Obstruction</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C34736 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C34736">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0022073</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Inflammation of the iris and the ciliary body. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Iridocyclitis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C34753 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C34753">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0022744"/>
        <rdfs:comment xml:lang="en">Trauma to the knee. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Knee Injury</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3671"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3478 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3478">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0085580</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Hypertension that presents without an identifiable cause. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Essential Hypertension</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3117"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C34786 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C34786">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0023976</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A ventricular arrhythmia characterized by a long QT interval, and accompanied by syncopal episodes sometimes leading to sudden death due to paroxysmal ventricular arrhythmia. This arrhythmia is associated with a prolongation of repolarization following depolarization of the cardiac ventricles. The prolongation of the Q-T interval combined with torsades de pointes manifests as several different forms; some may be acquired or congenital; some may lead to serious arrhythmia and sudden cardiac death. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Long QT Syndrome</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C34876 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C34876">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0029410"/>
        <rdfs:comment xml:lang="en">Osteoarthritis of the hip joint. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Hip Osteoarthritis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2883"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C34889 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C34889">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0030312</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A finding of low numbers of red and white blood cells and platelets in the peripheral blood. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Pancytopenia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3367"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C34890 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C34890">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0030319"/>
        <rdfs:comment xml:lang="en">An anxiety disorder characterized by multiple unexpected panic attacks with persistent concern of recurring attacks. Panic disorder may or may not be accompanied by agoraphobia. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Panic Disorder</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2878"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C34911 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C34911">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0030824</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An allergy to Penicillin. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Penicillin Allergy</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C112208"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C34922 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C34922">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0031212</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A diverse category of psychiatric disorders characterized by behavior that deviates markedly from the expectations of the individual&apos;s culture; this pattern of deviation is pervasive and inflexible and is stable over time. The behavioral pattern negatively interferes with relationships and work. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Personality Disorder</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2893"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C34932 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C34932">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C1761609</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Inflammation of the lungs due to the inhalation of solid or liquid material. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Aspiration Pneumonitis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C34935 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C34935">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0032650</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Swelling and protrusion of the gastrocnemius-semimembranosus bursa due to an accumulation of synovial fluid. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Baker Cyst</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2978"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C34995 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C34995">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0036202</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An idiopathic inflammatory disorder characterized by the formation of non-necrotizing epithelioid granulomas which contain giant cells. It usually affects the lungs, lymph nodes, liver, and skin. Cardiac involvement is also possible. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Sarcoidosis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C34997 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C34997">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0036205</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Sarcoidosis affecting the lung parenchyma. It is characterized by the presence of non-necrotizing granulomas in the lung tissues. It is manifested with dyspnea, cough, fever, night sweats, fatigue, and weight loss. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Pulmonary Sarcoidosis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C34995"/>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C98541"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C35020 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C35020">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0037005</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A dislocation of the shoulder joint. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Shoulder Dislocation</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3671"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C35024 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C35024">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0037199</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An acute or chronic inflammatory process affecting the mucous membranes of any sinus cavity. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Sinusitis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C35038 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C35038">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0038160</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Infection by Staphylococcus. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Staphylococcal Infection</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C35053 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C35053">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0039070</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A spontaneous loss of consciousness caused by insufficient blood supply to the brain. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Syncope</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3367"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C35069 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C35069">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0039730</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An inherited blood disorder characterized by a decreased synthesis of one of the polypeptide chains that form hemoglobin. Anemia results from this abnormal hemoglobin formation. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Thalassemia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3510 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3510">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0151779</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A primary melanoma arising from atypical melanocytes in the skin. Precursor lesions include acquired and congenital melanocytic nevi, and dysplastic nevi. Several histologic variants have been recognized, including superficial spreading melanoma, acral lentiginous melanoma, nodular melanoma, and lentigo maligna melanoma. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Cutaneous Melanoma</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2920"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C35131 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C35131">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0042998</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An inflammatory pathologic process that affects the vulva and the vagina. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Vulvovaginitis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C35204 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C35204">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0155626</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Necrosis of the myocardium, as a result of interruption of the blood supply to the area. It is characterized by a severe and rapid onset of symptoms that may include chest pain, often radiating to the left arm and left side of the neck, dyspnea, sweating, and palpitations. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Acute Myocardial Infarction</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C35350 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C35350">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0435750</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A traumatic break in one of the bones in the rib cage that does not involve a break in the adjacent skin. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Closed Fracture of Rib</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3671"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C35475 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C35475">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0518988</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An infectious process that affects a tooth. It is characterized by localized periapical or periodontal collection of pus. It presents with pain and swelling of the gums and/or cheek. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Tooth Abscess</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C35548 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C35548">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C1136085</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An abnormal laboratory test result indicating the presence of monoclonal immunoglobulins in the blood or urine. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Monoclonal Gammopathy</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3367"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C36282 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C36282">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0575141</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Symptoms, physical examination results, and/or laboratory test results related to the head and neck. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Head and Neck Finding</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3367"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3671 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3671">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C3263723</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Damage inflicted on the body as the direct or indirect result of an external force, with or without disruption of structural continuity. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Injury</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3367"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C37920 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C37920">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0428977</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An abnormally slow heart rate. Thresholds for different age, gender, and patient populations exist. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Bradycardia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2881"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C37967 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C37967">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C1522133</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A laboratory test result indicating an increased amount of cholesterol in the blood. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Hypercholesterolemia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3367"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C38012 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C38012">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0033687</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">The presence of abnormal amounts of protein in the urine. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Proteinuria</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3367"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C38057 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C38057">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0042571</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A feeling of movement, a sensation as if the external world were revolving around the patient (objective vertigo) or as if he himself were revolving in space (subjective vertigo). Vertigo is medically distinct from dizziness, lightheadedness, and unsteadiness. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Vertigo</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3367"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3852 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3852">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0236075"/>
        <rdfs:comment xml:lang="en">Any of the mental or physical manifestations that accompany perimenopause and menopause. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Menopausal Symptom</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C4876"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3884 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C3884">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0241060</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A cystic lesion located in the skin. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Skin Cyst</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2978"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C4017 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C4017">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C1527349"/>
        <rdfs:comment xml:lang="en">A breast carcinoma arising from the ducts. While ductal carcinomas can arise at other sites, this term is universally used to refer to carcinomas of the breast. Ductal carcinomas account for about two thirds of all breast cancers. Two types of ductal carcinomas have been described: ductal carcinoma in situ (DCIS) and invasive breast carcinoma of no special type. The latter often spreads to the axillary lymph nodes and other anatomic sites. The two forms of ductal carcinoma often coexist. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Breast Ductal Carcinoma</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C4872"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C40197 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C40197">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C1512433</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A precancerous neoplastic process that affects the cervical squamous epithelium. It is usually associated with human papillomavirus infection. It is classified as cervical squamous intraepithelial neoplasia 2 when there is nuclear atypia in both the upper and lower epithelial layers, mitotic figures are confined to the basal two-thirds of the epithelium, and maturation is present in the upper half of the epithelium. It is classified as cervical squamous intraepithelial neoplasia 3 when there is nuclear atypia and mitotic figures throughout the entire thickness of the epithelium, and maturation is absent or confined to the upper third of the epithelium. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">High Grade Cervical Squamous Intraepithelial Neoplasia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C4345 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C4345">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C1292778</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A clonal hematopoietic stem cell disorder, characterized by proliferation in the bone marrow of one or more of the myeloid (i.e., granulocytic, erythroid, megakaryocytic, and mast cell) lineages. It is primarily a neoplasm of adults. (WHO 2008) [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Myeloproliferative Neoplasm</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3262"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C4349 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C4349">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0338106</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An adenocarcinoma arising from the colon. It is more frequently seen in populations with a Western type diet and in patients with a history of chronic inflammatory bowel disease. Signs and symptoms include intestinal bleeding, anemia, and change in bowel habits. According to the degree of cellular differentiation, colonic adenocarcinomas are divided into well, moderately, and poorly differentiated. Histologic variants include mucinous adenocarcinoma, signet ring cell carcinoma, medullary carcinoma, serrated adenocarcinoma, cribriform comedo-type adenocarcinoma, and micropapillary adenocarcinoma. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Colon Adenocarcinoma</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2852"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C4786 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C4786">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0497327</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Loss of intellectual abilities interfering with an individual&apos;s social and occupational functions. Causes include Alzheimer&apos;s disease, brain injuries, brain tumors, and vascular disorders. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Dementia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C4802"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C4802 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C4802">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0270715</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A disorder of the central nervous system characterized by gradual and progressive loss of neural tissue and neurologic function. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Central Nervous System Degenerative Disorder</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C27586"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C4847 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C4847">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C1302363"/>
        <rdfs:comment xml:lang="en">A morphologic finding indicating the presence of dysplastic glandular epithelial cells in the colonic mucosa. There is no evidence of invasion. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Colon Dysplasia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C4872 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C4872">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0678222</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A carcinoma arising from the breast, most commonly the terminal ductal-lobular unit. It is the most common malignant tumor in females. Risk factors include country of birth, family history, menstrual and reproductive history, fibrocystic disease and epithelial hyperplasia, exogenous estrogens, contraceptive agents, and ionizing radiation. The vast majority of breast carcinomas are adenocarcinomas (ductal or lobular). Breast carcinoma spreads by direct invasion, by the lymphatic route, and by the blood vessel route. The most common site of lymph node involvement is the axilla. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Breast Carcinoma</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2916"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C4876 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C4876">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C1457887</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Subjective evidence of disease perceived by the patient. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Symptom</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C100104"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C48824 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C48824">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/AnatomicalSite"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0024094</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">The part of the spine in the lower back that consists of the lumbar region and the sacrum. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Lumbosacral Region</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C4914 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C4914">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0699893</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A carcinoma that arises from the skin. Representative examples are basal cell carcinoma and squamous cell carcinoma. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Skin Carcinoma</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2916"/>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2920"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C49343 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C49343">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0149871</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A blood clot in a deep vein, predominantly in the lower extremity, but may include the pelvis or upper extremity. [Definition Source: NCI][attribution: NICHD]</rdfs:comment>
        <rdfs:label xml:lang="en">Deep Vein Thrombosis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2931"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C50466 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C50466">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0004238</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A disorder characterized by an electrocardiographic finding of a supraventricular arrhythmia characterized by the replacement of consistent P waves by rapid oscillations or fibrillatory waves that vary in size, shape and timing and are accompanied by an irregular ventricular response. (CDISC) [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Atrial Fibrillation</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2881"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C50530 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C50530">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0011880</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">The metabolic condition resulted from uncontrolled diabetes mellitus, in which the shift of acid-base status of the body toward the acid side because of loss of base or retention of acids other than carbonic acid is accompanied by the accumulation of ketone bodies in body tissues and fluids. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Diabetic Ketoacidosis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3367"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C50577 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C50577">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0018801</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Inability of the heart to pump blood at an adequate rate to meet tissue metabolic requirements. Clinical symptoms of heart failure include: unusual dyspnea on light exertion, recurrent dyspnea occurring in the supine position, fluid retention or rales, jugular venous distension, pulmonary edema on physical exam, or pulmonary edema on chest x-ray presumed to be cardiac dysfunction. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Heart Failure</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C50579 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C50579">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0018944"/>
        <rdfs:comment xml:lang="en">A localized collection of blood, usually clotted, in an organ, space, or tissue, due to a break in the wall of a blood vessel. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Hematoma</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3367"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C50643 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C50643">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0270697</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Headache in erect position, after lumbar puncture; due to lowering of intracranial pressure by leakage of cerebrospinal fluid through the needle tract. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Lumbar Puncture Headache</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C34661"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C50667 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C50667">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C1709158</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An abnormality that affects hearing within the first month after birth. It may or may not result in hearing loss. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Neonatal Hearing Impairment</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C50713 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C50713">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0034065</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">The obstruction of the pulmonary artery or one of its branches by an embolus, sometimes associated with infarction of the lung. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Pulmonary Embolism</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2931"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C50781 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C50781">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0007787</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A brief attack (from a few minutes to an hour) of cerebral dysfunction of vascular origin, with no persistent neurological deficit. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Transient Ischemic Attack</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C27586"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C51224 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C51224">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0004239</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A disorder characterized by an electrocardiographic finding of an organized, regular atrial rhythm with atrial rate of 240-340 beats per minute. Multiple P waves typically appear in the inferior leads in a saw tooth-like pattern between the QRS complexes. (CDISC) [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Atrial Flutter</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2881"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C51447 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C51447">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0035229"/>
        <rdfs:comment xml:lang="en">Impairment of gas exchange within the lungs secondary to a disease process, neoplasm, or trauma, possibly resulting in hypoxia, hypercarbia, or both, but not requiring intubation or mechanical ventilation. Patients are normally managed with pharmaceutical therapy, supplemental oxygen, or both. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Pulmonary Insufficiency</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C51605 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C51605">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/SurgicalType"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0041271"/>
        <rdfs:comment xml:lang="en">Surgery to remove part or all of the fallopian tube(s). [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Salpingectomy</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C51750 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C51750">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/SurgicalType"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0161872"/>
        <rdfs:comment xml:lang="en">Total or partial excision of the turbinates. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Turbinectomy</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C53458 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C53458">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0311392</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Objective evidence of disease perceptible to the examining healthcare provider. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Sign</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C100104"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C54578 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C54578">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/Gene"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C1420306</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">This gene plays a role in the detoxification of superoxide radicals in the cytosol. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">SOD1 Gene</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C55098 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C55098">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C1557189</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An enzyme that is normally present in liver and heart cells. SGPT is released into blood when the liver or heart is damaged. The blood SGPT levels are thus elevated with liver damage (for example, from viral hepatitis) or with an insult to the heart (for example, from a heart attack). Some medications can also raise SGPT levels. Also called alanine aminotransferase (ALT). [Definition Source: RxList] Common Terminology Criteria for Adverse Events (CTCAE) [Definition Source: U.s. Department of Health and Human Services]</rdfs:comment>
        <rdfs:label xml:lang="en">Serum Glutamic Pyruvic Transaminase, CTCAE</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3367"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C60785 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C60785">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0149889</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A pathologic tract that connects an opening in the anal canal to the perianal skin. In the vast majority of cases there is a history of perianal abscess. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Anorectal Fistula</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C60989 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C60989">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0026896</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A chronic autoimmune neuromuscular disorder characterized by skeletal muscle weakness. It is caused by the blockage of the acetylcholine receptors at the neuromuscular junction. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Myasthenia Gravis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C99383"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C61277 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C61277">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0003872</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Joint inflammation associated with psoriasis. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Psoriatic Arthritis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2883"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C61443 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C61443">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0002453</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">The absence of menses in a woman who has achieved reproductive age. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Amenorrhea</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C61595 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C61595">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/PharmacologicSubstance"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0023791</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A naturally occurring micronutrient, synthesized in small amounts by plants and animals (including humans), with antioxidant and potential chemopreventive activities. Alpha-lipoic acid acts as a free radical scavenger and assists in repairing oxidative damage and regenerates endogenous antioxidants, including vitamins C and E and glutathione. This agent also promotes glutathione synthesis. In addition, alpha-lipoic acid exerts metal chelating capacities and functions as a cofactor in various mitochondrial enzyme complexes involved in the decarboxylation of alpha-keto acids. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Alpha-Lipoic Acid</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C1505"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C6727 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C6727">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0162678</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An autosomal dominant hereditary neoplastic syndrome. Two distinct clinicopathological entities are recognized: neurofibromatosis type 1 and neurofibromatosis type 2. Neurofibromatosis type 1 is associated with the presence of cafe-au-lait cutaneous lesions, multiple neurofibromas, malignant peripheral nerve sheath tumors, optic nerve gliomas, and bone lesions. Neurofibromatosis type 2 is associated with the presence of schwannomas, meningiomas, and gliomas. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Neurofibromatosis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C69313 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C69313">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/AnatomicalSite"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0728985</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">The set of vertebrae immediately caudal to the skull. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Cervical Spine</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C69314 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C69314">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/AnatomicalSite"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C3887615</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Those vertebrae between the ribs and the pelvis, L1-L5 in man. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Lumbar Spine</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C69315 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C69315">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/AnatomicalSite"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0581269</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">The vertebrae of the thoracic spine, numbered one through twelve in man. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Thoracic Spine</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C70428 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C70428">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0036749</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Inflammation of a serous membrane. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Serositis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C71079 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C71079">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0019360</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A common dermal and neurologic disorder caused by reactivation of the varicella-zoster virus that has remained dormant within dorsal root ganglia, often for decades, after the patient&apos;s initial exposure to the virus in the form of varicella (chickenpox). It is characterized by severe neuralgic pain along the distribution of the affected nerve and crops of clustered vesicles over the area. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Herpes Zoster</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C71398 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C71398">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/KinshipType"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0337573</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A male grandchild. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Grandson</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C19811"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C71399 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C71399">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/KinshipType"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0337561"/>
        <rdfs:comment xml:lang="en">A female grandchild. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Granddaughter</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C19811"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C71408 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C71408">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/KinshipType"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0337578</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A daughter of your brother or sister. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Niece</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C19811"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C71409 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C71409">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/KinshipType"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0337579</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A son of your brother or sister. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Nephew</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C19811"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C71410 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C71410">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/KinshipType"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0337580"/>
        <rdfs:comment xml:lang="en">A child of your aunt or uncle or their descendents. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Cousin</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C71411 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C71411">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/KinshipType"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0337583</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A child of your aunt or uncle. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">First Cousin</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C100808"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C7405 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C7405">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0017154</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Atrophic gastritis that is persistent and long-standing. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Chronic Atropic Gastritis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C26780"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C7510 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C7510">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0007115</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A primary or metastatic malignant neoplasm affecting the thyroid gland. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Malignant Thyroid Gland Neoplasm</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C26893"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C7570 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C7570">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0027962</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A neoplasm composed of melanocytes that usually appears as a dark spot on the skin. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Melanocytic Nevus</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3262"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C78302 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C78302">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0392171</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Complaints describing a pattern similar to influenza, which may include one or more of the following symptoms: fever, chills, muscle or body aches, cough, sore throat, rhinitis, or fatigue. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Flu-Like Symptoms</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C4876"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C78576 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C78576">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0033975"/>
        <rdfs:comment xml:lang="en">A mental disorder characterized by personality change, impaired functioning, and loss of touch with reality. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Psychosis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2893"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C78593 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C78593">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0152169</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Paroxysmal and severe flank pain radiating to the inguinal area. It is caused by the passage of a kidney stone through the ureter. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Renal Colic</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C79532 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C79532">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C2607914</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Inflammation of the nasal mucous membranes caused by an IgE-mediated response to external allergens. The inflammation may also involve the mucous membranes of the sinuses, eyes, middle ear, and pharynx. Symptoms include sneezing, nasal congestion, rhinorrhea, and itching. It may lead to fatigue, drowsiness, and malaise thus causing impairment of the quality of life. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Allergic Rhinitis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C79593 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C79593">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0015371</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A movement disorder caused by defects in the basal ganglia. The clinical manifestations include changes in the muscle tone, dyskinesia, and akinesia. Causes include vascular disorders, degenerative disorders, and antipsychotic drugs. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Extrapyramidal Disorder</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C4802"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C80020 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C80020">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/Gene"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C1420588</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">This gene is involved in transcription and mRNA splicing. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">TARDBP Gene</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C80310 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C80310">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C2698259</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A monoclonal expansion of B-lymphocytes with or without the characteristic immunophenotype of chronic lymphocytic leukemia. It precedes virtually all cases of chronic lymphocytic leukemia/small lymphocytic lymphoma. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Monoclonal B_Cell Lymphocytosis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C80385 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C80385">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0242339</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A lipoprotein metabolism disorder characterized by decreased levels of high-density lipoproteins, or elevated levels of plasma cholesterol, low-density lipoproteins and/or triglycerides. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Dyslipidemia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3367"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C8366 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C8366">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0878500"/>
        <rdfs:comment xml:lang="en">A precancerous neoplastic process that affects the squamous, glandular, or transitional cell epithelium without evidence of invasion. According to the degree of nuclear atypia, number of mitotic figures, and presence of architectural distortion, it is classified as low grade (mild dysplasia) or high grade (moderate or severe dysplasia). [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Intraepithelial Neoplasia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3262"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C84484 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C84484">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0162316</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Anemia caused by low iron intake, inefficient iron absorption in the gastrointestinal tract, or chronic blood loss. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Iron-Deficiency Anemia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2869"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C84505 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C84505">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0039685"/>
        <rdfs:comment xml:lang="en">A congenital heart disorder characterized by the presence of the following four abnormalities: ventricular septal defect, pulmonary stenosis, overriding aorta, and right ventricular hypertrophy. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Tetralogy of Fallot</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C84601 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C84601">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0242644</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A disorder caused by a spinal injury leading to an incomplete spinal lesion. Patients develop paralysis, ataxia and loss of sensation. Causes include spinal cord tumors, spinal traumas, ischemia, and inflammatory processes affecting the spine. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Brown-Sequard Syndrome</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C84705 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C84705">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0015523</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A rare inherited bleeding disorder caused by deficiency of coagulation factor XI. It may be asymptomatic or manifest with bleeding. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Hereditary Factor XI Deficiency</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C84719 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C84719">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0338451</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A syndrome caused by progressive degeneration of the frontal or temporal lobes of the brain. It is manifested with personality changes and deterioration of the language skills. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Frontotemporal Dementia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C4786"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C84770 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C84770">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0598608"/>
        <rdfs:comment xml:lang="en">A serious metabolic condition caused by mutations in the MTHFR gene, medications, or nutritional deficiency. It results in increased levels of homocysteine in the blood. Patients with this condition are at an increased risk for recurrent blood clots formation and cardiovascular accidents. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Hyperhomocysteinemia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C84776 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C84776">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0020757</dcterms:conformsTo>
        <rdfs:comment>A group of inherited or acquired skin disorders characterized by a dry, thickened, and scaly skin. The skin changes range from mild to severe. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label>Ichthyosis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C8486 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C8486">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0677721</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Ann Arbor Classification: Stage IV: Diffuse or disseminated involvement of one or more extralymphatic organs, with or without associated lymph node involvement; or isolated extralymphatic organ involvement in the absence of adjacent regional lymph node involvement, but in conjunction with disease in distant site(s); or any involvement of the liver or bone marrow, lungs (other than by direct extension from another site), or cerebrospinal fluid. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Ann Arbor Stage IV Mantle Cell Lymphoma</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C84950 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C84950">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0029134</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A disorder characterized by inflammation of the optic nerve. Causes include autoimmune disorders, infections, toxins, drugs, and multiple sclerosis. It may manifest with acute loss of vision and pain. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Optic Neuritis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C85024 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C85024">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0282513</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A rare neurologic progressive disorder characterized by impairment of the language and speech abilities. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Primary Progressive Aphasia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C85026 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C85026">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0030442"/>
        <rdfs:comment xml:lang="en">A progressive motor neuron disorder affecting the muscles which are innervated by cranial nerves of the lower brain stem. Signs and symptoms include difficulties in chewing and swallowing, dysarthria, and weakness of the facial muscles and tongue. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Progressive Bulbar Palsy</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/37340000"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C85027 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C85027">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0917981"/>
        <rdfs:comment xml:lang="en">A rare, milder form of amyotrophic lateral sclerosis. It is characterized by a slowly progressive clinical course. Signs and symptoms include muscle weakness, atrophy, and fasciculation. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Progressive Muscular Atrophy</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C34373"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C8509 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C8509">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0677930</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A tumor at the original site of origin. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Primary Neoplasm</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3262"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C85233 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C85233">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C1839259</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A rare, slowly progressive degenerative disorder affecting males. It is caused by mutations in the androgen receptor (AR) gene. It is characterized by bulbar and limb muscle weakness and atrophy, and gynecomastia. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Spinal and Bulbar Muscular Atrophy, X-linked 1</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C8668 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C8668">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0854831</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Ann Arbor Classification: Stage IV: Diffuse or disseminated involvement of one or more extralymphatic organs, with or without associated lymph node involvement; or isolated extralymphatic organ involvement in the absence of adjacent regional lymph node involvement, but in conjunction with disease in distant site(s); or any involvement of the liver or bone marrow, lungs (other than by direct extension from another site), or cerebrospinal fluid. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Ann Arbor Stage IV T-Cell Non-Hodgkin Lymphoma</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C87069 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C87069">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0008925</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A congenital abnormality consisting of a fissure in the midline of the hard and/or soft palate; it is the result of the failure of the two sides of the palate to fuse during embryonic development. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Cleft Palate</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C87497 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C87497">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0016053</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A chronic disorder of unknown etiology characterized by pain, stiffness, and tenderness in the muscles of neck, shoulders, back, hips, arms, and legs. Other signs and symptoms include headaches, fatigue, sleep disturbances, and painful menstruation. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Fibromyalgia</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C89715 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C89715">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0149931</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A common, severe type of vascular headache often associated with increased sympathetic activity, resulting in nausea, vomiting, and light sensitivity. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Migraine</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C9039 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C9039">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0302592"/>
        <rdfs:comment xml:lang="en">A carcinoma arising from either the exocervical squamous epithelium or the endocervical glandular epithelium. The major histologic types of cervical carcinoma are squamous cell carcinoma and adenocarcinoma. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Cervical Carcinoma</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C27020"/>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2916"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C9175 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C9175">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0021843</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Blockage of the normal flow of the intestinal contents within the bowel. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Bowel Obstruction</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3367"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C91852 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C91852">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/Gene"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C1414860</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">This gene is involved in gene expression, genomic integrity and RNA processing. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">FUS Gene</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C92200 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C92200">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0525045</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A category of psychiatric disorders which have as their most predominant feature a disturbance in mood. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Mood Disorder</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2893"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C9242 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C9242">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0007102</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A primary or metastatic malignant neoplasm that affects the colon. Representative examples include carcinoma, lymphoma, and sarcoma. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Malignant Colon Neoplasm</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C92560 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C92560">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C4317146</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">The backward flow of stomach acid contents into the esophagus (the tube that connects the mouth to the stomach). [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Gastroesophageal Reflux</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3367"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C93040 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C93040">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0001973</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Physical and psychological dependence on alcohol. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Alcohol Dependance</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C9305 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C9305">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0006826</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A tumor composed of atypical neoplastic, often pleomorphic cells that invade other tissues. Malignant neoplasms often metastasize to distant anatomic sites and may recur after excision. The most common malignant neoplasms are carcinomas, Hodgkin and non-Hodgkin lymphomas, leukemias, melanomas, and sarcomas. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Malignant Neoplasm</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3262"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C9384 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C9384">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C1378703"/>
        <rdfs:comment xml:lang="en">A carcinoma arising from the epithelium of the renal parenchyma or the renal pelvis. The majority are renal cell carcinomas. Kidney carcinomas usually affect middle aged and elderly adults. Hematuria, abdominal pain, and a palpable mass are common symptoms. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Kidney Carcinoma</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2916"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C94575 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C94575">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0036285</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A streptococcal infection, mainly occurring among children, that is characterized by a red skin rash, sore throat, and fever. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Scarlet Fever</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C94676 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C94676">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C2986622"/>
        <rdfs:comment xml:lang="en">A neoplastic process in the cervix characterized by morphologic features of both moderate and severe intraepithelial neoplasia. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Cervical Intraepithelial Neoplasia Grade 2/3</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C27020"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C96569 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C96569">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/KinshipType"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C3272868</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A female relative who is a sibling of either of the biological parents, and who share a common ancestor. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Aunt</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C19811"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C96573 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C96573">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/KinshipType"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0337477</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A male relative who is the biological father of either the biological mother or the biological father. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Grandfather</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C19811"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C96574 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C96574">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/KinshipType"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0337476</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A female relative who is the biological mother of either the biological mother or the biological father. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Grandmother</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C19811"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C96575 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C96575">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/KinshipType"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C3272872</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A female relative who is a sibling of the biological mother, and who both share a common ancestor. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Maternal Aunt</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C96569"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C96579 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C96579">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/KinshipType"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C3272876"/>
        <rdfs:comment xml:lang="en">A male relative who is a sibling of the biological mother, and who both share a common ancestor. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Maternal Uncle</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C96587"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C96581 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C96581">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/KinshipType"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C3272877</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A female relative who is a sibling of the biological father, and who both share a common ancestor. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Paternal Aunt</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C96569"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C96585 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C96585">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/KinshipType"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C3272881"/>
        <rdfs:comment xml:lang="en">A male relative who is a sibling of the biological father, and who both share a common ancestor. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Paternal Uncle</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C96587"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C96587 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C96587">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/KinshipType"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C3272882"/>
        <rdfs:comment xml:lang="en">A male relative who is a sibling of either of the biological parents, and who share a common ancestor. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Uncle</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C19811"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C97132 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C97132">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0008049</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A contagious childhood disorder caused by the varicella zoster virus. It is transmitted via respiratory secretions and contact with chickenpox blister contents. It presents with a vesicular skin rash, usually associated with fever, headache, and myalgias. The pruritic fluid-filled vesicles occur 10-21 days after exposure and last for 3-4 days. An additional 3-4 days of malaise follows before the affected individual feels better. An individual is contagious 1-2 days prior to the appearance of the blisters until all blisters are crusted over. Generally, healthy individuals recover without complications. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Chicken Pox</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C97142 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C97142">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0001361</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An acute inflammation of the tonsils caused by viruses or bacteria. Signs and symptoms include fever, enlargement of the tonsils, difficulty swallowing, and enlargement of the regional lymph nodes. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Acute Tonsillitis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C98541 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C98541">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0746102</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A persistent non-neoplastic disorder of the lungs. Representative examples include: chronic obstructive pulmonary disease, chronic bronchitis, emphysema, pulmonary fibrosis, pneumoconiosis, asbestosis, atelectasis, radiation induced pneumonitis, and radiation fibrosis. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Chronic Lung Disorder</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C98967 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C98967">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0022738</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A rare congenital syndrome characterized by the fusion of the vertebrae in the cervical spine. Patients present with a short neck and restricted mobility of the upper spine. Other signs and symptoms include scoliosis, spina bifida, cleft palate, and rib malformations. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Klippel-Feil Syndrome</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2991"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C99039 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C99039">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0034628</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Traumatic or pathological injury to the radius bone in which the continuity of the bone is broken. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Radius Fracture</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3671"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C99083 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C99083">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0040185</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Traumatic or pathological injury to the tibia in which the continuity of the bone is broken. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Tibia Fracture</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3671"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C99383 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C99383">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0751871</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A disorder characterized by the degeneration of the nervous system due to autoimmunity. Representative examples include multiple sclerosis, Guillain-Barre syndrome, and myasthenia gravis. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Autoimmune Nervous System Disorder</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2889"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000005 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/OAE_0000005">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/AdverseDrugReaction"/>
        <rdfs:comment xml:lang="en">An adverse event that occurs after a drug administration. [Definition Source: OAE]</rdfs:comment>
        <rdfs:label xml:lang="en">Adverse Drug Event</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000220 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/OAE_0000220">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/AdverseDrugReaction"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0852908</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An errored drug administration where a patient is administered with an ineffective drug. [Definition Source: OAE]</rdfs:comment>
        <rdfs:label xml:lang="en">Administration of Ineffective Drug</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/OAE_0000005"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000890 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/OAE_0000890">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/AdverseDrugReaction"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0013182</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A hypersensitivity AE that has an outcome of allergic reactions to certain drugs. [Definition Source: OAE]</rdfs:comment>
        <rdfs:label xml:lang="en">Drug Hypersensitivity AE</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/OAE_0000005"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000891 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/OAE_0000891">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/AdverseDrugReaction"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0277585</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A drug AE that has an outcome of lower threshold to the normal pharmacologic action of a drug. [Definition Source: OAE]</rdfs:comment>
        <rdfs:label xml:lang="en">Drug Intolerance AE</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/OAE_0000005"/>
    </owl:NamedIndividual>
    


