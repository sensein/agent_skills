        <rdfs:label xml:lang="en">Head</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C12429 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C12429">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
