        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0005953</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">The tissue occupying the spaces of bone. It consists of blood vessel sinuses and a network of hematopoietic cells which give rise to the red cells, white cells, and megakaryocytes. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Bone Marrow</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C12439 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C12439">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/AnatomicalSite"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0006104</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An organ composed of grey and white matter containing billions of neurons that is the center for intelligence and reasoning. It is protected by the bony cranium. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Brain</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C12441 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C12441">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/AnatomicalSite"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0006121</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Three sections, the midbrain, pons and medulla oblongata, that are located at the base of the brain. The brain stem regulates the central nervous system, and is vital as a conduit for motor and sensory innervations. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Brain Stem</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C12445 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C12445">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/AnatomicalSite"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0007765</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">The portion of the brain located at the base of the skull that is responsible for balance, equilibrium and movement. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Cerebellum</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C12464 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C12464">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/AnatomicalSite"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0037925</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">The elongated, approximately cylindrical part of the central nervous system of vertebrates that lies in the vertebral canal and from which the spinal nerves emerge. [Definition Source: NCI][attribution: On-line Medical Dictionary]</rdfs:comment>
        <rdfs:label xml:lang="en">Spinal Cord</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C12512 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C12512">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/AnatomicalSite"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C1522407</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">The part of the brain that is located superior to the tentorium cerebelli. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Supratentorial Brain</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C12664 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C12664">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/AnatomicalSite"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0230168</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">The cavity located between the lungs and pelvis. It contains the lower esophagus, stomach, pancreas, intestines, liver, gallbladder and spleen. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Abdomen</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C12671 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C12671">
