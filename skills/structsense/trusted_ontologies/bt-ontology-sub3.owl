<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/brainteaser/ontology/schema/"
     xml:base="https://w3id.org/brainteaser/ontology/schema/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ns="http://creativecommons.org/ns#"
     xmlns:ATC="http://purl.bioontology.org/ontology/ATC/"
     xmlns:OAE="http://purl.obolibrary.org/obo/OAE_"
     xmlns:bto="https://w3id.org/brainteaser/ontology/schema/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:ESCO="http://data.europa.eu/esco/isco/"
     xmlns:NCIT="http://purl.obolibrary.org/obo/NCIT_"
     xmlns:UMLS="https://uts.nlm.nih.gov/uts/umls/concept/"
     xmlns:adms="http://www.w3.org/ns/adms#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:om-1="http://www.wurvoc.org/vocabularies/om-1.8/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:time="http://www.w3.org/2006/time#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:SNOMEDCT="http://purl.bioontology.org/ontology/SNOMEDCT/"
     xmlns:Pollution="http://ontology.eil.utoronto.ca/GCI/Environment/Pollution.owl#">
    <owl:Ontology rdf:about="https://w3id.org/brainteaser/ontology/schema/">
        <owl:versionIRI rdf:resource="https://w3id.org/brainteaser/ontology/3.0/schema/"/>
        <owl:imports rdf:resource="http://ontology.eil.utoronto.ca/GCI/Environment/Pollution.owl"/>
        <owl:imports rdf:resource="http://www.w3.org/TR/skos-reference/skos-owl1-dl.rdf"/>
        <dc:title xml:lang="en">The Brainteaser Ontology</dc:title>
        <dcterms:contributor rdf:resource="https://brainteaser.health/partners/"/>
        <dcterms:creator rdf:resource="https://orcid.org/0000-0001-9219-6239"/>
        <dcterms:creator rdf:resource="https://orcid.org/0000-0001-9709-6392"/>
        <dcterms:creator rdf:resource="https://orcid.org/0000-0002-0676-682X"/>
        <dcterms:creator rdf:resource="https://orcid.org/0000-0002-5070-2049"/>
        <dcterms:creator rdf:resource="https://orcid.org/0000-0003-0362-5893"/>
        <dcterms:creator rdf:resource="https://orcid.org/0000-0003-4970-4554"/>
        <dcterms:description xml:lang="en">The BRAINTEASER Ontology (BO) jointly models both Amyotrophic Lateral Sclerosis (ALS) and Multiple Sclerosis (MS).

BO serves multiple purposes:

• to provide a unified and comprehensive conceptual view about ALS and MS, which are typically dealt with separately, allowing us to coherently integrate the data coming from the different medical partners in the project;
• to seamlessly represent both retrospective data and prospective data, produced during the lifetime of BRAINTEASER;
• to allow for sharing and re-using the BRAINTEASER datasets according to Open Science and FAIR principles.</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by-sa/4.0/"/>
        <dcterms:publisher rdf:resource="https://brainteaser.health/"/>
        <rdfs:comment xml:lang="en">The BRAINTEASER Ontology (BO) jointly models both Amyotrophic Lateral Sclerosis (ALS) and Multiple Sclerosis (MS).</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/elements/1.1/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- http://purl.org/dc/terms/conformsTo -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/conformsTo"/>
    


    <!-- http://purl.org/dc/terms/contributor -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/contributor"/>
    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/publisher -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#broaderTransitive -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#broaderTransitive"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#note -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#note"/>
    


    <!-- http://xmlns.com/foaf/0.1/name -->

    <owl:AnnotationProperty rdf:about="http://xmlns.com/foaf/0.1/name"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/1999/02/22-rdf-syntax-ns#langString -->

    <rdfs:Datatype rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#gYear -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#gYear"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#time -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#time"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.oclc.org/NET/ssnx/ssn#isProducedBy -->

    <rdf:Description rdf:about="http://purl.oclc.org/NET/ssnx/ssn#isProducedBy">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/GCI/Environment/Pollution.owl#Air_pollution_concentration"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/WeatherData"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://purl.oclc.org/NET/ssnx/ssn#SensingDevice"/>
    </rdf:Description>
    


    <!-- http://www.wurvoc.org/vocabularies/om-1.8/unit_of_measure -->

    <rdf:Description rdf:about="http://www.wurvoc.org/vocabularies/om-1.8/unit_of_measure">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/GCI/Environment/Pollution.owl#Air_pollution_concentration"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/WeatherData"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.wurvoc.org/vocabularies/om-1.8/Unit_of_measure"/>
    </rdf:Description>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/APConcentrationTime -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/APConcentrationTime">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/GCI/Environment/Pollution.owl#Air_pollution_concentration"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/WeatherData"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:comment xml:lang="en">It defines the relationship between air pollution conentration individuals and their time of recording.</rdfs:comment>
        <rdfs:label xml:lang="en">APConcentrationTime</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/administration -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/administration">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/TherapeuticTreatment"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/Administration"/>
        <rdfs:comment xml:lang="en">It defines the relationship between a therapeutic treatment and the specific administration details.</rdfs:comment>
        <rdfs:label xml:lang="en">administration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/adverseReaction -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/adverseReaction">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/EndTherapyReason"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/AdverseDrugReaction"/>
        <rdfs:comment xml:lang="en">It defines the relationship between The end therapy reason and the adverse reaction occurred.</rdfs:comment>
        <rdfs:label xml:lang="en">adverseReaction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/anatomicalLocation -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/anatomicalLocation">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/ClinicalEvaluation"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/DiagnosticImaging"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/Onset"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/SurgicalProcedure"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/Trauma"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/AnatomicalSite"/>
        <rdfs:comment xml:lang="en">It defines the location of a trauma, onset, surgical procedure or diagnostic imaging.</rdfs:comment>
        <rdfs:label xml:lang="en">anatomicalLocation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/birthplace -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/birthplace">
        <rdfs:domain rdf:resource="http://www.w3.org/2000/10/swap/pim/contact#Person"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/Place"/>
        <rdfs:comment xml:lang="en">It defines the relationship between a person and his or her birthplace.</rdfs:comment>
        <rdfs:label xml:lang="en">birthplace</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/coexistingPregnancy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/coexistingPregnancy">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Relapse"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/Pregnancy"/>
        <rdfs:comment xml:lang="en">It defines the relationship between a relapse and a co-occurring pregnancy.</rdfs:comment>
        <rdfs:label xml:lang="en">coexistingPregnancy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/conductedInClinic -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/conductedInClinic">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/ClinicalTrial"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/ClinicsAndHospitals"/>
        <rdfs:comment xml:lang="en">It defines the relationship between a clinical trial and a clinic or hospital. In particular, a clinical trial is conducted in a clinic or hospital.</rdfs:comment>
        <rdfs:label xml:lang="en">conductedInClinic</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/confirmedPregnancy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/confirmedPregnancy">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/EndTherapyReason"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/Pregnancy"/>
        <rdfs:comment xml:lang="en">It defines the relationship between the end therapy reason and a pregnancy, meaning the therapeutic treatment was interrupted due to a confirmed pregnancy.</rdfs:comment>
        <rdfs:label xml:lang="en">confirmedPregnancy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/consists -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/consists">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Event"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/InterventionOrProcedure"/>
        <rdfs:comment xml:lang="en">It defines the relationship between an event and an intervetion or procedure. In particular, an event could consist in an intervention or procedure.</rdfs:comment>
        <rdfs:label xml:lang="en">consists</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/coveredPlace -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/coveredPlace">
        <rdfs:domain rdf:resource="http://purl.oclc.org/NET/ssnx/ssn#SensingDevice"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/Place"/>
        <rdfs:comment xml:lang="en">It defines the relationship between the sensing device for environmental data and the covered place.</rdfs:comment>
        <rdfs:label xml:lang="en">coveredPlace</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/determinedBy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/determinedBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Comorbidity"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <rdfs:comment xml:lang="en">It defines the relationship between a comorbidity and the disease that determines it.</rdfs:comment>
        <rdfs:label xml:lang="en">determinedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/enrolledIn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/enrolledIn">
        <rdfs:domain rdf:resource="http://www.w3.org/2000/10/swap/pim/contact#Person"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/ClinicalTrialParticipation"/>
        <rdfs:comment xml:lang="en">It defines the relationship between a person and a clinical trial participation. In particular, a person can be enrolled in a clinical trial participation.</rdfs:comment>
        <rdfs:label xml:lang="en">enrolledIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/filledAppQuestionnaire -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/filledAppQuestionnaire">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Event"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/AppQuestionnaire"/>
        <rdfs:comment xml:lang="en">Links each app questionnaire to the event in which it was filled.</rdfs:comment>
        <rdfs:label xml:lang="en">filledAppQuestionnaire</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/hasDisease -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/hasDisease">
        <rdfs:domain rdf:resource="http://www.w3.org/2000/10/swap/pim/contact#Person"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <rdfs:comment xml:lang="en">It defines the relationship between a person and a disease which he or she suffers from.</rdfs:comment>
        <rdfs:label xml:lang="en">hasDisease</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/hasEthnicity -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/hasEthnicity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Patient"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/Group"/>
        <rdfs:comment xml:lang="en">It defines the patient&apos;s ethnicity. For instance, we say that: :Peter :hasEthnicity _:b . _:b a Group (social concept); a skos:Concept.</rdfs:comment>
        <rdfs:label xml:lang="en">hasEthnicity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/hasKinship -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/hasKinship">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Patient"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/Kinship"/>
        <rdfs:comment xml:lang="en">It defines the relation between a patient and a kinship. For instance, we say that: :Peter :hasKinship _:b . _:b a Kinship; :hasKinshipType http://aunt. http://aunt a KinshipType; a skos:Concept.</rdfs:comment>
        <rdfs:label xml:lang="en">hasKinship</rdfs:label>
        <skos:note xml:lang="en">This property is functional because we refer only to biological kinship thus a person can only have one biological kinship with a specific person.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/hasKinshipType -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/hasKinshipType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Kinship"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/KinshipType"/>
        <rdfs:comment xml:lang="en">It defines the relation between a Kinship and a KinshipType. For instance, we say that: :Peter :hasKinship _:b . _:b a Kinship; :hasKinshipType http://aunt. http://aunt a KinshipType; a skos:Concept.</rdfs:comment>
        <rdfs:label xml:lang="en">hasKinshipType</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/hasOccupation -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/hasOccupation">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Patient"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/Occupation"/>
        <rdfs:comment xml:lang="en">It defines the relationship between a patient and his or her occupation.</rdfs:comment>
        <rdfs:label xml:lang="en">hasOccupation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/hasRegisteredActivity -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/hasRegisteredActivity">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Event"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/Activity"/>
        <rdfs:comment xml:lang="en">It defines the relationsihip between an event and an activity. In particular, during an event a specific type of activity can be registered.</rdfs:comment>
        <rdfs:label xml:lang="en">hasRegisteredActivity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/hasRegisteredCondition -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/hasRegisteredCondition">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Event"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/Condition"/>
        <rdfs:comment xml:lang="en">It defines the relationsihip between an event and a comorbidity. In particular, during an event a preexisting condition can be registered.</rdfs:comment>
        <rdfs:label xml:lang="en">hasRegisteredCondition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/inClinicalTrial -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/inClinicalTrial">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/ClinicalTrialParticipation"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/ClinicalTrial"/>
        <rdfs:comment xml:lang="en">It defines the relationship between a clinical trial participation and a clinical trial. In particular, a clinical trial participation refers to a clinical trial.</rdfs:comment>
        <rdfs:label>inClinicalTrial</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/inKinshipWith -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/inKinshipWith">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Kinship"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/10/swap/pim/contact#Person"/>
        <rdfs:comment>The relationship of kinship between a patient with another Person (who might also be a Patient)</rdfs:comment>
        <rdfs:label xml:lang="en">inKinshipWith</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/isAboutDisease -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/isAboutDisease">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/ClinicalTrial"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <rdfs:comment xml:lang="en">It defines the relationship between a clinical trial and the disease studied in it.</rdfs:comment>
        <rdfs:label xml:lang="en">isAboutDisease</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/menstrualCycle -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/menstrualCycle">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Patient"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/MenstrualCycle"/>
        <rdfs:comment xml:lang="en">Links a patient to the information about her menstrual cycle.</rdfs:comment>
        <rdfs:label xml:lang="en">menstrualCycle</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/observedResult -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/observedResult">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/HematologyTest"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/LaboratoryTestResult"/>
        <rdfs:comment xml:lang="en">It defines the relationship between an hematology test and the observed laboratory results.</rdfs:comment>
        <rdfs:label xml:lang="en">observedResult</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/onGene -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/onGene">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/GeneticTesting"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/Gene"/>
        <rdfs:comment xml:lang="en">It defnies the relationship between a genetic testing and a gene. In particular, a genetic testing looks for some genetic mutations on a gene.</rdfs:comment>
        <rdfs:label xml:lang="en">onGene</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/ownsSensingDevice -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ownsSensingDevice">
        <rdfs:domain rdf:resource="http://www.w3.org/2000/10/swap/pim/contact#Person"/>
        <rdfs:range rdf:resource="http://purl.oclc.org/NET/ssnx/ssn#SensingDevice"/>
        <rdfs:comment xml:lang="en">Links each person to the sensing device they are carrying.</rdfs:comment>
        <rdfs:label xml:lang="en">ownsSensingDevice</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/performedTreatment -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/performedTreatment">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/TherapeuticProcedure"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/TherapeuticTreatment"/>
        <rdfs:comment xml:lang="en">It defines the relationship between the therapeutic procedure and the perfomed therapeutic treatments.</rdfs:comment>
        <rdfs:label xml:lang="en">performedTreatment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/pharmacologicSubstance -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/pharmacologicSubstance">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/TherapeuticTreatment"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/PharmacologicSubstance"/>
        <rdfs:comment xml:lang="en">It defines the relationship between a therapeutic treatment and the employed pharmacologic subastance.</rdfs:comment>
        <rdfs:label xml:lang="en">pharmacologicSubstance</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/placeLocation -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/placeLocation">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Residence"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/Place"/>
        <rdfs:comment xml:lang="en">It defines the relationship between a patient&apos;s residence and its location.</rdfs:comment>
        <rdfs:label xml:lang="en">placeLocation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/pregnancy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/pregnancy">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Event"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/Pregnancy"/>
        <rdfs:comment xml:lang="en">It defines the relationship between an event and a pregnancy that can be registrered during the event.</rdfs:comment>
        <rdfs:label xml:lang="en">pregnancy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/relapse -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/relapse">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Event"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/Relapse"/>
        <rdfs:comment xml:lang="en">It defines the relationship between an event and a relapse that can be registered during the event.</rdfs:comment>
        <rdfs:label xml:lang="en">relapse</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/requiredMRI -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/requiredMRI">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Relapse"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/MRI"/>
        <rdfs:comment xml:lang="en">It defines the relationship between a relapse and a MRI that has been required.</rdfs:comment>
        <rdfs:label xml:lang="en">requiredMRI</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/residence -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/residence">
        <rdfs:domain rdf:resource="http://www.w3.org/2000/10/swap/pim/contact#Person"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/Residence"/>
        <rdfs:comment xml:lang="en">It defines the relationship between a person and his or her residence.</rdfs:comment>
        <rdfs:label xml:lang="en">residence</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/surgicalType -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/surgicalType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SurgicalProcedure"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/SurgicalType"/>
        <rdfs:comment xml:lang="en">It defines the realtionship between the surgical procedure and the specific type of surgical procedure.</rdfs:comment>
        <rdfs:label xml:lang="en">surgicalType</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/tested -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/tested">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Patient"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/GeneticTesting"/>
        <rdfs:comment xml:lang="en">It defines the relationship betwen a patient and a genetic testing. In particular, a patient can be tested for genetic mutations.</rdfs:comment>
        <rdfs:label xml:lang="en">tested</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/testedForOligoclonalBands -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/testedForOligoclonalBands">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/CSFAnalysis"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/OligoclonalBands"/>
        <rdfs:comment xml:lang="en">It defines the relationship between a CSF Analysis and a test for the presence of oligoclonal bands.</rdfs:comment>
        <rdfs:label xml:lang="en">testedForOligoclonalBands</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/therapyType -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/therapyType">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/TherapeuticTreatment"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/TherapeuticProcedureType"/>
        <rdfs:comment xml:lang="en">It defines the relationship between the therapeutic treatment and the type of therapeutic procedure that has been administered.</rdfs:comment>
        <rdfs:label xml:lang="en">therapyType</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/trauma -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/trauma">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Event"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/Trauma"/>
        <rdfs:comment xml:lang="en">It defines the relationship between an event and a trauma that can be registered during the event.</rdfs:comment>
        <rdfs:label xml:lang="en">trauma</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/undergo -->

    <owl:ObjectProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/undergo">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Patient"/>
        <rdfs:range rdf:resource="https://w3id.org/brainteaser/ontology/schema/Event"/>
        <rdfs:comment xml:lang="en">It defines the relationship between patient and event. In particular, a patient can undergo some events.</rdfs:comment>
        <rdfs:label xml:lang="en">undergo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q1 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q1">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SelfALSFRSR"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#integer"/>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">Detectable speech disturbance</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">Intelligible with repeating</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">Normal speech process</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </owl:oneOf>
                    </rdfs:Datatype>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C4298336"/>
        <rdfs:comment xml:lang="en">Q1: Speech</rdfs:comment>
        <rdfs:label xml:lang="en">ALSFRSR_Q1</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q10 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q10">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SelfALSFRSR"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#integer"/>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">None</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">Occurs at rest: difficulty breathing when either sitting or lying</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">Occurs with one or more of the following: eating, bathing, dressing</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </owl:oneOf>
                    </rdfs:Datatype>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C4298328"/>
        <rdfs:comment xml:lang="en">Q10: Dyspnea</rdfs:comment>
        <rdfs:label xml:lang="en">ALSFRSR_Q10</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q10alt -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q10alt">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SelfALSFRSR"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">no change</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">shortness of breath at rest while either sitting or lying down</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">shortness of breath only with walking</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">shortness of breath with minimal exertion (i.e. talking, eating, bathing or dressing)</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first xml:lang="en">significant shortness of breath (all of the time) and considering using mechanical ventilation</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Do you experience shortness of breath or have difficulty breathing?</rdfs:comment>
        <rdfs:label xml:lang="en">ALSFRSR_Q10alt</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q11 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q11">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SelfALSFRSR"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#integer"/>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">Needs extra pillows in order to sleep (more than two)</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">None</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">Some difficulty sleeping at night due to shortness of breath, does not routinely use more than two pillows</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first xml:lang="en">Unable to sleep without mechanical assistance</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </owl:oneOf>
                    </rdfs:Datatype>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C4298327"/>
        <rdfs:comment xml:lang="en">Q11: Orthopnea</rdfs:comment>
        <rdfs:label xml:lang="en">ALSFRSR_Q11</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q11alt -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q11alt">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SelfALSFRSR"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">Unable to sleep without mechanical assistance</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">no change</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">occasional shortness of breath while lying on back but don&apos;t routinely use more that two (2) pillows to sleep</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">shortness of breath while lying on back and require more than two pillows (or an equivalent) to sleep</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Do you experience shortness of breath or have difficulty breathing while lying down on your back?</rdfs:comment>
        <rdfs:label xml:lang="en">ALSFRSR_Q11alt</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q12 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q12">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SelfALSFRSR"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#integer"/>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">Continuous use of BiPAP during the night</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">Intermittent use of BiPAP</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">None</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </owl:oneOf>
                    </rdfs:Datatype>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C4298326"/>
        <rdfs:comment xml:lang="en">Q12: Respiratory Insufficiency</rdfs:comment>
        <rdfs:label xml:lang="en">ALSFRSR_Q12</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q12alt -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q12alt">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SelfALSFRSR"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">continuous use of BiPAP at night</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">continuous use of BiPAP at night and during the day (nearly 24 hours per day)</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">intermittent use of BiPAP</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">mechanical ventilation by intubation or tracheostomy</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first xml:lang="en">no respiratory support</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Do you require respiratory (breathing) support?</rdfs:comment>
        <rdfs:label xml:lang="en">ALSFRSR_Q12alt</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q1alt -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q1alt">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SelfALSFRSR"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">no change</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">noticeable speech difference</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">speech has changed; asked often to repeat words or phrases</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">speech has changed; sometimes need the use of alternative communication methods (i.e. computer, writing pad, letter board or eye chart)</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first xml:lang="en">unable to communicate verbally</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Have you noticed any changes in your speech?</rdfs:comment>
        <rdfs:label xml:lang="en">ALSFRSR_Q1alt</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q2 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q2">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SelfALSFRSR"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#integer"/>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">Moderately excessive saliva; may have minimal drooling</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">Normal</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">Slight but definite excess of saliva in mouth; may have night time drooling</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </owl:oneOf>
                    </rdfs:Datatype>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C4298335"/>
        <rdfs:comment xml:lang="en">Q2: Salivation</rdfs:comment>
        <rdfs:label xml:lang="en">ALSFRSR_Q2</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q2alt -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q2alt">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SelfALSFRSR"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">marked amounts of excessive saliva with some daytime drooling</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">marked excessive saliva with marked drooling requiring a constant tissue or handkerchief</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">moderate amounts of excessive saliva with or without minimal day time drooling</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">no change</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first xml:lang="en">slight but definite excess of saliva with or without night time drooling</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Have you noticed any changes (increases) in the amount of saliva in your mouth (regardless of any medication use)?</rdfs:comment>
        <rdfs:label xml:lang="en">ALSFRSR_Q2alt</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q3 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q3">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SelfALSFRSR"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#integer"/>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">Early eating problems - occasional choking</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">Normal eating habits</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </owl:oneOf>
                    </rdfs:Datatype>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C4298334"/>
        <rdfs:comment xml:lang="en">Q3: Swallowing</rdfs:comment>
        <rdfs:label xml:lang="en">ALSFRSR_Q3</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q3alt -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q3alt">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SelfALSFRSR"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">do not eat anything by mouth and receive all nutrition through a feeding tube (PEG)</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">no changes (all foods and liquids)</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">some changes in swallowing or occasional choking episodes (including coughing during swallowing)</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">unable to eat all consistencies of food and have modified the consistency of foods eaten</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first xml:lang="en">use a feeding tube (PEG) to supplement what is eaten by mouth</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Have there been any changes in your ability to swallow?</rdfs:comment>
        <rdfs:label xml:lang="en">ALSFRSR_Q3alt</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q4 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q4">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SelfALSFRSR"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#integer"/>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">No words are legible, but can still grip pen</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">Normal</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">Not all words are legible</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first xml:lang="en">Slow</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </owl:oneOf>
                    </rdfs:Datatype>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C4298333"/>
        <rdfs:comment xml:lang="en">Q4:Handwriting</rdfs:comment>
        <rdfs:label xml:lang="en">ALSFRSR_Q4</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q4alt -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q4alt">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SelfALSFRSR"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">able to hold a pen but unable to write</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">no changes</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">not all words are legible</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">slower and/or sloppier but all the words are legible</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first xml:lang="en">unable to hold a pen</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Has your handwriting changed? Please choose the best answer that describes your  handwriting with your dominant (usual) hand without a cuff or brace.</rdfs:comment>
        <rdfs:label xml:lang="en">ALSFRSR_Q4alt</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q5 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q5">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SelfALSFRSR"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Q5: Cutting Food and Handling Utensils (with or without gastrostomy).</rdfs:comment>
        <rdfs:label xml:lang="en">ALSFRSR_Q5</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q5A -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q5A">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SelfALSFRSR"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">Can cut most foods (&gt; 50%), although slow and clumsy; some help needed</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">Food must be cut by someone, but can still feed slowly</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">Normal</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">Somewhat slow and clumsy, but no help needed</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C4285407"/>
        <rdfs:comment xml:lang="en">Q5A: Cutting Food and Handling Utensils (without gastrostomy)</rdfs:comment>
        <rdfs:label xml:lang="en">ALSFRSR_Q5A</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q5Aalt -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q5Aalt">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SelfALSFRSR"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">food must be cut by someone else but can feed slowly without assistance</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">needs to be fed</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">no change</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">sometimes need help with cutting more difficult foods</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first xml:lang="en">somewhat slow and clumsy (or different than before) but no assistance or  adaptive equipment</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Cutting food and handling utensils</rdfs:comment>
        <rdfs:label xml:lang="en">ALSFRSR_Q5Aalt</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q5B -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q5B">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SelfALSFRSR"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C4298332"/>
        <rdfs:comment xml:lang="en">Q5B: Cutting Food and Handling Utensils (with gastrostomy)</rdfs:comment>
        <rdfs:label xml:lang="en">ALSFRSR_Q5B</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q5Balt -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q5Balt">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SelfALSFRSR"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">require assistance with closures and fasteners</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">unable to perform any of the manipulations</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Using a feeding tube (PEG)</rdfs:comment>
        <rdfs:label xml:lang="en">ALSFRSR_Q5Balt</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q6 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q6">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SelfALSFRSR"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#integer"/>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">Independent; Can complete self-care with effort or decreased efficiency</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">Intermittent assistance or substitute methods</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">Needs attendant for self-care</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first xml:lang="en">Normal function</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </owl:oneOf>
                    </rdfs:Datatype>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C4298331"/>
        <rdfs:comment xml:lang="en">Q6: Dressing and Hygiene</rdfs:comment>
        <rdfs:label xml:lang="en">ALSFRSR_Q6</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q6alt -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q6alt">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SelfALSFRSR"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">do not perform self-care activities and completely dependent on caregiver</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">no change</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">perform self-care activities without assistance but with increased effort or decreased efficiency</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">require daily assistance</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first xml:lang="en">require intermittent assistance or use different methods (i.e. sit down to get dressed, fasten buttons with a fastener or your non-dominant hand)</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Has your ability to dress and perform self-care activities (i.e. bathing, teeth brushing, shaving, combing your hair, other hygienic activities) changed?</rdfs:comment>
        <rdfs:label xml:lang="en">ALSFRSR_Q6alt</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q7 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q7">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SelfALSFRSR"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#integer"/>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">Can turn alone, or adjust sheets, but with great difficulty</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">Normal function</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">Somewhat slow and clumsy, but no help needed</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </owl:oneOf>
                    </rdfs:Datatype>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C4285576"/>
        <rdfs:comment xml:lang="en">Q7: Truning in Bed and Adjusting Bed Clothes</rdfs:comment>
        <rdfs:label xml:lang="en">ALSFRSR_Q7</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q7alt -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q7alt">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SelfALSFRSR"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">can initiate turning in bed or adjusting the bed clothes but require assistance to complete the task</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">can turn in bed and adjust the bed clothes without assistance but it is slower or more clumsy</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">can turn in bed or adjust the bedclothes without assistance but with great difficulty</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">helpless in bed</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first xml:lang="en">no change</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Has your ability to turn in bed and adjust the bed clothes (i.e. cover yourself with the sheet or blanket) changed?</rdfs:comment>
        <rdfs:label xml:lang="en">ALSFRSR_Q7alt</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q8 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q8">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SelfALSFRSR"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#integer"/>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">Early ambulation difficulties</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">Non-ambulatory functional movement only</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">Normal</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first xml:lang="en">Walks with assistance</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </owl:oneOf>
                    </rdfs:Datatype>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C4298330"/>
        <rdfs:comment xml:lang="en">Q8: Walking</rdfs:comment>
        <rdfs:label xml:lang="en">ALSFRSR_Q8</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q8alt -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q8alt">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SelfALSFRSR"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">can move legs or stand up but unable to walk from room to room</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">cannot walk or move my legs</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">no change</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">require assistance to walk (i.e. cane, walker, foot brace or hand held assistance)</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first xml:lang="en">walking has changed but do not require any assistance or devices (i.e. foot brace, cane, walker)</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Has your ability to walk changed?</rdfs:comment>
        <rdfs:label xml:lang="en">ALSFRSR_Q8alt</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q9 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q9">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SelfALSFRSR"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#integer"/>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">Cannot do</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">Mild unsteadiness or fatigue</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">Needs assistance</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first xml:lang="en">Normal</rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                <rdf:first xml:lang="en">Slow</rdf:first>
                                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </owl:oneOf>
                    </rdfs:Datatype>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C4298329"/>
        <rdfs:comment xml:lang="en">Q9: Climbing Stairs</rdfs:comment>
        <rdfs:label xml:lang="en">ALSFRSR_Q9</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q9alt -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ALSFRSR_Q9alt">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SelfALSFRSR"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">cannot climb stairs</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">no change</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">require assistance (i.e. using the handrail, cane or person)</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">slower</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first xml:lang="en">unsteady and/or more fatigued</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Has your ability to climb stairs changed?</rdfs:comment>
        <rdfs:label xml:lang="en">ALSFRSR_Q9alt</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/ALSFRS_R_WHO_COMPLETED -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/ALSFRS_R_WHO_COMPLETED">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SelfALSFRSR"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">Caregiver alone</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">Patient</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">Patient with assistance</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">Patient with assistance from caregiver or family member</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Please indicate who completed this survey</rdfs:comment>
        <rdfs:label xml:lang="en">ALSFRS_R_WHO_COMPLETED</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/DYMUS_Q1 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/DYMUS_Q1">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/DYMUS"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Do you have difficulties swallowing solid food (such as meat, bread, and the like)?</rdfs:comment>
        <rdfs:label xml:lang="en">DYMUS_Q1</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/DYMUS_Q10 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/DYMUS_Q10">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/DYMUS"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Do you have weight loss?</rdfs:comment>
        <rdfs:label xml:lang="en">DYMUS_Q10</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/DYMUS_Q2 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/DYMUS_Q2">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/DYMUS"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Do you have difficulties swallowing liquids (such as water, milk, and the like)?</rdfs:comment>
        <rdfs:label xml:lang="en">DYMUS_Q2</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/DYMUS_Q3 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/DYMUS_Q3">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/DYMUS"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Do you have a globus sensation in your throat during swallowing?</rdfs:comment>
        <rdfs:label xml:lang="en">DYMUS_Q3</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/DYMUS_Q4 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/DYMUS_Q4">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/DYMUS"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Do you have food sticking in your throat?</rdfs:comment>
        <rdfs:label xml:lang="en">DYMUS_Q4</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/DYMUS_Q5 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/DYMUS_Q5">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/DYMUS"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Do you cough or do you have a choking sensation after ingesting solid foods?</rdfs:comment>
        <rdfs:label xml:lang="en">DYMUS_Q5</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/DYMUS_Q6 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/DYMUS_Q6">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/DYMUS"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Do you cough or do you have a choking sensation after ingesting liquids?</rdfs:comment>
        <rdfs:label xml:lang="en">DYMUS_Q6</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/DYMUS_Q7 -->

