    <!-- https://w3id.org/brainteaser/ontology/schema/PSQI_Q11C -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/PSQI_Q11C">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PSQI"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
