        <rdfs:comment xml:lang="en">A congenital neural tube defect in which vertebrae are not fully formed. It results in the protrusion of the spinal cord through the opening of the vertebrae. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Spina Bifida</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C27586"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C101398 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C101398">
