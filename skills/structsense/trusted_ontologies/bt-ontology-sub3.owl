        <rdfs:label xml:lang="en">Transurethral Prostatectomy</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.bioontology.org/ontology/SNOMEDCT/90460009 -->

    <owl:NamedIndividual rdf:about="http://purl.bioontology.org/ontology/SNOMEDCT/90460009">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0027531</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">General or unspecified injuries to the neck. It includes injuries to the skin, muscles, and other soft tissues of the neck. [Defintion Source: MSH]</rdfs:comment>
        <rdfs:label xml:lang="en">Neck Trauma</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C36282"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.bioontology.org/ontology/SNOMEDCT/9389005 -->

    <owl:NamedIndividual rdf:about="http://purl.bioontology.org/ontology/SNOMEDCT/9389005">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0019357</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A superficial, epithelial Herpesvirus hominis infection of the cornea, characterized by the presence of small vesicles which may break down and coalesce to form dendritic ulcers (KERATITIS, DENDRITIC). (Dictionary of Visual Science, 3d ed) [Defintion Source: MSH]</rdfs:comment>
        <rdfs:label xml:lang="en">Herpes Simplex Keratitis</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C155871"/>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C26805"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.bioontology.org/ontology/SNOMEDCT/9429009 -->

    <owl:NamedIndividual rdf:about="http://purl.bioontology.org/ontology/SNOMEDCT/9429009">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/SurgicalType"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0017193</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Surgical procedures involving the STOMACH and sometimes the lower ESOPHAGUS to correct anatomical defects, or to treat MORBID OBESITY by reducing the size of the stomach. There are several subtypes of bariatric gastroplasty, such as vertical banded gastroplasty, silicone ring vertical gastroplasty, and horizontal banded gastroplasty. [Definition Source: MSH]</rdfs:comment>
        <rdfs:label xml:lang="en">Gastroplasty</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C100023 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C100023">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0581375</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">There was greater than or equal to 50% stenosis (reduction in cross-sectional area) in two coronary arteries (or greater than or equal to 50% stenosis in the left main coronary artery). (ACC) [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Two Vessel Coronary Disease</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C2931"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C100104 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C100104">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
