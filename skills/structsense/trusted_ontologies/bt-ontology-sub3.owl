        <rdfs:comment xml:lang="en">The region of the body that includes the arm, the forearm, and hand. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Upper Extremity</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C12429"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C12742 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C12742">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
