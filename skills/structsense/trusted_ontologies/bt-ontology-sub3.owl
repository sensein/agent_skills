        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C0206078"/>
        <rdfs:comment xml:lang="en">Surgical excision of an intervertebral disc. Often performed for pain relief. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Discectomy</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C21481 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C21481">
