        <rdfs:label xml:lang="en">Plasmapheresis</rdfs:label>
        <skos:broaderTransitive rdf:resource="https://w3id.org/brainteaser/ontology/schema/ImmunoactiveDrugs"/>
    </owl:NamedIndividual>
    


