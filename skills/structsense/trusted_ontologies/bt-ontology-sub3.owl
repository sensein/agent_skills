        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/MRI"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:comment xml:lang="en">The total number of lesions in T2 detected with the MRI.</rdfs:comment>
        <rdfs:label xml:lang="en">totalLesionsT2MRI</rdfs:label>
    </owl:DatatypeProperty>
    


