        <rdfs:label xml:lang="en">lightSleepDuration</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/limbsOnset -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/limbsOnset">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Onset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the patient experienced limb onset, which menas symptoms began in the arms or legs. [Definition Source: National Institute of Neurological Disorders and Stroke]</rdfs:comment>
        <rdfs:label xml:lang="en">limbsOnset</rdfs:label>
    </owl:DatatypeProperty>
    


