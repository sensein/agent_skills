        <rdfs:label xml:lang="en">MTHFR Gene Mutation</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C185645 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C185645">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0235378</dcterms:conformsTo>
