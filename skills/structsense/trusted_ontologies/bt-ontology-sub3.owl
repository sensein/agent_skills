        <rdfs:label xml:lang="en">steps12pm6pm</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/steps6am12pm -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/steps6am12pm">
