        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C3639750"/>
        <rdfs:comment xml:lang="en">Any individual related biologically or legally to another individual and considered two degrees removed from the immediate family as in the case of cousins. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Third Degree Relative</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C101214 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C101214">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
