        <rdfs:label xml:lang="en">kingsValue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/lesionsT1MRI -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/lesionsT1MRI">
