        <rdfs:label xml:lang="en">lowStressDuration</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/lowerLimbSurgery -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/lowerLimbSurgery">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/Last5YearsEvent"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/MoreThan5YearsEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether a patient had a lower limb surgery.</rdfs:comment>
        <rdfs:label xml:lang="en">lowerLimbSurgery</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/lumboSacralSpineSurgery -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/lumboSacralSpineSurgery">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/Last5YearsEvent"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/MoreThan5YearsEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether a patient had a lumbo sacral spine surgery.</rdfs:comment>
        <rdfs:label xml:lang="en">lumboSacralSpineSurgery</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/lumboSacralTrauma -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/lumboSacralTrauma">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/Last5YearsEvent"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/MoreThan5YearsEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether a patient had a lumbo sacral trauma.</rdfs:comment>
        <rdfs:label xml:lang="en">lumboSacralTrauma</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/lymphocytesCSF -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/lymphocytesCSF">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/CSFAnalysis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The percentage of lymphocytes present in a sample of CSF. Unit of measure : [%].</rdfs:comment>
        <rdfs:label xml:lang="en">lymphocytesCSF</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/maritalStatus -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/maritalStatus">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Patient"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <dcterms:conformsTo xml:lang="en">https://uts.nlm.nih.gov/uts/umls/concept/C0024819</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A demographic parameter indicating a person&apos;s current conjugal status. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">maritalStatus</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/maxHeartRate -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/maxHeartRate">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/HeartRateMeasurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Max heart rate registered by the wearable device. [uom: bpm]</rdfs:comment>
        <rdfs:label xml:lang="en">maxHeartRate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/maxStressLevel -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/maxStressLevel">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/StressLevel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Max stress level registered by the wearable device.</rdfs:comment>
        <rdfs:label xml:lang="en">maxStressLevel</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/maxTimeHeartRate -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/maxTimeHeartRate">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/HeartRateMeasurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The time at which maximum heart rate occurs. </rdfs:comment>
        <rdfs:label xml:lang="en">maxTimeHeartRate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/measuredLevel -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/measuredLevel">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/LaboratoryTestResult"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The level of the hematopoietic component measured in the laboratory test result.</rdfs:comment>
        <rdfs:label xml:lang="en">measuredLevel</rdfs:label>
        <skos:note xml:lang="en">This data property is populated only for numeric-valued test results.</skos:note>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/measurementCalibrated -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/measurementCalibrated">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/GCI/Environment/Pollution.owl#Air_pollution_concentration"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/WeatherData"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Air pollution concentration value with seasonal components and noise removed.</rdfs:comment>
        <rdfs:label xml:lang="en">measurementCalibrated</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/mediumStressDuration -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/mediumStressDuration">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/StressLevel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Medium stress duration registered by the wearable device. [uom: seconds]</rdfs:comment>
        <rdfs:label xml:lang="en">mediumStressDuration</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/menopauseStatus -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/menopauseStatus">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Patient"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <dcterms:conformsTo xml:lang="en">https://uts.nlm.nih.gov/uts/umls/concept/C3829127</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">An indicator as to whether the female subject is in menopause. [Defintion source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">menopauseStatus</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/metersWalkedFirstMin -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/metersWalkedFirstMin">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/WalkTestALS"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">How many meters the patient walked in the first minute.</rdfs:comment>
        <rdfs:label xml:lang="en">metersWalkedFirstMin</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/metersWalkedTwoMins -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/metersWalkedTwoMins">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/WalkTestALS"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">How many meters the patient walked in two minutes.</rdfs:comment>
        <rdfs:label xml:lang="en">metersWalkedTwoMins</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/minHeartRate -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/minHeartRate">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/HeartRateMeasurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Min heart rate registered by the wearable device. [uom: bpm]</rdfs:comment>
        <rdfs:label xml:lang="en">minHeartRate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/minTimeHeartRate -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/minTimeHeartRate">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/HeartRateMeasurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The time at which minimum heart rate occurs.</rdfs:comment>
        <rdfs:label xml:lang="en">minTimeHeartRate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/mitosValue -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/mitosValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/MiToSFunctionalStaging"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">The patient&apos;s disease stage according to the MiToS staging system.</rdfs:comment>
        <rdfs:label xml:lang="en">mitosValue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/moderateIntensityDuration -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/moderateIntensityDuration">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PhysicalActivityData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Moderate intensity duration registered by the wearable device. [uom: seconds]</rdfs:comment>
        <rdfs:label xml:lang="en">moderateIntensityDuration</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/moreThan10PercentWeightloss -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/moreThan10PercentWeightloss">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/ClinicalEvaluation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether a patient lost more than 10% of his or her body weight.</rdfs:comment>
        <rdfs:label xml:lang="en">moreThan10PercentWeightloss</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/motorSubscore -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/motorSubscore">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/ALSFRS"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Motor ALSFRS subscore. Sum of items: 4, 5, 6, 7, 8 and 9.</rdfs:comment>
        <rdfs:label xml:lang="en">motorSubscore</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/multipleSclerosisType -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/multipleSclerosisType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/ClinicalEvaluation"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>clinically isolated syndrome (CIS)</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>primary progressive MS (PP)</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>progressive-relapsing (PR)</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>radiologically isolated syndrome (RIS)</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first>relapsing-remitting MS (RR)</rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                <rdf:first>secondary progressive MS (SP)</rdf:first>
                                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The Multiple Sclerosis (MS) disease course identified in the patient.</rdfs:comment>
        <rdfs:label xml:lang="en">multipleSclerosisType</rdfs:label>
        <skos:note xml:lang="en">This data property is used only for MS patients.</skos:note>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/mutationType -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/mutationType">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/GeneticTesting"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:comment xml:lang="en">The type of mutation observed in the gene during genetic testing.</rdfs:comment>
        <rdfs:label>mutationType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/neckTrauma -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/neckTrauma">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/Last5YearsEvent"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/MoreThan5YearsEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:comment xml:lang="en">Whether a patient had a neck trauma.</rdfs:comment>
        <rdfs:label xml:lang="en">neckTrauma</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/newOrEnlargedLesionsT2MRI -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/newOrEnlargedLesionsT2MRI">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/MRI"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the MRI detected new or enlarged gadolinium-enhanced lesions in T2 since the last MRI.</rdfs:comment>
        <rdfs:label xml:lang="en">newOrEnlargedLesionsT2MRI</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/newOrEnlargedLesionsT2MRINumber -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/newOrEnlargedLesionsT2MRINumber">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/MRI"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">The number of new or enlarged gadolinium-enhanced lesions in T2 since the last MRI.</rdfs:comment>
        <rdfs:label xml:lang="en">newOrEnlargedLesionsT2MRINumber</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/nonDominantHandTrial1 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/nonDominantHandTrial1">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/HandDexterity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Hand Dextrcity on non-dominant hand (Trial 1).</rdfs:comment>
        <rdfs:label xml:lang="en">nonDominantHandTrial1</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/nonDominantHandTrial2 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/nonDominantHandTrial2">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/HandDexterity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Hand Dextrcity on non-dominant hand (Trial 2).</rdfs:comment>
        <rdfs:label xml:lang="en">nonDominantHandTrial2</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/nonDominantHandTrialDone -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/nonDominantHandTrialDone">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/HandDexterity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the hand dextricity was performed on the dominant hand.</rdfs:comment>
        <rdfs:label xml:lang="en">nonDominantHandTrialDone</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/normalLevel -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/normalLevel">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/LaboratoryTestResult"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the measured level is within the normal range for the tested hematopoietic component.</rdfs:comment>
        <rdfs:label xml:lang="en">normalLevel</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/notes -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/notes">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Patient"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:comment xml:lang="en">An open box for adding notes about the patient.</rdfs:comment>
        <rdfs:label xml:lang="en">notes</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/numberSpinalCordLesions -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/numberSpinalCordLesions">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/MRI"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The number of spinal cord lesions showed in the MRI.</rdfs:comment>
        <rdfs:label xml:lang="en">numberSpinalCordLesions</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/oligoclonalBandsNumber -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/oligoclonalBandsNumber">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/OligoclonalBands"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">The number of oligoclonal bands present in the specimen.</rdfs:comment>
        <rdfs:label xml:lang="en">oligoclonalBandsNumber</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/oligoclonalBandsPresence -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/oligoclonalBandsPresence">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/OligoclonalBands"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the tested specimen presents oligoclonal bands.</rdfs:comment>
        <rdfs:label xml:lang="en">oligoclonalBandsPresence</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/oligoclonalBandsType -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/oligoclonalBandsType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/OligoclonalBands"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>in CSF</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>in CSF &amp; serum</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Whether the oligoclonal bands were found in CSF or in CSF &amp; serum.</rdfs:comment>
        <rdfs:label xml:lang="en">oligoclonalBandsType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/onsetElapsedTime -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/onsetElapsedTime">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeforeOnset"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>beyond 5years</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>within 5 yeras</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The time elapsed since the occurrence of an event that happened before the onset.</rdfs:comment>
        <rdfs:label xml:lang="en">onsetElapsedTime</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/originalALSFRS -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/originalALSFRS">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/ALSFRS"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Amyotrophic Lateral Sclerosis Functional Rating Scale. Sum of items: 1,2,3,4,5,6,7,8,9 and old10.</rdfs:comment>
        <rdfs:label xml:lang="en">originalALSFRS</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/otherFactorsAffectedHandTrial -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/otherFactorsAffectedHandTrial">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/HandDexterity"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:comment xml:lang="en">Other factors that affected the hand dextricity test.</rdfs:comment>
        <rdfs:label xml:lang="en">otherFactorsAffectedHandTrial</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/otherOnset -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/otherOnset">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Onset"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#boolean"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Other symptoms experienced by the patient during onset.</rdfs:comment>
        <rdfs:label xml:lang="en">otherOnset</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/otherRelapse -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/otherRelapse">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Relapse"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:comment xml:lang="en">Other functional systems involved in the relapse.</rdfs:comment>
        <rdfs:label xml:lang="en">otherRelapse</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/outsideWalkingStatus -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/outsideWalkingStatus">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/ClinicalEvaluation"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">Crutches</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">Fully ambulatory</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">Orthosis</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="em">Walker</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first xml:lang="en">Walking stick</rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                <rdf:first xml:lang="en">Wheelchair</rdf:first>
                                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The ambulatory status of the patient when walking outside. (e.g., whether they walk on their own or they need assistive devices)</rdfs:comment>
        <rdfs:label xml:lang="en">outsideWalkingStatus</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/packYear -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/packYear">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Smoking"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Quantificator of lifetime tobacco exposure defined as: (number of cigarettes smoked per day) X (number of years smoked)/20.</rdfs:comment>
        <rdfs:label xml:lang="en">packYear</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/participationEnd -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/participationEnd">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/ClinicalTrialParticipation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">The calendar date of the end of subject&apos;s partiicpation in a clinical trial.</rdfs:comment>
        <rdfs:label xml:lang="en">participationEnd</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/participationStart -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/participationStart">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/ClinicalTrialParticipation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">The calendar date of the start of subject&apos;s partiicpation in a clinical trial.</rdfs:comment>
        <rdfs:label xml:lang="en">participationStart</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/pathologicalJCCSF -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/pathologicalJCCSF">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/CSFAnalysis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the JC virus detected in the CSF specimen is pathological.</rdfs:comment>
        <rdfs:label xml:lang="en">pathologicalJCCSF</rdfs:label>
        <skos:note xml:lang="en">This data property can only be populated in &quot;visuJCTestedCSF&quot; has value True.</skos:note>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/pelvicSurgery -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/pelvicSurgery">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/Last5YearsEvent"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/MoreThan5YearsEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether a patient had a pelivc surgery.</rdfs:comment>
        <rdfs:label xml:lang="en">pelvicSurgery</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/phenotype -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/phenotype">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Patient"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C4086242"/>
        <rdfs:comment xml:lang="en">The observable properties present during a disease. [Definition Source: NCI]</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/NCIT_C125204"/>
        <rdfs:label xml:lang="en">phenotype</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/placeArea -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/placeArea">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Place"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>city</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>rural</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>town</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>urban</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The type of populated area that better describe the place.</rdfs:comment>
        <rdfs:label xml:lang="en">placeArea</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/positivityResult -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/positivityResult">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/LaboratoryTestResult"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the laboratory test result was positive or not.</rdfs:comment>
        <rdfs:label xml:lang="en">positivityResult</rdfs:label>
        <skos:note xml:lang="en">This data property is only populated for positive/negative laboratory test result.</skos:note>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/predominantLimbsImpairment -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/predominantLimbsImpairment">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/ClinicalEvaluation"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>both</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>distal</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>proximal</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Whether the patient predominantly presents distal limbs impairment or proximal limbs impairment.</rdfs:comment>
        <rdfs:label xml:lang="en">predominantLimbsImpairment</rdfs:label>
        <skos:note xml:lang="en">This data property is used only for ALS patients.</skos:note>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/predominantLimbsSide -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/predominantLimbsSide">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/ClinicalEvaluation"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>left</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>right</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>symmetric</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The side of the body that predominantly presents limb impariment.</rdfs:comment>
        <rdfs:label xml:lang="en">predominantLimbsSide</rdfs:label>
        <skos:note xml:lang="en">This data property is used only for ALS patients.</skos:note>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/predominantMotorNeuron -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/predominantMotorNeuron">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/ClinicalEvaluation"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>both motor neuron</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>lower motor neuron</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>upper motor neuron</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Whether the patient presents a predominance of lower motor neuron, upper motor neuron or both.</rdfs:comment>
        <rdfs:label xml:lang="en">predominantMotorNeuron</rdfs:label>
        <skos:note xml:lang="en">This data property is used only for ALS patients.</skos:note>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/pregnancyComplications -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/pregnancyComplications">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Pregnancy"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:comment xml:lang="en">Any kind of complication related to the pregnancy.</rdfs:comment>
        <rdfs:label xml:lang="en">pregnancyComplications</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/pregnancyEnd -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/pregnancyEnd">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Pregnancy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">The calendar date in which the pregnancy ended.</rdfs:comment>
        <rdfs:label xml:lang="en">pregnancyEnd</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/pregnancyEndEvent -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/pregnancyEndEvent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Pregnancy"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:comment xml:lang="en">The event that ended the pregnancy.</rdfs:comment>
        <rdfs:label xml:lang="en">pregnancyEndEvent</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/pregnancyStart -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/pregnancyStart">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Pregnancy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">The calendar date in which the pregnancy started.</rdfs:comment>
        <rdfs:label xml:lang="en">pregnancyStart</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/primaryNeoplasm -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/primaryNeoplasm">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/ALSBrainteaserComorbidities"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether a patient ever had a primary neoplasm.</rdfs:comment>
        <rdfs:label xml:lang="en">primaryNeoplasm</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/privacyPreservingDate -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/privacyPreservingDate">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/GCI/Environment/Pollution.owl#Air_pollution_concentration"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/Activity"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/AppQuestionnaire"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/Condition"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/Event"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/InterventionOrProcedure"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/Pregnancy"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/Relapse"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/Trauma"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/WeatherData"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Privacy preserving date computed according to an algorithm used to extract public instances.</rdfs:comment>
        <rdfs:label xml:lang="en">privacyPreservingDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/privacyPreservingDeathDate -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/privacyPreservingDeathDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Patient"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Privacy preserving death date computed according to an algorithm used to extract public instances.</rdfs:comment>
        <rdfs:label xml:lang="en">privacyPreservingDeathDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/procedureEnd -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/procedureEnd">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/InterventionOrProcedure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">The calendar date of the end of an intervention or procedure.</rdfs:comment>
        <rdfs:label xml:lang="en">procedureEnd</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/procedureStart -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/procedureStart">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/InterventionOrProcedure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">The calendar start of an intervention or procedure.</rdfs:comment>
        <rdfs:label xml:lang="en">procedureStart</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/proteinsCSF -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/proteinsCSF">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/CSFAnalysis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">A quantitative measurement of proteins present in a sample of CSF [ mg/l].</rdfs:comment>
        <rdfs:label xml:lang="en">proteinsCSF</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/pulmonaryAOPAbs -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/pulmonaryAOPAbs">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PulmonaryFunctionTest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Occlusion pressure at 100 ms (P0.1) is defined as the negative pressure measured 100 ms after the initiation of an inspiratory effort performed against a closed respiratory circuit. [Definition Source: Beloncle, F., Piquilloud, L., Olivier, PY. et al. Accuracy of P0.1 measurements performed by ICU ventilators: a bench study. Ann. Intensive Care 9, 104 (2019)]</rdfs:comment>
        <rdfs:label xml:lang="en">pulmonaryAOPAbs</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/pulmonaryFEV6 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/pulmonaryFEV6">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PulmonaryFunctionTest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Forced expiratory volume (FEV) is the amount of air expired in six seconds of the FVC test. [Definition Source: John Hopkins Medicine]</rdfs:comment>
        <rdfs:label xml:lang="en">pulmonaryFEV6</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/pulmonaryFVCLyingDown -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/pulmonaryFVCLyingDown">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PulmonaryFunctionTest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Forced Vital Capacity (FVC) when patient is lied down.</rdfs:comment>
        <rdfs:label xml:lang="en">pulmonaryFVCLyingDown</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/pulmonaryFVCLyingDownPercentage -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/pulmonaryFVCLyingDownPercentage">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PulmonaryFunctionTest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Percentage of FVC lying down.</rdfs:comment>
        <rdfs:label xml:lang="en">pulmonaryFVCLyingDownPercentage</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/pulmonaryFVCRel -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/pulmonaryFVCRel">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PulmonaryFunctionTest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The percentage of Forced vital capacity (FVC)  is the amount of air exhaled forcefully and quickly after inhaling as much as you can. [Defintion Source: John Hopkins Medicine]</rdfs:comment>
        <rdfs:label xml:lang="en">pulmonaryFVCRel</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/pulmonaryFVCSitting -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/pulmonaryFVCSitting">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PulmonaryFunctionTest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Forced Vital Capacity (FVC) when patient is sitted.</rdfs:comment>
        <rdfs:label xml:lang="en">pulmonaryFVCSitting</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/pulmonaryFVCSittingPercentage -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/pulmonaryFVCSittingPercentage">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PulmonaryFunctionTest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Percentage of FVC sitting</rdfs:comment>
        <rdfs:label xml:lang="en">pulmonaryFVCSittingPercentage</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/pulmonaryMEP -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/pulmonaryMEP">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PulmonaryFunctionTest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Maximum Expiratory Pressure (MEP) is the greatest amount of pressure that can be generated by exhaling against a mouthpiece, which is a measure of the strength of respiratory muscles. [Definition Source: NCI] (uom: CMH2O)</rdfs:comment>
        <rdfs:label xml:lang="en">pulmonaryMEP</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/pulmonaryMEPAbs -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/pulmonaryMEPAbs">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PulmonaryFunctionTest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Maximum Expiratory Pressure (MEP) is the highest pressure that can be developed during a forceful expiratory effort against an occluded airway. It is usually measured at maximal inspiration and reported as a positive number in either cm H2O or mmHg. [Definition Source: The University of Texas Medical Branch]</rdfs:comment>
        <rdfs:label xml:lang="en">pulmonaryMEPAbs</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/pulmonaryMEPpercentage -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/pulmonaryMEPpercentage">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PulmonaryFunctionTest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Percentage of MEP.</rdfs:comment>
        <rdfs:label xml:lang="en">pulmonaryMEPpercentage</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/pulmonaryMIP -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/pulmonaryMIP">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PulmonaryFunctionTest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Maximum Inspiratory Pressure (MIP) is the greatest amount of pressure that can be generated during inhalation against a fully occluded airway, which is used to measure the strength of respiratory muscles. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">pulmonaryMIP</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/pulmonaryMIPAbs -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/pulmonaryMIPAbs">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PulmonaryFunctionTest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Maximum Inspiratory Pressure (MIP) is the lowest pressure developed during a forceful inspiration against an occluded airway. It is usually measured at maximal expiration and recorded as a negative number in either cm H2O or mmHg. [Definition Source: The University of Texas Medical Branch]</rdfs:comment>
        <rdfs:label xml:lang="en">pulmonaryMIPAbs</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/pulmonaryMIPpercentage -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/pulmonaryMIPpercentage">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PulmonaryFunctionTest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Percentage of MIP.</rdfs:comment>
        <rdfs:label xml:lang="en">pulmonaryMIPpercentage</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/pulmonaryNIP -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/pulmonaryNIP">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PulmonaryFunctionTest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Maximal Negative Inspiratory Pressure (NIP) measures the strength of the diaphragm and other muscles of inspiration and reflects the ability to maintain normal lung expansion and avoid atelectasis. [Definition Source: doi.org/10.1016/B978-032304841-5.50067-4 ]</rdfs:comment>
        <rdfs:label xml:lang="en">pulmonaryNIP</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/pulmonaryPCF -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/pulmonaryPCF">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PulmonaryFunctionTest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Peak Cough Flow (PCF) is the maximum rate of air flow expelled through the mouth, endotracheal, or tracheostomy tube during a cough. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">pulmonaryPCF</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/pulmonaryPCO2 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/pulmonaryPCO2">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PulmonaryFunctionTest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The partial pressure of carbon dioxide (PCO2) is the concentration of carbon dioxide in the blood. This is a sensitive indication of the efficiency or level of ventilation of the lungs. [Definition Source: Collins Dictionary of Medicine]</rdfs:comment>
        <rdfs:label xml:lang="en">pulmonaryPCO2</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/pulmonaryPO2 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/pulmonaryPO2">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PulmonaryFunctionTest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The partial pressure of oxigen (PO2) is  the concentration of oxygen in the blood. This commonly measured parameter is an important indicator of the efficiency with which oxygen is transferred from atmosphere to blood. [Definition Source: Collins Dictionary of Medicine]</rdfs:comment>
        <rdfs:label xml:lang="en">pulmonaryPO2</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/pulmonaryVCAbs -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/pulmonaryVCAbs">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PulmonaryFunctionTest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Vital capacity (VC) is the total volume of air that can be exhaled after inhaling as much as you can. [Definition Source: John Hopkins Medicine]</rdfs:comment>
        <rdfs:label xml:lang="en">pulmonaryVCAbs</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/pyramidalEDSS -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/pyramidalEDSS">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/EDSS"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Expanded Disability Status Score (EDSS) score for pyramidal functions.</rdfs:comment>
        <rdfs:label xml:lang="en">pyramidalEDSS</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/pyramidalRelapse -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/pyramidalRelapse">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Relapse"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the relapse involved the pyramidal functions.</rdfs:comment>
        <rdfs:label xml:lang="en">pyramidalRelapse</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/quadraticTrendHeartRate -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/quadraticTrendHeartRate">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/HeartRateMeasurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The parameter corresponding to the curvature of heart rate. </rdfs:comment>
        <rdfs:label xml:lang="en">quadraticTrendHeartRate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/questionnaireSubmitted -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/questionnaireSubmitted">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/AppQuestionnaire"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">When the questionnaire was submitted.</rdfs:comment>
        <rdfs:label xml:lang="en">questionnaireSubmitted</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/quotientAlbuminCSF -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/quotientAlbuminCSF">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/CSFAnalysis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">CSF/serum albumin ratio is performed to understand the blood–CSF barrier disruption. [Defintion Source: Luque, Francisco A, and Stephen L Jaffe. “Cerebrospinal fluid analysis in multiple sclerosis.” International review of neurobiology vol. 79 (2007)]</rdfs:comment>
        <rdfs:label xml:lang="en">quotientAlbuminCSF</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/r2HeartRate -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/r2HeartRate">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/HeartRateMeasurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The quality of the quadratic model.</rdfs:comment>
        <rdfs:label xml:lang="en">r2HeartRate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/reasonIrregularCycle -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/reasonIrregularCycle">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/MenstrualCycle"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:comment xml:lang="en">Why the patient has an irregular menstrual cycle.</rdfs:comment>
        <rdfs:label xml:lang="en">reasonIrregularCycle</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/reasonNoMenstrualCycle -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/reasonNoMenstrualCycle">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/MenstrualCycle"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:comment xml:lang="en">Why the patient has no menstrual cycle. (e.g., menopause)</rdfs:comment>
        <rdfs:label xml:lang="en">reasonNoMenstrualCycle</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/reasonWalkTestNotCompleted -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/reasonWalkTestNotCompleted">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/WalkTest"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:comment xml:lang="en">The reason the walk test was not completed.</rdfs:comment>
        <rdfs:label xml:lang="en">reasonWalkTestNotCompleted</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/relapseClinicalTherapy -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/relapseClinicalTherapy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Relapse"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the relapse required treatment in an ambulatory care clinic.</rdfs:comment>
        <rdfs:label xml:lang="en">relapseClinicalTherapy</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/relapseCortisoneTherapy -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/relapseCortisoneTherapy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Relapse"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the relapse required a cortisone therapy.</rdfs:comment>
        <rdfs:label xml:lang="en">relapseCortisoneTherapy</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/relapseDuration -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/relapseDuration">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Relapse"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">The number of days the relapse lasted.</rdfs:comment>
        <rdfs:label xml:lang="en">relapseDuration</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/relapseEnd -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/relapseEnd">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Relapse"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">The calendar date of the end of the relapse.</rdfs:comment>
        <rdfs:label xml:lang="en">relapseEnd</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/relapseHospitalAdmission -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/relapseHospitalAdmission">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Relapse"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the relapse required an hospital admission.</rdfs:comment>
        <rdfs:label xml:lang="en">relapseHospitalAdmission</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/relapseImpactOnADL -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/relapseImpactOnADL">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Relapse"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the relapse afftecd the Activity of Daily Living (ADL).</rdfs:comment>
        <rdfs:label xml:lang="en">relapseImpactOnADL</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/relapseRecovery -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/relapseRecovery">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Relapse"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>complete</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>none</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>partial</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">How much the patient recovered from the relapse.</rdfs:comment>
        <rdfs:label xml:lang="en">relapseRecovery</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/relapseSequela -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/relapseSequela">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Relapse"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the patient presented symptoms continuing in time, maybe less severe.</rdfs:comment>
        <rdfs:label xml:lang="en">relapseSequela</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/relapseSeverity -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/relapseSeverity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Relapse"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>life risk</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>moderate</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>serious</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>slight</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The severity of the relapse.</rdfs:comment>
        <rdfs:label xml:lang="en">relapseSeverity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/relapseStart -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/relapseStart">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Relapse"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">The calendar date of the start of the relapse.</rdfs:comment>
        <rdfs:label xml:lang="en">relapseStart</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/relativeEndDate -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/relativeEndDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Activity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
        <rdfs:comment xml:lang="en">Privacy preserving end date computed according to an algorithm used to extract public instances.</rdfs:comment>
        <rdfs:label xml:lang="en">relativeEndDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/relativeStartDate -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/relativeStartDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Activity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
        <rdfs:comment xml:lang="en">Privacy preserving start date computed according to an algorithm used to extract public instances.</rdfs:comment>
        <rdfs:label xml:lang="en">relativeStartDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/remSleep -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/remSleep">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/SleepData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">REM sleep duration registered by the wearable device. [uom: seconds]</rdfs:comment>
        <rdfs:label xml:lang="en">remSleep</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/repirationSampEn -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/repirationSampEn">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/RespiratoryData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The sample entropy</rdfs:comment>
        <rdfs:label xml:lang="en">repirationSampEn</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/residenceEnd -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/residenceEnd">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Residence"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
        <rdfs:comment xml:lang="en">The calendar end date of the patient&apos;s residence in a specific geographical location.</rdfs:comment>
        <rdfs:label xml:lang="en">residenceEnd</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/residenceStart -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/residenceStart">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Residence"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
        <rdfs:comment xml:lang="en">The calendar start date of the patient&apos;s residence in a specific geographical location.</rdfs:comment>
        <rdfs:label xml:lang="en">residenceStart</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/respirationAlpha1DimMean -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/respirationAlpha1DimMean">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/RespiratoryData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Multifractal DFA. DimMean is the mean of singularity dimensions.</rdfs:comment>
        <rdfs:label xml:lang="en">respirationAlpha1DimMean</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/respirationAlpha1DimRange -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/respirationAlpha1DimRange">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/RespiratoryData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Multifractal DFA. DimRange is the range of singularity dimensions, corresponding to the height of the singularity spectrum.</rdfs:comment>
        <rdfs:label xml:lang="en">respirationAlpha1DimRange</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/respirationAlpha1ExpMean -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/respirationAlpha1ExpMean">
