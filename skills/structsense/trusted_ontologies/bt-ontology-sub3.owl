    <!-- http://purl.bioontology.org/ontology/SNOMEDCT/387731002 -->

    <owl:NamedIndividual rdf:about="http://purl.bioontology.org/ontology/SNOMEDCT/387731002">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
