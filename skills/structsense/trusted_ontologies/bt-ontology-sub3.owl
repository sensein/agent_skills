        <rdfs:label xml:lang="en">Black African</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.bioontology.org/ontology/SNOMEDCT/183005 -->

    <owl:NamedIndividual rdf:about="http://purl.bioontology.org/ontology/SNOMEDCT/183005">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding"/>
