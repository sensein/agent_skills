    <!-- https://w3id.org/brainteaser/ontology/schema/PSQI_Q1 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/PSQI_Q1">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PSQI"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#time"/>
        <rdfs:comment xml:lang="en">During the past month, what time have you usually gone to bed at night?</rdfs:comment>
        <rdfs:label xml:lang="en">PSQI_Q1</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/PSQI_Q10 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/PSQI_Q10">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PSQI"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">No bed partner or room mate</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">Partner in same bed</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">Partner/room mate in other room</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">Partner/room mate in same room but not same bed</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Do you have a bed partner or room mate?</rdfs:comment>
        <rdfs:label xml:lang="en">PSQI_Q10</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/PSQI_Q11A -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/PSQI_Q11A">
