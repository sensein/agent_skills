        <rdfs:label xml:lang="en">Eye</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C12419 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C12419">
