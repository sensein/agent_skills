    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/stdHeartRate -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/stdHeartRate">
