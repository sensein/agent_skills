    <!-- https://w3id.org/brainteaser/ontology/schema/MSQOL54_Q54 -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/MSQOL54_Q54">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/MSQOL54"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">Delighted</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">Mixed - about equally satisfied and dissatisfied</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
