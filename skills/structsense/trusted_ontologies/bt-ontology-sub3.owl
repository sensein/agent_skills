        <rdfs:label xml:lang="en">isMenstrualCycleRegular</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/kingsValue -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/kingsValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/KingsClinicalStaging"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
