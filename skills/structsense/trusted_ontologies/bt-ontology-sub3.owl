    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/traumaDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Trauma"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">The calendar date in which the trauma occurred.</rdfs:comment>
        <rdfs:label xml:lang="en">traumaDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/traumaDescription -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/traumaDescription">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Trauma"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:comment xml:lang="en">A description of the trauma</rdfs:comment>
        <rdfs:label xml:lang="en">traumaDescription</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/unitOfMeasure -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/unitOfMeasure">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/LaboratoryTestResult"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
