        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C0037088</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Objective evidence of disease perceptible to the examining practitioner (sign) and subjective evidence of disease perceived by the patient (symptom). [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Sign or Symptom</rdfs:label>
        <skos:broaderTransitive rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3367"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C100808 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C100808">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
