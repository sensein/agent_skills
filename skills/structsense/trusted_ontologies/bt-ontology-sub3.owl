        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Multifractal DFA of short-term fluctuations. ExpMean is the mean of singularity exponents.</rdfs:comment>
        <rdfs:label xml:lang="en">respirationAlpha1ExpMean</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/respirationAlpha1ExpRange -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/respirationAlpha1ExpRange">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/RespiratoryData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Multifractal DFA of short-term fluctuations. ExpRange is the range of singularity exponents, corresponding to the width of the singularity spectrum. </rdfs:comment>
        <rdfs:label xml:lang="en">respirationAlpha1ExpRange</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/respirationAlpha2DimMean -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/respirationAlpha2DimMean">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/RespiratoryData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Multifractal DFA. Dimmean is the mean of singularity dimensions.</rdfs:comment>
        <rdfs:label xml:lang="en">respirationAlpha2DimMean</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/respirationAlpha2DimRange -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/respirationAlpha2DimRange">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/RespiratoryData"/>
