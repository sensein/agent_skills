        <rdfs:label xml:lang="en">Pelvis</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C12799 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C12799">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/AnatomicalSite"/>
