                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <dcterms:conformsTo rdf:resource="https://uts.nlm.nih.gov/uts/umls/concept/C3828906"/>
        <rdfs:comment xml:lang="en">Does your health limit you in walking one block? If so, how much?</rdfs:comment>
        <rdfs:label xml:lang="en">MSQOL54_Q11</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/MSQOL54_Q12 -->

