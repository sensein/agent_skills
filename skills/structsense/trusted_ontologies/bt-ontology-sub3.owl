        <rdfs:label xml:lang="en">lesionsT1MRI</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/lesionsT2MRI -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/lesionsT2MRI">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/MRI"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the MRI detected some lesions in T2.</rdfs:comment>
        <rdfs:label xml:lang="en">lesionsT2MRI</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/leukocytesCountCSF -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/leukocytesCountCSF">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/CSFAnalysis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">A quantitative measurement of leukocytes present in a sample of CSF. Unit of measure : [/mm3].</rdfs:comment>
        <rdfs:label xml:lang="en">leukocytesCountCSF</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/lightSleepDuration -->

