        <rdfs:label xml:lang="en">C9orf72 Gene</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C101491 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C101491">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
