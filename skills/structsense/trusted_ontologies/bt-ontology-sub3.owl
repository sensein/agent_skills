        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Total sleep duration registered by the wearable device. [uom: seconds]</rdfs:comment>
        <rdfs:label xml:lang="en">totalSleepDuration</rdfs:label>
    </owl:DatatypeProperty>
    


