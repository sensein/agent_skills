    <!-- https://w3id.org/brainteaser/ontology/schema/evokedPotentialsLocation -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/evokedPotentialsLocation">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/EvokedPotentials"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>left</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>lower</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>lower left</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>lower right</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first>right</rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                <rdf:first>upper</rdf:first>
                                                                <rdf:rest>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                        <rdf:first>upper left</rdf:first>
                                                                        <rdf:rest>
                                                                            <rdf:Description>
                                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                <rdf:first>upper right</rdf:first>
                                                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                            </rdf:Description>
                                                                        </rdf:rest>
                                                                    </rdf:Description>
                                                                </rdf:rest>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The body location of the evoked potential test.</rdfs:comment>
        <rdfs:label xml:lang="en">evokedPotentialsLocation</rdfs:label>
        <skos:note xml:lang="en">Locations &quot;upper left/upper right/lower left/lower right&quot; can only be used for Evoked Potentials of type &apos;somatosensory&apos; or &apos;motor&apos;.</skos:note>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/evokedPotentialsResponse -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/evokedPotentialsResponse">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/EvokedPotentials"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>altered</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>normal</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The evoked potential function test result.</rdfs:comment>
        <rdfs:label xml:lang="en">evokedPotentialsResponse</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/evokedPotentialsType -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/evokedPotentialsType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/EvokedPotentials"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>auditory</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>motor</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>somatosensory</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>visual</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Whether the test was a Visual Evoked Potential (VEP), Auditory Evoked Potential (AEP), Somatosensory Evoked Potential (SSEP) or Motor Evoked Potential (MEP).</rdfs:comment>
        <rdfs:label xml:lang="en">evokedPotentialsType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/factorsAffectedHandTrial -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/factorsAffectedHandTrial">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/HandDexterity"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">Difficulty seeing</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">Dropped PEG</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">Has a Cold</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="en">Other</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first xml:lang="en">Talked</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The factors that affected the hand dextricity test.</rdfs:comment>
        <rdfs:label xml:lang="en">factorsAffectedHandTrial</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/familiarHistoryALS -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/familiarHistoryALS">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Patient"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether someone in the patient&apos;s faimily suffered from ALS. This property only applies to ALS patients.</rdfs:comment>
        <rdfs:label xml:lang="en">familiarHistoryALS</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/floorsClimbed -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/floorsClimbed">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PhysicalActivityData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Floors climbed registered by the wearable device.</rdfs:comment>
        <rdfs:label xml:lang="en">floorsClimbed</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/floorsClimbedGoal -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/floorsClimbedGoal">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/PhysicalActivityData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Floors climbed goal registered by the wearable device.</rdfs:comment>
        <rdfs:label xml:lang="en">floorsClimbedGoal</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/gadoliniumLesionsT1MRI -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/gadoliniumLesionsT1MRI">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/MRI"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the MRI detected some gadolinium-enhanced lesions in T1.</rdfs:comment>
        <rdfs:label xml:lang="en">gadoliniumLesionsT1MRI</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/gadoliniumLesionsT1MRINumber -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/gadoliniumLesionsT1MRINumber">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/MRI"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">The number of gadolinium-enhanced lesions in T1.</rdfs:comment>
        <rdfs:label xml:lang="en">gadoliniumLesionsT1MRINumber</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/generalizedOnset -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/generalizedOnset">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Onset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the patient experienced generalized onset, that are widespread symptoms.</rdfs:comment>
        <rdfs:label xml:lang="en">generalizedOnset</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/genomeSequencing -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/genomeSequencing">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/Patient"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <dcterms:conformsTo xml:lang="en">https://uts.nlm.nih.gov/uts/umls/concept/C3640076</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">A procedure that can determine the DNA sequence for nearly the entire genome of an individual. [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">genomeSequencing</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/glucoseCSF -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/glucoseCSF">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/CSFAnalysis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">A quantitative measurement of blood sugar present in a sample of CSF. Unit of measure : [mg/l].</rdfs:comment>
        <rdfs:label xml:lang="en">glucoseCSF</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/goldCoastExcludingOthers -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/goldCoastExcludingOthers">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/GoldCoastCriteria"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether other disease processes has been excluded. [Source: doi.org/10.1016/j.clinph.2020.04.005 ]</rdfs:comment>
        <rdfs:label xml:lang="en">goldCoastExcludingOthers</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/goldCoastProgressiveMotorImpairment -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/goldCoastProgressiveMotorImpairment">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/GoldCoastCriteria"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the patient presents progressive motor impairment documented by history or repeated clinical assessment, preceded by normal motor function. [Source: doi.org/10.1016/j.clinph.2020.04.005 ]</rdfs:comment>
        <rdfs:label xml:lang="en">goldCoastProgressiveMotorImpairment</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/goldCoastUMNandLMN -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/goldCoastUMNandLMN">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/GoldCoastCriteria"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the patient presents UMN and LMN signs in at least one body region. [Source: doi.org/10.1016/j.clinph.2020.04.005 ]</rdfs:comment>
        <rdfs:label xml:lang="en">goldCoastUMNandLMN</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/granulocytesCSF -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/granulocytesCSF">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/CSFAnalysis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The percentage of granulocytes present in a sample of CSF. Unit of measure : [%].</rdfs:comment>
        <rdfs:label xml:lang="en">granulocytesCSF</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/hadMajorTrauma -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/hadMajorTrauma">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeforeOnset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether a patient had a major trauma before the disease onset.</rdfs:comment>
        <rdfs:label xml:lang="en">hadMajorTrauma</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/hadSurgicalIntervention -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/hadSurgicalIntervention">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/BeforeOnset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the patient had a surgical intervention before the disease onset.</rdfs:comment>
        <rdfs:label xml:lang="en">hadSurgicalIntervention</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/hasMenstrualCycle -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/hasMenstrualCycle">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/MenstrualCycle"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the patient has the menstrual cycle.</rdfs:comment>
        <rdfs:label xml:lang="en">hasMenstrualCycle</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/hasMutation -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/hasMutation">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/GeneticTesting"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the gene tested positive or negative for mutations during genetic testing.</rdfs:comment>
        <rdfs:label xml:lang="en">hasMutation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/headNeckSurgery -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/headNeckSurgery">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/Last5YearsEvent"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/MoreThan5YearsEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether a patient had a surgery in the head and neck area.</rdfs:comment>
        <rdfs:label xml:lang="en">headNeckSurgery</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/headTrauma -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/headTrauma">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/Last5YearsEvent"/>
                    <rdf:Description rdf:about="https://w3id.org/brainteaser/ontology/schema/MoreThan5YearsEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether a patient had an head trauma.</rdfs:comment>
        <rdfs:label xml:lang="en">headTrauma</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/height -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/height">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/ClinicalEvaluation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <dcterms:conformsTo xml:lang="en">https://uts.nlm.nih.gov/uts/umls/concept/C0489786</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Distance or measurement from the base upwards; altitude; stature (of the human body). [Source: Oxford English Dictionary]</rdfs:comment>
        <rdfs:label xml:lang="en">height</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/highStressDuration -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/highStressDuration">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/StressLevel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">High stress duration registered by the wearable device. [uom: seconds]</rdfs:comment>
        <rdfs:label xml:lang="en">highStressDuration</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/homeWalkingStatus -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/homeWalkingStatus">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/ClinicalEvaluation"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first xml:lang="en">Crutches</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first xml:lang="en">Fully ambulatory</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first xml:lang="en">Orthosis</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first xml:lang="em">Walker</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first xml:lang="en">Walking stick</rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                <rdf:first xml:lang="en">Wheelchair</rdf:first>
                                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The ambulatory status of the patient within the house. (e.g., whether they walk on their own or they need assistive devices)</rdfs:comment>
        <rdfs:label xml:lang="en">homeWalkingStatus</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/hypertension -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/hypertension">
        <rdfs:domain rdf:resource="https://w3id.org/brainteaser/ontology/schema/ALSBrainteaserComorbidities"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether a patient ever had hypertension.</rdfs:comment>
        <rdfs:label xml:lang="en">hypertension</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/brainteaser/ontology/schema/immunoglobulinGCSF -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/brainteaser/ontology/schema/immunoglobulinGCSF">
