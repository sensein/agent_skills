        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/brainteaser/ontology/schema/KinshipType"/>
        <dcterms:conformsTo>https://uts.nlm.nih.gov/uts/umls/concept/C1519210</dcterms:conformsTo>
        <rdfs:comment xml:lang="en">Any relative who is two meioses away from a particular individual in a family; a relative with whom one quarter of an individual&apos;s genes is shared (i.e., grandparent, grandchild, uncle, aunt, nephew, niece, half-sibling) (from Genetics Home Reference glossary) [Definition Source: NCI]</rdfs:comment>
        <rdfs:label xml:lang="en">Second Degree Relative</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C21009 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/NCIT_C21009">
