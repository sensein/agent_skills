        <rdfs:seeAlso>https://www.ncbi.nlm.nih.gov/gene/161725</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#ObjectBurying -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#ObjectBurying">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ModelSystemAutismScale"/>
        <rdfs:label>OB</rdfs:label>
        <rdfs:label>Object burying</rdfs:label>
    </owl:Class>
    


