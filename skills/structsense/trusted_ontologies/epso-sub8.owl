        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#LateralizingSign"/>
        <rdfs:comment>Paradoxical Clonus refers to movement of body part at seizure end ipsilateral to the side of EEG seizure onset.</rdfs:comment>
        <rdfs:label>End of seizure paradoxical clonus</rdfs:label>
        <rdfs:label>Paradoxical Clonus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#ParaneoplasticAntigenMa1 -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#ParaneoplasticAntigenMa1">
