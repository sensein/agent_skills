        <rdfs:label>Ictal paresis (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:label>
        <rdfs:label>Motor onset (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:label>
    </owl:Class>
    


