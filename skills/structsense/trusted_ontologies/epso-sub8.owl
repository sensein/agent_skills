        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugBrandName"/>
        <rdfs:seeAlso>RxCUI 581650</rdfs:seeAlso>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/581650</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Bupropion -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Bupropion">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugIngredient"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasPreciseDrugIngredient"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#BupropionHydrobromide"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#BupropionHydrochloride"/>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasTradename"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Aplenzin"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Budeprion"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Buproban"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Forfivo"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Wellbutrin"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Zyban"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Neuroleptic Drug</rdfs:comment>
        <rdfs:seeAlso>RxCUI 42347</rdfs:seeAlso>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/42347</rdfs:seeAlso>
    </owl:Class>
    


