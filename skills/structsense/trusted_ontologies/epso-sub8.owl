        <rdfs:label>Tonic Status</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Topamax -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Topamax">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugBrandName"/>
        <synonym>RxCUI 220343</synonym>
        <rdfs:comment>Helps control and prevent certain kinds of seizures. Also prevents migraine headaches in adults.</rdfs:comment>
        <rdfs:label>Topamax®</rdfs:label>
