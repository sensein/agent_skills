            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>IA</rdfs:label>
        <rdfs:label>Isomorphic Astrocytoma</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#IsomorphicDiffuseGlioma -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#IsomorphicDiffuseGlioma">
