        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#BrainNeuronalTumor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasWorldHealthOrganizationGrading"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#WorldHealthOrganization_I"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Multinodular and vacuolating neuronal tumor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#MultipleSeizure -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#MultipleSeizure">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SeizureFrequencyCategory"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasValue"/>
                <owl:someValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</xsd:minInclusive>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>LA32853-6 (LOINC Code)</rdfs:comment>
        <rdfs:comment>Multiple per day (i.e., 4 days per week with &gt;= 2 seizures)</rdfs:comment>
        <rdfs:label>Multiple Seizure</rdfs:label>
        <rdfs:seeAlso>https://loinc.org/LA32853-6</rdfs:seeAlso>
    </owl:Class>
    


