        <synonym>RxCUI 901323</synonym>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/901323</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Topiramate -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Topiramate">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugIngredient"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasTradename"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Qsymia"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Topamax"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Topiragen"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Antiepileptic Drug</rdfs:comment>
        <rdfs:comment>Antiseizure Medication</rdfs:comment>
        <rdfs:isDefinedBy>Helps control and prevent certain kinds of seizures. Also prevents migraine headaches in adults.</rdfs:isDefinedBy>
        <rdfs:seeAlso>RxCUI 38404</rdfs:seeAlso>
        <rdfs:seeAlso>https://mor.nlm.nih.gov/RxNav/search?searchBy=String&amp;searchTerm=topiramate</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#TranscriptionFactor -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#TranscriptionFactor">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ProteinFunction"/>
        <rdfs:comment>&quot;Transcription factors are a diverse group of proteins that bind to DNA at specific promoter or enhancer regions. They also bind to DNA-associated proteins to initiate, stimulate, inhibit or terminate transcription. The proteins are often physically associated in a preinitiation complex and contain structural motifs.&quot; (National Cancer Institute Thesaurus)</rdfs:comment>
        <rdfs:label>Transcription Factor</rdfs:label>
        <rdfs:seeAlso>http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C17207</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#TranscriptionFactorSOX-1 -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#TranscriptionFactorSOX-1">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#BiologicalSubstance"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasFunction"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#TranscriptionFactor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>SRY-boxTranscriptionFactor1</rdfs:label>
        <rdfs:label>Transcription Factor SOX-1</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#TransverseFrontopolarGyrus -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#TransverseFrontopolarGyrus">
