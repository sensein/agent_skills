    <!-- http://www.case.edu/EpilepsyOntology.owl#DEPDC5 -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#DEPDC5">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Gene"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasSequenceVariant"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#VariationID50820"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#VariationID50822"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#VariationID50824"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#VariationID50825"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#VariationID59809"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>NM_001242897.2(DEPDC5):c.21C&gt;G (p.Tyr7Ter) (source: Simple ClinVar)</rdfs:comment>
        <rdfs:label>DEP domain containing 5</rdfs:label>
        <rdfs:seeAlso>https://ghr.nlm.nih.gov/gene/DEPDC5</rdfs:seeAlso>
        <rdfs:seeAlso>https://www.ncbi.nlm.nih.gov/clinvar/variation/50819/</rdfs:seeAlso>
    </owl:Class>
    


