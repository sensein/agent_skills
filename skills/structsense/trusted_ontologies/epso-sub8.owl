            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasWorldHealthOrganizationGrading"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#WorldHealthOrganization_III"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Associated with frequent BRAF V600E mutation</rdfs:comment>
        <rdfs:label>Anaplastic Pleomorphic Xanthoastrocytoma</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnatomicalBoundaryEntity -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnatomicalBoundaryEntity">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ImmaterialAnatomicalEntity"/>
        <rdfs:comment>&quot;Immaterial anatomical entity of one less dimension than the anatomical entity it bounds or demarcates from another anatomical entity. Examples: surface of heart, surface of epithelial cell, cervicothoracic plane, supra-orbital notch, costal margin, apex beat, Sylvian point.&quot; (Foundational Model of Anatomy)</rdfs:comment>
        <rdfs:label>Anatomical Boundary Entity</rdfs:label>
        <rdfs:seeAlso>http://purl.org/sig/ont/fma/fma50705</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnatomicalCavity -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnatomicalCavity">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AnatomicalSpace"/>
        <rdfs:comment>&quot;Anatomical space which contains portions of one or more body substances and is bounded by the internal surface of one maximally connected anatomical structure or two or more adjacent anatomical structures. Examples: nasal cavity, cavity of stomach, pharyngeal recess space, lumen of artery, cavity of serous sac.&quot; (Foundational Model of Anatomy)</rdfs:comment>
        <rdfs:label>Anatomical Cavity</rdfs:label>
        <rdfs:seeAlso>http://purl.org/sig/ont/fma/fma67552</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnatomicalCluster -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnatomicalCluster">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AnatomicalStructure"/>
        <rdfs:comment>Anatomical group that has its parts adjacent to one another. Anatomical structure, which has as its parts a heterogeneous collection of organs, organ parts, cells or body part subdivisions that are adjacent to, or continuous with one another; does not constitute an organ, organ system or organ system subdivision, or body part or body part subdivision.</rdfs:comment>
        <rdfs:label>Anatomical Cluster</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Anatomical_cluster</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnatomicalCompartmentSpace -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnatomicalCompartmentSpace">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AnatomicalSpace"/>
        <rdfs:comment>&quot;Anatomical space which contains two or more anatomical structures demarcated by bona fide boundaries and is bounded by the surface of one or more anatomical structures. Examples: orbital cavity, suprasternal space, thoracic cavity, fascial space, hepatic lacuna.&quot; (Foundational Model of Anatomy)</rdfs:comment>
        <rdfs:label>Anatomical Compartment Space</rdfs:label>
        <rdfs:seeAlso>http://purl.org/sig/ont/fma/fma84926</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnatomicalConduitSpace -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnatomicalConduitSpace">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AnatomicalSpace"/>
        <rdfs:comment>&quot;Anatomical space which connects two or more compartment spaces or two or more anatomical cavities. Examples: foramen magnum, pyloric orifice, space of right inguinal canal, nutrient canal space&quot; (Foundational Model of Anatomy)</rdfs:comment>
        <rdfs:label>Anatomical Conduit Space</rdfs:label>
        <rdfs:seeAlso>http://purl.org/sig/ont/fma/fma9338</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnatomicalContainment -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnatomicalContainment">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Non-physicalAnatomicalEntity"/>
        <rdfs:label>Anatomical containment</rdfs:label>
        <rdfs:seeAlso>http://purl.org/sig/ont/fma/fma50635</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnatomicalCoordinate -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnatomicalCoordinate">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Non-physicalAnatomicalEntity"/>
        <rdfs:label>Anatomical Coordinate</rdfs:label>
        <rdfs:seeAlso>http://purl.org/sig/ont/fma/fma23133</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnatomicalEntity -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnatomicalEntity">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#BodilyFeature"/>
        <rdfs:label>Anatomical entity</rdfs:label>
        <rdfs:seeAlso>http://purl.org/sig/ont/fma/fma62955</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnatomicalFissure -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnatomicalFissure">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AnatomicalSpace"/>
        <rdfs:label>Anatomical Fissure</rdfs:label>
        <rdfs:label>Groove</rdfs:label>
        <rdfs:seeAlso>http://purl.org/sig/ont/fma/fma75037</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnatomicalLine -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnatomicalLine">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AnatomicalBoundaryEntity"/>
        <rdfs:comment>&quot;Anatomical boundary entity, each instance of which has one spatial dimension. Examples: margin of tongue, posterior border of right lung, inferior margin of liver, arcuate line of hip bone, sulcus terminalis of heart, pancreatic incisure.&quot; (Foundational Model of Anatomy)</rdfs:comment>
        <rdfs:label>Anatomical Line</rdfs:label>
        <rdfs:seeAlso>http://purl.org/sig/ont/fma/fma9657</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnatomicalPoint -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnatomicalPoint">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AnatomicalBoundaryEntity"/>
        <rdfs:comment>&quot;Anatomical boundary entity, each instance of which has zero spatial dimension. Examples: Apex of lung, vertex, mentale, McBurney&apos;s point.&quot; (Foundational Model of Anatomy)</rdfs:comment>
        <rdfs:label>Anatomical Point</rdfs:label>
        <rdfs:seeAlso>http://purl.org/sig/ont/fma/fma9658</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnatomicalPointofFace -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnatomicalPointofFace">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AnatomicalPointofHead"/>
        <rdfs:label>Anatomical Point of Face</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnatomicalPointofHead -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnatomicalPointofHead">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AnatomicalPoint"/>
        <rdfs:label>Anatomical Point of Head</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnatomicalPointofSkull -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnatomicalPointofSkull">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AnatomicalPointofHead"/>
        <rdfs:label>Anatomical Point of Skull</rdfs:label>
        <rdfs:label>Anatomical cranial point</rdfs:label>
        <rdfs:label>Cranial osteometric point</rdfs:label>
        <rdfs:seeAlso>http://purl.org/sig/ont/fma/fma264284</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnatomicalSpace -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnatomicalSpace">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ImmaterialAnatomicalEntity"/>
        <rdfs:comment>&quot;Immaterial anatomical entity, each instance of which has three spatial dimensions. Examples: body cavity, thoracic cavity, lesser sac, cavity of right atrium, lumen of aorta, mediastinal space, space of anterior compartment of forearm.&quot; (Foundational Model of Anatomy)</rdfs:comment>
        <rdfs:label>Anatomical Space</rdfs:label>
        <rdfs:seeAlso>http://purl.org/sig/ont/fma/fma5897</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnatomicalStructure -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnatomicalStructure">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#MaterialAnatomicalEntity"/>
        <rdfs:comment>Anatomical structure, which has as its parts a heterogeneous collection of organs, organ parts, cells, cell parts or body part subdivisions that are adjacent to, or continuous with one another; does not constitute a cell part, cell, tissue, organ, organ system or organ system subdivision, cardinal body part, body part subdivision or anatomical junction. Examples: joint, adnexa of uterus, root of lung, renal pedicle, back. (source: FMA)</rdfs:comment>
        <rdfs:label>Anatomical Structure</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Anatomical_cluster</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnatomicalSurface -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnatomicalSurface">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AnatomicalBoundaryEntity"/>
        <rdfs:comment>&quot;Anatomical boundary entity, each instance of which has two spatial dimensions. Examples: body surface, epigastrium, precordium, right iliac fossa.&quot; (Foundational Model of Anatomy)</rdfs:comment>
        <rdfs:label>Anatomical Surface</rdfs:label>
        <rdfs:seeAlso>http://purl.org/sig/ont/fma/fma24137</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Anergan -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Anergan">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugBrandName"/>
        <synonym>RxCUI 992861</synonym>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/992861</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AngiocentricGlioma -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AngiocentricGlioma">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#OtherGlioma"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAssociatedMutationIn"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#MYB"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasWorldHealthOrganizationGrading"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#WorldHealthOrganization_I"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <synonym>Angiocentric glioma (morphologic abnormality)</synonym>
        <rdfs:label>AG</rdfs:label>
        <rdfs:label>Angiocentric Glioma</rdfs:label>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/SNOMEDCT/450900009</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnimalSeizure-likeActivity -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnimalSeizure-likeActivity">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ParoxysmalEvent"/>
        <rdfs:label>Animal Seizure-like Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnteriorCingulateEpilepsy -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnteriorCingulateEpilepsy">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#CingulateEpilepsy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasInterIctalEpileptiformAbnormality"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#SharpWave"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Spike"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasSemiologyFeature"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#HypermotorSeizure"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#PsychicAura"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#SimpleMotorSeizure"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAgeOfOnset"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Year"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAgeOfOnset"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">51</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Year"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Anterior Cingulate Epilepsy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnteriorCingulateSegment -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnteriorCingulateSegment">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#CingulateSegment"/>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnteriorCranialFossa -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnteriorCranialFossa">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#CranialFossa"/>
        <rdfs:label>Anterior Cranial Fossa</rdfs:label>
        <rdfs:seeAlso>http://purl.org/sig/ont/fma/fma9682</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnteriorFrontalLobeSegment -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnteriorFrontalLobeSegment">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#FrontalLobeSegment"/>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnteriorHypothalamicRegion -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnteriorHypothalamicRegion">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#HypothalamusZone"/>
        <rdfs:comment>Anterior Hypothalamic Region</rdfs:comment>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Anterior_hypothalamic_region</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnteriorMedianEminence -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnteriorMedianEminence">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DiencephalonZone"/>
        <rdfs:label>Anterior Median Eminence</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Anterior_median_eminence</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnteriorNuclearGroupThalamusSegment -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnteriorNuclearGroupThalamusSegment">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ThalamusSegment"/>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Segment_of_anterior_nuclear_group_of_thalamus</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnteriorParacentralGyrus -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnteriorParacentralGyrus">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#BrainGyrus"/>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Anterior_paracentral_gyrus</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnteriorSlowActivityinChildren -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnteriorSlowActivityinChildren">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#NormalElectroencephalogramPattern"/>
        <rdfs:comment>Slow wave activity, usually in the 4-7 Hz range seen in the anterior head regions in children.</rdfs:comment>
        <rdfs:label>Anterior Slow Activity in Children</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnteriorTemporalLobeSegment -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnteriorTemporalLobeSegment">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#TemporalLobeSegment"/>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AnteriorTransverseTemporalGyrus -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AnteriorTransverseTemporalGyrus">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#TemporalLobeGyrus"/>
        <rdfs:label>Anterior transverse temporal convolution of Heschl</rdfs:label>
        <rdfs:label>Anterior transverse temporal gyrus</rdfs:label>
        <rdfs:label>First transverse gyrus of Heschl</rdfs:label>
        <rdfs:label>Great transverse gyrus of Heschl</rdfs:label>
        <rdfs:seeAlso>http://purl.org/sig/ont/fma/fma61909</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AntiNeuronalNuclearAntibody1AssociatedEncephalitis -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AntiNeuronalNuclearAntibody1AssociatedEncephalitis">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AntibodyAssociatedEncephalitis"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAssociatedAntigen"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Type1AntiNeuronalNuclearAntibody"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Anti-Hu associated encephalitis</rdfs:comment>
        <rdfs:label>Anti Neuronal Nuclear Antibody 1 Associated Encephalitis</rdfs:label>
        <rdfs:label>Anti-ANNA1 Associated Encephalitis</rdfs:label>
        <rdfs:label>Anti-ANNA1AssociatedEncephalitis</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AntiNeuronalNuclearAntibody2AssociatedEncephalitis -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AntiNeuronalNuclearAntibody2AssociatedEncephalitis">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AntibodyAssociatedEncephalitis"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAssociatedAntigen"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Type2AntiNeuronalNuclearAntibody"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>ANNA2AssociatedEncephalitis</rdfs:label>
        <rdfs:label>Anti Neuronal Nuclear Antibody 2 Associated Encephalitis</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AntiNeuronalNuclearAntibody3AssociatedEncephalitis -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AntiNeuronalNuclearAntibody3AssociatedEncephalitis">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AntibodyAssociatedEncephalitis"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAssociatedAntigen"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Type3AntineuronalNuclearAntibody"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>ANNA3AssociatedEncephalitis</rdfs:label>
        <rdfs:label>Anti Neuronal Nuclear Antibody 3 Associated Encephalitis</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AntibodyAssociatedEncephalitis -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AntibodyAssociatedEncephalitis">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Encephalitis"/>
        <rdfs:label>Antibody-associated Encelphalitis</rdfs:label>
        <rdfs:label>Autoimmune encelphalitis</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Antinaus -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Antinaus">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugBrandName"/>
        <synonym>RxCUI 992865</synonym>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/992865</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AphasicEpisode -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AphasicEpisode">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SpecialEpisode"/>
        <rdfs:label>Aphasic Episode</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AphasicSeizure -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AphasicSeizure">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SpecialSeizure"/>
        <rdfs:comment>Aphasic seizures are seizures during which the patient has either a global aphasia or a more selective expressive or comprehensive aphasia.</rdfs:comment>
        <rdfs:comment>Cognitive (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:comment>Focal Onset (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
