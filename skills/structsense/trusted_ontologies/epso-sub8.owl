    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Forearm">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#MiddleFreeLimbSegment"/>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Forearm</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Forebrain -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Forebrain">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#CardinalBrainSegment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sig.uw.edu/fma#regional_part_of"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Brain"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The most anterior region the brain including both the telencephalon and diencephalon.</rdfs:comment>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Forebrain</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#ForebrainNeuralTissue -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#ForebrainNeuralTissue">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#BrainNeuralTissueSegment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sig.uw.edu/fma#regional_part_of"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#BrainNeuralTissue"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Fmaid 268544</rdfs:comment>
        <rdfs:label>Forebrain Neural Tissue</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Neural_tissue_of_forebrain</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#ForebrainSegment -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#ForebrainSegment">
