    <!-- http://www.case.edu/EpilepsyOntology.owl#AkineticSeizure -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AkineticSeizure">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SpecialSeizure"/>
        <rdfs:comment>Akinetic seizures are characterized by inability to perform voluntary movements and preferentially affect more distal muscles.</rdfs:comment>
        <rdfs:comment>Focal Onset (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:comment>Generalized Onset (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:comment>Motor (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:label>Akinetic Seizure</rdfs:label>
    </owl:Class>
    


