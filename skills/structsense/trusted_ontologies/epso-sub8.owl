    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#IntraCranialERPData">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AveragedEEGData"/>
        <rdfs:label>Intra Cranial ERP Data</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#IntracerebralHemorrhage -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#IntracerebralHemorrhage">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#CerebralHemorrhage"/>
        <rdfs:label>Intracerebral Hemorrhage</rdfs:label>
    </owl:Class>
    


