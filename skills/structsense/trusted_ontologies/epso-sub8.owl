    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Invega">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugBrandName"/>
        <synonym>RxCUI 686438</synonym>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/686438</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#IonChannel -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#IonChannel">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ProteinFunction"/>
        <rdfs:comment>&quot;A transmembrane pore that presents a hydrophilic channel for ions to cross a lipid bilayer down their electrochemical gradients. Some degree of ion specificity is usually observed and typically a million ions per second may flow. Channels may be permanently open, like the potassium leak channel or they may be voltage gated, like the sodium channel or ligand gated like the acetylcholine receptor.&quot; (National Cancer Institute Thesaurus)</rdfs:comment>
        <rdfs:label>Ion Channel</rdfs:label>
        <rdfs:seeAlso>http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C16754</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#IonotropicGlutamateReceptor -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#IonotropicGlutamateReceptor">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#BiologicalSubstance"/>
        <rdfs:label>Ionotropic Glutamate Receptor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#IpsilateralIctalBlinking -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#IpsilateralIctalBlinking">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#LateralizingSign"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#isLocatedAt"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Eye"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Unilateral ictal blinking is eye blinking occuring only on one side during episode of seizure.</rdfs:comment>
        <rdfs:label>Unilateral Eye Blinking</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#IrritativeZone -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#IrritativeZone">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#EpilepsyZone"/>
        <rdfs:comment>Area of cortex that produces interictal spikes in the EEG.</rdfs:comment>
        <rdfs:label>Irritative Zone</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Isocarboxazid -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Isocarboxazid">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugIngredient"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasTradename"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Marplan"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Neuroleptic Drug</rdfs:comment>
        <rdfs:seeAlso>RxCUI 6011</rdfs:seeAlso>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/6011</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#IsocitrateDehydrogenase -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#IsocitrateDehydrogenase">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#BiologicalSubstance"/>
        <rdfs:label>IDH</rdfs:label>
        <rdfs:label>Isocitrate Dehydrogenase</rdfs:label>
        <rdfs:label>R132H</rdfs:label>
        <rdfs:seeAlso>N Engl J Med. 2009 Sep 10;361(11); 1058-66</rdfs:seeAlso>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/MESH/C543588</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#IsolatedHeterotopicNeurons -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#IsolatedHeterotopicNeurons">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Heterotopia"/>
        <rdfs:label>Isolated heterotropic neurons</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#IsomorphicAstrocytoma -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#IsomorphicAstrocytoma">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#OtherGlioma"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasWorldHealthOrganizationGrading"/>
