    <!-- http://www.case.edu/EpilepsyOntology.owl#GlialFibrillaryAcidicProtein -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#GlialFibrillaryAcidicProtein">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#BiologicalSubstance"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#isUsedForMarkingCellularPattern"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Astrocyte"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>GFAP</rdfs:label>
        <rdfs:label>Glial Fibrillary Acidic Protein</rdfs:label>
        <rdfs:label>http://purl.bioontology.org/ontology/SNOMEDCT/24675006</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#GlioblastomaMultiforme -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#GlioblastomaMultiforme">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Astrocytic"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAssociatedMutationIn"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#IDH1"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#IDH2"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasWorldHealthOrganizationGrading"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#WorldHealthOrganization_IV"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>GBM</rdfs:label>
        <rdfs:label>Glioblastoma Multiforme</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Glioma -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Glioma">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#BrainGlialTumor"/>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Gliosis -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Gliosis">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Astrogliosis"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


