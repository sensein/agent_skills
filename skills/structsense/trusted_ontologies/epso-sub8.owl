        <rdfs:label>Behavioral Arrest</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Bellatal -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Bellatal">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugBrandName"/>
        <synonym>RxCUI 215608</synonym>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/215608</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#BenignChildhoodEpilepsyWithCentrotemporalSpikes -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#BenignChildhoodEpilepsyWithCentrotemporalSpikes">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SingleFocalEpilepsy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasEtiology"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#GeneticDefect"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasInterIctalEpileptiformAbnormality"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#BenignFocalEpileptiformDischargeofChildhood"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasSemiologyFeature"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#ClonicSeizure"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#SomatosensoryAura"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#TonicSeizure"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAgeOfOnset"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">4</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Year"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAgeOfOnset"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">10</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Year"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Benign Childhood Epilepsy With Centrotemporal Spikes</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#BenignElectroencephalogramPattern -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#BenignElectroencephalogramPattern">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ElectroencephalogramPattern"/>
        <rdfs:label>Benign EEG Pattern</rdfs:label>
        <rdfs:label>Benign Electroencephalogram Pattern</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#BenignFocalEpileptiformDischargeofChildhood -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#BenignFocalEpileptiformDischargeofChildhood">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#InterIctalPattern"/>
        <rdfs:comment>Benign focal epileptiform discharges of childhood (BFEDC) refer to regional or multiregional sharp waves that are normally followed by a negative slow wave with lower amplitude than the negative peak of the sharp wave and ocassionally show a dipolar distribution.</rdfs:comment>
        <rdfs:label>Benign Focal Epileptiform Discharge of Childhood (BFEDC)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#BenignMyoclonicEpilepsyInInfancy -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#BenignMyoclonicEpilepsyInInfancy">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#GeneralizedEpilepsy"/>
        <rdfs:label>Benign Myoclonic Epilepsy In Infancy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#BenignNeonatalConvulsions -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#BenignNeonatalConvulsions">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#GeneralizedEpilepsy"/>
        <rdfs:label>Benign Neonatal Convulsions</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#BenignNeonatalFamilialConvulsions -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#BenignNeonatalFamilialConvulsions">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#GeneralizedEpilepsy"/>
        <rdfs:label>Benign Neonatal Familial Convulsions</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#BetaActivity -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#BetaActivity">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#NormalElectroencephalogramPattern"/>
        <rdfs:comment>Beta activity refers to activity with frequency range 13 to 30 Hz.</rdfs:comment>
        <rdfs:label>Beta Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#BetaComaPattern -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#BetaComaPattern">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SpecialPattern"/>
        <rdfs:comment>Beta coma (BC) / Beta stupor (BS) refers to predominance of beta activity with amplitudes higher than 30 uV in a comatose/stuporous patient.</rdfs:comment>
        <rdfs:label>Beta Coma</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#BetaStuporPattern -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#BetaStuporPattern">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SpecialPattern"/>
        <rdfs:comment>Beta coma (BC) / Beta stupor (BS) refers to predominance of beta activity with amplitudes higher than 30 uV in a comatose/stuporous patient.</rdfs:comment>
        <rdfs:label>Beta Stupor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Bi-PeriodicLateralizedEpileptiformDischarge -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Bi-PeriodicLateralizedEpileptiformDischarge">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#PeriodicLateralizedEpileptiformDischarge"/>
        <rdfs:comment>Periodic sharp waves that occur in both hemispheres but do so asynchronously between the two hemispheres</rdfs:comment>
        <rdfs:label>Bilateral Periodic Lateralized Epileptiform Discharge (Bi-PLED)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#BiLobarEpilepsy -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#BiLobarEpilepsy">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Epilepsy"/>
        <rdfs:label>BiLobar Epilepsy</rdfs:label>
    </owl:Class>
    


