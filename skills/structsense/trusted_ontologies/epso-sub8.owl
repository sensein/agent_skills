    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#InterictalDischarge">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#InterIctalPattern"/>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#IntermediateAnatomicalCoordinate -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#IntermediateAnatomicalCoordinate">
