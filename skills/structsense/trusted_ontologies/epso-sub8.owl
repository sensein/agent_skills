        <rdfs:label>Leucine Rich Glioma Inactivated Protein 1</rdfs:label>
        <rdfs:label>UNQ775/PRO1569</rdfs:label>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/LNC/LP230269-5</rdfs:seeAlso>
