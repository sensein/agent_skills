    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#CerebralHydatidCyst">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#CerebralCyst"/>
        <rdfs:label>Cerebral hydatid cyst</rdfs:label>
        <rdfs:label>Cerebral hydatid cyst (disorder)</rdfs:label>
