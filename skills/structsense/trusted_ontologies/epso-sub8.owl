        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasTradename"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Symbyax"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Zyprexa"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Antidepressant Drug</rdfs:comment>
        <rdfs:seeAlso>RxCUI 61381</rdfs:seeAlso>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/61381</rdfs:seeAlso>
