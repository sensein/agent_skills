            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasTradename"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Alkabel"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Bellatal"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#D-Tal"/>
