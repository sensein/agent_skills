    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#FreeLimbSegment">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#LimbSegment"/>
        <rdfs:label>Free Limb Segment</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Free_limb_segment</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#FreeLowerLimbSegment -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#FreeLowerLimbSegment">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#FreeLimbSegment"/>
        <rdfs:label>Free Lower Limb Segment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#FreeUpperLimbSegment -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#FreeUpperLimbSegment">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#FreeLimbSegment"/>
        <rdfs:comment>Free upper limb segment (Source: FMA)</rdfs:comment>
        <rdfs:label>Free Upper Limb Segment</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Free_upper_limb_segment</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Frisium -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Frisium">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugBrandName"/>
        <synonym>RxCUI 151794</synonym>
        <rdfs:comment>Treats seizures in patients who have Lennox-Gastaut syndrome (LGS). This medicine is a benzodiazepine.</rdfs:comment>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/151794</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Frontal10-10System -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Frontal10-10System">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#10-10System"/>
        <rdfs:label>Frontal 10-10 System</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#FrontalAnatomicalCoordinate -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#FrontalAnatomicalCoordinate">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AnatomicalCoordinate"/>
        <rdfs:label>Frontal</rdfs:label>
        <rdfs:seeAlso>http://purl.org/sig/ont/fma/fma74536</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#FrontalArousalRhythm -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#FrontalArousalRhythm">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#RhythmicBenignVariant"/>
        <rdfs:comment>Frontal arousal rhythm (FAR) consists of trains of 7- to 20-Hz waveforms that occur predominantly over the frontal regions in runs lasting up to 20 seconds.</rdfs:comment>
        <rdfs:label>FAR</rdfs:label>
        <rdfs:label>Frontal Arousal Rhythm</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#FrontalIntermittentRhythmicDeltaActivity -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#FrontalIntermittentRhythmicDeltaActivity">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SlowActivity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#isLocatedAt"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#FrontalLobe"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Frontal intermittent Rhythmic Delta Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#FrontalLobe -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#FrontalLobe">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#CerebralHemisphereLobe"/>
        <rdfs:comment>Frontal lobe is the anterior-most of five lobes of the cerebral hemisphere. It is bounded by the central sulcus on its posterior border and by the longitudinal cerebral fissure on its medial border. (FMA)</rdfs:comment>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Frontal_lobe</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#FrontalLobeDorsolateralZone -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#FrontalLobeDorsolateralZone">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#TelencephalonZone"/>
        <rdfs:label>Frontal Lobe Dorsolateral Zone</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Dorsolateral_zone_of_frontal_lobe</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#FrontalLobeEpilepsy -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#FrontalLobeEpilepsy">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SingleFocalEpilepsy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasEtiology"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#BrainTumor"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#FocalCorticalDysplasia"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#VascularMalformation"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasIctalEpileptiformAbnormality"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SeizurePattern"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasInterIctalEpileptiformAbnormality"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#SharpWave"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Spike"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Frontal Lobe Epilepsy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#FrontalLobeGyrus -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#FrontalLobeGyrus">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#BrainGyrus"/>
        <rdfs:label>Gyrus of frontal lobe</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Gyrus_of_frontal_lobe</rdfs:seeAlso>
    </owl:Class>
    


