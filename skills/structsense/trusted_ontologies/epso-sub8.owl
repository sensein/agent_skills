    <!-- http://www.case.edu/EpilepsyOntology.owl#BordmannArea3RightParacentralLobuleAnteriorSegment -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#BordmannArea3RightParacentralLobuleAnteriorSegment">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#BrodmannArea3ParacentralLobuleAnteriorSegment"/>
