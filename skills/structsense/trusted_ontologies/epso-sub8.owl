    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#InternalAnatomicalCoordinate">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AnatomicalCoordinate"/>
        <rdfs:seeAlso>Internal</rdfs:seeAlso>
        <rdfs:seeAlso>http://purl.org/sig/ont/fma/fma74549</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#InternalGrayMatterComponent -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#InternalGrayMatterComponent">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#NeuraxisGrayMatter"/>
        <rdfs:comment>Gray matter component of neuraxis which is located in the interior of the neuraxis. Example: thalamus, dentate nucleus, ventral horn of spinal cord. (source: FMA)</rdfs:comment>
        <rdfs:label>Internal Gray Matter Component</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Internal_gray_matter_component</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Interneuron -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Interneuron">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Neuron"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#isUsedForMarkingCellularPattern"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Interneuron"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:seeAlso>http://purl.org/sig/ont/fma/fma67313</rdfs:seeAlso>
    </owl:Class>
    


