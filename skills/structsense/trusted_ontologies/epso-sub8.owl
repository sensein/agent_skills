        <rdfs:label>37 kDa neuronal protein</rdfs:label>
        <rdfs:label>37-kDa Ma1</rdfs:label>
        <rdfs:label>MA1</rdfs:label>
        <rdfs:label>PNMA1</rdfs:label>
        <rdfs:label>Paraneoplastic Antigen Ma1</rdfs:label>
        <rdfs:label>neuron- and testis-specific protein 1</rdfs:label>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/MESH/C117985</rdfs:seeAlso>
        <rdfs:seeAlso>http://purl.obolibrary.org/obo/PR_000012929</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#ParaneoplasticAntigenMa1AssociatedEncephalitis -->

