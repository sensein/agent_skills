            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasFunction"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Endocytosis"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>AMPH</rdfs:label>
        <rdfs:label>amphiphysin I</rdfs:label>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/MESH/C075637</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AmphiphysinAssociatedEncephalitis -->

