                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAssociatedMutationIn"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#MYBL1"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>IDG</rdfs:label>
        <rdfs:label>Isomorphic diffuse glioma</rdfs:label>
    </owl:Class>
    


