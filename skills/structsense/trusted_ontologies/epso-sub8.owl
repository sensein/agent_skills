        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasNeuroPathologyFinding"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#CorticalDyslamination"/>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#BrainGlialNeuronalTumor"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#isAdjacentTo"/>
                                        <owl:allValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#BrainGlialTumor"/>
                                    </owl:Restriction>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>FCD Type IIIB (Cortical Lamination Adjacent to a Glial or Glioneuronal Tumor)</rdfs:comment>
        <rdfs:label>FCD Type IIIB</rdfs:label>
        <rdfs:label>Focal Cortical Dysplasia Type IIIB</rdfs:label>
    </owl:Class>
    


