        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#InterIctalPattern"/>
        <rdfs:comment>Artifact-obscured EEG (AOE) refers to an ictal record that is obscured by artifacts, thereby making its interpretation difficult or impossible.</rdfs:comment>
        <rdfs:label>Artifact Obscured EEG (AOE)</rdfs:label>
    </owl:Class>
    


