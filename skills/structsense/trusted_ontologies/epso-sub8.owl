    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#ElementaryAuditoryAura -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#ElementaryAuditoryAura">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AuditoryAura"/>
