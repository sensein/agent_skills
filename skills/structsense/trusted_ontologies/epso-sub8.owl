    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#HypermotorStatus">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ComplexMotorStatus"/>
        <rdfs:comment>Hyperkinetic status epilepticus (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:label>Hypermotor Status</rdfs:label>
    </owl:Class>
    


