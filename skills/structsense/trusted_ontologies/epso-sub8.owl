            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasTradename"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Serzone"/>
