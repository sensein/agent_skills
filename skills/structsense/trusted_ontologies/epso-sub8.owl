    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Banzel">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugBrandName"/>
        <synonym>RxCUI 824296</synonym>
        <rdfs:comment>Treats seizures in patients who have Lennox-Gastaut syndrome (LGS).</rdfs:comment>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/824296</rdfs:seeAlso>
    </owl:Class>
    


