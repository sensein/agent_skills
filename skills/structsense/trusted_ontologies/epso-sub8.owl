            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Ma1AssociatedEncephalitis</rdfs:label>
        <rdfs:label>Paraneoplastic Antigen Ma1 Associated Encephalitis</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#ParaneoplasticAntigenMa2 -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#ParaneoplasticAntigenMa2">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#BiologicalSubstance"/>
        <rdfs:label>40 kDa neuronal protein</rdfs:label>
        <rdfs:label>KIAA0883</rdfs:label>
        <rdfs:label>MA2</rdfs:label>
        <rdfs:label>PNMA2</rdfs:label>
        <rdfs:label>Paraneoplastic antigen Ma2</rdfs:label>
        <rdfs:label>onconeuronal antigen Ma2</rdfs:label>
        <rdfs:label>paraneoplastic neuronal antigen MM2</rdfs:label>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/MESH/C119249</rdfs:seeAlso>
        <rdfs:seeAlso>http://purl.obolibrary.org/obo/PR_000012930</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#ParaneoplasticAntigenMa2AssociatedEncephalitis -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#ParaneoplasticAntigenMa2AssociatedEncephalitis">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AntibodyAssociatedEncephalitis"/>
        <rdfs:subClassOf>
