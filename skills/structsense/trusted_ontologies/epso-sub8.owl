    <!-- http://www.case.edu/EpilepsyOntology.owl#Treatment -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Treatment">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ClinicalCareManagement"/>
        <rdfs:label>Therapy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Trifluoperazine -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Trifluoperazine">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugIngredient"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasTradename"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Stelazine"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Antidepressant Drug</rdfs:comment>
        <rdfs:isDefinedBy>Treats psychotic disorders and anxiety. Sometimes given for nausea and vomiting caused by chemotherapy. Belongs to a class of drugs called phenothiazines.</rdfs:isDefinedBy>
        <rdfs:seeAlso>RxCUI 10800</rdfs:seeAlso>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/10800</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Triflupromazine -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Triflupromazine">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugIngredient"/>
        <rdfs:comment>Antidepressant Drug</rdfs:comment>
        <rdfs:isDefinedBy>Triflupromazine is an antipsychotic medication of the phenothiazine class. Among different effects of triflupromazine indication for use of this drug is severe emesis. Due to its potential side effects it is not gold standard in antiemetic therapy.</rdfs:isDefinedBy>
        <rdfs:seeAlso>RxCUI 10805</rdfs:seeAlso>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/10805</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Trilafon -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Trilafon">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugBrandName"/>
        <synonym>RxCUI 202730</synonym>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/202730</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Trileptal -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Trileptal">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugBrandName"/>
        <synonym>RxCUI 261680</synonym>
        <rdfs:comment>Used alone or together with other medicines to treat seizures caused by epilepsy in adults and children 2 years of age and older.</rdfs:comment>
        <rdfs:label>Trileptal®</rdfs:label>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/261680</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#TriphasicWave -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#TriphasicWave">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SpecialPattern"/>
        <rdfs:comment>Triphasic waves (TW) refer to high amplitude (&gt; 70 uV) positive sharp transients which are preceded and followed by relatively low-amplitude negative waves.</rdfs:comment>
        <rdfs:label>Triphasic Wave</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Trunk -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Trunk">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#BodyProperSubdivision"/>
        <rdfs:comment>Subdivision of body proper, which consists of a maximal set of diverse subclasses of organ and organ part spatially associated with the ribcage, thoracic and lumbar vertebral column, sacrum and coccyx, it is partially surrounded by skin of trunk. Examples: There is only one trunk. (source: FMA)</rdfs:comment>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Trunk</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#TuberCinereum -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#TuberCinereum">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DiencephalonZone"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sig.uw.edu/fma#regional_part_of"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#IntermediateHypothalamicRegion"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The tuber cinereum is a hollow eminence of gray matter situated between the mammilary bodies and the optic chiasm. The tuber cinereum is part of the hypothalamus.</rdfs:comment>
        <rdfs:label>Tuber Cinereum</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Tuber_cinereum</rdfs:seeAlso>
    </owl:Class>
    


