    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#BasalOccipitalLobeSegment">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#OccipitalLobeSegment"/>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#BasalTemporalEpilepsy -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#BasalTemporalEpilepsy">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#TemporalLobeEpilepsy"/>
        <rdfs:label>Basal Temporal Epilepsy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#BasalTemporalLobeSegment -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#BasalTemporalLobeSegment">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#TemporalLobeSegment"/>
        <rdfs:label>Basal Temporal</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Basilar -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Basilar">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AnatomicalCoordinate"/>
        <rdfs:seeAlso>http://purl.org/sig/ont/fma/fma74543</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Basophil -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Basophil">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#GranularLeukocyte"/>
        <rdfs:label>Mature Basophil</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Bedwetting -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Bedwetting">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SleepDisorder"/>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#BehavioralArrest -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#BehavioralArrest">
