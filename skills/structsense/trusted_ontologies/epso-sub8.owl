    <!-- http://www.case.edu/EpilepsyOntology.owl#AlphaComaPattern -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AlphaComaPattern">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SpecialPattern"/>
        <rdfs:comment>Alpha coma / Alpha stupor (AS) refers to EEG of a comatose/stuporous patient in which alpha activity predominates.</rdfs:comment>
        <rdfs:label>Alpha Coma</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AlphaRhythm -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AlphaRhythm">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#NormalElectroencephalogramPattern"/>
        <rdfs:comment>Alpha rhythm is the initial starting point for visual analysis of EEG, originates from occipital region of brain and has a frequency of 8 to 13 Hertz in adults.</rdfs:comment>
        <rdfs:label>Alpha Rhythm</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AlphaStuporPattern -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AlphaStuporPattern">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SpecialPattern"/>
        <rdfs:comment>Alpha coma / Alpha stupor (AS) refers to EEG of a comatose/stuporous patient in which alpha activity predominates.</rdfs:comment>
        <rdfs:label>Alpha Stupor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AlphaVariant -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AlphaVariant">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#RhythmicBenignVariant"/>
        <rdfs:comment>Alpha variant consists of activity over the posterior head regions that have a harmonic relationship to the alpha rhythm and show similar activity and distribution.</rdfs:comment>
        <rdfs:label>Alpha Variant</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AlteredLevelOfConsciousnessState -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AlteredLevelOfConsciousnessState">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SeizureConsciousnessState"/>
        <rdfs:comment>Altered Level Of Consciousness refers to relative unresponsiveness with postictal amnesia for the events that happened during the seizure.</rdfs:comment>
        <rdfs:label>Altered Level Of Consciousness</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Amaurosis -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Amaurosis">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#VisualAura"/>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AmaurosisStatus -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AmaurosisStatus">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#VisualAuraStatus"/>
        <rdfs:comment>Focal Onset (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:comment>Non-convulsive status epilepticus without coma (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:label>Amaurosis Status</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Amisulpride -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Amisulpride">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugIngredient"/>
        <rdfs:comment>Antidepressant Drug</rdfs:comment>
        <rdfs:seeAlso>RxCUI 46303</rdfs:seeAlso>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/46303</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Amitriptyline -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Amitriptyline">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugIngredient"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasPreciseDrugIngredient"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#AmitriptylineHydrochloride"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#AmitriptylineOxide"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#AmitriptylinePamoate"/>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasTradename"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Elavil"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Etrafon"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Limbitrol"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Vanatrip"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Neuroleptic Drug</rdfs:comment>
        <rdfs:seeAlso>RxCUI 704</rdfs:seeAlso>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/704</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AmitriptylineHydrochloride -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AmitriptylineHydrochloride">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#PreciseDrugIngredient"/>
        <rdfs:label>Amitriptyline Hydrochloride</rdfs:label>
        <rdfs:seeAlso>RxCUI 203168</rdfs:seeAlso>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/203168</rdfs:seeAlso>
