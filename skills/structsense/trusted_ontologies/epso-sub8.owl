    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#IntralaminarNuclearGroupThalamusSegment -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#IntralaminarNuclearGroupThalamusSegment">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ThalamusSegment"/>
