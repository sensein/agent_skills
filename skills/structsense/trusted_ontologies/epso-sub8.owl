    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Adolescent -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Adolescent">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#HumanBeing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasRecordedAge"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">13</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Year"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasRecordedAge"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">18</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Year"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>the period between puberty and the completion of physical growth, roughly from 11 to 19 years of age</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Adult -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Adult">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#HumanBeing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasRecordedAge"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">19</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Year"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>having attained full growth or maturity, or an organism that has done so.</rdfs:comment>
    </owl:Class>
    


