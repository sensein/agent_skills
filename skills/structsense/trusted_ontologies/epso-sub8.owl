        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#FocalEpileptogenicZone"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#isLocatedAt"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#LeftCerebralHemisphere"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#RightCerebralHemisphere"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Hemisphere</rdfs:label>
        <rdfs:label>Hemispheric Epileptogenic Zone</rdfs:label>
    </owl:Class>
    


