                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#PsychicAura"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Amygdalar Epilepsy</rdfs:label>
    </owl:Class>
    


