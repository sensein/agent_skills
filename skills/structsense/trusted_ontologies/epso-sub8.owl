    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AuditoryFrontocentralP200">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ScalpRecordedERPExtractedPattern"/>
        <rdfs:label>Auditory Frontocentral P200</rdfs:label>
        <rdfs:label>auditory_frontocentral_P200</rdfs:label>
        <rdfs:seeAlso>http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_3553000</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AuditoryN2b -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AuditoryN2b">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ScalpRecordedERPExtractedPattern"/>
        <rdfs:label>Auditory N2b</rdfs:label>
        <rdfs:seeAlso>http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0035000</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AuditoryStimulus -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AuditoryStimulus">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Stimulus"/>
        <rdfs:label>Auditory stimulus</rdfs:label>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/SNOMEDCT/278275007</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Aura -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Aura">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#EpilepticSeizure"/>
        <rdfs:comment>An aura is the perceptual disturbance experienced by epileptic patient and not detectable by an observer.</rdfs:comment>
        <rdfs:comment>Focal Onset (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:comment>Nonmotor Onset (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:comment>Unclassified (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:comment>Unknown Onset (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:label>Non-Specific Aura</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AuraStatus -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AuraStatus">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#StatusEpilepticus"/>
        <rdfs:comment>Focal Onset (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:comment>Non-convulsive status epilepticus without coma (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:label>Aura status</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AutismSpectrumDisorder -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AutismSpectrumDisorder">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#GeneralLearningDisability"/>
        <rdfs:label>Autism Spectrum Disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Automatism -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Automatism">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#LateralizingSign"/>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AutomatismwithPreservedResponsiveness -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AutomatismwithPreservedResponsiveness">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Automatism"/>
        <rdfs:label>Automatism with Preserved Responsiveness</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AutomatismwithoutPreservedResponsiveness -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AutomatismwithoutPreservedResponsiveness">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Automatism"/>
        <rdfs:label>Automatism without Preserved Responsiveness</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AutomotorEpisode -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AutomotorEpisode">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ComplexMotorEpisode"/>
        <rdfs:label>Automotor Episode</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AutomotorSeizure -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AutomotorSeizure">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ComplexMotorSeizure"/>
        <rdfs:comment>Automotor seizures are complex motor seizures characterized primarily by automatisms of the distal segments of body, including in particular the fingers, hands, tongue and lips.</rdfs:comment>
        <rdfs:label>Automotor Seizure</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AutomotorStatus -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AutomotorStatus">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ComplexMotorStatus"/>
        <rdfs:label>Automotor Status</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AutonomicAura -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AutonomicAura">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Aura"/>
        <rdfs:comment>A term used to denote a type of *aura that manifests itself as an autonomic alteration such as palpitations or &apos;hot flashes&apos;, without any objective proof of an autonomic disturbance.</rdfs:comment>
        <rdfs:comment>Autonomic (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:label>Autonomic Aura</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AutonomicAuraStatus -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AutonomicAuraStatus">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AuraStatus"/>
        <rdfs:comment>Focal Onset (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:comment>Non-convulsive status epilepticus without coma (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:label>Autonomic Aura Status</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AutonomicDysfunction -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AutonomicDysfunction">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Etiology"/>
        <rdfs:label>Autonomic Dysfunction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AutonomicEpisode -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AutonomicEpisode">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#NonEpilepticSeizure"/>
        <rdfs:label>Autonomic Episode</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AutonomicSeizure -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AutonomicSeizure">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#EpilepticSeizure"/>
        <rdfs:comment>Autonomic (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:comment>Autonomic seizures are epileptic seizures which have objectively documented autonomic signs as main ictal symptoms.</rdfs:comment>
        <rdfs:label>Autonomic Seizure</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AutonomicStatus -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AutonomicStatus">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#StatusEpilepticus"/>
        <rdfs:comment>Autonomics status epilepticus (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:comment>Focal Onset (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:comment>Generalized Onset (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:comment>Non-convulsive status epilepticus without coma (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:comment>Unknown Onset (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:label>Autonomic Status</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AutosomalDominantNocturnalFrontalLobeEpilepsy -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AutosomalDominantNocturnalFrontalLobeEpilepsy">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SingleFocalEpilepsy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAgeOfOnset"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Child"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAssociatedDisorder"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#GeneralLearningDisability"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAssociatedMutationIn"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#CHRNA2"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#CHRNA4"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#CHRNB2"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasEtiology"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#GeneticMutation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasIctalEpileptiformAbnormality"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SeizurePattern"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasInterIctalEpileptiformAbnormality"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#PolySpikes"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#SharpWave"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Spike"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasPreferredMedication"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Zonisamide"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasSemiologyFeature"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#HypermotorSeizure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>ADNFLE</rdfs:label>
        <rdfs:label>Autosomal Dominant Nocturnal Frontal Lobe Epilepsy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AutosomalDominantPartialEpilepsyWithAuditoryFeatures -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AutosomalDominantPartialEpilepsyWithAuditoryFeatures">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SingleFocalEpilepsy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAssociatedMutationIn"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#LGI1"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasEtiology"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#GeneticMutation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasIctalEpileptiformAbnormality"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SeizurePattern"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasInterIctalEpileptiformAbnormality"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#SharpWave"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Spike"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasPreferredMedication"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Phenytoin"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Valproate"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasSemiologyFeature"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#AphasicSeizure"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#AuditoryAura"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAgeOfOnset"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">4</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Year"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAgeOfOnset"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">50</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Year"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>ADPEAF</rdfs:label>
        <rdfs:label>Autosomal Dominant Partial Epilepsy With Auditory Features</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AveragedEEGData -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AveragedEEGData">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ElectroencephalographyData"/>
        <rdfs:label>Averaged EEG Data</rdfs:label>
        <rdfs:seeAlso>http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0000495</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Axial -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Axial">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AnatomicalCoordinate"/>
        <rdfs:seeAlso>http://purl.org/sig/ont/fma/fma74547</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#BCell -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#BCell">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Lymphocyte"/>
        <rdfs:label>B Cell</rdfs:label>
        <rdfs:label>B Lymphocyte</rdfs:label>
        <rdfs:label>lymphocyte of B lineage</rdfs:label>
        <rdfs:seeAlso>http://purl.obolibrary.org/obo/CL_0000945</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#BRAF -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#BRAF">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Gene"/>
        <rdfs:label>B-Raf proto-oncogene</rdfs:label>
        <rdfs:seeAlso>https://www.ncbi.nlm.nih.gov/gene/673</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Baboon -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Baboon">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#NonHumanPrimate"/>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#BackgroundSlowActivity -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#BackgroundSlowActivity">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SlowActivity"/>
        <rdfs:comment>Continuous slow (CS) refers to the activity that occurs continuously (&gt;80% of the time), is non-responsive to external stimuli, and clearly exceeds the amount considered physiologically normal for the patient&apos;s age.</rdfs:comment>
        <rdfs:label>Background Slow</rdfs:label>
        <rdfs:label>Background Slow Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#BackgroundSuppression -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#BackgroundSuppression">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SpecialPattern"/>
        <rdfs:comment>Background suppression (BS) refers to activity which is less than 10 uV (reference derivation).</rdfs:comment>
        <rdfs:label>Background Suppression</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#BalloonCell -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#BalloonCell">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#RadialGlialCell"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#isMarkedBy"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Phosphor-S6RibosomalProtein"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Vimentin"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Reference: Balloon cells derive from radial glial progenitor cells (https://academic.oup.com/brain/article/130/9/2267/291780)</rdfs:comment>
        <rdfs:label>Balloon Cell</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#BandHeterotopia -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#BandHeterotopia">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Heterotopia"/>
        <rdfs:label>Band Heterotopia</rdfs:label>
    </owl:Class>
    


