        <rdfs:label>Leukoencephalopathy co-occurrent with bilateral anterior temporal lobe cysts (disorder)</rdfs:label>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/SNOMEDCT/719403003</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Levetiracetam -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Levetiracetam">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugIngredient"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasTradename"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Keppra"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#KeppraXR"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Anti seizure medication</rdfs:comment>
        <rdfs:comment>Antiepileptic Drug</rdfs:comment>
        <rdfs:isDefinedBy>Used to help control certain types of seizures caused by epilepsy. This medicine is an antiepileptic.</rdfs:isDefinedBy>
        <rdfs:seeAlso>RxCUI 114477</rdfs:seeAlso>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/114477</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#LevomepromazineMaleate -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#LevomepromazineMaleate">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#PreciseDrugIngredient"/>
        <synonym>RxCUI 160372</synonym>
        <rdfs:comment>Levomepromazine in Germany and Methotrimeprazine in America is an aliphatic phenothiazine neuroleptic drug. It is a low-potency antipsychotic with strong analgesic and antiemetic properties.</rdfs:comment>
        <rdfs:label>Levomepromazine Maleate</rdfs:label>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/160372</rdfs:seeAlso>
    </owl:Class>
    


