    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#MuRhythm">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#NormalElectroencephalogramPattern"/>
        <rdfs:comment>Mu rhythm refers to central rhythm of alpha activity frequency (usually 8 to 10 hz) in which the individual waves have an arch like shape.</rdfs:comment>
        <rdfs:label>Mu Rhythm</rdfs:label>
    </owl:Class>
    


