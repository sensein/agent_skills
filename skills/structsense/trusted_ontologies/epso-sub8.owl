    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#DialepticEpisode">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#NonEpilepticSeizure"/>
        <rdfs:label>Dialeptic Episode</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#DialepticSeizure -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#DialepticSeizure">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#EpilepticSeizure"/>
        <rdfs:comment>Dialeptic seizures have alteration or loss of consciousness as the main ictal manifestation usually without loss of postural tone</rdfs:comment>
        <rdfs:comment>Nonmotor (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:label>Dialeptic Seizure</rdfs:label>
        <rdfs:label>Impaired Awareness</rdfs:label>
    </owl:Class>
    


