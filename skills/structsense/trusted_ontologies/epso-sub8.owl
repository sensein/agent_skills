        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#FocalCorticalDysplasiaTypeIII"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasNeuroPathologyFinding"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#CorticalDyslamination"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#isLocatedAt"/>
                                        <owl:allValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#TemporalLobe"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#isAdjacentTo"/>
                        <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#HippocampalSclerosis"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>FCD Type IIIA (Cortical Lamination Abnormality in the Temporal Lobe Associated with Hippocampal Sclerosis)</rdfs:comment>
        <rdfs:label>FCD Type IIIA</rdfs:label>
        <rdfs:label>Focal Cortical Dysplasia Type IIIA</rdfs:label>
    </owl:Class>
    


