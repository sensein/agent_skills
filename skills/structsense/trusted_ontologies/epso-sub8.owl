            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAssociatedAntigen"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Amphiphysin"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>AMPH Associated Encephalitis</rdfs:label>
        <rdfs:label>AMPHAssociatedEncephalitis</rdfs:label>
        <rdfs:label>Amphiphysin Associated Encephalitis</rdfs:label>
    </owl:Class>
    


