                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Oligoastrocytoma</rdfs:label>
    </owl:Class>
    


