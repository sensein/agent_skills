            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Lateralizing Sign refers to the sign that helps in lateralizing the epileptogenic zone.</rdfs:comment>
        <rdfs:label>Lateralizing Sign</rdfs:label>
    </owl:Class>
    


