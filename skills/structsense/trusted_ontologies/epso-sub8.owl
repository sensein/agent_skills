            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasNeuroPathologyFinding"/>
                        <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#LossofMyelination"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasNeuroPathologyFinding"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#BalloonCell"/>
                                    <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#DysmorphicNeurons"/>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
