    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PleomorhicXanthoastrocytoma">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#OtherAstrocyticTumor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasWorldHealthOrganizationGrading"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#WorldHealthOrganization_II"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#WorldHealthOrganization_III"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>PXA</rdfs:label>
        <rdfs:label>Pleomorhic Xanthoastrocytoma</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Pneumonia -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Pneumonia">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#PrematureMortality"/>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PolySpikes -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PolySpikes">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#InterictalDischarge"/>
        <rdfs:comment>Polyspikes (PSP) refer to a pattern consisting of groups of three or more spikes appearing one after another with a frequency of more than 10 Hz.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Polymicrogyria -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Polymicrogyria">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#CorticalDevelopmentMalformation"/>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PolymorphousLow-gradeNeuroepithelialTumoroftheYoung -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PolymorphousLow-gradeNeuroepithelialTumoroftheYoung">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Oligodendroglial"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAssociatedMutationIn"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#BRAF"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#FGFR"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasWorldHealthOrganizationGrading"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#WorldHealthOrganization_I"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>PLNTY</rdfs:label>
        <rdfs:label>Polymorphous Low-grade Neuroepithelial Tumor of the Young</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Polyopia -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Polyopia">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#VisualIllusion"/>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PolyopiaStatus -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PolyopiaStatus">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#VisualIllusionStatus"/>
        <rdfs:comment>Focal Onset (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:comment>Non-convulsive status epilepticus without coma (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:label>Polyopia Status</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PonsNeuralTissue -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PonsNeuralTissue">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#BrainNeuralTissueSegment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sig.uw.edu/fma#regional_part_of"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Metencephalon"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Fmaid 268533</rdfs:comment>
        <rdfs:label>Pons Neural Tissue</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Neural_tissue_of_pons</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PontineTegmentumPostremaArea -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PontineTegmentumPostremaArea">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#MetencephalonZone"/>
        <rdfs:label>Pontine Tegmentum Postrema Area</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Area_postrema_in_pontine_tegmentum</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PontocerebellarTrigone -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PontocerebellarTrigone">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#MetencephalonZone"/>
        <rdfs:label>Pontocerebellar Trigone</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Pontocerebellar_trigone</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PorencephalicCyst -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PorencephalicCyst">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#CerebralCyst"/>
        <rdfs:label>Porencephalic cyst (disorder)</rdfs:label>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/SNOMEDCT/65705009</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PositiveMagneticResonanceImagingFinding -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PositiveMagneticResonanceImagingFinding">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#RadiologicalExaminationFinding"/>
        <rdfs:comment>Similar to SNOMED CT class positive genetic finding (http://purl.bioontology.org/ontology/SNOMEDCT/412731001)</rdfs:comment>
        <rdfs:label>Positive Magnetic Resonance Imaging Finding</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PositronEmissionTomography -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PositronEmissionTomography">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#NuclearMedicineImaging"/>
        <rdfs:label>PET</rdfs:label>
        <rdfs:label>Positron Emission Tomography</rdfs:label>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/SNOMEDCT/82918005</rdfs:seeAlso>
        <rdfs:seeAlso>http://radlex.org/RID/RID10337</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PossibleSuddenUnexpectedDeathinEpilepsy -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PossibleSuddenUnexpectedDeathinEpilepsy">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SuddenUnexpectedDeathinEpilepsy"/>
        <rdfs:label>Possible SUDEP</rdfs:label>
        <rdfs:label>Possible Sudden Unexpected Death in Epilepsy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PostIctal -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PostIctal">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ElectroencephalogramFinding"/>
        <rdfs:label>Post Ictal</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PostIctalApnea -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PostIctalApnea">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#InducedApnea"/>
        <rdfs:label>Post Ictal Apnea</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PosteriorCingulateEpilepsy -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PosteriorCingulateEpilepsy">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#CingulateEpilepsy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasIctalEpileptiformAbnormality"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SeizurePattern"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasIctalOnsetZone"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#TemporalLobe"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasInterIctalEpileptiformAbnormality"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#SharpWave"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Spike"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasSemiologyFeature"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#AbdominalAura"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#AutomotorSeizure"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#DialepticSeizure"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#PsychicAura"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#SimpleMotorSeizure"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Posterior Cingulate Epilepsy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PosteriorCingulateSegment -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PosteriorCingulateSegment">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#CingulateSegment"/>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PosteriorCranialFossa -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PosteriorCranialFossa">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#CranialFossa"/>
        <rdfs:label>Posterior Cranial Fossa</rdfs:label>
        <rdfs:seeAlso>http://purl.org/sig/ont/fma/fma54368</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PosteriorFrontalLobeSegment -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PosteriorFrontalLobeSegment">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#FrontalLobeSegment"/>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PosteriorHypothalamicRegionSegment -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PosteriorHypothalamicRegionSegment">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#HypothalamusSegment"/>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Segment_of_posterior_hypothalamic_region</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PosteriorHypothalamicZone -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PosteriorHypothalamicZone">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#HypothalamusZone"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sig.uw.edu/fma#receives_input_from"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#LateralHypothalamicRegion"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Posterior Hypothalamic Zone</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Posterior_hypothalamic_region</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PosteriorMedianEminence -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PosteriorMedianEminence">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DiencephalonZone"/>
        <rdfs:label>Posterior Median Eminence</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Posterior_median_eminence</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PosteriorNuclearGroupThalamusSegment -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PosteriorNuclearGroupThalamusSegment">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ThalamusSegment"/>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Segment_of_posterior_nuclear_group_of_thalamus</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PosteriorParacentralGyrus -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PosteriorParacentralGyrus">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#BrainGyrus"/>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Posterior_paracentral_gyrus</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PosteriorSlowWavesofYouth -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PosteriorSlowWavesofYouth">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#NormalElectroencephalogramPattern"/>
        <rdfs:comment>Posterior slow waves of youth, also referred to as single delta frequency waves, referes to 2.5 to 4.5 Hz waves occuring in the posterior head regions of children and adolescents.</rdfs:comment>
        <rdfs:label>Posterior Slow Waves of Youth</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PosteriorTemporalEpilepsy -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PosteriorTemporalEpilepsy">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#TemporalLobeEpilepsy"/>
        <rdfs:label>Posterior Temporal Epilepsy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PosteriorTemporalLobeSegment -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PosteriorTemporalLobeSegment">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#TemporalLobeSegment"/>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PosteriorTransverseTemporalGyrus -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PosteriorTransverseTemporalGyrus">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#TemporalLobeGyrus"/>
        <rdfs:label>Posterior transverse temporal convolution of Heschl</rdfs:label>
        <rdfs:label>Posterior transverse temporal gyrus</rdfs:label>
        <rdfs:seeAlso>http://purl.org/sig/ont/fma/fma61910</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PosterotemporalN2c -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PosterotemporalN2c">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ScalpRecordedERPExtractedPattern"/>
        <rdfs:label>Posterotemporal N2c</rdfs:label>
        <rdfs:seeAlso>http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_0000096</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PostictalAphasia -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PostictalAphasia">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#LateralizingSign"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#occursAt"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#PostIctal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Postictal aphasia is impairment of speech during or after episode of seizure.</rdfs:comment>
        <rdfs:label>Postictal Aphasia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PostictalMemoryDysfunction -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PostictalMemoryDysfunction">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#LateralizingSign"/>
        <rdfs:label>Postictal Memory Dysfunction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PostictalNoseWiping -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PostictalNoseWiping">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#LateralizingSign"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#makesUseOf"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#LeftHand"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#RightHand"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Postictal Nose Wiping</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PostictalToddsParalysis -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PostictalToddsParalysis">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#LateralizingSign"/>
        <rdfs:comment>Postictal todd&apos;s paralysis refers to the focal weakness occuring in a part of body after seizure.</rdfs:comment>
        <rdfs:label>Postictal Todd&apos;s Paralysis</rdfs:label>
    </owl:Class>
    


