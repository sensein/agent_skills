    <!-- http://www.case.edu/EpilepsyOntology.owl#Astrocytoma -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Astrocytoma">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Astrocytic"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAssociatedMutationIn"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#IDH1"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#IDH2"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAssociatedMutationIn"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#WorldHealthOrganization_II"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#WorldHealthOrganization_III"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#WorldHealthOrganization_IV"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


