    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#TonicSeizureEnd">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#TonicSeizure"/>
        <rdfs:label>Tonic Seizure End</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#TonicSeizureOnset -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#TonicSeizureOnset">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#TonicSeizure"/>
        <rdfs:label>Onset of Generalized Tonic Phase</rdfs:label>
        <rdfs:label>Tonic Seizure Onset</rdfs:label>
    </owl:Class>
    


