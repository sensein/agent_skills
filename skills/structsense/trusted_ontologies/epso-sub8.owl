        <rdfs:label>Parieto Occipital Epilepsy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Paroxetine -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Paroxetine">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugIngredient"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasTradename"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Brisdelle"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Paxil"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Pexeva"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Neuroleptic Drug</rdfs:comment>
        <rdfs:seeAlso>RxCUI 32937</rdfs:seeAlso>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/32937</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#ParoxysmalEvent -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#ParoxysmalEvent">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#PhysiologicalPathologicalProcess"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasDuration"/>
                <owl:someValuesFrom rdf:resource="http://www.ifomis.org/bfo/1.1#TemporalEntity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#isLocatedAt"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#HumanBodyPart"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#occursAt"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Death"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Events are short, sudden, frequent and stereotyped symptoms that can be observed in various clinical conditions including epilepsy. Paroxysmal event refers to the seizures that cannot be classified with sufficient certainity as epileptic or nonepileptic.</rdfs:comment>
        <rdfs:label>Paroxysmal Event</rdfs:label>
        <rdfs:label>Seizure Semiology</rdfs:label>
    </owl:Class>
    


