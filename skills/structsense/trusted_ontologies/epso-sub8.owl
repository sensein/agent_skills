        <rdfs:label>Forebrain Segment</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Segment_of_forebrain</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Forfivo -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Forfivo">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugBrandName"/>
        <rdfs:seeAlso>RxCUI 1232586</rdfs:seeAlso>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/1232586</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Fosphenytoin -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Fosphenytoin">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugIngredient"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasTradename"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Cerebyx"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Sesquient"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Antiepileptic drug</rdfs:comment>
        <rdfs:seeAlso>RxCUI 72236</rdfs:seeAlso>
        <rdfs:seeAlso>https://mor.nlm.nih.gov/RxNav/search?searchBy=String&amp;searchTerm=fosphenytoin</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Fourteen-SixHertzPositiveBurst -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Fourteen-SixHertzPositiveBurst">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#EpileptiformBenignVariant"/>
        <rdfs:comment>Fourteen and six-hertz positive bursts consist of short trains of arch-shaped waveforms with alternating postive spiky components and a negative, smooth, rounded waveforms that occur at a rate of 14 Hz or 6-7 Hz and last from 0.5 to 1 second.</rdfs:comment>
        <rdfs:label>Fourteen-Six Hertz Positive Burst</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#FourthToe -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#FourthToe">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Toe"/>
        <rdfs:label>Fourth Toe</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Fourth_toe</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#FrameshiftVariant -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#FrameshiftVariant">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#MolecularConsequence"/>
        <rdfs:label>Frameshift</rdfs:label>
        <rdfs:label>Frameshift Variant</rdfs:label>
        <rdfs:label>frameshift_variant</rdfs:label>
        <rdfs:seeAlso>http://www.sequenceontology.org/browser/current_svn/term/SO:0001589</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#FreeGamma-aminobutyricAcid -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#FreeGamma-aminobutyricAcid">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#BiologicalSubstance"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasFunction"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#NeuroTransmitter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Free gamma-aminobutyric acid</rdfs:label>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/SNOMEDCT/706946000</rdfs:seeAlso>
    </owl:Class>
    


