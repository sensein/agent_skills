    <!-- http://www.case.edu/EpilepsyOntology.owl#AbdominalAura -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AbdominalAura">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Aura"/>
        <rdfs:comment>Abdominal aura is used to denote a type of somatosensory or somaesthetic aura that typically manifests itself as a rising epigastric sensation.</rdfs:comment>
        <rdfs:comment>Autonomic (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:label>Abdominal Aura</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AbdominalAuraStatus -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AbdominalAuraStatus">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AuraStatus"/>
        <rdfs:comment>Focal Onset (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:comment>Non-convulsive status epilepticus without coma (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:label>Abdominal Aura Status</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Abilify -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Abilify">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugBrandName"/>
        <synonym>RxCUI 352393</synonym>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/352393</rdfs:seeAlso>
