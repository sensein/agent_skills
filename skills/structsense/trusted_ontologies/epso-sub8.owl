                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Zonegran"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Anti seizure medication</rdfs:comment>
        <rdfs:comment>Antiepileptic Drug</rdfs:comment>
        <rdfs:isDefinedBy>Treats partial seizures in adults with epilepsy. May be used together with other anti-seizure medicines. Belongs to a class of drugs called sulfonamides (sulfa drugs).</rdfs:isDefinedBy>
