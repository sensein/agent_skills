    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#EndocrineResponseToTheImmobilizationStress -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#EndocrineResponseToTheImmobilizationStress">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ModelSystemDepressionScale"/>
        <rdfs:label>Endocrine response to the immobilization stress</rdfs:label>
        <rdfs:label>IMS</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Endocytosis -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Endocytosis">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ProteinFunction"/>
        <rdfs:comment>&quot;A vesicle-mediated transport process in which cells take up external materials or membrane constituents by the invagination of a small region of the plasma membrane to form a new membrane-bounded vesicle.&quot; (Gene Ontology)</rdfs:comment>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/MESH/D004705</rdfs:seeAlso>
        <rdfs:seeAlso>http://purl.obolibrary.org/obo/GO_0006897</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#EndothelialCell -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#EndothelialCell">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Cell"/>
        <rdfs:label>Endothelial Cell</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Eosinophil -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Eosinophil">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#GranularLeukocyte"/>
        <rdfs:label>mature eosinocyte</rdfs:label>
        <rdfs:label>mature eosinophil leucocyte</rdfs:label>
        <rdfs:label>polymorphonuclear leucocyte</rdfs:label>
        <rdfs:label>polymorphonuclear leukocyte</rdfs:label>
        <rdfs:seeAlso>http://purl.obolibrary.org/obo/CL_0000041</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#EpendymalTumor -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#EpendymalTumor">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#NonDiffuseGlioma"/>
        <rdfs:label>Ependymal Tumor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Ependymoma -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Ependymoma">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#EpendymalTumor"/>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#EpendymomaRELA-FusionPositive -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#EpendymomaRELA-FusionPositive">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#EpendymalTumor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAssociatedMutationIn"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#RELA"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasWorldHealthOrganizationGrading"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#WorldHealthOrganization_III"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Ependymoma RELA-Fusion Positive</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Epidiolex -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Epidiolex">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugBrandName"/>
        <rdfs:comment>Antiepileptic drug</rdfs:comment>
        <rdfs:seeAlso>RxCUI 2058901</rdfs:seeAlso>
        <rdfs:seeAlso>https://mor.nlm.nih.gov/RxNav/search?searchBy=String&amp;searchTerm=epidiolex</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Epilepsy -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Epilepsy">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Disease"/>
        <rdfs:comment>&quot;A disorder characterized by recurrent seizures.&quot; (SNOMED CT)</rdfs:comment>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/SNOMEDCT/84757009</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#EpilepsyOfInfancyWithMigratingFocalSeizures -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#EpilepsyOfInfancyWithMigratingFocalSeizures">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#MultiFocalEpilepsy"/>
        <rdfs:label>Epilepsy Of Infancy With Migrating Focal Seizures</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#EpilepsySurgery -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#EpilepsySurgery">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Treatment"/>
        <rdfs:label>Epilepsy Surgery</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#EpilepsyWithContinuousSpike-wavesDuringSlow-waveSleep -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#EpilepsyWithContinuousSpike-wavesDuringSlow-waveSleep">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#UndeterminedEpilepsy"/>
        <rdfs:label>Epilepsy With Continuous Spike-waves During Slow-wave Sleep</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#EpilepsyWithGeneralTonicClonicSeizureOnAwakening -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#EpilepsyWithGeneralTonicClonicSeizureOnAwakening">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#GeneralizedEpilepsy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAssociatedMutationIn"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#EFHC1"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasEtiology"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#GeneticDefect"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasIctalEpileptiformAbnormality"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#PolySpikes"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Spike"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasInterIctalEpileptiformAbnormality"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#PolySpikes"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Spike"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasSemiologyFeature"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#MyoclonicSeizure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAgeOfOnset"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">13</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Year"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Specific type of Idiopathic Generalized Epilepsies (IGE) </rdfs:comment>
        <rdfs:label>Epilepsy With General Tonic Clonic Seizure On Awakening</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#EpilepsyWithMyoclonic-astaticSeizures -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#EpilepsyWithMyoclonic-astaticSeizures">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#GeneralizedEpilepsy"/>
        <rdfs:label>Epilepsy With Myoclonic-astatic Seizures</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#EpilepsyWithMyoclonicAbsences -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#EpilepsyWithMyoclonicAbsences">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#GeneralizedEpilepsy"/>
        <rdfs:label>Epilepsy With Myoclonic Absences</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#EpilepsyZone -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#EpilepsyZone">
        <rdfs:subClassOf rdf:resource="http://www.ifomis.org/bfo/1.1#IndependentContinuant"/>
        <rdfs:comment>Epilepsy zone</rdfs:comment>
        <rdfs:comment>https://pubmed.ncbi.nlm.nih.gov/11522572/</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#EpilepticEpisode -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#EpilepticEpisode">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SimpleMotorEpisode"/>
        <rdfs:label>Epileptic Episode</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#EpilepticSeizure -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#EpilepticSeizure">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ParoxysmalEvent"/>
        <owl:disjointWith rdf:resource="http://www.case.edu/EpilepsyOntology.owl#NonEpilepticSeizure"/>
        <rdfs:comment>An epileptic seizure, occasionally referred to as a fit, is defined as a transient symptom of &quot;abnormal excessive or synchronous neuronal activity in the brain&quot;.</rdfs:comment>
        <rdfs:label>Epileptic Seizure</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#EpilepticSpasm -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#EpilepticSpasm">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SimpleMotorSeizure"/>
        <rdfs:comment>Epileptic spasms consists of a more or less sustained contractions of axial muscles leading to flexion of the trunk and abduction and elevation of both arms in  &quot;salaam&quot; positions.</rdfs:comment>
        <rdfs:comment>Generalized Onset (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:comment>Unknown Onset (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:label>ConvulsiveMotorSeizure</rdfs:label>
        <rdfs:label>Epileptic Spasm</rdfs:label>
        <rdfs:label>Infantile spasm syndrome</rdfs:label>
        <rdfs:label>Spasm</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#EpilepticSpasmStatus -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#EpilepticSpasmStatus">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SimpleMotorStatus"/>
        <rdfs:comment>Myoclonic (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:label>Epileptic Spasm Status</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#EpileptiformBenignVariant -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#EpileptiformBenignVariant">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#BenignElectroencephalogramPattern"/>
        <rdfs:comment>Eileptiform benign variant have an epileptiform appearance but are not epileptogenic, that is, they are not associated with seizures.</rdfs:comment>
        <rdfs:label>Epileptiform Benign Variant</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#EpileptiformPattern -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#EpileptiformPattern">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AbnormalElectroencephalogramPattern"/>
        <rdfs:comment>Epileptiform patterns refers to the discharges that are easily differentiated from background activity, are usually seen in patients with epilepsy and indicate a tendency to epilepsy.</rdfs:comment>
        <rdfs:label>Epileptiform Pattern</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#EpileptogenicLesion -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#EpileptogenicLesion">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#EpilepsyZone"/>
        <rdfs:comment>Potentially epileptogenic lesion visible on anatomical neuroimaging.</rdfs:comment>
        <rdfs:label>Epileptogenic Lesion</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#EpileptogenicZone -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#EpileptogenicZone">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#EpilepsyZone"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#isLocatedAt"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AnatomicalStructure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Area of cortex that is indispensable to the generation of clinical epileptic seizures.</rdfs:comment>
        <rdfs:label>Epileptogenic Zone</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Epilim -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Epilim">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugBrandName"/>
        <synonym>RxCUI 151706</synonym>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/151706</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#EpithelialCell -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#EpithelialCell">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SomaticCell"/>
        <rdfs:label>Epithelial Cell</rdfs:label>
        <rdfs:seeAlso>http://purl.org/sig/ont/fma/fma66768</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#EpithelialCyst -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#EpithelialCyst">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#BrainTumor"/>
        <rdfs:label>Epithelial Cyst</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Epitope -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Epitope">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#BiologicalSubstance"/>
        <rdfs:label>Antigen</rdfs:label>
        <rdfs:label>Antigenic determinant</rdfs:label>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/SNOMEDCT/52078008</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Erythrocyte -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Erythrocyte">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#NucleatedCell"/>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Escitalopram -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Escitalopram">
