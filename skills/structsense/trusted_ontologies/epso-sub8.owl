    <!-- http://www.case.edu/EpilepsyOntology.owl#LateralizingSign -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#LateralizingSign">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SeizureFeature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#isLocatedAt"/>
