    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PostureAtDeath">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ClinicalFinding"/>
        <rdfs:label>Posture At Death</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Potiga -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Potiga">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugBrandName"/>
        <synonym>RxCUI 1112994</synonym>
        <rdfs:comment>Used to treat partial-onset seizures in adults.</rdfs:comment>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/1112994</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PreBaseline -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PreBaseline">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ElectroencephalogramEvent"/>
        <rdfs:label>Pre Baseline</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PrecentralGyrus -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PrecentralGyrus">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#FrontalLobeGyrus"/>
        <rdfs:label>Precentral convolution</rdfs:label>
        <rdfs:label>Precentral gyrus</rdfs:label>
        <rdfs:label>Prerolandic gyrus</rdfs:label>
        <rdfs:seeAlso>http://purl.org/sig/ont/fma/fma61894</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PrecentralOperculum -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PrecentralOperculum">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#TelencephalonZone"/>
        <rdfs:label>Precentral Operculum</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Precentral_operculum</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PreciseDrugIngredient -->

