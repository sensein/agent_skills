    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#InsulaLobule">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#CerebralLobeSegment"/>
        <rdfs:label>Lobule of insula</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Lobule_of_insula</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#InsulaPosteriorLobule -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#InsulaPosteriorLobule">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#InsulaLobule"/>
        <rdfs:label>Posterior lobule of insula</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Posterior_lobule_of_insula</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#InsularEpilepsy -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#InsularEpilepsy">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SingleFocalEpilepsy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasEtiology"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#DysembryoplasticNeuroepithelialTumor"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Glioma"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasIctalEpileptiformAbnormality"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SeizurePattern"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasInterIctalEpileptiformAbnormality"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#SharpWave"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Spike"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasSemiologyFeature"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SomatosensoryAura"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Insular Epilepsy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#InterIctal -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#InterIctal">
