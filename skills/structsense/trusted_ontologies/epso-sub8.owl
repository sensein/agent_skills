    <!-- http://www.case.edu/EpilepsyOntology.owl#Valproate -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Valproate">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugIngredient"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasPreciseDrugIngredient"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#DivalproexSodium"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#MagnesiumValproate"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#SodiumValproate"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#ValproicAcid"/>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasTradename"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Depacon"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Depakene"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Depakote"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#DepakoteER"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Epilim"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Stavzor"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Anti seizure medication</rdfs:comment>
        <rdfs:comment>Antiepileptic Drug</rdfs:comment>
        <rdfs:isDefinedBy>Used for controlling certain types of seizures in the treatment of epilepsy in patients who are unable to take the oral form of valproate.</rdfs:isDefinedBy>
        <rdfs:seeAlso>RxCUI 40254</rdfs:seeAlso>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/40254</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#ValproicAcid -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#ValproicAcid">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#PreciseDrugIngredient"/>
        <rdfs:comment>Anti seizure medication</rdfs:comment>
        <rdfs:comment>Treats seizures (epilepsy). Also used to treat mood disorders and prevent migraine headaches. This medicine is an anticonvulsant.</rdfs:comment>
        <rdfs:label>Valproic Acid</rdfs:label>
    </owl:Class>
    


