    <!-- http://www.case.edu/EpilepsyOntology.owl#OrbitoFrontalEpilepsy -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#OrbitoFrontalEpilepsy">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#FrontalLobeEpilepsy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasEtiology"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#BrainTumor"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#TraumaticBrainInjury"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#VascularMalformation"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasIctalEpileptiformAbnormality"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SeizurePattern"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasInterIctalEpileptiformAbnormality"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#SharpWave"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Spike"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasPreferredMedication"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Phenytoin"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasSeizureOnsetZone"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#FrontalLobeOrbitofrontalSegment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasSemiologyFeature"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#AutonomicSeizure"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#HypermotorSeizure"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#OlfactoryAura"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Orbito Frontal Epilepsy</rdfs:label>
    </owl:Class>
    


