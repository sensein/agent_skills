    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#HypnogogicSeizure">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SpecialSeizure"/>
        <rdfs:comment>Generalized Onset (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:comment>Motor (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:comment>Myoclonic (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:comment>Unknown Onset (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:label>Hypnogogic seizure</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#HypnogogicStatus -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#HypnogogicStatus">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SpecialStatus"/>
        <rdfs:label>Hypnogogic Status</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#HypnopompicEpisode -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#HypnopompicEpisode">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SpecialEpisode"/>
        <rdfs:label>Hypnopompic Episode</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#HypnopompicSeizure -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#HypnopompicSeizure">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SpecialSeizure"/>
        <rdfs:label>Hypnopompic Seizure</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#HypnopompicStatus -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#HypnopompicStatus">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SpecialStatus"/>
        <rdfs:label>Hypnopompic Status</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#HypomotorEpisode -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#HypomotorEpisode">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SpecialEpisode"/>
        <rdfs:label>Hypomotor Episode</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#HypomotorSeizure -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#HypomotorSeizure">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SpecialSeizure"/>
        <rdfs:comment>Hypomotor seizures are characterized by immobility or a marked decrease in movements of newborns, infants or of mentally retarded patients in whom the cause of the immobility (alteration of consciousness, inability to move distraction by an aura, etc.) cannot be determined.</rdfs:comment>
        <rdfs:label>Hypomotor Seizure</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#HypomotorStatus -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#HypomotorStatus">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SpecialStatus"/>
        <rdfs:label>Hypomotor Status</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#HypopneaSyndrome -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#HypopneaSyndrome">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SleepDisorder"/>
        <rdfs:label>Hypopnea Syndrome</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#HypothalamicEpilepsy -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#HypothalamicEpilepsy">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SingleFocalEpilepsy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAssociatedDisorder"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#MentalRetardation"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#PrecociousPuberty"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAssociatedMutationIn"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#GLI3"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasEtiology"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#HypothalamicHamartoma"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasIctalEpileptiformAbnormality"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SeizurePattern"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasSemiologyFeature"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#GelasticSeizure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Hypothalamic Epilepsy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#HypothalamicHamartoma -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#HypothalamicHamartoma">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Hamartoma"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAssociatedMutationIn"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#GLI3"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Hypothalamic Hamartoma</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#HypothalamusSegment -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#HypothalamusSegment">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DiencephalonSegment"/>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Segment_of_hypothalamus</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#HypothalamusZone -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#HypothalamusZone">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DiencephalonZone"/>
        <rdfs:comment>A regional part of brain that is part of a hypothalamus </rdfs:comment>
        <rdfs:label>Hypothalamus Zone</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Zone_of_hypothalamus</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#HypoxicIschemicInjury -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#HypoxicIschemicInjury">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#StructuralCause"/>
        <rdfs:label>Hypoxic Ischemic Injury</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Hypsarrhythmia -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Hypsarrhythmia">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#InterIctalPattern"/>
        <rdfs:comment>Hypsarrhythmia (HYP) refers to the pattern characterized by generalized continuous slow activity with an amplitude higher than 300 uV and the appearance of multiregional spikes or sharp waves over both hemispheres.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#IDH1 -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#IDH1">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Gene"/>
        <rdfs:label>Isocitrate Dehydrogenase (NADP(+)) 1</rdfs:label>
        <rdfs:seeAlso>https://www.ncbi.nlm.nih.gov/gene?cmd=retrieve&amp;dopt=default&amp;list_uids=3417&amp;rn=1</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#IDH2 -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#IDH2">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Gene"/>
        <rdfs:label>Isocitrate Dehydrogenase (NADP(+)) 2</rdfs:label>
        <rdfs:seeAlso>https://www.ncbi.nlm.nih.gov/gene?cmd=retrieve&amp;dopt=default&amp;list_uids=3418&amp;rn=1</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#IER3IP1 -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#IER3IP1">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Gene"/>
        <rdfs:label>immediate early response 3 interacting protein 1</rdfs:label>
        <rdfs:seeAlso>https://ghr.nlm.nih.gov/gene/IER3IP1</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Ictal -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Ictal">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ElectroencephalogramFinding"/>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#IctalApnea -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#IctalApnea">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#InducedApnea"/>
        <rdfs:label>Ictal Apnea</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#IctalDystonia -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#IctalDystonia">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#LateralizingSign"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#isLocatedAt"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#LeftHand"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#RightHand"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#occursAt"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Ictal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Ictal dystonia is abnormal muscle tone, rsulting in muscle spasms and abnormal postures, during episode of seizure.</rdfs:comment>
        <rdfs:label>Dystonic Posturing</rdfs:label>
        <rdfs:label>Ictal Dystonia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#IctalNystagmus -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#IctalNystagmus">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#LateralizingSign"/>
        <rdfs:label>Ictal Nystagmus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#IctalPattern -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#IctalPattern">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#EpileptiformPattern"/>
        <rdfs:label>Ictal Pattern</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#IctalSpeech -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#IctalSpeech">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#LateralizingSign"/>
        <rdfs:comment>Ictal speech is abnormal speech production during episode of seizure.</rdfs:comment>
        <rdfs:label>Ictal Speech</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Iloperidone -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Iloperidone">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugIngredient"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasTradename"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Fanapt"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Antidepressant Drug</rdfs:comment>
        <rdfs:seeAlso>RxCUI 73178</rdfs:seeAlso>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/73178</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#ImagingModality -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#ImagingModality">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#NervousSystemMeasurementModality"/>
        <rdfs:label>Imaging Modality</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Imipramine -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Imipramine">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugIngredient"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasPreciseDrugIngredient"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#ImipramineHydrochloride"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#ImipraminePamoate"/>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasTradename"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Tofranil"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Tofranil-PM"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Neuroleptic Drug</rdfs:comment>
        <rdfs:seeAlso>RxCUI 5691</rdfs:seeAlso>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/5691</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#ImipramineHydrochloride -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#ImipramineHydrochloride">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#PreciseDrugIngredient"/>
        <rdfs:label>Imipramine Hydrochloride</rdfs:label>
        <rdfs:seeAlso>RxCUI 150816</rdfs:seeAlso>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/150816</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#ImipraminePamoate -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#ImipraminePamoate">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#PreciseDrugIngredient"/>
        <rdfs:label>Imipramine Pamoate</rdfs:label>
        <rdfs:seeAlso>RxCUI 91118</rdfs:seeAlso>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/91118</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#ImmaterialAnatomicalEntity -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#ImmaterialAnatomicalEntity">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#HumanBodyPart"/>
        <rdfs:comment>Physical anatomical entity which is a three-dimensional space, surface, line or point associated with a material anatomical entity. Examples: body space, surface of heart, costal margin, apex of right lung, anterior compartment of right arm. (source: FMA)</rdfs:comment>
        <rdfs:label>Immaterial Anatomical Entity</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Immaterial_anatomical_entity</rdfs:seeAlso>
    </owl:Class>
    


