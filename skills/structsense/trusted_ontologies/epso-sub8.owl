    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Child -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Child">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#HumanBeing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasRecordedAge"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Year"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasRecordedAge"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">12</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Year"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>a person of either sex between the time of birth and adolescence</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#ChildAttentionDeficitDisorder -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#ChildAttentionDeficitDisorder">
