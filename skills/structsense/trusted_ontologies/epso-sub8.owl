                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#ZuclopenthixolAcetate"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#ZuclopenthixolDecanoate"/>
