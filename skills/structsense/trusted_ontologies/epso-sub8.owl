        <rdfs:seeAlso>http://purl.bioontology.org/ontology/SNOMEDCT/17057004</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#InducedPluripotentStemCellCulture -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#InducedPluripotentStemCellCulture">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#CellCulture"/>
        <rdfs:label>Induced Pluripotent Stem Cells</rdfs:label>
        <rdfs:label>iPSC</rdfs:label>
        <rdfs:seeAlso>http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C124144</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Infant -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Infant">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#HumanBeing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasRecordedAge"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Month"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasRecordedAge"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Year"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>the human young from the time of birth to one year of age</rdfs:comment>
    </owl:Class>
    


