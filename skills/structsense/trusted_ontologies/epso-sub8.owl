    <!-- http://www.case.edu/EpilepsyOntology.owl#MesialFrontalEpilepsy -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#MesialFrontalEpilepsy">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#FrontalLobeEpilepsy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasEtiology"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#BifocalEncephalomalacia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasSemiologyFeature"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#BilateralAsymmetricTonicSeizure"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#HypermotorSeizure"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Mesial Frontal Epilepsy</rdfs:label>
    </owl:Class>
    


