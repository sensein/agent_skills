        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasTradename"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Diastat"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Anti seizure medication</rdfs:comment>
        <rdfs:comment>Antiepileptic Drug</rdfs:comment>
        <rdfs:isDefinedBy>Treats anxiety, muscle spasms, seizures, and other medical conditions. This medicine is a benzodiazepine.</rdfs:isDefinedBy>
        <rdfs:label>Benzodiazepine</rdfs:label>
        <rdfs:seeAlso>RxCUI 3322</rdfs:seeAlso>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/3322</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Diencephalon -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Diencephalon">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ForebrainSegment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sig.uw.edu/fma#regional_part_of"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Forebrain"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&quot;Organ component of neuraxis that has as its parts the epithalamus, thalamus, hypothalamus, subthalamus. There is only one diencephalon.&quot; [FMA v3.1]</rdfs:comment>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Diencephalon</rdfs:seeAlso>
    </owl:Class>
    


