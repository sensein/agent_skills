            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Area of the forebrain anterior to the posterior tuberculum and the hypothalamus and ventral to the ventral thalamus[ZFA]</rdfs:comment>
        <rdfs:label>Preoptic Area</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Preoptic_area</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#PrimaryReadingEpilepsy -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#PrimaryReadingEpilepsy">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#GeneralizedEpilepsy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAssociatedMutationIn"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#CACNB4"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#CLCN2"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#EFHC1"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#GABRA1"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#GABRD"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasEtiology"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#GeneticMutation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasPreferredMedication"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Lamotrigine"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Levetiracetam"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Topiramate"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Valproate"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Zonisamide"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasSemiologyFeature"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#MyoclonicSeizure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAgeOfOnset"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">8</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Year"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAgeOfOnset"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">20</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Year"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Primary Reading Epilepsy</rdfs:label>
    </owl:Class>
    


