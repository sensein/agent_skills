        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/236734</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AmitriptylinePamoate -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#AmitriptylinePamoate">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#PreciseDrugIngredient"/>
        <rdfs:label>Amitriptyline Pamoate</rdfs:label>
        <rdfs:seeAlso>RxCUI 235737</rdfs:seeAlso>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/235737</rdfs:seeAlso>
