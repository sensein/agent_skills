                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#PRKCA"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>PGNT</rdfs:label>
        <rdfs:label>Papillary Glioneuronal Tumor</rdfs:label>
    </owl:Class>
    


