    <!-- http://www.case.edu/EpilepsyOntology.owl#IntermediateHypothalamicRegion -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#IntermediateHypothalamicRegion">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#HypothalamusZone"/>
        <rdfs:comment>Brain structure that lies perpendicular to the longitudinal axis of the embryonic neural tube, is continuous with the rostral hypothalamic proliferation and whose most lateral extent is deflected dorsally within the inferior lobe</rdfs:comment>
        <rdfs:label>Intermediate Hypothalamic Region</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Intermediate_hypothalamic_region</rdfs:seeAlso>
    </owl:Class>
    


