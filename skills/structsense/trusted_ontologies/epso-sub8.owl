                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>SUDEP</rdfs:label>
        <rdfs:label>Sudden Unexpected Death in Epilepsy</rdfs:label>
    </owl:Class>
    


