        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/152408</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Telencephalon -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Telencephalon">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ForebrainSegment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sig.uw.edu/fma#regional_part_of"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Forebrain"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Organ component of neuraxis that has as its parts the cerebral cortex, cerebral white matter, basal ganglia, septum and fornix, as well as subcortical gray and white matter structures. There is only one telencephalon.</rdfs:comment>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Telencephalon</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#TelencephalonBasalGanglion -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#TelencephalonBasalGanglion">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#NeuraxisGanglion"/>
        <rdfs:label>Basal Ganglion of Telencephalon</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Basal_ganglion_of_telencephalon</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#TelencephalonNeuralTissue -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#TelencephalonNeuralTissue">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#BrainNeuralTissueSegment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sig.uw.edu/fma#regional_part_of"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ForebrainNeuralTissue"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#isConstitutionalPartOf"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Telencephalon"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Fmaid 268525</rdfs:comment>
        <rdfs:label>Telencephalon Neural Tissue</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Neural_tissue_of_telencephalon</rdfs:seeAlso>
    </owl:Class>
    


