    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Amygdala">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#TelencephalonBasalGanglion"/>
        <rdfs:comment>Subdivision of basal ganglion of telencephalon which is an almond-shaped gray mass in the dorsomedial part of the temporal lobe. (source: FMA)</rdfs:comment>
        <rdfs:label>Amygdalar</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Amygdala</rdfs:seeAlso>
    </owl:Class>
    


