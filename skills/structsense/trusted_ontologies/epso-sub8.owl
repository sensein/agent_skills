                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Gabitril"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Anti seizure medication</rdfs:comment>
        <rdfs:comment>Antiepileptic Drug</rdfs:comment>
        <rdfs:isDefinedBy>Controls partial seizures when used in combination with other medicines. This medicine is an anticonvulsant.</rdfs:isDefinedBy>
        <rdfs:seeAlso>RxCUI 31914</rdfs:seeAlso>
    </owl:Class>
    


