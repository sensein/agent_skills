                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasAssociatedAntigen"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ParaneoplasticAntigenMa2"/>
            </owl:Restriction>
        </rdfs:subClassOf>
