    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#IntermittentSlowActivityOnset">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#IntermittentSlowActivity"/>
        <rdfs:label>Onset of Intermittent Slow</rdfs:label>
    </owl:Class>
    


