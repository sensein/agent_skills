        <rdfs:label>Attention deficit hyperactivity disorder, predominantly hyperactive impulsive type</rdfs:label>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/SNOMEDCT/7461003</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#AttentionDeficitHyperactivityDisorderPredominantlyInattentiveType -->

