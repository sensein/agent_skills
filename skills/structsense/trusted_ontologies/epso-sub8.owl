    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Carbamazepine -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Carbamazepine">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugIngredient"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasTradename"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Carbatrol"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Tegretol"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#TegretolXR"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Anti seizure medication</rdfs:comment>
        <rdfs:comment>Antiepileptic Drug</rdfs:comment>
        <rdfs:isDefinedBy>Treats different types of seizures. Also used to treat nerve pain and bipolar disorder, also known as manic-depressive illness.</rdfs:isDefinedBy>
        <rdfs:seeAlso>RxCUI 2002</rdfs:seeAlso>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/2002</rdfs:seeAlso>
    </owl:Class>
    


