        <rdfs:seeAlso>http://purl.bioontology.org/NEMO/ontology/NEMO.owl#NEMO_2662000</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#ElectrographicSeizure -->

