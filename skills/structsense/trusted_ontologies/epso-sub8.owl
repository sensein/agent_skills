    <!-- http://www.case.edu/EpilepsyOntology.owl#Tiagabine -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Tiagabine">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugIngredient"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasPreciseDrugIngredient"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#TiagabineHydrochloride"/>
