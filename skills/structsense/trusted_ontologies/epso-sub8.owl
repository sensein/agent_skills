    <!-- http://www.case.edu/EpilepsyOntology.owl#SingleFocalEpilepsy -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SingleFocalEpilepsy">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#FocalEpilepsy"/>
        <rdfs:label>Single Focal Epilepsy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SingleNucleotideVariant -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SingleNucleotideVariant">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#VariationType"/>
        <rdfs:label>SNV</rdfs:label>
        <rdfs:label>Single Nucleotide Variant</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SinglePhotonImaging -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SinglePhotonImaging">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#NuclearMedicineImaging"/>
        <rdfs:seeAlso>http://radlex.org/RID/RID10332</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SituationalCircadianRhythmSleepDisorder -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SituationalCircadianRhythmSleepDisorder">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SleepDisorder"/>
        <rdfs:label>Situational Circadian Rhythm Sleep Disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Six-HertzSpikeWaveBurst -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Six-HertzSpikeWaveBurst">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#EpileptiformBenignVariant"/>
        <rdfs:comment>Six-hertz spike-and-wave bursts (phantom spike and wave) are brief bursts, lasting 1 to 2 seconds with a repitition rate of 6Hz with a range of 5-7 hz.
</rdfs:comment>
        <rdfs:label>Phantom spike and wave</rdfs:label>
        <rdfs:label>Six-Hertz Spike Wave Burst</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SkullOssificationDefect -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SkullOssificationDefect">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#CongenitalAnomalyofSkull"/>
        <rdfs:label>Defect of skull ossification (disorder)</rdfs:label>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/SNOMEDCT/253980008</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SleepDisorder -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SleepDisorder">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Disease"/>
        <rdfs:label>Sleep disorder</rdfs:label>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/SNOMEDCT/39898005</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SleepOnsetRapidEyeMovement -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SleepOnsetRapidEyeMovement">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SpecialPattern"/>
        <rdfs:comment>Sleep-onset rapid eye movement (SOR) refers to the occurence of REM sleep less than 15 minutes after falling sleep.</rdfs:comment>
        <rdfs:label>Sleep Onset Rapid Eye Movement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SleepParalysis -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SleepParalysis">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SleepDisorder"/>
        <rdfs:label>Sleep Paralysis</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SleepRelatedElectroencephalogramPattern -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SleepRelatedElectroencephalogramPattern">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#NormalElectroencephalogramPattern"/>
        <rdfs:label>Sleep Related EEG Pattern</rdfs:label>
        <rdfs:label>Sleep Related Electroencephalogram Pattern</rdfs:label>
        <rdfs:label>SleepRelatedEEGPattern</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SleepStructure -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SleepStructure">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ModelSystemDepressionScale"/>
        <rdfs:label>SLEEP</rdfs:label>
        <rdfs:label>Sleep structure</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SleepTalking -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SleepTalking">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SleepDisorder"/>
        <rdfs:label>Sleep Talking</rdfs:label>
        <rdfs:label>Somniloquy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SleepWalking -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SleepWalking">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SleepDisorder"/>
        <rdfs:label>Sleep Walking</rdfs:label>
        <rdfs:label>Somnambulism</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SleepingSickness -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SleepingSickness">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SleepDisorder"/>
        <rdfs:label>Sleeping Sickness</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Slice -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Slice">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ModelSystem"/>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SlowActivity -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SlowActivity">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#InterIctalPattern"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasInterIctalEpileptiformAbnormality"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#PolySpikes"/>
                            <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Spike"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Slow activity is a general term referring to EEG activities that are abnormally slow for the age of the patient and regional or lateralized activity that is slowet than on the homotopic contralateral side.</rdfs:comment>
        <rdfs:label>Slow Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SlowAlphaVariant -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SlowAlphaVariant">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AlphaVariant"/>
        <rdfs:comment>Occurs at a harmonic half that of the alpha range</rdfs:comment>
        <rdfs:label>Slow Alpha Variant</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SlowSpikeWaveComplex -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SlowSpikeWaveComplex">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SpikeWaveComplex"/>
        <rdfs:comment>Slow spike-and-wave complexes (SSWC) refer to bursts of spike-and-wave complexes with a regular repetition rate of less than 2.5 Hz, with at least one burst of these complexes with a duration of more than 3 seconds.</rdfs:comment>
        <rdfs:label>Slow Spike and Wave Complex</rdfs:label>
        <rdfs:label>Slow Spike-and-Wave Complex</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SlowTransient -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SlowTransient">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ElectroencephalogramPattern"/>
        <rdfs:seeAlso>Slow transient</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SmallSharpSpike -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SmallSharpSpike">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#EpileptiformBenignVariant"/>
        <rdfs:comment>Small sharp spikes (SSS) consist of single monophasic or diphasic spikes with an abrupt ascending limb and a steep descending limb, are generally of low voltage and short duratiopn, usually less than 50 ms.</rdfs:comment>
        <rdfs:label>SSS</rdfs:label>
        <rdfs:label>Small Sharp Spike</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Snoring -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Snoring">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SleepDisorder"/>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SocialTransmissionofFoodPreference -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SocialTransmissionofFoodPreference">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ModelSystemAutismScale"/>
        <rdfs:label>STFP</rdfs:label>
        <rdfs:label>Social transmission of food preference</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SodiumValproate -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SodiumValproate">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#PreciseDrugIngredient"/>
        <rdfs:label>sodium valproate</rdfs:label>
        <rdfs:seeAlso>RxCUI 9919</rdfs:seeAlso>
        <rdfs:seeAlso>http://purl.bioontology.org/ontology/RXNORM/9919</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SomaticCell -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SomaticCell">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Cell"/>
        <rdfs:label>Somatic Cell</rdfs:label>
        <rdfs:seeAlso>http://purl.org/sig/ont/fma/fma72300</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SomatosensoryAura -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SomatosensoryAura">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Aura"/>
        <rdfs:comment>Sensory (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:comment>Somatosensory auras consists of paraesthesias, which have a clearly defined dermatomal distribution.</rdfs:comment>
        <rdfs:label>Somatosensory Aura</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SomatosensoryAuraStatus -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SomatosensoryAuraStatus">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AuraStatus"/>
        <rdfs:comment>Focal Onset (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:comment>Non-convulsive status epilepticus without coma (mapping reference: ILAE 2017 Classification of Seizure Types Expanded Version)</rdfs:comment>
        <rdfs:label>Somatosensory Aura Status</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Somatostatin -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Somatostatin">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#BiologicalSubstance"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasFunction"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#NeuroModulator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SomatostatinExpressingInterneuron -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SomatostatinExpressingInterneuron">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Interneuron"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#isMarkedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Somatostatin"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Somatostatin Expressing Interneuron</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Somatotopic -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Somatotopic">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SomatotopicArrangement"/>
        <rdfs:comment>Non-somatotopic Semiological Distribution refers to the distribution in which there is no maintenance of spatial organization within the central nervous system.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SomatotopicArrangement -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SomatotopicArrangement">
        <rdfs:subClassOf rdf:resource="http://www.ifomis.org/bfo/1.1#DependentContinuant"/>
        <rdfs:comment>Somatotopy refers to the correspondence between the position of a receptor in part of the body and the corresponding area of the cerebral cortex that is activated by it. [Wikipedia]</rdfs:comment>
        <rdfs:label>Somatotopic Arrangement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SpaceofCompartmentofHead -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SpaceofCompartmentofHead">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AnatomicalCompartmentSpace"/>
        <rdfs:label>Space of Compartment of Head</rdfs:label>
        <rdfs:seeAlso>http://purl.org/sig/ont/fma/fma84953</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SpecialEpisode -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SpecialEpisode">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#NonEpilepticSeizure"/>
        <rdfs:label>Special Episode</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SpecialPattern -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SpecialPattern">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AbnormalElectroencephalogramPattern"/>
        <rdfs:label>Special Pattern</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SpecialSeizure -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SpecialSeizure">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#EpilepticSeizure"/>
        <owl:disjointWith>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#Aura"/>
                    <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#AutonomicSeizure"/>
                    <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#DialepticSeizure"/>
                    <rdf:Description rdf:about="http://www.case.edu/EpilepsyOntology.owl#MotorSeizure"/>
                </owl:unionOf>
            </owl:Class>
        </owl:disjointWith>
        <rdfs:comment>Special seizures include all seizures that cannot be classified as auras, autonomic, dialeptic or motor seizures.</rdfs:comment>
        <rdfs:label>Special Seizure</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SpecialStatus -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SpecialStatus">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#StatusEpilepticus"/>
        <rdfs:label>Special Status</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Sphenoidal -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Sphenoidal">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#IntracranialElectrode"/>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Spike -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Spike">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#InterictalDischarge"/>
        <rdfs:comment>Spikes refer to epileptiform discharges with a duration of 40 to 80 ms.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SpikeWaveComplex -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SpikeWaveComplex">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#InterIctalPattern"/>
        <rdfs:comment>Spike-and-wave complexes (SWC) are spikes and waves that occur repititively (in series) and do not fulfill the criteria for more specific epileptiform patterns such as slow spike-and-wave complexes or 3-Hz spike-and-wave complexes.</rdfs:comment>
        <rdfs:label>Spike and Wave Complex</rdfs:label>
        <rdfs:label>Spike-and-Wave Complex</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SpikeWaveComplex3Hz -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SpikeWaveComplex3Hz">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SpikeWaveComplex"/>
        <rdfs:comment>3-Hz spike-and-wave complexes (3 SWC) refer to the bursts of spike-and-wave complexes with a regular repitition rate of 3 to 5.5 Hz.</rdfs:comment>
        <rdfs:label>3-Hz Spike-and-Wave Complex</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SpindleStupor -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SpindleStupor">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SpecialPattern"/>
        <rdfs:comment>Spindle coma (SC) / Spindle stupor (SS) refers to an EEG recording of coma where the record is like that of a typical stage II sleep pattern</rdfs:comment>
        <rdfs:label>Spindle Stupor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Splenocyte -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Splenocyte">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Leukocyte"/>
        <rdfs:seeAlso>http://purl.obolibrary.org/obo/CL_2000074</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Splice-DA -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Splice-DA">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#MolecularConsequence"/>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#SpontaneousSeizure -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#SpontaneousSeizure">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ParoxysmalEvent"/>
        <rdfs:label>Spontaneous Seizure</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#StatusEpilepticus -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#StatusEpilepticus">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ParoxysmalEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#isCausedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#TemperatureInducedSeizure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A paroxysmal event that is &quot;continuous, unremitting seizure lasting longer than 5 minutes&quot;.</rdfs:comment>
        <rdfs:label>SE</rdfs:label>
        <rdfs:label>Status Epilepticus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#StatusPattern -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#StatusPattern">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#IctalPattern"/>
        <rdfs:comment>Status pattern (EEG ST) refers to a continous EEG seizure pattern of frequent recurring EEG seizure patterns without return to normal background activity.</rdfs:comment>
        <rdfs:label>ST</rdfs:label>
        <rdfs:label>Status Pattern</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#StatusSemiology -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#StatusSemiology">
