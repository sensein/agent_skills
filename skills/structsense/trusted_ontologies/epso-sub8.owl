    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Basal">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#AnatomicalCoordinate"/>
        <rdfs:seeAlso>http://purl.org/sig/ont/fma/fma74542</rdfs:seeAlso>
    </owl:Class>
    


