            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasTradename"/>
                <owl:someValuesFrom rdf:resource="http://www.case.edu/EpilepsyOntology.owl#Promethegan"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Antidepressant Drug</rdfs:comment>
        <rdfs:isDefinedBy>Prevents and controls motion sickness, nausea, vomiting, and dizziness. Also used to relieve or prevent allergic reactions, helps people go to sleep, and control their pain or anxiety before or after surgery or other procedures.</rdfs:isDefinedBy>
