        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#ActivationProcedure"/>
        <rdfs:comment>Hyperventilation response is a method used to cause rapid, deep breathing; this technique produces generalized slowing of the EEG and may provoke epileptiform waves or seizures (especially absences seizures) during an EEG recording.</rdfs:comment>
        <rdfs:label>Hyperventilation Response</rdfs:label>
    </owl:Class>
    


