        <rdfs:label>Inframe Insertion Variant</rdfs:label>
        <rdfs:label>inframe_insertion</rdfs:label>
        <rdfs:seeAlso>http://www.sequenceontology.org/browser/current_svn/term/SO:0001821</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Inion -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Inion">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#MiddleAnatomicalPointofSkull"/>
        <rdfs:comment>&quot;The projecting part of the occipital bone at the base of the skull.&quot; (Foundational Model of Anatomy)</rdfs:comment>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Inion</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#InnumerableSeizure -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#InnumerableSeizure">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SeizureFrequencyCategory"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.case.edu/EpilepsyOntology.owl#hasValue"/>
                <owl:someValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</xsd:minInclusive>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>American Academy of Neurology recommended seizure frequency category.</rdfs:comment>
        <rdfs:comment>LA32852-8 (LOINC Code)</rdfs:comment>
        <rdfs:label>Innumerable</rdfs:label>
        <rdfs:label>Innumerable Seizure</rdfs:label>
        <rdfs:seeAlso>https://loinc.org/LA32852-8</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Inovelon -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Inovelon">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#DrugBrandName"/>
        <rdfs:comment>Treats seizures in patients who have Lennox-Gastaut syndrome (LGS).</rdfs:comment>
        <rdfs:label>Inovelon®</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#InsertionVariant -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#InsertionVariant">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#VariationType"/>
        <rdfs:label>Insertion</rdfs:label>
        <rdfs:label>Insertion Variant</rdfs:label>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Insomnia -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Insomnia">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#SleepDisorder"/>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#Insula -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#Insula">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#CerebralHemisphereLobe"/>
        <rdfs:comment>Lobe of cerebral hemispheere located in the depths of the lateral fissure and is covered by portions of the frontal, parietal and temporal lobes.</rdfs:comment>
        <rdfs:label>Insular</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Insula</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#InsulaAnteriorLobule -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#InsulaAnteriorLobule">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#InsulaLobule"/>
        <rdfs:label>Anterior lobule of insula</rdfs:label>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Anterior_lobule_of_insula</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.case.edu/EpilepsyOntology.owl#InsulaGyrus -->

    <owl:Class rdf:about="http://www.case.edu/EpilepsyOntology.owl#InsulaGyrus">
        <rdfs:subClassOf rdf:resource="http://www.case.edu/EpilepsyOntology.owl#BrainGyrus"/>
        <rdfs:seeAlso>http://sig.uw.edu/fma#Gyrus_of_insula</rdfs:seeAlso>
    </owl:Class>
    


