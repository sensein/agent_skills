    <!-- http://purl.obolibrary.org/obo/WBbt_0004292 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBbt_0004292">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBbt_0008600"/>
        <obo:IAO_0000115>a single, H-shaped cell which lies just above the anus and connects the roof of the anal canal to the dorsal bodywall; its contractions act to increase the size of the anal opening by lifting the roof of the rectum and hence facilitate expulsion of intestinal contents.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>WBbt:0005802</oboInOwl:hasAlternativeId>
        <oboInOwl:hasOBONamespace>worm_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>dilator muscle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>lineage name: ABplpppppap</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>mu anal</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>WBbt:0004292</oboInOwl:id>
        <rdfs:comment>LINKOUT::WORMATLAS::&lt;http://www.wormatlas.org/ver1/handbook/mesodermal.htm/musclepartIII.htm#Adp&gt;</rdfs:comment>
        <rdfs:label>anal depressor muscle</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBbt_0004292"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>a single, H-shaped cell which lies just above the anus and connects the roof of the anal canal to the dorsal bodywall; its contractions act to increase the size of the anal opening by lifting the roof of the rectum and hence facilitate expulsion of intestinal contents.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0-87969-307-X</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WBPaper:00038216</oboInOwl:hasDbXref>
    </owl:Axiom>
    


