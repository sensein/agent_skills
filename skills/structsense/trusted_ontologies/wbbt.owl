    <!-- http://purl.obolibrary.org/obo/WBbt_0005754 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBbt_0005754">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBbt_0003672"/>
        <obo:IAO_0000115>an epithelial cell that serves either to bridge two neighboring epithelial tissues or to form an opening in the epithelium.</obo:IAO_0000115>
