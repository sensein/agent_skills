        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBbt_0005762"/>
        <obo:IAO_0000115>a structural (glial) cell which forms an specialized environment surrounding the sensory ending(s) of one or more neurons; sometimes accompanied by a more distal socket cell.  In early development of the sensory nerves and of the nerve ring some sheath cells (cephalics and labials) may also provide a substrate for axon guidance</obo:IAO_0000115>
        <oboInOwl:hasDbXref>WBPaper:00038216</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>worm_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>pocket cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>WBbt:0005811</oboInOwl:id>
        <rdfs:label>neuronal sheath cell</rdfs:label>
    </owl:Class>
