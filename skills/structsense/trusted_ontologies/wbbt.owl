    <!-- http://purl.obolibrary.org/obo/WBbt_0005270 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBbt_0005270">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBbt_0005190"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBbt_0005409"/>
        <obo:IAO_0000115>Neuron class of six motoneurons, with cell bodies in the ventral cord, which innervate dorsal muscles. Each cell has a short, posteriorly directed and a longer, anteriorly directed process emanating from its cell body. The anterior process has a branch, which leaves the ventral cord as a commissure and runs round to the dorsal cord.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>worm_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBbt:0005270</oboInOwl:id>
        <rdfs:comment>LINKOUT::WORMATLAS::&lt;http://www.wormatlas.org/neurons/Individual%20Neurons/DDframeset.html&gt;</rdfs:comment>
        <rdfs:label>DD neuron</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBbt_0005270"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Neuron class of six motoneurons, with cell bodies in the ventral cord, which innervate dorsal muscles. Each cell has a short, posteriorly directed and a longer, anteriorly directed process emanating from its cell body. The anterior process has a branch, which leaves the ventral cord as a commissure and runs round to the dorsal cord.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:Paper00000938</oboInOwl:hasDbXref>
    </owl:Axiom>
    


