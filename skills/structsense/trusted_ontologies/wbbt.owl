    <!-- http://purl.obolibrary.org/obo/WBbt_0005214 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBbt_0005214">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBbt_0005135"/>
        <obo:IAO_0000115>ganglion that lies beside the nerve ring in the head. It contains neuron cell bodies that send their neuronal processes into the ring and longitudinal nerves, but form no local neuropil separate from the nerve ring. The dorsal ganglion is in close contact with the dorsal hypodermal cord.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>WBbt:0005228</oboInOwl:hasAlternativeId>
        <oboInOwl:hasOBONamespace>worm_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBbt:0005214</oboInOwl:id>
        <rdfs:label>dorsal ganglion</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBbt_0005214"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>ganglion that lies beside the nerve ring in the head. It contains neuron cell bodies that send their neuronal processes into the ring and longitudinal nerves, but form no local neuropil separate from the nerve ring. The dorsal ganglion is in close contact with the dorsal hypodermal cord.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WBPaper:00038216</oboInOwl:hasDbXref>
    </owl:Axiom>
    


