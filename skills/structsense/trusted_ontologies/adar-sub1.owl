        <rdfs:subClassOf rdf:resource="&autism-rules;Spontaneous_imitation_of_actions"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Spontaneous_imitation_of_actions -->

    <owl:Class rdf:about="&autism-rules;Spontaneous_imitation_of_actions">
        <rdfs:subClassOf rdf:resource="&autism-rules;Imitation"/>
    </owl:Class>
    


