        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:comment rdf:datatype="&xsd;string">&quot;Seeks medical help in an emergency (for example, recognizes symptoms of serious illness or injury, such as shortness of breath, chest pain, uncontrolled bleeding, etc.). You may mark &quot;&quot;N/O&quot;&quot; for No Opportunity if the individual has not been in a medical emergency. &quot;</rdfs:comment>
        <assessment-result:valueRange rdf:datatype="&xsd;string">0;1;2</assessment-result:valueRange>
