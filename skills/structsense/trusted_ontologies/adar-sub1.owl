    <owl:DatatypeProperty rdf:about="http://purl.org/autism-ontology/1.0/ca_vinelandsurvey-2005.owl#Vinelandsurvey_2005_Personal_32">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:comment rdf:datatype="&xsd;string">&quot;Bathes or showers and dries self. SCORING TIP: Mark a &quot;&quot;2&quot;&quot; if the individual bathes or showers without help, including turning the water on and off; mark a &quot;&quot;1&quot;&quot; if the individual needs help with any part of bathing or drying or with turning the water on and off; mark &quot;&quot;0&quot;&quot; if the individual never bathes or showers without help or without reminders. &quot;</rdfs:comment>
