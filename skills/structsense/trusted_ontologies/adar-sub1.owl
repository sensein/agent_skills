    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Definite_unusual_reactions_to_minor_changes_in_subjects_own_routines -->

    <owl:Class rdf:about="&autism-rules;Definite_unusual_reactions_to_minor_changes_in_subjects_own_routines">
        <rdfs:subClassOf rdf:resource="&autism-rules;Difficulties_with_minor_changes_in_subjects_own_routines_or_personal_environment"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Delayed_walked_unaided -->

    <owl:Class rdf:about="&autism-rules;Delayed_walked_unaided">
        <rdfs:subClassOf rdf:resource="&autism-rules;First_walked_unaided"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Depression -->

    <owl:Class rdf:about="&autism-rules;Depression">
        <rdfs:subClassOf rdf:resource="&autism-rules;Mood"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">A mood state characterized by sadness, despair, or discouragement, and melancholic feelings of grief or unhappiness.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0011570</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Destructive_Behavior -->

    <owl:Class rdf:about="&autism-rules;Destructive_Behavior">
        <rdfs:subClassOf rdf:resource="&autism-rules;Intentional_Bad_Behavior"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Intentionally damaging one&apos;s own or others&apos; belongings.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0233520</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Development_definitly_abnormal_in_the_first_3_years_not_unambiguously_autistic_at_that_age -->

    <owl:Class rdf:about="&autism-rules;Development_definitly_abnormal_in_the_first_3_years_not_unambiguously_autistic_at_that_age">
        <rdfs:subClassOf rdf:resource="&autism-rules;Age_when_abnormality_first_evident"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Development_definitly_abnormal_in_the_first_3_years_strongly_indicative_of_autism -->

    <owl:Class rdf:about="&autism-rules;Development_definitly_abnormal_in_the_first_3_years_strongly_indicative_of_autism">
        <rdfs:subClassOf rdf:resource="&autism-rules;Age_when_abnormality_first_evident"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Development_in_the_dirst_3_years_of_life_clearly_normal -->

    <owl:Class rdf:about="&autism-rules;Development_in_the_dirst_3_years_of_life_clearly_normal">
        <rdfs:subClassOf rdf:resource="&autism-rules;Age_when_abnormality_first_evident"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Development_or_Regression_of_Language_Skills -->

    <owl:Class rdf:about="&autism-rules;Development_or_Regression_of_Language_Skills">
        <rdfs:subClassOf rdf:resource="&autism-rules;Language_Ability"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The acquisition or loss of the ability to communicate using language.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C1843016, http://www.nlm.nih.gov/research/umls?cui=C0023013</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Development_possibly_within_normal_limits_during_first_3_years -->

    <owl:Class rdf:about="&autism-rules;Development_possibly_within_normal_limits_during_first_3_years">
        <rdfs:subClassOf rdf:resource="&autism-rules;Age_when_abnormality_first_evident"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Development_probably_abnormal_by_the_age_of_3_years -->

    <owl:Class rdf:about="&autism-rules;Development_probably_abnormal_by_the_age_of_3_years">
        <rdfs:subClassOf rdf:resource="&autism-rules;Age_when_abnormality_first_evident"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Difficulties_with_minor_changes_in_subjects_own_routines_or_personal_environment -->

    <owl:Class rdf:about="&autism-rules;Difficulties_with_minor_changes_in_subjects_own_routines_or_personal_environment">
        <rdfs:subClassOf rdf:resource="&autism-rules;Reaction_to_Unexpected_Change"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Difficulties_with_minor_changes_in_subjects_own_routines_or_personal_environment_UnknownOrNotAsked -->

    <owl:Class rdf:about="&autism-rules;Difficulties_with_minor_changes_in_subjects_own_routines_or_personal_environment_UnknownOrNotAsked">
        <rdfs:subClassOf rdf:resource="&autism-rules;Difficulties_with_minor_changes_in_subjects_own_routines_or_personal_environment"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Direct_Gaze -->

    <owl:Class rdf:about="&autism-rules;Direct_Gaze">
        <rdfs:subClassOf rdf:resource="&autism-rules;Eye_Contact"/>
        <rdfs:comment rdf:datatype="&xsd;string">(Q50) Direct Gaze</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Direct_Gaze_Not_Available -->

    <owl:Class rdf:about="&autism-rules;Direct_Gaze_Not_Available">
        <rdfs:subClassOf rdf:resource="&autism-rules;Direct_Gaze"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Disease_or_Syndrome -->

    <owl:Class rdf:about="&autism-rules;Disease_or_Syndrome">
        <rdfs:subClassOf rdf:resource="&autism-rules;Pathologic_function"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Disobedience -->

    <owl:Class rdf:about="&autism-rules;Disobedience">
        <rdfs:subClassOf rdf:resource="&autism-rules;Intentional_Bad_Behavior"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Intentionally violating rules, commands or prohibitions.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0424347</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Distant_or_Preoccupied_Affect -->

    <owl:Class rdf:about="&autism-rules;Distant_or_Preoccupied_Affect">
        <rdfs:subClassOf rdf:resource="&autism-rules;Affect"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Appearing unemotional, unresponsive, or disconnected from one&apos;s physical environment.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0233484</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Does_not_consistently_appear_to_pay_attention -->

    <owl:Class rdf:about="&autism-rules;Does_not_consistently_appear_to_pay_attention">
        <rdfs:subClassOf rdf:resource="&autism-rules;Attention_to_voice"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Down_Syndrom -->

    <owl:Class rdf:about="&autism-rules;Down_Syndrom">
        <rdfs:subClassOf rdf:resource="&autism-core;AUTISMC1000038"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Eating_Ability -->

    <owl:Class rdf:about="&autism-rules;Eating_Ability">
        <rdfs:subClassOf rdf:resource="&autism-rules;Self-Care"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Indicating need for, and carrying out the coordinated tasks and actions of eating food that has been served or taking hold of a drink, bringing it to the mouth and consuming it in culturally acceptable ways.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d550, http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d560</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Emotional_Outbursts -->

    <owl:Class rdf:about="&autism-rules;Emotional_Outbursts">
        <rdfs:subClassOf rdf:resource="&autism-rules;Control_of_Emotional_Reactions"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">An extreme, violent display of emotion, often in response to frustration, including temper tantrums.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0679475</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Emotional_Regulation_and_Control -->

    <owl:Class rdf:about="&autism-rules;Emotional_Regulation_and_Control">
        <rdfs:subClassOf rdf:resource="&autism-rules;Executive_Function"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Directing or governing one`s own emotions. Individuals with autism spectrum disorder can react negatively to their environment and at times may engage in emotional outbursts.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">N\A</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Emotional_Swings -->

    <owl:Class rdf:about="&autism-rules;Emotional_Swings">
        <rdfs:subClassOf rdf:resource="&autism-rules;Mood"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Tendency to display unpredictable, extreme, and rapidly changing emotions or moods.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0085633</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Emotional_Traits -->

    <owl:Class rdf:about="&autism-rules;Emotional_Traits">
        <rdfs:subClassOf rdf:resource="&autism-rules;Personal_Traits"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The characteristics of a person&apos;s emotional makeup.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0233451</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Empathy -->

    <owl:Class rdf:about="&autism-rules;Empathy">
        <rdfs:subClassOf rdf:resource="&autism-rules;Interpersonal_Awareness"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">An individual&apos;s objective and insightful awareness of the feelings and behavior of others, including demonstration of an awareness of and a concern for the good of others.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D004645</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Engagement_in_Social_Activities -->

    <owl:Class rdf:about="&autism-rules;Engagement_in_Social_Activities">
        <rdfs:subClassOf rdf:resource="&autism-rules;Community_Life_Skills"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Participating in informal or casual gatherings or groups with others who have common interests.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d9205</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Engaging_in_Social_Conversation -->

    <owl:Class rdf:about="&autism-rules;Engaging_in_Social_Conversation">
        <rdfs:subClassOf rdf:resource="&autism-rules;Social_Interest"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Participating in and enjoying interactions with others where the purpose is to be friendly or social, rather than expressing explicit information or needs.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d71041</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Engaging_in_Social_Play -->

    <owl:Class rdf:about="&autism-rules;Engaging_in_Social_Play">
        <rdfs:subClassOf rdf:resource="&autism-rules;Interactions_with_Friends_and_Family"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Participating in and enjoying structured and unstructured games and spontaneous recreation.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d9200</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Enjoys_Parallel_Active_Play_but_Little_or_No_Cooperative_Play -->

    <owl:Class rdf:about="&autism-rules;Enjoys_Parallel_Active_Play_but_Little_or_No_Cooperative_Play">
        <rdfs:subClassOf rdf:resource="&autism-rules;Group_Play_With_Peers"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Environmental_effect_of_humans -->

    <owl:Class rdf:about="&autism-rules;Environmental_effect_of_humans">
        <rdfs:subClassOf rdf:resource="&autism-rules;Human-caused_Phenomenon_or_process"/>
        <rdfs:comment rdf:datatype="&xsd;string">a change in the natural environment that is a result of the activities 
      of human beings</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Epilepsy -->

    <owl:Class rdf:about="&autism-rules;Epilepsy">
        <rdfs:subClassOf rdf:resource="&autism-core;AUTISMC1000038"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Executive_Function -->

    <owl:Class rdf:about="&autism-rules;Executive_Function">
        <rdfs:subClassOf rdf:resource="&autism-rules;Personal_Traits"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">A set of cognitive functions that controls complex, goal-directed thought and behavior. Executive function involves multiple domains, such as concept formation, goal management, cognitive flexibility, inhibition control, impulse control, and working memory.  Executive function in autism spectrum disorder is a subject of continuing research.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D056344</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Expressive_Language -->

    <owl:Class rdf:about="&autism-rules;Expressive_Language">
        <rdfs:subClassOf rdf:resource="&autism-rules;Language_Ability"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to produce and use language in an accurate and meaningful way.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d330</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Expressive_Lexicon -->

    <owl:Class rdf:about="&autism-rules;Expressive_Lexicon">
        <rdfs:subClassOf rdf:resource="&autism-rules;Expressive_Language"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The vocabulary that an individual can produce.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D014825</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Expressive_Morphology -->

    <owl:Class rdf:about="&autism-rules;Expressive_Morphology">
        <rdfs:subClassOf rdf:resource="&autism-rules;Expressive_Language"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to produce accurate forms of words, including the inflections that indicate the grammatical role of a word.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0517141</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Expressive_Phonology -->

    <owl:Class rdf:about="&autism-rules;Expressive_Phonology">
        <rdfs:subClassOf rdf:resource="&autism-rules;Expressive_Language"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to produce sounds according to the sound patterns of language.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D013061, http://purl.bioontology.org/ontology/MSH/D013065</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Expressive_Semantics -->

    <owl:Class rdf:about="&autism-rules;Expressive_Semantics">
        <rdfs:subClassOf rdf:resource="&autism-rules;Expressive_Language"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to produce phrases, sentences, or sets of sentences that successfully convey meaning.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0564246</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Expressive_Syntax -->

    <owl:Class rdf:about="&autism-rules;Expressive_Syntax">
        <rdfs:subClassOf rdf:resource="&autism-rules;Expressive_Language"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to produce phrases and sentences according to the rules of grammar.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C2183469</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Eye_Contact -->

    <owl:Class rdf:about="&autism-rules;Eye_Contact">
        <rdfs:subClassOf rdf:resource="&autism-rules;Reciprocal_Social_Interaction"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Meeting the eyes of another individual in an effort to communicate or in response to communication by the other individual, and integrating eye contact with verbal interaction, including looking at the individual speaking or being addressed.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0870532</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Facial_Expression_Range_NotAvailable -->

    <owl:Class rdf:about="&autism-rules;Facial_Expression_Range_NotAvailable">
        <rdfs:subClassOf rdf:resource="&autism-rules;Range_of_Facial_Expressions_Used_To_Communicate"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Facial_Expressions -->

    <owl:Class rdf:about="&autism-rules;Facial_Expressions">
        <rdfs:subClassOf rdf:resource="&autism-rules;Non-Verbal_Communication"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Observable changes of expression in the face in response to emotional stimuli.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D005149</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Facial_expressions_almost_always_appropriate_to_mood_situation_and_context -->

    <owl:Class rdf:about="&autism-rules;Facial_expressions_almost_always_appropriate_to_mood_situation_and_context">
        <rdfs:subClassOf rdf:resource="&autism-rules;Inappropriate_facial_expressions"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Facial_expressions_obviously_inappropriate_in_several_different_situations -->

    <owl:Class rdf:about="&autism-rules;Facial_expressions_obviously_inappropriate_in_several_different_situations">
        <rdfs:subClassOf rdf:resource="&autism-rules;Inappropriate_facial_expressions"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Facial_expressions_slightly_or_occasionally_inappropriate_or_odd -->

    <owl:Class rdf:about="&autism-rules;Facial_expressions_slightly_or_occasionally_inappropriate_or_odd">
        <rdfs:subClassOf rdf:resource="&autism-rules;Inappropriate_facial_expressions"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Few_or_No_Attempts_To_Share_Enjoyments -->

    <owl:Class rdf:about="&autism-rules;Few_or_No_Attempts_To_Share_Enjoyments">
        <rdfs:subClassOf rdf:resource="&autism-rules;Seeking_To_Share_herHis_Enjoyment_With_Others"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Fewer_Than_Five_Words_Total_or_Speech_Not_Used_on_a_Daily_Basis -->

    <owl:Class rdf:about="&autism-rules;Fewer_Than_Five_Words_Total_or_Speech_Not_Used_on_a_Daily_Basis">
        <rdfs:subClassOf rdf:resource="&autism-rules;Overall_level_of_language"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Severe distortions in the development of many basic psychological functions that are not normal for any stage in development. These distortions are manifested in sustained social impairment, speech abnormalities, and peculiar motor movements.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D002659</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Fine_Motor_Skills -->

    <owl:Class rdf:about="&autism-rules;Fine_Motor_Skills">
        <rdfs:subClassOf rdf:resource="&autism-rules;Motor_Skills"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The small movements of the hands, wrists, fingers, feet, toes, lips, and tongue.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0678857</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#First_and_second_person_confusion_after_phrase_speech_established -->

    <owl:Class rdf:about="&autism-rules;First_and_second_person_confusion_after_phrase_speech_established">
        <rdfs:subClassOf rdf:resource="&autism-rules;Pronominal_reversal"/>
        <rdfs:comment rdf:datatype="&xsd;string">(2) &quot;you/I&quot; or &quot;s/he/I&quot; confusion after phrse speech established, but &quot;you&quot; ot &quot;s/he&quot; not used with intonation of a question</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#First_walked_unaided -->

    <owl:Class rdf:about="&autism-rules;First_walked_unaided">
        <rdfs:subClassOf rdf:resource="&autism-rules;Motor_milestones"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#First_walked_unaided_milestone_not_reached -->

    <owl:Class rdf:about="&autism-rules;First_walked_unaided_milestone_not_reached">
        <rdfs:subClassOf rdf:resource="&autism-rules;First_walked_unaided"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Flexibility_in_Problem_Solving -->

    <owl:Class rdf:about="&autism-rules;Flexibility_in_Problem_Solving">
        <rdfs:subClassOf rdf:resource="&autism-rules;Mental_Flexibility"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to change strategies, or shift mental sets, when involved in problem-solving.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=b1643</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Flexibly_and_spontaneously_offers_comfort -->

    <owl:Class rdf:about="&autism-rules;Flexibly_and_spontaneously_offers_comfort">
        <rdfs:subClassOf rdf:resource="&autism-rules;Offering_Comfort"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Form_Perception -->

    <owl:Class rdf:about="&autism-rules;Form_Perception">
        <rdfs:subClassOf rdf:resource="&autism-rules;Visual_Perception"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The sensory discrimination of a pattern shape or outline.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D005556</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Fragile_X_Syndrom -->

    <owl:Class rdf:about="&autism-rules;Fragile_X_Syndrom">
        <rdfs:subClassOf rdf:resource="&autism-core;AUTISMC1000038"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Frequency -->

    <owl:Class rdf:about="&autism-rules;Frequency">
        <rdfs:subClassOf rdf:resource="http://ontology.neuinfo.org/NIF/Backend/BIRNLex-OBI-proxy.owl#birnlex_11001"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Frequent_Attempts_to_Direct_Attention_to_Things_Enjoys -->

    <owl:Class rdf:about="&autism-rules;Frequent_Attempts_to_Direct_Attention_to_Things_Enjoys">
        <rdfs:subClassOf rdf:resource="&autism-rules;Seeking_To_Share_herHis_Enjoyment_With_Others"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Frequent_Spontaneous_and_Varied_Offers_to_Share_Objects -->

    <owl:Class rdf:about="&autism-rules;Frequent_Spontaneous_and_Varied_Offers_to_Share_Objects">
        <rdfs:subClassOf rdf:resource="&autism-rules;Offering_To_Share"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Frequent_use_of_inappropriate_questions_or_statements -->

    <owl:Class rdf:about="&autism-rules;Frequent_use_of_inappropriate_questions_or_statements">
        <rdfs:subClassOf rdf:resource="&autism-rules;Inappropriate_questions_or_statements"/>
        <rdfs:comment rdf:datatype="&xsd;string">(2) Frequent use of questions/statements that are odd or obviously inappropriate to the situation</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Friendships -->

    <owl:Class rdf:about="&autism-rules;Friendships">
        <rdfs:subClassOf rdf:resource="&autism-rules;Relating_to_Others"/>
        <rdfs:comment rdf:datatype="&xsd;string">(Q65) Friendships</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Friendships_NotAvailable -->

    <owl:Class rdf:about="&autism-rules;Friendships_NotAvailable">
        <rdfs:subClassOf rdf:resource="&autism-rules;Friendships"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Friendships_NotKnownOrNotAsked -->

    <owl:Class rdf:about="&autism-rules;Friendships_NotKnownOrNotAsked">
        <rdfs:subClassOf rdf:resource="&autism-rules;Friendships"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Full_Facial_Expression_Range -->

    <owl:Class rdf:about="&autism-rules;Full_Facial_Expression_Range">
        <rdfs:subClassOf rdf:resource="&autism-rules;Range_of_Facial_Expressions_Used_To_Communicate"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Functional_Laterality -->

    <owl:Class rdf:about="&autism-rules;Functional_Laterality">
        <rdfs:subClassOf rdf:resource="&autism-rules;Motor_Skills"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Behavioral manifestations of cerebral dominance in which there is preferential use and superior functioning of either the left or the right side, as in the preferred use of the right hand or right foot.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D007839</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Functional_Use -->

    <owl:Class rdf:about="&autism-rules;Functional_Use">
        <rdfs:subClassOf rdf:resource="&autism-rules;Overall_level_of_language"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Severe distortions in the development of many basic psychological functions that are not normal for any stage in development. These distortions are manifested in sustained social impairment, speech abnormalities, and peculiar motor movements.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D002659</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#General_loss_of_skills -->

    <owl:Class rdf:about="&autism-rules;General_loss_of_skills">
        <rdfs:subClassOf rdf:resource="&autism-rules;Loss_of_skills"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Generally_responsive_to_other_childrens_approaches -->

    <owl:Class rdf:about="&autism-rules;Generally_responsive_to_other_childrens_approaches">
        <rdfs:subClassOf rdf:resource="&autism-rules;Response_to_Approaches_Of_Other_Children"/>
        <rdfs:comment rdf:datatype="&xsd;string">generally responsive to other children&apos;s approaches, although may be hesitant initially if other children are too rough or intrusive; simetimes makes a clear effort to keep an interaction going with a child other than a sibling by gesturing, vocalizing, offering an object, etc.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Genetic_function -->

    <owl:Class rdf:about="&autism-rules;Genetic_function">
        <rdfs:subClassOf rdf:resource="&autism-rules;Molecular_function"/>
        <rdfs:comment rdf:datatype="&xsd;string">Functions of or related to the maintenance, translation or expression of the genetic material.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Gestures -->

    <owl:Class rdf:about="&autism-rules;Gestures">
        <rdfs:subClassOf rdf:resource="&autism-rules;Non-Verbal_Communication"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Movement of a part of the body for the purpose of communication.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D005868</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Gross_Motor_Skills -->

    <owl:Class rdf:about="&autism-rules;Gross_Motor_Skills">
        <rdfs:subClassOf rdf:resource="&autism-rules;Motor_Skills"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Skills that involve the large muscle groups, including movements of the arms, legs, feet, or the entire body.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0678858</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Group_Play_With_Peers -->

    <owl:Class rdf:about="&autism-rules;Group_Play_With_Peers">
        <rdfs:subClassOf rdf:resource="&autism-rules;Engaging_in_Social_Play"/>
        <rdfs:comment rdf:datatype="&xsd;string">(Q64) Group Play With Peers</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Group_Play_With_Peers_NotAvailable -->

    <owl:Class rdf:about="&autism-rules;Group_Play_With_Peers_NotAvailable">
        <rdfs:subClassOf rdf:resource="&autism-rules;Group_Play_With_Peers"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Group_Play_With_Peers_UnknownOrNotAsked -->

    <owl:Class rdf:about="&autism-rules;Group_Play_With_Peers_UnknownOrNotAsked">
        <rdfs:subClassOf rdf:resource="&autism-rules;Group_Play_With_Peers"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Hand_and_finger_mannerisms -->

    <owl:Class rdf:about="&autism-rules;Hand_and_finger_mannerisms">
        <rdfs:subClassOf rdf:resource="&autism-rules;Motor_Perseveration"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Hand_and_finger_mannerisms_NotAvailable -->

    <owl:Class rdf:about="&autism-rules;Hand_and_finger_mannerisms_NotAvailable">
        <rdfs:subClassOf rdf:resource="&autism-rules;Hand_and_finger_mannerisms"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Hand_and_finger_mannerisms_UnknownOrNotAsked -->

    <owl:Class rdf:about="&autism-rules;Hand_and_finger_mannerisms_UnknownOrNotAsked">
        <rdfs:subClassOf rdf:resource="&autism-rules;Hand_and_finger_mannerisms"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Has_no_unusual_sensory_interests -->

    <owl:Class rdf:about="&autism-rules;Has_no_unusual_sensory_interests">
        <rdfs:subClassOf rdf:resource="&autism-rules;Unusual_sensory_interests"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Has_partial_response_or_indirect_physical_approach -->

    <owl:Class rdf:about="&autism-rules;Has_partial_response_or_indirect_physical_approach">
        <rdfs:subClassOf rdf:resource="&autism-rules;Offering_Comfort"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Has_to_say_one_or_more_things_in_a_special_way -->

    <owl:Class rdf:about="&autism-rules;Has_to_say_one_or_more_things_in_a_special_way">
        <rdfs:subClassOf rdf:resource="&autism-rules;Verbal_rituals"/>
        <rdfs:comment rdf:datatype="&xsd;string">(2) Subject has to say one or more things in a special way; rituals mayintrude on family life, may involve other family members and some distress at interruption, or may cause some disturbance or minor reorganization of family life that can be tolerated by most families</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Has_unusual_sensory_interest_that_takes_up_a_major_amount_of_time -->

    <owl:Class rdf:about="&autism-rules;Has_unusual_sensory_interest_that_takes_up_a_major_amount_of_time">
        <rdfs:subClassOf rdf:resource="&autism-rules;Unusual_sensory_interests"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Head_Shaking -->

    <owl:Class rdf:about="&autism-rules;Head_Shaking">
        <rdfs:subClassOf rdf:resource="&autism-rules;Gestures"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Home_Life_Skills -->

    <owl:Class rdf:about="&autism-rules;Home_Life_Skills">
        <rdfs:subClassOf rdf:resource="&autism-rules;Adaptive_Life_Skills"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Carrying out domestic and everyday actions and tasks, including adhering to household rules, caring for one&apos;s self and one&apos;s possessions, and performing household tasks.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d6</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Human-caused_Phenomenon_or_process -->

    <owl:Class rdf:about="&autism-rules;Human-caused_Phenomenon_or_process">
        <rdfs:subClassOf rdf:resource="http://www.ifomis.org/bfo/1.1/span#Process"/>
        <rdfs:comment rdf:datatype="&xsd;string">A phenomenon or process that is a result of the activities of human beings.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Human_With_DSM-5_Diagnosis_definition_A -->

    <owl:Class rdf:about="&autism-rules;Human_With_DSM-5_Diagnosis_definition_A">
        <rdfs:subClassOf rdf:resource="&autism-rules;Human_With_DSM-5_Diagnostic_Criterion"/>
        <rdfs:comment rdf:datatype="&xsd;string">Persistent deficits in social communication and social interaction across multiple contexts, as manifested by the following, currently or by history</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Human_With_DSM-5_Diagnosis_definition_A_1 -->

    <owl:Class rdf:about="&autism-rules;Human_With_DSM-5_Diagnosis_definition_A_1">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;Reciprocal_Conversation_Little_or_No"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;Reciprocal_Conversation_Occasional"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
