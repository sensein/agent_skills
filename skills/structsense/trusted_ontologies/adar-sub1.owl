    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Human_with_DSM-IV_definition_A_1_a -->

    <owl:Class rdf:about="&autism-rules;Human_with_DSM-IV_definition_A_1_a">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;Cinsges_Inconsistant_Spontaneous_Use"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;Cinsges_Limited_Spotaneous_Use"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;Cinsges_No_Use"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;Head_Shaking_Never"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;Head_Shaking_Sometimes"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;Never_Nodes_Spontaneously"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;Sometimes_Nodes_Spontaneously"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;gaze_Brief_Definit_Direct_Gaze"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;gaze_Uncertain_Occasional_Direct_Gaze"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;gaze_Unusuall_or_Odd_Gaze"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;qualov_May_Use_Eye_Gaze_or_Vocalization"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;qualov_No_Eye_Gaze_and_Vocalization"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;qualov_Rarely_Shows_Social_Intentionality_Involving_Eye_Gaze_or_Vocalization"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;rfacex_Little_Or_No_Emotions_Indication_Facial_Expression_Range"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;rfacex_Markedly_Limited_Facial_Expression_Range"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;rfacex_Somewhat_Limited_Facial_Expression_Range"/>
                                    </owl:Restriction>
                                </owl:unionOf>
                            </owl:Class>
                            <owl:Restriction>
