        <rdfs:subClassOf rdf:resource="&autism-rules;Unusual_attachment_to_objects"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Unusual_attachment_to_objects -->

