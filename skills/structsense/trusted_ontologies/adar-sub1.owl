    </owl:DatatypeProperty>
    


    <!-- http://purl.org/autism-ontology/1.0/ca_vinelandsurvey-2005.owl#Vinelandsurvey_2005_InterpersRelation_13 -->

    <owl:DatatypeProperty rdf:about="http://purl.org/autism-ontology/1.0/ca_vinelandsurvey-2005.owl#Vinelandsurvey_2005_InterpersRelation_13">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:comment rdf:datatype="&xsd;string">&quot;Uses actions to show happiness or concern for others (for example, hugs, pats arm, holds hands, etc.).&quot;</rdfs:comment>
        <assessment-result:valueRange rdf:datatype="&xsd;string">0;1;2</assessment-result:valueRange>
