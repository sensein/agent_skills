    <!-- http://purl.org/autism-ontology/1.0/ca_vinelandsurvey-2005.owl#SubjectKey -->

    <owl:DatatypeProperty rdf:about="http://purl.org/autism-ontology/1.0/ca_vinelandsurvey-2005.owl#SubjectKey">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:comment rdf:datatype="&xsd;string">&quot;The NDAR Global Unique Identifier  (GUID) for subjects which identifies a subject in NDAR. A GUID retrieved from the NDAR GUID system.  The GUID consists of a prefix, GUID pattern, and check character. The prefix chosen for this system is ÂNDARÂ. For the GUID a pattern is AANNNAA, where A represents alphabetic and N represents numerical characters. The check character can be numerical or alphabetic. An example of GUID for a valid subject is NDARCJ743PV3&quot;</rdfs:comment>
        <assessment-result:valueRange rdf:datatype="&xsd;string">GUID should exist in the GUID System</assessment-result:valueRange>
        <assessment-result:isRequired rdf:datatype="&xsd;string">Required</assessment-result:isRequired>
        <assessment-result:usedIn rdf:datatype="&xsd;string">Vineland Survey Interview Form - 2005</assessment-result:usedIn>
        <rdfs:domain rdf:resource="http://purl.org/autism-ontology/1.0/ca_vinelandsurvey-2005.owl#AUTISMC000003"/>
        <rdfs:subPropertyOf rdf:resource="http://purl.org/autism-ontology/1.0/ca_vinelandsurvey-2005.owl#Header"/>
    </owl:DatatypeProperty>
    


