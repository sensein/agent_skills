        <rdfs:subClassOf rdf:resource="&autism-rules;Intonation_Volume_Rhythm_Rate"/>
        <rdfs:comment rdf:datatype="&xsd;string">(3) Speech that is frequently peculiar or difficult to understand because of abnormalities of type specified under &quot;2&quot;</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Speech_tendsOrTended_to_be_more_repetitive_than_most_subject -->

    <owl:Class rdf:about="&autism-rules;Speech_tendsOrTended_to_be_more_repetitive_than_most_subject">
        <rdfs:subClassOf rdf:resource="&autism-rules;Stereotyped_utterances_and_delayed_echolalia"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Speech_with_abnormality -->

