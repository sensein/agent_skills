        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:comment rdf:datatype="&xsd;string">&quot;Follows directions for health care procedures, special diet, or medical treatments. You may mark &quot;&quot;N/O&quot;&quot; for No Opportunity if the individual does not have a health concern that requires special procedures, diet, or treatments. &quot;</rdfs:comment>
        <assessment-result:valueRange rdf:datatype="&xsd;string">0;1;2</assessment-result:valueRange>
