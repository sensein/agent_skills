        <rdfs:subClassOf rdf:resource="&autism-rules;Restricted_and_Unusual_Interests"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Atypical degree of interest in sensory stimuli, such as flashing lights, textures, or sounds.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">N\A</autism-rules:has_definition_source>
    </owl:Class>
    


