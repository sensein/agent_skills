    <!-- http://purl.org/autism-ontology/1.0/ca_adi-2003.owl#SubjectKey -->

    <owl:DatatypeProperty rdf:about="http://purl.org/autism-ontology/1.0/ca_adi-2003.owl#SubjectKey">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:comment rdf:datatype="&xsd;string">&quot;The NDAR Global Unique Identifier  (GUID) for subjects which identifies a subject in NDAR. &amp;&amp;&amp;&amp; A GUID retrieved from the NDAR GUID system.  The GUID consists of a prefix, GUID pattern, and check character. The prefix chosen for this system is ÂNDARÂ. For the GUID a pattern is AANNNAA, where A represents alphabetic and N represents numerical characters. The check character can be numerical or alphabetic. &amp;&amp;&amp;&amp; An example of GUID for a valid subject is NDARCJ743PV3&quot;</rdfs:comment>
        <assessment-result:size rdf:datatype="&xsd;string">20</assessment-result:size>
        <assessment-result:usedIn rdf:datatype="&xsd;string">ADI-2003</assessment-result:usedIn>
        <assessment-result:valueRange rdf:datatype="&xsd;string">GUID should exist in the GUID System
</assessment-result:valueRange>
        <assessment-result:isRequired rdf:datatype="&xsd;string">Required</assessment-result:isRequired>
        <rdfs:domain rdf:resource="http://purl.org/autism-ontology/1.0/ca_adi-2003.owl#AUTISMC000000"/>
        <rdfs:subPropertyOf rdf:resource="http://purl.org/autism-ontology/1.0/ca_adi-2003.owl#Header"/>
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>
    


