    <!-- http://purl.org/autism-ontology/1.0/autism-core.owl#AUTISMC1000054 -->

    <owl:Class rdf:about="&autism-core;AUTISMC1000054">
        <rdfs:label rdf:datatype="&xsd;string">Adaptive behavior phenotype</rdfs:label>
        <rdfs:subClassOf rdf:resource="&autism-core;AUTISMC1000015"/>
        <rdfs:comment rdf:datatype="&xsd;string">Adaptive behaviors are everyday living skills such as walking, talking, getting dressed, going to school, going to work, preparing a meal, cleaning the house, etc. They are skills that a person learns in the process of adapting to his/her surroundings. Since adaptive behaviors are for the most part developmental, it is possible to describe a person&apos;s adaptive behavior as an age-equivalent score. (http://psychology.wikia.com/wiki/Vineland_Adaptive_Behavior_Scale)</rdfs:comment>
        <rdfs:comment rdf:datatype="&xsd;string">Maps generally to items on the Vineland Adaptive Behavior Scale</rdfs:comment>
    </owl:Class>
    


