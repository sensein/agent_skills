        <rdfs:subClassOf rdf:resource="&autism-rules;Visual_Perception"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The awareness of the spatial properties of objects; including physical space.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D013028</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Special_interest_of_unusual_degree -->

