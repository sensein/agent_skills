                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="&autism-core;AUTISMC1000053"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-core.owl#AUTISMC1000079 -->

    <owl:Class rdf:about="&autism-core;AUTISMC1000079">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&autism-core;AUTISMC1000053"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="&autism-core;AUTISMC1000034"/>
                            <rdf:Description rdf:about="&autism-core;AUTISMC1000060"/>
                            <rdf:Description rdf:about="&autism-core;AUTISMC1000063"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="&autism-core;AUTISMC1000053"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-core.owl#AUTISMC1000080 -->

    <owl:Class rdf:about="&autism-core;AUTISMC1000080">
        <rdfs:label rdf:datatype="&xsd;string">Early development and skill acquisition phenotype</rdfs:label>
        <rdfs:subClassOf rdf:resource="&autism-core;AUTISMC1000015"/>
        <rdfs:comment rdf:datatype="&xsd;string">Relates to assessment items under &apos;Early Development&apos; and &apos;Acquisition and Loss of Language/Other Skills&apos; sections of ADI-R 2003</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-core.owl#AUTISMC1000081 -->

    <owl:Class rdf:about="&autism-core;AUTISMC1000081">
        <rdfs:label rdf:datatype="&xsd;string">Word acquisition</rdfs:label>
        <rdfs:subClassOf rdf:resource="&autism-core;AUTISMC1000019"/>
        <rdfs:comment rdf:datatype="&xsd;string"></rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-core.owl#AUTISMC100009 -->

    <owl:Class rdf:about="&autism-core;AUTISMC100009">
        <rdfs:label rdf:datatype="&xsd;string">Qualitative measure</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.org/obo/owl/PATO#PATO_0000068"/>
        <rdfs:comment rdf:datatype="&xsd;string">An entry in an ordinal scale</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-core.owl#AUTISMC100010 -->

    <owl:Class rdf:about="&autism-core;AUTISMC100010">
        <rdfs:label rdf:datatype="&xsd;string">Marked</rdfs:label>
        <rdfs:subClassOf rdf:resource="&autism-core;AUTISMC100009"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-core.owl#AUTISMC100011 -->

    <owl:Class rdf:about="&autism-core;AUTISMC100011">
        <rdfs:label rdf:datatype="&xsd;string">present or absent</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.org/obo/owl/PATO#PATO_0000068"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-core.owl#Degree_of_Restrictive_repetitive_and_stereotyped_behaviors -->

    <owl:Class rdf:about="&autism-core;Degree_of_Restrictive_repetitive_and_stereotyped_behaviors">
        <rdfs:label rdf:datatype="&xsd;string">Restrictive, repetitive and stereotyped behaviors phenotype</rdfs:label>
        <rdfs:subClassOf rdf:resource="&autism-core;AUTISMC1000015"/>
        <rdfs:comment rdf:datatype="&xsd;string">Relates to assessment items under &apos;Interests and Behaviors&apos; section of ADI-R 2003</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Ability_to_Converse_in_Social_Settings -->

    <owl:Class rdf:about="&autism-rules;Ability_to_Converse_in_Social_Settings">
        <rdfs:subClassOf rdf:resource="&autism-rules;Conversational_Skills"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to participate in and contribute to friendly and casual conversations with others in a contextually and socially appropriate manner, including asking questions relevant to the conversational topic.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d350</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Ability_to_Convey_Appropriate_Level_of_Detail -->

    <owl:Class rdf:about="&autism-rules;Ability_to_Convey_Appropriate_Level_of_Detail">
        <rdfs:subClassOf rdf:resource="&autism-rules;Ability_to_Convey_Information"/>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">N\A</autism-rules:has_definition_source>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to recognize and express the appropriate amount of information required during conversation on a given topic, such as sharing details that will interest another without including unnecessary information.</autism-rules:has_definition>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Ability_to_Convey_Correct_Information_ -->

    <owl:Class rdf:about="&autism-rules;Ability_to_Convey_Correct_Information_">
        <rdfs:subClassOf rdf:resource="&autism-rules;Ability_to_Convey_Information"/>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">N\A</autism-rules:has_definition_source>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to understand and express accurate and relevant information during conversations, such as correctly answering questions of others.</autism-rules:has_definition>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Ability_to_Convey_Feelings -->

    <owl:Class rdf:about="&autism-rules;Ability_to_Convey_Feelings">
        <rdfs:subClassOf rdf:resource="&autism-rules;Ability_to_Convey_Information"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to understand and accurately express information regarding one&apos;s own thoughts, opinions, and feelings.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C1821397</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Ability_to_Convey_Information -->

    <owl:Class rdf:about="&autism-rules;Ability_to_Convey_Information">
        <rdfs:subClassOf rdf:resource="&autism-rules;Conversational_Skills"/>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">N\A</autism-rules:has_definition_source>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to understand and express a variety of types of information in conversation, including reporting of events, answering questions of others, and expressing one&apos;s own thoughts and feelings.</autism-rules:has_definition>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Ability_to_Engage_in_Casual_Conversation -->

    <owl:Class rdf:about="&autism-rules;Ability_to_Engage_in_Casual_Conversation">
        <rdfs:subClassOf rdf:resource="&autism-rules;Ability_to_Converse_in_Social_Settings"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to maintain casual interactions with others such as chatting and small talk, in a contextually and socially appropriate manner.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d3501</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Abnormal_idiosyncratic_Negative_response_to_specific_sensory_stimuli -->

    <owl:Class rdf:about="&autism-rules;Abnormal_idiosyncratic_Negative_response_to_specific_sensory_stimuli">
        <rdfs:subClassOf rdf:resource="&autism-rules;Reaction_to_Sensory_Stimuli"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Abnormal_idiosyncratic_Negative_response_to_specific_sensory_stimuli_UnknownOrNotAsked -->

    <owl:Class rdf:about="&autism-rules;Abnormal_idiosyncratic_Negative_response_to_specific_sensory_stimuli_UnknownOrNotAsked">
        <rdfs:subClassOf rdf:resource="&autism-rules;Abnormal_idiosyncratic_Negative_response_to_specific_sensory_stimuli"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Abnormal_speech -->

    <owl:Class rdf:about="&autism-rules;Abnormal_speech">
        <rdfs:subClassOf rdf:resource="&autism-rules;Intonation_Volume_Rhythm_Rate"/>
        <rdfs:comment rdf:datatype="&xsd;string">(2) Speech that is clearly abnormal in terms of any or all of the following: (a) odd intonation or inappropriate pitch and stress; (b) markedly flat and toneless or mechanical speech; (c) consistently abnormal volume that lacks modulation; (d) imappropriate, poorly modulated rate or rhythm (either unusually slow or halting or unusually rapid or jerky) to a degree that creates some interference with intelligibility</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Abnormal_speech_due_to_other_impairment -->

    <owl:Class rdf:about="&autism-rules;Abnormal_speech_due_to_other_impairment">
        <rdfs:subClassOf rdf:resource="&autism-rules;Intonation_Volume_Rhythm_Rate"/>
        <rdfs:comment rdf:datatype="&xsd;string">(7) Stutter or stammer ; abnormal intonation due to severe hearing impairment; or intonation abnormality due to neurological disorder causing motor dysfunction</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Abstract_Thinking -->

    <owl:Class rdf:about="&autism-rules;Abstract_Thinking">
        <rdfs:subClassOf rdf:resource="&autism-rules;Cognitive_Ability"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The conceptual process of creating ideas and generalizations that are distinct from concrete realities, specific objects, or actual instances.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d163</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Acquisition_of_bladder_control -->

    <owl:Class rdf:about="&autism-rules;Acquisition_of_bladder_control">
        <rdfs:subClassOf rdf:resource="&autism-rules;Control_Acquisition"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Acquisition_of_bladder_control_Daytime -->

    <owl:Class rdf:about="&autism-rules;Acquisition_of_bladder_control_Daytime">
        <rdfs:subClassOf rdf:resource="&autism-rules;Acquisition_of_bladder_control"/>
        <rdfs:comment rdf:datatype="&xsd;string">(Q6)</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Acquisition_of_bladder_control_Nighttime -->

    <owl:Class rdf:about="&autism-rules;Acquisition_of_bladder_control_Nighttime">
        <rdfs:subClassOf rdf:resource="&autism-rules;Acquisition_of_bladder_control"/>
        <rdfs:comment rdf:datatype="&xsd;string">(Q7)</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Acquisition_of_bowel_control -->

    <owl:Class rdf:about="&autism-rules;Acquisition_of_bowel_control">
        <rdfs:subClassOf rdf:resource="&autism-rules;Control_Acquisition"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Acquisition_of_control_certainty -->

    <owl:Class rdf:about="&autism-rules;Acquisition_of_control_certainty">
        <rdfs:subClassOf rdf:resource="&autism-rules;Refineable_entity"/>
        <owl:disjointWith rdf:resource="&autism-rules;Loss_of_skills_certainty"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Acting_Before_Thinking -->

    <owl:Class rdf:about="&autism-rules;Acting_Before_Thinking">
        <rdfs:subClassOf rdf:resource="&autism-rules;Impulse_Control_and_Regulation"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Taking action before considering the consequences or impact of such action.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D007175</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Actively_Seeks_and_Plays_Cooperatively_in_Several_Different_Groups -->

    <owl:Class rdf:about="&autism-rules;Actively_Seeks_and_Plays_Cooperatively_in_Several_Different_Groups">
        <rdfs:subClassOf rdf:resource="&autism-rules;Group_Play_With_Peers"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Adaptive_Life_Skills -->

    <owl:Class rdf:about="&autism-rules;Adaptive_Life_Skills">
        <rdfs:subClassOf rdf:resource="&autism-rules;Social_Competence"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Everyday skills that are needed at home and in the community.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0085880</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Adherence_to_Rituals_and_Routines -->

    <owl:Class rdf:about="&autism-rules;Adherence_to_Rituals_and_Routines">
        <rdfs:subClassOf rdf:resource="&autism-rules;Restricted_and_Repetitive_Behavior"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Intolerance for deviation from routine, or Insistence on a specific order.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C1837653</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Adherence_to_Rules_in_the_Community -->

    <owl:Class rdf:about="&autism-rules;Adherence_to_Rules_in_the_Community">
        <rdfs:subClassOf rdf:resource="&autism-rules;Community_Life_Skills"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Understanding and obeying rules and laws when in the broader community.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0562410, http://www.nlm.nih.gov/research/umls?cui=C0562415</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Adherence_to_Rules_in_the_Home -->

    <owl:Class rdf:about="&autism-rules;Adherence_to_Rules_in_the_Home">
        <rdfs:subClassOf rdf:resource="&autism-rules;Home_Life_Skills"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Understanding and obeying rules that have been determined for appropriate behavior within the household.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0562410, http://www.nlm.nih.gov/research/umls?cui=C0562415</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Affect -->

    <owl:Class rdf:about="&autism-rules;Affect">
        <rdfs:subClassOf rdf:resource="&autism-rules;Emotional_Traits"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Conveying meaning by movements of the body, such as facial gestures, arm and hand movements, and postures.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d3350</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Age_parents_first_noticed_something_was_mot_right -->

    <owl:Class rdf:about="&autism-rules;Age_parents_first_noticed_something_was_mot_right">
        <rdfs:subClassOf rdf:resource="&autism-core;AUTISMC1000080"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Age_when_abnormality_first_evident -->

    <owl:Class rdf:about="&autism-rules;Age_when_abnormality_first_evident">
        <rdfs:subClassOf rdf:resource="&autism-core;AUTISMC1000080"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Age_when_abnormality_first_evident_UnknownOrNotAsked -->

    <owl:Class rdf:about="&autism-rules;Age_when_abnormality_first_evident_UnknownOrNotAsked">
        <rdfs:subClassOf rdf:resource="&autism-rules;Age_when_abnormality_first_evident"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Aggressive_Behavior -->

    <owl:Class rdf:about="&autism-rules;Aggressive_Behavior">
        <rdfs:subClassOf rdf:resource="&autism-rules;Intentional_Bad_Behavior"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Behavior which may be manifested by destructive and attacking action which is verbal or physical, by covert attitudes of hostility or by obstructionism.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D000374</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#An_interest_in_infant_toys -->

    <owl:Class rdf:about="&autism-rules;An_interest_in_infant_toys">
        <rdfs:subClassOf rdf:resource="&autism-rules;Repetitive_use_of_objects_or_interest_in_parts_of_objects"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Analytic_Capability -->

    <owl:Class rdf:about="&autism-rules;Analytic_Capability">
        <rdfs:subClassOf rdf:resource="&autism-rules;Cognitive_Ability"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Skill in reasoning, including problem solving and numeracy.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d175</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Anger_Control -->

    <owl:Class rdf:about="&autism-rules;Anger_Control">
        <rdfs:subClassOf rdf:resource="&autism-rules;Control_of_Emotional_Reactions"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to control and appropriately manage a strong emotional feeling of displeasure aroused by being interfered with, injured or threatened.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0002957</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Anxiety -->

    <owl:Class rdf:about="&autism-rules;Anxiety">
        <rdfs:subClassOf rdf:resource="&autism-rules;Mood"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Feeling unreasonably or excessively afraid of impending actual or imagined danger; including feelings of panic and phobias.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D001008</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Appropriate_and_Spontaneous_Use -->

    <owl:Class rdf:about="&autism-rules;Appropriate_and_Spontaneous_Use">
        <rdfs:subClassOf rdf:resource="&autism-rules;Conventional_or_Instrumental_Gestures"/>
        <rdfs:comment rdf:datatype="&xsd;string">Appropriate and spontaneous use of a variety of conventional or instrumental gestures</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Appropriate_response_to_overtures_by_familiar_and_unfamiliar_adults -->

    <owl:Class rdf:about="&autism-rules;Appropriate_response_to_overtures_by_familiar_and_unfamiliar_adults">
        <rdfs:subClassOf rdf:resource="&autism-rules;Appropriateness_of_social_responses"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Appropriateness_of_social_responses -->

    <owl:Class rdf:about="&autism-rules;Appropriateness_of_social_responses">
        <rdfs:subClassOf rdf:resource="&autism-rules;Reciprocal_Social_Interaction"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Appropriateness_of_social_responses_NA -->

    <owl:Class rdf:about="&autism-rules;Appropriateness_of_social_responses_NA">
        <rdfs:subClassOf rdf:resource="&autism-rules;Appropriateness_of_social_responses"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Appropriateness_of_social_responses_UnknownOrNotAsked -->

    <owl:Class rdf:about="&autism-rules;Appropriateness_of_social_responses_UnknownOrNotAsked">
        <rdfs:subClassOf rdf:resource="&autism-rules;Appropriateness_of_social_responses"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Association_of_loss_of_language_with_physical_illness -->

    <owl:Class rdf:about="&autism-rules;Association_of_loss_of_language_with_physical_illness">
        <rdfs:subClassOf rdf:resource="&autism-rules;Loss_of_language_skills_or_other_skills"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Attachment_to_an_unusual_object_causes_significant_distress_on_separation -->

    <owl:Class rdf:about="&autism-rules;Attachment_to_an_unusual_object_causes_significant_distress_on_separation">
        <rdfs:subClassOf rdf:resource="&autism-rules;Unusual_attachment_to_objects"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Attachment_to_shooter_comforter_or_other_unusual_object_beyond_age -->

    <owl:Class rdf:about="&autism-rules;Attachment_to_shooter_comforter_or_other_unusual_object_beyond_age">
        <rdfs:subClassOf rdf:resource="&autism-rules;Unusual_attachment_to_objects"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Attention_and_Focus -->

    <owl:Class rdf:about="&autism-rules;Attention_and_Focus">
        <rdfs:subClassOf rdf:resource="&autism-rules;Working_Memory"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to focus on an external stimulus or internal experience for the required period of time, including intentionally focusing on specific stimuli, such as by filtering out distracting noises.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=b140, http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d160</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Attention_to_voice -->

    <owl:Class rdf:about="&autism-rules;Attention_to_voice">
        <rdfs:subClassOf rdf:resource="&autism-rules;Recognition_and_Responsiveness_to_Voice"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Attention_to_voice_NotAvailable -->

    <owl:Class rdf:about="&autism-rules;Attention_to_voice_NotAvailable">
        <rdfs:subClassOf rdf:resource="&autism-rules;Attention_to_voice"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Attention_to_voice_UnknownOrNotAsked -->

    <owl:Class rdf:about="&autism-rules;Attention_to_voice_UnknownOrNotAsked">
        <rdfs:subClassOf rdf:resource="&autism-rules;Attention_to_voice"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Autism -->

    <owl:Class rdf:about="&autism-rules;Autism">
        <rdfs:subClassOf rdf:resource="&autism-core;AUTISMC1000038"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Autism_High_Level_Visualizer -->

    <owl:Class rdf:about="&autism-rules;Autism_High_Level_Visualizer">
        <rdfs:subClassOf rdf:resource="http://ontology.neuinfo.org/NIF/Backend/BIRNLex-OBI-proxy.owl#birnlex_11001"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Autism_Phenotype -->

    <owl:Class rdf:about="&autism-rules;Autism_Phenotype">
        <rdfs:subClassOf rdf:resource="http://www.ifomis.org/bfo/1.1/snap#Disposition"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Severe distortions in the development of many basic psychological functions that are not normal for any stage in development. These distortions are manifested in sustained social impairment, speech abnormalities, and peculiar motor movements.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D002659</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Autoimmune_Disease -->

    <owl:Class rdf:about="&autism-rules;Autoimmune_Disease">
        <rdfs:subClassOf rdf:resource="&autism-core;AUTISMC1000038"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Awareness_and_Avoidance_of_Danger -->

    <owl:Class rdf:about="&autism-rules;Awareness_and_Avoidance_of_Danger">
        <rdfs:subClassOf rdf:resource="&autism-rules;Planning"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Avoiding risks and potentially hazardous situations that can lead to injury or harm.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d571</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Awareness_of_Harmful_Social_Situations -->

    <owl:Class rdf:about="&autism-rules;Awareness_of_Harmful_Social_Situations">
        <rdfs:subClassOf rdf:resource="&autism-rules;Awareness_of_Social_Cues"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Being aware of and maintaining a distance between oneself and others that is contextually, socially and culturally appropriate.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d7204</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Awareness_of_Social_Cues -->

    <owl:Class rdf:about="&autism-rules;Awareness_of_Social_Cues">
        <rdfs:subClassOf rdf:resource="&autism-rules;Recognition_of_Social_Norms"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Giving and reacting appropriately to signs and hints that occur in social interactions. This ability can be compromised in individuals with autism spectrum disorder.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C2371537</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Awareness_of_Social_and_Personal_Space -->

    <owl:Class rdf:about="&autism-rules;Awareness_of_Social_and_Personal_Space">
        <rdfs:subClassOf rdf:resource="&autism-rules;Awareness_of_Social_Cues"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Recognizing when being treated poorly or unfairly by others.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C1821431</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Biologic_function -->

    <owl:Class rdf:about="&autism-rules;Biologic_function">
        <rdfs:subClassOf rdf:resource="&autism-rules;Natural_phenomenon_or_process"/>
        <rdfs:comment rdf:datatype="&xsd;string">A state, activity or process of the body or one of its systems or parts.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Bowel_Disorders -->

    <owl:Class rdf:about="&autism-rules;Bowel_Disorders">
        <rdfs:subClassOf rdf:resource="&autism-core;AUTISMC1000038"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Brief_Definit_Direct_Gaze -->

    <owl:Class rdf:about="&autism-rules;Brief_Definit_Direct_Gaze">
        <rdfs:subClassOf rdf:resource="&autism-rules;Direct_Gaze"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Can_perform_unexpected_action_with_unexpected_object_when_requested -->

    <owl:Class rdf:about="&autism-rules;Can_perform_unexpected_action_with_unexpected_object_when_requested">
        <rdfs:subClassOf rdf:resource="&autism-rules;Comprehension_of_simple_language"/>
        <rdfs:comment rdf:datatype="&xsd;string">(0) In response to a request can usually perform an unexpected action with an unexpected object; or could place an object, other than something to be used by self (such as boots or a toy), in an unexpected location in a different room (?Put the keys on the kitchen table&quot;)</rdfs:comment>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Severe distortions in the development of many basic psychological functions that are not normal for any stage in development. These distortions are manifested in sustained social impairment, speech abnormalities, and peculiar motor movements.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D002659</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Can_usually_get_object_from_another_room_when_requested -->

    <owl:Class rdf:about="&autism-rules;Can_usually_get_object_from_another_room_when_requested">
        <rdfs:subClassOf rdf:resource="&autism-rules;Comprehension_of_simple_language"/>
        <rdfs:comment rdf:datatype="&xsd;string">(1) In response to a request can usually get an object, other than something for self or something highly contextualized, from another room (?Get the keys from the Kitchen table&quot;), but usually cannot carry out a new action on this object or put it in a &quot;new&quot; place</rdfs:comment>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Severe distortions in the development of many basic psychological functions that are not normal for any stage in development. These distortions are manifested in sustained social impairment, speech abnormalities, and peculiar motor movements.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D002659</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Cell_function -->

    <owl:Class rdf:about="&autism-rules;Cell_function">
        <rdfs:subClassOf rdf:resource="&autism-rules;Physiologic_function"/>
        <rdfs:comment rdf:datatype="&xsd;string">A physiologic function inherent to cells or cell components</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Child_always_different -->

    <owl:Class rdf:about="&autism-rules;Child_always_different">
        <rdfs:subClassOf rdf:resource="&autism-rules;Onset_as_preceived_with_hindsight"/>
        <rdfs:comment rdf:datatype="&xsd;string">Child always &amp;quot;different&amp;quot;, but differences were not perceived by parents 
      as any kind of abnormality</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Circumscribed_Interests -->

    <owl:Class rdf:about="&autism-rules;Circumscribed_Interests">
        <rdfs:subClassOf rdf:resource="&autism-rules;Restricted_and_Unusual_Interests"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Circumscribed_Interests_NotAvailable -->

    <owl:Class rdf:about="&autism-rules;Circumscribed_Interests_NotAvailable">
        <rdfs:subClassOf rdf:resource="&autism-rules;Circumscribed_Interests"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Circumscribed_Interests_UnknownOrNotAsked -->

    <owl:Class rdf:about="&autism-rules;Circumscribed_Interests_UnknownOrNotAsked">
        <rdfs:subClassOf rdf:resource="&autism-rules;Circumscribed_Interests"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Clear_Social_Quality -->

    <owl:Class rdf:about="&autism-rules;Clear_Social_Quality">
        <rdfs:subClassOf rdf:resource="&autism-rules;Social_Verbalization_Chat"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Clothing_Self -->

    <owl:Class rdf:about="&autism-rules;Clothing_Self">
        <rdfs:subClassOf rdf:resource="&autism-rules;Self-Care"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Carrying out the coordinated actions and tasks of putting on and taking off clothes and footwear in sequence and in keeping with climatic and social conditions.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d540</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Cognitive_Ability -->

    <owl:Class rdf:about="&autism-rules;Cognitive_Ability">
        <rdfs:subClassOf rdf:resource="&autism-rules;Personal_Traits"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">General mental function required to understand and integrate the various mental functions, including all cognitive functions and their development over the life span.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0392334</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Color_Perception -->

    <owl:Class rdf:about="&autism-rules;Color_Perception">
        <rdfs:subClassOf rdf:resource="&autism-rules;Visual_Perception"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Mental processing of chromatic signals from the eye by the visual cortex where they are converted into symbolic representations.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D003118</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Community_Life_Skills -->

    <owl:Class rdf:about="&autism-rules;Community_Life_Skills">
        <rdfs:subClassOf rdf:resource="&autism-rules;Adaptive_Life_Skills"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Skills that allow successful engagement in all aspects of community social life, such as engaging in organized groups, recreation, and citizenship.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d8, http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d9</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Comprehension_of_simple_language -->

    <owl:Class rdf:about="&autism-rules;Comprehension_of_simple_language">
        <rdfs:subClassOf rdf:resource="&autism-rules;Receptive_Lexicon"/>
        <rdfs:comment rdf:datatype="&xsd;string">(Q29) Comprehension of simple language</rdfs:comment>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Severe distortions in the development of many basic psychological functions that are not normal for any stage in development. These distortions are manifested in sustained social impairment, speech abnormalities, and peculiar motor movements.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D002659</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Comprehension_of_simple_language_NotAvailable -->

    <owl:Class rdf:about="&autism-rules;Comprehension_of_simple_language_NotAvailable">
        <rdfs:subClassOf rdf:resource="&autism-rules;Comprehension_of_simple_language"/>
        <rdfs:comment rdf:datatype="&xsd;string">(8) N/A (e.g., deaf)</rdfs:comment>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Severe distortions in the development of many basic psychological functions that are not normal for any stage in development. These distortions are manifested in sustained social impairment, speech abnormalities, and peculiar motor movements.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D002659</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Comprehension_of_simple_language_unknownOrNotAsked -->

    <owl:Class rdf:about="&autism-rules;Comprehension_of_simple_language_unknownOrNotAsked">
        <rdfs:subClassOf rdf:resource="&autism-rules;Comprehension_of_simple_language"/>
        <rdfs:comment rdf:datatype="&xsd;string">(9) N/K or not asked</rdfs:comment>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Severe distortions in the development of many basic psychological functions that are not normal for any stage in development. These distortions are manifested in sustained social impairment, speech abnormalities, and peculiar motor movements.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D002659</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Compulsions_or_rituals -->

    <owl:Class rdf:about="&autism-rules;Compulsions_or_rituals">
        <rdfs:subClassOf rdf:resource="&autism-rules;Adherence_to_Rituals_and_Routines"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Compulsions_or_rituals_UknownOrNotAsked -->

    <owl:Class rdf:about="&autism-rules;Compulsions_or_rituals_UknownOrNotAsked">
        <rdfs:subClassOf rdf:resource="&autism-rules;Compulsions_or_rituals"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Compulsive_Behavior -->

    <owl:Class rdf:about="&autism-rules;Compulsive_Behavior">
        <rdfs:subClassOf rdf:resource="&autism-rules;Restricted_and_Repetitive_Behavior"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Performing an act persistently and repetitively without it leading to reward or pleasure.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D003192</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Concept -->

    <owl:Class rdf:about="&autism-rules;Concept">
        <rdfs:label rdf:datatype="&xsd;string">Concept</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://ontology.neuinfo.org/NIF/Backend/BIRNLex-OBI-proxy.owl#birnlex_11001"/>
        <rdfs:comment rdf:datatype="&xsd;string">From the vocabulary</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Conditional_probability -->

    <owl:Class rdf:about="&autism-rules;Conditional_probability">
        <rdfs:subClassOf rdf:resource="&autism-rules;Frequency"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Consistently_Nods_Spontaneously -->

    <owl:Class rdf:about="&autism-rules;Consistently_Nods_Spontaneously">
        <rdfs:subClassOf rdf:resource="&autism-rules;Nodding"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Consistently_Shakes_Head_Spontaneously -->

    <owl:Class rdf:about="&autism-rules;Consistently_Shakes_Head_Spontaneously">
        <rdfs:subClassOf rdf:resource="&autism-rules;Head_Shaking"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Consistently_Uses_Eye_Gaze_With_Vocalization -->

    <owl:Class rdf:about="&autism-rules;Consistently_Uses_Eye_Gaze_With_Vocalization">
        <rdfs:subClassOf rdf:resource="&autism-rules;Quality_of_Social_Overtures"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Consistently_and_persistently_avoids_approaches_of_other_children -->

    <owl:Class rdf:about="&autism-rules;Consistently_and_persistently_avoids_approaches_of_other_children">
        <rdfs:subClassOf rdf:resource="&autism-rules;Response_to_Approaches_Of_Other_Children"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Constructive_or_imaginative_play -->

    <owl:Class rdf:about="&autism-rules;Constructive_or_imaginative_play">
        <rdfs:subClassOf rdf:resource="&autism-rules;Loss_of_language_skills_or_other_skills"/>
        <rdfs:comment rdf:datatype="&xsd;string">(Q24) Constructive or imaginative play (puzzles, games, make-believe etc.)</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Constructive_or_imaginative_play_Definite_loss -->

    <owl:Class rdf:about="&autism-rules;Constructive_or_imaginative_play_Definite_loss">
        <rdfs:subClassOf rdf:resource="&autism-rules;Constructive_or_imaginative_play"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Constructive_or_imaginative_play_No_loss -->

    <owl:Class rdf:about="&autism-rules;Constructive_or_imaginative_play_No_loss">
        <rdfs:subClassOf rdf:resource="&autism-rules;Constructive_or_imaginative_play"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Constructive_or_imaginative_play_Possible_loss -->

    <owl:Class rdf:about="&autism-rules;Constructive_or_imaginative_play_Possible_loss">
        <rdfs:subClassOf rdf:resource="&autism-rules;Constructive_or_imaginative_play"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Control_Acquisition -->

    <owl:Class rdf:about="&autism-rules;Control_Acquisition">
        <rdfs:label rdf:datatype="&xsd;string">Control Acquisition</rdfs:label>
        <rdfs:subClassOf rdf:resource="&autism-core;AUTISMC1000024"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Control_of_Emotional_Reactions -->

    <owl:Class rdf:about="&autism-rules;Control_of_Emotional_Reactions">
        <rdfs:subClassOf rdf:resource="&autism-rules;Emotional_Regulation_and_Control"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to control and appropriately manage the experience and display of emotions in response to external stimuli.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0871727, http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=b1521</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Conventional_or_Instrumental_Gestures -->

    <owl:Class rdf:about="&autism-rules;Conventional_or_Instrumental_Gestures">
        <rdfs:subClassOf rdf:resource="&autism-rules;Gestures"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Conversation_Flows -->

    <owl:Class rdf:about="&autism-rules;Conversation_Flows">
        <rdfs:subClassOf rdf:resource="&autism-rules;Reciprocal_Conversation"/>
        <rdfs:comment rdf:datatype="&xsd;string">Conversation flows, including both offering information, and building on other person&apos;s response in a manner that leads to ongoing dialogue</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Conversational_Skills -->

    <owl:Class rdf:about="&autism-rules;Conversational_Skills">
        <rdfs:subClassOf rdf:resource="&autism-rules;Recognition_of_Social_Norms"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Abilities needed to start, sustain and end an interchange of thoughts and ideas, carried out by means of spoken, written, sign or other forms of language, with one or more people one knows or who are strangers, in formal or casual settings.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0871703</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Cranial_Anomalies -->

    <owl:Class rdf:about="&autism-rules;Cranial_Anomalies">
        <rdfs:subClassOf rdf:resource="&autism-core;AUTISMC1000038"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Daily_spontaneous_and_meaningful_speech -->

    <owl:Class rdf:about="&autism-rules;Daily_spontaneous_and_meaningful_speech">
        <rdfs:subClassOf rdf:resource="&autism-rules;Level_of_communicative_language_before_loss"/>
        <rdfs:comment rdf:datatype="&xsd;string">Daily, spontaneous, and meaningful speech used communicatively, with at 
      least five different words used at some point before change</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Decision_Making_Ability -->

    <owl:Class rdf:about="&autism-rules;Decision_Making_Ability">
        <rdfs:subClassOf rdf:resource="&autism-rules;Planning"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Making a choice among options, implementing the choice, and evaluating the effects of the choice, or deciding to undertake and undertaking one task from among several tasks that need to be done.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d177</autism-rules:has_definition_source>
    </owl:Class>
    


