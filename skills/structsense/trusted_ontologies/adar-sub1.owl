        <rdfs:range rdf:resource="&xsd;int"/>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/autism-ontology/1.0/ca_vinelandsurvey-2005.owl#Vinelandsurvey_2005_InterpersRelation_17 -->

    <owl:DatatypeProperty rdf:about="http://purl.org/autism-ontology/1.0/ca_vinelandsurvey-2005.owl#Vinelandsurvey_2005_InterpersRelation_17">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:comment rdf:datatype="&xsd;string">&quot;Answers when familiar adults make small talk (for example, if asked, &quot;&quot;How are you?&quot;&quot; says, &quot;&quot;I&apos;m fine&quot;&quot;; if told, &quot;&quot;You look nice,&quot;&quot; says, &quot;&quot;Thank you&quot;&quot;; etc.).&quot;</rdfs:comment>
        <assessment-result:valueRange rdf:datatype="&xsd;string">0;1;2</assessment-result:valueRange>
