                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;Social_Verbalization_Some_Speech_to_Alert_Caregiver"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="&autism-rules;Human_with_DSm-IV_definition_A_2"/>
        <rdfs:comment rdf:datatype="&xsd;string">in individuals with adequate speech, marked impairment in the ability to initiate or sustain a conversation with others</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Human_with_DSm-IV_definition_A_2_c -->

    <owl:Class rdf:about="&autism-rules;Human_with_DSm-IV_definition_A_2_c">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;neologidiolang_Occasional_use_of_neologisms_or_idiosyncratic_words_and_phrases"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;neologidiolang_Regular_use_of_neologisms_or_idiosyncratic_ways_of_saying_things"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;pronominalReversal_First_and_second_person_confusion_after_phrase_speech_established"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;pronominalReversal_Pronominal_confusion_other"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;pronominalReversal_Pronominal_confusion_when_asking_a_question"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;stereo_Often_usesOrUsed_stereotyped_itterances_with_productive_language_as_well"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;stereo_Phrases_are_almost_exclusively_stereotyped_utterances"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;stereo_Speech_tendsOrTended_to_be_more_repetitive_than_most_subject"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="&autism-rules;Human_with_DSm-IV_definition_A_2"/>
        <rdfs:comment rdf:datatype="&xsd;string">stereotyped and repetitive use of language or idiosyncratic language</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Human_with_DSm-IV_definition_A_2_d -->

    <owl:Class rdf:about="&autism-rules;Human_with_DSm-IV_definition_A_2_d">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;imit_Some_indication_of_spontaneous_imitation_that_goes_beyond_copying_a_frequent_use_of_an_object"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;imit_Spontaneous_imitation_limited_to_a_few_familiar_routines_that_are_not_incorporated_into_play"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;imit_Very_rare_or_no_spontaneous_imitation"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;peerpl_No_Play_With_Other_Children_or_Not_Pretend_Play_Even_On_Own"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;peerpl_Some_Participation_in_Pretend_Play_With_Another_Child"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;peerpl_Some_Play_With_Other_Children_BUT_No_Pretending"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;play_No_pretend_play"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;play_Occasional_spontaneous_pretend_actions_or_highly_repetitive_pretend_play"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;play_Some_pretend_play"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;soplay_Little_toAndFro_social_play"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;soplay_No_evidence_of_toAndFro_socal_play"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;soplay_Some_toAndFro_social_play"/>
                                    </owl:Restriction>
                                </owl:unionOf>
                            </owl:Class>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="&autism-rules;has_general_finding"/>
                                <owl:hasValue rdf:resource="&autism-rules;subjectAge_Between_4_and_10_years"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;imit_Some_indication_of_spontaneous_imitation_that_goes_beyond_copying_a_frequent_use_of_an_object"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;imit_Spontaneous_imitation_limited_to_a_few_familiar_routines_that_are_not_incorporated_into_play"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;imit_Very_rare_or_no_spontaneous_imitation"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;play_No_pretend_play"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;play_Occasional_spontaneous_pretend_actions_or_highly_repetitive_pretend_play"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;play_Some_pretend_play"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;soplay_Little_toAndFro_social_play"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;soplay_No_evidence_of_toAndFro_socal_play"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&autism-rules;has_mostAbnormal4-5_finding"/>
                                        <owl:hasValue rdf:resource="&autism-rules;soplay_Some_toAndFro_social_play"/>
                                    </owl:Restriction>
                                </owl:unionOf>
                            </owl:Class>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="&autism-rules;has_general_finding"/>
                                <owl:hasValue rdf:resource="&autism-rules;subjectAge_Under_4_years"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="&autism-rules;Human_with_DSm-IV_definition_A_2"/>
        <rdfs:comment rdf:datatype="&xsd;string">lack of varied, spontaneous make-believe play or social imitative play appropriate to developmental level</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Human_with_DSm-IV_definition_B -->

    <owl:Class rdf:about="&autism-rules;Human_with_DSm-IV_definition_B">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_general_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;Delayed_Phrase"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_general_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;Delayed_Word"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_general_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;No_Phrase"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_general_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;No_Word"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_general_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;ageParentsFirstNoticed_Under36Months"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_general_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;ageabnDevelopment_definitly_abnormal_in_the_first_3_years_not_unambiguously_autistic_at_that_age"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_general_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;ageabnDevelopment_definitly_abnormal_in_the_first_3_years_strongly_indicative_of_autism"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_general_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;ageabnDevelopment_probably_abnormal_by_the_age_of_3_years"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_general_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;interjudge_AbnormalitiesManifestedBeforeAgeOf36Months"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="&autism-rules;Human_With_DSM-IV_Diagnostic_Criterion"/>
        <rdfs:comment rdf:datatype="&xsd;string">Delayes or abnormal functioning in at least one of the following areas, 
with onset prior to age 3 years (Social interaction, Language aa used in 
social communication, Symbolic and imaginative play)</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Human_with_two_A1s -->

    <owl:Class rdf:about="&autism-rules;Human_with_two_A1s">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="&autism-rules;Human_with_DSM-IV_definition_A_1_a"/>
                            <rdf:Description rdf:about="&autism-rules;Human_with_DSM-IV_definition_A_1_b"/>
                        </owl:intersectionOf>
                    </owl:Class>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="&autism-rules;Human_with_DSM-IV_definition_A_1_a"/>
                            <rdf:Description rdf:about="&autism-rules;Human_with_DSM-IV_definition_A_1_c"/>
                        </owl:intersectionOf>
                    </owl:Class>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="&autism-rules;Human_with_DSM-IV_definition_A_1_a"/>
                            <rdf:Description rdf:about="&autism-rules;Human_with_DSM-IV_definition_A_1_d"/>
                        </owl:intersectionOf>
                    </owl:Class>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="&autism-rules;Human_with_DSM-IV_definition_A_1_b"/>
                            <rdf:Description rdf:about="&autism-rules;Human_with_DSM-IV_definition_A_1_c"/>
                        </owl:intersectionOf>
                    </owl:Class>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="&autism-rules;Human_with_DSM-IV_definition_A_1_b"/>
                            <rdf:Description rdf:about="&autism-rules;Human_with_DSM-IV_definition_A_1_d"/>
                        </owl:intersectionOf>
                    </owl:Class>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="&autism-rules;Human_with_DSM-IV_definition_A_1_c"/>
                            <rdf:Description rdf:about="&autism-rules;Human_with_DSM-IV_definition_A_1_d"/>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="&autism-rules;Human_With_DSM-IV_Diagnostic_Criterion"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Hygiene -->

    <owl:Class rdf:about="&autism-rules;Hygiene">
        <rdfs:subClassOf rdf:resource="&autism-rules;Self-Care"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Maintaining personal cleanliness.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d510</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#IBD -->

    <owl:Class rdf:about="&autism-rules;IBD">
        <rdfs:subClassOf rdf:resource="&autism-core;AUTISMC1000038"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#IQ -->

    <owl:Class rdf:about="&autism-rules;IQ">
        <rdfs:subClassOf rdf:resource="&autism-rules;Cognitive_Ability"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to learn and to deal with new situations and to deal effectively with tasks involving abstractions. The relative intelligence of an individual is expressed as a score on a standardized test of intelligence.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D007360, http://www.nlm.nih.gov/research/umls?cui=C0456149</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Idiosyncratic_and_Routinized_Speech -->

    <owl:Class rdf:about="&autism-rules;Idiosyncratic_and_Routinized_Speech">
        <rdfs:subClassOf rdf:resource="&autism-rules;Language_Ability"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Unusual speech, including formulaic speech, overreliance on a restricted range of expressions, echolalia, and idiosyncratic sound-meaning associations.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D004454, http://www.nlm.nih.gov/research/umls?cui=C0392185, http://www.nlm.nih.gov/research/umls?cui=C0233647</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Imagination -->

    <owl:Class rdf:about="&autism-rules;Imagination">
        <rdfs:subClassOf rdf:resource="&autism-rules;Abstract_Thinking"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to perceive new relationships and to derive new ideas and solve problems by pursuing nontraditional patterns of thinking.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0010297</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Imaginative_Cooperative_Play_With_Other_Children_in_Spontaneous_Pretend_Activities -->

    <owl:Class rdf:about="&autism-rules;Imaginative_Cooperative_Play_With_Other_Children_in_Spontaneous_Pretend_Activities">
        <rdfs:subClassOf rdf:resource="&autism-rules;Imaginative_Play_With_Peers"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Imaginative_Play_With_Peers -->

    <owl:Class rdf:about="&autism-rules;Imaginative_Play_With_Peers">
        <rdfs:subClassOf rdf:resource="&autism-rules;Engaging_in_Social_Play"/>
        <rdfs:subClassOf rdf:resource="&autism-rules;Imagination"/>
        <rdfs:comment rdf:datatype="&xsd;string">(Q49) Imaginative Play With Peers</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Imaginative_Play_With_Peers_NotAvailable -->

    <owl:Class rdf:about="&autism-rules;Imaginative_Play_With_Peers_NotAvailable">
        <rdfs:subClassOf rdf:resource="&autism-rules;Imaginative_Play_With_Peers"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Imaginative_Play_With_Peers_NotKnownOrNotAsked -->

    <owl:Class rdf:about="&autism-rules;Imaginative_Play_With_Peers_NotKnownOrNotAsked">
        <rdfs:subClassOf rdf:resource="&autism-rules;Imaginative_Play_With_Peers"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Imaginative_play -->

    <owl:Class rdf:about="&autism-rules;Imaginative_play">
        <rdfs:subClassOf rdf:resource="&autism-rules;Imagination"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Imaginative_play_NotAvailable -->

    <owl:Class rdf:about="&autism-rules;Imaginative_play_NotAvailable">
        <rdfs:subClassOf rdf:resource="&autism-rules;Imaginative_play"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Imaginative_play_UnknownOrNotAsked -->

    <owl:Class rdf:about="&autism-rules;Imaginative_play_UnknownOrNotAsked">
        <rdfs:subClassOf rdf:resource="&autism-rules;Imaginative_play"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Imitation -->

    <owl:Class rdf:about="&autism-rules;Imitation">
        <rdfs:subClassOf rdf:resource="&autism-rules;Reciprocal_Social_Interaction"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Mimicking or copying the movements of other individuals as a means of interaction and play as well as to learn by modeling the actions and behaviors of others.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d130</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Imitative_social_play -->

    <owl:Class rdf:about="&autism-rules;Imitative_social_play">
        <rdfs:subClassOf rdf:resource="&autism-rules;Engaging_in_Social_Play"/>
        <rdfs:subClassOf rdf:resource="&autism-rules;Imitation"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Imitative_social_play_NotAvailable -->

    <owl:Class rdf:about="&autism-rules;Imitative_social_play_NotAvailable">
        <rdfs:subClassOf rdf:resource="&autism-rules;Imitative_social_play"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Imitative_social_play_UnknownOrNotAsked -->

    <owl:Class rdf:about="&autism-rules;Imitative_social_play_UnknownOrNotAsked">
        <rdfs:subClassOf rdf:resource="&autism-rules;Imitative_social_play"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Immoderate_Behavior -->

    <owl:Class rdf:about="&autism-rules;Immoderate_Behavior">
        <rdfs:subClassOf rdf:resource="&autism-rules;Impulse_Control_and_Regulation"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The inability to control and appropriately manage intensity of behavior, including excessive silliness, laughing, and loudness.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d7202</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Impatience -->

    <owl:Class rdf:about="&autism-rules;Impatience">
        <rdfs:subClassOf rdf:resource="&autism-rules;Impulse_Control_and_Regulation"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The inability to wait calmly without feelings of agitation.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0564566</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Impulse_Control_and_Regulation -->

    <owl:Class rdf:about="&autism-rules;Impulse_Control_and_Regulation">
        <rdfs:subClassOf rdf:resource="&autism-rules;Emotional_Regulation_and_Control"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Mental functions that regulate and resist sudden intense urges to do something.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=b1304</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Inappropriate_facial_expressions -->

    <owl:Class rdf:about="&autism-rules;Inappropriate_facial_expressions">
        <rdfs:subClassOf rdf:resource="&autism-rules;Facial_Expressions"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Inappropriate_facial_expressions_NotAvailable -->

    <owl:Class rdf:about="&autism-rules;Inappropriate_facial_expressions_NotAvailable">
        <rdfs:subClassOf rdf:resource="&autism-rules;Inappropriate_facial_expressions"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Inappropriate_facial_expressions_UnknownOrNotAsked -->

    <owl:Class rdf:about="&autism-rules;Inappropriate_facial_expressions_UnknownOrNotAsked">
        <rdfs:subClassOf rdf:resource="&autism-rules;Inappropriate_facial_expressions"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Inappropriate_questions_or_statements -->

    <owl:Class rdf:about="&autism-rules;Inappropriate_questions_or_statements">
        <rdfs:subClassOf rdf:resource="&autism-rules;Using_Language_Appropriately"/>
        <rdfs:comment rdf:datatype="&xsd;string">(Q36) Inappropriate questions or statements</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Inappropriate_questions_or_statements_NotAvailable -->

    <owl:Class rdf:about="&autism-rules;Inappropriate_questions_or_statements_NotAvailable">
        <rdfs:subClassOf rdf:resource="&autism-rules;Inappropriate_questions_or_statements"/>
        <rdfs:comment rdf:datatype="&xsd;string">N/A (code &quot;1&quot; or &quot;2&quot; on Item 30)</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Inappropriate_questions_or_statements_UnknownOrNotAsked -->

    <owl:Class rdf:about="&autism-rules;Inappropriate_questions_or_statements_UnknownOrNotAsked">
        <rdfs:subClassOf rdf:resource="&autism-rules;Inappropriate_questions_or_statements"/>
        <rdfs:comment rdf:datatype="&xsd;string">N/K or not asked</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Inconsistent_Spontaneous_Use -->

    <owl:Class rdf:about="&autism-rules;Inconsistent_Spontaneous_Use">
        <rdfs:subClassOf rdf:resource="&autism-rules;Conventional_or_Instrumental_Gestures"/>
        <rdfs:comment rdf:datatype="&xsd;string">Inconsistant spontaneous use, or use of elicited or well-rehearsed simple conventional or instrumental gestures only</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Initiating_Social_Interaction -->

    <owl:Class rdf:about="&autism-rules;Initiating_Social_Interaction">
        <rdfs:subClassOf rdf:resource="&autism-rules;Initiating_and_Responding_to_Social_Overtures"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Starting interactions with others, including introducing oneself and actively trying to make friends.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d71040</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Initiating_and_Responding_to_Social_Overtures -->

    <owl:Class rdf:about="&autism-rules;Initiating_and_Responding_to_Social_Overtures">
        <rdfs:subClassOf rdf:resource="&autism-rules;Social_Interest"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Showing interest in making social advances to initiate friendly interactions as well as positive responses to the social advances of others.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d7104</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Injury_or_poisoning -->

    <owl:Class rdf:about="&autism-rules;Injury_or_poisoning">
        <rdfs:subClassOf rdf:resource="http://www.ifomis.org/bfo/1.1/span#Process"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Insistence_on_Order -->

    <owl:Class rdf:about="&autism-rules;Insistence_on_Order">
        <rdfs:subClassOf rdf:resource="&autism-rules;Adherence_to_Rituals_and_Routines"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Insistence on an extreme degree of order in the surrounding environment, including placement and arrangement of specific objects.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0233850</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Insistence_on_Routine -->

    <owl:Class rdf:about="&autism-rules;Insistence_on_Routine">
        <rdfs:subClassOf rdf:resource="&autism-rules;Adherence_to_Rituals_and_Routines"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Insistence on a specific sequence of ordered events and actions and intolerance of deviation from such routines.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0424246, http://www.nlm.nih.gov/research/umls?cui=C1976715</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Insufficient_language_to_show_change_communicative_intent -->

    <owl:Class rdf:about="&autism-rules;Insufficient_language_to_show_change_communicative_intent">
        <rdfs:subClassOf rdf:resource="&autism-rules;Loss_of_communicative_intent"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Insufficient_language_to_show_change_five_meaningful_words_use -->

    <owl:Class rdf:about="&autism-rules;Insufficient_language_to_show_change_five_meaningful_words_use">
        <rdfs:subClassOf rdf:resource="&autism-rules;Loss_of_spontaneous_use_of_at_least_five_meaningful_words"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Insufficient_language_to_show_change_in_articulation -->

    <owl:Class rdf:about="&autism-rules;Insufficient_language_to_show_change_in_articulation">
        <rdfs:subClassOf rdf:resource="&autism-rules;Loss_of_articulation"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Insufficient_language_to_show_change_syntactycal_skills -->

    <owl:Class rdf:about="&autism-rules;Insufficient_language_to_show_change_syntactycal_skills">
        <rdfs:subClassOf rdf:resource="&autism-rules;Loss_of_syntactical_skills"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Integrated_Verbal_and_NonVerbal_Communication -->

    <owl:Class rdf:about="&autism-rules;Integrated_Verbal_and_NonVerbal_Communication">
        <rdfs:subClassOf rdf:resource="&autism-rules;Language_Ability"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Matching non-verbal communication, such as gestures and facial expressions, with meaning conveyed through verbal communication.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">N\A</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Intense_Interests -->

    <owl:Class rdf:about="&autism-rules;Intense_Interests">
        <rdfs:subClassOf rdf:resource="&autism-rules;Restricted_and_Unusual_Interests"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Extremely strong interest in specific objects or topics.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">N\A</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Intentional_Bad_Behavior -->

    <owl:Class rdf:about="&autism-rules;Intentional_Bad_Behavior">
        <rdfs:subClassOf rdf:resource="&autism-rules;Recognition_of_Social_Norms"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Deliberate engagement in disruptive or improper behavior.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0474416</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Intentional_Cruelty -->

    <owl:Class rdf:about="&autism-rules;Intentional_Cruelty">
        <rdfs:subClassOf rdf:resource="&autism-rules;Intentional_Bad_Behavior"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Deliberately taking actions that cause physical or psychological pain for others.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0233515</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Interactions_with_Friends_and_Family -->

    <owl:Class rdf:about="&autism-rules;Interactions_with_Friends_and_Family">
        <rdfs:subClassOf rdf:resource="&autism-rules;Social_Interest"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Relationships, including conversations and joint activities, with family members and friends.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d750, http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d760</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Interest_In_Children -->

    <owl:Class rdf:about="&autism-rules;Interest_In_Children">
        <rdfs:subClassOf rdf:resource="&autism-rules;Social_Interest"/>
        <rdfs:comment rdf:datatype="&xsd;string">(Q62) Interest In Children</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Interest_in_children_NotAvailable -->

    <owl:Class rdf:about="&autism-rules;Interest_in_children_NotAvailable">
        <rdfs:subClassOf rdf:resource="&autism-rules;Interest_In_Children"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Interest_in_children_UnknownOrNotAsked -->

    <owl:Class rdf:about="&autism-rules;Interest_in_children_UnknownOrNotAsked">
        <rdfs:subClassOf rdf:resource="&autism-rules;Interest_In_Children"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Interpersonal_Awareness -->

    <owl:Class rdf:about="&autism-rules;Interpersonal_Awareness">
        <rdfs:subClassOf rdf:resource="&autism-rules;Interpersonal_Interactions"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Consciousness of contextually and socially appropriate manner, such as by showing consideration and esteem when appropriate, or responding to the feelings of others.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d710</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Interpersonal_Interactions -->

    <owl:Class rdf:about="&autism-rules;Interpersonal_Interactions">
        <rdfs:subClassOf rdf:resource="&autism-rules;Social_Competence"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The reciprocal interaction of two or more persons.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D007398</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Interviewers_judgment_on_age_when_developmental_abnormalities_probably_first_manifest -->

    <owl:Class rdf:about="&autism-rules;Interviewers_judgment_on_age_when_developmental_abnormalities_probably_first_manifest">
        <rdfs:subClassOf rdf:resource="&autism-core;AUTISMC1000080"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Intonation_Volume_Rhythm_Rate -->

    <owl:Class rdf:about="&autism-rules;Intonation_Volume_Rhythm_Rate">
        <rdfs:subClassOf rdf:resource="&autism-rules;Prosody"/>
        <rdfs:comment rdf:datatype="&xsd;string">(Q40) Intonation / Volume / Rhythm / Rate</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Intonation_Volume_Rhythm_Rate_NotAvailable -->

    <owl:Class rdf:about="&autism-rules;Intonation_Volume_Rhythm_Rate_NotAvailable">
        <rdfs:subClassOf rdf:resource="&autism-rules;Intonation_Volume_Rhythm_Rate"/>
        <rdfs:comment rdf:datatype="&xsd;string">(8) N/A (code &quot;1&quot; or &quot;2&quot; on Item 30)</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Intonation_Volume_Rhythm_Rate_UnknownOrNotAsked -->

    <owl:Class rdf:about="&autism-rules;Intonation_Volume_Rhythm_Rate_UnknownOrNotAsked">
        <rdfs:subClassOf rdf:resource="&autism-rules;Intonation_Volume_Rhythm_Rate"/>
        <rdfs:comment rdf:datatype="&xsd;string">(9) N/K or not asked</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Involuntary_Behaviors -->

    <owl:Class rdf:about="&autism-rules;Involuntary_Behaviors">
        <rdfs:subClassOf rdf:resource="&autism-rules;Stereotyped_Restricted_and_Repetitive_Behavior"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Non-intentional, non-purposive behaviors, including perseveration, habitual repeated movements, and extreme sensitivity to stimuli.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=b765</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Involve_Seeking_of_Contact_in_Group_Situation_within_personal_relationships -->

    <owl:Class rdf:about="&autism-rules;Involve_Seeking_of_Contact_in_Group_Situation_within_personal_relationships">
        <rdfs:subClassOf rdf:resource="&autism-rules;Friendships"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Isolated_Cognitive_Skills -->

    <owl:Class rdf:about="&autism-rules;Isolated_Cognitive_Skills">
        <rdfs:subClassOf rdf:resource="&autism-rules;Cognitive_Ability"/>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">N\A</autism-rules:has_definition_source>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Showing extreme proficiency in certain areas with special abilities, for example, in memory, music, drawing, reading and computational skills.</autism-rules:has_definition>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Job_Performance -->

    <owl:Class rdf:about="&autism-rules;Job_Performance">
        <rdfs:subClassOf rdf:resource="&autism-rules;Community_Life_Skills"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Quality of the work conducted at one&apos;s place of employment.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d845</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Joint_Attention -->

    <owl:Class rdf:about="&autism-rules;Joint_Attention">
        <rdfs:subClassOf rdf:resource="&autism-rules;Reciprocal_Social_Interaction"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Sharing attentional focus with others between objects or events.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=b1403</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Keeps_to_Self -->

    <owl:Class rdf:about="&autism-rules;Keeps_to_Self">
        <rdfs:subClassOf rdf:resource="&autism-rules;Social_Interest"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Generally remaining isolated; avoiding interactions; preferring to be alone rather than with others.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0037421</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Lack_of_Appropriate_Guilt -->

    <owl:Class rdf:about="&autism-rules;Lack_of_Appropriate_Guilt">
        <rdfs:subClassOf rdf:resource="&autism-rules;Intentional_Bad_Behavior"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Absence of subjective feeling that one has transgressed a moral, social or ethical principle.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0018379</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Language_Ability -->

    <owl:Class rdf:about="&autism-rules;Language_Ability">
        <rdfs:subClassOf rdf:resource="&autism-rules;Personal_Traits"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to use and comprehend the complex system of human communication. Individuals with autism spectrum disorder often have a range of receptive and expressive language impairments.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d3</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Language_Development -->

    <owl:Class rdf:about="&autism-rules;Language_Development">
        <rdfs:subClassOf rdf:resource="&autism-rules;Development_or_Regression_of_Language_Skills"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The gradual expansion in complexity and meaning of symbols and sounds as perceived and interpreted by the individual through a maturational and learning process.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D007804</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Level_of_communicative_language_before_loss -->

    <owl:Class rdf:about="&autism-rules;Level_of_communicative_language_before_loss">
        <rdfs:subClassOf rdf:resource="&autism-rules;Loss_of_skills"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Limited_Attempt -->

    <owl:Class rdf:about="&autism-rules;Limited_Attempt">
        <rdfs:subClassOf rdf:resource="&autism-rules;Pointing_to_Express_Interest"/>
        <autism-rules:reference rdf:datatype="&xsd;string">ADi-R, WPS Edition (WPS No. W-382B)</autism-rules:reference>
        <rdfs:comment rdf:datatype="&xsd;string">Makes some limited attempt to express interest by pointing, but with limited flexibility and\or lack of coordination (e.g., uses arm without consistent coordination with eye gaze)</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Limited_Spontaneous_Use -->

    <owl:Class rdf:about="&autism-rules;Limited_Spontaneous_Use">
        <rdfs:subClassOf rdf:resource="&autism-rules;Conventional_or_Instrumental_Gestures"/>
        <rdfs:comment rdf:datatype="&xsd;string">Spontaneous use of conventional or instrumental gestures, but limited in range or context</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Little_Or_No_Emotions_Indication_Facial_Expression_Range -->

    <owl:Class rdf:about="&autism-rules;Little_Or_No_Emotions_Indication_Facial_Expression_Range">
        <rdfs:subClassOf rdf:resource="&autism-rules;Range_of_Facial_Expressions_Used_To_Communicate"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Little_or_No_Reciprocal_Conversation -->

    <owl:Class rdf:about="&autism-rules;Little_or_No_Reciprocal_Conversation">
        <rdfs:subClassOf rdf:resource="&autism-rules;Reciprocal_Conversation"/>
        <rdfs:comment rdf:datatype="&xsd;string">Little or no reciprocal conversation; others find it difficult to build a conversation even if there is talk by subject; subject fails to follow anyone else&apos;s conversation topic; may ask or answer questions but not as part of a single interchange</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Little_or_Non -->

    <owl:Class rdf:about="&autism-rules;Little_or_Non">
        <rdfs:subClassOf rdf:resource="&autism-rules;Pointing_to_Express_Interest"/>
        <autism-rules:reference rdf:datatype="&xsd;string">ADi-R (WPS No. W-382B)</autism-rules:reference>
        <rdfs:comment rdf:datatype="&xsd;string">Little or no spotaneous unpromped attempts to point to express interest in objects at a distance</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Little_or_no_comprehension_of_words -->

    <owl:Class rdf:about="&autism-rules;Little_or_no_comprehension_of_words">
        <rdfs:subClassOf rdf:resource="&autism-rules;Comprehension_of_simple_language"/>
        <rdfs:comment rdf:datatype="&xsd;string">(4) Little or no comprehension of words, even in context</rdfs:comment>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Severe distortions in the development of many basic psychological functions that are not normal for any stage in development. These distortions are manifested in sustained social impairment, speech abnormalities, and peculiar motor movements.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D002659</autism-rules:has_definition_source>
    </owl:Class>
    


