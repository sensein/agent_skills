                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;stereo_Often_usesOrUsed_stereotyped_itterances_with_productive_language_as_well"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;stereo_Phrases_are_almost_exclusively_stereotyped_utterances"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;stereo_Speech_tendsOrTended_to_be_more_repetitive_than_most_subject"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;useobj_An_interest_in_infant_toys"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;useobj_Play_linked_to_highly_stereotyped_use_of_objects"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;useobj_Play_linked_to_highly_stereotyped_use_of_objects_and_prevents_other_activities"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="&autism-rules;Human_With_DSM-5_Diagnosis_definition_B_Part"/>
        <rdfs:comment rdf:datatype="&xsd;string">Stereotyped or repetitive motor movements, use of objects, or speech (e.g., simple motor stereotypies, lining up toys or flipping objects, echolalia, idiosyncratic phrases)</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Human_With_DSM-5_Diagnosis_definition_B_2 -->

    <owl:Class rdf:about="&autism-rules;Human_With_DSM-5_Diagnosis_definition_B_2">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;change_Definite_unusual_and_marked_resistance_to_minor_changes_in_subjects_own_routines"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;change_Definite_unusual_reactions_to_minor_changes_in_subjects_own_routines"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;change_Unusually_negative_reaction_to_minor_changes_in_subjects_own_routines"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;crit_One_or_more_activities_that_subject_has_to_preform_in_a_special_way_if_disrupted_appears_to_be_under_MARKED_pressure"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;crit_One_or_more_activities_that_subject_has_to_preform_in_a_special_way_if_disrupted_appears_to_be_under_pressure"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;crit_Some_activities_with_unusual_fixed_sequences"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;resis_Definite_unusual_and_marked_resistance_to_trivial_changes_in_the_environment"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;resis_Definite_unusual_reaction_to_trivial_changes_in_the_environment"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;resis_Unusually_negative_reaction_to_trivial_changes_in_the_environment"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;verbalrituals_Has_to_say_one_or_more_things_in_a_special_way"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;verbalrituals_Marked_difficulty_to_control"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;verbalrituals_Tendency_to_say_things_in_ritualized_way"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="&autism-rules;Human_With_DSM-5_Diagnosis_definition_B_Part"/>
        <rdfs:comment rdf:datatype="&xsd;string">Insistance on sameness, inflexible adherence to routines, or ritualized patterns of verbal or nonverbal behaviour (e.g., extreme distress at small changes, difficulties with transitions, rigid thinking patters, greeting rituals, need to take same route or eat same food every day)</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Human_With_DSM-5_Diagnosis_definition_B_3 -->

    <owl:Class rdf:about="&autism-rules;Human_With_DSM-5_Diagnosis_definition_B_3">
        <owl:equivalentClass>
            <owl:Class>
