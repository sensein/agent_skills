    <owl:Class rdf:about="&autism-rules;Sorting_Ability">
        <rdfs:subClassOf rdf:resource="&autism-rules;Mental_Flexibility"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to sort objects in different ways as instructed, including sorting the same objects multiple times by different rules.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0237886</autism-rules:has_definition_source>
    </owl:Class>
    


