        <rdfs:subClassOf rdf:resource="&autism-rules;Intonation_Volume_Rhythm_Rate"/>
        <rdfs:comment rdf:datatype="&xsd;string">(1) Speech that shows one or other of the abnormalities listed under &quot;2&quot;, but not obviously peculiar and no interference with intelligibility</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Spontaneous_imitation_limited_to_a_few_familiar_routines_that_are_not_incorporated_into_play -->

