    <rdf:Description>
        <rdf:type rdf:resource="&swrl;Imp"/>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="&swrl;AtomList"/>
                <rdf:rest rdf:resource="&rdf;nil"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="&swrl;IndividualPropertyAtom"/>
                        <swrl:argument2 rdf:resource="&autism-rules;ageabnDevelopment_definitly_abnormal_in_the_first_3_years_not_unambiguously_autistic_at_that_age"/>
                        <swrl:argument1 rdf:resource="&autism-rules;h"/>
                        <swrl:propertyPredicate rdf:resource="&autism-rules;has_general_finding"/>
                    </rdf:Description>
                </rdf:first>
            </rdf:Description>
        </swrl:head>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="&swrl;AtomList"/>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="&swrl;AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="&swrl;DatavaluedPropertyAtom"/>
                                <swrl:argument1 rdf:resource="&autism-rules;a"/>
                                <swrl:argument2 rdf:resource="&autism-rules;id1"/>
                                <swrl:propertyPredicate rdf:resource="http://purl.org/autism-ontology/1.0/ca_adi-2003.owl#SubjectKey"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="&swrl;AtomList"/>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="&swrl;AtomList"/>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="&swrl;AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="&swrl;ClassAtom"/>
                                                        <swrl:classPredicate rdf:resource="&autism-core;AUTISMC1000045"/>
                                                        <swrl:argument1 rdf:resource="&autism-rules;h"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="&swrl;AtomList"/>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="&swrl;AtomList"/>
                                                                <rdf:rest rdf:resource="&rdf;nil"/>
                                                                <rdf:first>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="&swrl;BuiltinAtom"/>
                                                                        <swrl:builtin rdf:resource="&swrlb;equal"/>
                                                                        <swrl:arguments rdf:parseType="Collection">
                                                                            <rdf:Description rdf:about="&autism-rules;id1"/>
                                                                            <rdf:Description rdf:about="&autism-rules;id2"/>
                                                                        </swrl:arguments>
                                                                    </rdf:Description>
                                                                </rdf:first>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                        <rdf:first>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="&swrl;DatavaluedPropertyAtom"/>
                                                                <swrl:argument1 rdf:resource="&autism-rules;h"/>
                                                                <swrl:argument2 rdf:resource="&autism-rules;id2"/>
                                                                <swrl:propertyPredicate rdf:resource="&autism-rules;subject_id"/>
                                                            </rdf:Description>
                                                        </rdf:first>
                                                    </rdf:Description>
                                                </rdf:rest>
