        <rdfs:subClassOf rdf:resource="&autism-rules;Use_of_others_body_to_communicate"/>
        <rdfs:comment rdf:datatype="&xsd;string">(0) No use of other&apos;s body to communicate, except in situations where other strategies have not worked (e.g., when parent conversing with someone and subject cannot get her/his attention), or when taking someone&apos;s hand to lead them places.</rdfs:comment>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Severe distortions in the development of many basic psychological functions that are not normal for any stage in development. These distortions are manifested in sustained social impairment, speech abnormalities, and peculiar motor movements.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D002659</autism-rules:has_definition_source>
    </owl:Class>
    


