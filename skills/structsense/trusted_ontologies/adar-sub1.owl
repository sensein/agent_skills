    <owl:Class rdf:about="&autism-rules;Spontaneous_imitation_of_actions_NotAvailable">
        <rdfs:subClassOf rdf:resource="&autism-rules;Spontaneous_imitation_of_actions"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Spontaneous_imitation_of_actions_UnknownOrNotAsked -->

    <owl:Class rdf:about="&autism-rules;Spontaneous_imitation_of_actions_UnknownOrNotAsked">
        <rdfs:subClassOf rdf:resource="&autism-rules;Spontaneous_imitation_of_actions"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Spontaneous_imitations_of_vocalization -->

    <owl:Class rdf:about="&autism-rules;Spontaneous_imitations_of_vocalization">
        <rdfs:subClassOf rdf:resource="&autism-rules;Level_of_communicative_language_before_loss"/>
        <rdfs:comment rdf:datatype="&xsd;string">Spontaneous imitations of vocalization (without ever having any 
      completely spontaneous speech), with no elicited imitation or 
      spontaneous communicative speech</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Spontaneously_Pointing -->

    <owl:Class rdf:about="&autism-rules;Spontaneously_Pointing">
        <rdfs:subClassOf rdf:resource="&autism-rules;Pointing_to_Express_Interest"/>
        <autism-rules:reference rdf:datatype="&xsd;string">ADi-R (WPS No. W-382B)</autism-rules:reference>
        <rdfs:comment rdf:datatype="&xsd;string">Spontaneously pointing at objects at a distance with finger to express interest, using coordinated eye gaze in order to communicate</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Stereotyped_Restricted_and_Repetitive_Behavior -->

    <owl:Class rdf:about="&autism-rules;Stereotyped_Restricted_and_Repetitive_Behavior">
        <rdfs:subClassOf rdf:resource="&autism-rules;Personal_Traits"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Behaviors, interests, movements, or vocalizations that are repetitive and lack clear function and purpose.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">N\A</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Stereotyped_utterances_and_delayed_echolalia -->

    <owl:Class rdf:about="&autism-rules;Stereotyped_utterances_and_delayed_echolalia">
        <rdfs:subClassOf rdf:resource="&autism-rules;Idiosyncratic_and_Routinized_Speech"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Stereotyped_utterances_and_delayed_echolalia_NotAvailable_or_No_Phrase -->

    <owl:Class rdf:about="&autism-rules;Stereotyped_utterances_and_delayed_echolalia_NotAvailable_or_No_Phrase">
        <rdfs:subClassOf rdf:resource="&autism-rules;Stereotyped_utterances_and_delayed_echolalia"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Stereotyped_utterances_and_delayed_echolalia_UnknownOrNotAsked -->

    <owl:Class rdf:about="&autism-rules;Stereotyped_utterances_and_delayed_echolalia_UnknownOrNotAsked">
        <rdfs:subClassOf rdf:resource="&autism-rules;Stereotyped_utterances_and_delayed_echolalia"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Task_Completion -->

    <owl:Class rdf:about="&autism-rules;Task_Completion">
        <rdfs:subClassOf rdf:resource="&autism-rules;Task_Performance"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Finishing a task.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d2105, http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d2104</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Task_Initiation -->

    <owl:Class rdf:about="&autism-rules;Task_Initiation">
        <rdfs:subClassOf rdf:resource="&autism-rules;Task_Performance"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Preparing and arranging the time and space for performance of a task with one or more components and undertaking execution of the task.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d2101</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Task_Performance -->

    <owl:Class rdf:about="&autism-rules;Task_Performance">
        <rdfs:subClassOf rdf:resource="&autism-rules;Working_Memory"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Carrying out simple or complex and coordinated actions related to the mental and physical components of a single task, such as initiating a task, organizing time, space and materials for a task, pacing task performance, and carrying out, completing, and sustaining a task.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d210</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Tendency_to_say_things_in_ritualized_way -->

    <owl:Class rdf:about="&autism-rules;Tendency_to_say_things_in_ritualized_way">
        <rdfs:subClassOf rdf:resource="&autism-rules;Verbal_rituals"/>
        <rdfs:comment rdf:datatype="&xsd;string">(1) Tendency to say things in ritualized way or to require others to do so, but no indication that this is compulsive, and readily stops if asked to do so</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Tics_and_Mannerisms -->

    <owl:Class rdf:about="&autism-rules;Tics_and_Mannerisms">
        <rdfs:subClassOf rdf:resource="&autism-rules;Involuntary_Behaviors"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Habitual, repeated, rapid contraction of certain muscles, resulting in stereotyped individualized actions that can be voluntarily suppressed for only brief periods. They tend to be aggravated by emotional stress.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D020323</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Toileting -->

    <owl:Class rdf:about="&autism-rules;Toileting">
        <rdfs:subClassOf rdf:resource="&autism-rules;Self-Care"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Planning and carrying out the appropriate elimination of human waste and cleaning oneself afterwards.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d530</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Transitioning_Ability -->

    <owl:Class rdf:about="&autism-rules;Transitioning_Ability">
        <rdfs:subClassOf rdf:resource="&autism-rules;Mental_Flexibility"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to shift attention from one activity or focus to another when required to do so.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=b1401</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Tuberous_Sclerosis -->

    <owl:Class rdf:about="&autism-rules;Tuberous_Sclerosis">
        <rdfs:subClassOf rdf:resource="&autism-core;AUTISMC1000038"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Type_1_DM -->

    <owl:Class rdf:about="&autism-rules;Type_1_DM">
        <rdfs:subClassOf rdf:resource="&autism-core;AUTISMC1000038"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Uncertain_Occasional_Direct_Gaze -->

    <owl:Class rdf:about="&autism-rules;Uncertain_Occasional_Direct_Gaze">
        <rdfs:subClassOf rdf:resource="&autism-rules;Direct_Gaze"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Understanding_Context -->

    <owl:Class rdf:about="&autism-rules;Understanding_Context">
        <rdfs:subClassOf rdf:resource="&autism-rules;Conversational_Skills"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to recognize the communication situation, including the mood, opinions and comprehension level of other participants, and to modify one&apos;s language and responses accordingly.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0566112</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Understanding_Logical_Progression -->

    <owl:Class rdf:about="&autism-rules;Understanding_Logical_Progression">
        <rdfs:subClassOf rdf:resource="&autism-rules;Reasoning"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Understanding how logically connected events relate to each other, such as understanding connections and order in a sequence.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0233630</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Understanding_Others_Expectations -->

    <owl:Class rdf:about="&autism-rules;Understanding_Others_Expectations">
        <rdfs:subClassOf rdf:resource="&autism-rules;Interpersonal_Awareness"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to understand obligations and accountability assumed in formal and informal relationships with others.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d2503</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Understanding_the_Effect_of_Ones_Actions -->

    <owl:Class rdf:about="&autism-rules;Understanding_the_Effect_of_Ones_Actions">
        <rdfs:subClassOf rdf:resource="&autism-rules;Interpersonal_Awareness"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to recognize how one&apos;s own behavior affects others, including recognizing when one&apos;s behavior bothers others, or when one&apos;s behavior hurts another individual.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d7100</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Understands_fewer_than_50_words -->

    <owl:Class rdf:about="&autism-rules;Understands_fewer_than_50_words">
        <rdfs:subClassOf rdf:resource="&autism-rules;Comprehension_of_simple_language"/>
        <rdfs:comment rdf:datatype="&xsd;string">(3) Understands fewer than 50 words, but some comprehension of &quot;no&quot; and names of a few favorite objects, food, or poeple, or words within familiar routines</rdfs:comment>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Severe distortions in the development of many basic psychological functions that are not normal for any stage in development. These distortions are manifested in sustained social impairment, speech abnormalities, and peculiar motor movements.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D002659</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Understands_many_words -->

    <owl:Class rdf:about="&autism-rules;Understands_many_words">
        <rdfs:subClassOf rdf:resource="&autism-rules;Comprehension_of_simple_language"/>
        <rdfs:comment rdf:datatype="&xsd;string">(2) Understands many words (more than 50), including &quot;yes&quot; and names of familiar people, toys or foods, but does not meet criteria from &quot;0&quot; or &quot;1&quot;</rdfs:comment>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Severe distortions in the development of many basic psychological functions that are not normal for any stage in development. These distortions are manifested in sustained social impairment, speech abnormalities, and peculiar motor movements.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D002659</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Undue_general_sensitivity_to_noise -->

    <owl:Class rdf:about="&autism-rules;Undue_general_sensitivity_to_noise">
        <rdfs:subClassOf rdf:resource="&autism-rules;Reaction_to_Sensory_Stimuli"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Undue_general_sensitivity_to_noise_UnknownOrNotAsked -->

