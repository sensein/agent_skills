                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
                        <owl:hasValue rdf:resource="&autism-rules;othman_Marked_mannerisms_associated_with_social_impairment"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&autism-rules;has_ever_finding"/>
