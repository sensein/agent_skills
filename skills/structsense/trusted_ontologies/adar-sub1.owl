        <rdfs:range rdf:resource="&xsd;int"/>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/autism-ontology/1.0/ca_vinelandsurvey-2005.owl#Vinelandsurvey_2005_InterpersRelation_14 -->

    <owl:DatatypeProperty rdf:about="http://purl.org/autism-ontology/1.0/ca_vinelandsurvey-2005.owl#Vinelandsurvey_2005_InterpersRelation_14">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:comment rdf:datatype="&xsd;string">&quot;Shows desire to please others (for example, shares a snack or toy, tries to help even if not capable, etc.).&quot;</rdfs:comment>
        <assessment-result:valueRange rdf:datatype="&xsd;string">0;1;2</assessment-result:valueRange>
        <assessment-result:isRequired rdf:datatype="&xsd;string">Recommended</assessment-result:isRequired>
        <assessment-result:usedIn rdf:datatype="&xsd;string">Vineland Survey Interview Form - 2005</assessment-result:usedIn>
        <rdfs:domain rdf:resource="http://purl.org/autism-ontology/1.0/ca_vinelandsurvey-2005.owl#AUTISMC000003"/>
        <rdfs:subPropertyOf rdf:resource="http://purl.org/autism-ontology/1.0/ca_vinelandsurvey-2005.owl#InterpersRelation"/>
        <rdfs:range rdf:resource="&xsd;int"/>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/autism-ontology/1.0/ca_vinelandsurvey-2005.owl#Vinelandsurvey_2005_InterpersRelation_15 -->

    <owl:DatatypeProperty rdf:about="http://purl.org/autism-ontology/1.0/ca_vinelandsurvey-2005.owl#Vinelandsurvey_2005_InterpersRelation_15">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:comment rdf:datatype="&xsd;string">&quot;Demonstrates friendship-seeking behavior with others the same age (for example, says, &quot;&quot;Do you want to play?&quot;&quot; or takes another child by the hand, etc.).&quot;</rdfs:comment>
        <assessment-result:valueRange rdf:datatype="&xsd;string">0;1;2</assessment-result:valueRange>
        <assessment-result:isRequired rdf:datatype="&xsd;string">Recommended</assessment-result:isRequired>
        <assessment-result:usedIn rdf:datatype="&xsd;string">Vineland Survey Interview Form - 2005</assessment-result:usedIn>
        <rdfs:domain rdf:resource="http://purl.org/autism-ontology/1.0/ca_vinelandsurvey-2005.owl#AUTISMC000003"/>
        <rdfs:subPropertyOf rdf:resource="http://purl.org/autism-ontology/1.0/ca_vinelandsurvey-2005.owl#InterpersRelation"/>
        <rdfs:range rdf:resource="&xsd;int"/>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/autism-ontology/1.0/ca_vinelandsurvey-2005.owl#Vinelandsurvey_2005_InterpersRelation_16 -->

    <owl:DatatypeProperty rdf:about="http://purl.org/autism-ontology/1.0/ca_vinelandsurvey-2005.owl#Vinelandsurvey_2005_InterpersRelation_16">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:comment rdf:datatype="&xsd;string">&quot;Imitates relatively complex actions as they are being performed by another person (for example, shaving, putting on makeup, hammering nails, etc.).&quot;</rdfs:comment>
        <assessment-result:valueRange rdf:datatype="&xsd;string">0;1;2</assessment-result:valueRange>
        <assessment-result:isRequired rdf:datatype="&xsd;string">Recommended</assessment-result:isRequired>
        <assessment-result:usedIn rdf:datatype="&xsd;string">Vineland Survey Interview Form - 2005</assessment-result:usedIn>
