    <owl:Class rdf:about="&autism-core;AUTISMC1000078">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&autism-core;AUTISMC1000053"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="&autism-core;AUTISMC1000033"/>
