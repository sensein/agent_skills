        <rdfs:subClassOf rdf:resource="&autism-rules;Offering_To_Share"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Offering_comfort_NotAvailable -->

    <owl:Class rdf:about="&autism-rules;Offering_comfort_NotAvailable">
        <rdfs:subClassOf rdf:resource="&autism-rules;Offering_Comfort"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Offering_comfort_NotKnownOrNotAsked -->

    <owl:Class rdf:about="&autism-rules;Offering_comfort_NotKnownOrNotAsked">
        <rdfs:subClassOf rdf:resource="&autism-rules;Offering_Comfort"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Often_Watches_Other_Children_and_Sometimes_Approaches_Them_ot_Gets_Attention -->

    <owl:Class rdf:about="&autism-rules;Often_Watches_Other_Children_and_Sometimes_Approaches_Them_ot_Gets_Attention">
        <rdfs:subClassOf rdf:resource="&autism-rules;Interest_In_Children"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Often_usesOrUsed_stereotyped_itterances_with_productive_language_as_well -->

    <owl:Class rdf:about="&autism-rules;Often_usesOrUsed_stereotyped_itterances_with_productive_language_as_well">
        <rdfs:subClassOf rdf:resource="&autism-rules;Stereotyped_utterances_and_delayed_echolalia"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#One_or_More_Relationships_That_Involve_Some_Personal_Shared_Activities -->

    <owl:Class rdf:about="&autism-rules;One_or_More_Relationships_That_Involve_Some_Personal_Shared_Activities">
        <rdfs:subClassOf rdf:resource="&autism-rules;Friendships"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#One_or_More_Relationships_With_Person_In_Approximately_Own_Age_Group -->

    <owl:Class rdf:about="&autism-rules;One_or_More_Relationships_With_Person_In_Approximately_Own_Age_Group">
        <rdfs:subClassOf rdf:resource="&autism-rules;Friendships"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#One_or_more_activities_that_subject_has_to_preform_in_a_special_way_if_disrupted_appears_to_be_under_MARKED_pressure -->

    <owl:Class rdf:about="&autism-rules;One_or_more_activities_that_subject_has_to_preform_in_a_special_way_if_disrupted_appears_to_be_under_MARKED_pressure">
        <rdfs:subClassOf rdf:resource="&autism-rules;Compulsions_or_rituals"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#One_or_more_activities_that_subject_has_to_preform_in_a_special_way_if_disrupted_appears_to_be_under_pressure -->

    <owl:Class rdf:about="&autism-rules;One_or_more_activities_that_subject_has_to_preform_in_a_special_way_if_disrupted_appears_to_be_under_pressure">
        <rdfs:subClassOf rdf:resource="&autism-rules;Compulsions_or_rituals"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Only_occasional_complex_mannerisms_or_stereotyped_body_movement -->

    <owl:Class rdf:about="&autism-rules;Only_occasional_complex_mannerisms_or_stereotyped_body_movement">
        <rdfs:subClassOf rdf:resource="&autism-rules;Other_complex_mannerisms_or_stereotyped_body_movements"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Only_occasional_midline_hand_movements -->

    <owl:Class rdf:about="&autism-rules;Only_occasional_midline_hand_movements">
        <rdfs:subClassOf rdf:resource="&autism-rules;Midline_hand_movements"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Onset_as_preceived_with_hindsight -->

    <owl:Class rdf:about="&autism-rules;Onset_as_preceived_with_hindsight">
        <rdfs:subClassOf rdf:resource="&autism-core;AUTISMC1000080"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Organ_or_tissue_function -->

    <owl:Class rdf:about="&autism-rules;Organ_or_tissue_function">
        <rdfs:subClassOf rdf:resource="&autism-rules;Physiologic_function"/>
        <rdfs:comment rdf:datatype="&xsd;string">A physiologic function of a particular organ, organ system, or tissue.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Organism_function -->

    <owl:Class rdf:about="&autism-rules;Organism_function">
        <rdfs:subClassOf rdf:resource="&autism-rules;Physiologic_function"/>
        <rdfs:comment rdf:datatype="&xsd;string">A physiologic function of the organism as a whole, of multiple organ systems, or of multiple organs or tissues</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Other_complex_mannerisms_or_stereotyped_body_movements -->

    <owl:Class rdf:about="&autism-rules;Other_complex_mannerisms_or_stereotyped_body_movements">
        <rdfs:subClassOf rdf:resource="&autism-rules;Motor_Perseveration"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Other_complex_mannerisms_or_stereotyped_body_movements_NotAvailable -->

    <owl:Class rdf:about="&autism-rules;Other_complex_mannerisms_or_stereotyped_body_movements_NotAvailable">
        <rdfs:subClassOf rdf:resource="&autism-rules;Other_complex_mannerisms_or_stereotyped_body_movements"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Other_complex_mannerisms_or_stereotyped_body_movements_UnknownOrNotAsked -->

    <owl:Class rdf:about="&autism-rules;Other_complex_mannerisms_or_stereotyped_body_movements_UnknownOrNotAsked">
        <rdfs:subClassOf rdf:resource="&autism-rules;Other_complex_mannerisms_or_stereotyped_body_movements"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Overall_level_of_language -->

    <owl:Class rdf:about="&autism-rules;Overall_level_of_language">
        <rdfs:subClassOf rdf:resource="&autism-rules;Expressive_Lexicon"/>
        <rdfs:comment rdf:datatype="&xsd;string">0 - functional use of spontaneous, echoed, or stereotyped language that, 
      on a daily basis, involves phrases of three words or more that at least 
      sometimes include a verb and are comprehensible

 1 - no functional use of three-word phrases in spontaneous, echoed, or 
      stereotyped speech, but uses speech on a daily basis with at least five 
      different words in the last month

 2 - fewer than five words total or speech not used on a daily basis</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Participation_in_Athletic_Activities -->

    <owl:Class rdf:about="&autism-rules;Participation_in_Athletic_Activities">
        <rdfs:subClassOf rdf:resource="&autism-rules;Engagement_in_Social_Activities"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Engaging in competitive and informal or formally organized games or athletic events, performed alone or in a group.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d9201</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Participation_in_Play_Activities -->

    <owl:Class rdf:about="&autism-rules;Participation_in_Play_Activities">
        <rdfs:subClassOf rdf:resource="&autism-rules;Engagement_in_Social_Activities"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Engaging in games and other recreation.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d920</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Pathologic_Function_NOS -->

    <owl:Class rdf:about="&autism-rules;Pathologic_Function_NOS">
        <rdfs:subClassOf rdf:resource="&autism-rules;Pathologic_function"/>
        <rdfs:comment rdf:datatype="&xsd;string">Pathologic Function NOS (not otherwise specified)</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Pathologic_function -->

    <owl:Class rdf:about="&autism-rules;Pathologic_function">
        <rdfs:subClassOf rdf:resource="&autism-rules;Biologic_function"/>
        <rdfs:comment rdf:datatype="&xsd;string">A disordered process, activity, or state of the organism as a whole, of a body system or systems, or of multiple organs or tissues. Included here are normal responses to a negative stimulus as well as patholologic conditions or states that are less specific than a disease. Pathologic functions frequently have systemic effects.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Pattern_Recognition_and_Rendering -->

    <owl:Class rdf:about="&autism-rules;Pattern_Recognition_and_Rendering">
        <rdfs:subClassOf rdf:resource="&autism-rules;Visual_Perception"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The analysis of a critical number of sensory stimuli or facts (the pattern) by processes such as vision, touch, or hearing, and the ability to produce patterns through drawing and other means.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D010364</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Performance_in_School -->

    <owl:Class rdf:about="&autism-rules;Performance_in_School">
        <rdfs:subClassOf rdf:resource="&autism-rules;Community_Life_Skills"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Performing activities involved in obtaining an education.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d820</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Performance_of_Chores -->

    <owl:Class rdf:about="&autism-rules;Performance_of_Chores">
        <rdfs:subClassOf rdf:resource="&autism-rules;Performance_of_Household_Tasks"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Doing housework such as cleaning the house, tidying rooms, washing clothes, storing food and disposing of garbage.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d640</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Performance_of_Household_Tasks -->

    <owl:Class rdf:about="&autism-rules;Performance_of_Household_Tasks">
        <rdfs:subClassOf rdf:resource="&autism-rules;Home_Life_Skills"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Performing tasks necessary for the general management and upkeep of a household, including completing chores and preparing food.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d630-d649</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Personal_Traits -->

    <owl:Class rdf:about="&autism-rules;Personal_Traits">
        <rdfs:subClassOf rdf:resource="&autism-rules;Autism_Phenotype"/>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">N\A</autism-rules:has_definition_source>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The distinguishing qualities, or characteristics, belonging to an individual. The qualities that have been shown to be important for the autism spectrum disorder phenotype include, for example, language and other cognitive abilities, restricted, repetitive and stereotyped behaviors, aspects of executive functioning, and a range of emotional traits.</autism-rules:has_definition>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Phrases_are_almost_exclusively_stereotyped_utterances -->

    <owl:Class rdf:about="&autism-rules;Phrases_are_almost_exclusively_stereotyped_utterances">
        <rdfs:subClassOf rdf:resource="&autism-rules;Stereotyped_utterances_and_delayed_echolalia"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Physiologic_function -->

    <owl:Class rdf:about="&autism-rules;Physiologic_function">
        <rdfs:subClassOf rdf:resource="&autism-rules;Biologic_function"/>
        <rdfs:comment rdf:datatype="&xsd;string">A normal process, activity, or state of the body.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Planning -->

    <owl:Class rdf:about="&autism-rules;Planning">
        <rdfs:subClassOf rdf:resource="&autism-rules;Executive_Function"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">A complex operation in which a sequence of actions must be constantly monitored, re-evaluated and updated.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=b1641</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Play_linked_to_highly_stereotyped_use_of_objects -->

    <owl:Class rdf:about="&autism-rules;Play_linked_to_highly_stereotyped_use_of_objects">
        <rdfs:subClassOf rdf:resource="&autism-rules;Repetitive_use_of_objects_or_interest_in_parts_of_objects"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Play_linked_to_highly_stereotyped_use_of_objects_and_prevents_other_activities -->

    <owl:Class rdf:about="&autism-rules;Play_linked_to_highly_stereotyped_use_of_objects_and_prevents_other_activities">
        <rdfs:subClassOf rdf:resource="&autism-rules;Repetitive_use_of_objects_or_interest_in_parts_of_objects"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Pointing_to_Express_Interest -->

    <owl:Class rdf:about="&autism-rules;Pointing_to_Express_Interest">
        <rdfs:subClassOf rdf:resource="&autism-rules;Gestures"/>
        <rdfs:subClassOf rdf:resource="&autism-rules;Joint_Attention"/>
        <autism-rules:reference rdf:datatype="&xsd;string">ADi-R (WPS No. W-382B)</autism-rules:reference>
        <rdfs:comment rdf:datatype="&xsd;string">Does [subject] ever spontaneously point at things around him\her?

with a finger or sort of hand extended, like reaching?

in what circumstances?

Does he\she ever point at things at a distance, such as out a window at home or in a car or bus?

If I wanted to get you to look at something, I might first look at it, then look at you, then point and look at the object again, then look back at you to see if you understood. Can [subject] do this?

What about when s/he was 4 to 5 years old?</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Poor_Eating_Behavior -->

    <owl:Class rdf:about="&autism-rules;Poor_Eating_Behavior">
        <rdfs:subClassOf rdf:resource="&autism-rules;Self-Care"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Behavior related to feeding which negatively affects the quality or amount of food eaten and digested.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0015745</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Poor_Treatment_by_Others_in_Social_Settings -->

    <owl:Class rdf:about="&autism-rules;Poor_Treatment_by_Others_in_Social_Settings">
        <rdfs:subClassOf rdf:resource="&autism-rules;Interactions_with_Friends_and_Family"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Being treated poorly by others in public, such as being frequently laughed at, made fun of, or bullied.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0730514</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Possible_Showing_by_Bringing_and_Directing_Attention_But_Not_Sufficient_Frequent -->

    <owl:Class rdf:about="&autism-rules;Possible_Showing_by_Bringing_and_Directing_Attention_But_Not_Sufficient_Frequent">
        <rdfs:subClassOf rdf:resource="&autism-rules;Showing_And_Directing_Attention"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Predictable_abnormal_idiosyncratic_negative_response_to_one_or_more_sensory_stimuli_some_intrusion_to_ordinary_activities -->

    <owl:Class rdf:about="&autism-rules;Predictable_abnormal_idiosyncratic_negative_response_to_one_or_more_sensory_stimuli_some_intrusion_to_ordinary_activities">
        <rdfs:subClassOf rdf:resource="&autism-rules;Abnormal_idiosyncratic_Negative_response_to_specific_sensory_stimuli"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Predictable_abnormal_idiosyncratic_negative_response_to_one_or_more_sensory_stimuli_with_mild_reaction -->

    <owl:Class rdf:about="&autism-rules;Predictable_abnormal_idiosyncratic_negative_response_to_one_or_more_sensory_stimuli_with_mild_reaction">
        <rdfs:subClassOf rdf:resource="&autism-rules;Abnormal_idiosyncratic_Negative_response_to_specific_sensory_stimuli"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Predictable_abnormal_idiosyncratic_negative_response_to_one_or_more_sensory_stimuli_with_substantial_interference_with_family_routines -->

    <owl:Class rdf:about="&autism-rules;Predictable_abnormal_idiosyncratic_negative_response_to_one_or_more_sensory_stimuli_with_substantial_interference_with_family_routines">
        <rdfs:subClassOf rdf:resource="&autism-rules;Abnormal_idiosyncratic_Negative_response_to_specific_sensory_stimuli"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Preparation_of_Food -->

    <owl:Class rdf:about="&autism-rules;Preparation_of_Food">
        <rdfs:subClassOf rdf:resource="&autism-rules;Performance_of_Household_Tasks"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Planning, organizing, cooking and serving simple and complex meals for oneself and others.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d630</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Preparing_for_Tasks -->

    <owl:Class rdf:about="&autism-rules;Preparing_for_Tasks">
        <rdfs:subClassOf rdf:resource="&autism-rules;Planning"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to successfully manage arranging materials, space, or time as needed to facilitate performance of tasks.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d2100, http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d2101</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Prevalence -->

    <owl:Class rdf:about="&autism-rules;Prevalence">
        <rdfs:subClassOf rdf:resource="&autism-rules;Frequency"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Probable_loss_of_articulation -->

    <owl:Class rdf:about="&autism-rules;Probable_loss_of_articulation">
        <rdfs:subClassOf rdf:resource="&autism-rules;Loss_of_articulation"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Probable_loss_of_communicative_intent -->

    <owl:Class rdf:about="&autism-rules;Probable_loss_of_communicative_intent">
        <rdfs:subClassOf rdf:resource="&autism-rules;Loss_of_communicative_intent"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Probable_loss_of_five_meaningful_words_use -->

    <owl:Class rdf:about="&autism-rules;Probable_loss_of_five_meaningful_words_use">
        <rdfs:subClassOf rdf:resource="&autism-rules;Loss_of_spontaneous_use_of_at_least_five_meaningful_words"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Probable_loss_of_syntactical_skills -->

    <owl:Class rdf:about="&autism-rules;Probable_loss_of_syntactical_skills">
        <rdfs:subClassOf rdf:resource="&autism-rules;Loss_of_syntactical_skills"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Problem_Solving_Ability -->

    <owl:Class rdf:about="&autism-rules;Problem_Solving_Ability">
        <rdfs:subClassOf rdf:resource="&autism-rules;Reasoning"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Finding solutions to questions or situations by identifying and analyzing issues, developing options and solutions, evaluating potential effects of solutions, and executing a chosen solution.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0033211</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Problems_not_present_before_fifth_birthday -->

    <owl:Class rdf:about="&autism-rules;Problems_not_present_before_fifth_birthday">
        <rdfs:subClassOf rdf:resource="&autism-rules;Onset_as_preceived_with_hindsight"/>
        <rdfs:comment rdf:datatype="&xsd;string">Problems not present before fifth birthday, but were noted at or before 
      sixth birthday</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Problems_not_present_before_first_birthday -->

    <owl:Class rdf:about="&autism-rules;Problems_not_present_before_first_birthday">
        <rdfs:subClassOf rdf:resource="&autism-rules;Onset_as_preceived_with_hindsight"/>
        <rdfs:comment rdf:datatype="&xsd;string">Problems not present before first birthday, but were noted as or before 
            third birthday</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Problems_not_present_before_fourth_birthday -->

    <owl:Class rdf:about="&autism-rules;Problems_not_present_before_fourth_birthday">
        <rdfs:subClassOf rdf:resource="&autism-rules;Onset_as_preceived_with_hindsight"/>
        <rdfs:comment rdf:datatype="&xsd;string">Problems not present before fourth birthday, but were noted at or before 
            fifth birthday</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Problems_not_present_before_second_birthday -->

    <owl:Class rdf:about="&autism-rules;Problems_not_present_before_second_birthday">
        <rdfs:subClassOf rdf:resource="&autism-rules;Onset_as_preceived_with_hindsight"/>
        <rdfs:comment rdf:datatype="&xsd;string">Problems not present before second birthday, but were noted as or before 
      third birthday</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Problems_not_present_before_sixth_birthday -->

    <owl:Class rdf:about="&autism-rules;Problems_not_present_before_sixth_birthday">
        <rdfs:subClassOf rdf:resource="&autism-rules;Onset_as_preceived_with_hindsight"/>
        <rdfs:comment rdf:datatype="&xsd;string">Problems not present before sixth birthday, but were noted at or 
      before 
XXX birthday</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Problems_not_present_before_third_birthday -->

    <owl:Class rdf:about="&autism-rules;Problems_not_present_before_third_birthday">
        <rdfs:subClassOf rdf:resource="&autism-rules;Onset_as_preceived_with_hindsight"/>
        <rdfs:comment rdf:datatype="&xsd;string">Problems not present before third birthday, but were noted at or before 
      fourth birthday</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Problems_present_in_first_12_months -->

    <owl:Class rdf:about="&autism-rules;Problems_present_in_first_12_months">
        <rdfs:subClassOf rdf:resource="&autism-rules;Onset_as_preceived_with_hindsight"/>
        <rdfs:comment rdf:datatype="&xsd;string">Problems present in first 12 months</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Produced_speech_or_sounds_upon_request -->

    <owl:Class rdf:about="&autism-rules;Produced_speech_or_sounds_upon_request">
        <rdfs:subClassOf rdf:resource="&autism-rules;Level_of_communicative_language_before_loss"/>
        <rdfs:comment rdf:datatype="&xsd;string">Prodeuced speech or sounds upon request (may or may not have also spontaneously imitated)</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Pronominal_confusion_other -->

    <owl:Class rdf:about="&autism-rules;Pronominal_confusion_other">
        <rdfs:subClassOf rdf:resource="&autism-rules;Pronominal_reversal"/>
        <rdfs:comment rdf:datatype="&xsd;string">(7) Other type of pronominal confusion (other than &quot;I/am&quot;), such as &quot;he/you&quot;</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Pronominal_confusion_when_asking_a_question -->

    <owl:Class rdf:about="&autism-rules;Pronominal_confusion_when_asking_a_question">
        <rdfs:subClassOf rdf:resource="&autism-rules;Pronominal_reversal"/>
        <rdfs:comment rdf:datatype="&xsd;string">(3) Pronominal confusion when asking a question in which &quot;you&quot; or &quot;s/he&quot; is used for &quot;I&quot;</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Pronominal_reversal -->

    <owl:Class rdf:about="&autism-rules;Pronominal_reversal">
        <rdfs:subClassOf rdf:resource="&autism-rules;Expressive_Syntax"/>
        <rdfs:comment rdf:datatype="&xsd;string">(Q37) Pronominal Reversal</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Pronominal_reversal_NotAvailable -->

    <owl:Class rdf:about="&autism-rules;Pronominal_reversal_NotAvailable">
        <rdfs:subClassOf rdf:resource="&autism-rules;Pronominal_reversal"/>
        <rdfs:comment rdf:datatype="&xsd;string">(8) N/A (code &quot;1&quot; or &quot;2&quot; on Item 30 or no pronouns used)</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Pronominal_reversal_UnknownOrNotAsked -->

    <owl:Class rdf:about="&autism-rules;Pronominal_reversal_UnknownOrNotAsked">
        <rdfs:subClassOf rdf:resource="&autism-rules;Pronominal_reversal"/>
        <rdfs:comment rdf:datatype="&xsd;string">(9) N/K or not asked</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Prosody -->

    <owl:Class rdf:about="&autism-rules;Prosody">
        <rdfs:subClassOf rdf:resource="&autism-rules;Expressive_Phonology"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to produce the appropriate rhythm, stress, and intonation of speech.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D013065</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Purposive_hand_movements -->

    <owl:Class rdf:about="&autism-rules;Purposive_hand_movements">
        <rdfs:subClassOf rdf:resource="&autism-rules;Loss_of_language_skills_or_other_skills"/>
        <rdfs:comment rdf:datatype="&xsd;string">(Q21) Purposive Hand Movements (ability to grip/hold objects)</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Purposive_hand_movements_Definite_loss -->

    <owl:Class rdf:about="&autism-rules;Purposive_hand_movements_Definite_loss">
        <rdfs:subClassOf rdf:resource="&autism-rules;Purposive_hand_movements"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Purposive_hand_movements_No_loss -->

    <owl:Class rdf:about="&autism-rules;Purposive_hand_movements_No_loss">
        <rdfs:subClassOf rdf:resource="&autism-rules;Purposive_hand_movements"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Purposive_hand_movements_Possible_loss -->

    <owl:Class rdf:about="&autism-rules;Purposive_hand_movements_Possible_loss">
        <rdfs:subClassOf rdf:resource="&autism-rules;Purposive_hand_movements"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Quality_of_Performed_Task -->

    <owl:Class rdf:about="&autism-rules;Quality_of_Performed_Task">
        <rdfs:subClassOf rdf:resource="&autism-rules;Task_Performance"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The degree of excellence with which a task is performed.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0557391</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Quality_of_Social_Overtures -->

    <owl:Class rdf:about="&autism-rules;Quality_of_Social_Overtures">
        <rdfs:subClassOf rdf:resource="&autism-rules;Conversational_Skills"/>
        <rdfs:subClassOf rdf:resource="&autism-rules;Eye_Contact"/>
        <rdfs:subClassOf rdf:resource="&autism-rules;Integrated_Verbal_and_NonVerbal_Communication"/>
        <rdfs:comment rdf:datatype="&xsd;string">(Q56) Quality Of Social Overtures</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Quality_of_Social_Overtures_NotAvailable -->

    <owl:Class rdf:about="&autism-rules;Quality_of_Social_Overtures_NotAvailable">
        <rdfs:subClassOf rdf:resource="&autism-rules;Quality_of_Social_Overtures"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Range_of_Facial_Expressions_Used_To_Communicate -->

    <owl:Class rdf:about="&autism-rules;Range_of_Facial_Expressions_Used_To_Communicate">
        <rdfs:subClassOf rdf:resource="&autism-rules;Facial_Expressions"/>
        <rdfs:subClassOf rdf:resource="&autism-rules;Relating_to_Others"/>
        <rdfs:comment rdf:datatype="&xsd;string">(Q57) Range Of Facial Expressions Used To Communicate</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Rare_or_No_Social_Approaches_of_Showing_and_Directing_Attention -->

    <owl:Class rdf:about="&autism-rules;Rare_or_No_Social_Approaches_of_Showing_and_Directing_Attention">
        <rdfs:subClassOf rdf:resource="&autism-rules;Showing_And_Directing_Attention"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Rarely_Shows_Social_Intentionality_Involving_Eye_Gaze_or_Vocalization -->

    <owl:Class rdf:about="&autism-rules;Rarely_Shows_Social_Intentionality_Involving_Eye_Gaze_or_Vocalization">
        <rdfs:subClassOf rdf:resource="&autism-rules;Quality_of_Social_Overtures"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Rarely_offers_comfort_or_only_in_odd_ways -->

    <owl:Class rdf:about="&autism-rules;Rarely_offers_comfort_or_only_in_odd_ways">
        <rdfs:subClassOf rdf:resource="&autism-rules;Offering_Comfort"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Rarely_or_never_responds_to_the_approach_of_even_a_familiar_child -->

    <owl:Class rdf:about="&autism-rules;Rarely_or_never_responds_to_the_approach_of_even_a_familiar_child">
        <rdfs:subClassOf rdf:resource="&autism-rules;Response_to_Approaches_Of_Other_Children"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Rarely_or_never_uses_stereotyped_phrases -->

    <owl:Class rdf:about="&autism-rules;Rarely_or_never_uses_stereotyped_phrases">
        <rdfs:subClassOf rdf:resource="&autism-rules;Stereotyped_utterances_and_delayed_echolalia"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Rarely_responds_although_hearing_normal -->

    <owl:Class rdf:about="&autism-rules;Rarely_responds_although_hearing_normal">
        <rdfs:subClassOf rdf:resource="&autism-rules;Attention_to_voice"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Reaction_to_Sensory_Stimuli -->

    <owl:Class rdf:about="&autism-rules;Reaction_to_Sensory_Stimuli">
        <rdfs:subClassOf rdf:resource="&autism-rules;Involuntary_Behaviors"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Extreme sensitivity to external stimuli such as noises, bright lights, smells and textures.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D012684, http://www.nlm.nih.gov/research/umls?cui=C0854080</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Reaction_to_Unexpected_Change -->

    <owl:Class rdf:about="&autism-rules;Reaction_to_Unexpected_Change">
        <rdfs:subClassOf rdf:resource="&autism-rules;Restricted_and_Repetitive_Behavior"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Response to changes in situations or surroundings.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d2500</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Reading_and_Writing -->

    <owl:Class rdf:about="&autism-rules;Reading_and_Writing">
        <rdfs:subClassOf rdf:resource="&autism-rules;Language_Ability"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Performing activities involved in the comprehension and production of written language for the purpose of obtaining general knowledge or specific information.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d345</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Reasoning -->

    <owl:Class rdf:about="&autism-rules;Reasoning">
        <rdfs:subClassOf rdf:resource="&autism-rules;Analytic_Capability"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Thinking that is coherent and logical, involving ability to follow instructions as well as problem solving ability.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0684328</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Receptive_Language -->

    <owl:Class rdf:about="&autism-rules;Receptive_Language">
        <rdfs:subClassOf rdf:resource="&autism-rules;Language_Ability"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to understand language.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d310</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Receptive_Lexicon -->

    <owl:Class rdf:about="&autism-rules;Receptive_Lexicon">
        <rdfs:subClassOf rdf:resource="&autism-rules;Receptive_Language"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The vocabulary that an individual is able to understand.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D014825</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Receptive_Morphology -->

    <owl:Class rdf:about="&autism-rules;Receptive_Morphology">
        <rdfs:subClassOf rdf:resource="&autism-rules;Receptive_Language"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to understand the structure and constituent parts of a word.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0517141</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Receptive_Phonology -->

    <owl:Class rdf:about="&autism-rules;Receptive_Phonology">
        <rdfs:subClassOf rdf:resource="&autism-rules;Receptive_Language"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to recognize and understand language sounds.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=b2304</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Receptive_Semantics -->

    <owl:Class rdf:about="&autism-rules;Receptive_Semantics">
        <rdfs:subClassOf rdf:resource="&autism-rules;Receptive_Language"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to understand language meaning.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C2183464</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Receptive_Syntax -->

    <owl:Class rdf:about="&autism-rules;Receptive_Syntax">
        <rdfs:subClassOf rdf:resource="&autism-rules;Receptive_Language"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to comprehend phrases and sentences according to the rules of grammar.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C2183464</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Reciprocal_Conversation -->

    <owl:Class rdf:about="&autism-rules;Reciprocal_Conversation">
        <rdfs:label rdf:datatype="&xsd;string">Reciprocal Conversation</rdfs:label>
        <rdfs:subClassOf rdf:resource="&autism-rules;Conversational_Skills"/>
        <rdfs:comment rdf:datatype="&xsd;string">ADI-R (Q35): Reciprocat Conversation within subject&apos;s level of language)</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Reciprocal_Social_Interaction -->

    <owl:Class rdf:about="&autism-rules;Reciprocal_Social_Interaction">
        <rdfs:subClassOf rdf:resource="&autism-rules;Interpersonal_Interactions"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Mutual actions and communicative exchanges among people in social settings.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d730</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Recognition_and_Responsiveness_to_Voice -->

    <owl:Class rdf:about="&autism-rules;Recognition_and_Responsiveness_to_Voice">
        <rdfs:subClassOf rdf:resource="&autism-rules;Reciprocal_Social_Interaction"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Awareness of someone&apos;s voice when another individual begins speaking, and ability to turn, locate and focus on voice, including responding when name is called.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d3100</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Recognition_of_Social_Norms -->

    <owl:Class rdf:about="&autism-rules;Recognition_of_Social_Norms">
        <rdfs:subClassOf rdf:resource="&autism-rules;Social_Competence"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Awareness of rules for social conduct, or standards which comprise a cultural definition of desirable or acceptable behavior.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0237750</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Refer_to_self_by_name_afterphrase_speech_established -->

    <owl:Class rdf:about="&autism-rules;Refer_to_self_by_name_afterphrase_speech_established">
        <rdfs:subClassOf rdf:resource="&autism-rules;Pronominal_reversal"/>
        <rdfs:comment rdf:datatype="&xsd;string">(1) Refers/referres to self by name instead of &quot;I&quot; after phrase speech established, but no persistant &quot;you/s/he-I&quot; confusion</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Refineable_entity -->

    <owl:Class rdf:about="&autism-rules;Refineable_entity">
        <rdfs:subClassOf rdf:resource="http://www.ifomis.org/bfo/1.1/snap#Quality"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Regard_for_Customs_and_Manners -->

    <owl:Class rdf:about="&autism-rules;Regard_for_Customs_and_Manners">
        <rdfs:subClassOf rdf:resource="&autism-rules;Recognition_of_Social_Norms"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Recognizing and adhering to social conventions governing oneself and one&apos;s behavior in public and around others.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d7203</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Regression_of_General_Skills -->

    <owl:Class rdf:about="&autism-rules;Regression_of_General_Skills">
        <rdfs:subClassOf rdf:resource="&autism-rules;Adaptive_Life_Skills"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Loss or decline of abilities or skills that have already been learned.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C2748611</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Regression_of_Language_Skills -->

    <owl:Class rdf:about="&autism-rules;Regression_of_Language_Skills">
        <rdfs:subClassOf rdf:resource="&autism-rules;Development_or_Regression_of_Language_Skills"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Loss of language ability after some language has already been acquired.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C1843016</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Regular_Showing_of_Objects_by_Bringing_and_Directing_Attention -->

    <owl:Class rdf:about="&autism-rules;Regular_Showing_of_Objects_by_Bringing_and_Directing_Attention">
        <rdfs:subClassOf rdf:resource="&autism-rules;Showing_And_Directing_Attention"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Regular_use_of_neologisms_or_idiosyncratic_ways_of_saying_things -->

    <owl:Class rdf:about="&autism-rules;Regular_use_of_neologisms_or_idiosyncratic_ways_of_saying_things">
        <rdfs:subClassOf rdf:resource="&autism-rules;Neologisms_idiosyncratic_language"/>
        <rdfs:comment rdf:datatype="&xsd;string">(2) Regular use of neologisms and/or idiosyncratic ways of saying things, including generalization of unusual term to reference beyond the example that may have fosteres the initial idiosyncratic word or phrase</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Regular_use_of_others_hand_as_a_tool -->

    <owl:Class rdf:about="&autism-rules;Regular_use_of_others_hand_as_a_tool">
        <rdfs:subClassOf rdf:resource="&autism-rules;Use_of_others_body_to_communicate"/>
        <rdfs:comment rdf:datatype="&xsd;string">(3) Regular use of other&apos;s hand as a tool or to gesture &quot;for&quot; the subject</rdfs:comment>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Severe distortions in the development of many basic psychological functions that are not normal for any stage in development. These distortions are manifested in sustained social impairment, speech abnormalities, and peculiar motor movements.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D002659</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Regularly_predictable_reciprocal_social_smiling -->

    <owl:Class rdf:about="&autism-rules;Regularly_predictable_reciprocal_social_smiling">
        <rdfs:subClassOf rdf:resource="&autism-rules;Social_smiling"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Relating_to_Others -->

    <owl:Class rdf:about="&autism-rules;Relating_to_Others">
        <rdfs:subClassOf rdf:resource="&autism-rules;Reciprocal_Social_Interaction"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Beginning and maintaining interactions with others for a short or long period of time, in a contextually and socially appropriate manner.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d7200</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Repetitive_Actions -->

    <owl:Class rdf:about="&autism-rules;Repetitive_Actions">
        <rdfs:subClassOf rdf:resource="&autism-rules;Adherence_to_Rituals_and_Routines"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Performing the same action repeatedly.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C1827547</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Repetitive_use_of_objects_or_interest_in_parts_of_objects -->

    <owl:Class rdf:about="&autism-rules;Repetitive_use_of_objects_or_interest_in_parts_of_objects">
        <rdfs:subClassOf rdf:resource="&autism-rules;Restricted_and_Unusual_Interests"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Repetitive_use_of_objects_or_interest_in_parts_of_objects_NotAvailable -->

    <owl:Class rdf:about="&autism-rules;Repetitive_use_of_objects_or_interest_in_parts_of_objects_NotAvailable">
        <rdfs:subClassOf rdf:resource="&autism-rules;Repetitive_use_of_objects_or_interest_in_parts_of_objects"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Repetitive_use_of_objects_or_interest_in_parts_of_objects_UnknownOrNotAsked -->

    <owl:Class rdf:about="&autism-rules;Repetitive_use_of_objects_or_interest_in_parts_of_objects_UnknownOrNotAsked">
        <rdfs:subClassOf rdf:resource="&autism-rules;Repetitive_use_of_objects_or_interest_in_parts_of_objects"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Resistance_to_trivial_changes_in_the_environment_not_directly_affecting_the_subject -->

    <owl:Class rdf:about="&autism-rules;Resistance_to_trivial_changes_in_the_environment_not_directly_affecting_the_subject">
        <rdfs:subClassOf rdf:resource="&autism-rules;Reaction_to_Unexpected_Change"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Resistance_to_trivial_changes_in_the_environment_not_directly_affecting_the_subject_UnknownOrNotAsked -->

    <owl:Class rdf:about="&autism-rules;Resistance_to_trivial_changes_in_the_environment_not_directly_affecting_the_subject_UnknownOrNotAsked">
        <rdfs:subClassOf rdf:resource="&autism-rules;Resistance_to_trivial_changes_in_the_environment_not_directly_affecting_the_subject"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Responds_to_parentsOrCaregiver_and_others_in_familiar_settings -->

    <owl:Class rdf:about="&autism-rules;Responds_to_parentsOrCaregiver_and_others_in_familiar_settings">
        <rdfs:subClassOf rdf:resource="&autism-rules;Appropriateness_of_social_responses"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Response_Inhibition -->

    <owl:Class rdf:about="&autism-rules;Response_Inhibition">
        <rdfs:subClassOf rdf:resource="&autism-rules;Executive_Function"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The interference with or prevention of a behavioral or verbal response even though the stimulus for that response is present.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D007266</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Response_to_Approaches_Of_Other_Children -->

    <owl:Class rdf:about="&autism-rules;Response_to_Approaches_Of_Other_Children">
        <rdfs:subClassOf rdf:resource="&autism-rules;Responsiveness_to_Social_Advances"/>
        <rdfs:comment rdf:datatype="&xsd;string">(Q63) Response to approaches of other shildren</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Response_to_Approaches_Of_Other_Children_NotAvailable -->

    <owl:Class rdf:about="&autism-rules;Response_to_Approaches_Of_Other_Children_NotAvailable">
        <rdfs:subClassOf rdf:resource="&autism-rules;Response_to_Approaches_Of_Other_Children"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Response_to_Approaches_Of_Other_Children_NotKnownorNotAsked -->

    <owl:Class rdf:about="&autism-rules;Response_to_Approaches_Of_Other_Children_NotKnownorNotAsked">
        <rdfs:subClassOf rdf:resource="&autism-rules;Response_to_Approaches_Of_Other_Children"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Responsiveness_to_Social_Advances -->

    <owl:Class rdf:about="&autism-rules;Responsiveness_to_Social_Advances">
        <rdfs:subClassOf rdf:resource="&autism-rules;Initiating_and_Responding_to_Social_Overtures"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Reacting positively by attempts of others to initial social interaction.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C2111895</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Restricted_Range_of_Interests -->

    <owl:Class rdf:about="&autism-rules;Restricted_Range_of_Interests">
        <rdfs:subClassOf rdf:resource="&autism-rules;Restricted_and_Unusual_Interests"/>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">N\A</autism-rules:has_definition_source>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Possessing a narrow range of interests in objects or topics.</autism-rules:has_definition>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Restricted_and_Repetitive_Behavior -->

    <owl:Class rdf:about="&autism-rules;Restricted_and_Repetitive_Behavior">
        <rdfs:subClassOf rdf:resource="&autism-rules;Stereotyped_Restricted_and_Repetitive_Behavior"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Atypical behavior that involves both display of unusual or intense interests, and atypical movements such as hand flapping, finger movements, rocking or twirling.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C2675334</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Restricted_and_Unusual_Interests -->

    <owl:Class rdf:about="&autism-rules;Restricted_and_Unusual_Interests">
        <rdfs:subClassOf rdf:resource="&autism-rules;Restricted_and_Repetitive_Behavior"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Atypical or highly limited interest in specific objects or topics.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C2675334</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Risk_factor -->

    <owl:Class rdf:about="&autism-rules;Risk_factor">
        <rdfs:subClassOf rdf:resource="http://ontology.neuinfo.org/NIF/Backend/BIRNLex-OBI-proxy.owl#birnlex_11001"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Schizophrenia -->

    <owl:Class rdf:about="&autism-rules;Schizophrenia">
        <rdfs:subClassOf rdf:resource="&autism-core;AUTISMC1000038"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Seeking_To_Share_herHis_Enjoyment_With_Others -->

    <owl:Class rdf:about="&autism-rules;Seeking_To_Share_herHis_Enjoyment_With_Others">
        <rdfs:subClassOf rdf:resource="&autism-rules;Joint_Attention"/>
        <rdfs:comment rdf:datatype="&xsd;string">(Q54) Seeking to Share Her\His Enjoyment With Others</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Seeking_To_Share_herHis_Enjoyment_With_Others_NotAvailable -->

    <owl:Class rdf:about="&autism-rules;Seeking_To_Share_herHis_Enjoyment_With_Others_NotAvailable">
        <rdfs:subClassOf rdf:resource="&autism-rules;Seeking_To_Share_herHis_Enjoyment_With_Others"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Seeking_To_Share_herHis_Enjoyment_With_Others_NotKnownOrNotAsked -->

    <owl:Class rdf:about="&autism-rules;Seeking_To_Share_herHis_Enjoyment_With_Others_NotKnownOrNotAsked">
        <rdfs:subClassOf rdf:resource="&autism-rules;Seeking_To_Share_herHis_Enjoyment_With_Others"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Seeks_No_Play_That_Involves_Participation_in_Groups_of_Other_Children -->

    <owl:Class rdf:about="&autism-rules;Seeks_No_Play_That_Involves_Participation_in_Groups_of_Other_Children">
        <rdfs:subClassOf rdf:resource="&autism-rules;Group_Play_With_Peers"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Self-Care -->

    <owl:Class rdf:about="&autism-rules;Self-Care">
        <rdfs:subClassOf rdf:resource="&autism-rules;Home_Life_Skills"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Caring for oneself, including washing and drying oneself, caring for one&apos;s body and body parts, proper use of the bathroom as needed, dressing, eating and drinking.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d5</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Self-Injurious_Behavior -->

    <owl:Class rdf:about="&autism-rules;Self-Injurious_Behavior">
        <rdfs:subClassOf rdf:resource="&autism-rules;Emotional_Regulation_and_Control"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Behavior in which persons intentionally hurt or harm themselves.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D016728</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Self_Concept -->

    <owl:Class rdf:about="&autism-rules;Self_Concept">
        <rdfs:subClassOf rdf:resource="&autism-rules;Emotional_Traits"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">A person&apos;s view of himself, including confidence in one&apos;s personal traits and abilities.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://purl.bioontology.org/ontology/MSH/D012649</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Self_help_skills -->

    <owl:Class rdf:about="&autism-rules;Self_help_skills">
        <rdfs:subClassOf rdf:resource="&autism-rules;Loss_of_language_skills_or_other_skills"/>
        <rdfs:comment rdf:datatype="&xsd;string">(Q23) Self-help skills (feeding, dress, using the bathroom etc.)</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Self_help_skills_Definite_loss -->

    <owl:Class rdf:about="&autism-rules;Self_help_skills_Definite_loss">
        <rdfs:subClassOf rdf:resource="&autism-rules;Self_help_skills"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Self_help_skills_No_loss -->

    <owl:Class rdf:about="&autism-rules;Self_help_skills_No_loss">
        <rdfs:subClassOf rdf:resource="&autism-rules;Self_help_skills"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Self_help_skills_Possible_loss -->

    <owl:Class rdf:about="&autism-rules;Self_help_skills_Possible_loss">
        <rdfs:subClassOf rdf:resource="&autism-rules;Self_help_skills"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Sensitivity_to_Conversant -->

    <owl:Class rdf:about="&autism-rules;Sensitivity_to_Conversant">
        <rdfs:subClassOf rdf:resource="&autism-rules;Conversational_Skills"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Observant of other participant in conversation, such as recognizing if other participant appears bored, not changing the topic of conversation if others are not interested, and not interrupting others in conversation.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d3503</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Series_of_short_lasting_attachments_to_unusual_objects -->

    <owl:Class rdf:about="&autism-rules;Series_of_short_lasting_attachments_to_unusual_objects">
        <rdfs:subClassOf rdf:resource="&autism-rules;Unusual_attachment_to_objects"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Sharing -->

    <owl:Class rdf:about="&autism-rules;Sharing">
        <rdfs:subClassOf rdf:resource="&autism-rules;Interactions_with_Friends_and_Family"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Offering and allowing others to use possessions, such as letting another child play with one&apos;s own toys.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0237876</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Sharing_in_Interests_of_Others -->

    <owl:Class rdf:about="&autism-rules;Sharing_in_Interests_of_Others">
        <rdfs:subClassOf rdf:resource="&autism-rules;Interactions_with_Friends_and_Family"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Showing interest in participating in or learning about activities or topics that others express enjoyment in.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://bioportal.bioontology.org/ontologies/45578?p=terms&amp;conceptid=d7101</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Showing_And_Directing_Attention -->

    <owl:Class rdf:about="&autism-rules;Showing_And_Directing_Attention">
        <rdfs:subClassOf rdf:resource="&autism-rules;Joint_Attention"/>
        <rdfs:comment rdf:datatype="&xsd;string">(Q52) Showing And Directing Attention</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Showing_And_Directing_Attention_NotAvailable -->

    <owl:Class rdf:about="&autism-rules;Showing_And_Directing_Attention_NotAvailable">
        <rdfs:subClassOf rdf:resource="&autism-rules;Showing_And_Directing_Attention"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Showing_And_Directing_Attention_NotKnownOrNotAsked -->

    <owl:Class rdf:about="&autism-rules;Showing_And_Directing_Attention_NotKnownOrNotAsked">
        <rdfs:subClassOf rdf:resource="&autism-rules;Showing_And_Directing_Attention"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Showing_Emotion -->

    <owl:Class rdf:about="&autism-rules;Showing_Emotion">
        <rdfs:subClassOf rdf:resource="&autism-rules;Affect"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Showing outward display of emotions that can be perceived by others.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0455212</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Shows_no_interest_in_other_children -->

    <owl:Class rdf:about="&autism-rules;Shows_no_interest_in_other_children">
        <rdfs:subClassOf rdf:resource="&autism-rules;Interest_In_Children"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Shows_one_or_two_unusual_interests_regularly -->

    <owl:Class rdf:about="&autism-rules;Shows_one_or_two_unusual_interests_regularly">
        <rdfs:subClassOf rdf:resource="&autism-rules;Unusual_sensory_interests"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Skill_in_Understanding_Humor -->

    <owl:Class rdf:about="&autism-rules;Skill_in_Understanding_Humor">
        <rdfs:subClassOf rdf:resource="&autism-rules;Understanding_Context"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to recognize and enjoy humorous statements, including jokes, irony, and sarcasm.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0566220</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Skill_in_Understanding_Non-Literal_Meaning -->

    <owl:Class rdf:about="&autism-rules;Skill_in_Understanding_Non-Literal_Meaning">
        <rdfs:subClassOf rdf:resource="&autism-rules;Understanding_Context"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to recognize and comprehend figurative and metaphorical meanings.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0870558</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Sleep_Disorders -->

    <owl:Class rdf:about="&autism-rules;Sleep_Disorders">
        <rdfs:subClassOf rdf:resource="&autism-core;AUTISMC1000038"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Slight_sensitivity_to_noise -->

    <owl:Class rdf:about="&autism-rules;Slight_sensitivity_to_noise">
        <rdfs:subClassOf rdf:resource="&autism-rules;Undue_general_sensitivity_to_noise"/>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Social_Anxiety -->

    <owl:Class rdf:about="&autism-rules;Social_Anxiety">
        <rdfs:subClassOf rdf:resource="&autism-rules;Interpersonal_Interactions"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Apprehension or fear of social interaction or social situations in general.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0424166</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Social_Awkwardness -->

    <owl:Class rdf:about="&autism-rules;Social_Awkwardness">
        <rdfs:subClassOf rdf:resource="&autism-rules;Interpersonal_Interactions"/>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">N\A</autism-rules:has_definition_source>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The inability to conduct oneself with ease in social situations.</autism-rules:has_definition>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Social_Competence -->

    <owl:Class rdf:about="&autism-rules;Social_Competence">
        <rdfs:subClassOf rdf:resource="&autism-rules;Autism_Phenotype"/>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">N\A</autism-rules:has_definition_source>
        <autism-rules:has_definition rdf:datatype="&xsd;string">The ability to function in social situations. Children and adults with autism spectrum disorder demonstrate some delays, deficits, or atypical characteristics in the frequency, type, and quality of social interactions and social relationships with other individuals. Research suggests that differences in social development characterize children with autism spectrum disorder from the earliest months, and that delays, deficits, or atypical characteristics in this domain may be a &quot;core feature&quot; of autism spectrum disorder.</autism-rules:has_definition>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Social_Dependence_on_Others -->

    <owl:Class rdf:about="&autism-rules;Social_Dependence_on_Others">
        <rdfs:subClassOf rdf:resource="&autism-rules;Social_Interest"/>
        <autism-rules:has_definition rdf:datatype="&xsd;string">Requiring a high degree of attention from others, including being unable to act appropriately when left alone by caregiver.</autism-rules:has_definition>
        <autism-rules:has_definition_source rdf:datatype="&xsd;string">http://www.nlm.nih.gov/research/umls?cui=C0011548</autism-rules:has_definition_source>
    </owl:Class>
    


    <!-- http://purl.org/autism-ontology/1.0/autism-rules.owl#Social_Interest -->

