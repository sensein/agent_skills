                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ADMO#inflammation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>inflammatory process</rdfs:label>
    </owl:Class>
    


