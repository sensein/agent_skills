                <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_output"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/DMO#oxidized"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/DMO#polypeptidic_chain"/>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#conversion"/>
        <rdfs:label>oxidation</rdfs:label>
    </owl:Class>
    


