    <owl:Class rdf:about="http://www.semanticweb.org/DMO#transcription">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_input"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/DMO#gene"/>
