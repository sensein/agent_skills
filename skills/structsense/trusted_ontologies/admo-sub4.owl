                        <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_output"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ADMO#UnprocessedmRNA"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#composite_biochemical_process"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#genetic_production"/>
        <DMO:SBOref>SBO:0000183</DMO:SBOref>
        <rdfs:label>transcription</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/DMO#transfer -->

    <owl:Class rdf:about="http://www.semanticweb.org/DMO#transfer">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ADMO#protein-protein_complexation"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/DMO#dissociation"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ADMO#protein-protein_complexation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#dissociation"/>
        <rdfs:label>transfer of protein in complex</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/DMO#transfer_of_a_chemical_group -->

    <owl:Class rdf:about="http://www.semanticweb.org/DMO#transfer_of_a_chemical_group">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/DMO#addition_of_a_chemical_group"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/DMO#removal_of_a_chemical_group"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#addition_of_a_chemical_group"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#removal_of_a_chemical_group"/>
        <DMO:SBOref>SBO:0000402</DMO:SBOref>
        <rdfs:label>transfer of a chemical group</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/DMO#translation -->

    <owl:Class rdf:about="http://www.semanticweb.org/DMO#translation">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_input"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/DMO#mRNA"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_output"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ADMO#native_polypeptidic_chain"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#composite_biochemical_process"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_component_process"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ADMO#translation_component_process"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <DMO:SBOref>SBO:0000184</DMO:SBOref>
        <rdfs:label>translation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/DMO#translocation_reaction -->

    <owl:Class rdf:about="http://www.semanticweb.org/DMO#translocation_reaction">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/DMO#transport_reaction"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_output"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.semanticweb.org/DMO#polypeptidic_chain"/>
                                    <rdf:Description rdf:about="http://www.semanticweb.org/DMO#protein_complex"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#transport_reaction"/>
        <DMO:Alias>protein transport</DMO:Alias>
        <DMO:SBOref>SBO:0000185</DMO:SBOref>
        <rdfs:label>translocation reaction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/DMO#transport_reaction -->

    <owl:Class rdf:about="http://www.semanticweb.org/DMO#transport_reaction">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_mediator"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ADMO#membrane"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ADMO#biological_process"/>
        <DMO:SBOref>SBO:0000655</DMO:SBOref>
        <rdfs:label>transport reaction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/DMO#truncated -->

    <owl:Class rdf:about="http://www.semanticweb.org/DMO#truncated">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#in_modified_form"/>
        <DMO:from>mEPN</DMO:from>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">truncated</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/DMO#ubiquitinated -->

    <owl:Class rdf:about="http://www.semanticweb.org/DMO#ubiquitinated">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#converted_gene_product"/>
        <DMO:from>mEPN</DMO:from>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ubiquitinated</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/DMO#ubiquitination -->

    <owl:Class rdf:about="http://www.semanticweb.org/DMO#ubiquitination">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_input"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ADMO#UB_tetramere"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_output"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/DMO#ubiquitinated"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#addition_of_a_chemical_group"/>
        <DMO:SBOref>SBO:0000224</DMO:SBOref>
        <rdfs:label>ubiquitination</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/DMO#active%20transport -->

    <owl:Class rdf:about="http://www.semanticweb.org/DMO#active%20transport">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/DMO#transport_reaction"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_mediator"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/DMO#molecular_entity"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#transport_reaction"/>
        <DMO:SBOref>SBO:0000657</DMO:SBOref>
        <rdfs:label>active transport</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/DMO#halomer%20dissociation -->

    <owl:Class rdf:about="http://www.semanticweb.org/DMO#halomer%20dissociation">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_input"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/DMO#heteromer"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_output"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/DMO#gene_product"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_output"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/DMO#simple_chemical"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#molecular_interaction"/>
        <rdfs:label>protein-simple chemical dissociation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fromwhere#ALDH2 -->

    <owl:Class rdf:about="http://www.semanticweb.org/fromwhere#ALDH2">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ADMO#UnprocessedmRNA"/>
    </owl:Class>
    


