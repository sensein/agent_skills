    <!-- http://www.semanticweb.org/ADMO#cholesterol_synthesis -->

    <owl:Class rdf:about="http://www.semanticweb.org/ADMO#cholesterol_synthesis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#pathway"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_component_process"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ADMO#cholesterol_synthesis_process"/>
            </owl:Restriction>
        </rdfs:subClassOf>
