    <!-- http://www.semanticweb.org/DMO#agregated_process -->

    <owl:Class rdf:about="http://www.semanticweb.org/DMO#agregated_process">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_input"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.semanticweb.org/ADMO#unmaterial_participant"/>
                                    <rdf:Description rdf:about="http://www.semanticweb.org/DMO#physical_compartment"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_output"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.semanticweb.org/ADMO#unmaterial_participant"/>
                                    <rdf:Description rdf:about="http://www.semanticweb.org/DMO#physical_compartment"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ADMO#biological_process"/>
        <rdfs:isDefinedBy>Biological process that involved unspecified reactions and involved phenotypes.</rdfs:isDefinedBy>
        <rdfs:label>agregated biological process</rdfs:label>
    </owl:Class>
    


