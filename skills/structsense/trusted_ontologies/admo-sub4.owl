        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#pathway"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_component_process"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ADMO#apoptotic_process"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apoptosis</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ADMO#apoptotic_process -->

    <owl:Class rdf:about="http://www.semanticweb.org/ADMO#apoptotic_process">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_participant"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/ADMO#apoptosicSignal"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/ADMO#caspase"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#pathway_process"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#component_process_of"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ADMO#apoptosis"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>apoptosis process</rdfs:label>
    </owl:Class>
    


