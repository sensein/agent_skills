    <!-- http://www.semanticweb.org/ADMO#composite_complex%20dissociation -->

    <owl:Class rdf:about="http://www.semanticweb.org/ADMO#composite_complex%20dissociation">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_input"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ADMO#composite_complex"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_output"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ADMO#composite_complex"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_output"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.semanticweb.org/DMO#polypeptidic_chain"/>
                                    <rdf:Description rdf:about="http://www.semanticweb.org/DMO#simple_chemical"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ADMO#translation_component_process"/>
        <rdfs:label>composite complex modification</rdfs:label>
    </owl:Class>
    


