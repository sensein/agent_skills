    </owl:Class>
    


    <!-- http://www.semanticweb.org/ADMO#amyloidB_clearance_process -->

    <owl:Class rdf:about="http://www.semanticweb.org/ADMO#amyloidB_clearance_process">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_input"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ADMO#AmyloidB"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_mediator"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ADMO#membrane"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#pathway_process"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#transport_reaction"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#component_process_of"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ADMO#amyloidB_clearance"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">amyloidB clearance process</rdfs:label>
    </owl:Class>
    


