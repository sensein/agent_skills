vincent.henry[at]inria.fr
Olivier Colliot
olivier.colliot[at]sorbonne-universite.fr</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://scai.fraunhofer.de/NDDUO#Synonym -->

    <owl:AnnotationProperty rdf:about="http://scai.fraunhofer.de/NDDUO#Synonym"/>
    


    <!-- http://scai.fraunhofer.de/NDDUO#mapping -->

    <owl:AnnotationProperty rdf:about="http://scai.fraunhofer.de/NDDUO#mapping"/>
    


    <!-- http://www.semanticweb.org/ADMO#AlzPathId -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/ADMO#AlzPathId"/>
    


    <!-- http://www.semanticweb.org/ADMO#AlzPathReaction -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/ADMO#AlzPathReaction"/>
    


    <!-- http://www.semanticweb.org/DMO#Alias -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/DMO#Alias"/>
    


    <!-- http://www.semanticweb.org/DMO#GeneCards -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/DMO#GeneCards"/>
    


    <!-- http://www.semanticweb.org/DMO#KEGG -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/DMO#KEGG"/>
    


    <!-- http://www.semanticweb.org/DMO#Reactome -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/DMO#Reactome"/>
    


    <!-- http://www.semanticweb.org/DMO#SBOref -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/DMO#SBOref"/>
    


    <!-- http://www.semanticweb.org/DMO#UniGene -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/DMO#UniGene"/>
    


    <!-- http://www.semanticweb.org/DMO#UniProt -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/DMO#UniProt"/>
    


    <!-- http://www.semanticweb.org/DMO#Xref -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/DMO#Xref"/>
    


    <!-- http://www.semanticweb.org/DMO#from -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/DMO#from"/>
    


    <!-- http://www.semanticweb.org/DMO#pubchem -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/DMO#pubchem"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/ADMO#SNP_of -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ADMO#SNP_of">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/DMO#part_of"/>
        <rdfs:label>SNP of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/DMO#component_process_of -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/DMO#component_process_of">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/DMO#part_of"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="http://www.semanticweb.org/DMO#has_part"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/DMO#has_component_process"/>
        <rdfs:label>component process of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/DMO#derives_from -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/DMO#derives_from">
        <DMO:from>RO_0001000</DMO:from>
        <rdfs:label>derives from</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/DMO#has_SNP -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/DMO#has_SNP">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/DMO#has_part"/>
        <rdfs:label>has SNP</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/DMO#has_component_process -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/DMO#has_component_process">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/DMO#has_part"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="http://www.semanticweb.org/DMO#part_of"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <DMO:from>RO_0002018</DMO:from>
        <rdfs:label>has component process</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/DMO#has_input -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/DMO#has_input">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/DMO#has_participant"/>
        <DMO:from>RO_0002233</DMO:from>
        <rdfs:label>has input</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/DMO#has_mediator -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/DMO#has_mediator">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/DMO#has_participant"/>
        <rdfs:label>has mediator</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/DMO#has_molecular_component -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/DMO#has_molecular_component">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/DMO#has_part"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="http://www.semanticweb.org/DMO#part_of"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/DMO#molecular_component_of"/>
        <rdfs:label>has molecular component</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/DMO#has_output -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/DMO#has_output">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/DMO#has_participant"/>
        <DMO:from>RO_0002234</DMO:from>
        <rdfs:label>has output</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/DMO#has_part -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/DMO#has_part">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/DMO#part_of"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <DMO:from>BFO_0000051</DMO:from>
        <rdfs:label>has part</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/DMO#has_participant -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/DMO#has_participant">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/DMO#has_participant"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/DMO#derives_from"/>
        </owl:propertyChainAxiom>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/DMO#has_participant"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/DMO#has_molecular_component"/>
        </owl:propertyChainAxiom>
        <DMO:from>RO_0000057</DMO:from>
        <rdfs:label>has participant</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/DMO#has_template -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/DMO#has_template">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/DMO#derives_from"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/DMO#template_of"/>
        <rdfs:label>has template</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/DMO#input_of -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/DMO#input_of"/>
    


    <!-- http://www.semanticweb.org/DMO#mediates -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/DMO#mediates"/>
    


    <!-- http://www.semanticweb.org/DMO#molecular_component_of -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/DMO#molecular_component_of">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/DMO#part_of"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="http://www.semanticweb.org/DMO#has_part"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:label>molecular component of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/DMO#occurs_in -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/DMO#occurs_in">
        <DMO:from>BFO_0000066</DMO:from>
        <rdfs:label>occurs in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/DMO#output_of -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/DMO#output_of"/>
    


    <!-- http://www.semanticweb.org/DMO#part_of -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/DMO#part_of">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <DMO:from>BFO_0000050</DMO:from>
        <rdfs:label>part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/DMO#template_of -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/DMO#template_of">
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="http://www.semanticweb.org/DMO#derives_from"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:label>template of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://scai.fraunhofer.de/AlzheimerOntology#Abeta_RAGE_interaction -->

    <owl:Class rdf:about="http://scai.fraunhofer.de/AlzheimerOntology#Abeta_RAGE_interaction">
        <owl:equivalentClass rdf:resource="http://www.semanticweb.org/ADMO#re1321"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ADMO#protein-protein_complexation"/>
        <NDDUO:Synonym>Abeta-RAGE interactions</NDDUO:Synonym>
        <rdfs:comment>from manual annotation of text corpus</rdfs:comment>
        <rdfs:label>Abeta-RAGE interaction</rdfs:label>
    </owl:Class>
    


    <!-- http://scai.fraunhofer.de/AlzheimerOntology#Acetylation -->

    <owl:Class rdf:about="http://scai.fraunhofer.de/AlzheimerOntology#Acetylation">
        <owl:equivalentClass rdf:resource="http://www.semanticweb.org/DMO#acetylation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#addition_of_a_chemical_group"/>
        <NDDUO:Synonym>protein amino acid acetylation</NDDUO:Synonym>
        <rdfs:comment>AD594</rdfs:comment>
        <rdfs:label>Acetylation</rdfs:label>
    </owl:Class>
    


    <!-- http://scai.fraunhofer.de/AlzheimerOntology#Autophagy -->

    <owl:Class rdf:about="http://scai.fraunhofer.de/AlzheimerOntology#Autophagy">
        <owl:equivalentClass rdf:resource="http://www.semanticweb.org/ADMO#autophagy"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#pathway"/>
        <NDDUO:Synonym>autophagosome</NDDUO:Synonym>
        <NDDUO:Synonym>chaperone-mediated autophagy</NDDUO:Synonym>
        <NDDUO:mapping>http://purl.org/obo/owl/GO#GO_0006914</NDDUO:mapping>
        <rdfs:comment>AD473</rdfs:comment>
        <rdfs:label>Autophagy</rdfs:label>
    </owl:Class>
    


    <!-- http://scai.fraunhofer.de/AlzheimerOntology#Calcium_release -->

    <owl:Class rdf:about="http://scai.fraunhofer.de/AlzheimerOntology#Calcium_release">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#transport_reaction"/>
        <NDDUO:mapping>http://purl.org/obo/owl/GO#GO_0015278</NDDUO:mapping>
        <rdfs:comment>AD591</rdfs:comment>
        <rdfs:label>Calcium release</rdfs:label>
    </owl:Class>
    


    <!-- http://scai.fraunhofer.de/AlzheimerOntology#De_acetylations -->

    <owl:Class rdf:about="http://scai.fraunhofer.de/AlzheimerOntology#De_acetylations">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#removal_of_a_chemical_group"/>
        <NDDUO:Synonym>protein amino acid deacetylation</NDDUO:Synonym>
        <rdfs:comment>AD595</rdfs:comment>
        <rdfs:label>De-acetylation</rdfs:label>
    </owl:Class>
    


    <!-- http://scai.fraunhofer.de/AlzheimerOntology#De_methylation -->

    <owl:Class rdf:about="http://scai.fraunhofer.de/AlzheimerOntology#De_methylation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#removal_of_a_chemical_group"/>
        <rdfs:comment>AD596</rdfs:comment>
        <rdfs:label>De-methylation</rdfs:label>
    </owl:Class>
    


    <!-- http://scai.fraunhofer.de/AlzheimerOntology#Methylation -->

    <owl:Class rdf:about="http://scai.fraunhofer.de/AlzheimerOntology#Methylation">
        <owl:equivalentClass rdf:resource="http://www.semanticweb.org/DMO#methylation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#addition_of_a_chemical_group"/>
        <NDDUO:mapping>http://purl.org/obo/owl/GO#GO_0032259</NDDUO:mapping>
        <rdfs:comment>AD597</rdfs:comment>
        <rdfs:label>Methylation</rdfs:label>
    </owl:Class>
    


    <!-- http://scai.fraunhofer.de/AlzheimerOntology#Microglia_activation -->

    <owl:Class rdf:about="http://scai.fraunhofer.de/AlzheimerOntology#Microglia_activation">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_output"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ADMO#activatedMicroglia"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#agregated_process"/>
        <rdfs:label>Microglia activation</rdfs:label>
    </owl:Class>
    


    <!-- http://scai.fraunhofer.de/AlzheimerOntology#Neurite_growth -->

    <owl:Class rdf:about="http://scai.fraunhofer.de/AlzheimerOntology#Neurite_growth">
        <owl:equivalentClass rdf:resource="http://www.semanticweb.org/ADMO#neuriteOutgrouth"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#phenotype"/>
        <NDDUO:mapping>http://purl.org/obo/owl/GO#GO_0031175</NDDUO:mapping>
        <rdfs:comment>AD490</rdfs:comment>
        <rdfs:label>Neurite growth</rdfs:label>
    </owl:Class>
    


    <!-- http://scai.fraunhofer.de/AlzheimerOntology#Oxidative_stress -->

    <owl:Class rdf:about="http://scai.fraunhofer.de/AlzheimerOntology#Oxidative_stress">
        <owl:equivalentClass rdf:resource="http://www.semanticweb.org/ADMO#oxidativeStress"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#phenotype"/>
        <NDDUO:Synonym>oxidative damage</NDDUO:Synonym>
        <rdfs:comment>AD601</rdfs:comment>
        <rdfs:label>Oxidative stress</rdfs:label>
    </owl:Class>
    


    <!-- http://scai.fraunhofer.de/AlzheimerOntology#Protein_aggregation -->

    <owl:Class rdf:about="http://scai.fraunhofer.de/AlzheimerOntology#Protein_aggregation">
        <owl:equivalentClass rdf:resource="http://www.semanticweb.org/DMO#protein_aggregation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#molecular_interaction"/>
        <rdfs:comment>AD609</rdfs:comment>
        <rdfs:label>Protein aggregation</rdfs:label>
    </owl:Class>
    


    <!-- http://scai.fraunhofer.de/AlzheimerOntology#Protein_degradation -->

    <owl:Class rdf:about="http://scai.fraunhofer.de/AlzheimerOntology#Protein_degradation">
        <owl:equivalentClass rdf:resource="http://www.semanticweb.org/DMO#degradation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#biochemical_reaction"/>
        <NDDUO:Synonym>protein breakdown</NDDUO:Synonym>
        <NDDUO:Synonym>protein catabolism</NDDUO:Synonym>
        <NDDUO:Synonym>protein degradation</NDDUO:Synonym>
        <NDDUO:Synonym>proteolytic process</NDDUO:Synonym>
        <NDDUO:mapping>http://purl.org/obo/owl/GO#GO_0030163</NDDUO:mapping>
        <rdfs:comment>AD610</rdfs:comment>
        <rdfs:label>Protein degradation</rdfs:label>
    </owl:Class>
    


    <!-- http://scai.fraunhofer.de/AlzheimerOntology#Sumoylation -->

    <owl:Class rdf:about="http://scai.fraunhofer.de/AlzheimerOntology#Sumoylation">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_output"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/DMO#sumolayted"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#addition_of_a_chemical_group"/>
        <NDDUO:Synonym>SUMO-protein conjugation</NDDUO:Synonym>
        <NDDUO:Synonym>protein sumolation</NDDUO:Synonym>
        <NDDUO:Synonym>small ubiquitin-related protein 1 conjugation</NDDUO:Synonym>
        <NDDUO:Synonym>sumoylation</NDDUO:Synonym>
        <NDDUO:mapping>http://purl.org/obo/owl/GO#GO_0016925</NDDUO:mapping>
        <rdfs:comment>AD598</rdfs:comment>
        <rdfs:label>Sumoylation</rdfs:label>
    </owl:Class>
    


    <!-- http://scai.fraunhofer.de/AlzheimerOntology#Synaptic_release -->

    <owl:Class rdf:about="http://scai.fraunhofer.de/AlzheimerOntology#Synaptic_release">
        <owl:equivalentClass rdf:resource="http://www.semanticweb.org/ADMO#synaptic_vesicle_release"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#pathway"/>
        <rdfs:comment>AD503</rdfs:comment>
        <rdfs:label>Synaptic release</rdfs:label>
    </owl:Class>
    


    <!-- http://scai.fraunhofer.de/AlzheimerOntology#Transmitter_release -->

    <owl:Class rdf:about="http://scai.fraunhofer.de/AlzheimerOntology#Transmitter_release">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#transport_reaction"/>
        <NDDUO:Synonym>neurotransmitter release</NDDUO:Synonym>
        <rdfs:comment>AD618</rdfs:comment>
        <rdfs:label>Transmitter release</rdfs:label>
    </owl:Class>
    


    <!-- http://scai.fraunhofer.de/AlzheimerOntology#Ubiquitination -->

    <owl:Class rdf:about="http://scai.fraunhofer.de/AlzheimerOntology#Ubiquitination">
        <owl:equivalentClass rdf:resource="http://www.semanticweb.org/DMO#ubiquitination"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#addition_of_a_chemical_group"/>
        <rdfs:comment>AD629</rdfs:comment>
        <rdfs:label>Ubiquitination</rdfs:label>
    </owl:Class>
    


    <!-- http://scai.fraunhofer.de/AlzheimerOntology#amyloid_beta_deposition -->

    <owl:Class rdf:about="http://scai.fraunhofer.de/AlzheimerOntology#amyloid_beta_deposition">
        <owl:equivalentClass rdf:resource="http://www.semanticweb.org/ADMO#SenilePlaque"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#homomere"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#neo-non-covalent_complex"/>
        <NDDUO:Synonym>A beta-related neurotoxicity</NDDUO:Synonym>
        <NDDUO:Synonym>Amyloid Pathology</NDDUO:Synonym>
        <NDDUO:Synonym>Amyloid-beta depositions</NDDUO:Synonym>
        <NDDUO:Synonym>amyloid beta neurotoxicity</NDDUO:Synonym>
        <NDDUO:Synonym>amyloid fibrils</NDDUO:Synonym>
        <NDDUO:Synonym>amyloid pathology</NDDUO:Synonym>
        <NDDUO:Synonym>amyloid- deposition</NDDUO:Synonym>
        <NDDUO:Synonym>cerebral deposition of amyloid fibrils</NDDUO:Synonym>
        <NDDUO:Synonym>cerebral depositions of amyloid fibrils</NDDUO:Synonym>
        <rdfs:comment>from manual annotation of text corpus</rdfs:comment>
        <rdfs:label>Amyloid-beta deposition</rdfs:label>
    </owl:Class>
    


    <!-- http://scai.fraunhofer.de/AlzheimerOntology#apoptotic_signalling -->

    <owl:Class rdf:about="http://scai.fraunhofer.de/AlzheimerOntology#apoptotic_signalling">
        <owl:equivalentClass rdf:resource="http://www.semanticweb.org/ADMO#apoptosis"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#pathway"/>
        <rdfs:comment>from manual annotation of text corpus</rdfs:comment>
        <rdfs:label>apoptotic signalling</rdfs:label>
    </owl:Class>
    


    <!-- http://scai.fraunhofer.de/AlzheimerOntology#calcium_signalling -->

    <owl:Class rdf:about="http://scai.fraunhofer.de/AlzheimerOntology#calcium_signalling">
