    <!-- http://www.semanticweb.org/ADMO#amyloidB_clearance -->

    <owl:Class rdf:about="http://www.semanticweb.org/ADMO#amyloidB_clearance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#pathway"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_component_process"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ADMO#amyloidB_clearance_process"/>
            </owl:Restriction>
