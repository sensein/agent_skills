    <!-- http://www.semanticweb.org/ADMO#amyloidB_cleavage_process -->

    <owl:Class rdf:about="http://www.semanticweb.org/ADMO#amyloidB_cleavage_process">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_input"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.semanticweb.org/ADMO#APP"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#derives_from"/>
                                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ADMO#APP"/>
                                    </owl:Restriction>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_output"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/DMO#truncated"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#pathway_process"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#component_process_of"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ADMO#amyloidB_cleavage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">amyloidB cleavage process</rdfs:label>
    </owl:Class>
    


