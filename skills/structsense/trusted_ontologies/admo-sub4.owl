    </owl:Class>
    


    <!-- http://www.semanticweb.org/ADMO#cholesterol_synthesis_process -->

    <owl:Class rdf:about="http://www.semanticweb.org/ADMO#cholesterol_synthesis_process">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_input"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/DMO#simple_chemical"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_output"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.semanticweb.org/ADMO#cholesterol"/>
                                    <rdf:Description rdf:about="http://www.semanticweb.org/ADMO#cholesterol_precursor"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#pathway_process"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#component_process_of"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ADMO#cholesterol_synthesis"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cholesterol synthesis process</rdfs:label>
    </owl:Class>
    


