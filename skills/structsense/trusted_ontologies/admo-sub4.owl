    <!-- http://www.semanticweb.org/DMO#oligodemerisation -->

    <owl:Class rdf:about="http://www.semanticweb.org/DMO#oligodemerisation">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_input"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/DMO#homomere"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/DMO#has_output"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/DMO#polypeptidic_chain"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#dissociation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/DMO#non-covalent_binding"/>
        <rdfs:label>homomere dissociation</rdfs:label>
    </owl:Class>
    


