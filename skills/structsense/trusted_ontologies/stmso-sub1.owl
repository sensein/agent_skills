    <owl:Ontology rdf:about="https://bioportal.bioontology.org/ontologies/STMSO">
        <owl:versionIRI rdf:resource="https://bioportal.bioontology.org/ontologies/STMSO"/>
        <rdfs:comment>STMSO is an OWL 2 ontology for symptomatic treatment  for multiple sclrosis  patients. The ontology is based on BFO and OGMS.</rdfs:comment>
        <STMSO1:creator>Misagh Zahiri Esfahani</STMSO1:creator>
        <STMSO1:date rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2021</STMSO1:date>
    </owl:Ontology>
    


