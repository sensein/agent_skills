                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/STMSO#Invasive_ventilator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://bioportal.bioontology.org/ontologies/STMSO#Has_pharmacological_treatment"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/STMSO#Metaxalone"/>
