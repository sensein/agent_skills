                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/STMSO#Cognitive_rehabilitation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
