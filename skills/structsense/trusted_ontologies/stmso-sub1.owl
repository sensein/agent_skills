                <owl:onProperty rdf:resource="https://bioportal.bioontology.org/ontologies/STMSO#Has_nonpharmacological_treatment"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/STMSO#Assistive_devices"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://bioportal.bioontology.org/ontologies/STMSO#Has_nonpharmacological_treatment"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/STMSO#Exercise"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://bioportal.bioontology.org/ontologies/STMSO#Has_nonpharmacological_treatment"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/STMSO#Occupational_therapy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://bioportal.bioontology.org/ontologies/STMSO#Has_pharmacological_treatment"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/STMSO#Dalfampridine"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">weakness</rdfs:label>
        <STMSO1:definition>Weakness is a common symptom in multiple sclerosis. You may feel that you do not have enough strength or energy to move some or all of your limbs, or your whole body. Weakness and fatigue are closely linked and having one often makes the other symptoms worse.</STMSO1:definition>
    </owl:Class>
    


