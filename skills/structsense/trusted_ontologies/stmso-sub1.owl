                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/STMSO#Ventilator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>breathing problems</rdfs:label>
        <STMSO1:Synonyme>Respiration</STMSO1:Synonyme>
        <STMSO1:definition>breathing is primarily under the control of the autonomic or “automatic” nervous system — the part of the central nervous system that controls vital functions such as heartbeat and respiration without conscious thought. It is unusual for MS to affect the autonomic nervous system, and therefore uncommon for breathing problems to occur in MS as a direct result of loss of autonomic control.</STMSO1:definition>
    </owl:Class>
    


