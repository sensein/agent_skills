    <!-- https://bioportal.bioontology.org/ontologies/STMSO#Hearing_loss -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/STMSO#Hearing_loss">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/STMSO#Symptom"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://bioportal.bioontology.org/ontologies/STMSO#Has_referrals_to_specialists"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/STMSO#audiologist"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Hearing loss</rdfs:label>
        <STMSO1:definition>Hearing loss is an uncommon symptom of MS. About 6 percent of people who have MS complain of impaired hearing. The cause of hearing loss can be due to non-MS related issues but in MS, can be associated with damage to the hearing nerve pathways in the brain and the brainstem.</STMSO1:definition>
    </owl:Class>
    


