                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/STMSO#Getting_enough_sleep"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Cognitive Problems</rdfs:label>
        <STMSO1:definition>rdfs:isDefinedBy &quot;Problems with concentration/attention, memory impairment, poor word-finding ability, decreased information-processing speed, motor slowing and mental exhaustion. &quot;</STMSO1:definition>
