    <!-- https://bioportal.bioontology.org/ontologies/STMSO#Diplopia -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/STMSO#Diplopia">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/STMSO#Vision_Problems"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://bioportal.bioontology.org/ontologies/STMSO#Has_nonpharmacological_treatment"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/STMSO#Fresnel"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://bioportal.bioontology.org/ontologies/STMSO#Has_recommendation"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/STMSO#Resting_or_cooling_down_the_eye"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://bioportal.bioontology.org/ontologies/STMSO#Has_recommendation"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/STMSO#Short-term_patching_of_one_eye"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://bioportal.bioontology.org/ontologies/STMSO#Has_surgery"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/STMSO#Diplopia_surgery"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Double vision
A visual symptom in which a single object is perceived by the visual cortex as two objects rather than one. Disorders associated with this condition include REFRACTIVE ERRORS, STRABISMUS, OCULOMOTOR NERVE DISEASES, TROCHLEAR NERVE DISEASES, ABDUCENS NERVE DISEASES, and diseases of the BRAIN STEM and OCCIPITAL LOBE.</rdfs:comment>
    </owl:Class>
    


