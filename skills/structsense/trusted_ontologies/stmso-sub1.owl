            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Walking difficulties</rdfs:label>
        <STMSO1:definition>Ambulation Problems or Gait difficulties
Impairment of the ability to coordinate the movements required for normal ambulation (walking) which may result from impairments of motor function or sensory feedback. 
(Source: http://www.ncbi.nlm.nih.gov/mesh?term=gait%20ataxia )</STMSO1:definition>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/STMSO#Weakness -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/STMSO#Weakness">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/STMSO#Symptom"/>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/STMSOl#side_effect_of_drug"/>
