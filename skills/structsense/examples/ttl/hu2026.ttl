    ner:partOfDocumentVersion kb:a6a2cf3f-c89a-56c0-88fa-031f7afd0daa ;
    ner:sentenceText "The time of response onset was determined by application of fluorescein in the absence of fish and fine-adjusted based on neural activity measurements in each experiment." .

kb:dd29f9ee-3382-5357-9a46-3a36ed3ac302 a ner:Sentence ;
    rdfs:label "sentence 277" ;
    ner:partOfDocumentVersion kb:a6a2cf3f-c89a-56c0-88fa-031f7afd0daa ;
