kb:706e412d-754a-5f60-b257-2344836784fe a ner:Sentence ;
    rdfs:label "sentence 102" ;
    ner:partOfDocumentVersion kb:a6a2cf3f-c89a-56c0-88fa-031f7afd0daa ;
    ner:sentenceText "Classical models of autoassociative memory assume that pattern classification is based on convergent intrinsic attractor dynamics, which can map noisy variations of the same input onto a common, less variable output3–5." .

