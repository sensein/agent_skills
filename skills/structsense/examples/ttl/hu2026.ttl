kb:220c629f-3f8d-5831-a255-d3fa1d75fb28 a ner:Sentence ;
    rdfs:label "sentence 330" ;
    ner:partOfDocumentVersion kb:a6a2cf3f-c89a-56c0-88fa-031f7afd0daa ;
