kb:dea5244b-bc37-5c81-8dd0-99b6c30f948e a ner:Sentence ;
    rdfs:label "sentence 284" ;
    ner:partOfDocumentVersion kb:a6a2cf3f-c89a-56c0-88fa-031f7afd0daa ;
    ner:sentenceText "Hence, training did not substantially reduce trial-to-trial variability but slightly modified the similarity between odor-evoked activity patterns." .

