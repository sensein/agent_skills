kb:4a7545c0-e6f5-5f22-93e4-1633cb036612 a ner:Sentence ;
    rdfs:label "sentence 112" ;
    ner:partOfDocumentVersion kb:a6a2cf3f-c89a-56c0-88fa-031f7afd0daa ;
    ner:sentenceText "The formation of manifolds representing semantic categories is the basis for pattern classification by convolutional networks, which lack attractor dynamics by design14,61." .

