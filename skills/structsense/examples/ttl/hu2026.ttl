    rdfs:label "sentence 607" ;
    ner:partOfDocumentVersion kb:a6a2cf3f-c89a-56c0-88fa-031f7afd0daa ;
    ner:sentenceText "According to GLUE theory, capacity is affected by geometric measures including effective radius, dimension, and alignments." .

