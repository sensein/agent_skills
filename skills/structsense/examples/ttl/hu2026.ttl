    ner:partOfDocumentVersion kb:a6a2cf3f-c89a-56c0-88fa-031f7afd0daa ;
    ner:sentenceText "Upon silencing, membrane potentials and synaptic currents decayed nearly exponentially with time constants (membrane potential, 65 ± 23 ms; currents, 60 ± 21 ms) similar to the membrane time constant of pDp neurons (52 ± 16 ms; Extended Data Fig." .

kb:17886aaa-ad3a-52d3-95e5-92a5e4e26c92 a ner:Sentence ;
    rdfs:label "sentence 161" ;
    ner:partOfDocumentVersion kb:a6a2cf3f-c89a-56c0-88fa-031f7afd0daa ;
