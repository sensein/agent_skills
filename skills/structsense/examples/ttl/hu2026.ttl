kb:5da0de8e-1476-5610-a737-ddb59dd09d79 a ner:Sentence ;
    rdfs:label "sentence 25" ;
    ner:partOfDocumentVersion kb:a6a2cf3f-c89a-56c0-88fa-031f7afd0daa ;
    ner:sentenceText "Putative computational functions of representational manifolds The representation of sensory and semantic information by neural manifolds supports task-dependent pattern classification by facilitating access to relevant information." .

