kb:c34cb2ee-bd0e-5def-a47b-0d70c7222bba a ner:Sentence ;
    rdfs:label "Higher manifold capacity indicates greater discriminability, that is, a downs..." ;
    ner:partOfDocumentVersion kb:a6a2cf3f-c89a-56c0-88fa-031f7afd0daa ;
    ner:sentenceText "Higher manifold capacity indicates greater discriminability, that is, a downstream neuron, modeled as a linear sum followed by thresholding, can distinguish between manifolds by accessing a smaller number of upstream neurons." .

