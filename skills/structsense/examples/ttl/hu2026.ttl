kb:ee87e0dc-0807-5d28-be17-e0caef9bb308 a ner:Sentence ;
    rdfs:label "sentence 165" ;
    ner:partOfDocumentVersion kb:a6a2cf3f-c89a-56c0-88fa-031f7afd0daa ;
    ner:sentenceText "Interpretable changes in manifold capacity have recently been described also in brain areas of other species37." .

