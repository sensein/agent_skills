    ner:ontologyIRI <http://purl.obolibrary.org/obo/cl.owl> .
ex:onto-chebi a ner:ExternalOntology ; ner:ontologyAcronym "CHEBI" ;
    ner:ontologyIRI <http://purl.obolibrary.org/obo/chebi.owl> .
ex:onto-go a ner:ExternalOntology ; ner:ontologyAcronym "GO" ;
    ner:ontologyIRI <http://purl.obolibrary.org/obo/go.owl> .
ex:onto-nbo a ner:ExternalOntology ; ner:ontologyAcronym "NBO" ;
    ner:ontologyIRI <http://purl.obolibrary.org/obo/nbo.owl> .
