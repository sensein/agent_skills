##############################################################################
# 9. EXEMPLAR CAUSAL / ASSOCIATION RELATIONS
##############################################################################

# Training increases manifold capacity (experimental group comparison)
ex:rel-training-capacity a ner:CausalRelation ;
    ner:hasCause  ex:entity-odor-discrimination-learning ;
    ner:hasEffect ex:entity-manifold-capacity ;
    ner:hasCurrentCausalRelationVersion ex:rel-training-capacity-v1 .
ex:rel-training-capacity-v1 a ner:CausalRelationVersion ;
    ner:versionOfCausalRelation ex:rel-training-capacity ;
    ner:relationRevisionNumber 1 ;
    ner:causalNegated false ;
    ner:causalHypothetical false ;
    rdfs:comment "Manifold capacity significantly higher in trained vs naive fish across all training groups (juvenile and adult pDp); positive polarity; experimental evidence." .

# Manifold capacity predicts behavioral discrimination (association, r=0.56)
ex:rel-capacity-behavior a ner:CausalRelation ;
    ner:hasCause  ex:entity-manifold-capacity ;
    ner:hasEffect ex:entity-olfactory-behavior ;
    ner:hasCurrentCausalRelationVersion ex:rel-capacity-behavior-v1 .
ex:rel-capacity-behavior-v1 a ner:CausalRelationVersion ;
    ner:versionOfCausalRelation ex:rel-capacity-behavior ;
    ner:relationRevisionNumber 1 ;
    ner:causalNegated false ;
    ner:causalHypothetical true ;
    ner:hasEffectEstimate ex:est-capacity-behavior ;
    rdfs:comment "Correlational evidence (predictive, not interventional): capacity vs behavioral discrimination score in juvenile fish." .
ex:est-capacity-behavior a ner:EffectEstimate ;
    ner:effectMeasure "Pearson correlation (r)" ;
    ner:effectValue 0.56 ;
    ner:pValue 0.004 ;
    ner:sampleSize 25 .

