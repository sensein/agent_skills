##############################################################################
# Named-entity extraction of:
#   Hu B, Temiz NZ, Chou C-N, Rupprecht P, Meissner-Bernard C, Titze B,
#   Chung S, Friedrich RW. "Representational learning by optimization of
#   neural manifolds in an olfactory memory network."
#   Nature Neuroscience (2026). doi:10.1038/s41593-026-02429-3
#
# Instances conform to the BrainKB NER ontology
# (named_entity_ontology_biomedical_neuroscience_v2_3).
# Cross-ontology hooks:
#   - ner:resolvedToConcept -> ner:OntologyConcept (conceptIRI = OBO PURL)
#   - skos:exactMatch / skos:closeMatch / skos:relatedMatch asserted directly
#     on each ner:NamedEntity so the graph auto-connects to CL, UBERON, ZFA,
#     CHEBI, GO, NBO, OBI, NCBITaxon under standard SSSOM/OBO federation.
# All external IDs verified against EBI OLS4 (2026-09-24).
##############################################################################

########################  Source publication  ###############################

ex:publication a ner:Publication ;
    ner:doi   "10.1038/s41593-026-02429-3" ;
    ner:title "Representational learning by optimization of neural manifolds in an olfactory memory network" ;
    ner:hasDocumentVersion ex:docv1 .

ex:docv1 a ner:DocumentVersion ;
    ner:versionOfDocument ex:publication ;
    ner:mediaType "application/pdf" .

########################  Extraction provenance  ############################

ex:extraction-run-1 a ner:NERExtractionActivity ;
    ner:taskType "named entity recognition + concept mapping" ;
    ner:runIdentifier "hu2026-ner-v1" ;
    prov:wasAssociatedWith ex:agent-claude ;
    prov:used ex:docv1 .

ex:agent-claude a ner:LanguageModelAgent ;
    rdfs:label "Claude (Anthropic), OLS4-verified concept mapping" .

ex:snapshot-1 a ner:ExtractionSnapshot ;
    ner:snapshotOfDocumentVersion ex:docv1 ;
    prov:wasGeneratedBy ex:extraction-run-1 .

########################  External ontologies  ##############################

ex:onto-ncbitaxon a ner:ExternalOntology ; ner:ontologyAcronym "NCBITaxon" ;
    ner:ontologyIRI <http://purl.obolibrary.org/obo/ncbitaxon.owl> .
ex:onto-uberon a ner:ExternalOntology ; ner:ontologyAcronym "UBERON" ;
    ner:ontologyIRI <http://purl.obolibrary.org/obo/uberon.owl> .
