    <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/Identifier"/>
    <rdfs:label xml:lang="en">agent identifier</rdfs:label>
    <bkr:dataciteMapping>nameIdentifier (ORCID, ROR, ISNI)</bkr:dataciteMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/bridge/brainkb/hasEvidenceItem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/bridge/brainkb/EvidenceLine"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/bridge/brainkb/EvidenceItem"/>
    <rdfs:label xml:lang="en">has evidence item</rdfs:label>
    <bkr:assertionEvidenceAlignment>EvidenceLine.has_evidence_item</bkr:assertionEvidenceAlignment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/IOSpecification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">input/output specification</rdfs:label>
    <skos:definition xml:lang="en">A description of one thing a resource expects to be given or undertakes to return: its role, format, schema, modality, cardinality and whether it is required. The information a reuser needs to decide whether their data can be fed in and whether the output can be consumed downstream.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/isPartOfResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:label xml:lang="en">is part of resource</rdfs:label>
    <bkr:dataciteMapping>relationType=IsPartOf</bkr:dataciteMapping>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/isPartOf"/>
    <bkr:schemaAlignment>schema:isPartOf</bkr:schemaAlignment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/relation-type/">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dcterms:title xml:lang="en">DataCite relationType</dcterms:title>
    <skos:scopeNote xml:lang="en">The 39 relation types used on bkr:ResourceRelation.</skos:scopeNote>
    <rdfs:seeAlso rdf:resource="https://schema.datacite.org/meta/kernel-4.7/include/datacite-relationType-v4.xsd"/>
  </rdf:Description>
