  <rdf:Description rdf:about="https://brainkb.org/resource/UsageExample">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">usage example</rdfs:label>
    <skos:definition xml:lang="en">A concrete worked demonstration of using the resource: a command line, code snippet, notebook, tutorial or published analysis that a reuser can follow or adapt.</skos:definition>
    <bkr:designNote xml:lang="en">Distinct from bkr:ResourceUse, which is a recorded application that happened inside a provenance graph. A usage example is documentation; a resource use is evidence.</bkr:designNote>
