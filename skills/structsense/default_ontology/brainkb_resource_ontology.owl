    <rdfs:domain rdf:resource="https://brainkb.org/resource/IOSpecification"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">input/output modality</rdfs:label>
    <skos:note xml:lang="en">Values from the modality vocabulary.</skos:note>
  </rdf:Description>
