    <skos:notation>Tools</skos:notation>
    <bkr:instantiatesClass rdf:resource="https://schema.org/SoftwareApplication"/>
    <skos:broadMatch rdf:resource="https://brainkb.org/resource/extracted-type/tool"/>
    <skos:definition xml:lang="en">Software offered for reuse. Typed schema:SoftwareApplication rather than a BKR class.</skos:definition>
  </rdf:Description>
