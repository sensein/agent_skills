  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/DUO_0000017">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/source-category/plasmids">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/source-category/"/>
    <skos:prefLabel xml:lang="en">Plasmids</skos:prefLabel>
    <skos:notation>Plasmids</skos:notation>
    <bkr:instantiatesClass rdf:resource="https://brainkb.org/resource/MaterialCollection"/>
    <skos:broadMatch rdf:resource="https://brainkb.org/resource/extracted-type/material_collection"/>
    <skos:definition xml:lang="en">A physical construct distributed for reuse, typically through a plasmid repository.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/access-level/embargoed">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/access-level/"/>
    <skos:prefLabel xml:lang="en">embargoed</skos:prefLabel>
    <skos:definition xml:lang="en">Will become available after bkr:embargoEndDate.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/scope-dimension/measured_variable">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/scope-dimension/"/>
    <skos:prefLabel xml:lang="en">measured variable</skos:prefLabel>
    <skos:definition xml:lang="en">Behavioural, physiological or environmental quantity.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/Schema">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/Standard"/>
    <rdfs:label xml:lang="en">schema</rdfs:label>
    <skos:definition xml:lang="en">A formal specification of the structure, types and constraints that conforming data or metadata must satisfy.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/assumptionAboutParameter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Assumption"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/ParameterSetting"/>
    <rdfs:label xml:lang="en">assumption about parameter</rdfs:label>
  </rdf:Description>
