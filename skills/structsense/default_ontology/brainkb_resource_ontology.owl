  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lifecycle-status/planned">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/lifecycle-status/"/>
    <skos:prefLabel xml:lang="en">planned</skos:prefLabel>
    <skos:definition xml:lang="en">Announced or committed to, not yet built.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/availability-status/limited">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/availability-status/"/>
