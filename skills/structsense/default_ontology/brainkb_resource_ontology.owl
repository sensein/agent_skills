    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
    <rdfs:label xml:lang="en">has feature of interest</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/date-type/Available">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/date-type/"/>
    <skos:prefLabel xml:lang="en">Available</skos:prefLabel>
    <skos:notation>Available</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/identifier-type/ISBN">
