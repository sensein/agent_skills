    <bkr:instantiatesClass rdf:resource="https://brainkb.org/resource/Schema"/>
    <skos:broadMatch rdf:resource="https://brainkb.org/resource/extracted-type/schema"/>
    <skos:definition xml:lang="en">A file or data format specification. Typed bkr:Schema: a format is the schema a distribution conforms to.</skos:definition>
  </rdf:Description>
