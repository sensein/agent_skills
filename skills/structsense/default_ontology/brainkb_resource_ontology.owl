    <rdfs:seeAlso rdf:resource="https://schema.datacite.org/meta/kernel-4.7/include/datacite-titleType-v4.xsd"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/SoftwareResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/DigitalResource"/>
    <rdfs:label xml:lang="en">software resource</rdfs:label>
    <skos:definition xml:lang="en">Executable or source-level software offered for reuse: a library, an application, a pipeline or a notebook.</skos:definition>
    <bkr:dataciteMapping>resourceTypeGeneral=Software</bkr:dataciteMapping>
    <bkr:structsenseField>type=Tool</bkr:structsenseField>
    <rdfs:seeAlso rdf:resource="http://rdf.webofcode.org/woc/Project"/>
    <bkr:nerAlignment rdf:resource="https://brainkb.org/ner/SoftwareEntity"/>
    <skos:closeMatch rdf:resource="https://schema.org/SoftwareApplication"/>
    <bkr:schemaAlignment>schema:SoftwareApplication</bkr:schemaAlignment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lifesci/appliesToCellType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://brainkb.org/resource/appliesToConcept"/>
