    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/StatisticalAssumption"/>
    <rdfs:label xml:lang="en">independence assumption</rdfs:label>
    <skos:example xml:lang="en">Cells are independent samples, i.e. donor effects are ignorable.</skos:example>
  </rdf:Description>
