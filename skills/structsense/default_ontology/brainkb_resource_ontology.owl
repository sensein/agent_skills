  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/InfrastructureResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/Resource/Resource"/>
    <rdfs:label xml:lang="en">infrastructure resource</rdfs:label>
    <skos:definition xml:lang="en">Compute, storage, network or facility capacity that other activities consume.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/maintainer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasAttributedTo"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <rdfs:label xml:lang="en">maintainer</rdfs:label>
    <skos:definition xml:lang="en">Agent currently responsible for keeping the resource usable and up to date.</skos:definition>
    <bkr:schemaAlignment>schema:maintainer</bkr:schemaAlignment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/license">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
