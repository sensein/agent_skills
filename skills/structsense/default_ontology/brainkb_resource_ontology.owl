    <skos:inScheme rdf:resource="https://brainkb.org/resource/evidence-level/"/>
    <skos:prefLabel xml:lang="en">extracted from text</skos:prefLabel>
    <skos:definition xml:lang="en">Read out of prose by an extraction pipeline; not confirmed by a human.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/access-level/restricted_by_agreement">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/access-level/"/>
    <skos:prefLabel xml:lang="en">restricted by agreement</skos:prefLabel>
    <skos:definition xml:lang="en">Requires a signed data use or material transfer agreement.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/change-type/modification">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/change-type/"/>
    <skos:prefLabel xml:lang="en">modification</skos:prefLabel>
    <skos:definition xml:lang="en">Existing content changed in place.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/extracted-type/model">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/extracted-type/"/>
    <skos:prefLabel xml:lang="en">Model</skos:prefLabel>
    <skos:definition xml:lang="en">A fitted or specified model distributed for reuse, including trained classifiers and foundation models.</skos:definition>
    <bkr:instantiatesClass rdf:resource="https://brainkb.org/resource/ComputationalModel"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/TechnicalAssumption">
