    <skos:notation>ROR</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lifecycle-status/in_development">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/lifecycle-status/"/>
    <skos:prefLabel xml:lang="en">in development</skos:prefLabel>
    <skos:definition xml:lang="en">Under active construction; interfaces and content may change without notice.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lifesci/data-modality/">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dcterms:title xml:lang="en">data modality</dcterms:title>
    <skos:scopeNote xml:lang="en">Broad measurement modality, for scope statements where no single assay term applies.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/relatedItemType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/ResourceRelation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">related item type</rdfs:label>
    <bkr:dataciteMapping>@relatedItemType</bkr:dataciteMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lifesci/appliesToCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://brainkb.org/resource/appliesToConcept"/>
    <bkr:scopeDimensionLabel>condition</bkr:scopeDimensionLabel>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/ApplicabilityScope"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">applies to condition</rdfs:label>
    <skos:definition xml:lang="en">Disease or phenotypic condition in scope, as a MONDO or HP term.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lifesci/appliesToTaxon">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://brainkb.org/resource/appliesToConcept"/>
    <bkr:scopeDimensionLabel>taxon</bkr:scopeDimensionLabel>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/ApplicabilityScope"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">applies to taxon</rdfs:label>
    <skos:definition xml:lang="en">Species or higher taxon the resource applies to, as an NCBITaxon term.</skos:definition>
    <bkr:structsenseField>mapped_specific_target_concept (NCBITaxon)</bkr:structsenseField>
    <bkr:designNote xml:lang="en">OBO term IRIs are used in scope metadata as skos:Concept individuals. OWL 2 permits class/individual punning, but the class hierarchy and the SKOS-individual view have separate direct-semantics interpretations; do not assume an OWL subclass axiom automatically entails a SKOS broader/narrower relation.</bkr:designNote>
    <bkr:nerAlignment rdf:resource="https://brainkb.org/ner/Species"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/GeoLocation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://purl.org/dc/terms/Location"/>
    <rdfs:label xml:lang="en">geolocation (legacy BKR alias)</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <dcterms:isReplacedBy rdf:resource="http://purl.org/dc/terms/Location"/>
    <bkr:dataciteMapping>resource/geoLocations/geoLocation</bkr:dataciteMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/bridge/brainkb/evidenceItemDocument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/bridge/brainkb/EvidenceItem"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/IAO_0000310"/>
    <rdfs:label xml:lang="en">evidence item document</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#hadPrimarySource"/>
    <bkr:assertionEvidenceAlignment>EvidenceItem.reference</bkr:assertionEvidenceAlignment>
    <skos:note xml:lang="en">For a versioned source use ner:DocumentVersion and ner:versionOfDocument, so the evidence survives the document being revised.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/ResourceVersion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:label xml:lang="en">resource version</rdfs:label>
    <skos:definition xml:lang="en">One identifiable version of a resource, with its own identifier, dates, distribution and provenance.</skos:definition>
    <bkr:dataciteMapping>resource/version</bkr:dataciteMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/identifier-type/PURL">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/identifier-type/"/>
    <skos:prefLabel xml:lang="en">PURL</skos:prefLabel>
    <skos:notation>PURL</skos:notation>
    <bkr:reuseNote xml:lang="en">No published datacite: scheme individual for this identifier type; minted by BKR.</bkr:reuseNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/FundingReference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">funding reference</rdfs:label>
    <bkr:dataciteMapping>resource/fundingReferences/fundingReference</bkr:dataciteMapping>
    <skos:closeMatch rdf:resource="https://schema.org/MonetaryGrant"/>
    <skos:closeMatch rdf:resource="https://schema.org/Grant"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/relation-type/IsVariantFormOf">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/relation-type/"/>
    <skos:prefLabel xml:lang="en">IsVariantFormOf</skos:prefLabel>
    <skos:notation>IsVariantFormOf</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/modality/image">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/modality/"/>
    <skos:prefLabel xml:lang="en">image</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/OntologyResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/TerminologyResource"/>
    <rdfs:label xml:lang="en">ontology resource</rdfs:label>
    <skos:definition xml:lang="en">An axiomatised terminology catalogued as a reusable resource.</skos:definition>
    <skos:closeMatch rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <skos:closeMatch rdf:resource="https://brainkb.org/ner/OntologyReference"/>
    <bkr:reuseNote xml:lang="en">Deliberately NOT owl:Ontology rdfs:subClassOf bkr:TerminologyResource. owl:Ontology states that a document is an OWL ontology — including every schema and shapes file in a graph — whereas this class states that an ontology has been catalogued for reuse. An instance is typically both: typed owl:Ontology by its own header and bkr:OntologyResource by its catalogue record.</bkr:reuseNote>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <dcterms:isReplacedBy rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <skos:note xml:lang="en">Use owl:Ontology directly; add bkr:Resource when catalogued.</skos:note>
  </rdf:Description>
