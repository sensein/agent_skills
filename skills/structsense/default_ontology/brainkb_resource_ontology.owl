    <bkr:dataciteMapping>@identifierType</bkr:dataciteMapping>
    <skos:note xml:lang="en">Values from &lt;https://brainkb.org/resource/identifier-type/&gt;, which includes DOI, Handle, RRID, ARK, PMID, SWHID, URL and the rest of the DataCite relatedIdentifierType list.</skos:note>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/spar/datacite/usesIdentifierScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/relationTypeInformation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/ResourceRelation"/>
