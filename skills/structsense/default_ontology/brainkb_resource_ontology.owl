    <rdfs:isDefinedBy rdf:resource="http://xmlns.com/foaf/0.1/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/agentVersion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://brainkb.org/ner/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/Validation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/ResourceLifecycleActivity"/>
    <rdfs:label xml:lang="en">validation</rdfs:label>
    <skos:definition xml:lang="en">An activity that tests whether a resource performs as claimed, under stated conditions.</skos:definition>
    <skos:closeMatch rdf:resource="https://brainkb.org/ner/ValidationReport"/>
    <skos:note xml:lang="en">The NER term is the report (an artifact); bkr:Validation is the activity that produces one.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://schema.org/SoftwareSourceCode">
    <bkr:reuseNote xml:lang="en">Use schema:SoftwareSourceCode directly for version-controlled source; add BKR resource typing only to catalogued instances.</bkr:reuseNote>
    <skos:closeMatch rdf:resource="http://rdf.webofcode.org/woc/Project"/>
    <skos:closeMatch rdf:resource="https://brainkb.org/ner/CodeVersion"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/ResourceRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">resource relation</rdfs:label>
    <skos:definition xml:lang="en">A reified, typed link from one resource to another resource or identifier, using the DataCite relationType vocabulary. Reification lets the link itself carry provenance — who asserted it and on what evidence.</skos:definition>
    <bkr:dataciteMapping>resource/relatedIdentifiers/relatedIdentifier</bkr:dataciteMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/ioModality">
