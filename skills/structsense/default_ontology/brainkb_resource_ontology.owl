  <rdf:Description rdf:about="http://www.w3.org/ns/dcat#CatalogRecord">
    <bkr:reuseNote xml:lang="en">Use directly for the metadata record about a resource, distinct from the resource. BKR attaches record-level properties without globally changing the DCAT class hierarchy.</bkr:reuseNote>
    <bkr:designNote xml:lang="en">prov:wasGeneratedBy on the record points at the curation or extraction run; prov:wasGeneratedBy on the resource points at the science that produced the resource.</bkr:designNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
