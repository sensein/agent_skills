    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/DigitalResource"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000310"/>
    <rdfs:label xml:lang="en">documentation</rdfs:label>
    <skos:definition xml:lang="en">User-facing documentation of a resource: a manual, README, tutorial or release note.</skos:definition>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <dcterms:isReplacedBy rdf:resource="http://purl.obolibrary.org/obo/IAO_0000310"/>
    <skos:note xml:lang="en">Use the IAO document class directly; add bkr:Resource to an instance only when catalogued.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/checksumAlgorithm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">checksum algorithm</rdfs:label>
    <bkr:bicanAlignment>bican:checksum.checksum algorithm</bkr:bicanAlignment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/Project">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:label xml:lang="en">project</rdfs:label>
    <skos:definition xml:lang="en">A bounded body of work with its own aims, agents, funding and outputs. Modelled as an activity so that the resources it produces and consumes are plain PROV generation and usage.</skos:definition>
    <bkr:dataciteMapping>resourceTypeGeneral=Project</bkr:dataciteMapping>
    <bkr:designNote xml:lang="en">When a project must itself be cited (DataCite resourceTypeGeneral=Project), catalogue its dcat:CatalogRecord and link the record to the activity with bkr:describesActivity rather than typing the project as a bkr:Resource.</bkr:designNote>
    <skos:closeMatch rdf:resource="https://schema.org/ResearchProject"/>
    <skos:closeMatch rdf:resource="https://brain-bbqs.org/vocab/Project"/>
    <skos:note xml:lang="en">schema.org treats a project as an organisation-like thing; BKR treats it as a prov:Activity. Reading a BBQS project into BKR therefore maps its descriptive fields to a dcat:CatalogRecord with bkr:describesActivity, and its outputs to bkr:producedResource.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/ReferenceAssumption">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/Assumption"/>
    <rdfs:label xml:lang="en">reference assumption</rdfs:label>
    <skos:definition xml:lang="en">An assumption that a particular reference resource — atlas version, taxonomy version, genome annotation — is the correct frame of reference.</skos:definition>
  </rdf:Description>
