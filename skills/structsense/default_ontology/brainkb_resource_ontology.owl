  <rdf:Description rdf:about="https://brainkb.org/resource/ResourceWithdrawal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/ResourceLifecycleActivity"/>
