    <bkr:reuseNote xml:lang="en">No published datacite: scheme individual for this identifier type; minted by BKR.</bkr:reuseNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/bridge/brainkb/evidenceItemMention">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://brainkb.org/resource/evidencedByMention"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/bridge/brainkb/EvidenceItem"/>
    <rdfs:range rdf:resource="https://brainkb.org/ner/EntityMention"/>
    <rdfs:label xml:lang="en">evidence item mention</rdfs:label>
    <skos:definition xml:lang="en">The text anchor of a text-derived evidence item: an entity mention carrying its own span, sentence, offsets and salience.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/Consortium">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Organization"/>
    <rdfs:label xml:lang="en">consortium</rdfs:label>
    <skos:definition xml:lang="en">A federation of institutions and projects operating under a shared programme, such as BICAN.</skos:definition>
    <skos:closeMatch rdf:resource="https://brain-bbqs.org/vocab/Consortium"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/availabilityStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">availability status</rdfs:label>
    <skos:note xml:lang="en">Values from &lt;https://brainkb.org/resource/availability-status/&gt;: available, limited, exhausted, offline, planned.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/dcat#Resource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/io-role/report">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/io-role/"/>
    <skos:prefLabel xml:lang="en">report</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/hasEvidenceLine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/ResourceAssertion"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/SEPIO_0000002"/>
    <rdfs:label xml:lang="en">has evidence line</rdfs:label>
    <skos:definition xml:lang="en">An independent argument for or against the assertion, in the sense of SEPIO.</skos:definition>
    <bkr:assertionEvidenceAlignment>Assertion.has_evidence_line</bkr:assertionEvidenceAlignment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/checksumValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">checksum value</rdfs:label>
    <bkr:bicanAlignment>bican:checksum.value</bkr:bicanAlignment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/resource-type/PeerReview">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/resource-type/"/>
    <skos:prefLabel xml:lang="en">PeerReview</skos:prefLabel>
    <skos:notation>PeerReview</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/criticality/moderate">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/criticality/"/>
    <skos:prefLabel xml:lang="en">moderate</skos:prefLabel>
    <skos:definition xml:lang="en">Results are degraded or biased if the assumption fails.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lifesci/appliesToTaxonomyNode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://brainkb.org/resource/appliesToConcept"/>
    <bkr:scopeDimensionLabel>taxonomy node</bkr:scopeDimensionLabel>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/ApplicabilityScope"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">applies to taxonomy node</rdfs:label>
    <skos:definition xml:lang="en">Node of a versioned cell type taxonomy, where the relevant unit is a taxonomy cluster rather than a CL class.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/migrationGuidance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:label xml:lang="en">migration guidance</rdfs:label>
    <skos:definition xml:lang="en">What users of a deprecated or superseded resource should do instead.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/funder-identifier-type/">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dcterms:title xml:lang="en">DataCite funderIdentifierType</dcterms:title>
    <skos:scopeNote xml:lang="en">Funder identifier schemes.</skos:scopeNote>
    <rdfs:seeAlso rdf:resource="https://schema.datacite.org/meta/kernel-4.7/include/datacite-funderIdentifierType-v4.xsd"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/relatedResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/ResourceRelation"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:label xml:lang="en">related resource</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/hasAvailableCapacity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://ontology.eil.utoronto.ca/icity/Resource/hasAvailableCapacity"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:label xml:lang="en">has available capacity</rdfs:label>
    <bkr:icityAlignment rdf:resource="http://ontology.eil.utoronto.ca/icity/Resource/hasAvailableCapacity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/evidence-level/">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dcterms:title xml:lang="en">BRPO scope evidence level</dcterms:title>
    <skos:scopeNote xml:lang="en">Strength of the basis for an applicability-scope claim. Ordered from weakest to strongest; a catalogue can require at least documented-in-publication before advertising a scope.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/usage-role/compute_allocation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/usage-role/"/>
    <skos:prefLabel xml:lang="en">compute allocation</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/resolution-route/">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dcterms:title xml:lang="en">Identifier resolution route</dcterms:title>
    <skos:scopeNote xml:lang="en">How a resource identifier was resolved: straight to the authoritative repository when the accession prefix is known, via DataCite Commons when it is not, via a generic resolver, or by hand.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/ssn/System">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/ssn/"/>
    <rdfs:label xml:lang="en">system</rdfs:label>
    <skos:note xml:lang="en">A unit of infrastructure implementing one or more procedures: the class for a catalogued instrument instance.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/brain-bican">
    <rdfs:isDefinedBy rdf:resource="https://github.com/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/scope-dimension/analytical_task">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/scope-dimension/"/>
    <skos:prefLabel xml:lang="en">analytical task</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/ServiceResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:label xml:lang="en">service resource</rdfs:label>
    <skos:definition xml:lang="en">A resource offered as an operated, continuously available service rather than a downloadable object: a portal, an API, a knowledge base, a registry.</skos:definition>
    <bkr:dataciteMapping>resourceTypeGeneral=Service</bkr:dataciteMapping>
    <skos:closeMatch rdf:resource="https://schema.org/Service"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/title-type/Other">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/title-type/"/>
    <skos:prefLabel xml:lang="en">Other</skos:prefLabel>
    <skos:notation>Other</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/mapping-method/llm_judgment">
    <skos:closeMatch rdf:resource="https://w3id.org/semapv/vocab/UnspecifiedMatching"/>
    <skos:note xml:lang="en">A language-model judgement is not a tool lookup. Catalogue policy forbids publishing an ontology IRI on this basis alone; the mapping decision stays at ner:/mapping-status/proposed until a retrieval method or a human review confirms it.</skos:note>
    <rdfs:isDefinedBy rdf:resource="https://brainkb.org/ner/mapping-method/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/source-category/data_archives_and_repositories">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/source-category/"/>
    <skos:prefLabel xml:lang="en">Data Archives &amp; Repositories</skos:prefLabel>
    <skos:notation>Data Archives &amp; Repositories</skos:notation>
    <bkr:instantiatesClass rdf:resource="https://brainkb.org/resource/Archive"/>
    <skos:broadMatch rdf:resource="https://brainkb.org/resource/extracted-type/archive"/>
    <skos:definition xml:lang="en">An archive or repository that holds deposited resources.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/ssn/implements">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/ssn/"/>
    <rdfs:label xml:lang="en">implements</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/MachineLearningModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/ComputationalModel"/>
    <rdfs:label xml:lang="en">machine learning model</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/bridge/brainkb/extractionAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasAssociatedWith"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/AutomatedExtraction"/>
    <rdfs:range rdf:resource="https://brainkb.org/ner/PipelineAgent"/>
    <rdfs:label xml:lang="en">extraction agent</rdfs:label>
    <skos:note xml:lang="en">Model identity goes on the agent or the ner:ModelArtifact with ner:modelName, ner:modelVersion, ner:modelProvider and ner:agentVersion — the resource ontology does not define its own model-identifier property.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/resolvesToResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/ner/NamedEntity"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:label xml:lang="en">resolves to resource</rdfs:label>
    <skos:definition xml:lang="en">Canonical named-entity resolution against the resource catalogue: a document-independent ner:NamedEntity is resolved to the registered dataset, tool, atlas, model or other BKR resource that it denotes.</skos:definition>
    <skos:note xml:lang="en">This property is intentionally independent of bkr:describedByMention. A NamedEntity may aggregate multiple EntityMention spans, so reversing a mention-level relation is not equivalent to canonical entity resolution.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/date-type/Copyrighted">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/date-type/"/>
    <skos:prefLabel xml:lang="en">Copyrighted</skos:prefLabel>
    <skos:notation>Copyrighted</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/description-type/Methods">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/description-type/"/>
    <skos:prefLabel xml:lang="en">Methods</skos:prefLabel>
    <skos:notation>Methods</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/partOfProgram">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Project"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/Program"/>
    <rdfs:label xml:lang="en">part of program</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/Archive">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/ServiceResource"/>
    <rdfs:label xml:lang="en">archive</rdfs:label>
    <skos:altLabel xml:lang="en">repository</skos:altLabel>
    <skos:definition xml:lang="en">A curated, persistently operated store that others deposit resources into and retrieve them from, with its own accession scheme, submission policy and retention commitment.</skos:definition>
    <skos:note xml:lang="en">An archive is a resource in its own right and also the thing an identifier resolves through; use bkr:depositedIn to point a resource at the archive holding it, and bkr:accessionScheme for the identifier scheme it issues.</skos:note>
    <bkr:dataciteMapping>resourceTypeGeneral=Service</bkr:dataciteMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/OutOfScope">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/ApplicabilityScope"/>
    <rdfs:label xml:lang="en">out of scope</rdfs:label>
    <skos:definition xml:lang="en">An explicit statement of non-applicability: material or conditions for which the resource is known or declared not to work.</skos:definition>
    <bkr:designNote xml:lang="en">Recording negative scope is as useful as positive scope and cannot be inferred from its absence.</bkr:designNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/modality/audio">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/modality/"/>
    <skos:prefLabel xml:lang="en">audio</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/resolution-status/not_found">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/resolution-status/"/>
    <skos:prefLabel xml:lang="en">not found</skos:prefLabel>
    <skos:notation>not_found</skos:notation>
    <skos:definition xml:lang="en">The source has no record for this identifier. The identifier is kept with this status rather than deleted: a paper did cite it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/ioName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/IOSpecification"/>
    <rdfs:label xml:lang="en">input/output name</rdfs:label>
    <skos:definition xml:lang="en">Parameter, port or slot name as the resource's own documentation calls it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/ssn/hasSubSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/ssn/"/>
    <rdfs:label xml:lang="en">has subsystem</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lifesci/hasDataUseModifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/lifesci/DataUseCondition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">has data use modifier</rdfs:label>
    <bkr:duoAlignment rdf:resource="http://purl.obolibrary.org/obo/DUO_0000017"/>
    <skos:note xml:lang="en">A DUO data use modifier term, e.g. obo:DUO_0000019 (publication required), obo:DUO_0000021 (ethics approval required), obo:DUO_0000046 (non-commercial use only), obo:DUO_0000024 (publication moratorium).</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/awardURI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/FundingReference"/>
    <rdfs:label xml:lang="en">award URI</rdfs:label>
    <bkr:dataciteMapping>@awardURI</bkr:dataciteMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/TerminologyResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/DigitalResource"/>
    <rdfs:label xml:lang="en">terminology resource</rdfs:label>
    <skos:definition xml:lang="en">A structured set of terms and their relations used to annotate other resources: an ontology, a controlled vocabulary, a nomenclature or a taxonomy.</skos:definition>
    <bkr:nerAlignment rdf:resource="https://brainkb.org/ner/OntologyReference"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/contributor-role/ProjectMember">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/contributor-role/"/>
    <skos:prefLabel xml:lang="en">ProjectMember</skos:prefLabel>
    <skos:notation>ProjectMember</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/locn#geographicName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semapv/vocab/EmbeddingBasedMatching">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/semapv/vocab/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/relation-type/IsPreviousVersionOf">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/relation-type/"/>
    <skos:prefLabel xml:lang="en">IsPreviousVersionOf</skos:prefLabel>
    <skos:notation>IsPreviousVersionOf</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/io-role/primary_data">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/io-role/"/>
    <skos:prefLabel xml:lang="en">primary data</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/appliesToTopic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://brainkb.org/resource/appliesToConcept"/>
    <rdfs:label xml:lang="en">applies to topic</rdfs:label>
    <skos:definition xml:lang="en">Research topic or subject area the resource is about, as a concept. The scope-side counterpart of bkr:hasSubject, which carries the keyword as given.</skos:definition>
    <bkr:scopeDimensionLabel>topic</bkr:scopeDimensionLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/identifier-type/LSID">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/identifier-type/"/>
    <skos:prefLabel xml:lang="en">LSID</skos:prefLabel>
    <skos:notation>LSID</skos:notation>
    <skos:exactMatch rdf:resource="http://purl.org/spar/datacite/lsid"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/scope-dimension/data_modality">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/scope-dimension/"/>
    <skos:prefLabel xml:lang="en">data modality</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/evidence-level/empirically_validated">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/evidence-level/"/>
    <skos:prefLabel xml:lang="en">empirically validated</skos:prefLabel>
    <skos:definition xml:lang="en">Demonstrated by a validation activity with reported results.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/scopeDimensionLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">scope dimension label</rdfs:label>
    <rdfs:comment xml:lang="en">Human-readable name of the dimension a sub-property of bkr:appliesToConcept populates.</rdfs:comment>
    <rdfs:comment xml:lang="en">Human-readable name of the scope dimension a sub-property of bkr:appliesToConcept populates.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://schema.org/affiliation">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:isDefinedBy rdf:resource="https://schema.org/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/assumption-status/stated">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/assumption-status/"/>
    <skos:prefLabel xml:lang="en">stated</skos:prefLabel>
    <skos:definition xml:lang="en">Asserted but not checked.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/downloadURL">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdfs:label xml:lang="en">download URL</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/dcat#downloadURL"/>
    <bkr:schemaAlignment>schema:distribution/schema:contentUrl</bkr:schemaAlignment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/DataSchema">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/Schema"/>
    <rdfs:label xml:lang="en">data schema</rdfs:label>
    <skos:definition xml:lang="en">A schema over primary data rather than over its description: a table specification, file-format definition or array layout.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/relation-type/Obsoletes">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/relation-type/"/>
    <skos:prefLabel xml:lang="en">Obsoletes</skos:prefLabel>
    <skos:notation>Obsoletes</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/usage-role/input_data">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/usage-role/"/>
    <skos:prefLabel xml:lang="en">input data</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/Resource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/dcat#Resource"/>
    <rdfs:label xml:lang="en">resource</rdfs:label>
    <skos:definition xml:lang="en">Anything a consortium catalogues, shares, cites or reuses as a unit of research value: a dataset, a software tool, a computational model, an atlas, a taxonomy, a specimen collection, a protocol, a service, a publication or a piece of infrastructure.</skos:definition>
    <bkr:dataciteMapping>resource</bkr:dataciteMapping>
    <bkr:icityAlignment rdf:resource="http://ontology.eil.utoronto.ca/icity/Resource/Resource"/>
    <bkr:designNote xml:lang="en">Resource is a prov:Entity, not a prov:Activity: the endeavour that produces a resource is a bkr:Project (an activity), while the resource itself is the thing produced.</bkr:designNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/mediaType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">media type</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/dcat#mediaType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/hasIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/adms#identifier"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/adms#Identifier"/>
    <rdfs:label xml:lang="en">has identifier (legacy BKR alias)</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <dcterms:isReplacedBy rdf:resource="http://www.w3.org/ns/adms#identifier"/>
    <bkr:schemaAlignment>schema:identifier</bkr:schemaAlignment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/assessmentMetric">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dqv#QualityMeasurement"/>
    <rdfs:label xml:lang="en">assessment metric label</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/dqv#isMeasurementOf"/>
    <bkr:designNote xml:lang="en">Human-readable metric label kept for extraction compatibility. Use dqv:isMeasurementOf with a dqv:Metric IRI for computable metrics.</bkr:designNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/violationConsequence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Assumption"/>
    <rdfs:label xml:lang="en">violation consequence</rdfs:label>
    <skos:definition xml:lang="en">What goes wrong when the assumption does not hold.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/identifier-type/URL">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/identifier-type/"/>
    <skos:prefLabel xml:lang="en">URL</skos:prefLabel>
    <skos:notation>URL</skos:notation>
    <skos:exactMatch rdf:resource="http://purl.org/spar/datacite/url"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/Instrument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/PhysicalResource"/>
    <rdfs:label xml:lang="en">instrument</rdfs:label>
    <bkr:dataciteMapping>resourceTypeGeneral=Instrument</bkr:dataciteMapping>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <dcterms:isReplacedBy rdf:resource="http://www.w3.org/ns/ssn/System"/>
    <skos:note xml:lang="en">Use ssn:System for an instrument/equipment instance; specialize as sosa:Sensor, sosa:Sampler or sosa:Actuator when applicable.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/modality/sequence">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/modality/"/>
    <skos:prefLabel xml:lang="en">sequence</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/relation-type/IsDocumentedBy">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/relation-type/"/>
    <skos:prefLabel xml:lang="en">IsDocumentedBy</skos:prefLabel>
    <skos:notation>IsDocumentedBy</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/nextReviewDue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#CatalogRecord"/>
    <rdfs:label xml:lang="en">next review due</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/identifier-type/EAN13">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/identifier-type/"/>
    <skos:prefLabel xml:lang="en">EAN13</skos:prefLabel>
    <skos:notation>EAN13</skos:notation>
    <skos:exactMatch rdf:resource="http://purl.org/spar/datacite/ean13"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/title">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lifesci/appliesToSpecimenType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://brainkb.org/resource/appliesToConcept"/>
    <bkr:scopeDimensionLabel>specimen type</bkr:scopeDimensionLabel>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/ApplicabilityScope"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">applies to specimen type</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lifesci/DataUseCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">data use condition</rdfs:label>
    <skos:definition xml:lang="en">The permitted and restricted secondary uses of a resource, expressed with the Data Use Ontology.</skos:definition>
    <bkr:duoAlignment rdf:resource="http://purl.obolibrary.org/obo/DUO_0000001"/>
    <skos:note xml:lang="en">Expressed with the Data Use Ontology: bkrls:hasDataUsePermission takes a descendant of obo:DUO_0000001 (data use permission), bkrls:hasDataUseModifier a descendant of obo:DUO_0000017 (data use modifier). Shape bkrs:DataUseConditionShape enforces DUO PURLs.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/hasAssumption">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/Assumption"/>
    <rdfs:label xml:lang="en">has assumption</rdfs:label>
    <skos:note xml:lang="en">Domain is deliberately open: resources, workflows, protocols and activities can all carry assumptions.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/description-type/">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dcterms:title xml:lang="en">DataCite descriptionType</dcterms:title>
    <skos:scopeNote xml:lang="en">Description roles.</skos:scopeNote>
    <rdfs:seeAlso rdf:resource="https://schema.datacite.org/meta/kernel-4.7/include/datacite-descriptionType-v4.xsd"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/onBenchmark">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/BenchmarkResult"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/Benchmark"/>
    <rdfs:label xml:lang="en">on benchmark</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/resource-type/Award">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/resource-type/"/>
    <skos:prefLabel xml:lang="en">Award</skos:prefLabel>
    <skos:notation>Award</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/spar/datacite/handle">
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://schema.datacite.org/meta/kernel-4.7/include/datacite-contributorType-v4.xsd">
    <rdfs:isDefinedBy rdf:resource="https://schema.datacite.org/meta/kernel-4.7/include/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/Benchmarking">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/Validation"/>
    <rdfs:label xml:lang="en">benchmarking</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/extracted-type/notebook">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/extracted-type/"/>
    <skos:prefLabel xml:lang="en">Computational notebook</skos:prefLabel>
    <skos:definition xml:lang="en">An executable document interleaving code, output and narrative.</skos:definition>
    <bkr:instantiatesClass rdf:resource="https://brainkb.org/resource/ComputationalNotebook"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lifesci/data-modality/multimodal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/lifesci/data-modality/"/>
    <skos:prefLabel xml:lang="en">multimodal</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lifesci/Imaging">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/DataGeneration"/>
    <rdfs:label xml:lang="en">imaging</rdfs:label>
    <skos:definition xml:lang="en">A data-generation activity in which images are acquired. This class intentionally has a different IRI from the imaging data-modality SKOS concept.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/usage-role/training_data">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/usage-role/"/>
    <skos:prefLabel xml:lang="en">training data</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/date-type/Accepted">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/date-type/"/>
    <skos:prefLabel xml:lang="en">Accepted</skos:prefLabel>
    <skos:notation>Accepted</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/resolution-status/ambiguous">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/resolution-status/"/>
    <skos:prefLabel xml:lang="en">ambiguous</skos:prefLabel>
    <skos:notation>ambiguous</skos:notation>
    <skos:definition xml:lang="en">More than one record matched, so the identifier does not denote a single resource.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/resource-type/Report">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/resource-type/"/>
    <skos:prefLabel xml:lang="en">Report</skos:prefLabel>
    <skos:notation>Report</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/extracted-type/material_collection">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/extracted-type/"/>
    <skos:prefLabel xml:lang="en">Material collection</skos:prefLabel>
    <skos:definition xml:lang="en">A depletable physical collection; in the life sciences use bkrls:SpecimenCollection.</skos:definition>
    <bkr:instantiatesClass rdf:resource="https://brainkb.org/resource/MaterialCollection"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/relation-type/IsSourceOf">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/relation-type/"/>
    <skos:prefLabel xml:lang="en">IsSourceOf</skos:prefLabel>
    <skos:notation>IsSourceOf</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/failureSeverity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/FailureMode"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">failure severity</rdfs:label>
    <skos:note xml:lang="en">Values from the criticality vocabulary.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/assertion-method/">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dcterms:title xml:lang="en">BKR assertion method</dcterms:title>
    <skos:scopeNote xml:lang="en">How a property-level claim was produced.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/identifier-type/ARK">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/identifier-type/"/>
    <skos:prefLabel xml:lang="en">ARK</skos:prefLabel>
    <skos:notation>ARK</skos:notation>
    <skos:exactMatch rdf:resource="http://purl.org/spar/datacite/ark"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/mapping-method/bm25">
    <skos:closeMatch rdf:resource="https://w3id.org/semapv/vocab/LexicalSimilarityThresholdMatching"/>
    <rdfs:isDefinedBy rdf:resource="https://brainkb.org/ner/mapping-method/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/Pipeline">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/Workflow"/>
    <rdfs:label xml:lang="en">pipeline</rdfs:label>
    <skos:altLabel xml:lang="en">processing pipeline</skos:altLabel>
    <skos:definition xml:lang="en">A concrete, runnable chain of processing steps with pinned software versions and a defined entry point — what a lab actually executes, as opposed to the abstract workflow specification it implements.</skos:definition>
    <bkr:designNote xml:lang="en">Kept distinct from bkr:Workflow because reuse questions differ: a workflow is cited and adapted, a pipeline is run, and only the pipeline carries an execution environment, resource requirements and per-step software versions.</bkr:designNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/ioDescription">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/IOSpecification"/>
    <rdfs:label xml:lang="en">input/output description</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/resource-type/BookChapter">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/resource-type/"/>
    <skos:prefLabel xml:lang="en">BookChapter</skos:prefLabel>
    <skos:notation>BookChapter</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/relation-type/IsContinuedBy">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/relation-type/"/>
    <skos:prefLabel xml:lang="en">IsContinuedBy</skos:prefLabel>
    <skos:notation>IsContinuedBy</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/managedByCommittee">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/AccessCondition"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/DataAccessCommittee"/>
    <rdfs:label xml:lang="en">managed by committee</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/ObservedScope">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/ApplicabilityScope"/>
    <rdfs:label xml:lang="en">observed scope</rdfs:label>
    <skos:definition xml:lang="en">Scope inferred from recorded applications of the resource (bkr:ResourceUse), i.e. what it has actually been run on.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/relation-type/Requires">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/relation-type/"/>
    <skos:prefLabel xml:lang="en">Requires</skos:prefLabel>
    <skos:notation>Requires</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/access-level/registered">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/access-level/"/>
    <skos:prefLabel xml:lang="en">registered</skos:prefLabel>
    <skos:definition xml:lang="en">Retrievable after self-registration or login.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/contributor-role/DataManager">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/contributor-role/"/>
    <skos:prefLabel xml:lang="en">DataManager</skos:prefLabel>
    <skos:notation>DataManager</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/descriptionType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Description"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">description type</rdfs:label>
    <bkr:dataciteMapping>@descriptionType</bkr:dataciteMapping>
    <skos:note xml:lang="en">Values from &lt;https://brainkb.org/resource/description-type/&gt;: Abstract, Methods, SeriesInformation, TableOfContents, TechnicalInfo, Other.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/identifier-type/DOI">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/identifier-type/"/>
    <skos:prefLabel xml:lang="en">DOI</skos:prefLabel>
    <skos:notation>DOI</skos:notation>
    <skos:exactMatch rdf:resource="http://purl.org/spar/datacite/doi"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lifecycle-status/released">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/lifecycle-status/"/>
    <skos:prefLabel xml:lang="en">released</skos:prefLabel>
    <skos:definition xml:lang="en">Published and citable.</skos:definition>
