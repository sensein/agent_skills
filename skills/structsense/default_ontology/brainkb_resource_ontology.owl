    <rdfs:subPropertyOf rdf:resource="http://xmlns.com/foaf/0.1/primaryTopic"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/source-category/reference_taxonomies">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/source-category/"/>
