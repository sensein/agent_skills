    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <dcterms:isReplacedBy rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <bkr:dataciteMapping>resource/subjects/subject</bkr:dataciteMapping>
    <skos:definition xml:lang="en">A topical keyword or classification assigned to a resource, optionally carrying the scheme it came from and the IRI of the matched concept.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/resource-type/Project">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/resource-type/"/>
    <skos:prefLabel xml:lang="en">Project</skos:prefLabel>
    <skos:notation>Project</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/PreprocessingAssumption">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/TechnicalAssumption"/>
    <rdfs:label xml:lang="en">preprocessing assumption</rdfs:label>
    <skos:example xml:lang="en">Input matrices are raw UMI counts, not normalised values.</skos:example>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lifesci/Atlas">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/DigitalResource"/>
    <rdfs:label xml:lang="en">atlas</rdfs:label>
    <skos:definition xml:lang="en">An integrated, spatially or taxonomically organised reference description of a biological system, assembled from one or more datasets and intended as a common frame of reference.</skos:definition>
    <bkr:nerAlignment rdf:resource="https://brainkb.org/ner/AtlasReference"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/madeBySensor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
    <rdfs:label xml:lang="en">made by sensor</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/versionOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#specializationOf"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/ResourceVersion"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/VersionedResource"/>
    <rdfs:label xml:lang="en">version of</rdfs:label>
    <bkr:dataciteMapping>relationType=IsVersionOf</bkr:dataciteMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lifecycleStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">lifecycle status</rdfs:label>
    <skos:note xml:lang="en">Values from &lt;https://brainkb.org/resource/lifecycle-status/&gt;: planned, in development, draft, released, maintained, superseded, deprecated, withdrawn.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/scopeTargetLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/ApplicabilityScope"/>
    <rdfs:label xml:lang="en">scope target label</rdfs:label>
    <skos:definition xml:lang="en">Coarse target as stated in the source, before mapping, e.g. "Human", "Animal", "Multimodal".</skos:definition>
    <bkr:structsenseField>target</bkr:structsenseField>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/observable-property/latest_version">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/observable-property/"/>
    <skos:prefLabel xml:lang="en">latest version</skos:prefLabel>
    <skos:notation>latest_version</skos:notation>
    <skos:definition xml:lang="en">The newest version identifier the source advertises.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#hadRole">
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov#"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/identifier-type/URN">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/identifier-type/"/>
    <skos:prefLabel xml:lang="en">URN</skos:prefLabel>
    <skos:notation>URN</skos:notation>
    <skos:exactMatch rdf:resource="http://purl.org/spar/datacite/urn"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/appliesToModality">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://brainkb.org/resource/appliesToConcept"/>
    <rdfs:label xml:lang="en">applies to modality</rdfs:label>
    <skos:definition xml:lang="en">Broad data modality the resource consumes or produces, independent of domain: text, image, video, audio, tabular, time series, graph, spatial, multimodal.</skos:definition>
    <bkr:scopeDimensionLabel>modality</bkr:scopeDimensionLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/recordedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#CatalogRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/dcat#Catalog"/>
    <rdfs:label xml:lang="en">recorded in</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://schema.org/MonetaryGrant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/Requirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">requirement</rdfs:label>
    <skos:definition xml:lang="en">Something that must be available for the resource to be used: a dependency, hardware, an input data type, a licence, an approval or an expertise level.</skos:definition>
    <bkr:dataciteMapping>relationType=Requires</bkr:dataciteMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/scopeAssertedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/ApplicabilityScope"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">scope asserted in</rdfs:label>
    <skos:definition xml:lang="en">Publication or documentation in which the scope claim appears.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/ExecutionConfiguration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">execution configuration</rdfs:label>
    <skos:definition xml:lang="en">The parameter settings, software versions and environment under which a computational run was performed — the information needed to judge whether a tool's assumptions were met.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/appliesToVariable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://brainkb.org/resource/appliesToConcept"/>
    <rdfs:label xml:lang="en">applies to variable</rdfs:label>
    <skos:definition xml:lang="en">Measured variable or construct in scope — the behavioural, physiological or environmental quantity the resource measures or models.</skos:definition>
    <bkr:schemaAlignment>schema:variableMeasured</bkr:schemaAlignment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/scope-dimension/geographic_area">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/scope-dimension/"/>
    <skos:prefLabel xml:lang="en">geographic area</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/observable-property/declared_license">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/observable-property/"/>
    <skos:prefLabel xml:lang="en">declared licence</skos:prefLabel>
    <skos:notation>declared_license</skos:notation>
    <skos:definition xml:lang="en">The licence the source declares, which may differ from the one a paper states.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/hasPositiveScope">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://brainkb.org/resource/hasScope"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/ApplicabilityScope"/>
    <rdfs:label xml:lang="en">has positive scope</rdfs:label>
    <skos:definition xml:lang="en">Super-property for declared, validated and observed applicability. Explicit exclusions are deliberately not sub-properties, so positive-scope property chains cannot turn an out-of-scope concept into an applicable concept.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/extracted-type/tool">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/extracted-type/"/>
    <skos:prefLabel xml:lang="en">Tool</skos:prefLabel>
    <skos:definition xml:lang="en">Software a user runs: a command-line program, application or service client. Normalise "library", "framework", "package", "toolkit" to this.</skos:definition>
    <bkr:instantiatesClass rdf:resource="https://schema.org/SoftwareApplication"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/DataAccessCommittee">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Organization"/>
    <rdfs:label xml:lang="en">data access committee</rdfs:label>
    <skos:definition xml:lang="en">The body that authorises access to a controlled-access resource.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/funder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/FundingReference"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <rdfs:label xml:lang="en">funder</rdfs:label>
    <bkr:dataciteMapping>funderName</bkr:dataciteMapping>
    <bkr:schemaAlignment>schema:funder</bkr:schemaAlignment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#notation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/publisher">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/publisher"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <rdfs:label xml:lang="en">publisher (legacy BKR alias)</rdfs:label>
    <bkr:dataciteMapping>resource/publisher</bkr:dataciteMapping>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <dcterms:isReplacedBy rdf:resource="http://purl.org/dc/terms/publisher"/>
    <bkr:schemaAlignment>schema:publisher</bkr:schemaAlignment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/structsenseField">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">structsense field</rdfs:label>
    <rdfs:comment xml:lang="en">Corresponding field in the structsense resource-extraction output schema.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/ResourceAssertion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SEPIO_0000001"/>
    <rdfs:label xml:lang="en">resource assertion</rdfs:label>
    <skos:definition xml:lang="en">A single property-level claim about a resource, carrying its own evidence: the verbatim quote it came from, the document and location, the method that produced it and the agent responsible.</skos:definition>
    <bkr:bicanAlignment>assertion_evidence.yaml</bkr:bicanAlignment>
    <bkr:designNote xml:lang="en">Use when field-level provenance matters — e.g. an automated extraction pipeline asserts that a tool supports macaque, quoting the sentence it read.</bkr:designNote>
    <skos:note xml:lang="en">Aligned to the BrainKB assertion–evidence model: an assertion (SEPIO:0000001) supported by evidence lines (SEPIO:0000002) over evidence items (SEPIO:0000149).</skos:note>
    <skos:note xml:lang="en">A catalogue statement with evidence. The assertion is attributed with prov:wasAttributedTo and generated by a bkr:MetadataCuration or bkr:AutomatedExtraction activity, exactly as the assertion-evidence schema does with was_generated_by.</skos:note>
    <bkr:assertionEvidenceAlignment>Assertion (sepio:0000001)</bkr:assertionEvidenceAlignment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/subjectScheme">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">subject scheme (legacy literal)</rdfs:label>
    <bkr:dataciteMapping>@subjectScheme</bkr:dataciteMapping>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <dcterms:isReplacedBy rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
    <skos:note xml:lang="en">Use skos:inScheme with a skos:ConceptScheme IRI; this legacy literal is retained only for round-tripping old records.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/contributor-role/ResearchGroup">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/contributor-role/"/>
    <skos:prefLabel xml:lang="en">ResearchGroup</skos:prefLabel>
    <skos:notation>ResearchGroup</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/date-type/Coverage">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/date-type/"/>
    <skos:prefLabel xml:lang="en">Coverage</skos:prefLabel>
    <skos:notation>Coverage</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lifesci/Sequencing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/DataGeneration"/>
    <rdfs:label xml:lang="en">sequencing</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/conceptIdentifier">
    <bkr:sssomSlot>object_id (CURIE form)</bkr:sssomSlot>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://brainkb.org/ner/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/oa#Annotation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/identifier-type/LISSN">
