    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">mapped field</rdfs:label>
    <skos:definition xml:lang="en">Which field of the record a concept mapping applies to, e.g. "scope target", "specific target", "subject", "assumption". Not expressible in the Named Entity Ontology, whose mappings are anchored to text spans rather than to record fields.</skos:definition>
    <bkr:structsenseField>the field whose *_concept the mapping populates</bkr:structsenseField>
  </rdf:Description>
