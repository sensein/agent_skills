    <skos:prefLabel xml:lang="en">References</skos:prefLabel>
    <skos:notation>References</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/conceptIRI">
    <bkr:sssomSlot>object_id</bkr:sssomSlot>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://brainkb.org/ner/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/fieldCompleteness">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#CatalogRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">field completeness</rdfs:label>
    <skos:definition xml:lang="en">Fraction of the extraction profile's fields that were found for this record. A record is allowed to be incomplete; it is not allowed to hide it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/assertion-method/registry_api_lookup">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/assertion-method/"/>
    <skos:prefLabel xml:lang="en">registry API lookup</skos:prefLabel>
    <skos:notation>registry_api_lookup</skos:notation>
    <skos:definition xml:lang="en">The value was read from the issuing repository's own API.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/contributor-role/Editor">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/contributor-role/"/>
