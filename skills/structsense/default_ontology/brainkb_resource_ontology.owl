    <bkr:dataciteMapping>@contributorType=RightsHolder</bkr:dataciteMapping>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <dcterms:isReplacedBy rdf:resource="http://purl.org/dc/terms/rightsHolder"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/assertion-method/manual_curation">
