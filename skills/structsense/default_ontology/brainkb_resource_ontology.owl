    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov#"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/verificationOutcome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/ResourceAssertion"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">verification outcome</rdfs:label>
    <skos:note xml:lang="en">Whether the authoritative source confirmed the extracted value, contradicted it, had no value for it, or could not be consulted. Values from &lt;https://brainkb.org/resource/verification-outcome/&gt;.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/documentationURL">
