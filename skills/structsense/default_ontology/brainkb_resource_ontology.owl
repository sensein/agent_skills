  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/identifier-type/w3id">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/identifier-type/"/>
    <skos:prefLabel xml:lang="en">w3id</skos:prefLabel>
    <skos:notation>w3id</skos:notation>
    <bkr:reuseNote xml:lang="en">No published datacite: scheme individual for this identifier type; minted by BKR.</bkr:reuseNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/Assumption">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">assumption</rdfs:label>
    <skos:definition xml:lang="en">A condition that must hold for a resource to produce valid results, stated explicitly so that a user can check it. The assumption is an entity in its own right: it is asserted by someone, stated somewhere, holds under a scope, has a criticality, and may be tested, satisfied or violated in a given application.</skos:definition>
    <bkr:designNote xml:lang="en">Assumptions are the metadata most often lost when tools are catalogued. Modelling them as first-class entities rather than free text lets a catalogue answer "which tools in this pipeline assume unimodal count distributions?".</bkr:designNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/observable-property/latest_release_tag">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/observable-property/"/>
    <skos:prefLabel xml:lang="en">latest release tag</skos:prefLabel>
    <skos:notation>latest_release_tag</skos:notation>
    <skos:definition xml:lang="en">The newest release tag of a code repository.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/availability-status/available">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/availability-status/"/>
