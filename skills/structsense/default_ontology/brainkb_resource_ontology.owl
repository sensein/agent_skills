    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/ApplicabilityScope"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">scope evidence level</rdfs:label>
    <skos:note xml:lang="en">Values from &lt;https://brainkb.org/resource/evidence-level/&gt;: developer asserted, documented in publication, empirically validated, benchmarked, extracted from text, inferred from usage.</skos:note>
