    <rdfs:label xml:lang="en">assertion-evidence alignment</rdfs:label>
    <rdfs:comment xml:lang="en">Corresponding class or slot in the BrainKB/BICAN assertion-evidence schema (https://identifiers.org/brain-bican/assertion-evidence-schema).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/softwareVersionUsed">
