  <rdf:Description rdf:about="https://brainkb.org/resource/isBreakingChange">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/ner/ChangeRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">is breaking change</rdfs:label>
    <skos:definition xml:lang="en">True when downstream consumers must change code, queries or annotations to accommodate the change.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/source-category/data_format">
