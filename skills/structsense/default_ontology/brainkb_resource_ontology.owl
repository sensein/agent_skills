    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <rdfs:label xml:lang="en">assumption asserted by</rdfs:label>
    <skos:definition xml:lang="en">Who says so: the developers, a curator, a reviewer, or an extraction agent.</skos:definition>
  </rdf:Description>
