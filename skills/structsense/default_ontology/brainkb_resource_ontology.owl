    <skos:note xml:lang="en">Values from the io-role vocabulary.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/scope-dimension/taxon">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/scope-dimension/"/>
    <skos:prefLabel xml:lang="en">taxon</skos:prefLabel>
    <skos:definition xml:lang="en">Biological species or higher taxon.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/Description">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">description</rdfs:label>
    <bkr:dataciteMapping>resource/descriptions/description</bkr:dataciteMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/executionEnvironment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/ExecutionConfiguration"/>
    <rdfs:label xml:lang="en">execution environment</rdfs:label>
    <skos:definition xml:lang="en">Container image, conda environment or module stack identifier.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/observable-property/distribution_byte_size">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/observable-property/"/>
    <skos:prefLabel xml:lang="en">distribution byte size</skos:prefLabel>
    <skos:notation>distribution_byte_size</skos:notation>
    <skos:definition xml:lang="en">Size in bytes of the distribution at the time of observation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/reviewStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://brainkb.org/ner/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/identifier-type/arXiv">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/identifier-type/"/>
    <skos:prefLabel xml:lang="en">arXiv</skos:prefLabel>
    <skos:notation>arXiv</skos:notation>
    <skos:exactMatch rdf:resource="http://purl.org/spar/datacite/arxiv"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/assertion-method/automated_extraction">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/assertion-method/"/>
    <skos:prefLabel xml:lang="en">automated extraction</skos:prefLabel>
    <skos:definition xml:lang="en">Pipeline read it from a document; the text anchor is an ner:EntityMention.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/sourceValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/ResourceAssertion"/>
    <rdfs:label xml:lang="en">value at source</rdfs:label>
    <skos:note xml:lang="en">The value the authoritative source gives, recorded alongside bkr:assertedValue so a mismatch keeps both sides rather than overwriting the extracted claim.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/Program">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:label xml:lang="en">program</rdfs:label>
    <skos:definition xml:lang="en">A funded, time-bounded coordination umbrella under which projects operate, such as the BRAIN Initiative Cell Atlas Network.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/hasFeatureOfInterest">
