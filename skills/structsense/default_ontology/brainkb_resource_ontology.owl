  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/observable-property/">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dcterms:title xml:lang="en">Observable resource property</dcterms:title>
    <skos:scopeNote xml:lang="en">Properties of a resource whose value changes over time and can be observed from a repository, registry or archive. Used as the sosa:observedProperty of a bkr:ResourceObservation, so a catalogue can hold a dated series rather than one overwritten current value.</skos:scopeNote>
  </rdf:Description>
