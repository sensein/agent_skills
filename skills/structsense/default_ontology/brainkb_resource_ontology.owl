    <skos:prefLabel xml:lang="en">reference taxonomy</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/ComputationalRun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/DataProcessing"/>
    <rdfs:label xml:lang="en">computational run</rdfs:label>
    <skos:definition xml:lang="en">One execution of software over inputs, with a configuration, in an environment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/isTestableBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Assumption"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:label xml:lang="en">is testable by</rdfs:label>
    <skos:definition xml:lang="en">Diagnostic tool, metric or protocol that checks whether the assumption holds for given data.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/ioFormat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/IOSpecification"/>
    <rdfs:label xml:lang="en">input/output format</rdfs:label>
    <skos:definition xml:lang="en">Concrete format or media type expected or produced — CSV, Parquet, AnnData/h5ad, NIfTI, BIDS directory, ONNX, FASTQ.</skos:definition>
    <bkr:dataciteMapping>resource/formats/format</bkr:dataciteMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/containerImage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/SoftwareResource"/>
    <rdfs:label xml:lang="en">container image</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/assumptionStatedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Assumption"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">assumption stated in</rdfs:label>
    <skos:definition xml:lang="en">Publication, documentation or code comment where the assumption is stated.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/assumptionSatisfiedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Assumption"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:label xml:lang="en">assumption satisfied in</rdfs:label>
    <skos:definition xml:lang="en">An activity in which the assumption was checked and found to hold.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/identifier-type/SWHID">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/identifier-type/"/>
    <skos:prefLabel xml:lang="en">SWHID</skos:prefLabel>
    <skos:notation>SWHID</skos:notation>
    <bkr:reuseNote xml:lang="en">No published datacite: scheme individual for this identifier type; minted by BKR.</bkr:reuseNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/contributor-role/Producer">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/contributor-role/"/>
    <skos:prefLabel xml:lang="en">Producer</skos:prefLabel>
    <skos:notation>Producer</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/date-type/Updated">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/date-type/"/>
    <skos:prefLabel xml:lang="en">Updated</skos:prefLabel>
    <skos:notation>Updated</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/exampleScope">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/UsageExample"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/ApplicabilityScope"/>
    <rdfs:label xml:lang="en">example scope</rdfs:label>
    <skos:definition xml:lang="en">What the example was run on — a worked example on mouse data is weak but real evidence of mouse applicability.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/bridge/schema/ingestionNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">ingestion note</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/stewardedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <rdfs:label xml:lang="en">stewarded by</rdfs:label>
    <skos:definition xml:lang="en">Organization accountable for the resource's continued availability, as distinct from its owner or creator.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/describesActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#CatalogRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:label xml:lang="en">describes activity</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/exampleCode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/UsageExample"/>
    <rdfs:label xml:lang="en">example code</rdfs:label>
    <skos:definition xml:lang="en">Verbatim command or code, as given in the source.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/funder-identifier-type/CrossrefFunderID">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/funder-identifier-type/"/>
    <skos:prefLabel xml:lang="en">Crossref Funder ID</skos:prefLabel>
    <skos:notation>Crossref Funder ID</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/bridge/brainkb/mentionDenotes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/ner/EntityMention"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:label xml:lang="en">mention denotes resource</rdfs:label>
    <skos:definition xml:lang="en">Span-level denotation: this particular ner:EntityMention refers to this registered resource. This relation is intentionally separate from bkr:resolvesToResource, which relates a canonical ner:NamedEntity to a resource.</skos:definition>
    <skos:note xml:lang="en">Not a subproperty of bkr:resolvesToResource: otherwise the bkr:resolvesToResource domain would infer every mentionDenotes subject to be a ner:NamedEntity. Keep mention-level and canonical-entity-level resolution distinct.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/hasPart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/hasGeoLocation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/spatial"/>
    <rdfs:range rdf:resource="http://purl.org/dc/terms/Location"/>
    <rdfs:label xml:lang="en">has geolocation (legacy BKR alias)</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <dcterms:isReplacedBy rdf:resource="http://purl.org/dc/terms/spatial"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/resourceTypeGeneral">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">resource type (general)</rdfs:label>
    <bkr:dataciteMapping>resource/resourceType/@resourceTypeGeneral</bkr:dataciteMapping>
    <skos:note xml:lang="en">The DataCite general type, as a concept from &lt;https://brainkb.org/resource/resource-type/&gt;. Complementary to the OWL class of the resource: the class carries inference, the concept carries exchange fidelity.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/useScope">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/ResourceUse"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/ApplicabilityScope"/>
    <rdfs:label xml:lang="en">use scope</rdfs:label>
    <skos:definition xml:lang="en">The biological and technical scope of this particular application: the species, structures, cell types and modality the resource was actually applied to here.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/entryPoint">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/SoftwareResource"/>
    <rdfs:label xml:lang="en">entry point</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://rdf.webofcode.org/woc/Method"/>
    <skos:definition xml:lang="en">Command, function or API operation through which the software is invoked.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/requirement-type/approval_requirement">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/requirement-type/"/>
    <skos:prefLabel xml:lang="en">approval requirement</skos:prefLabel>
    <skos:definition xml:lang="en">Ethics, IRB or data access approval.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/scopeEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/ApplicabilityScope"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">scope evidence</rdfs:label>
    <skos:definition xml:lang="en">Assessment, benchmark result, assertion or recorded use that supports the scope claim.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lifecycle-status/superseded">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/lifecycle-status/"/>
    <skos:prefLabel xml:lang="en">superseded</skos:prefLabel>
    <skos:definition xml:lang="en">A newer version or replacement resource should be used instead.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/dcat#Dataset">
    <bkr:reuseNote xml:lang="en">Use dcat:Dataset directly for the dataset type. A catalogued dataset is also explicitly typed bkr:DigitalResource (or bkr:Resource) by the ingestion layer; BKR does not globally redefine every DCAT dataset as a BKR resource.</bkr:reuseNote>
    <skos:closeMatch rdf:resource="https://schema.org/Dataset"/>
    <skos:closeMatch rdf:resource="https://brainkb.org/ner/DatasetEntity"/>
    <bkr:dataciteMapping>resourceTypeGeneral=Dataset</bkr:dataciteMapping>
    <bkr:structsenseField>type=Dataset</bkr:structsenseField>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <bkr:nerAlignment rdf:resource="https://brainkb.org/ner/DatasetEntity"/>
    <bkr:schemaAlignment>schema:Dataset</bkr:schemaAlignment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/appliesToConcept">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/ApplicabilityScope"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">applies to concept</rdfs:label>
    <skos:definition xml:lang="en">The generic scope dimension: a published concept this resource covers or can be correctly applied to. Domain extensions declare sub-properties for their dimensions — taxon, anatomical structure, cell type, material, instrument class, region, period, population — so that a query can ask across all of them at once while each stays separately typed.</skos:definition>
    <skos:note xml:lang="en">Pair with bkr:scopeDimension on the scope object, or rely on the sub-property, to record which dimension a concept belongs to.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/nextVersion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:label xml:lang="en">next version</rdfs:label>
    <bkr:dataciteMapping>relationType=IsPreviousVersionOf</bkr:dataciteMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/description-type/SeriesInformation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/description-type/"/>
    <skos:prefLabel xml:lang="en">SeriesInformation</skos:prefLabel>
    <skos:notation>SeriesInformation</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/extracted-type/publication">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/extracted-type/"/>
    <skos:prefLabel xml:lang="en">Publication</skos:prefLabel>
    <skos:definition xml:lang="en">An article, preprint, data paper or report.</skos:definition>
    <bkr:instantiatesClass rdf:resource="http://purl.obolibrary.org/obo/IAO_0000310"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/releaseTag">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/CodeRelease"/>
    <rdfs:label xml:lang="en">release tag</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/exampleDescription">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/UsageExample"/>
    <rdfs:label xml:lang="en">example description</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/usage-role/reference_atlas">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/usage-role/"/>
    <skos:prefLabel xml:lang="en">reference atlas</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/hasFundingReference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/FundingReference"/>
    <rdfs:label xml:lang="en">has funding reference</rdfs:label>
    <bkr:schemaAlignment>schema:funding</bkr:schemaAlignment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/contributionOrder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Attribution"/>
    <rdfs:label xml:lang="en">contribution order</rdfs:label>
    <skos:note xml:lang="en">BKR extension: PROV has qualified attribution and role but no ordering property corresponding to DataCite creator/contributor order.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/resource-type/Software">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/resource-type/"/>
    <skos:prefLabel xml:lang="en">Software</skos:prefLabel>
    <skos:notation>Software</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/relation-type/HasPart">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/relation-type/"/>
    <skos:prefLabel xml:lang="en">HasPart</skos:prefLabel>
    <skos:notation>HasPart</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/relation-type/IsVersionOf">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/relation-type/"/>
    <skos:prefLabel xml:lang="en">IsVersionOf</skos:prefLabel>
    <skos:notation>IsVersionOf</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lifecycle-status/draft">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/lifecycle-status/"/>
    <skos:prefLabel xml:lang="en">draft</skos:prefLabel>
    <skos:definition xml:lang="en">Released for comment, not for production use.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/resolution-status/source_unavailable">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/resolution-status/"/>
    <skos:prefLabel xml:lang="en">source unavailable</skos:prefLabel>
    <skos:notation>source_unavailable</skos:notation>
    <skos:definition xml:lang="en">The source could not be consulted — network failure, rate limit, authentication required. Says nothing about the identifier.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/accessLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/AccessCondition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">access level</rdfs:label>
    <skos:note xml:lang="en">Values from &lt;https://brainkb.org/resource/access-level/&gt;: open, registered, controlled, embargoed, consortium internal, restricted by agreement.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/ScopeAssumption">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/Assumption"/>
    <rdfs:label xml:lang="en">scope assumption</rdfs:label>
    <skos:definition xml:lang="en">An assumption that the material under analysis falls within the resource's applicability scope.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/subjectLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">subject label (legacy BKR alias)</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <dcterms:isReplacedBy rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/usage-role/">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dcterms:title xml:lang="en">BRPO usage role</dcterms:title>
    <skos:scopeNote xml:lang="en">Role a resource plays in an activity that uses it.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/date-type/Valid">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/date-type/"/>
    <skos:prefLabel xml:lang="en">Valid</skos:prefLabel>
    <skos:notation>Valid</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/resource-type/Event">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/resource-type/"/>
    <skos:prefLabel xml:lang="en">Event</skos:prefLabel>
    <skos:notation>Event</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/modelName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://brainkb.org/ner/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/VersionedResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:label xml:lang="en">versioned resource</rdfs:label>
    <skos:definition xml:lang="en">A resource that is released in identifiable versions. The abstract, version-independent resource; individual versions are bkr:ResourceVersion instances specialising it.</skos:definition>
    <bkr:bicanAlignment>bican:VersionedNamedThing</bkr:bicanAlignment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/nerAlignment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">named entity ontology alignment</rdfs:label>
    <rdfs:comment xml:lang="en">Corresponding term in the BrainKB Named Entity Ontology (https://brainkb.org/ner/).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/dataciteMapping">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">DataCite mapping</rdfs:label>
    <rdfs:comment xml:lang="en">Path of the corresponding property in the DataCite Metadata Kernel 4.7 XSD.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lifecycle-status/maintained">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/lifecycle-status/"/>
    <skos:prefLabel xml:lang="en">maintained</skos:prefLabel>
    <skos:definition xml:lang="en">Released and receiving ongoing updates and support.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/Capability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">capability</rdfs:label>
    <skos:definition xml:lang="en">Something the resource can do, stated so that it can be matched against a need: an analytical operation, a coverage claim, a throughput.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/modality/time_series">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
