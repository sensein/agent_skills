    <rdf:type rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/identifier-type/"/>
    <skos:prefLabel xml:lang="en">ISBN</skos:prefLabel>
    <skos:notation>ISBN</skos:notation>
    <skos:exactMatch rdf:resource="http://purl.org/spar/datacite/isbn"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/change-type/metadata_correction">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/change-type/"/>
    <skos:prefLabel xml:lang="en">metadata correction</skos:prefLabel>
    <skos:definition xml:lang="en">The record was wrong; the resource did not change.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/identifier-type/UPC">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/identifier-type/"/>
    <skos:prefLabel xml:lang="en">UPC</skos:prefLabel>
    <skos:notation>UPC</skos:notation>
    <bkr:reuseNote xml:lang="en">No published datacite: scheme individual for this identifier type; minted by BKR.</bkr:reuseNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/resource-type/OutputManagementPlan">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/resource-type/"/>
    <skos:prefLabel xml:lang="en">OutputManagementPlan</skos:prefLabel>
    <skos:notation>OutputManagementPlan</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/verification-outcome/absent_at_source">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/verification-outcome/"/>
    <skos:prefLabel xml:lang="en">absent at source</skos:prefLabel>
    <skos:notation>absent_at_source</skos:notation>
    <skos:definition xml:lang="en">The source has a record but no value for this property, so the extracted value stands unverified.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/scopeConfidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/ApplicabilityScope"/>
    <rdfs:label xml:lang="en">scope confidence</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#broadMatch">
