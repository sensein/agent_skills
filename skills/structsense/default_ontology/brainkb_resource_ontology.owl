    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/lifecycle-status/"/>
    <skos:prefLabel xml:lang="en">frozen</skos:prefLabel>
    <skos:definition xml:lang="en">Released and stable; no further changes planned, still supported.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/scope-dimension/material_or_specimen_type">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/scope-dimension/"/>
