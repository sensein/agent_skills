  <rdf:Description rdf:about="https://brainkb.org/resource/ResourceObservation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
    <rdfs:label xml:lang="en">resource observation</rdfs:label>
    <skos:definition xml:lang="en">An observation of a property of a resource at a point in time — the latest release of a repository, the last commit date, the declared licence, the record's last-modified date at the archive. A series of these is how a resource's evolution is represented.</skos:definition>
    <skos:note xml:lang="en">Reuses the SOSA observation pattern: sosa:hasFeatureOfInterest points at the resource, sosa:observedProperty at the observed property, sosa:hasResult or bkr:observationValue at the value, and sosa:resultTime at when the observation was made. BKR adds no parallel observation vocabulary.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/ResourceLifecycleActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:label xml:lang="en">resource lifecycle activity</rdfs:label>
    <skos:definition xml:lang="en">Any activity that creates, transforms, evaluates, describes, releases or retires a resource.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/ResourceCollection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Collection"/>
    <rdfs:label xml:lang="en">resource collection</rdfs:label>
    <skos:definition xml:lang="en">A resource whose members are themselves resources, e.g. a release bundle of datasets and the tools needed to read them.</skos:definition>
    <bkr:dataciteMapping>resourceTypeGeneral=Collection</bkr:dataciteMapping>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <dcterms:isReplacedBy rdf:resource="http://www.w3.org/ns/prov#Collection"/>
    <skos:note xml:lang="en">Use prov:Collection for a collection; add bkr:Resource if the collection itself is catalogued.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/contributor-role/HostingInstitution">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/contributor-role/"/>
    <skos:prefLabel xml:lang="en">HostingInstitution</skos:prefLabel>
    <skos:notation>HostingInstitution</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lifesci/AnatomicalReferenceAtlas">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/lifesci/Atlas"/>
    <rdfs:label xml:lang="en">anatomical reference atlas</rdfs:label>
    <skos:definition xml:lang="en">An atlas providing a reference coordinate space and parcellation of anatomical structures.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/creator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasAttributedTo"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/creator"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <rdfs:label xml:lang="en">creator (legacy BKR shortcut)</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <dcterms:isReplacedBy rdf:resource="http://purl.org/dc/terms/creator"/>
    <bkr:dataciteMapping>resource/creators/creator</bkr:dataciteMapping>
    <skos:note xml:lang="en">Shortcut for a bkr:Contribution with role &lt;https://brainkb.org/resource/contributor-role/Creator&gt;; use the qualified form when order or affiliation matters.</skos:note>
    <bkr:schemaAlignment>schema:creator</bkr:schemaAlignment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/producedByProject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://brainkb.org/resource/producedByActivity"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/Project"/>
    <rdfs:label xml:lang="en">produced by project</rdfs:label>
    <skos:definition xml:lang="en">Links a resource to the project that produced it — the project-to-dataset and project-to-tool edge of the resource index.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/resource-type/Audiovisual">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/resource-type/"/>
    <skos:prefLabel xml:lang="en">Audiovisual</skos:prefLabel>
    <skos:notation>Audiovisual</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/date-type/Issued">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/date-type/"/>
    <skos:prefLabel xml:lang="en">Issued</skos:prefLabel>
    <skos:notation>Issued</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/extracted-type/benchmark">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/extracted-type/"/>
    <skos:prefLabel xml:lang="en">Benchmark</skos:prefLabel>
    <skos:definition xml:lang="en">A dataset-plus-task-plus-metric bundle for comparable evaluation.</skos:definition>
    <bkr:instantiatesClass rdf:resource="https://brainkb.org/resource/Benchmark"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lifesci/CellTypeAtlas">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/lifesci/Atlas"/>
    <rdfs:label xml:lang="en">cell type atlas</rdfs:label>
    <skos:definition xml:lang="en">An atlas whose organising units are cell types or cell populations and their distribution.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/date-type/Submitted">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/date-type/"/>
    <skos:prefLabel xml:lang="en">Submitted</skos:prefLabel>
    <skos:notation>Submitted</skos:notation>
  </rdf:Description>
