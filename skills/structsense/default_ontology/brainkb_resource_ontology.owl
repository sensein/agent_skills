    <rdfs:domain rdf:resource="https://brainkb.org/resource/ApplicabilityScope"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">applies to cell type</rdfs:label>
    <skos:definition xml:lang="en">Cell type covered, as a Cell Ontology term or a cell-type-taxonomy node.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brain-bbqs.org/vocab/Consortium">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
