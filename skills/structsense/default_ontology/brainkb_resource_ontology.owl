    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/resolutionRoute">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/IdentifierResolution"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">resolution route</rdfs:label>
    <skos:note xml:lang="en">Which path was taken: the authoritative repository for a known accession prefix, DataCite Commons for an unknown one, a DOI or accession resolver, or a manual lookup. Values from &lt;https://brainkb.org/resource/resolution-route/&gt;.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/assertionEvidenceAlignment">
