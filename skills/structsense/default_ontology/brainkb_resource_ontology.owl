    <rdfs:domain rdf:resource="https://brainkb.org/resource/ComputationalRun"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/ComputeResource"/>
    <rdfs:label xml:lang="en">compute resource used</rdfs:label>
