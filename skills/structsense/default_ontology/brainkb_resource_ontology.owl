    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/DigitalResource"/>
    <rdfs:subClassOf rdf:resource="http://purl.org/dc/terms/Standard"/>
    <rdfs:label xml:lang="en">standard</rdfs:label>
    <bkr:dataciteMapping>resourceTypeGeneral=Standard</bkr:dataciteMapping>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <dcterms:isReplacedBy rdf:resource="http://purl.org/dc/terms/Standard"/>
    <skos:note xml:lang="en">Use dcterms:Standard directly.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/titleText">
