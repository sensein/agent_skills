<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:bkr="https://brainkb.org/resource/"
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
   xmlns:vann="http://purl.org/vocab/vann/"
>
  <rdf:Description rdf:about="https://brainkb.org/ner/mapping-method/dense_embedding">
    <skos:closeMatch rdf:resource="https://w3id.org/semapv/vocab/EmbeddingBasedMatching"/>
    <rdfs:isDefinedBy rdf:resource="https://brainkb.org/ner/mapping-method/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/identifier-type/CrossrefFunderID">
    <rdf:type rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
    <skos:exactMatch rdf:resource="http://purl.org/spar/datacite/fundref"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/dateType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/ResourceDate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">date type</rdfs:label>
    <bkr:dataciteMapping>@dateType</bkr:dataciteMapping>
    <skos:note xml:lang="en">Values from &lt;https://brainkb.org/resource/date-type/&gt;: Accepted, Available, Collected, Copyrighted, Coverage, Created, Issued, Other, Submitted, Updated, Valid, Withdrawn.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/usedResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#used"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:label xml:lang="en">used resource</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/hasReviewDecision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://brainkb.org/ner/ReviewDecision"/>
    <rdfs:label xml:lang="en">has review decision</rdfs:label>
    <skos:definition xml:lang="en">Curation outcome for a record, a scope claim, an assumption or a mapping.</skos:definition>
    <skos:note xml:lang="en">Reuses the Named Entity Ontology's review model (ner:reviewStatus over ner:ReviewStatus: unreviewed, accepted, corrected, rejected; plus ner:reviewComment, ner:reviewConfidence, ner:reviewDimension) rather than a BKR-specific record status.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/identifier-type/PMID">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/identifier-type/"/>
    <skos:prefLabel xml:lang="en">PMID</skos:prefLabel>
    <skos:notation>PMID</skos:notation>
    <skos:exactMatch rdf:resource="http://purl.org/spar/datacite/pmid"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/access-level/consortium_internal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/access-level/"/>
    <skos:prefLabel xml:lang="en">consortium internal</skos:prefLabel>
    <skos:definition xml:lang="en">Available to consortium members only.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/date-type/Created">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/date-type/"/>
    <skos:prefLabel xml:lang="en">Created</skos:prefLabel>
    <skos:notation>Created</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SEPIO_0000149">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">evidence item</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/affiliation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Organization"/>
    <rdfs:label xml:lang="en">affiliation (legacy BKR alias)</rdfs:label>
    <bkr:dataciteMapping>affiliation</bkr:dataciteMapping>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <dcterms:isReplacedBy rdf:resource="https://schema.org/affiliation"/>
    <bkr:schemaAlignment>schema:affiliation</bkr:schemaAlignment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/relation-type/IsSupplementedBy">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/relation-type/"/>
    <skos:prefLabel xml:lang="en">IsSupplementedBy</skos:prefLabel>
    <skos:notation>IsSupplementedBy</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/MetadataSchema">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/Standard"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/Schema"/>
    <rdfs:label xml:lang="en">metadata schema</rdfs:label>
    <bkr:bicanAlignment>brain-bican/models LinkML schemas</bkr:bicanAlignment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/observable-property/open_issue_count">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/observable-property/"/>
    <skos:prefLabel xml:lang="en">open issue count</skos:prefLabel>
    <skos:notation>open_issue_count</skos:notation>
    <skos:definition xml:lang="en">Number of open issues at the time of observation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/publicationYear">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
    <rdfs:label xml:lang="en">publication year</rdfs:label>
    <bkr:dataciteMapping>resource/publicationYear</bkr:dataciteMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lastVerified">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#CatalogRecord"/>
    <rdfs:label xml:lang="en">last verified</rdfs:label>
    <skos:definition xml:lang="en">When a curator or pipeline last confirmed that the record still matches the resource — the freshness signal of the catalogue.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/identifier-type/IGSN">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/identifier-type/"/>
    <skos:prefLabel xml:lang="en">IGSN</skos:prefLabel>
    <skos:notation>IGSN</skos:notation>
    <skos:exactMatch rdf:resource="http://purl.org/spar/datacite/igsn"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/change-type/nomenclature_change">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/change-type/"/>
    <skos:prefLabel xml:lang="en">nomenclature change</skos:prefLabel>
    <skos:definition xml:lang="en">Labels or identifiers of the resource's own units changed, so downstream annotations must be re-mapped.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:title xml:lang="en">BrainKB Resource Ontology (standalone)</dcterms:title>
    <vann:preferredNamespacePrefix>bkr</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://brainkb.org/resource/</vann:preferredNamespaceUri>
    <owl:versionIRI rdf:resource="https://brainkb.org/resource/0.5.0/"/>
    <owl:versionInfo>0.5.0 — merged standalone build</owl:versionInfo>
    <dcterms:description xml:lang="en">Single-file build of the BrainKB Resource Ontology: the domain-neutral core, the controlled vocabularies, the life-science extension and the bridges to the BrainKB Named Entity Ontology, the SEPIO assertion-evidence model and schema.org. Generated from the module sources by scripts/build_standalone.py; edit the modules, not this file. Catalogue policy (SHACL) ships separately as bkr-shapes.ttl.</dcterms:description>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-02</dcterms:modified>
    <dcterms:source>bkr.ttl</dcterms:source>
    <dcterms:source>bkr-vocab.ttl</dcterms:source>
    <dcterms:source>bkr-lifesci.ttl</dcterms:source>
    <dcterms:source>bkr-brainkb-bridge.ttl</dcterms:source>
    <dcterms:source>bkr-schema-bridge.ttl</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/dcat#">
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/dcat#"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/rightsIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:label xml:lang="en">rights identifier</rdfs:label>
    <bkr:dataciteMapping>@rightsIdentifier</bkr:dataciteMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/classificationCode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#notation"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">classification code (legacy BKR alias)</rdfs:label>
    <bkr:dataciteMapping>@classificationCode</bkr:dataciteMapping>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <dcterms:isReplacedBy rdf:resource="http://www.w3.org/2004/02/skos/core#notation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/ComputationalModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/DigitalResource"/>
    <rdfs:label xml:lang="en">computational model</rdfs:label>
    <skos:definition xml:lang="en">A fitted or specified model — statistical, mechanistic or machine-learned — distributed for reuse, including trained classifiers used for cell-type mapping.</skos:definition>
    <bkr:dataciteMapping>resourceTypeGeneral=Model</bkr:dataciteMapping>
    <bkr:structsenseField>type=Model</bkr:structsenseField>
    <bkr:nerAlignment rdf:resource="https://brainkb.org/ner/ModelArtifact"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/assumptionStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Assumption"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">assumption status</rdfs:label>
    <skos:note xml:lang="en">Values from &lt;https://brainkb.org/resource/assumption-status/&gt;: stated, verified, untested, violated, disputed, retired.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/StatisticalAssumption">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/Assumption"/>
    <rdfs:label xml:lang="en">statistical assumption</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/notFoundField">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#CatalogRecord"/>
    <rdfs:label xml:lang="en">not-found field</rdfs:label>
    <skos:definition xml:lang="en">Name of a profile field the extractor looked for and did not find. Explicit absence, so a later run can distinguish "not in the source" from "not yet attempted".</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/contributor-role/Creator">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/contributor-role/"/>
    <skos:prefLabel xml:lang="en">Creator</skos:prefLabel>
    <skos:definition xml:lang="en">Agent credited as a creator of the resource (DataCite creators rather than contributors).</skos:definition>
    <skos:notation>Creator</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/change-type/retraction">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/change-type/"/>
    <skos:prefLabel xml:lang="en">retraction</skos:prefLabel>
    <skos:definition xml:lang="en">The resource or part of it was retracted.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n21a3cd6794b140088b77c713d4c27c9fb2">
    <rdf:first rdf:resource="https://brainkb.org/ner/SoftwareEntity"/>
    <rdf:rest rdf:nodeID="n21a3cd6794b140088b77c713d4c27c9fb3"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/DataResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:closeMatch rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <skos:closeMatch rdf:resource="https://brainkb.org/resource/DataPortal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lifesci/data-modality/epigenomic">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/lifesci/data-modality/"/>
    <skos:prefLabel xml:lang="en">epigenomic</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/IdentifierResolution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/ResourceLifecycleActivity"/>
    <rdfs:label xml:lang="en">identifier resolution</rdfs:label>
    <skos:definition xml:lang="en">An attempt to resolve a resource identifier against an authoritative source: a repository API, a registry, DataCite Commons or an identifier resolver. The attempt is recorded whether or not it succeeded.</skos:definition>
    <skos:note xml:lang="en">The outcome belongs on the activity, not on the identifier: the same accession can fail today and resolve tomorrow, and both attempts are part of the record.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/resourceName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:label xml:lang="en">resource name</rdfs:label>
    <skos:definition xml:lang="en">Canonical short name of the resource.</skos:definition>
    <bkr:structsenseField>name</bkr:structsenseField>
    <bkr:dataciteMapping>resource/titles/title</bkr:dataciteMapping>
    <rdfs:seeAlso rdf:resource="http://purl.org/dc/terms/title"/>
    <bkr:schemaAlignment>schema:name</bkr:schemaAlignment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/ioCardinality">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/IOSpecification"/>
    <rdfs:label xml:lang="en">input/output cardinality</rdfs:label>
    <skos:definition xml:lang="en">How many are expected or returned: "exactly one", "one or more", "one per sample".</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/appliesToTask">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://brainkb.org/resource/appliesToConcept"/>
    <rdfs:label xml:lang="en">applies to task</rdfs:label>
    <skos:definition xml:lang="en">Analytical task the resource performs, ideally an EDAM operation.</skos:definition>
    <bkr:structsenseField>category</bkr:structsenseField>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/WorkingGroup">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Organization"/>
    <rdfs:label xml:lang="en">working group</rdfs:label>
    <skos:definition xml:lang="en">A standing sub-unit of a consortium or programme with its own remit and outputs.</skos:definition>
    <bkr:schemaAlignment>bbqs:vocab WorkingGroup / schema:parentOrganization</bkr:schemaAlignment>
    <skos:closeMatch rdf:resource="https://brain-bbqs.org/vocab/WorkingGroup"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/verification-outcome/confirmed">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/verification-outcome/"/>
    <skos:prefLabel xml:lang="en">confirmed</skos:prefLabel>
    <skos:notation>confirmed</skos:notation>
    <skos:definition xml:lang="en">The source gives the same value.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/Leaderboard">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/ServiceResource"/>
    <rdfs:label xml:lang="en">leaderboard</rdfs:label>
    <bkr:structsenseField>type=Leaderboard</bkr:structsenseField>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/previousVersion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasRevisionOf"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:label xml:lang="en">previous version</rdfs:label>
    <bkr:dataciteMapping>relationType=IsNewVersionOf</bkr:dataciteMapping>
    <bkr:bicanAlignment>bican:revision_of</bkr:bicanAlignment>
    <owl:inverseOf rdf:resource="https://brainkb.org/resource/nextVersion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/PhysicalResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/Resource/Resource"/>
    <rdfs:label xml:lang="en">physical resource</rdfs:label>
    <skos:definition xml:lang="en">A resource with a physical embodiment, such as an instrument, specimen collection, tissue block or reagent lot. Depletion-by-use is modeled more specifically by bkr:ConsumableResource.</skos:definition>
    <bkr:dataciteMapping>resourceTypeGeneral=PhysicalObject</bkr:dataciteMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/assertionConfidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">assertion confidence</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/sourceDocument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/ResourceAssertion"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">source document</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#hadPrimarySource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/contributor-role/WorkPackageLeader">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/contributor-role/"/>
    <skos:prefLabel xml:lang="en">WorkPackageLeader</skos:prefLabel>
    <skos:notation>WorkPackageLeader</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/Identifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/adms#Identifier"/>
    <rdfs:label xml:lang="en">identifier (legacy BKR alias)</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <dcterms:isReplacedBy rdf:resource="http://www.w3.org/ns/adms#Identifier"/>
    <skos:note xml:lang="en">Use adms:Identifier directly. Kept only for backward compatibility with BKR 0.5.0 records.</skos:note>
    <bkr:dataciteMapping>resource/identifier</bkr:dataciteMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lifesci/appliesToAssay">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://brainkb.org/resource/appliesToMeasurementTechnique"/>
    <bkr:scopeDimensionLabel>assay</bkr:scopeDimensionLabel>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/ApplicabilityScope"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">applies to assay</rdfs:label>
    <skos:definition xml:lang="en">Assay or measurement technique the resource consumes or produces, as an EFO or OBI term.</skos:definition>
    <bkr:nerAlignment rdf:resource="https://brainkb.org/ner/Assay"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/hasTitle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/Title"/>
    <rdfs:label xml:lang="en">has title</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/dateDeprecated">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:label xml:lang="en">date deprecated</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/extracted-type/archive">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/extracted-type/"/>
    <skos:prefLabel xml:lang="en">Archive</skos:prefLabel>
    <skos:definition xml:lang="en">A persistent store others deposit into and retrieve from, with its own accession scheme. Normalise "repository", "data portal", "database" to this when the subject is the store itself.</skos:definition>
    <bkr:instantiatesClass rdf:resource="https://brainkb.org/resource/Archive"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/relationType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/ResourceRelation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">relation type</rdfs:label>
    <bkr:dataciteMapping>@relationType</bkr:dataciteMapping>
    <skos:note xml:lang="en">Values from &lt;https://brainkb.org/resource/relation-type/&gt; (the 39 DataCite 4.7 relation types).</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/usage-role/validation_data">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/usage-role/"/>
    <skos:prefLabel xml:lang="en">validation data</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/resolution-status/resolved">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/resolution-status/"/>
    <skos:prefLabel xml:lang="en">resolved</skos:prefLabel>
    <skos:notation>resolved</skos:notation>
    <skos:definition xml:lang="en">The identifier resolved to exactly one record at the source.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/failureSymptom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/FailureMode"/>
    <rdfs:label xml:lang="en">failure symptom</rdfs:label>
    <skos:definition xml:lang="en">How the failure presents: an error, a crash, degraded accuracy, implausible output, or nothing visible at all.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/icity/Change/Manifestation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lifesci/appliedToTaxon">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">applied to taxon</rdfs:label>
    <owl:propertyChainAxiom rdf:nodeID="n45ffa8a04ce142318981ad1c2ce2f03db1"/>
    <skos:definition xml:lang="en">Entailed shortcut: any taxon appearing in any scope of the resource. Use for retrieval; use the scope objects when the distinction between declared, validated and observed matters.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/resource-type/PhysicalObject">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/resource-type/"/>
    <skos:prefLabel xml:lang="en">PhysicalObject</skos:prefLabel>
    <skos:notation>PhysicalObject</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://schema.org/SoftwareApplication">
    <bkr:reuseNote xml:lang="en">Use schema:SoftwareApplication directly for runnable software and add bkr:SoftwareResource at the instance/profile level when the software is catalogued by BKR.</bkr:reuseNote>
    <skos:closeMatch rdf:resource="https://brainkb.org/ner/SoftwareEntity"/>
    <bkr:dataciteMapping>resourceTypeGeneral=Software</bkr:dataciteMapping>
    <bkr:structsenseField>type=Tool</bkr:structsenseField>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/subjectConcept">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">subject concept (legacy wrapper link)</rdfs:label>
    <bkr:dataciteMapping>@valueURI</bkr:dataciteMapping>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <dcterms:isReplacedBy rdf:resource="http://purl.org/dc/terms/subject"/>
    <skos:note xml:lang="en">New records use the concept IRI itself as the dcterms:subject object, so no wrapper-to-concept link is required.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lifecycle-status/">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dcterms:title xml:lang="en">BRPO lifecycle status</dcterms:title>
    <skos:scopeNote xml:lang="en">Where a resource stands in its own lifecycle. Drives the update layer: only released and maintained resources should be recommended, and superseded or deprecated ones must carry bkr:isSupersededBy or bkr:deprecationReason.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/funderIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/FundingReference"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/Identifier"/>
    <rdfs:label xml:lang="en">funder identifier</rdfs:label>
    <bkr:dataciteMapping>funderIdentifier</bkr:dataciteMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/resolution-route/manual_lookup">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/resolution-route/"/>
    <skos:prefLabel xml:lang="en">manual lookup</skos:prefLabel>
    <skos:notation>manual_lookup</skos:notation>
    <skos:definition xml:lang="en">A person located the record by hand; record the reviewer as the activity's agent.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/verification-outcome/">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dcterms:title xml:lang="en">Metadata verification outcome</dcterms:title>
    <skos:scopeNote xml:lang="en">Whether an authoritative source confirmed a metadata value that was extracted from a document or supplied by a submitter.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/resolution-route/datacite_commons">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/resolution-route/"/>
    <skos:prefLabel xml:lang="en">DataCite Commons</skos:prefLabel>
    <skos:notation>datacite_commons</skos:notation>
    <skos:definition xml:lang="en">The identifier prefix was not recognised, so DataCite Commons was queried to find the issuing repository and the record.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lifesci/CellTypeTaxonomy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/TerminologyResource"/>
    <rdfs:label xml:lang="en">cell type taxonomy</rdfs:label>
    <skos:definition xml:lang="en">A versioned, hierarchical set of cell type definitions derived from data, with a nomenclature that other resources map onto.</skos:definition>
    <bkr:bicanAlignment>cell_taxonomy.yaml / ccn2.yaml</bkr:bicanAlignment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000310">
    <rdfs:label xml:lang="en">document</rdfs:label>
    <bkr:reuseNote xml:lang="en">Use the IAO document class directly. A document becomes a BKR digital resource only when it is explicitly catalogued as such; citation alone does not make every IAO document a BKR resource.</bkr:reuseNote>
    <skos:closeMatch rdf:resource="https://schema.org/ScholarlyArticle"/>
    <skos:closeMatch rdf:resource="https://brainkb.org/ner/PublicationEntity"/>
    <bkr:dataciteMapping>resourceTypeGeneral=JournalArticle|Preprint|DataPaper|Report</bkr:dataciteMapping>
    <bkr:structsenseField>type=Paper</bkr:structsenseField>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <bkr:nerAlignment rdf:resource="https://brainkb.org/ner/PublicationEntity"/>
    <bkr:nerAlignment rdf:resource="https://brainkb.org/ner/Publication"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/bridge/brainkb/EvidenceLine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SEPIO_0000002"/>
    <rdfs:label xml:lang="en">resource evidence line</rdfs:label>
    <skos:definition xml:lang="en">An argument for or against a catalogue statement, bundling the evidence items that support it.</skos:definition>
    <bkr:assertionEvidenceAlignment>EvidenceLine (sepio:0000002)</bkr:assertionEvidenceAlignment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/ConceptMappingCandidate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/DataProcessing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/ResourceLifecycleActivity"/>
    <rdfs:label xml:lang="en">data processing</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/bridge/brainkb/hasAssertion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/ResourceAssertion"/>
    <rdfs:label xml:lang="en">has assertion</rdfs:label>
    <skos:note xml:lang="en">Domain is open: bkr:ApplicabilityScope, bkr:Assumption, bkr:Capability, bkr:Limitation, bkr:ResourceRelation and dcat:CatalogRecord all take assertions.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/assumption-status/violated">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/assumption-status/"/>
    <skos:prefLabel xml:lang="en">violated</skos:prefLabel>
    <skos:definition xml:lang="en">Found not to hold in at least one application.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/depositedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/Archive"/>
    <rdfs:label xml:lang="en">deposited in</rdfs:label>
    <bkr:dataciteMapping>@contributorType=HostingInstitution</bkr:dataciteMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/OntologyConcept">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/contributorAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#agent"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Attribution"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <rdfs:label xml:lang="en">contributor agent (legacy BKR alias)</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <dcterms:isReplacedBy rdf:resource="http://www.w3.org/ns/prov#agent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/contributor-role/Sponsor">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/contributor-role/"/>
    <skos:prefLabel xml:lang="en">Sponsor</skos:prefLabel>
    <skos:notation>Sponsor</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/extracted-type/schema">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/extracted-type/"/>
    <skos:prefLabel xml:lang="en">Schema</skos:prefLabel>
    <skos:definition xml:lang="en">A formal structure-and-constraint specification. Normalise "data model", "metadata standard", "JSON Schema", "LinkML model" to this.</skos:definition>
    <bkr:instantiatesClass rdf:resource="https://brainkb.org/resource/Schema"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/bridge/brainkb/ResourceChangeRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/ner/ChangeRecord"/>
    <rdfs:label xml:lang="en">resource change record</rdfs:label>
    <skos:definition xml:lang="en">A change to a released resource or its catalogue record, as opposed to a change to an annotation. Carries bkr:isBreakingChange and bkr:migrationGuidance in addition to the NER change fields.</skos:definition>
    <skos:note xml:lang="en">ner:changeTrigger values already cover the machine-side causes (pipeline_update, model_update, ontology_update, mapping_rerun, source_correction, human_review); resource-side causes — a new data release, a reprocessing, a nomenclature revision — are recorded with bkr:changeType over &lt;https://brainkb.org/resource/change-type/&gt; where that scheme is retained locally, or added as new ner:ChangeTrigger individuals.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/ioExample">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/IOSpecification"/>
    <rdfs:label xml:lang="en">input/output example</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/evidencedByMention">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:range rdf:resource="https://brainkb.org/ner/EntityMention"/>
    <rdfs:label xml:lang="en">evidenced by mention</rdfs:label>
    <skos:definition xml:lang="en">Links any BKR statement object — an assertion, an applicability scope, an assumption, a resource relation — to the text span in a source document that supports it. The span, its offsets, its sentence and its salience are the Named Entity Ontology's concern, not this ontology's.</skos:definition>
    <skos:note xml:lang="en">Use instead of carrying quote strings on BKR terms: ner:EntityMention already has ner:evidenceText, ner:inSentence, ner:mentionStartInSentence / ner:mentionEndInSentence, ner:documentStartOffset / ner:documentEndOffset and ner:mentionSalience.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/source-category/organization">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/source-category/"/>
    <skos:prefLabel xml:lang="en">Organization</skos:prefLabel>
    <skos:notation>Organization</skos:notation>
    <bkr:instantiatesClass rdf:resource="http://www.w3.org/ns/prov#Organization"/>
    <skos:definition xml:lang="en">An organisation. NOT a bkr:Resource: an institution that issues or hosts resources is an agent, and typing it as a catalogued resource would make the scope and assumption machinery meaningless for it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/source-category/">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dcterms:title xml:lang="en">Resource citation list source categories</dcterms:title>
    <skos:scopeNote xml:lang="en">Categories as used by curated resource citation tables, mapped to OWL classes
via bkr:instantiatesClass and to BKR extracted types via skos:broadMatch.</skos:scopeNote>
    <rdfs:seeAlso rdf:resource="https://github.com/brain-bican"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/hasObservedScope">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://brainkb.org/resource/hasPositiveScope"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/ObservedScope"/>
    <rdfs:label xml:lang="en">has observed scope</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/alternateIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/adms#identifier"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/adms#Identifier"/>
    <rdfs:label xml:lang="en">alternate identifier</rdfs:label>
    <bkr:dataciteMapping>resource/alternateIdentifiers/alternateIdentifier</bkr:dataciteMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/contributor-role/DataCurator">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/contributor-role/"/>
    <skos:prefLabel xml:lang="en">DataCurator</skos:prefLabel>
    <skos:notation>DataCurator</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/change-type/">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dcterms:title xml:lang="en">BKR change type</dcterms:title>
    <skos:scopeNote xml:lang="en">What kind of change a change record describes, from the consumer's point of view. Complements ner:ChangeTrigger (what caused it) rather than replacing it.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/hasChangeRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://brainkb.org/ner/hasChangeRecord"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:range rdf:resource="https://brainkb.org/ner/ChangeRecord"/>
    <rdfs:label xml:lang="en">has change record</rdfs:label>
    <skos:definition xml:lang="en">A documented difference between two states of a resource, a version or a record.</skos:definition>
    <skos:note xml:lang="en">ner:hasChangeRecord already has domain prov:Entity and the record carries ner:changedField, ner:changeReason, ner:changedEntity and ner:changeTrigger (human_review, mapping_rerun, model_update, ontology_update, pipeline_update, source_correction). BKR adds only what is specific to released resources: bkr:isBreakingChange and bkr:migrationGuidance.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/contributor-role/RegistrationAuthority">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/contributor-role/"/>
    <skos:prefLabel xml:lang="en">RegistrationAuthority</skos:prefLabel>
    <skos:notation>RegistrationAuthority</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/observable-property/access_level_at_source">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/observable-property/"/>
    <skos:prefLabel xml:lang="en">access level at source</skos:prefLabel>
    <skos:notation>access_level_at_source</skos:notation>
    <skos:definition xml:lang="en">The access condition the source advertises (open, controlled, embargoed).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/relation-type/IsSupplementTo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/relation-type/"/>
    <skos:prefLabel xml:lang="en">IsSupplementTo</skos:prefLabel>
    <skos:notation>IsSupplementTo</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/scopeAssertedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasAttributedTo"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/ApplicabilityScope"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <rdfs:label xml:lang="en">scope asserted by</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/assessmentDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
