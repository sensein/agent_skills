    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/source-category/"/>
    <skos:prefLabel xml:lang="en">Analysis Pipelines</skos:prefLabel>
    <skos:notation>Analysis Pipelines</skos:notation>
    <bkr:instantiatesClass rdf:resource="https://brainkb.org/resource/Pipeline"/>
    <skos:broadMatch rdf:resource="https://brainkb.org/resource/extracted-type/pipeline"/>
    <skos:definition xml:lang="en">A multi-step analysis workflow.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/Assay">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/funder-identifier-type/ROR">
