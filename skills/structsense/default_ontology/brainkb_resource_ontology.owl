  <rdf:Description rdf:about="https://brainkb.org/resource/ControlledVocabulary">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/TerminologyResource"/>
    <rdfs:label xml:lang="en">controlled vocabulary</rdfs:label>
    <skos:definition xml:lang="en">A term set without full axiomatisation, catalogued as a reusable resource.</skos:definition>
    <skos:closeMatch rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <bkr:reuseNote xml:lang="en">Same reasoning as bkr:OntologyResource: skos:ConceptScheme is a term set, which every internal vocabulary module also is.</bkr:reuseNote>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <dcterms:isReplacedBy rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:note xml:lang="en">Use skos:ConceptScheme directly; add bkr:Resource when catalogued.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/extracted-type/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/extracted-type/"/>
    <skos:prefLabel xml:lang="en">Ontology</skos:prefLabel>
    <skos:definition xml:lang="en">A logically axiomatised terminology. Normalise "controlled vocabulary" to skos:ConceptScheme and "taxonomy" to the taxonomy type instead when it is not axiomatised.</skos:definition>
    <bkr:instantiatesClass rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/change-type/license_change">
