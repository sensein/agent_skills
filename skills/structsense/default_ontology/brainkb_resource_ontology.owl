    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/FundingReference"/>
    <rdfs:label xml:lang="en">award number</rdfs:label>
    <bkr:dataciteMapping>awardNumber</bkr:dataciteMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/modality/spatial">
