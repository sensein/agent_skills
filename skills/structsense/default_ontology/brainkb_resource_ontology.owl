    <skos:inScheme rdf:resource="https://brainkb.org/resource/requirement-type/"/>
    <skos:prefLabel xml:lang="en">license requirement</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/AutomatedExtraction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/ResourceLifecycleActivity"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/ner/NERExtractionActivity"/>
    <rdfs:label xml:lang="en">automated extraction</rdfs:label>
    <skos:definition xml:lang="en">A pipeline run that derives resource metadata from unstructured sources (papers, READMEs, portals), e.g. a structsense resource-extraction run.</skos:definition>
    <rdfs:seeAlso rdf:resource="https://github.com/sensein/agent_skills/tree/main/skills/structsense"/>
    <skos:note xml:lang="en">A resource-metadata extraction run is an extraction activity in the NER sense; it uses ner:usedModel and ner:usedOntologyVersion to pin the model and ontology release, and emits an ner:ExtractionSnapshot.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#endedAtTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov#"/>
  </rdf:Description>
