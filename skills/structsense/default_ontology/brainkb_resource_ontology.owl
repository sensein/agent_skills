  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/appliedToConcept">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">applied to concept</rdfs:label>
    <owl:propertyChainAxiom rdf:nodeID="n6ef787cca7004846bb88c8f6716f1be8b1"/>
    <skos:definition xml:lang="en">Entailed shortcut over positive scopes (declared, validated and observed) and every dimension, for retrieval. Out-of-scope concepts are intentionally excluded.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/modality/">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dcterms:title xml:lang="en">modality</dcterms:title>
    <skos:scopeNote xml:lang="en">Domain-independent data modality for bkr:appliesToModality and bkr:ioModality. Domain extensions add their own: the life-science extension's data-modality scheme covers transcriptomic, epigenomic, spatial transcriptomic and the rest.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/isPartOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
