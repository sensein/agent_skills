  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/DataAssumption">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/Assumption"/>
    <rdfs:label xml:lang="en">data assumption</rdfs:label>
    <skos:definition xml:lang="en">An assumption about the form, completeness or provenance of the input data.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/relation-type/HasTranslation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/relation-type/"/>
    <skos:prefLabel xml:lang="en">HasTranslation</skos:prefLabel>
    <skos:notation>HasTranslation</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lifesci/SpecimenCollection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/MaterialCollection"/>
    <rdfs:label xml:lang="en">specimen collection</rdfs:label>
    <skos:definition xml:lang="en">A curated set of biological specimens (donors, tissue blocks, sections, nuclei suspensions) available for use, and depleted by it.</skos:definition>
    <bkr:bicanAlignment>library_generation.yaml (Donor, TissueSample, DissociatedCellSample)</bkr:bicanAlignment>
    <bkr:designNote xml:lang="en">Specimen-level detail is out of BRPO's scope; BRPO catalogues the collection as a resource and links to BICAN specimen records.</bkr:designNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/projectAward">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Project"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/FundingReference"/>
    <rdfs:label xml:lang="en">project award</rdfs:label>
  </rdf:Description>
