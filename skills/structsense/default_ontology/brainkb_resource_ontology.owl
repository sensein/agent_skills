    <skos:notation>RRID</skos:notation>
    <bkr:reuseNote xml:lang="en">No published datacite: scheme individual for this identifier type; minted by BKR.</bkr:reuseNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/scope-dimension/time_period">
