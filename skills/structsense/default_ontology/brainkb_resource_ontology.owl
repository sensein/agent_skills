    <rdfs:label xml:lang="en">programming language</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://rdf.webofcode.org/woc/Project"/>
    <bkr:schemaAlignment>schema:programmingLanguage</bkr:schemaAlignment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/spar/datacite/igsn">
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/datacite/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/hasCapacity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://ontology.eil.utoronto.ca/icity/Resource/hasCapacity"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:label xml:lang="en">has capacity</rdfs:label>
    <bkr:icityAlignment rdf:resource="http://ontology.eil.utoronto.ca/icity/Resource/hasCapacity"/>
    <skos:note xml:lang="en">Range is an ISO 21972 quantity in iCity; BRPO leaves the quantity representation to the deployment.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/requiredResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Requirement"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:label xml:lang="en">required resource</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/StorageResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/InfrastructureResource"/>
    <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/Resource/DivisibleResource"/>
    <rdfs:label xml:lang="en">storage resource</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/extracted-type/taxonomy">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/extracted-type/"/>
    <skos:prefLabel xml:lang="en">Taxonomy</skos:prefLabel>
    <skos:definition xml:lang="en">A hierarchical set of terms without full OWL axiomatisation; in the life sciences use bkrls:CellTypeTaxonomy.</skos:definition>
    <bkr:instantiatesClass rdf:resource="https://brainkb.org/resource/TerminologyResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/relation-type/Compiles">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/relation-type/"/>
    <skos:prefLabel xml:lang="en">Compiles</skos:prefLabel>
    <skos:notation>Compiles</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/resource-type/Service">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/resource-type/"/>
    <skos:prefLabel xml:lang="en">Service</skos:prefLabel>
    <skos:notation>Service</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/identifier-type/ISSN">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/identifier-type/"/>
    <skos:prefLabel xml:lang="en">ISSN</skos:prefLabel>
    <skos:notation>ISSN</skos:notation>
    <skos:exactMatch rdf:resource="http://purl.org/spar/datacite/issn"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/hostedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <rdfs:label xml:lang="en">hosted by</rdfs:label>
    <bkr:dataciteMapping>@contributorType=HostingInstitution</bkr:dataciteMapping>
    <bkr:schemaAlignment>schema:provider</bkr:schemaAlignment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/bridge/brainkb/evidenceItemAssessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/bridge/brainkb/EvidenceItem"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/dqv#QualityMeasurement"/>
    <rdfs:label xml:lang="en">evidence item assessment</rdfs:label>
    <skos:definition xml:lang="en">Non-textual evidence: a benchmark result or performance measurement standing behind a scope or capability claim.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/Facility">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/InfrastructureResource"/>
    <rdfs:label xml:lang="en">facility</rdfs:label>
    <skos:definition xml:lang="en">A physical site providing capability to a consortium: a sequencing centre, imaging centre or biobank.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/assertionAbout">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/ResourceAssertion"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">assertion about</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/access-level/open">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/access-level/"/>
    <skos:prefLabel xml:lang="en">open</skos:prefLabel>
    <skos:definition xml:lang="en">Retrievable without registration or approval.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/criticality/">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dcterms:title xml:lang="en">BRPO criticality</dcterms:title>
    <skos:scopeNote xml:lang="en">Consequence of an assumption not holding.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/description-type/Other">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/description-type/"/>
    <skos:prefLabel xml:lang="en">Other</skos:prefLabel>
    <skos:notation>Other</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/DeviceResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/PhysicalResource"/>
    <rdfs:label xml:lang="en">device resource</rdfs:label>
    <skos:definition xml:lang="en">A hardware device offered for reuse or replication — a sensor, camera, rig, wearable or stimulus apparatus — including its manufacturer, model and calibration.</skos:definition>
    <bkr:schemaAlignment>schema:Product / sosa:Sensor (sosa:Platform for rigs)</bkr:schemaAlignment>
    <skos:note xml:lang="en">Distinguished from bkr:Instrument, which is a specific physical unit in a facility; a device resource is the design or product line that others can obtain.</skos:note>
    <skos:note xml:lang="en">Use schema:Product for a reusable device design/product model and ssn:System (or Sensor/Sampler/Actuator) for a concrete system instance. Add bkr:Resource only when the thing is catalogued.</skos:note>
    <skos:note xml:lang="en">Legacy BKR class. Prefer schema:Product for a device design/product model and ssn:System for a concrete instrument/equipment instance; specialize with sosa:Sensor, sosa:Sampler or sosa:Actuator where appropriate.</skos:note>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <dcterms:isReplacedBy rdf:resource="https://schema.org/Product"/>
    <dcterms:isReplacedBy rdf:resource="http://www.w3.org/ns/ssn/System"/>
    <skos:closeMatch rdf:resource="https://schema.org/Product"/>
    <skos:closeMatch rdf:resource="http://www.w3.org/ns/ssn/System"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/ResourceDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">resource date</rdfs:label>
    <bkr:dataciteMapping>resource/dates/date</bkr:dataciteMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/followedProtocol">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Plan"/>
    <rdfs:label xml:lang="en">followed protocol</rdfs:label>
    <skos:note xml:lang="en">Shortcut for prov:qualifiedAssociation / prov:hadPlan; use the qualified form when the responsible agent and role must also be recorded.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#Organization">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <bkr:reuseNote xml:lang="en">Organisations are prov:Organization. BKR specialises only the roles nothing standard covers: bkr:Consortium, bkr:WorkingGroup, bkr:FundingAgency, bkr:DataAccessCommittee, bkr:ResearchGroup.</bkr:reuseNote>
    <skos:closeMatch rdf:resource="https://schema.org/Organization"/>
    <skos:closeMatch rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
    <bkr:dataciteMapping>@nameType=Organizational</bkr:dataciteMapping>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov#"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/source-category/metadata">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/source-category/"/>
    <skos:prefLabel xml:lang="en">Metadata</skos:prefLabel>
    <skos:notation>Metadata</skos:notation>
    <bkr:instantiatesClass rdf:resource="https://brainkb.org/resource/Schema"/>
    <skos:broadMatch rdf:resource="https://brainkb.org/resource/extracted-type/schema"/>
    <skos:definition xml:lang="en">A metadata standard, dictionary or schema. Shares bkr:Schema with data formats; the source category is retained so the distinction is not lost.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/AnatomicalStructure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/Protocol">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/DigitalResource"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Plan"/>
    <rdfs:label xml:lang="en">protocol</rdfs:label>
    <skos:definition xml:lang="en">A specified wet-lab or analytical procedure that activities can follow.</skos:definition>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <dcterms:isReplacedBy rdf:resource="http://www.w3.org/ns/prov#Plan"/>
    <skos:note xml:lang="en">Use prov:Plan directly for reusable plans/protocols; domain-specific protocol classes may additionally be asserted.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/hasSubProject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Project"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/Project"/>
    <rdfs:label xml:lang="en">has subproject</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/resource-type/JournalArticle">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/resource-type/"/>
    <skos:prefLabel xml:lang="en">JournalArticle</skos:prefLabel>
    <skos:notation>JournalArticle</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/resolution-route/authoritative_repository">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/resolution-route/"/>
    <skos:prefLabel xml:lang="en">authoritative repository</skos:prefLabel>
    <skos:notation>authoritative_repository</skos:notation>
    <skos:definition xml:lang="en">The repository that issues this accession prefix was queried directly (for example GEO for GSE accessions, NeMO for NeMO IDs).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/Benchmark">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/DigitalResource"/>
    <rdfs:label xml:lang="en">benchmark</rdfs:label>
    <skos:definition xml:lang="en">A dataset-plus-task-plus-metric bundle used to evaluate tools or models comparably.</skos:definition>
    <bkr:structsenseField>type=Benchmark</bkr:structsenseField>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/Limitation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">limitation</rdfs:label>
    <skos:definition xml:lang="en">A known weakness or boundary of a resource that is not framed as a precondition.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/observable-property/contributor_count">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/observable-property/"/>
    <skos:prefLabel xml:lang="en">contributor count</skos:prefLabel>
    <skos:notation>contributor_count</skos:notation>
    <skos:definition xml:lang="en">Number of distinct contributors at the time of observation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/recordFromSnapshot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#CatalogRecord"/>
    <rdfs:range rdf:resource="https://brainkb.org/ner/ExtractionSnapshot"/>
    <rdfs:label xml:lang="en">record from snapshot</rdfs:label>
    <skos:definition xml:lang="en">The extraction snapshot a machine-generated record was built from, so the record can be regenerated or diffed when the pipeline, the model or the source document version changes.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/hasAssessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/dqv#hasQualityMeasurement"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/dqv#QualityMeasurement"/>
    <rdfs:label xml:lang="en">has assessment</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/ValidatedScope">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/resource/ApplicabilityScope"/>
    <rdfs:label xml:lang="en">validated scope</rdfs:label>
    <skos:definition xml:lang="en">Scope for which performance has been demonstrated by a validation or benchmarking activity whose result is cited.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/lifesci/hasDataUseCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/lifesci/DataUseCondition"/>
    <rdfs:label xml:lang="en">has data use condition</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/icity/Resource/hasCapacity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/requirement-type/">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dcterms:title xml:lang="en">BRPO requirement type</dcterms:title>
    <skos:scopeNote xml:lang="en">Kind of precondition for use.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#Person">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <bkr:reuseNote xml:lang="en">People are prov:Person, as in the assertion-evidence schema. BKR defines no person class.</bkr:reuseNote>
    <skos:closeMatch rdf:resource="https://schema.org/Person"/>
    <skos:closeMatch rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    <bkr:dataciteMapping>@nameType=Personal</bkr:dataciteMapping>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov#"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/evidence-level/documented_in_publication">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/evidence-level/"/>
    <skos:prefLabel xml:lang="en">documented in publication</skos:prefLabel>
    <skos:definition xml:lang="en">Stated in a peer-reviewed or preprinted publication about the resource.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/assumption-status/untested">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/assumption-status/"/>
    <skos:prefLabel xml:lang="en">untested</skos:prefLabel>
    <skos:definition xml:lang="en">No test exists or none has been run.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/deprecationReason">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:label xml:lang="en">deprecation reason</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/conformsToSchema">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:range rdf:resource="https://brainkb.org/resource/Schema"/>
    <rdfs:label xml:lang="en">conforms to schema</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.org/dc/terms/conformsTo"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/conformsTo"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/assumption-status/verified">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/assumption-status/"/>
    <skos:prefLabel xml:lang="en">verified</skos:prefLabel>
    <skos:definition xml:lang="en">Checked and found to hold in at least one application.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/schemaAlignment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">schema.org alignment</rdfs:label>
    <rdfs:comment xml:lang="en">Corresponding schema.org or BRAIN BBQS knowledge-graph term.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Platform">
    <bkr:reuseNote xml:lang="en">Use sosa:Platform directly for rigs, enclosures or vehicles that host sensors; add BKR typing only to catalogued instances.</bkr:reuseNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/assumption-status/disputed">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/assumption-status/"/>
    <skos:prefLabel xml:lang="en">disputed</skos:prefLabel>
    <skos:definition xml:lang="en">Contested in the literature or by another group.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/dqv#hasQualityMeasurement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
