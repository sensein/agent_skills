    <bkr:instantiatesClass rdf:resource="https://brainkb.org/resource/lifesci/CellTypeTaxonomy"/>
    <skos:broadMatch rdf:resource="https://brainkb.org/resource/extracted-type/taxonomy"/>
    <skos:definition xml:lang="en">A reference cell-type taxonomy, as distinct from a general ontology.</skos:definition>
  </rdf:Description>
