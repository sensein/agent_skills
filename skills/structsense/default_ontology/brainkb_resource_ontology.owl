  <rdf:Description rdf:about="https://brainkb.org/resource/observationValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/ResourceObservation"/>
    <rdfs:label xml:lang="en">observation value</rdfs:label>
    <skos:note xml:lang="en">The observed value as a literal, for the common case where sosa:hasResult would otherwise need a node for a single number, date or string.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/resolutionStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/IdentifierResolution"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">resolution status</rdfs:label>
    <skos:note xml:lang="en">Values from &lt;https://brainkb.org/resource/resolution-status/&gt;: resolved, not_found, ambiguous, redirected, tombstoned, source_unavailable.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/description-type/Abstract">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/description-type/"/>
    <skos:prefLabel xml:lang="en">Abstract</skos:prefLabel>
    <skos:notation>Abstract</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/verifiedAgainst">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/ResourceAssertion"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">verified against</rdfs:label>
    <skos:note xml:lang="en">The authoritative source the assertion was checked against. Use with bkr:sourceDocument when the source is a document rather than a registry.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/resource-type/Journal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/resource-type/"/>
    <skos:prefLabel xml:lang="en">Journal</skos:prefLabel>
    <skos:notation>Journal</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/source-category/atlases_and_coordinate_frameworks">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://brainkb.org/resource/source-category/"/>
    <skos:prefLabel xml:lang="en">Atlases &amp; Coordinate Frameworks</skos:prefLabel>
    <skos:notation>Atlases &amp; Coordinate Frameworks</skos:notation>
    <bkr:instantiatesClass rdf:resource="https://brainkb.org/resource/lifesci/Atlas"/>
    <skos:broadMatch rdf:resource="https://brainkb.org/resource/extracted-type/dataset"/>
    <skos:definition xml:lang="en">A brain atlas or common coordinate framework. Typed bkrls:Atlas; the underlying artefact is also a dcat:Dataset when distributions are catalogued.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/resource/hasConceptMapping">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://brainkb.org/ner/ConceptMappingDecision"/>
    <rdfs:label xml:lang="en">has concept mapping</rdfs:label>
    <skos:definition xml:lang="en">The decision that mapped a label used in this record — a scope target, a subject keyword, an assumption term — to a concept in a published ontology.</skos:definition>
    <skos:note xml:lang="en">Range is the Named Entity Ontology's mapping decision, which already carries ner:mappingStatus, ner:mappingRelationType, ner:decisionConfidence, ner:conceptMappingProvenanceRaw and ner:alignmentMethodRaw; the mapping activity carries ner:usedMappingMethod and ner:usedOntologyVersion. The SSSOM crosswalk for those terms is in bkr-brainkb-bridge.ttl.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/Location">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
