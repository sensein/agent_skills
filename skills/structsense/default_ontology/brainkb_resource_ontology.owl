  <rdf:Description rdf:about="https://brainkb.org/resource/describedByMention">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://brainkb.org/resource/Resource"/>
    <rdfs:range rdf:resource="https://brainkb.org/ner/EntityMention"/>
    <rdfs:label xml:lang="en">described by mention</rdfs:label>
    <skos:definition xml:lang="en">Links a catalogued resource to a text span that mentions or describes it. This is a span-level evidence/navigation relation and is intentionally not declared inverse to bkr:resolvesToResource, whose subject is a canonical ner:NamedEntity rather than an ner:EntityMention.</skos:definition>
    <skos:note xml:lang="en">Do not declare owl:inverseOf bkr:resolvesToResource unless the Named Entity Ontology explicitly makes NamedEntity and EntityMention the same semantic level; doing so causes unintended OWL domain/range type inferences.</skos:note>
  </rdf:Description>
