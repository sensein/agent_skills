  <rdf:Description rdf:about="https://brainkb.org/ner/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:title xml:lang="en">Named Entity Ontology for Scientific, Biomedical, and Neuroscience Knowledge</dcterms:title>
    <rdfs:label xml:lang="en">Named Entity Ontology</rdfs:label>
    <dcterms:description xml:lang="en">Version 2.2 adds a first-class causality module for relation extraction. It represents source-anchored causal relation mentions, canonical causal relations, cause/effect/mediator/moderator/confounder roles, polarity, directness, modality, causal evidence basis, mechanisms, context, quantitative effect estimates, mapping to external causal predicates, provenance, and temporal evolution. Causal and associative relations are explicitly separated.</dcterms:description>
    <dcterms:description xml:lang="en">Version 2.3 repairs the remaining local class disconnection in the causality module and guarantees that all locally defined OWL classes are connected to the NamedEntityElement root. Integration with the Assertion–Evidence ontology is provided by a separate bridge ontology.</dcterms:description>
    <owl:versionInfo>2.4.0</owl:versionInfo>
    <owl:versionIRI rdf:resource="https://brainkb.org/ner/2.4.0/"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:created>
    <dcterms:creator>BrainKB</dcterms:creator>
    <dcterms:relation rdf:resource="https://brainkb.org/assertion-evidence/"/>
    <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/prov-o/"/>
    <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/annotation-model/"/>
    <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/owl-time/"/>
    <rdfs:comment xml:lang="en">The ontology intentionally does not use BFO as an upper ontology. Domain identity is obtained through external ontology mapping; PROV-O provides lineage and Web Annotation provides annotation semantics.</rdfs:comment>
    <rdfs:comment xml:lang="en">v2.4.0: adds ner:publicationDate (Publication temporal anchor) and declares the PROV-O subset used by instance data (hadPrimarySource, used, wasAssociatedWith, wasGeneratedBy, wasDerivedFrom, wasInfluencedBy; startedAtTime, endedAtTime, generatedAtTime) so provenance is validator-checkable. See ner_ontology_v2_4_additions.ttl for the reviewed delta.</rdfs:comment>
    <owl:priorVersion rdf:resource="https://brainkb.org/ner/2.3.0/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/SoftwareEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Software</rdfs:label>
