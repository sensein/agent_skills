  <rdf:Description rdf:about="https://brainkb.org/ner/EntityMention">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Entity Mention</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/ner/TextSpan"/>
    <skos:definition xml:lang="en">An immutable occurrence of an entity expression in a source. Interpretation is stored separately in versioned annotations.</skos:definition>
    <owl:disjointWith rdf:resource="https://brainkb.org/ner/OntologyConcept"/>
    <owl:disjointWith rdf:resource="https://brainkb.org/ner/NamedEntity"/>
  </rdf:Description>
