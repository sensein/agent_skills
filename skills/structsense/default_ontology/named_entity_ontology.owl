  <rdf:Description rdf:about="https://brainkb.org/ner/MaterializedOntologyAssertion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Materialized Ontology Assertion</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/ner/MappingArtifact"/>
    <skos:definition xml:lang="en">A reified relation materialized from an accepted mapping or external ontology, retaining source ontology and activity provenance.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/CorticalLayer">
