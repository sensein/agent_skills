  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/RelationAnnotation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Relation Annotation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/ner/AnnotationArtifact"/>
    <skos:definition xml:lang="en">A provenance-bearing annotation representing a relation extracted from a source.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/AssociationRelationMention">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Association Relation Mention</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/ner/RelationMention"/>
    <skos:definition xml:lang="en">A source-anchored non-causal association relation. It is kept separate from causal relations to avoid conflating correlation with causation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/changeReason">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">change reason</rdfs:label>
    <rdfs:domain rdf:resource="https://brainkb.org/ner/ChangeRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/conceptIdentifier">
