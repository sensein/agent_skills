    <rdfs:domain rdf:resource="https://brainkb.org/ner/ModelArtifact"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/FluidSample">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fluid Sample</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/ner/BiologicalSample"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/publicationDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">publication date</rdfs:label>
    <rdfs:domain rdf:resource="https://brainkb.org/ner/Publication"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:comment xml:lang="en">Date (or year-precision date, e.g. 2026-01-01) the publication was issued. Instances SHOULD also mirror the value as dcterms:issued (xsd:gYear or xsd:date) for interoperability.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://purl.org/dc/terms/issued"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/promptVersion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">prompt version</rdfs:label>
    <rdfs:domain rdf:resource="https://brainkb.org/ner/PromptArtifact"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
