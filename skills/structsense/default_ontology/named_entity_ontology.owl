    <rdfs:label xml:lang="en">Genetic Variant</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/ner/GenomicEntity"/>
    <skos:definition xml:lang="en">A sequence-level or genomic variant.</skos:definition>
    <ner:recommendedOntology>Sequence Ontology (SO)</ner:recommendedOntology>
    <ner:recommendedOntology>ClinVar/dbSNP identifiers</ner:recommendedOntology>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/sourceModelIdentifier">
