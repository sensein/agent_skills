  <rdf:Description rdf:about="https://brainkb.org/ner/hasCause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has cause</rdfs:label>
    <rdfs:domain rdf:resource="https://brainkb.org/ner/CausalRelation"/>
    <rdfs:range rdf:resource="https://brainkb.org/ner/NamedEntity"/>
    <skos:definition xml:lang="en">Links a canonical causal relation to the named entity functioning as cause.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/CausalModality">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Causal Modality</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/ner/NamedEntityControlledTerm"/>
    <skos:definition xml:lang="en">Epistemic modality of the causal claim, such as asserted, probable, possible, hypothetical, or conditional.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/ClassificationChangedChange">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
