    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Neurological Sign</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/ner/ClinicalPhenotype"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/ner/NeuroscienceEntity"/>
