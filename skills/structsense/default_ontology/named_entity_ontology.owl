  <rdf:Description rdf:about="https://brainkb.org/ner/CausalPredicateMappingActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Causal Predicate Mapping Activity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/ner/NamedEntityProcessingActivity"/>
    <skos:definition xml:lang="en">Activity that maps a local causal relation type to an external ontology relation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/AnatomicalStructure">
