    <rdfs:label xml:lang="en">Transcript</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/ner/GenomicEntity"/>
    <skos:definition xml:lang="en">A transcript or transcript-level entity.</skos:definition>
    <ner:recommendedOntology>Sequence Ontology (SO)</ner:recommendedOntology>
    <ner:recommendedOntology>RNAcentral</ner:recommendedOntology>
  </rdf:Description>
