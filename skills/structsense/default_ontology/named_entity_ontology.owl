    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The single quality dimension this decision evaluates, e.g. 'grounding', 'labeling', 'mapping', 'claims', 'kg-keys', or 'ensemble-combined' for the combiner's decision.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/Paragraph">
