  <rdf:Description rdf:about="https://brainkb.org/ner/NamedEntitySoftwareAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Named Entity Software Agent</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#SoftwareAgent"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/ner/NamedEntityProcessingAgent"/>
    <skos:definition xml:lang="en">A software agent used by the named-entity extraction and concept-mapping pipeline.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/ModelArtifact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
