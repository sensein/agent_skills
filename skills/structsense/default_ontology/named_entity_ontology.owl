    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Neurological Disease</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/ner/NeuroscienceEntity"/>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/ner/Disease"/>
    <skos:definition xml:lang="en">A neurological disease or disorder.</skos:definition>
    <ner:recommendedOntology>MONDO</ner:recommendedOntology>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/CausalRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Causal Relation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/ner/AnnotationArtifact"/>
    <skos:definition xml:lang="en">A canonical, provenance-bearing causal relation between named entities, processes, states, or other extracted entities.</skos:definition>
    <ner:recommendedOntology>OBO Relation Ontology (RO)</ner:recommendedOntology>
    <rdfs:comment xml:lang="en">Do not infer causality from association alone. AssociationRelationMention is intentionally separate from CausalRelationMention. Causal relations should preserve the source cue, context, modality, provenance, and evidence basis.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brainkb.org/ner/DiseaseSubtype">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Disease Subtype</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://brainkb.org/ner/Disease"/>
  </rdf:Description>
